module Outputs
    intent =
        "Recording every Output against the name an Input calls it by, so a"
        "spend resolves with one lookup."
        "Infra.Spends already answers the question, and answers it expensively:"
        "a t: lookup for the parent Transaction, a b: lookup for its Block, and"
        "then the whole Block read and decoded to take one Output out of it."
        "Over Blocks 170000 to 172000 that resolved 13 Inputs out of 81901,"
        "because the t: keyspace only covers Heights someone chose to index and"
        "the parents of a modern Transaction are scattered over the whole chain."
        "This keyspace is the same fact, written down where the question is"
        "asked. o:<txid>:<index> holds the Output itself, so following an Input"
        "back stops being a Block decode."
        "It is far larger than the t: keyspace -- one entry per Output rather"
        "than one per Transaction -- which is why it waits for a Store that"
        "keeps its keys on disk. On the file backends it would be added to a log"
        "that is replayed into memory at every startup."
        "Built over a range of Heights, like Infra.TxIndex and for the same"
        "reason, and by its own command, because indexing Transactions and"
        "indexing Outputs are separately useful and separately expensive."
    exposes [Built, build]
    depends [Domain.Block, Infra.Pace, Domain.Index, Domain.Transaction, Infra.Blocks, Infra.Store, Domain.IndexKeys]
    effects [Console.print, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll, Time.now, Time.unixMs]

record Built
    blocks: Int
    outputs: Int

record Walk
    reached: Int
    advancing: Bool
    store: Store
    blocks: BlockStore
    pending: List<Entry>
    waiting: Int
    counted: Built
    pace: Pace

fn maybeReport(height: Int, counted: Built, pace: Pace) -> Result<Pace, String>
    ? "Say where the build has got to, about once a minute."
      "This ran for three hours over Blocks 200001 to 400000 and said nothing"
      "until it was done, which meant reading /proc to find out where it was."
      "Outputs a second rather than Blocks a second is the number that means"
      "something here: a Block near 400000 holds a hundred times the Outputs"
      "of one near 20000, and the Block rate falls accordingly while the work"
      "per Output does not."
    ! [Console.print, Time.now, Time.unixMs]
    nowMs = Time.unixMs()
    match Infra.Pace.due(pace, nowMs, counted.blocks)
        false -> Result.Ok(pace)
        true -> reported(height, counted, pace, nowMs)

fn reported(height: Int, counted: Built, pace: Pace, nowMs: Int) -> Result<Pace, String>
    ? "One progress line, and the Pace the next one measures from."
    ! [Console.print, Time.now]
    _said = Console.print("  {Time.now()}  height {height}: {counted.blocks} blocks, {counted.outputs} outputs, recent {Infra.Pace.perSecond(counted.blocks - pace.lastBlocks, nowMs - pace.lastMs)} blocks/s {Infra.Pace.perSecond(counted.outputs - pace.lastItems, nowMs - pace.lastMs)} outputs/s, overall {Infra.Pace.perSecond(counted.blocks, nowMs - pace.startedMs)} blocks/s {Infra.Pace.perSecond(counted.outputs, nowMs - pace.startedMs)} outputs/s")
    Result.Ok(Infra.Pace.advanced(pace, nowMs, counted.blocks, counted.outputs))

fn batchSize() -> Int
    ? "How many entries to hold before writing them."
      "Large enough that the Store is copied rarely, small enough that what is"
      "held is bounded whatever a Block turns out to contain."
    20000

verify batchSize
    batchSize() => 20000

fn build(store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Built, String>
    ? "Record every Output of every Transaction in a range of Heights."
      "A Height whose body is absent is stepped over rather than refused: the"
      "range is what the caller asked for, and what is held inside it is what"
      "there is to index."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll, Time.now, Time.unixMs]
    below = watermark(store)?
    walked = walk(Walk(reached = from, advancing = advances(from, below, to), store = store, blocks = blocks, pending = [], waiting = 0, counted = Built(blocks = 0, outputs = 0), pace = Infra.Pace.pacedFrom(Time.unixMs())), resumeFrom(from, below, to), to)?
    _flushed = flushed(walked)?
    Result.Ok(walked.counted)

fn watermark(store: Store) -> Result<Int, String>
    ? "How far the Output keyspace has been built, or zero if never."
    ! [Infra.Kv.get]
    held = Infra.Store.get(store, Domain.IndexKeys.outputsBelowKey()?)?
    Domain.Index.prunedBelowOf(held)

verify watermark
    watermark(Infra.Store.fixture([])) => Result.Ok(0)
    watermark(Infra.Store.fixture([(Domain.IndexKeys.outputsBelowKey()?, "1234")])) => Result.Ok(1234)
    watermark(Infra.Store.fixture([(Domain.IndexKeys.outputsBelowKey()?, "x")])) => Result.Err("Height must be a whole number, got 'x'")

fn resumeFrom(from: Int, below: Int, to: Int) -> Int
    ? "Where to actually start, given what has been built already."
      "Three cases, and the third is a repair."
      "A build that begins at or below the watermark and runs past it carries"
      "straight on from the watermark: those Heights are done and rewriting"
      "them would produce the same keys with the same values for no reason."
      "A build that begins above it starts where it was asked to, because the"
      "watermark is a claim about every Height below it and a gap would make"
      "that claim false."
      "A build that ends below it is a repair: the caller is saying the claim"
      "is already false and naming the Heights that make it so. It runs"
      "exactly the range it was given. The keys are the Transaction Id and the"
      "Output position, so writing one twice writes the same value, and a"
      "repair over Heights that were fine costs time and changes nothing."
    match to < below
        true -> from
        false -> continuing(from, below)

verify resumeFrom
    resumeFrom(1, 0, 100) => 1
    resumeFrom(1, 500, 900) => 500
    resumeFrom(500, 500, 900) => 500
    resumeFrom(900, 500, 1000) => 900
    resumeFrom(262074, 363724, 262076) => 262074

fn continuing(from: Int, below: Int) -> Int
    ? "The two cases that are not a repair."
    match from <= below
        true -> below
        false -> from

verify continuing
    continuing(1, 0) => 1
    continuing(1, 500) => 500
    continuing(900, 500) => 900

fn advances(from: Int, below: Int, to: Int) -> Bool
    ? "Whether this build may move the watermark."
      "Only a build that starts at or below it and reaches past it. A repair"
      "wholly below the watermark must not move it -- the watermark would go"
      "backwards and claim less than is true, and the next ordinary build"
      "would redo everything above the repair for nothing."
    Bool.and(from <= below, to >= below)

verify advances
    advances(0, 0, 100) => true
    advances(1, 0, 100) => false
    advances(1, 500, 900) => true
    advances(900, 500, 1000) => false
    advances(262074, 363724, 262076) => false

fn marked(pending: List<Entry>, reached: Int, advancing: Bool) -> Result<List<Entry>, String>
    ? "The batch, with the watermark on the end when it may be advanced."
      "In the same putAll as the Outputs it accounts for, so the two land"
      "together or not at all: one Kv.putAll is one LevelDB WriteBatch. A"
      "watermark written separately could survive a batch that did not, and"
      "then claim Heights nobody had indexed."
    match advancing
        false -> Result.Ok(List.reverse(pending))
        true -> Result.Ok(List.concat(List.reverse(pending), [Entry(key = Domain.IndexKeys.outputsBelowKey()?, value = Domain.Index.encodeHeight(reached))]))

verify marked
    marked([], 7, false) => Result.Ok([])
    marked([], 7, true) => Result.Ok([Entry(key = Domain.IndexKeys.outputsBelowKey()?, value = "7")])
    marked([Entry(key = Domain.IndexKeys.outputKey("aa", 0)?, value = "5:51")], 7, false) => Result.Ok([Entry(key = Domain.IndexKeys.outputKey("aa", 0)?, value = "5:51")])
    marked([Entry(key = Domain.IndexKeys.outputKey("aa", 0)?, value = "5:51")], 400000, true) => Result.Ok([Entry(key = Domain.IndexKeys.outputKey("aa", 0)?, value = "5:51"), Entry(key = Domain.IndexKeys.outputsBelowKey()?, value = "400000")])

fn flushed(state: Walk) -> Result<Store, String>
    ? "Write whatever is still held back."
      "The accumulator is built by prepending, so it is turned round here rather"
      "than concatenated on every Block, which would cost the batch twice over."
    ! [Infra.Kv.putAll]
    Infra.Store.putAll(state.store, marked(state.pending, state.reached, state.advancing)?)

fn walk(state: Walk, height: Int, to: Int) -> Result<Walk, String>
    ? "Each Height in turn."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll, Time.now, Time.unixMs]
    match height > to
        true -> Result.Ok(state)
        false -> atHeight(state, height, to)

fn atHeight(state: Walk, height: Int, to: Int) -> Result<Walk, String>
    ? "A Height the Index does not name ends the range early."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll, Time.now, Time.unixMs]
    named = Infra.Store.get(state.store, Domain.IndexKeys.heightKey(height)?)?
    match named
        Option.None -> Result.Ok(state)
        Option.Some(blockId) -> atBlock(state, height, to, blockId)

fn atBlock(state: Walk, height: Int, to: Int, blockId: String) -> Result<Walk, String>
    ? "A Block whose body is not held has no Transactions to record."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll, Time.now, Time.unixMs]
    located = Infra.Store.get(state.store, Domain.IndexKeys.blockKey(blockId)?)?
    match located
        Option.None -> walk(state, height + 1, to)
        Option.Some(text) -> indexBody(state, height, to, blockId, text)

fn indexBody(state: Walk, height: Int, to: Int, blockId: String, text: String) -> Result<Walk, String>
    ? "Read the Block and write one entry per Transaction it holds."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll, Time.now, Time.unixMs]
    location = Domain.Index.decodeLocation(text)?
    payload = Infra.Blocks.read(state.blocks, location)?
    transactions = Domain.Block.transactionsOf(payload)?
    entries = outputsFor(Domain.Block.txidsOf(transactions), transactions, state.pending)?
    added = List.len(entries) - List.len(state.pending)
    counted = Built(blocks = state.counted.blocks + 1, outputs = state.counted.outputs + added)
    stepped = maybeReport(height, counted, state.pace)?
    carried = Walk(reached = height + 1, advancing = state.advancing, store = state.store, blocks = state.blocks, pending = entries, waiting = state.waiting + added, counted = counted, pace = stepped)
    recorded = maybeWrite(carried)?
    walk(recorded, height + 1, to)

fn maybeWrite(state: Walk) -> Result<Walk, String>
    ? "Write the batch once it is big enough, and start a new one."
    ! [Infra.Kv.putAll]
    match state.waiting >= batchSize()
        false -> Result.Ok(state)
        true -> written(state)

fn written(state: Walk) -> Result<Walk, String>
    ? "One putAll for everything held back."
    ! [Infra.Kv.putAll]
    grown = flushed(state)?
    Result.Ok(Walk(reached = state.reached, advancing = state.advancing, store = grown, blocks = state.blocks, pending = [], waiting = 0, counted = state.counted, pace = state.pace))

fn outputsFor(txids: List<String>, transactions: List<Transaction>, acc: List<Entry>) -> Result<List<Entry>, String>
    ? "One entry per Output, walking the Ids and the Transactions together."
      "Two lists rather than one because a Transaction does not carry its own"
      "Id: it is the hash of its bytes, and Domain.Block computes them once for"
      "the whole Block."
    match txids
        [] -> Result.Ok(acc)
        [head, ..tail] -> nextTransaction(head, tail, transactions, acc)

verify outputsFor
    outputsFor([], [], []) => Result.Ok([])
    List.len(outputsFor(["aa"], [sampleTx()], [])?) => 1

fn nextTransaction(txid: String, rest: List<String>, transactions: List<Transaction>, acc: List<Entry>) -> Result<List<Entry>, String>
    ? "The Ids and the Transactions are the same list in the same order, so one"
      "running out before the other cannot happen and stops the walk if it does."
    match transactions
        [] -> Result.Ok(acc)
        [head, ..tail] -> outputsFor(rest, tail, entriesFor(txid, Domain.Transaction.outputsOf(head), 0, acc)?)

verify nextTransaction
    nextTransaction("aa", [], [], []) => Result.Ok([])
    List.len(nextTransaction("aa", [], [sampleTx()], [])?) => 1

fn entriesFor(txid: String, outputs: List<Output>, index: Int, acc: List<Entry>) -> Result<List<Entry>, String>
    ? "One entry per Output of one Transaction, in Output order."
      "Prepends onto whatever is already waiting and does not turn the result"
      "round; the batch is reversed once, when it is written."
    match outputs
        [] -> Result.Ok(acc)
        [head, ..tail] -> entriesFor(txid, tail, index + 1, List.prepend(entryFor(txid, index, head)?, acc))

verify entriesFor
    entriesFor("aa", [], 0, []) => Result.Ok([])
    List.len(entriesFor("aa", [sampleOutput()], 0, [])?) => 1
    List.len(entriesFor("aa", [sampleOutput(), sampleOutput()], 0, [])?) => 2

fn entryFor(txid: String, index: Int, output: Output) -> Result<Entry, String>
    ? "This Output, under the name an Input will call it by."
    Result.Ok(Entry(key = Domain.IndexKeys.outputKey(txid, index)?, value = Domain.Index.encodeSpentOutput(Domain.Index.SpentOutput(value = Domain.Transaction.valueOf(output), script = Domain.Transaction.outputScriptOf(output)))))

verify entryFor
    entryFor("aa", 0, sampleOutput()) => Result.Ok(Entry(key = Domain.IndexKeys.outputKey("aa", 0)?, value = "5000:51"))
    entryFor("aa", 3, sampleOutput()) => Result.Ok(Entry(key = Domain.IndexKeys.outputKey("aa", 3)?, value = "5000:51"))

fn sampleOutput() -> Output
    ? "One Output, for the blocks above."
    Output(value = 5000, script = "51")

verify sampleOutput
    Domain.Transaction.valueOf(sampleOutput()) => 5000

fn sampleTx() -> Transaction
    ? "A Transaction with one Output, for the blocks above."
    Transaction(version = 1, inputs = [], outputs = [sampleOutput()], lockTime = 0, txid = "aa", size = 0, isSegWit = false)

verify sampleTx
    List.len(Domain.Transaction.outputsOf(sampleTx())) => 1
