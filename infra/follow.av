module Follow
    intent =
        "Following the tip on a pool of Peers: the listen loop grown from"
        "Transactions to Blocks."
        "Stages 1 to 3 make a node that can check the chain it is handed. This"
        "is the one that stays current. It is the same three phases the"
        "download commands run -- Headers, then bodies, then the UTXO Set --"
        "only driven by a Peer saying something arrived rather than by a range"
        "somebody typed, and run again every time it does."
        "An Announcement of a Block is answered with getheaders rather than"
        "getdata, which is a deliberate departure from how it was first"
        "written down (#26). A Block whose Header the tree has not placed"
        "cannot be connected and cannot even be told from a Block on a branch"
        "we are not following, so asking for the body first buys nothing and"
        "loses the ordering. Headers first is also what Bitcoin Core does with"
        "an inv it did not expect, and for the same reason. The getdata still"
        "happens -- it is what the body phase is -- one Header later."
        "Many Peers now, and a Mempool: a Transaction announced here is asked"
        "for, checked against the UTXO Set and Policy, held if it passes and"
        "announced onward to every other Peer. Compact Blocks arrive here too"
        "(Stage 7), and so do Peers that dialled us, which the loop answers"
        "and then serves the chain to (Stage 8, on the listen and accept that"
        "jasisz/aver#1131 asked for and #1138 delivered). Nothing in this"
        "loop is waiting on the runtime any more."
    exposes [Following, Catching, Walked, Asking, Batched, Aligning, Flown, Chunking, Stepping, Chunked, Onward, opened, seatedKeys, handled, turned, tickMs, tickFor, tickSockets, Admitted, callerTaken, listenerOf, drained, servingOwed, closed, dueFor, catchingOn, askedHeaders, wantsHeaders, flying, stopAsked, headersHeard, alignedFor, flownOnce, blockLanded, chunkBegun, chunkStepped, chunkEnded, caughtMoved, faultedOn, blockInvalid, chainStopped, withPool, sampleFollowing, sampleCatching]
    depends [Bytes, Tcp, Work, Domain.Addr, Domain.Address, Domain.AddressBook, Domain.Block, Domain.Body, Domain.Catchup, Domain.CompactBlock, Domain.Hash, Domain.HeaderTree, Domain.Inbox, Domain.Index, Domain.IndexKeys, Domain.Inventory, Domain.Mempool, Domain.Network, Domain.Screen, Domain.Screenlines, Domain.Snapshot, Domain.Target, Domain.Transaction, Domain.TreeStore, Domain.UtxoStore, Domain.Version, Infra.Blocks, Infra.Board, Infra.Bodies, Infra.ChainState, Infra.Debug, Infra.Download, Infra.Headers, Infra.Mempool, Infra.Metrics, Infra.Peers, Infra.Resolver, Infra.Rewind, Infra.Pace, Infra.Screen, Infra.Store, Domain.Watchdog]
    effects [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText, Disk.readBytesAt, Disk.size, Disk.sync,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.getAll, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.now, Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]

record Following
    pool: Pool
    store: Store
    blocks: BlockStore
    book: Map<String, Candidate>
    nextKey: Int
    watch: Watching
    mempool: Mempool
    rebuilding: Option<Rebuilding>
    log: Log
    board: Option<Board>
    gate: Gate

record Rebuilding
    blockId: String
    hash: List<Int>
    key: Int
    askedMs: Int
    compact: Option<Compact>
    asked: List<Int>

record Watching
    snapshot: Snapshot
    heard: Map<Int, Int>
    anyHeardMs: Int
    saidPeersMs: Int
    tendedMs: Int
    view: Option<View>
    leaving: Bool
    stopAskedMs: Int
    pollReturnedMs: Int
    handling: String

fn freshWatch(nowMs: Int) -> Watching
    ? "What the loop knows about its own watching, before anything happens:"
      "an empty Snapshot, nobody heard yet -- but the clock starts now, so"
      "silence is measured from joining and not from 1970."
    Watching(snapshot = Domain.Snapshot.started(nowMs), heard = Map.fromList([]), anyHeardMs = nowMs, saidPeersMs = nowMs, tendedMs = 0, view = Option.None, leaving = false, stopAskedMs = 0, pollReturnedMs = nowMs, handling = "starting")

verify freshWatch
    freshWatch(5).anyHeardMs => 5
    freshWatch(5).saidPeersMs => 5
    freshWatch(5).tendedMs => 0
    Map.len(freshWatch(5).heard) => 0

fn tickMs() -> Int
    ? "How long one turn of the listen loop waits before looking at its own"
      "clock. One second: fast enough that a due line prints when it is due"
      "and a stop request is noticed promptly, slow enough that an idle node"
      "costs nothing worth measuring."
    1000

verify tickMs
    tickMs() => 1000

fn listeningIf(pool: Pool, store: Store, answering: Option<Int>) -> Result<Pool, String>
    ? "Bind a port, if this node was asked to answer callers."
    ! [Console.print, Infra.Kv.get, Tcp.listen]
    match answering
        Option.None -> Result.Ok(pool)
        Option.Some(port) -> listeningOn(pool, store, port)

fn listeningOn(pool: Pool, store: Store, port: Int) -> Result<Pool, String>
    ? "The port bound, and said out loud -- an open port is worth announcing."
      "What this node promises is decided here, once, from the directory it"
      "actually holds: the whole chain if nothing has been pruned, and only"
      "the recent part if it has. Promising more than we hold would send"
      "syncing Peers to a node that cannot answer them."
      "The line reports what the pool ends up holding rather than what was"
      "asked for. Those were once the same sentence and briefly were not: a"
      "rebuild dropped both arguments on the floor, so the node announced"
      "NODE_NETWORK at Height 179 while telling every Peer it had nothing."
    ! [Console.print, Infra.Kv.get, Tcp.listen]
    services = servicesFrom(store)?
    height = tipHeightOf(store)?
    bound = Infra.Peers.listening(pool, port, services, height)?
    _said = Console.print("listening on port {port} as {promiseNamed(bound.serves)} at Height {bound.height}, for up to {Infra.Peers.inboundLimit(bound)} inbound Peer(s)")
    Result.Ok(bound)

fn servicesFrom(store: Store) -> Result<Int, String>
    ? "The service bits this directory can honestly claim."
    ! [Infra.Kv.get]
    watermark = Infra.Store.get(store, Domain.IndexKeys.prunedBelowKey()?)?
    Result.Ok(promiseFor(watermark))

fn promiseFor(watermark: Option<Bytes>) -> Int
    ? "A directory that has never pruned serves everything; one that has"
      "serves what is left, and says which."
    match watermark
        Option.None -> Domain.Version.nodeNetwork() + Domain.Version.nodeWitness()
        Option.Some(stored) -> Domain.Version.nodeNetworkLimited() + Domain.Version.nodeWitness()

verify promiseFor
    promiseFor(Option.None) => 9
    promiseFor(Option.Some(Domain.Index.emptyBytes())) => 1032

fn promiseNamed(services: Int) -> String
    ? "The bits, for a reader."
    match services == Domain.Version.nodeNetwork() + Domain.Version.nodeWitness()
        true -> "NODE_NETWORK|NODE_WITNESS"
        false -> "NODE_NETWORK_LIMITED|NODE_WITNESS"

verify promiseNamed
    promiseNamed(9) => "NODE_NETWORK|NODE_WITNESS"
    promiseNamed(1032) => "NODE_NETWORK_LIMITED|NODE_WITNESS"

fn mempoolCap() -> Int
    ? "How many bytes of unconfirmed Transactions this node will hold."
      "Core's default, 300 MB, and the same reasoning: it is large enough that"
      "a node sees what a miner would be choosing from, and small enough that"
      "a Peer cannot make us hold the whole flood. What goes first when it is"
      "reached is what pays least, so the cost of filling it falls on whoever"
      "is filling it. Domain.Mempool does that part."
    300000000

verify mempoolCap
    mempoolCap() => 300000000

fn withWatch(state: Following, watch: Watching) -> Following
    ? "The state, with what the loop knows about its watching moved on."
    Following(pool = state.pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate)

fn withGate(state: Following, gate: Gate) -> Following
    ? "The state, with the Catch-up gate moved on."
    Following(pool = state.pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = gate)

fn opened(network: Network, addresses: List<PeerAddress>, store: Store, blocks: BlockStore, screened: Bool, answering: Option<Int>, logging: Option<String>, noting: Option<String>, boarding: Option<Int>, inbound: Int) -> Result<Following, String>
    ? "Connect to every Peer given, and open what the node answers on."
      "With screened true the node runs as the Screen (#130): the terminal"
      "is taken here, before the first Catch-up, and given back in closed,"
      "on the one path every ending shares."
      "With answering carrying a port the node also binds it and answers"
      "callers (#30). It is a word rather than a default because an inbound"
      "port is an attack surface, and a node should not open one because"
      "somebody upgraded it. The port is bound before the outbound Peers"
      "are greeted, and nothing reads a caller until the processes run."
      "Nothing waits after this returns: the processes in main.av read the"
      "Peers, walk the Catch-up and keep the clock, and each step they ask"
      "for is one of the functions below."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Infra.Kv.get,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.listen, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor,
        Time.unixMs,
        Wait.poll,
    ]
    opening = logOf(logging, noting, Time.unixMs())
    noteOpened = Infra.Metrics.noting(opening, "start", "{Domain.Network.nameOf(network)} pid-run, {List.len(addresses)} seed address(es), screen {screened}")?
    metricsLog = Infra.Metrics.opened(noteOpened, Domain.Network.nameOf(network), 0, 0)?
    book = bootstrapped(network, addresses)?
    ready = listeningIf(Infra.Peers.withInboundCap(Infra.Peers.opened(network), inbound), store, answering)?
    board = boardIf(boarding)?
    pool = joining(ready, addresses, 0)?
    asked = askingAll(pool, Infra.Peers.peerKeys(pool))?
    bound = tellingCompact(asked, Infra.Peers.peerKeys(asked))?
    started = firstSeated(Following(pool = bound, store = store, blocks = blocks, book = book, nextKey = List.len(addresses), watch = freshWatch(Time.unixMs()), mempool = Domain.Mempool.empty(mempoolCap()), rebuilding = Option.None, log = metricsLog, board = board, gate = Domain.Catchup.noGate()), Domain.AddressBook.sizeOf(book))?
    screenedInto(started, screened)

fn seatedKeys(state: Following) -> List<Int>
    ? "Every Peer with a socket of its own, greeted or greeting: one process each."
    Infra.Peers.seatedKeys(state.pool)

verify seatedKeys
    seatedKeys(sampleFollowing()) => []

fn sampleFollowing() -> Following
    ? "A node with nobody connected and nothing stored, for the cases here."
    Following(pool = Infra.Peers.opened(Network.Regtest), store = Infra.Store.fixture([]), blocks = Infra.Blocks.fixture("d"), book = Domain.AddressBook.noBook(), nextKey = 0, watch = freshWatch(0), mempool = Domain.Mempool.empty(1000), rebuilding = Option.None, log = Infra.Metrics.none(), board = Option.None, gate = Domain.Catchup.noGate())

verify sampleFollowing
    sampleFollowing().nextKey => 0

fn sampleCatching() -> Catching
    ? "A Catch-up just begun against Peer 1, for the cases here."
    Catching(key = 1, why = "", stood = "", startedMs = 0, bookAt = 0, eye = eyeOf(sampleFollowing()), have = 0, pace = Infra.Pace.pacedFrom(0), askedMs = 0, reply = Option.None, aligned = Option.None, tipHeight = 0, flight = Option.None, sliceUntil = 0, standing = 0, blocks = leastChunk(), chunkTo = 0, chunkStartedMs = 0, setting = Option.None, final = false, built = Option.None)

verify sampleCatching
    sampleCatching().key => 1

fn handled(state: Following, key: Int, command: String, body: List<Int>, nowMs: Int) -> Result<Following, String>
    ? "One Message from one Peer acted on, after marking the Peer as heard."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.close, Tcp.writeNow,
        Time.unixMs,
    ]
    handle(withWatch(heardFrom(state, key, nowMs), Watching.update(heardAt(state.watch, key, nowMs), handling = "{command} from peer {key}")), key, command, body)

fn turned(state: Following, nowMs: Int) -> Result<Following, String>
    ? "One look at the loop's own clock, which used to be the part of every"
      "turn that was not a Message: ask the dial what it has become and say"
      "so, tell the Network where we are, weigh every Peer's Handshake"
      "Height against the tree's best (#328), start a dial if the pool is"
      "short, answer the Board, then minding (#201) -- the frame, the keys,"
      "the record -- and the two rules silence decides. Callers are the"
      "acceptor's, not the clock's."
      "A rebuild nobody has answered for too long falls back to the whole"
      "Block. An Err is the run ending, as it always was."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Infra.Kv.get,
        Random.int,
        Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    held = List.len(Infra.Peers.peerKeys(state.pool))
    told = firstAfterNone(dialsAsked(state)?, held)
    knownAt = saidAdvertised(told, Infra.Peers.told(told.pool, nowMs)?)
    weighed = withGate(knownAt, Domain.Catchup.weighingAll(knownAt.gate, Infra.Peers.claimsOf(knownAt.pool), heightOf(Infra.Headers.tipOf(knownAt.store)?)))
    topped = boarded(toppedUp(weighed)?, nowMs)?
    looked = minding(topped, nowMs)?
    _somebody = anyoneLeft(List.len(Infra.Peers.peerKeys(looked.pool)), leftToDial(looked.book, Infra.Peers.dialingNow(looked.pool)))?
    _alive = stillHeard(nowMs - looked.watch.anyHeardMs, List.len(Infra.Peers.peerKeys(looked.pool)), leftToDial(looked.book, Infra.Peers.dialingNow(looked.pool)))?
    rebuiltOr(looked, staleRebuild(looked.rebuilding, nowMs))

fn rebuiltOr(state: Following, stale: Option<Rebuilding>) -> Result<Following, String>
    ? "A rebuild nobody has answered for too long, fetched the ordinary way."
      "Without this a Peer that goes quiet after announcing a Block leaves"
      "the node waiting for a Message that is never coming."
    ! [Console.print, Disk.appendText, Time.unixMs]
    match stale
        Option.None -> Result.Ok(state)
        Option.Some(pending) -> fellBack(state, pending.key, "peer {pending.key} did not send the compact Block for {pending.blockId} within {Int.div(rebuildDeadlineMs(), 1000)} seconds")

fn tickFor(state: Following) -> Int
    ? "How long until the loop's clock is looked at again."
      "A Reader with a request still arriving or an answer still going out"
      "is work this node owes and nothing will wake it for. A tenth of a"
      "second while any Reader is held, and the ordinary tick otherwise, so"
      "a browser does not wait a second between operations and a node"
      "nobody is looking at still sleeps."
    match state.board
        Option.None -> tickMs()
        Option.Some(one) -> match List.len(one.readers) > 0
            true -> 100
            false -> tickMs()

verify tickFor
    tickFor(sampleFollowing()) => tickMs()

fn tickSockets(state: Following) -> List<Tcp.Socket>
    ? "What the clock is also woken by: the dial in flight settling, and a"
      "Board Reader with something to read or room to write."
    List.concat(dialSockets(Infra.Peers.dialOf(state.pool)), boardSockets(state.board))

verify tickSockets
    tickSockets(sampleFollowing()) => []

fn dialSockets(dial: Option<Tcp.Dial>) -> List<Tcp.Socket>
    ? "The dial as a socket to wait on, if there is one."
    match dial
        Option.None -> []
        Option.Some(one) -> [Tcp.Socket.Dialing(one)]

verify dialSockets
    dialSockets(Option.None) => []

fn boardSockets(board: Option<Board>) -> List<Tcp.Socket>
    ? "The Board's Readers as sockets to wait on."
    match board
        Option.None -> []
        Option.Some(one) -> Map.values(Infra.Board.watchSockets(one))

verify boardSockets
    boardSockets(Option.None) => []

fn drained(state: Following) -> Result<Following, String>
    ? "Every outbox offered to its socket once, then the Blocks Peers asked"
      "for read onto the wires that have room (#361)."
    ! [Console.error, Console.print, Disk.readBytesAt, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    servingBlocks(withPool(state, Infra.Peers.flushedAll(state.pool)?))

fn servingOwed(state: Following) -> Bool
    ? "Whether some Peer is still owed a Block its wire has room for."
    match Infra.Peers.nextBlockWanted(state.pool)
        Option.None -> false
        Option.Some(_) -> true

verify servingOwed
    servingOwed(sampleFollowing()) => false

fn closed(state: Following, catching: Option<Catching>, outcome: Result<Unit, String>) -> Following
    ? "The node shut down, whichever way it ended: a stop asked for, the"
      "Screen's q answered with y, or a reason the run cannot go on."
      "What the walk holds is put down first -- the Locations of Blocks"
      "already in a Segment, the Set's window at a whole Block -- then the"
      "terminal comes back when the Screen has it, so the last words land on"
      "a terminal that can show them, then the Board and every socket are"
      "closed and the metrics log says how the run ended."
    ! [
        Console.print,
        Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.close, Tcp.closeDial, Tcp.closeListener,
        Terminal.disableRawMode, Terminal.flush, Terminal.showCursor,
        Time.unixMs,
        Work.cancel,
    ]
    walked = walkPutDown(state, catching)
    _screen = restoredFor(walked.watch.view)
    _said = stopLine(walked.watch, outcome)
    _slow = stopSaid(walked.log, walked.watch.stopAskedMs, Time.unixMs())
    _board = boardClosed(walked.board)
    _ended = notedEnd(walked.log, outcome)
    _closed = Infra.Peers.closeAll(walked.pool)
    walked

fn stopLine(watch: Watching, outcome: Result<Unit, String>) -> Unit
    ? "A stop says what it is doing; a failure is said by the command."
    ! [Console.print]
    match outcome
        Result.Ok(_) -> saidLineIfPlain(watch, "stop requested; closing the pool and releasing the claim")
        Result.Err(_) -> Unit

fn walkPutDown(state: Following, catching: Option<Catching>) -> Following
    ? "A Catch-up cut short keeps what it had done. A failure here is not"
      "worth more than the ending already under way, so it is passed over."
    ! [
        Console.print,
        Disk.size, Disk.sync,
        Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Time.unixMs,
        Work.cancel,
    ]
    match catching
        Option.None -> state
        Option.Some(one) -> chunkPutDown(flightPutDown(state, one), one.setting)

fn flightPutDown(state: Following, catching: Catching) -> Following
    ? "The Locations the download was holding back, written."
    ! [Disk.size, Disk.sync, Infra.Kv.putAll]
    match catching.flight
        Option.None -> state
        Option.Some(flight) -> match Infra.Bodies.settled(Infra.Bodies.reachedAt(flight, catching.tipHeight))
            Result.Err(_) -> state
            Result.Ok(one) -> Following.update(state, store = one.store, blocks = one.blocks)

fn chunkPutDown(state: Following, setting: Option<Setting>) -> Following
    ? "The Set's window written at the last whole Block."
    ! [
        Console.print,
        Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Time.unixMs,
        Work.cancel,
    ]
    match setting
        Option.None -> state
        Option.Some(one) -> match Infra.ChainState.endedChunk(one)
            Result.Err(_) -> state
            Result.Ok(built) -> Following.update(state, store = built.store)

record Catching
    key: Int
    why: String
    stood: String
    startedMs: Int
    bookAt: Int
    eye: Eye
    have: Int
    pace: Pace
    askedMs: Int
    reply: Option<List<Int>>
    aligned: Option<Realigned>
    tipHeight: Int
    flight: Option<Flight>
    sliceUntil: Int
    standing: Int
    blocks: Int
    chunkTo: Int
    chunkStartedMs: Int
    setting: Option<Setting>
    final: Bool
    built: Option<Built>

record Walked
    state: Following
    catching: Catching

fn dueFor(state: Following, first: Bool, nowMs: Int) -> Option<Due>
    ? "The Peer the next Catch-up asks, if one is due. The first one of the"
      "run is due at once and asks the lowest key, before anything has"
      "announced anything, because a node that waited would sit idle until"
      "the next Block was mined and then fail to connect it onto a Set that"
      "was hours behind. After that it is whatever claim the gate holds"
      "whose Peer may be obeyed now."
    match first
        true -> firstDue(Infra.Peers.peerKeys(state.pool))
        false -> Domain.Catchup.dueNow(state.gate, nowMs)

verify dueFor
    dueFor(sampleFollowing(), true, 0) => Option.None
    dueFor(sampleFollowing(), false, 0) => Option.None

fn firstDue(keys: List<Int>) -> Option<Due>
    ? "The lowest key held, with nothing to say about why."
    match keys
        [] -> Option.None
        [head, ..tail] -> Option.Some(Due(key = head, why = ""))

verify firstDue
    firstDue([]) => Option.None
    firstDue([3, 4]) => Option.Some(Due(key = 3, why = ""))

fn catchingOn(state: Following, due: Due, nowMs: Int) -> Result<Walked, String>
    ? "A Catch-up begun against one Peer: where the node stands read first,"
      "so the gate can charge a Peer whose claim moved nothing (#300), and"
      "genesis put in the Index, because no Peer will send it."
    ! [Console.print, Infra.Kv.get, Infra.Kv.putAll, Time.now]
    stood = standingNow(state.store)?
    have = haveOf(state.store)?
    planted = Infra.Download.withGenesis(state.pool.network, state.store)?
    _said = saidWhy(state.watch, due.why)
    taken = withGate(Following.update(state, store = planted), Domain.Catchup.taken(state.gate, due.key))
    Result.Ok(Walked(state = taken, catching = Catching(key = due.key, why = due.why, stood = stood, startedMs = nowMs, bookAt = Domain.AddressBook.sizeOf(state.book), eye = eyeOf(taken), have = have, pace = Infra.Pace.pacedFrom(nowMs), askedMs = 0, reply = Option.None, aligned = Option.None, tipHeight = 0, flight = Option.None, sliceUntil = 0, standing = 0, blocks = leastChunk(), chunkTo = 0, chunkStartedMs = 0, setting = Option.None, final = false, built = Option.None)))

fn saidWhy(watch: Watching, why: String) -> Unit
    ? "The claim that started a Catch-up, when it had one."
    ! [Console.print, Time.now]
    match why == ""
        true -> Unit
        false -> saidLineIfPlain(watch, "{Time.now()}  {why}")

fn restartedOn(catching: Catching, key: Int, have: Int) -> Catching
    ? "The same Catch-up, asked of another Peer from the start."
    Catching.update(catching, key = key, have = have, askedMs = 0, reply = Option.None, aligned = Option.None, tipHeight = 0, flight = Option.None, sliceUntil = 0, standing = 0, blocks = leastChunk(), chunkTo = 0, chunkStartedMs = 0, setting = Option.None, final = false, built = Option.None)

fn eyeNow(state: Following, catching: Catching) -> Eye
    ? "The walk's Eye with what the loop has moved since the last step: the"
      "View a key changed, the Snapshot the clock refreshed, the log."
      "What the walk alone keeps -- the chunk it is timing, when it last"
      "drew -- stays as the walk left it."
    Eye.update(catching.eye, view = state.watch.view, snapshot = state.watch.snapshot, log = state.log, candidates = Domain.AddressBook.sizeOf(state.book))

fn foldedEye(state: Following, catching: Catching, eye: Eye) -> Walked
    ? "What a step's Eye saw, back into the loop and kept for the next step."
    Walked(state = withLog(withWatch(state, watchSeen(state.watch, eye)), eye.log), catching = Catching.update(catching, eye = eye))

type Asking
    Sent(Walked)
    Paused(Walked)

fn askedHeaders(state: Following, catching: Catching, nowMs: Int) -> Result<Asking, String>
    ? "One getheaders to the Peer being caught up on, or the phase paused"
      "when a stop was asked for."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Infra.Kv.get,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    asked = Infra.Download.batchAsked(state.pool, catching.key, state.store, catching.have, catching.pace, eyeNow(state, catching))?
    seen = foldedEye(withPool(state, asked.pool), Catching.update(catching, pace = asked.pace), asked.eye)
    match asked.sent
        true -> Result.Ok(Asking.Sent(Walked(state = seen.state, catching = Catching.update(seen.catching, askedMs = nowMs, reply = Option.None))))
        false -> Result.Ok(Asking.Paused(seen))

fn wantsHeaders(catching: Option<Catching>, key: Int, command: String) -> Bool
    ? "Whether this Message is the answer the walk is waiting for: the first"
      "headers from the Peer it asked, after it asked."
    match catching
        Option.None -> false
        Option.Some(one) -> Bool.and(Bool.and(command == "headers", one.key == key), Bool.and(one.askedMs > 0, unanswered(one.reply)))

verify wantsHeaders
    wantsHeaders(Option.None, 1, "headers") => false

fn unanswered(reply: Option<List<Int>>) -> Bool
    ? "No answer kept yet."
    match reply
        Option.None -> true
        Option.Some(_) -> false

verify unanswered
    unanswered(Option.None) => true
    unanswered(Option.Some([])) => false

fn flying(catching: Catching) -> Bool
    ? "Whether the download is in the air, so a Block is its business."
    match catching.flight
        Option.None -> false
        Option.Some(_) -> true

verify flying
    flying(sampleCatching()) => false

fn stopAsked(state: Following, nowMs: Int) -> Following
    ? "When the stop was first seen, unless a walk saw it earlier (#268)."
    withWatch(state, stopAskedNow(state.watch, nowMs))

record Batched
    walked: Walked
    more: Bool

fn headersHeard(state: Following, catching: Catching, body: List<Int>) -> Result<Batched, String>
    ? "The answer placed in the tree; more while it moved the tip."
    ! [Console.print, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll, Time.unixMs]
    answered = Infra.Download.batchHeard(state.pool.network, state.store, catching.have, body, eyeNow(state, catching))?
    seen = foldedEye(Following.update(state, store = answered.store), Catching.update(catching, have = answered.have, askedMs = 0, reply = Option.None), answered.eye)
    Result.Ok(Batched(walked = seen, more = answered.more))

type Aligning
    Ready(Walked)
    Refused(Walked, String)

fn alignedFor(state: Following, catching: Catching) -> Result<Aligning, String>
    ? "The Set taken back to the fork, or the reason it cannot be (#290)."
      "Everything Infra.Rewind can refuse is a fact about this node's own"
      "chain directory -- a fork below the Undo window, a body that was"
      "pruned, a Segment that will not read, Undo Data that will not decode"
      "-- and none of it is the fault of the Peer that was asked for"
      "Headers. It ends the run with every Peer still connected."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.Kv.applyAll, Infra.Kv.get,
        Time.unixMs,
    ]
    _heard = saidBookIfPlain(state.watch, catching.bookAt, Domain.AddressBook.sizeOf(state.book))
    realigning(state, catching, Infra.Rewind.realigned(state.store, state.blocks, eyeNow(state, catching)))

fn realigning(state: Following, catching: Catching, aligned: Result<Realigned, String>) -> Result<Aligning, String>
    ? "Refused, or the bodies above the fork planned."
    ! [Disk.appendText, Infra.Kv.get, Time.unixMs]
    match aligned
        Result.Err(why) -> Result.Ok(Aligning.Refused(Walked(state = state, catching = catching), why))
        Result.Ok(found) -> fetchPlanned(Following.update(state, store = found.store), catching, found)

fn fetchPlanned(state: Following, catching: Catching, found: Realigned) -> Result<Aligning, String>
    ? "The bodies above the fork to the tip, as a Flight not yet flown."
    ! [Disk.appendText, Infra.Kv.get, Time.unixMs]
    tipHeight = tipHeightOf(state.store)?
    startLog = marking(state, state.pool, "bodies", found.from, tipHeight, true)?
    marked = withLog(state, startLog)
    Result.Ok(Aligning.Ready(Walked(state = marked, catching = Catching.update(catching, aligned = Option.Some(found), tipHeight = tipHeight, standing = found.from, flight = Option.Some(Infra.Bodies.takingOff(Infra.Bodies.opening(marked.pool, marked.store, marked.blocks, found.from, eyeNow(marked, catching), marked.book, marked.nextKey), found.from, tipHeight)), sliceUntil = 0, blocks = leastChunk()))))

type Flown
    Going(Walked, Int)
    Sliced(Walked)
    Landed(Walked)
    Faulted(Walked, String)

fn flownOnce(state: Following, catching: Catching, nowMs: Int) -> Result<Flown, String>
    ? "One turn of the download, without its wait: what is owed by Peers"
      "that went is wanted again, every Peer is given what it has room for,"
      "a stall is charged, and the minute line said. Going says how long"
      "until it is worth looking again when no Block arrives; a Block that"
      "arrives is filed by the Peer's own process in the meantime."
      "A slice ends after sliceMs so the Set gets a chunk (#185), and a stop"
      "asked for ends the download with what is on disk."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match catching.flight
        Option.None -> flightLanded(state, catching, Option.None)
        Option.Some(flight) -> flownFrom(state, catching, borrowedFlight(state, catching, flight), sliceFrom(catching.sliceUntil, nowMs), nowMs)

fn borrowedFlight(state: Following, catching: Catching, flight: Flight) -> Flight
    ? "The Flight holding the pool, the Stores and the Book as they are now."
    Infra.Bodies.borrowing(flight, state.pool, state.store, state.blocks, eyeNow(state, catching), state.book, state.nextKey)

fn sliceFrom(sliceUntil: Int, nowMs: Int) -> Int
    ? "When this slice of the download ends: a new slice starts its clock now."
    match sliceUntil <= 0
        true -> nowMs + sliceMs()
        false -> sliceUntil

verify sliceFrom
    sliceFrom(0, 100) => 100 + sliceMs()
    sliceFrom(500, 100) => 500

fn flownFrom(state: Following, catching: Catching, flight: Flight, sliceUntil: Int, nowMs: Int) -> Result<Flown, String>
    ? "Ended, sliced, or another turn."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Bool.or(Bool.or(Process.stopRequested(), flight.progress.eye.stopped), Bool.not(Infra.Bodies.stillFlying(flight)))
        true -> flightLanded(state, catching, Option.Some(flight))
        false -> match Infra.Bodies.spent(sliceUntil, nowMs)
            true -> Result.Ok(Flown.Sliced(withFlight(state, catching, flight, 0)))
            false -> turnedFlight(state, catching, Infra.Bodies.reported(Infra.Bodies.stallChecked(Infra.Bodies.turned(flight)?)?, catching.tipHeight)?, sliceUntil, nowMs)

fn turnedFlight(state: Following, catching: Catching, flight: Flight, sliceUntil: Int, nowMs: Int) -> Result<Flown, String>
    ? "A grounded download lands; otherwise wait at most a tick."
    ! [Disk.appendText, Disk.size, Disk.sync, Infra.Kv.putAll, Time.unixMs]
    match Infra.Bodies.stillFlying(flight)
        false -> flightLanded(state, catching, Option.Some(flight))
        true -> Result.Ok(Flown.Going(withFlight(state, catching, flight, sliceUntil), Int.max(0, Int.min(Infra.Bodies.tickMs(), sliceUntil - nowMs))))

fn withFlight(state: Following, catching: Catching, flight: Flight, sliceUntil: Int) -> Walked
    ? "The download's shared parts back into the loop, and the Flight kept."
    seen = foldedEye(fromFetched(state, flight.progress), catching, flight.progress.eye)
    Walked(state = seen.state, catching = Catching.update(seen.catching, flight = Option.Some(flight), sliceUntil = sliceUntil))

verify withFlight
    withFlight(sampleFollowing(), sampleCatching(), Infra.Bodies.sampleFlight(), 9).catching.sliceUntil => 9

fn fromFetched(state: Following, progress: Fetched) -> Following
    ? "What a download step changed that the loop shares."
    Following.update(state, pool = progress.pool, store = progress.store, blocks = progress.blocks, book = progress.book, nextKey = progress.nextKey)

fn flightLanded(state: Following, catching: Catching, flight: Option<Flight>) -> Result<Flown, String>
    ? "The download over: the Locations it held back written, and the"
      "bodies record in the metrics log (#180). A fault on this node's own"
      "side (#327) is the chain's, not a Peer's."
    ! [Disk.appendText, Disk.size, Disk.sync, Infra.Kv.putAll, Time.unixMs]
    match flight
        Option.None -> Result.Ok(Flown.Landed(Walked(state = state, catching = catching)))
        Option.Some(one) -> landedWith(state, catching, Infra.Bodies.settled(Infra.Bodies.reachedAt(one, catching.tipHeight))?)

fn landedWith(state: Following, catching: Catching, fetched: Fetched) -> Result<Flown, String>
    ? "Landed, or faulted."
    ! [Disk.appendText, Time.unixMs]
    bodiesLog = markingCounts(withLog(state, fetched.eye.log), fetched.pool, "bodies", fetched.reached, catching.tipHeight, fetched.count, fetched.bytes, true)?
    seen = foldedEye(withLog(fromFetched(state, fetched), bodiesLog), Catching.update(catching, flight = Option.None, sliceUntil = 0), Eye.update(fetched.eye, log = bodiesLog))
    match Infra.Bodies.faultOf(fetched)
        Option.Some(why) -> Result.Ok(Flown.Faulted(seen, why))
        Option.None -> Result.Ok(Flown.Landed(seen))

fn blockLanded(state: Following, catching: Catching, body: List<Int>) -> Walked
    ? "A Block a Peer sent while the download is flying, filed against what"
      "is owed. A failure to file it grounds the download, which then ends"
      "with the reason as a fault on this node's own side (#327)."
    ! [
        Console.error,
        Disk.appendBytes, Disk.size, Disk.sync,
        Infra.Kv.putAll,
        Tcp.close,
        Time.unixMs,
    ]
    match catching.flight
        Option.None -> Walked(state = state, catching = catching)
        Option.Some(flight) -> filedFlight(state, catching, borrowedFlight(state, catching, flight), body)

fn filedFlight(state: Following, catching: Catching, flight: Flight, body: List<Int>) -> Walked
    ? "Filed, or grounded."
    ! [
        Console.error,
        Disk.appendBytes, Disk.size, Disk.sync,
        Infra.Kv.putAll,
        Tcp.close,
        Time.unixMs,
    ]
    match Infra.Bodies.blockLanded(flight, body)
        Result.Ok(filedOne) -> withFlight(state, catching, filedOne, catching.sliceUntil)
        Result.Err(why) -> withFlight(state, catching, Infra.Bodies.grounded(flight, why), catching.sliceUntil)

type Chunking
    Begun(Walked, Int)
    Refused(Walked, String)

fn chunkBegun(state: Following, catching: Catching, final: Bool, nowMs: Int) -> Result<Chunking, String>
    ? "A chunk of the Set begun. Between two slices of the download it is"
      "sized by what the last chunk cost (#185); the final Set to the tip is"
      "a run of chunks whose counts carry from one to the next (#238), and"
      "it starts where the Set stands."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.Kv.applyAll, Infra.Kv.get,
        Time.unixMs,
    ]
    base = finalFrom(catching, final, standingOf(state.store)?)
    chunkTo = Int.min(base.tipHeight, base.standing + base.blocks)
    noted = notedChunk(state, final, base.standing, chunkTo, base.tipHeight)?
    eye = Infra.Screen.chunking(chunkEye(noted, base, final), base.standing + 1, chunkTo, nowMs, Domain.Watchdog.chunkBudgetOf(chunkMs()))
    begunWith(noted, Catching.update(base, chunkTo = chunkTo, chunkStartedMs = nowMs, eye = eye), Infra.ChainState.begunChunk(noted.pool.network, noted.store, noted.blocks, chunkTo, base.tipHeight, eye, carriedIf(base, final)))

fn finalFrom(catching: Catching, final: Bool, standing: Int) -> Catching
    ? "The final Set starts its own counts, from where the Set stands."
    match Bool.and(final, Bool.not(catching.final))
        true -> Catching.update(catching, final = true, built = Option.None, standing = standing, blocks = leastChunk())
        false -> catching

verify finalFrom
    finalFrom(sampleCatching(), true, 7).standing => 7
    finalFrom(sampleCatching(), false, 7).standing => 0

fn notedChunk(state: Following, final: Bool, standing: Int, chunkTo: Int, tipHeight: Int) -> Result<Following, String>
    ? "The final Set's chunks are noted in the debug log, as they were."
    ! [Disk.appendText, Time.unixMs]
    match final
        false -> Result.Ok(state)
        true -> Result.Ok(withLog(state, Infra.Metrics.noting(state.log, "set", "connecting {standing + 1}..{chunkTo} of {tipHeight}, {List.len(Infra.Peers.peerKeys(state.pool))} Peer(s)")?))

fn chunkEye(state: Following, catching: Catching, final: Bool) -> Eye
    ? "The Eye a chunk carries; the final Set's with the company brought up to date."
    match final
        false -> eyeNow(state, catching)
        true -> Infra.Screen.counting(Infra.Screen.eyeing(eyeNow(state, catching), companied(state.watch.snapshot, state.pool, state.book, state.mempool)), Domain.AddressBook.sizeOf(state.book))

verify chunkEye
    chunkEye(sampleFollowing(), sampleCatching(), false).candidates => 0
    chunkEye(sampleFollowing(), sampleCatching(), true).candidates => 0

fn carriedIf(catching: Catching, final: Bool) -> Option<Built>
    ? "What the final Set has counted so far; a chunk between slices counts afresh."
    match final
        true -> catching.built
        false -> Option.None

verify carriedIf
    Option.withDefault(carriedIf(Catching.update(sampleCatching(), built = Option.Some(Infra.ChainState.sampleBuilt(4))), true), Infra.ChainState.sampleBuilt(0)).reached => 4
    Option.withDefault(carriedIf(Catching.update(sampleCatching(), built = Option.Some(Infra.ChainState.sampleBuilt(4))), false), Infra.ChainState.sampleBuilt(0)).reached => 0

fn begunWith(state: Following, catching: Catching, begun: Result<Setting, String>) -> Result<Chunking, String>
    ? "The chunk under way from the Height after the fork, or refused."
    ! [Disk.appendText, Time.unixMs]
    match begun
        Result.Err(why) -> refusedChunk(state, catching, why)
        Result.Ok(setting) -> Result.Ok(Chunking.Begun(withSetting(state, catching, setting), setting.height))

fn withSetting(state: Following, catching: Catching, setting: Setting) -> Walked
    ? "The chunk's Store and Eye back into the loop, and the chunk kept."
    seen = foldedEye(Following.update(state, store = setting.walk.counted.store), catching, Infra.ChainState.eyeOfSetting(setting))
    Walked(state = seen.state, catching = Catching.update(seen.catching, setting = Option.Some(setting)))

verify withSetting
    withSetting(sampleFollowing(), sampleCatching(), Infra.ChainState.sampleSetting(5)).catching.chunkTo => 0

fn refusedChunk(state: Following, catching: Catching, why: String) -> Result<Chunking, String>
    ? "Say which Height would not connect, and stop the Set there."
    ! [Disk.appendText, Time.unixMs]
    noted = Infra.Metrics.noting(state.log, "chain", "the Set stopped: {why}")?
    Result.Ok(Chunking.Refused(Walked(state = withLog(state, noted), catching = Catching.update(catching, setting = Option.None)), why))

type Stepping
    Parked(Walked, Work.Job)
    Next(Walked)
    Ended(Walked)
    Refused(Walked, String)

fn chunkStepped(state: Following, catching: Catching) -> Result<Stepping, String>
    ? "One step of the chunk: a job asked about or begun, or a Block into"
      "the window. Parked names the job the walk waits on."
      "The Setting is taken out of the Catch-up for the step and put back"
      "by steppedWith, so the step holds the only reference to its window"
      "and a Block set into it is not a copy of the whole window (#227)."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
        Work.cancel,
    ]
    eye = eyeNow(state, catching)
    match catching.setting
        Option.None -> Result.Ok(Stepping.Ended(Walked(state = state, catching = catching)))
        Option.Some(setting) -> steppedWith(state, Catching.update(catching, setting = Option.None), Infra.ChainState.stepOnce(Infra.ChainState.withSettingEye(setting, eye)))

fn steppedWith(state: Following, catching: Catching, stepped: Result<Stepped, String>) -> Result<Stepping, String>
    ? "What the step came to, with its Store and Eye back into the loop and"
      "its Setting back into the Catch-up. A Block that will not connect is"
      "the chain's refusal, not an error, and leaves no Setting behind."
    match stepped
        Result.Err(why) -> Result.Ok(Stepping.Refused(Walked(state = state, catching = catching), why))
        Result.Ok(Stepped.Waiting(setting, job)) -> Result.Ok(Stepping.Parked(withSetting(state, catching, setting), job))
        Result.Ok(Stepped.Connected(setting)) -> Result.Ok(Stepping.Next(withSetting(state, catching, setting)))
        Result.Ok(Stepped.Finished(setting)) -> Result.Ok(Stepping.Ended(withSetting(state, catching, setting)))

verify steppedWith
    steppedWith(sampleFollowing(), sampleCatching(), Result.Err("no")) => Result.Ok(Stepping.Refused(Walked(state = sampleFollowing(), catching = sampleCatching()), "no"))

type Chunked
    Built(Walked, Bool)
    Refused(Walked, String)

fn chunkEnded(state: Following, catching: Catching, nowMs: Int) -> Result<Chunked, String>
    ? "The chunk's window written. Built is true when the Set to the tip is"
      "done: the chunk reached the tip, or stopped short of where it was"
      "going, which is a body not held or a stop asked for."
    ! [
        Console.print,
        Disk.appendText,
        Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Time.unixMs,
        Work.cancel,
    ]
    match catching.setting
        Option.None -> Result.Ok(Chunked.Built(Walked(state = state, catching = catching), true))
        Option.Some(setting) -> endedWith(state, catching, Infra.ChainState.endedChunk(setting), nowMs)

fn endedWith(state: Following, catching: Catching, ended: Result<Built, String>, nowMs: Int) -> Result<Chunked, String>
    ? "Counted, sized and folded back, or refused."
    ! [Disk.appendText, Time.unixMs]
    match ended
        Result.Err(why) -> chunkRefused(state, catching, why)
        Result.Ok(built) -> builtWith(state, catching, Infra.ChainState.Built.update(built, eye = Infra.Screen.chunkDone(built.eye, built.reached, nowMs)?), nowMs)

fn chunkRefused(state: Following, catching: Catching, why: String) -> Result<Chunked, String>
    ? "The window would not write: the chain's refusal, noted."
    ! [Disk.appendText, Time.unixMs]
    noted = Infra.Metrics.noting(state.log, "chain", "the Set stopped: {why}")?
    Result.Ok(Chunked.Refused(Walked(state = withLog(state, noted), catching = Catching.update(catching, setting = Option.None)), why))

fn builtWith(state: Following, catching: Catching, built: Built, nowMs: Int) -> Result<Chunked, String>
    ? "The next chunk sized from what this one cost."
    seen = foldedEye(Following.update(state, store = built.store), catching, built.eye)
    next = Catching.update(seen.catching, setting = Option.None, standing = built.reached, blocks = sized(built.reached - catching.standing, nowMs - catching.chunkStartedMs)?, built = builtIf(catching.final, built))
    Result.Ok(Chunked.Built(Walked(state = seen.state, catching = next), Bool.and(catching.final, Bool.or(built.reached < catching.chunkTo, catching.chunkTo >= catching.tipHeight))))

verify builtWith
    Result.withDefault(builtWith(sampleFollowing(), Catching.update(sampleCatching(), chunkTo = 5, tipHeight = 5), Infra.ChainState.sampleBuilt(5), 0), Chunked.Refused(Walked(state = sampleFollowing(), catching = sampleCatching()), "")) => Chunked.Built(Walked(state = sampleFollowing(), catching = Catching.update(sampleCatching(), chunkTo = 5, tipHeight = 5, standing = 5)), false)

fn builtIf(final: Bool, built: Built) -> Option<Built>
    ? "The final Set keeps its counts for the line that ends it."
    match final
        true -> Option.Some(built)
        false -> Option.None

verify builtIf
    Option.withDefault(builtIf(true, Infra.ChainState.sampleBuilt(3)), Infra.ChainState.sampleBuilt(0)).reached => 3
    Option.withDefault(builtIf(false, Infra.ChainState.sampleBuilt(3)), Infra.ChainState.sampleBuilt(0)).reached => 0

fn caughtMoved(state: Following, catching: Catching, nowMs: Int) -> Result<Following, String>
    ? "The Catch-up done: the Set's line said, the Mempool swept of what"
      "the Blocks confirmed and given back what a Reorganisation"
      "disconnected, the Snapshot at the tip, and the gate told whether the"
      "Peer that asked for it moved anything (#300). A run that ran long"
      "holds one more ask of that Peer (#328), because every Announcement"
      "made meanwhile was acted on in its own turn and may have been"
      "outrun by what this Catch-up has since placed."
    ! [Console.print, Disk.appendText, Infra.Kv.get, Time.unixMs]
    built = Option.withDefault(catching.built, emptyBuilt(state, catching))
    after = finishedWith(state, built, catching.tipHeight, unconfirmedOf(catching.aligned))?
    back = backAtTip(after)?
    stands = standingNow(back.store)?
    Result.Ok(withGate(back, Domain.Catchup.recovering(chargedIf(back.gate, catching, List.contains(Infra.Peers.peerKeys(back.pool), catching.key), stands), Domain.Catchup.whoToAsk(catching.key, Infra.Peers.peerKeys(back.pool)), catching.startedMs, nowMs)))

fn chargedIf(gate: Gate, catching: Catching, seated: Bool, stands: String) -> Gate
    ? "Only a Catch-up a Peer asked for is charged to it."
    match catching.why == ""
        true -> gate
        false -> Domain.Catchup.charging(gate, catching.key, seated, catching.stood == stands, catching.startedMs)

verify chargedIf
    chargedIf(Domain.Catchup.noGate(), sampleCatching(), true, "a") => Domain.Catchup.noGate()

fn emptyBuilt(state: Following, catching: Catching) -> Built
    ? "A Set that connected nothing, standing where it stood."
    Built(store = state.store, blocks = 0, added = 0, removed = 0, fees = 0, reached = catching.standing, dropped = 0, views = [], eye = catching.eye, unconfirmed = [])

fn unconfirmedOf(aligned: Option<Realigned>) -> List<Carried>
    ? "The Transactions a Reorganisation took out of disconnected Blocks."
    match aligned
        Option.None -> []
        Option.Some(one) -> one.unconfirmed

verify unconfirmedOf
    unconfirmedOf(Option.None) => []

fn finishedWith(state: Following, built: Built, tipHeight: Int, unconfirmed: List<Carried>) -> Result<Following, String>
    ? "The Set forward to the tip, and one line saying where that leaves it."
    ! [Console.print, Disk.appendText, Infra.Kv.get, Time.unixMs]
    backOut = List.concat(unconfirmed, built.unconfirmed)
    seen = watchSeen(state.watch, built.eye)
    _each = saidLinesIfPlain(seen, blockLinesOf(built.blocks, built.views))
    _said = saidLineIfPlain(seen, "following at Height {built.reached}: {built.blocks} connected, {built.dropped} disconnected, set +{built.added} -{built.removed}")
    setLog = Infra.Metrics.marked(built.eye.log, "set", built.reached, tipHeight, built.blocks, 0, Infra.Peers.polledMsOf(state.pool), List.len(Infra.Peers.peerKeys(state.pool)), Domain.AddressBook.sizeOf(state.book), built.added, built.removed, true)?
    swept = sweptOf(built.store, state.mempool, built.blocks, built.dropped)?
    restored = restoring(state.pool.network, built.store, swept, backOut, tipHeight, 0, List.len(backOut))?
    Result.Ok(withWatch(Following.update(state, store = built.store, watch = seen, mempool = restored, log = setLog), watchAfterBuild(seen, built.views)))

fn blockInvalid(state: Following, catching: Catching, blockId: String, why: String) -> Result<Onward, String>
    ? "A Block this Catch-up fetched proved its work and failed consensus"
      "when connected (#376). It is marked invalid in the tree, the tip goes"
      "back to its parent, and the Peer the Catch-up was on is dropped for"
      "serving it -- Core marks BLOCK_FAILED_VALID and disconnects the same"
      "way. Until now this was a chain-side stop (#183), which let a Peer"
      "with one Block's worth of work end the run."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]
    marked = Infra.Headers.markedInvalid(state.store, blockId)?
    noted = Infra.Metrics.noting(state.log, "chain", "Block {blockId} does not connect and is marked invalid: {why}; charged to peer {catching.key} (#376)")?
    faultedOn(Following.update(state, store = marked, log = noted), catching, "served Block {blockId}, which does not connect: {why} (#376)")

type Onward
    Next(Walked)
    Rest(Following)

fn faultedOn(state: Following, catching: Catching, why: String) -> Result<Onward, String>
    ? "Catch up on another Peer when this one would not do it."
      "A Peer being asked for Headers or bodies can fail in ways that are"
      "facts about it rather than about the chain: a Message that does not"
      "match its own checksum, one framed for another Network, a Block that"
      "is not the Block that was asked for, or simply no answer at all before"
      "the deadline. With several Peers, stopping would mean the first Peer"
      "named on the command line can end the node by lying once -- which is"
      "what the misbehaviour test found it doing. So the Peer is dropped and"
      "the Catch-up tried again on whoever is left. Each attempt removes a"
      "Peer, so the retrying stops."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]
    kept = walkPutDown(state, Option.Some(catching))
    _said = saidErrorIfPlain(kept.watch, "dropping peer {catching.key}: {why}")
    shrunk = Infra.Peers.dropOne(kept.pool, catching.key)?
    dropped = withGate(withPool(kept, shrunk), Domain.Catchup.forgotten(kept.gate, catching.key))
    noted = Infra.Metrics.noting(dropped.log, "fault", "catch-up ended: {why}; charging it to a Peer and retrying with {List.len(Infra.Peers.peerKeys(dropped.pool))} left (#183)")?
    onwardTo(withLog(dropped, noted), catching, why, Infra.Peers.peerKeys(dropped.pool))

fn onwardTo(state: Following, catching: Catching, why: String, left: List<Int>) -> Result<Onward, String>
    ? "Another Peer to ask, or nobody left and the reason the last one gave."
    ! [
        Console.error,
        Disk.appendText,
        Infra.Kv.get,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match left
        [] -> Result.Ok(Onward.Rest(nobodyLeft(state, why)?))
        [head, ..tail] -> Result.Ok(Onward.Next(Walked(state = state, catching = restartedOn(catching, head, haveOf(state.store)?))))

fn boardIf(boarding: Option<Int>) -> Result<Option<Board>, String>
    ? "The status Board bound, if a port was asked for (#261)."
    ! [Tcp.listen]
    match boarding
        Option.None -> Result.Ok(Option.None)
        Option.Some(port) -> Result.Ok(Option.Some(Infra.Board.opened(port)?))

fn boardClosed(board: Option<Board>) -> Unit
    ? "The Board's port given back on the way out."
    ! [Tcp.close, Tcp.closeListener]
    match board
        Option.None -> Unit
        Option.Some(one) -> Infra.Board.closed(one)

fn boarded(state: Following, nowMs: Int) -> Result<Following, String>
    ? "Anyone waiting on the Board answered, once a turn (#261). The"
      "Board never holds the loop: Infra.Board asks and does not wait."
    ! [Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow]
    match state.board
        Option.None -> Result.Ok(state)
        Option.Some(one) -> boardedWith(state, one, nowMs)

fn boardedWith(state: Following, one: Board, nowMs: Int) -> Result<Following, String>
    ? "The state unchanged whatever the Board did: a Reader is not a Peer,"
      "and what it did or failed to do is its own business."
    ! [Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow]
    answered = Infra.Board.served(one, state.watch.snapshot, nowMs)
    Result.Ok(Following.update(state, board = Option.Some(answered)))

fn notedEnd(log: Log, outcome: Result<Unit, String>) -> Result<Log, String>
    ? "The last line a run writes, which is the most useful line it has"
      "(#227)."
      "debug.log recorded what a run was doing and never how it stopped, so"
      "the one question asked of it most often -- why is this down -- was"
      "the one question it could not answer. Signet ended on a Tcp.accept"
      "ceiling and the reason survived only as a screenshot of a Screen"
      "nobody was watching."
      "Written from the log opened at the start rather than the one the run"
      "carried, because a run that ended in an Err has no state left to ask;"
      "only the path is wanted here and the path does not change."
    ! [Disk.appendText, Time.unixMs]
    match outcome
        Result.Err(why) -> Infra.Metrics.noting(log, "end", "stopped with an error: {why}")
        Result.Ok(done) -> Infra.Metrics.noting(log, "end", "stopped cleanly")

fn firstSeated(state: Following, left: Int) -> Result<Following, String>
    ? "A session that named no Peer starts with an empty pool, so it dials"
      "one out of the Book before anything asks a Peer a question (#166)."
      "The catch-up speaks to a Peer by identifier, and there is no"
      "identifier to speak to until a Handshake has completed. A session"
      "that named its Peers is already seated and passes straight through."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match List.len(Infra.Peers.peerKeys(state.pool)) > 0
        true -> Result.Ok(state)
        false -> seatingMore(state, left)

fn seatingMore(state: Following, left: Int) -> Result<Following, String>
    ? "One more Candidate tried, while there are any left to try."
      "Every Candidate refused is a Candidate marked tried, so this walks"
      "the Book once rather than circling it."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match left <= 0
        true -> Result.Err("no Candidate answered; none of the addresses the DNS seeds gave could be reached")
        false -> seatingOne(state, left)

fn seatingOne(state: Following, left: Int) -> Result<Following, String>
    ? "Start a dial if none is in flight, then wait on it and ask what it"
      "became (#267)."
      "This counted turns of a loop, and since #202 made the dial"
      "non-blocking that counted nothing. toppedUp starts a dial and returns"
      "at once, and dialingNow makes the next twenty-three turns no-ops, so"
      "a node given no address burned its whole Address Book in microseconds"
      "and reported that none of the DNS seeds could be reached -- without"
      "having waited for even one of them. The instant error was the tell:"
      "twenty-four Candidates at five seconds each is two minutes, and it"
      "came back before the listening line had scrolled."
      "So the wait is here, and what is counted is Candidates that settled"
      "rather than turns taken. awaitTick is the wait because it is the one"
      "the pool already uses: it polls every socket, which is what lets an"
      "inbound caller arrive while we are still looking for an outbound."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    started = toppedUp(state)?
    waited = Infra.Peers.awaitTick(started.pool, seatingTickMs())?
    asked = dialsAsked(withPool(started, waited.pool))?
    seatingNext(asked, left, Infra.Peers.dialingNow(asked.pool))

fn seatingNext(state: Following, left: Int, dialing: Bool) -> Result<Following, String>
    ? "A dial still in flight costs no Candidate; one that has settled does."
      "Without that distinction the count runs out while the first dial is"
      "still in its five seconds."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match dialing
        true -> firstSeated(state, left)
        false -> firstSeated(state, left - 1)

fn seatingTickMs() -> Int
    ? "How long each look at a starting dial waits. A quarter second: short"
      "enough that a Candidate answering is noticed at once, long enough"
      "that waiting out a dead one costs a handful of turns and not"
      "thousands."
    250

verify seatingTickMs
    seatingTickMs() => 250

fn bootstrapped(network: Network, addresses: List<PeerAddress>) -> Result<Map<String, Candidate>, String>
    ? "The Address Book a session starts with (#166)."
      "Named Peers mean an empty Book: the caller said who to talk to, and a"
      "regtest or a controlled test must not have that quietly widened by a"
      "DNS lookup. Nothing named means the seeds are the bootstrap, which is"
      "what the glossary has always said they were."
      "The Book is held in memory only, so it is empty at every start and"
      "the seeds are always asked on the first turn. Once gossip has filled"
      "it, the dial loop takes Candidates from the Book and the seeds are"
      "not asked again -- which is the rule wanted either way: ask when the"
      "Book cannot supply."
    ! [
        Console.print,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match addresses
        [head, ..tail] -> Result.Ok(Domain.AddressBook.noBook())
        [] -> fromSeeds(network)

fn fromSeeds(network: Network) -> Result<Map<String, Candidate>, String>
    ? "Ask the Network's seeds and put what they answer in the Book as"
      "Candidates -- claimed addresses, not Peers, which is what every"
      "address that has not completed a Handshake is."
    ! [
        Console.print,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _asking = Console.print("no Peer given; asking the {Domain.Network.nameOf(network)} DNS seeds")
    found = Infra.Resolver.discoverAll(network)?
    seeded(Domain.AddressBook.heardAll(Domain.AddressBook.noBook(), textsOf(found, []), Domain.AddressBook.fromSeed()), network)

fn seeded(book: Map<String, Candidate>, network: Network) -> Result<Map<String, Candidate>, String>
    ? "A Book with nothing in it cannot start a node, and saying so beats"
      "dialling nothing in a loop."
    ! [Console.print]
    match Domain.AddressBook.sizeOf(book) == 0
        true -> Result.Err("the {Domain.Network.nameOf(network)} DNS seeds answered with no address to dial")
        false -> saidSeeded(book)

fn saidSeeded(book: Map<String, Candidate>) -> Result<Map<String, Candidate>, String>
    ? "How many Candidates the bootstrap found."
    ! [Console.print]
    _said = Console.print("{Domain.AddressBook.sizeOf(book)} Candidate(s) from the DNS seeds")
    Result.Ok(book)

fn textsOf(addresses: List<PeerAddress>, acc: List<String>) -> List<String>
    ? "The Book keys on the text of an Address, which is how a Peer names"
      "one in an addr Message too."
    match addresses
        [] -> List.reverse(acc)
        [head, ..tail] -> textsOf(tail, List.prepend(Domain.Address.toString(head), acc))

verify textsOf
    textsOf([], []) => []
    List.len(textsOf([Domain.Address.fromPeerText("1.2.3.4:8333", 8333)?], [])) => 1

fn markingCounts(state: Following, pool: Pool, phase: String, height: Int, target: Int, blocks: Int, bytes: Int, forced: Bool) -> Result<Log, String>
    ? "One metrics record carrying what a walk counted (#180)."
      "The body walk is the only phase that knows a Block count and a byte"
      "count, and it knows them only while it is running -- Fetched is handed"
      "back once, at the end. So the walk's own totals are read out of it"
      "here rather than being asked for again from the store."
    ! [Disk.appendText, Time.unixMs]
    Infra.Metrics.marked(state.log, phase, height, target, blocks, bytes, Infra.Peers.polledMsOf(pool), List.len(Infra.Peers.peerKeys(pool)), Domain.AddressBook.sizeOf(state.book), 0, 0, forced)

fn marking(state: Following, pool: Pool, phase: String, height: Int, target: Int, forced: Bool) -> Result<Log, String>
    ? "One metrics record, at a phase boundary or when a window is due (#180)."
      "Reads the counters out of the pool it is handed rather than the one in"
      "the state, because a walk hands back a pool that has done the waiting"
      "and the state's is the one from before it."
    ! [Disk.appendText, Time.unixMs]
    markingCounts(state, pool, phase, height, target, 0, 0, forced)

fn withLog(state: Following, log: Log) -> Following
    ? "The state, with the metrics log moved on."
    Following(pool = state.pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = log, board = state.board, gate = state.gate)

fn logOf(logging: Option<String>, noting: Option<String>, nowMs: Int) -> Log
    ? "The metrics log this run keeps, which is none unless a path was asked"
      "for (#180), carrying the debug note beside it (#218)."
    match logging
        Option.None -> Infra.Metrics.none()
        Option.Some(path) -> Infra.Metrics.toFile(path, noteOf(noting), nowMs)

verify logOf
    logOf(Option.None, Option.None, 5).path => Option.None
    logOf(Option.Some("m.log"), Option.None, 5).path => Option.Some("m.log")
    logOf(Option.Some("m.log"), Option.Some("d.log"), 5).note.path => Option.Some("d.log")

fn noteOf(noting: Option<String>) -> Infra.Debug.Note
    ? "The debug note this run keeps, on the same terms as the metrics log."
    match noting
        Option.None -> Infra.Debug.none()
        Option.Some(path) -> Infra.Debug.toFile(path)

verify noteOf
    noteOf(Option.None).path => Option.None
    noteOf(Option.Some("d.log")).path => Option.Some("d.log")

fn restoredIf(screened: Bool) -> Unit
    ? "Give the terminal back if the Screen ever had it; restoring a"
      "terminal that was never taken changes nothing."
    ! [Terminal.disableRawMode, Terminal.flush, Terminal.showCursor]
    match screened
        true -> Infra.Screen.restored()
        false -> Unit

fn tellingCompact(pool: Pool, keys: List<Int>) -> Result<Pool, String>
    ? "Tell every Peer we speak compact Blocks, and which version."
      "Low bandwidth: announce first and let us ask (#29). The alternative"
      "has Peers pushing whole compact Blocks at us unasked, which is worth"
      "having only once the asking path has been proven against a real one."
      "Version 2, because version 1 names Transactions by their Transaction"
      "Id and cannot name a SegWit spend at all."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    match keys
        [] -> Result.Ok(pool)
        [head, ..tail] -> tellingCompact(Infra.Peers.tell(pool, head, "sendcmpct", Domain.CompactBlock.sendCompactPayload(false, Domain.CompactBlock.protocolVersion())?)?, tail)

fn askingAll(pool: Pool, keys: List<Int>) -> Result<Pool, String>
    ? "Ask every Peer for the Peers it knows."
      "Once, on joining. A Peer answers a getaddr at most once per connection"
      "-- Bitcoin Core ignores the second -- so asking again would be noise,"
      "and the unsolicited addr Messages that follow are where the rest comes"
      "from."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    match keys
        [] -> Result.Ok(pool)
        [head, ..tail] -> askingAll(Infra.Peers.tell(pool, head, "getaddr", Bytes.fromList([]))?, tail)

fn saidBook(before: Int, after: Int) -> Unit
    ? "Say how the Address Book grew, when it grew."
      "Silent when it did not, which is most turns of the loop: a Peer"
      "relaying one address it just learned is routine and a Peer answering"
      "our getaddr with hundreds is not."
    ! [Console.print]
    match after > before
        false -> Unit
        true -> Console.print("the Address Book holds {after} Candidate(s), up {after - before}")

fn toppedUp(state: Following) -> Result<Following, String>
    ? "Start a dial when the node is short of Peers, and do not wait for it."
      "One at a time rather than a rush of them: a Handshake is a"
      "conversation and this loop is the only thing that can have one."
      "What #202 changed is that the rate is no longer bought with the"
      "loop's wall clock. This used to stand in Infra.Peers.joined until the"
      "dial settled -- five seconds on an address out of an Address Book,"
      "against a tick of one -- so a node short of Peers spent five of every"
      "six seconds here and got through one Message in each of them. With"
      "2,751 Candidates to work through it admitted no Transactions at all."
      "The dial is parked on the pool now and asked once a turn what it has"
      "become; a Candidate still costs its five seconds, but they are the"
      "dial's seconds and not the loop's."
      "The deciding and the dialling moved to Infra.Peers with #199, so that"
      "a body walk can do the same thing for the hours it holds the pool."
      "This is now the loop saying who it is: the pool, the Book and the"
      "next key, handed over and taken back. The pool and the Book are"
      "bound by a match and handed on, so the loop holds neither while a"
      "Candidate is marked in the Book."
    ! [Random.int, Tcp.beginConnect, Time.unixMs]
    match (state.pool, state.book)
        (pool, book) -> match Infra.Peers.toppedUp(pool, book, state.nextKey)
            Result.Err(why) -> Result.Err(why)
            Result.Ok(done) -> Result.Ok(Following.update(state, pool = done.pool, book = done.book, nextKey = done.nextKey))

fn withBook(state: Following, book: Map<String, Candidate>) -> Following
    ? "The state, with the Address Book moved on."
    Following(pool = state.pool, store = state.store, blocks = state.blocks, book = book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate)

fn dialsAsked(state: Following) -> Result<Following, String>
    ? "Ask the dial what it became, and say so."
      "The pair the loop does every turn, done here as well because a"
      "catch-up is hours long and the dial started at the last phase"
      "boundary would otherwise sit parked until the walk ended and its"
      "deadline had long since passed. It costs one Tcp.dialled and no"
      "waiting, which is the whole point of #202."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.writeNow,
        Time.unixMs,
    ]
    drainSettled(withPool(state, Infra.Peers.advanced(state.pool)?))

fn saidAdvertised(state: Following, advertised: Advertised) -> Following
    ? "Say where we told the Network we are, on the turn we told it (#214)."
      "Once a day, and once more the first time enough Peers agree, so this"
      "is not a line that scrolls. Without it there is no way to tell a node"
      "that has advertised from one whose Peers never agreed on an address,"
      "and only one of those is a fault."
    ! [Console.print]
    match advertised.address
        Option.None -> withPool(state, advertised.pool)
        Option.Some(one) -> saidAdvertisedNow(withPool(state, advertised.pool), one, advertised.peers)

fn saidAdvertisedNow(state: Following, address: String, peers: Int) -> Following
    ? "The line itself."
    ! [Console.print]
    _said = saidLineIfPlain(state.watch, "told {peers} Peer(s) this node is at {address}")
    state

fn drainSettled(state: Following) -> Result<Following, String>
    ? "What the dials became while the loop was doing something else."
      "Kept on the pool rather than returned, the same as the spare"
      "Messages, so a dial that settles during a walk is still said out loud"
      "when the walk ends rather than being lost with the walk's pool."
    ! [Console.error, Console.print, Disk.appendText, Tcp.close, Tcp.writeNow, Time.unixMs]
    saying(withPool(state, Infra.Peers.withoutSettled(state.pool)), Infra.Peers.settledOf(state.pool))

fn saying(state: Following, outcomes: List<Outcome>) -> Result<Following, String>
    ? "One at a time, oldest first."
    ! [Console.error, Console.print, Disk.appendText, Tcp.close, Tcp.writeNow, Time.unixMs]
    match outcomes
        [] -> Result.Ok(state)
        [head, ..tail] -> saying(said(state, head)?, tail)

fn said(state: Following, one: Outcome) -> Result<Following, String>
    ? "A Candidate that answered is a Peer to greet; one that did not is a"
      "line and nothing more."
    ! [Console.error, Console.print, Disk.appendText, Tcp.close, Tcp.writeNow, Time.unixMs]
    match one.seated
        false -> unreachable(state, one.address, one.why)
        true -> reached(state, one.address, one.key)

fn unreachable(state: Following, address: String, why: String) -> Result<Following, String>
    ? "Say who would not have us, and leave it marked as tried."
      "Noted as well as said, because a pool that will not refill is read"
      "from the Candidates that refused it (#222) and the Screen keeps none"
      "of them."
    ! [Console.error, Disk.appendText, Time.unixMs]
    _said = saidErrorIfPlain(state.watch, "candidate {address} did not answer: {why}")
    noted = Infra.Metrics.noting(state.log, "peer", "candidate {address} did not answer: {why}")?
    Result.Ok(withLog(state, noted))

fn reached(state: Following, address: String, key: Int) -> Result<Following, String>
    ? "A Candidate has become a Peer, so ask it who it knows."
    ! [Console.error, Console.print, Disk.appendText, Tcp.close, Tcp.writeNow, Time.unixMs]
    _said = saidLineIfPlain(state.watch, "peer {key} is {address}, from the Address Book")
    noted = Infra.Metrics.noting(state.log, "peer", "seated {key} at {address} from the Book, {List.len(Infra.Peers.peerKeys(state.pool))} held")?
    asked = Infra.Peers.tell(state.pool, key, "getaddr", Bytes.fromList([]))?
    Result.Ok(withPool(withLog(state, noted), asked))

fn joining(pool: Pool, addresses: List<PeerAddress>, key: Int) -> Result<Pool, String>
    ? "Every Peer given, each handshaked before the next is dialled."
      "Sequentially rather than at once, because a Handshake is a"
      "conversation and ADR 0008 puts conversations on the loop rather than"
      "in branches. It costs a few seconds at startup and buys the property"
      "that every Peer in the pool has already been read from once."
    ! [
        Console.error, Console.print,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match addresses
        [] -> Result.Ok(pool)
        [head, ..tail] -> joiningOne(pool, head, tail, key)

fn joiningOne(pool: Pool, address: PeerAddress, rest: List<PeerAddress>, key: Int) -> Result<Pool, String>
    ? "One Peer that will not answer is one Peer, not the end of the node."
      "With a single Peer a failed Handshake was the run failing, because"
      "there was nothing else to be connected to. With several it is a fact"
      "about that Peer, said out loud and stepped past."
    ! [
        Console.error, Console.print,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match Infra.Peers.joined(pool, key, address)
        Result.Err(why) -> refused(pool, address, rest, key, why)
        Result.Ok(outcome) -> acceptedOrNot(outcome, address, rest, key)

fn acceptedOrNot(outcome: Joined, address: PeerAddress, rest: List<PeerAddress>, key: Int) -> Result<Pool, String>
    ? "Seated or not, the pool that comes back is the one to carry on with."
      "The startup Peers are dialled one after another, so the seconds a"
      "Candidate spends not answering are seconds the Peers already seated"
      "spend being read, rather than seconds nobody spends."
    ! [
        Console.error, Console.print,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    match outcome.seated
        true -> accepted(outcome.pool, address, rest, key)
        false -> refused(outcome.pool, address, rest, key, outcome.why)

fn refused(pool: Pool, address: PeerAddress, rest: List<PeerAddress>, key: Int, why: String) -> Result<Pool, String>
    ? "Say which Peer would not have us, then try the next."
    ! [
        Console.error, Console.print,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _said = Console.error("peer {Domain.Address.toString(address)} refused: {why}")
    joining(pool, rest, key)

fn accepted(pool: Pool, address: PeerAddress, rest: List<PeerAddress>, key: Int) -> Result<Pool, String>
    ? "Say who answered, then go on to the next."
    ! [
        Console.error, Console.print,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _said = Console.print("peer {key} is {Domain.Address.toString(address)}")
    joining(pool, rest, key + 1)

fn screenedInto(state: Following, screened: Bool) -> Result<Following, String>
    ? "Take the terminal and open the Overview, when a Screen was asked for."
    ! [
        Infra.Kv.get,
        Terminal.clear, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor,
        Time.unixMs,
    ]
    match screened
        false -> Result.Ok(state)
        true -> takenTerminal(state)

fn takenTerminal(state: Following) -> Result<Following, String>
    ? "Raw mode on, the Snapshot stood at the tip, and the View into the"
      "state the loop carries."
      "The tip is read here because a catch-up that found nothing to do"
      "never moves the Snapshot -- and a Screen opened over an up-to-date"
      "chain should say where the node stands, not show a catch-up of"
      "nothing."
    ! [
        Infra.Kv.get,
        Terminal.clear, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor,
        Time.unixMs,
    ]
    _taken = Infra.Screen.entered()?
    placed = Infra.Headers.tipOf(state.store)?
    quiet = withPool(state, Infra.Peers.drawnElsewhere(state.pool))
    Result.Ok(withWatch(quiet, Watching(snapshot = atTip(quiet.watch.snapshot, placed, Time.unixMs()), heard = quiet.watch.heard, anyHeardMs = quiet.watch.anyHeardMs, saidPeersMs = quiet.watch.saidPeersMs, tendedMs = quiet.watch.tendedMs, view = Option.Some(Domain.Screen.opened()), leaving = quiet.watch.leaving, stopAskedMs = 0, pollReturnedMs = quiet.watch.pollReturnedMs, handling = quiet.watch.handling)))

fn atTip(snapshot: Snapshot, placed: Option<Placement>, nowMs: Int) -> Snapshot
    ? "The Snapshot standing on the tree's best tip, when the tree has one."
    match placed
        Option.None -> snapshot
        Option.Some(one) -> Domain.Snapshot.tipAt(snapshot, one.height, one.blockId, nowMs)

verify atTip
    atTip(Domain.Snapshot.started(0), Option.None, 5).tip.height => 0
    atTip(Domain.Snapshot.started(0), Option.Some(Placement(blockId = "aa", parentId = "pp", height = 7, work = 1)), 5).tip.height => 7
    atTip(Domain.Snapshot.started(0), Option.Some(Placement(blockId = "aa", parentId = "pp", height = 7, work = 1)), 5).phase => Phase.Listening

fn firstKey(pool: Pool) -> Int
    ? "Which Peer to ask first, before any of them has announced anything."
    Result.withDefault(lowestKey(Infra.Peers.peerKeys(pool)), 0)

fn lowestKey(keys: List<Int>) -> Result<Int, String>
    ? "The lowest identifier held, or nothing when the pool is empty."
    match keys
        [] -> Result.Err("no Peers")
        [head, ..tail] -> Result.Ok(head)

verify lowestKey
    lowestKey([]) => Result.Err("no Peers")
    lowestKey([0, 1]) => Result.Ok(0)

fn chainStopped(state: Following, why: String) -> Result<Following, String>
    ? "Stop, and say it was the chain and not the company."
      "Named apart from the Peer message so a reader of the last line knows"
      "at once which of the two it is looking at, and knows the Peers are"
      "still there."
    ! [Console.error]
    _said = saidErrorIfPlain(state.watch, "the chain cannot be followed past here: {why}")
    Result.Err("the chain cannot be followed past here, and no Peer is at fault: {why}")

fn nobodyLeft(state: Following, why: String) -> Result<Following, String>
    ? "Every Peer refused, which used to end the run whatever the Address"
      "Book held (#217)."
      "On mainnet it held 602 Candidates when the last of four Peers went,"
      "and the node stopped rather than dial one. With somebody left to try,"
      "or a dial already in flight, this is a node between Peers: it goes"
      "back to the loop, whose top-up dials one Candidate a turn, and the"
      "first Peer seated after none is asked to bring the chain up to date"
      "(firstAfterNone). Only nobody to dial ends the run, and the message"
      "says so rather than blaming the Peers alone."
    ! [
        Console.error,
        Disk.appendText,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _note = Infra.Metrics.noting(state.log, "pool", "empty; {Domain.AddressBook.sizeOf(state.book)} Candidate(s) held, dialling {leftToDial(state.book, Infra.Peers.dialingNow(state.pool))}; last said: {why}")?
    match leftToDial(state.book, Infra.Peers.dialingNow(state.pool))
        false -> reseeded(state, why)
        true -> Result.Ok(saidBetweenPeers(state, why))

fn reseeded(state: Following, why: String) -> Result<Following, String>
    ? "Nobody left to dial: ask the Network's DNS seeds again rather than"
      "end the run (#272). A pool empties in the first minute after a"
      "restart -- five named seeds, a Book the addr answers have not yet"
      "filled -- and a node meant never to stop should not stop for that."
      "Only seeds that answer nothing end it, and they say so."
    ! [
        Console.error,
        Disk.appendText,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.readNow, Tcp.writeNow,
        Time.unixMs,
        Wait.poll,
    ]
    _said = saidErrorIfPlain(state.watch, "the pool is empty and the Book has nobody left; asking the DNS seeds again")
    found = Infra.Resolver.discoverAll(state.pool.network)?
    grown = Domain.AddressBook.heardAll(state.book, textsOf(found, []), Domain.AddressBook.fromSeed())
    noted = Infra.Metrics.noting(state.log, "pool", "reseeded from the DNS seeds: {List.len(found)} address(es), {Domain.AddressBook.sizeOf(grown)} Candidate(s) held")?
    match Domain.AddressBook.anyUntried(grown, [])
        false -> Result.Err("no Peer could bring the chain up to date, the Address Book has nobody left to dial, and the DNS seeds answered nothing new; the last said: {why}")
        true -> Result.Ok(saidBetweenPeers(withLog(withBook(state, grown), noted), why))

fn saidBetweenPeers(state: Following, why: String) -> Following
    ? "Say that the pool is empty and the Book is not."
    ! [Console.error]
    _said = saidErrorIfPlain(state.watch, "every Peer is gone ({why}); {Domain.AddressBook.sizeOf(state.book)} Candidates in the Address Book, dialling on")
    state

fn leftToDial(book: Map<String, Candidate>, dialing: Bool) -> Bool
    ? "Whether an empty pool can still become a pool: a Candidate untried,"
      "or a dial in flight that has not yet said what it became."
    match dialing
        true -> true
        false -> Domain.AddressBook.anyUntried(book, [])

verify leftToDial
    leftToDial(Domain.AddressBook.noBook(), false) => false
    leftToDial(Domain.AddressBook.noBook(), true) => true
    leftToDial(Domain.AddressBook.heard(Domain.AddressBook.noBook(), "1.2.3.4:8333", 0), false) => true
    leftToDial(Domain.AddressBook.marked(Domain.AddressBook.heard(Domain.AddressBook.noBook(), "1.2.3.4:8333", 0), "1.2.3.4:8333"), false) => false

fn someUntried(chosen: Option<String>) -> Option<Bool>
    ? "An address to try is a yes."
    match chosen
        Option.None -> Option.None
        Option.Some(address) -> Option.Some(true)

verify someUntried
    someUntried(Option.None) => Option.None
    someUntried(Option.Some("1.2.3.4:8333")) => Option.Some(true)

fn sliceMs() -> Int
    ? "How long one slice of the download runs before the Set gets a turn"
      "(#185)."
      "Every deadline the pool enforces is wall clock -- awaitFrom fails a"
      "Peer at 60 s, pumped errors the pool at 150 s of silence, and #168's"
      "stallMs is 30 s against the Flight's own heardMs. A Set chunk between"
      "two slices must be short against all three or it fails Peers that"
      "were never slow. Ten seconds each way leaves the tightest of them"
      "three times the room it needs."
    10000

verify sliceMs
    sliceMs() => 10000

fn backAtTip(state: Following) -> Result<Following, String>
    ? "The catch-up has returned, so the Snapshot says so."
      "The walks leave the phase where they left it -- headersAt and"
      "bodiesAt both set one -- and only a Block that connects used to put"
      "it back. At the tip a turn that finds one new Header and no Block"
      "therefore left the Screen showing the catching-up form until the next"
      "Block arrived, and the Transactions Panel a Mempool arrival lands on"
      "(#164) is not drawn in that form at all."
      "This is the same call the Screen already makes the moment it opens,"
      "at the same moment: the catch-up returned."
    ! [Infra.Kv.get, Time.unixMs]
    placed = Infra.Headers.tipOf(state.store)?
    Result.Ok(withWatch(state, Watching(snapshot = atTip(state.watch.snapshot, placed, Time.unixMs()), heard = state.watch.heard, anyHeardMs = state.watch.anyHeardMs, saidPeersMs = state.watch.saidPeersMs, tendedMs = state.watch.tendedMs, view = state.watch.view, leaving = state.watch.leaving, stopAskedMs = state.watch.stopAskedMs, pollReturnedMs = state.watch.pollReturnedMs, handling = state.watch.handling)))

fn eyeOf(state: Following) -> Eye
    ? "The Eye a walk carries, opened from what the loop already knows --"
      "the View, the Snapshot, the metrics log and the Book's size -- so a"
      "walk draws and logs the way the loop does. It carries no Board: the"
      "loop's own clock answers the Board while a walk runs."
    Infra.Screen.watchedBy(state.watch.view, state.watch.snapshot, state.log, Domain.AddressBook.sizeOf(state.book), Option.None)

fn watchSeen(watch: Watching, eye: Eye) -> Watching
    ? "What a walk's Eye saw, folded back: the Snapshot it advanced, the"
      "View keys may have switched, and whether q was answered with y."
    Watching(snapshot = eye.snapshot, heard = watch.heard, anyHeardMs = watch.anyHeardMs, saidPeersMs = watch.saidPeersMs, tendedMs = watch.tendedMs, view = eye.view, leaving = Bool.or(watch.leaving, eye.stopped), stopAskedMs = Int.max(watch.stopAskedMs, eye.stopAskedMs), pollReturnedMs = watch.pollReturnedMs, handling = watch.handling)

fn saidBookIfPlain(watch: Watching, before: Int, after: Int) -> Unit
    ? "The Book line for the plain log; the Panel shows the count."
    ! [Console.print]
    match watch.view
        Option.None -> saidBook(before, after)
        Option.Some(view) -> Unit

fn chunkMs() -> Int
    ? "How long a chunk of the Set should take between two looks at the"
      "pool: ten seconds (#222)."
      "#217 made this a count of Blocks -- 250 -- chosen against Bitcoin"
      "Core's twenty-minute ping timeout, which it met. What it also set,"
      "and was not chosen against, was the rate at which the pool can be"
      "refilled: toppedUp starts at most one dial per tending, so one per"
      "chunk, and a chunk turned out to be 53 seconds on mainnet. The listen"
      "loop dials once a tick. So the phase that lasts forty hours refilled"
      "its pool at a fiftieth of the rate the phase that lasts seconds does,"
      "and mainnet held one Peer for 71 of its 73 chunks with 602 Candidates"
      "it could not get to."
      "A count of Blocks was always a proxy for a length of time, and a bad"
      "one: a Block in 2013 and a Block at the tip differ by orders of"
      "magnitude. Ten seconds is six dials a minute -- eight Peers inside two"
      "minutes -- and stays far inside twenty however heavy the Blocks get,"
      "which the fixed count did not promise."
    10000

verify chunkMs
    chunkMs() => 10000

fn mostChunk() -> Int
    ? "The most Blocks one chunk may take, whatever the clock says."
      "#217's number, kept as the ceiling: it is the count that was measured"
      "against the ping timeout, and nothing here should quietly exceed it."
    250

verify mostChunk
    mostChunk() => 250

fn leastChunk() -> Int
    ? "The fewest, so heavy Blocks cannot make a chunk long by making it"
      "small. Five Blocks that each take a minute is still five minutes,"
      "which is inside the timeout with room to spare."
    5

verify leastChunk
    leastChunk() => 5

fn sized(done: Int, tookMs: Int) -> Result<Int, String>
    ? "The next chunk, from what the last one actually cost. With nothing"
      "to go on -- the first chunk of a catch-up, or one that connected"
      "nothing -- the smallest: it is over in seconds and the next is"
      "sized from it, where a chunk of the most took a hundred seconds on"
      "mainnet and tripped the watchdog's budget on every restart (#268)."
      "Aims at chunkMs and clamps to the pair above. A chunk that took no"
      "measurable time says nothing about the rate, so it asks for the"
      "ceiling and finds out."
    match Bool.or(tookMs <= 0, done <= 0)
        true -> Result.Ok(leastChunk())
        false -> Result.Ok(clamped(Int.div(done * chunkMs(), tookMs)?))

verify sized
    sized(0, 0) => Result.Ok(5)
    sized(250, 0) => Result.Ok(5)
    sized(250, 1000) => Result.Ok(250)
    sized(250, 53000) => Result.Ok(47)
    sized(10, 10000) => Result.Ok(10)
    sized(1, 60000) => Result.Ok(5)

fn clamped(blocks: Int) -> Int
    ? "Between the fewest and the most."
    Int.min(mostChunk(), Int.max(leastChunk(), blocks))

verify clamped
    clamped(0) => 5
    clamped(7) => 7
    clamped(9000) => 250

fn standingOf(store: Store) -> Result<Int, String>
    ? "The Height the Set has been built up to, or zero before it has one."
      "Read the way Infra.Rewind reads it, so the first chunk is measured"
      "from where the walk will actually start; a reorganisation since may"
      "move that lower, which the walk's own realignment handles."
    ! [Infra.Kv.get]
    heightIn(Infra.Store.get(store, Domain.UtxoStore.reachedKey()?)?)

fn heightIn(held: Option<Bytes>) -> Result<Int, String>
    ? "Nothing recorded is Height zero."
    match held
        Option.None -> Result.Ok(0)
        Option.Some(stored) -> Result.Ok(Domain.UtxoStore.decodeReached(stored)?.height)

verify heightIn
    heightIn(Option.None) => Result.Ok(0)
    heightIn(Option.Some(Bytes.fromList([1, 2, 3]))) => Result.Err("a Set standing is exactly 36 bytes, a 4-byte Height and a 32-byte Block Id, got 3")
    heightIn(Option.Some(Domain.UtxoStore.encodeReached(Domain.UtxoStore.Reached(height = 7, blockId = Domain.UtxoStore.sampleBlockId()))?)) => Result.Ok(7)

fn companied(snapshot: Snapshot, pool: Pool, book: Map<String, Candidate>, mempool: Mempool) -> Snapshot
    ? "The Snapshot a chunk carries, with the company brought up to date"
      "(#275): who is connected now, how many Candidates, the Mempool, the"
      "address we are known by. The loop's refreshed does this once a"
      "second; a walk got its Snapshot when the catch-up began and carried"
      "it through every chunk, so the Peers Panel and the page showed the"
      "company as it stood hours ago -- five Peers with frozen counters"
      "while the pool held six and a seventh was being seated."
    Domain.Snapshot.withServing(Domain.Snapshot.withMempool(Domain.Snapshot.withCandidates(Domain.Snapshot.withPeers(snapshot, Infra.Peers.company(pool)), Domain.AddressBook.sizeOf(book)), mempoolView(mempool)), Infra.Peers.selfAddress(pool))

verify companied
    List.len(companied(Domain.Snapshot.started(0), Infra.Peers.opened(Network.Regtest), Domain.AddressBook.noBook(), Domain.Mempool.empty(1000)).company.peers) => 0
    companied(Domain.Snapshot.started(0), Infra.Peers.opened(Network.Regtest), Domain.AddressBook.heard(Domain.AddressBook.noBook(), "1.2.3.4:8333", 0), Domain.Mempool.empty(1000)).company.candidates => 1

fn sweptOf(store: Store, pool: Mempool, connectedCount: Int, disconnectedCount: Int) -> Result<Mempool, String>
    ? "The Mempool, after the chain moved under it."
      "Nothing moved means nothing to do, and that is the common case: this"
      "runs on every turn of the loop that reaches the Set, and most of them"
      "connect no Blocks at all."
    ! [Console.print, Infra.Kv.get]
    match connectedCount + disconnectedCount == 0
        true -> Result.Ok(pool)
        false -> saidSwept(pool, sweeping(store, pool, Domain.Mempool.txids(pool), [])?)

fn saidSwept(before: Mempool, after: Mempool) -> Result<Mempool, String>
    ? "Say what the chain took, unless it took nothing."
      "A Block that confirms nothing we held is the ordinary case on a quiet"
      "chain and is not worth a line."
    ! [Console.print]
    match Domain.Mempool.count(before) == Domain.Mempool.count(after)
        true -> Result.Ok(after)
        false -> toldSwept(before, after)

fn toldSwept(before: Mempool, after: Mempool) -> Result<Mempool, String>
    ? "What left, and what is still held."
    ! [Console.print]
    _said = Console.print("mempool: {Domain.Mempool.count(before) - Domain.Mempool.count(after)} Transaction(s) left, taken by the chain; holding {Domain.Mempool.count(after)} ({Domain.Mempool.bytes(after)} bytes)")
    Result.Ok(after)

fn sweeping(store: Store, pool: Mempool, held: List<String>, gone: List<String>) -> Result<Mempool, String>
    ? "Every held Transaction, against the Set the new Blocks left behind."
      "A held Transaction whose Inputs the Set no longer holds has either been"
      "confirmed or been beaten to its Outputs by one that was, and the two"
      "want the same thing done: it leaves. Asking the Set is what makes both"
      "answers one question -- there is no need to know which Block confirmed"
      "what, only whether the Outputs it means to spend are still there."
      "A reorganisation is the same walk. Disconnecting puts Outputs back, so"
      "a Transaction that was dropped for being confirmed is simply not here"
      "any more; Core would restore it and this does not, which costs us a"
      "Transaction we would have relayed and never costs correctness. The"
      "restoring half of n1bor/btc-listener#28 needs the disconnected Block's"
      "Transactions carried out of the walk, and Domain.Mempool.restored is"
      "written and waiting for them."
    ! [Infra.Kv.get]
    match held
        [] -> Result.Ok(Domain.Mempool.confirmed(pool, gone))
        [head, ..tail] -> sweptOne(store, pool, head, tail, gone)

fn sweptOne(store: Store, pool: Mempool, txid: String, rest: List<String>, gone: List<String>) -> Result<Mempool, String>
    ? "One held Transaction, by what it spends."
    ! [Infra.Kv.get]
    match Domain.Mempool.heldFor(pool, txid)
        Option.None -> sweeping(store, pool, rest, gone)
        Option.Some(entry) -> sweptSpends(store, pool, txid, rest, gone, entry.spends)

fn sweptSpends(store: Store, pool: Mempool, txid: String, rest: List<String>, gone: List<String>, spends: List<String>) -> Result<Mempool, String>
    ? "Its Outputs, one at a time, stopping at the first one that has gone."
    ! [Infra.Kv.get]
    match spends
        [] -> sweeping(store, pool, rest, gone)
        [head, ..tail] -> sweptSpend(store, pool, txid, rest, gone, head, tail)

fn sweptSpend(store: Store, pool: Mempool, txid: String, rest: List<String>, gone: List<String>, spend: String, others: List<String>) -> Result<Mempool, String>
    ? "Whether the Set still holds this one."
    ! [Infra.Kv.get]
    stored = Infra.Store.get(store, keyForOutpoint(spend)?)?
    match stored
        Option.None -> sweeping(store, pool, rest, List.prepend(txid, gone))
        Option.Some(found) -> sweptSpends(store, pool, txid, rest, gone, others)

fn keyForOutpoint(spend: String) -> Result<Bytes, String>
    ? "The Set key for an Output named the way the Mempool names it."
    keyForParts(String.split(spend, ":"))

fn keyForParts(parts: List<String>) -> Result<Bytes, String>
    ? "The two halves of the name, back into a key."
    match parts
        [] -> Result.Err("an Output name is a Transaction Id and a position, got nothing")
        [head, ..tail] -> keyForRest(head, tail)

verify keyForParts
    keyForParts([]) => Result.Err("an Output name is a Transaction Id and a position, got nothing")
    keyForParts(["f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", "0"]) => Domain.UtxoStore.unspentKey("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", 0)

fn keyForRest(txid: String, rest: List<String>) -> Result<Bytes, String>
    ? "The position, which a name without one has not got."
    match rest
        [] -> Result.Err("an Output name is a Transaction Id and a position, got only {txid}")
        [head, ..tail] -> Domain.UtxoStore.unspentKey(txid, Result.withDefault(Int.fromString(head), 0))

verify keyForRest
    keyForRest("aa", []) => Result.Err("an Output name is a Transaction Id and a position, got only aa")
    keyForRest("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", ["0"]) => Domain.UtxoStore.unspentKey("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", 0)

fn restoring(network: Network, store: Store, pool: Mempool, unconfirmed: List<Carried>, tipHeight: Int, back: Int, offered: Int) -> Result<Mempool, String>
    ? "What a Reorganisation put back in flight, offered to the Mempool again."
      "Offered, not placed. A Transaction from an abandoned Block was valid on"
      "the branch that carried it, and that is no longer the question: what"
      "matters is whether it is valid on the branch we have just moved to. A"
      "reorganisation whose new Blocks spend the same Outputs is the ordinary"
      "shape of one rather than an edge case, and putting such a Transaction"
      "back unasked would mean holding a double spend and announcing it to"
      "every Peer. So each goes through the same admission as anything else:"
      "the Set is asked, the ones whose Outputs have gone are refused, and"
      "first-seen-wins settles anything the new branch already claimed."
      "The bytes are what is offered, not the decoded Transaction, because"
      "the Mempool has to be able to hand them back verbatim to a Peer that"
      "asks -- which is why the rewind carries them (#147)."
      "They arrive lowest Block first, so a parent is offered before any child"
      "that spends it. Offered the other way round, the child would find its"
      "parent's Output missing from the Set and be refused for good."
    ! [Console.print, Infra.Kv.get]
    match unconfirmed
        [] -> saidRestored(pool, back, offered)
        [head, ..tail] -> restoringOne(network, store, pool, head, tail, tipHeight, back, offered)

fn restoringOne(network: Network, store: Store, pool: Mempool, one: Carried, rest: List<Carried>, tipHeight: Int, back: Int, offered: Int) -> Result<Mempool, String>
    ? "One of them, through the ordinary door."
    ! [Console.print, Infra.Kv.get]
    landing = Infra.Mempool.admitting(network, store, pool, one.bytes, tipHeight)?
    restoring(network, store, poolAfter(pool, landing), rest, tipHeight, back + oneIfAdmitted(landing), offered)

fn poolAfter(pool: Mempool, landing: Landing) -> Mempool
    ? "The Mempool that admission left behind."
      "A refusal leaves it exactly as it was, which is the answer for a"
      "Transaction the new branch has already spent out from under."
    match landing
        Landing.Admitted(after, held) -> after
        _ -> pool

verify poolAfter
    count(poolAfter(Domain.Mempool.empty(1000), Landing.Duplicate)) => 0
    count(poolAfter(Domain.Mempool.empty(1000), Landing.Rejected("no"))) => 0
    count(poolAfter(Domain.Mempool.empty(1000), Landing.Conflicted("aa"))) => 0

fn count(pool: Mempool) -> Int
    ? "How many the Mempool holds, for the cases just above."
    Domain.Mempool.count(pool)

verify count
    count(Domain.Mempool.empty(1000)) => 0

fn oneIfAdmitted(landing: Landing) -> Int
    ? "One for a Transaction that came back, nothing for one that did not."
    match landing
        Landing.Admitted(after, held) -> 1
        _ -> 0

verify oneIfAdmitted
    oneIfAdmitted(Landing.Duplicate) => 0
    oneIfAdmitted(Landing.Rejected("no")) => 0
    oneIfAdmitted(Landing.Conflicted("aa")) => 0

fn saidRestored(pool: Mempool, back: Int, offered: Int) -> Result<Mempool, String>
    ? "Say what the disconnect put back, unless it put nothing."
      "Reported by what was offered rather than by what was admitted, and the"
      "difference between the two numbers is the point: a Reorganisation whose"
      "new Blocks spend the same Outputs offers Transactions that are refused,"
      "and a line saying 3 offered, 0 admitted is the correct outcome rather"
      "than a silence that could equally mean nothing was carried at all."
    ! [Console.print]
    match offered == 0
        true -> Result.Ok(pool)
        false -> toldRestored(pool, back, offered)

fn toldRestored(pool: Mempool, back: Int, offered: Int) -> Result<Mempool, String>
    ? "A Reorganisation putting Transactions back in flight is worth a line:"
      "it is the moment a spend that looked settled stops being settled."
    ! [Console.print]
    _said = Console.print("mempool: {offered} Transaction(s) offered back from disconnected Block(s), {back} admitted; holding {Domain.Mempool.count(pool)} ({Domain.Mempool.bytes(pool)} bytes)")
    Result.Ok(pool)

fn saidLineIfPlain(watch: Watching, line: String) -> Unit
    ? "One line for the plain log; the Screen draws the same fact."
    ! [Console.print]
    match watch.view
        Option.None -> Console.print(line)
        Option.Some(view) -> Unit

fn saidErrorIfPlain(watch: Watching, line: String) -> Unit
    ? "One line of complaint for the plain log, and silence under a Screen."
      "The Screen owns the terminal in raw mode: a line printed into it lands"
      "wherever the cursor happens to be, and with no carriage return the next"
      "one starts from that column. That is what turned a frame into a"
      "staircase."
    ! [Console.error]
    match watch.view
        Option.None -> Console.error(line)
        Option.Some(view) -> Unit

fn saidLinesIfPlain(watch: Watching, lines: List<String>) -> Unit
    ? "The same, for several."
    ! [Console.print]
    match watch.view
        Option.None -> saidBlocks(lines)
        Option.Some(view) -> Unit

fn blockLinesOf(connectedCount: Int, views: List<BlockView>) -> List<String>
    ? "A line per Block, but only when every connected Block is in the ring"
      "-- otherwise lines for the newest eight of thousands would be noise"
      "pretending to be news."
    match connectedCount > Domain.Snapshot.blockLimit()
        true -> []
        false -> blockLines(List.reverse(views), [])

verify blockLinesOf
    blockLinesOf(9000, []) => []
    blockLinesOf(1, [BlockView(height = 5, blockId = "aa", transactions = 2, bytes = 300, atMs = 0)]) => ["block 5 aa 2 tx 300 bytes"]

fn blockLines(oldestFirst: List<BlockView>, acc: List<String>) -> List<String>
    ? "Each view rendered, oldest first, the order they connected in."
    match oldestFirst
        [] -> List.reverse(acc)
        [head, ..tail] -> blockLines(tail, List.prepend(Domain.Screenlines.blockLine(head), acc))

verify blockLines
    blockLines([], []) => []
    blockLines([BlockView(height = 5, blockId = "aa", transactions = 2, bytes = 300, atMs = 0)], []) => ["block 5 aa 2 tx 300 bytes"]

fn saidBlocks(lines: List<String>) -> Unit
    ? "Print each line in turn."
    ! [Console.print]
    match lines
        [] -> Unit
        [head, ..tail] -> saidNext(head, tail)

fn saidNext(line: String, rest: List<String>) -> Unit
    ? "One line, then the rest."
    ! [Console.print]
    _printed = Console.print(line)
    saidBlocks(rest)

fn watchAfterBuild(watch: Watching, views: List<BlockView>) -> Watching
    ? "The Blocks that just connected, into the Snapshot's ring and its tip."
      "Nothing connected moves nothing: the usual announce of a Block already"
      "held leaves the Snapshot exactly as it was."
    match views
        [] -> watch
        [newest, ..older] -> Watching(snapshot = Domain.Snapshot.tipAt(ringed(watch.snapshot, List.reverse(views)), newest.height, newest.blockId, newest.atMs), heard = watch.heard, anyHeardMs = watch.anyHeardMs, saidPeersMs = watch.saidPeersMs, tendedMs = watch.tendedMs, view = watch.view, leaving = watch.leaving, stopAskedMs = watch.stopAskedMs, pollReturnedMs = watch.pollReturnedMs, handling = watch.handling)

verify watchAfterBuild
    watchAfterBuild(freshWatch(0), []).snapshot.tip.height => 0
    watchAfterBuild(freshWatch(0), [BlockView(height = 5, blockId = "aa", transactions = 2, bytes = 300, atMs = 9)]).snapshot.tip.height => 5
    watchAfterBuild(freshWatch(0), [BlockView(height = 5, blockId = "aa", transactions = 2, bytes = 300, atMs = 9)]).snapshot.tip.blockId => "aa"
    List.len(watchAfterBuild(freshWatch(0), [BlockView(height = 5, blockId = "aa", transactions = 2, bytes = 300, atMs = 9)]).snapshot.rings.blocks) => 1

fn ringed(snapshot: Snapshot, oldestFirst: List<BlockView>) -> Snapshot
    ? "Each connected Block into the ring, oldest first so the newest ends"
      "up at the front."
    match oldestFirst
        [] -> snapshot
        [head, ..tail] -> ringed(Domain.Snapshot.notedBlock(snapshot, head), tail)

verify ringed
    ringed(Domain.Snapshot.started(0), []).rings.blocks => []
    List.len(ringed(Domain.Snapshot.started(0), [BlockView(height = 5, blockId = "aa", transactions = 2, bytes = 300, atMs = 9)]).rings.blocks) => 1

fn haveOf(store: Store) -> Result<Int, String>
    ? "How many Heights the Header tree already reaches, for the Locator."
      "One more than the tip's Height, counting genesis -- so one for a tree"
      "that holds nothing yet, because the phase below plants genesis before"
      "it asks for anything. The download phase gets the same number by"
      "counting h: up from genesis, which is a walk of the whole chain and is"
      "not something to do every time a Block is announced."
    ! [Infra.Kv.get]
    tip = Infra.Headers.tipOf(store)?
    Result.Ok(heightOf(tip) + 1)

verify haveOf
    haveOf(Infra.Store.fixture([])) => Result.Ok(1)
    haveOf(Infra.Store.fixture([(Domain.TreeStore.bestTipKey()?, Domain.Index.encodeBlockId("aa")?), (Domain.TreeStore.headerKey("aa")?, Domain.TreeStore.encodeHeld(Domain.TreeStore.heldFor(Domain.HeaderTree.Placement(blockId = "aa", parentId = Domain.TreeStore.sampleParentId(), height = 318980, work = 1), Domain.TreeStore.sampleHeaderHex()))?)])) => Result.Ok(318981)

fn tipHeightOf(store: Store) -> Result<Int, String>
    ? "The Height of the branch with the most work."
    ! [Infra.Kv.get]
    tip = Infra.Headers.tipOf(store)?
    Result.Ok(heightOf(tip))

verify tipHeightOf
    tipHeightOf(Infra.Store.fixture([])) => Result.Ok(0)
    tipHeightOf(Infra.Store.fixture([(Domain.TreeStore.bestTipKey()?, Domain.Index.encodeBlockId("aa")?), (Domain.TreeStore.headerKey("aa")?, Domain.TreeStore.encodeHeld(Domain.TreeStore.heldFor(Domain.HeaderTree.Placement(blockId = "aa", parentId = Domain.TreeStore.sampleParentId(), height = 318980, work = 1), Domain.TreeStore.sampleHeaderHex()))?)])) => Result.Ok(318980)

fn heightOf(tip: Option<Placement>) -> Int
    ? "Where a tip sits, or genesis when there is no tip yet."
      "Zero for nothing planted is right rather than convenient: the Header"
      "phase plants genesis before it asks anything, so a tree with no tip is"
      "a tree about to have genesis for one."
    match tip
        Option.None -> 0
        Option.Some(placement) -> placement.height

verify heightOf
    heightOf(Option.None) => 0
    heightOf(Option.Some(Placement(blockId = "aa", parentId = "bb", height = 7, work = 1))) => 7

fn stopSaid(log: Log, askedMs: Int, nowMs: Int) -> Result<Log, String>
    ? "One line if the stop took longer than its budget to land (#268)."
    ! [Disk.appendText, Time.unixMs]
    match Bool.and(askedMs > 0, Domain.Watchdog.overrun(askedMs, nowMs, Domain.Watchdog.stopBudgetMs()))
        false -> Result.Ok(log)
        true -> Infra.Metrics.noting(log, "watchdog", Domain.Watchdog.slowStop(nowMs - askedMs))

fn stopAskedNow(watch: Watching, nowMs: Int) -> Watching
    ? "When the loop first saw the stop, unless a walk saw it earlier (#268)."
    match watch.stopAskedMs > 0
        true -> watch
        false -> Watching(snapshot = watch.snapshot, heard = watch.heard, anyHeardMs = watch.anyHeardMs, saidPeersMs = watch.saidPeersMs, tendedMs = watch.tendedMs, view = watch.view, leaving = watch.leaving, stopAskedMs = nowMs, pollReturnedMs = watch.pollReturnedMs, handling = watch.handling)

verify stopAskedNow
    stopAskedNow(freshWatch(0), 40).stopAskedMs => 40
    stopAskedNow(stopAskedNow(freshWatch(0), 40), 90).stopAskedMs => 40

fn restoredFor(view: Option<View>) -> Unit
    ? "Restore the terminal when there is a Screen to take down."
    ! [Terminal.disableRawMode, Terminal.flush, Terminal.showCursor]
    match view
        Option.None -> Unit
        Option.Some(one) -> Infra.Screen.restored()

fn firstAfterNone(state: Following, heldBefore: Int) -> Following
    ? "A Peer seated into an empty pool is asked to bring the chain up to"
      "date (#217), because whatever was missed while alone is what it has."
      "Nothing else re-runs the catch-up: an inv does, and a node that lost"
      "every Peer mid-walk will not hear one until a Peer is seated. Its"
      "Handshake counts as being heard from, so the silence rule does not"
      "end the run for the seconds between seating and its first Message."
      "The claim is held for the walk with no reason to print, which is"
      "how the walk tells it from an Announcement."
    ! [Time.unixMs]
    match Bool.and(heldBefore == 0, List.len(Infra.Peers.peerKeys(state.pool)) > 0)
        false -> state
        true -> withGate(heardFrom(state, firstKey(state.pool), Time.unixMs()), Domain.Catchup.held(state.gate, firstKey(state.pool), ""))

fn heardFrom(state: Following, key: Int, nowMs: Int) -> Following
    ? "This Peer just spoke; remember when, for it and for the pool."
    withWatch(state, heardAt(state.watch, key, nowMs))

fn heardAt(watch: Watching, key: Int, nowMs: Int) -> Watching
    ? "One Peer's voice moves its own timestamp and the pool's."
    Watching(snapshot = watch.snapshot, heard = Map.set(watch.heard, key, nowMs), anyHeardMs = nowMs, saidPeersMs = watch.saidPeersMs, tendedMs = watch.tendedMs, view = watch.view, leaving = watch.leaving, stopAskedMs = watch.stopAskedMs, pollReturnedMs = watch.pollReturnedMs, handling = watch.handling)

verify heardAt
    heardAt(freshWatch(0), 3, 900).anyHeardMs => 900
    Map.get(heardAt(freshWatch(0), 3, 900).heard, 3) => Option.Some(900)
    heardAt(freshWatch(7), 3, 900).saidPeersMs => 7
    heardAt(sampleTended(55), 3, 900).tendedMs => 55

fn sampleTended(tendedMs: Int) -> Watching
    ? "A Watching that has looked at its clock, for the cases here."
    Watching(snapshot = Domain.Snapshot.started(0), heard = Map.fromList([]), anyHeardMs = 0, saidPeersMs = 0, tendedMs = tendedMs, view = Option.None, leaving = false, stopAskedMs = 0, pollReturnedMs = 0, handling = "starting")

verify sampleTended
    sampleTended(55).tendedMs => 55

fn afterAccepting(state: Following, taken: Accepted) -> Following
    ? "A caller admitted takes the next key, so the one after it is free."
    Following(pool = taken.pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = nextAfter(state.nextKey, taken.seated), watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate)

fn nextAfter(nextKey: Int, seated: Option<Int>) -> Int
    ? "One further on if a caller took a key, unchanged if none did."
    match seated
        Option.None -> nextKey
        Option.Some(key) -> key + 1

verify nextAfter
    nextAfter(4, Option.None) => 4
    nextAfter(4, Option.Some(4)) => 5

fn tendEveryMs() -> Int
    ? "How often the loop looks at its own clock: once a second, which is"
      "the cadence a quiet tick already gave it."
      "It is a clock and not a tick because a busy turn takes it too now"
      "(#201). A node handling a Message a millisecond would otherwise"
      "redraw a frame and walk its Peers for every one of them, and the"
      "watcher cannot read a frame faster than this anyway."
    1000

verify tendEveryMs
    tendEveryMs() => 1000

fn minding(state: Following, nowMs: Int) -> Result<Following, String>
    ? "The loop's own clock, looked at on every turn whether or not a"
      "Message arrived, and at most once a second."
      "This is everything the loop owes somebody watching it: the frame, the"
      "keys and the record that has come due. None of it was ever about the"
      "pool being silent, and all of it used to happen only when the pool"
      "was (#201). A caller waiting to be admitted was here too, which made"
      "every caller wait up to a second; the acceptor takes them now."
    ! [
        Console.print,
        Disk.appendText,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Domain.Screenlines.due(state.watch.tendedMs, nowMs, tendEveryMs())
        false -> Result.Ok(state)
        true -> minded(boarded(state, nowMs)?, nowMs)

fn minded(state: Following, nowMs: Int) -> Result<Following, String>
    ? "The clock has come round: the Snapshot's company brought up to date,"
      "the record written if it is due, and then the Screen's share or the"
      "plain log's."
    ! [
        Console.print,
        Disk.appendText,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    fresh = withTended(refreshed(state, nowMs), nowMs)
    kept = withLog(fresh, marking(fresh, fresh.pool, "listen", fresh.watch.snapshot.tip.height, fresh.watch.snapshot.tip.height, false)?)
    tended(kept, nowMs)

record Admitted
    state: Following
    failed: Bool

fn callerTaken(state: Following, nowMs: Int) -> Result<Admitted, String>
    ? "One caller off the listener, if one is queued: what the acceptor asks"
      "each time the listener is ready, so a caller is admitted as it"
      "arrives rather than on the clock's next second. Quiet inbound Peers"
      "are swept first, so a slot freed now is one this caller can have."
      "failed is a listener that would not give a caller at all."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Tcp.accept, Tcp.close, Tcp.peerAddress,
        Time.unixMs,
    ]
    swept = quietSwept(state, Infra.Peers.quietInbound(state.pool, nowMs), nowMs)?
    taken = Infra.Peers.accepting(swept.pool, swept.nextKey)?
    Result.Ok(Admitted(state = afterAccepting(swept, taken), failed = taken.failed))

verify callerTaken
    callerTaken(sampleFollowing(), 0)?.failed => false

fn listenerOf(state: Following) -> Option<Tcp.Socket>
    ? "The listener the acceptor parks on, when the node answers on a port."
    Infra.Peers.listenerOf(state.pool)

verify listenerOf
    listenerOf(sampleFollowing()) => Option.None

fn quietSwept(state: Following, quiet: List<Int>, nowMs: Int) -> Result<Following, String>
    ? "Take back the slots of inbound Peers that have gone quiet (#330)."
      "Before accepting rather than after, so a slot freed now is one a"
      "caller can have now. Swept when the acceptor is asked, which is when"
      "a caller arrives and once a second otherwise, so this walks the table"
      "once a caller and not once a Message."
    ! [Console.error, Disk.appendText, Tcp.close, Time.unixMs]
    match quiet
        [] -> Result.Ok(state)
        [head, ..tail] -> quietSweptOne(state, head, tail, nowMs)

fn quietSweptOne(state: Following, key: Int, rest: List<Int>, nowMs: Int) -> Result<Following, String>
    ? "One of them, then the others."
      "Said out loud and noted, because a Peer going without being at fault"
      "is worth being able to see afterwards: it is the difference between a"
      "table of crawlers and a table doing something."
    ! [Console.error, Disk.appendText, Tcp.close, Time.unixMs]
    _said = saidErrorIfPlain(state.watch, "dropping peer {key}: inbound and silent for {Int.div(Infra.Peers.peerIdleDeadlineMs(), 60000)} minutes")
    noted = Infra.Metrics.noting(state.log, "peer", "inbound {key} swept: silent past the deadline, slot taken back (#330)")?
    shrunk = Infra.Peers.dropOne(state.pool, key)?
    quietSwept(withGate(withLog(withPool(state, shrunk), noted), Domain.Catchup.forgotten(state.gate, key)), rest, nowMs)

fn tended(state: Following, nowMs: Int) -> Result<Following, String>
    ? "A Screen gets a frame, a plain run gets the line that has come due."
    ! [
        Console.print,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
    ]
    match state.watch.view
        Option.None -> Result.Ok(saidStats(state, nowMs))
        Option.Some(view) -> attended(state, view, nowMs)

fn withTended(state: Following, nowMs: Int) -> Following
    ? "The state, with the clock that gates the next look moved on."
    withWatch(state, Watching(snapshot = state.watch.snapshot, heard = state.watch.heard, anyHeardMs = state.watch.anyHeardMs, saidPeersMs = state.watch.saidPeersMs, tendedMs = nowMs, view = state.watch.view, leaving = state.watch.leaving, stopAskedMs = state.watch.stopAskedMs, pollReturnedMs = state.watch.pollReturnedMs, handling = state.watch.handling))

fn leavingNow(state: Following) -> Following
    ? "The state, told that q was answered with y."
      "Said rather than done, because the turn this was decided on may have"
      "a Message in its hand: the caller stops on the way out and the"
      "terminal is given back there, in the one place that does it."
    withWatch(state, Watching(snapshot = state.watch.snapshot, heard = state.watch.heard, anyHeardMs = state.watch.anyHeardMs, saidPeersMs = state.watch.saidPeersMs, tendedMs = state.watch.tendedMs, view = state.watch.view, leaving = true, stopAskedMs = 0, pollReturnedMs = state.watch.pollReturnedMs, handling = state.watch.handling))

fn staleRebuild(rebuilding: Option<Rebuilding>, nowMs: Int) -> Option<Rebuilding>
    ? "A rebuild nobody has answered for too long."
      "Without this a Peer that goes quiet after announcing a Block leaves"
      "the node waiting for a Message that is never coming, holding a Block"
      "it could have fetched in one round trip."
    match rebuilding
        Option.None -> Option.None
        Option.Some(pending) -> staleOr(pending, nowMs)

verify staleRebuild
    staleRebuild(Option.None, 20000) => Option.None
    staleRebuild(Option.Some(Rebuilding(blockId = "aa", hash = [], key = 2, askedMs = 0, compact = Option.None, asked = [])), 500) => Option.None
    staleRebuild(Option.Some(Rebuilding(blockId = "aa", hash = [], key = 2, askedMs = 0, compact = Option.None, asked = [])), 20000) => Option.Some(Rebuilding(blockId = "aa", hash = [], key = 2, askedMs = 0, compact = Option.None, asked = []))

fn staleOr(pending: Rebuilding, nowMs: Int) -> Option<Rebuilding>
    ? "Overdue, or still worth waiting for."
    match nowMs - pending.askedMs > rebuildDeadlineMs()
        true -> Option.Some(pending)
        false -> Option.None

verify staleOr
    staleOr(Rebuilding(blockId = "", hash = [], key = 0, askedMs = 0, compact = Option.None, asked = []), 20000) => Option.Some(Rebuilding(blockId = "", hash = [], key = 0, askedMs = 0, compact = Option.None, asked = []))
    staleOr(Rebuilding(blockId = "", hash = [], key = 0, askedMs = 0, compact = Option.None, asked = []), 500) => Option.None

fn attended(state: Following, view: View, nowMs: Int) -> Result<Following, String>
    ? "The Screen's share of a turn: keys first, then the frame."
      "Keys first, because a q pressed a second ago should not have to"
      "watch one more redraw before it is answered."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey]
    keys = Infra.Screen.drainedKeys()?
    acted = Domain.Screen.pressedAll(view, keys)
    match acted.answer
        Answer.StopNode -> Result.Ok(leavingNow(withView(state, acted.view)))
        _ -> drawnNow(withView(state, acted.view), acted.view, nowMs)

fn drawnNow(state: Following, view: View, nowMs: Int) -> Result<Following, String>
    ? "The frame onto the terminal."
      "Every look redraws: at the tip that is once a second, and the frame"
      "is a handful of lines. The catch-up's ten-second cadence arrives with"
      "the rest of #130."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    _drawn = Infra.Screen.shown(Domain.Screen.frameOf(view, state.watch.snapshot, nowMs))?
    Result.Ok(state)

fn withView(state: Following, view: View) -> Following
    ? "The state, with the Screen's View moved on."
    withWatch(state, Watching(snapshot = state.watch.snapshot, heard = state.watch.heard, anyHeardMs = state.watch.anyHeardMs, saidPeersMs = state.watch.saidPeersMs, tendedMs = state.watch.tendedMs, view = Option.Some(view), leaving = state.watch.leaving, stopAskedMs = state.watch.stopAskedMs, pollReturnedMs = state.watch.pollReturnedMs, handling = state.watch.handling))

fn anyoneLeft(held: Int, someoneToDial: Bool) -> Result<Unit, String>
    ? "A pool with nobody in it and nobody to dial ends the run."
      "Until #217 an empty pool alone did, on the reasoning that the top-up"
      "a moment ago was this turn's chance to refill it. That stopped being"
      "true with #202: the top-up starts a dial and does not wait, so the"
      "pool is empty for the five turns a Candidate takes to answer -- and"
      "was empty here with 602 Candidates in the Book when mainnet stopped."
    match Bool.or(held > 0, someoneToDial)
        true -> Result.Ok(Unit)
        false -> Result.Err("every Peer is gone and the Address Book has nothing left to dial")

verify anyoneLeft
    anyoneLeft(1, false) => Result.Ok(Unit)
    anyoneLeft(0, true) => Result.Ok(Unit)
    anyoneLeft(0, false) => Result.Err("every Peer is gone and the Address Book has nothing left to dial")

fn stillHeard(silentMs: Int, peers: Int, dialling: Bool) -> Result<Unit, String>
    ? "Whether anybody has said anything inside the idle deadline."
      "The same rule the pool's own poll enforced before the tick (#129):"
      "silence from everybody for the whole deadline is a node no longer"
      "connected to anything that is still talking. An empty pool that is"
      "still dialling is exempt (#359): there is nobody in it to hear, and"
      "anyoneLeft, asked first, is what ends a pool with nobody to dial."
    match Domain.Watchdog.unheard(silentMs, peers, dialling, Infra.Peers.idleDeadlineMs())
        Option.None -> Result.Ok(Unit)
        Option.Some(why) -> Result.Err(why)

verify stillHeard
    stillHeard(0, 3, false) => Result.Ok(Unit)
    stillHeard(149999, 3, true) => Result.Ok(Unit)
    stillHeard(150000, 3, true) => Result.Err("no Peer said anything for 150 seconds")
    stillHeard(174601, 0, true) => Result.Ok(Unit)
    stillHeard(150000, 0, false) => Result.Err("no Peer said anything for 150 seconds")

fn refreshed(state: Following, nowMs: Int) -> Following
    ? "The Snapshot's company brought up to date: who is connected, how"
      "long each has been quiet, and how many Candidates are on the shelf."
      "The rows come from the pool (#168), which is the only thing that"
      "knows them, and which the catch-up walks hold too -- so the Panel is"
      "the same Panel whichever phase draws it."
    withWatch(state, Watching(snapshot = Domain.Snapshot.withServing(Domain.Snapshot.withMempool(Domain.Snapshot.withCandidates(Domain.Snapshot.withPeers(state.watch.snapshot, Infra.Peers.company(state.pool)), Domain.AddressBook.sizeOf(state.book)), mempoolView(state.mempool)), Infra.Peers.selfAddress(state.pool)), heard = state.watch.heard, anyHeardMs = state.watch.anyHeardMs, saidPeersMs = state.watch.saidPeersMs, tendedMs = state.watch.tendedMs, view = state.watch.view, leaving = state.watch.leaving, stopAskedMs = state.watch.stopAskedMs, pollReturnedMs = state.watch.pollReturnedMs, handling = state.watch.handling))

fn mempoolView(pool: Mempool) -> MempoolView
    ? "The Mempool's four numbers, read through the accessors #28 built for"
      "exactly this Panel (#134)."
    MempoolView(held = Domain.Mempool.count(pool), bytes = Domain.Mempool.bytes(pool), cap = Domain.Mempool.capOf(pool), floorRate = Domain.Mempool.floorRate(pool))

fn saidStats(state: Following, nowMs: Int) -> Following
    ? "The Peer stats line, when it has come due and not before."
    ! [Console.print]
    match Domain.Screenlines.due(state.watch.saidPeersMs, nowMs, Domain.Screenlines.peerStatsEveryMs())
        false -> state
        true -> saidStatsNow(state, nowMs)

fn saidStatsNow(state: Following, nowMs: Int) -> Following
    ? "Say it, and remember when it was said."
    ! [Console.print]
    _said = Console.print(Domain.Screenlines.peersLine(state.watch.snapshot.company, nowMs))
    withWatch(state, Watching(snapshot = state.watch.snapshot, heard = state.watch.heard, anyHeardMs = state.watch.anyHeardMs, saidPeersMs = nowMs, tendedMs = state.watch.tendedMs, view = state.watch.view, leaving = state.watch.leaving, stopAskedMs = state.watch.stopAskedMs, pollReturnedMs = state.watch.pollReturnedMs, handling = state.watch.handling))

fn handle(state: Following, key: Int, command: String, body: List<Int>) -> Result<Following, String>
    ? "The three Messages this loop acts on; every other one is ignored."
      "A ping has to be answered or the Peer eventually drops the connection,"
      "and it is answered to the Peer that sent it rather than to whichever"
      "one the node happens to be talking to."
      "An unsolicited headers is still read as the chain having moved -- a"
      "Peer that was sent no sendheaders should not be sending one, and a"
      "Peer that does is still telling us something -- but it is weighed"
      "before it is acted on now (#300), because it used to be acted on"
      "whatever it said."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.close, Tcp.writeNow,
        Time.unixMs,
    ]
    match command
        "inv" -> onAnnouncement(state, key, body)
        "cmpctblock" -> onCompact(state, key, body)
        "blocktxn" -> onBlockTxn(state, key, body)
        "tx" -> onTransaction(state, key, body)
        "getdata" -> onAsked(state, key, body)
        "getheaders" -> onAskedHeaders(state, key, body)
        "headers" -> onAnnouncedHeaders(state, key, body)
        "addr" -> onAddresses(state, key, body)
        "getaddr" -> onAskedAddresses(state, key)
        "ping" -> onPing(state, key, body)
        _ -> Result.Ok(state)

fn onAnnouncement(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "Blocks first, then Transactions."
      "Both are announced down the same Message. A Block moving the chain"
      "outranks anything unconfirmed -- what a Block confirms leaves the"
      "Mempool anyway -- so an Announcement carrying both is followed for the"
      "Block, and the Transactions in it will be offered again by somebody."
    ! [Console.error, Disk.appendText, Infra.Kv.get, Tcp.close, Tcp.writeNow, Time.unixMs]
    match Domain.Inventory.tooMany(body)
        true -> losingPeer(state, key, "an inv naming {Domain.Inventory.announcedCount(body)} entries, above the {Domain.Inventory.maxEntries()} Core allows (MAX_INV_SZ, #358)")
        false -> onAnnouncedWithin(state, key, body)

fn onAnnouncedWithin(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "Blocks first, then Transactions."
    ! [Console.error, Disk.appendText, Infra.Kv.get, Tcp.close, Tcp.writeNow, Time.unixMs]
    announced = Domain.Inventory.blockHashesOf(body)
    match announced
        [] -> onOffered(state, key, Domain.Inventory.txHashesOf(body))
        [head, ..tail] -> onAnnouncedBlocks(state, key, announced, head)

fn servedAddressCap() -> Int
    ? "How many Candidates one getaddr is answered with."
      "A quarter of what an addr Message may carry, which is the shape of"
      "Core's own answer: enough to be worth asking for, short of handing"
      "over the whole Book to whoever asks first."
    250

verify servedAddressCap
    servedAddressCap() => 250

fn onAskedAddresses(state: Following, key: Int) -> Result<Following, String>
    ? "A Peer asking who we know, answered out of the Address Book (#210)."
      "This was in the arm that ignores everything, which made this node a"
      "dead end in the gossip graph: it asked every Peer for addresses and"
      "gave none back, so anybody who did find it learned nothing and had"
      "no reason to keep it."
    ! [Console.error, Console.print, Tcp.close, Tcp.writeNow, Time.unixMs]
    offered = parsedAll(List.take(Map.keys(state.book), servedAddressCap()), Domain.Network.portOf(state.pool.network), [])
    answered = Infra.Peers.tell(state.pool, key, "addr", Domain.Addr.payload(offered, Int.div(Time.unixMs(), 1000), 0)?)?
    Result.Ok(saidOffered(relayedAddresses(withPool(state, answered), List.len(offered)), List.len(offered), key))

fn relayedAddresses(state: Following, handed: Int) -> Following
    ? "The Snapshot's tally of Addresses handed on (#383)."
    withWatch(state, Watching.update(state.watch, snapshot = Domain.Snapshot.withRelayedAddresses(state.watch.snapshot, handed)))

verify relayedAddresses
    relayedAddresses(sampleFollowing(), 250).watch.snapshot.relayed.addresses => 250

fn relayedTransaction(state: Following, others: Int) -> Following
    ? "One more Transaction told onward, when there was anybody to tell (#383)."
    match others > 0
        false -> state
        true -> withWatch(state, Watching.update(state.watch, snapshot = Domain.Snapshot.withRelayedTransactions(state.watch.snapshot, 1)))

verify relayedTransaction
    relayedTransaction(sampleFollowing(), 0).watch.snapshot.relayed.transactions => 0
    relayedTransaction(sampleFollowing(), 2).watch.snapshot.relayed.transactions => 1

fn relayedBlock(state: Following) -> Following
    ? "One more Block served to a Peer that asked (#383)."
    withWatch(state, Watching.update(state.watch, snapshot = Domain.Snapshot.withRelayedBlocks(state.watch.snapshot, 1)))

verify relayedBlock
    relayedBlock(relayedBlock(sampleFollowing())).watch.snapshot.relayed.blocks => 2

fn parsedAll(addresses: List<String>, port: Int, acc: List<PeerAddress>) -> List<PeerAddress>
    ? "The Book's keys as Peer Addresses, passing over any that will not"
      "parse -- they came from a Peer and a Peer may say anything."
    match addresses
        [] -> List.reverse(acc)
        [head, ..tail] -> parsedAll(tail, port, keptParsed(Domain.Address.fromPeerText(head, port), acc))

verify parsedAll
    List.len(parsedAll([], 8333, [])) => 0
    List.len(parsedAll(["1.2.3.4:8333"], 8333, [])) => 1
    List.len(parsedAll(["not an address"], 8333, [])) => 0
    parsedAll(["1.2.3.4", "5.6.7.8"], 8333, []) => [Domain.Address.fromOctetsOn([1, 2, 3, 4], 8333)?, Domain.Address.fromOctetsOn([5, 6, 7, 8], 8333)?]

fn keptParsed(parsed: Result<PeerAddress, String>, acc: List<PeerAddress>) -> List<PeerAddress>
    ? "One address in, if it is one."
    match parsed
        Result.Err(why) -> acc
        Result.Ok(address) -> List.prepend(address, acc)

verify keptParsed
    List.len(keptParsed(Result.Err("no"), [])) => 0
    List.len(keptParsed(Domain.Address.fromOctetsOn([1, 2, 3, 4], 8333), [])) => 1

fn saidOffered(state: Following, howMany: Int, key: Int) -> Following
    ? "Say what was handed over, unless it was nothing."
    ! [Console.print]
    match howMany == 0
        true -> state
        false -> saidOfferedNow(state, howMany, key)

fn saidOfferedNow(state: Following, howMany: Int, key: Int) -> Following
    ? "The line itself."
    ! [Console.print]
    _said = saidLineIfPlain(state.watch, "offered {howMany} Candidate(s) to peer {key}")
    state

fn onAddresses(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "Peers this Peer says exist, into the Address Book."
      "Every one of them is a claim by a Peer under no obligation to be"
      "honest, which is why they go in as Candidates: nothing is believed"
      "until a Handshake completes, and who told us is recorded beside each"
      "one so that a Peer feeding us rubbish can be seen to have done it."
    ! [Console.print]
    offered = routableOnly(Domain.Addr.addressesOf(body), [])
    grown = Domain.AddressBook.heardAll(state.book, renderedAll(offered, []), key)
    _said = heardIfPlain(state.watch, List.len(offered), key, Domain.AddressBook.sizeOf(grown))
    Result.Ok(Following(pool = state.pool, store = state.store, blocks = state.blocks, book = grown, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate))

fn heardIfPlain(watch: Watching, offered: Int, key: Int, held: Int) -> Unit
    ? "The heard line for the plain log; the Panel shows the Book."
    ! [Console.print]
    match watch.view
        Option.None -> saidHeard(offered, key, held)
        Option.Some(view) -> Unit

fn saidHeard(offered: Int, key: Int, held: Int) -> Unit
    ? "Say what was heard, unless nothing was."
      "A Peer relaying a single address it just learned is the common case"
      "and is not worth a line; a Peer answering our getaddr with hundreds"
      "is worth one."
    ! [Console.print]
    match offered == 0
        true -> Unit
        false -> Console.print("peer {key} named {offered} Peer(s); the Address Book holds {held}")

fn routableOnly(addresses: List<PeerAddress>, acc: List<PeerAddress>) -> List<PeerAddress>
    ? "The offered addresses a Peer could actually be reached at (#291)."
      "Core keeps nothing outside IsRoutable, and neither should the Book:"
      "a loopback, private or this-network Candidate is one this node would"
      "dial to nowhere, and a Peer offering a thousand of them was filling"
      "the Book with them."
    match addresses
        [] -> List.reverse(acc)
        [head, ..tail] -> routableOnly(tail, keptIfRoutable(head, acc))

verify routableOnly
    routableOnly([], []) => []
    List.len(routableOnly([Domain.Address.fromPeerText("1.2.3.4:8333", 8333)?, Domain.Address.fromPeerText("10.0.0.1:8333", 8333)?, Domain.Address.fromPeerText("127.0.0.1:8333", 8333)?], [])) => 1

fn keptIfRoutable(address: PeerAddress, acc: List<PeerAddress>) -> List<PeerAddress>
    ? "Kept if routable, dropped if not."
    match Domain.Address.routable(address)
        true -> List.prepend(address, acc)
        false -> acc

verify keptIfRoutable
    List.len(keptIfRoutable(Domain.Address.fromPeerText("1.2.3.4:8333", 8333)?, [])) => 1
    List.len(keptIfRoutable(Domain.Address.fromPeerText("192.168.1.1:8333", 8333)?, [])) => 0

fn renderedAll(addresses: List<PeerAddress>, acc: List<String>) -> List<String>
    ? "Each Peer Address as the text the Address Book keys it by."
    match addresses
        [] -> List.reverse(acc)
        [head, ..tail] -> renderedAll(tail, List.prepend(Domain.Address.toString(head), acc))

verify renderedAll
    renderedAll([], []) => []
    List.len(renderedAll([Domain.Address.fromString("1.2.3.4")?], [])) => 1
    renderedAll([Domain.Address.fromString("1.2.3.4")?], []) => ["1.2.3.4:8333"]

fn onMoved(state: Following, key: Int, why: String) -> Result<Following, String>
    ? "The chain says it has moved, so the walk is asked to find out how"
      "far from that Peer -- unless it said the same thing a moment ago and"
      "nothing came of it (#300)."
      "What arrived is not trusted to be the new tip, or to be on the branch"
      "with the most work, or to be anything but a Block Id -- the Header"
      "phase settles all three, and a Peer that announced something already"
      "held simply moves nothing."
      "That last sentence is why the gate is here. Moving nothing costs the"
      "Header round trip, the realignment and the walk anyway, so a Peer"
      "that can make the node do it for free can make it do it for ever."
      "A claim allowed now is held for the walk, which takes it on its next"
      "ask; the Catch-up runs beside the Peers rather than in place of them."
    ! [Disk.appendText, Time.unixMs]
    nowMs = Time.unixMs()
    match Domain.Catchup.allowed(state.gate, key, nowMs)
        false -> holdingBack(state, key, why)
        true -> Result.Ok(withGate(state, Domain.Catchup.held(state.gate, key, why)))

fn holdingBack(state: Following, key: Int, why: String) -> Result<Following, String>
    ? "This Peer wasted its last Catch-up and is inside its cooldown, so its"
      "claim is kept rather than obeyed."
      "Kept rather than dropped: a node following one Peer -- which is how"
      "this program is usually started, and how it is usually run -- would"
      "otherwise sit a Block behind until the next one was mined. The walk"
      "takes the claim the moment the cooldown passes."
    ! [Disk.appendText, Time.unixMs]
    noted = Infra.Metrics.noting(state.log, "fault", "peer {key} says the chain moved inside its cooldown ({why}); held until it passes (#300)")?
    Result.Ok(withGate(withLog(state, noted), Domain.Catchup.held(state.gate, key, why)))

fn standingNow(store: Store) -> Result<String, String>
    ? "Where the node stands, as one string: the tip of the branch with the"
      "most work, its Height, and the Height the Set has been built to."
      "One string because the only question asked of it is whether a"
      "Catch-up changed anything, and the Block Id is in it because a"
      "Reorganisation can move the tip without moving its Height."
    ! [Infra.Kv.get]
    tip = Infra.Headers.tipOf(store)?
    set = standingOf(store)?
    Result.Ok("{tipIdOf(tip)}:{heightOf(tip)}:{set}")

fn tipIdOf(tip: Option<Placement>) -> String
    ? "The Block Id of the branch with the most work, or nothing for a tree"
      "with nothing planted in it yet."
    match tip
        Option.None -> ""
        Option.Some(placement) -> placement.blockId

verify tipIdOf
    tipIdOf(Option.None) => ""
    tipIdOf(Option.Some(Domain.HeaderTree.Placement(blockId = "aa", parentId = "bb", height = 3, work = 1))) => "aa"

fn onAnnouncedHeaders(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "A headers Message nobody asked for, weighed before it is obeyed."
      "This was the cheapest way to drive the node through a whole Catch-up"
      "(#300): any Peer, an inbound stranger included, could send an empty"
      "headers and be answered with the Header round trip, the realignment,"
      "the body walk and the Set build, and send another a moment later."
      "Three things stand in the way now. It has to decode, or the Peer"
      "broke the protocol and loses its place. It has to name a Header the"
      "tree has not already placed, or there is nothing in it that could"
      "move anything. And that Header has to prove work under the Network's"
      "own limit, which is the part that costs the sender something: eighty"
      "bytes proving nothing are free to mint, and free is what made this"
      "worth doing."
    ! [Console.error, Disk.appendText, Infra.Kv.get, Tcp.close, Time.unixMs]
    match Domain.Block.headersOf(body)
        Result.Err(why) -> losingPeer(state, key, "peer {key} sent an unasked-for headers that would not decode: {why}")
        Result.Ok(headers) -> weighingHeaders(state, key, headers)

fn weighingHeaders(state: Following, key: Int, headers: List<BlockHeader>) -> Result<Following, String>
    ? "The first Header in the announcement the tree has not placed, if the"
      "announcement holds one. An empty headers holds none, which is the"
      "case that started this."
    ! [Console.error, Disk.appendText, Infra.Kv.get, Tcp.close, Time.unixMs]
    unplaced = firstUnplaced(state.store, headers)?
    match unplaced
        Option.None -> ignoredAnnouncement(state, key, "{List.len(headers)} unasked-for Header(s)")
        Option.Some(header) -> provenEnough(state, key, header)

fn firstUnplaced(store: Store, headers: List<BlockHeader>) -> Result<Option<BlockHeader>, String>
    ? "The first Header here that the tree has not placed."
    ! [Infra.Kv.get]
    match headers
        [] -> Result.Ok(Option.None)
        [head, ..tail] -> unplacedOrNext(store, head, tail, Infra.Store.get(store, Domain.TreeStore.headerKey(head.blockId)?)?)

fn unplacedOrNext(store: Store, header: BlockHeader, rest: List<BlockHeader>, held: Option<Bytes>) -> Result<Option<BlockHeader>, String>
    ? "A Header the k: keyspace does not hold is the one we are looking for."
    ! [Infra.Kv.get]
    match held
        Option.None -> Result.Ok(Option.Some(header))
        Option.Some(stored) -> firstUnplaced(store, rest)

fn provenEnough(state: Following, key: Int, header: BlockHeader) -> Result<Following, String>
    ? "A Header worth a Catch-up is one somebody spent work on."
      "Measured against the Network's easiest target rather than against the"
      "bits the Header claims, because the bits are the sender's own claim"
      "about itself -- Domain.Target.provenAtLimit says why. A Header that"
      "does not clear it is not a Header any Peer mined, so the Peer loses"
      "its place rather than merely being ignored."
    ! [Console.error, Disk.appendText, Tcp.close, Time.unixMs]
    match Domain.Target.provenAtLimit(state.pool.network, header)
        Option.Some(why) -> losingPeer(state, key, "peer {key} announced Header {header.blockId} unasked: {why}")
        Option.None -> onMoved(state, key, "peer {key} sent Headers unasked, naming {header.blockId}")

fn ignoredAnnouncement(state: Following, key: Int, what: String) -> Result<Following, String>
    ? "An announcement naming nothing the tree has not already placed."
      "Not a fault and not a Catch-up: the Peer keeps its place and the loop"
      "carries on. It goes to the record because a Peer sending these in a"
      "loop is worth being able to see afterwards."
    ! [Disk.appendText, Time.unixMs]
    noted = Infra.Metrics.noting(state.log, "fault", "ignoring {what} from peer {key}: the tree has placed every one (#300)")?
    Result.Ok(withLog(state, noted))

fn losingPeer(state: Following, key: Int, why: String) -> Result<Following, String>
    ? "A Peer that broke the protocol in the listen loop: dropped, and the"
      "loop carries on with whoever is left."
      "Apart from withoutPeer, which drops a Peer that failed a Catch-up and"
      "then retries the Catch-up on somebody else. Nothing is being retried"
      "here -- what the Peer said was worthless, not unfinished."
    ! [Console.error, Tcp.close]
    _said = saidErrorIfPlain(state.watch, "dropping peer {key}: {why}")
    shrunk = Infra.Peers.dropOne(state.pool, key)?
    Result.Ok(Following(pool = shrunk, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = Domain.Catchup.forgotten(state.gate, key)))

fn onPing(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "Reply with the same nonce, to the Peer that sent it."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    payload = Bytes.fromList(body)?
    sent = Infra.Peers.tell(state.pool, key, "pong", payload)?
    Result.Ok(Following(pool = sent, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate))

fn onOffered(state: Following, key: Int, offered: List<List<Int>>) -> Result<Following, String>
    ? "Transactions a Peer says it holds."
      "Only the ones we have not got are asked for. That is most of the flood"
      "control at this end but not all of it: nothing here records what has"
      "been asked for and not yet arrived, so a Transaction announced by eight"
      "Peers at once is asked of all eight, and seven copies arrive to be"
      "recognised and dropped. Each of those costs a decode and nothing more"
      "-- admission answers Known before it looks anything up -- and the fix"
      "is a record of what is in flight, which is the same bookkeeping the"
      "orphan pool needs. Both are deferred by n1bor/btc-listener#28."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    match unheld(state.mempool, offered, [])
        [] -> Result.Ok(state)
        [head, ..tail] -> asking(state, key, List.prepend(head, tail))

fn unheld(pool: Mempool, offered: List<List<Int>>, acc: List<List<Int>>) -> List<List<Int>>
    ? "The offered identifiers we do not already hold."
    match offered
        [] -> List.reverse(acc)
        [head, ..tail] -> unheld(pool, tail, keptIfNew(pool, head, acc))

verify unheld
    unheld(Domain.Mempool.empty(1000), [], []) => []
    List.len(unheld(Domain.Mempool.empty(1000), [[1, 2]], [])) => 1

fn keptIfNew(pool: Mempool, hash: List<Int>, acc: List<List<Int>>) -> List<List<Int>>
    ? "An identifier we hold is dropped rather than asked for."
    match Domain.Mempool.holds(pool, Domain.Hash.reversedHex(hash))
        true -> acc
        false -> List.prepend(hash, acc)

verify keptIfNew
    List.len(keptIfNew(Domain.Mempool.empty(1000), [1, 2], [])) => 1
    keptIfNew(Domain.Mempool.empty(1000), [1, 2], []) => [[1, 2]]

fn asking(state: Following, key: Int, hashes: List<List<Int>>) -> Result<Following, String>
    ? "Ask the Peer that offered them, with the witness type."
      "The witness type is what makes the reply SegWit-serialised, which is"
      "the serialisation the Transaction Id was not taken over and the one the"
      "Scripts need."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    payload = Domain.Inventory.getDataPayload(Domain.Inventory.witnessTxType(), hashes)?
    sent = Infra.Peers.tell(state.pool, key, "getdata", payload)?
    Result.Ok(Following(pool = sent, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate))

fn onTransaction(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "A Transaction we asked for, or one a Peer sent unasked."
      "Both go through the same admission. A Peer that sends what nobody asked"
      "for has not misbehaved -- Core does it, for a Transaction it thinks we"
      "want -- and admission is the thing that decides, not who sent it."
    ! [Console.error, Console.print, Infra.Kv.get, Tcp.close, Tcp.writeNow, Time.unixMs]
    tipHeight = tipHeightOf(state.store)?
    landing = Infra.Mempool.admitting(state.pool.network, state.store, state.mempool, body, tipHeight)?
    landed(state, key, landing)

fn landed(state: Following, key: Int, landing: Landing) -> Result<Following, String>
    ? "What admission decided, and what to do about it."
      "Only an admission is relayed. A refusal is ours and not the network's:"
      "a Transaction we will not hold may be perfectly valid, and telling"
      "other Peers we have it when we do not is how a node ends up unable to"
      "answer its own Announcements."
    ! [Console.error, Console.print, Tcp.close, Tcp.writeNow, Time.unixMs]
    match landing
        Landing.Admitted(after, held) -> announcing(state, key, after, held)
        Landing.Duplicate -> Result.Ok(state)
        Landing.Conflicted(txid) -> notHeld(state, "conflicts with {txid}, which got here first")
        Landing.Rejected(why) -> notHeld(state, why)

fn notHeld(state: Following, why: String) -> Result<Following, String>
    ? "Say why, and carry on."
      "One line per refusal is a lot on mainnet and the right amount on a"
      "chain being watched. n1bor/btc-listener#134 is where this becomes a"
      "counter on a Panel instead."
    ! [Console.print]
    _said = saidLineIfPlain(state.watch, "mempool refused a Transaction: it {why}")
    Result.Ok(state)

fn announcing(state: Following, key: Int, after: Mempool, held: Domain.Mempool.Held) -> Result<Following, String>
    ? "Held, and told to every other Peer."
      "Not back to the Peer that sent it: it plainly has it. Announced by"
      "identifier rather than sent whole, which is what inv is for -- a Peer"
      "that wants it asks, and most will already have it."
    ! [Console.error, Console.print, Tcp.close, Tcp.writeNow, Time.unixMs]
    _said = saidLineIfPlain(state.watch, "mempool admitted {held.txid}: {held.size} bytes, {held.fee} sat at {held.rate}/kB; holding {Domain.Mempool.count(after)} ({Domain.Mempool.bytes(after)} bytes)")
    payload = Domain.Inventory.getDataPayload(Domain.Inventory.txType(), [hashOf(held.txid)])?
    told = toldOthers(state.pool, Infra.Peers.peerKeys(state.pool), key, payload)?
    seen = relayedTransaction(arrivedOnRing(state, held, Time.unixMs()), List.len(Infra.Peers.peerKeys(state.pool)) - 1)
    Result.Ok(Following(pool = told, store = seen.store, blocks = seen.blocks, book = seen.book, nextKey = seen.nextKey, watch = seen.watch, mempool = after, rebuilding = seen.rebuilding, log = state.log, board = state.board, gate = state.gate))

fn arrivedOnRing(state: Following, held: Domain.Mempool.Held, nowMs: Int) -> Following
    ? "The Transactions Panel learns about it now rather than when a Block"
      "takes it (#164). The fee is already computed here, which is why this"
      "is where the ring is fed: the same row will flip to confirmed under"
      "the same Id when connect sees it in a Block."
    withWatch(state, Watching(snapshot = Domain.Snapshot.notedArrival(state.watch.snapshot, TxView(txId = held.txid, fee = held.fee, coinbase = false, atMs = nowMs, confirmed = false)), heard = state.watch.heard, anyHeardMs = state.watch.anyHeardMs, saidPeersMs = state.watch.saidPeersMs, tendedMs = state.watch.tendedMs, view = state.watch.view, leaving = state.watch.leaving, stopAskedMs = state.watch.stopAskedMs, pollReturnedMs = state.watch.pollReturnedMs, handling = state.watch.handling))

fn toldOthers(pool: Pool, keys: List<Int>, sender: Int, payload: Bytes) -> Result<Pool, String>
    ? "The Announcement, to every Peer but the one that told us."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    match keys
        [] -> Result.Ok(pool)
        [head, ..tail] -> toldOne(pool, head, tail, sender, payload)

fn toldOne(pool: Pool, key: Int, rest: List<Int>, sender: Int, payload: Bytes) -> Result<Pool, String>
    ? "One Peer, unless it is the one that sent it."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    match key == sender
        true -> toldOthers(pool, rest, sender, payload)
        false -> toldOthers(Infra.Peers.tell(pool, key, "inv", payload)?, rest, sender, payload)

fn hashOf(txid: String) -> List<Int>
    ? "A Transaction Id back into the bytes an Announcement carries."
      "Announcements carry the hash the way it came off the digest, which is"
      "the reverse of the way it is read; Domain.Hash.reversedHex turns one"
      "into the other and this turns it back."
    List.reverse(Bytes.octets(Result.withDefault(Bytes.fromHex(txid), Bytes.fromList([]))))

verify hashOf
    hashOf("0201") => [1, 2]
    hashOf("") => []
    Domain.Hash.reversedHex(hashOf("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16")) => "f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16"

fn onAsked(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "A Peer asking for Transactions we announced, and for Blocks."
      "Answering is not a courtesy: a node that announces and then goes quiet"
      "wastes the round trip of every Peer that asked, and Peers drop one that"
      "does it. What we cannot answer is passed over in silence, which is what"
      "Core does with a getdata for something it no longer holds."
      "Transactions are answered here, because a Transaction is kilobytes and"
      "the Mempool already holds its bytes. Blocks are written down and read"
      "off the disk later, one at a time, as each Peer's wire empties"
      "(Infra.Peers.wanting, servingBlocks): Core in initial block download"
      "asks one Peer for sixteen Blocks at a time, and framing them where the"
      "Message arrived fills the eight mebibytes that Peer's queue is allowed"
      "before the sixth mainnet Block, which costs it its seat."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    txsOut = serving(state.pool, state.mempool, key, Domain.Inventory.requestedTxHashesOf(body))?
    blocksOut = Infra.Peers.wanting(txsOut, key, Domain.Inventory.requestedBlockHashesOf(body), servedBlockCap())
    Result.Ok(withPool(state, blocksOut))

fn servedBlockCap() -> Int
    ? "The most Blocks one Peer may have waiting to be served at once."
      "A getdata may name fifty thousand Blocks, and answering all of them"
      "means reading fifty thousand Blocks off disk and putting gigabytes on"
      "a wire nobody promised to read. Core caps a getdata at a thousand"
      "entries and so does this: a Peer that wants more asks again, which"
      "gives this node a turn in between to notice what else is happening."
      "The cap is on what we serve rather than on what may be asked, because"
      "refusing the Message outright would break a Peer that asked politely"
      "for more than we will give at once."
      "It counts the queue rather than the Message, so a Peer that sends a"
      "second getdata before the first is finished cannot go past it."
    1000

verify servedBlockCap
    servedBlockCap() => 1000

fn servingBlocks(state: Following) -> Result<Following, String>
    ? "Blocks Peers have asked for, out of our own Segments, as their wires"
      "empty."
      "This is the half that makes a node worth syncing from: Headers say"
      "what the chain is, Blocks are the chain. A Block we do not hold is"
      "passed over in silence, which is what Core does with a getdata for"
      "something it has pruned or never had."
      "One turn of the loop reads at most servedPerTurn() Blocks, and fewer"
      "than that if every Peer that asked already has its watermark's worth"
      "waiting. Which Peer and which Block is Infra.Peers.nextBlockWanted's"
      "to say, and nothing here reads a socket: the disk is touched only on"
      "this loop's own turn."
      "Infra.Working deliberately holds no Infra.Kv or Disk.readBytesAt, so"
      "the serving turns that run while a Block is being decoded answer pings"
      "and drain wires but read no Blocks. A Peer that asks during one waits"
      "until the loop has its turn back, which is bounded by the walk rather"
      "than by the Peer."
    ! [Console.error, Console.print, Disk.readBytesAt, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    servingWithin(state, servedPerTurn())

fn servedPerTurn() -> Int
    ? "How many Blocks one turn of the loop reads off the disk, over all the"
      "Peers that asked together."
      "Without it a turn stops only when every Peer is at its watermark or"
      "has nothing left to ask for, and that is not a bound this node sets."
      "Every seated Peer may have servedBlockCap() identifiers waiting, and"
      "identifiers naming Blocks we do not hold cost an Infra.Store.get each"
      "and add nothing to any wire, so none of them brings the turn any"
      "closer to a watermark: with the default inbound cap that is 125,000"
      "lookups in a turn nothing can interrupt. The held ones are worse per"
      "Block, at a Segment read and up to four mebibytes a Peer."
      "Sixteen because that is what Core asks one Peer for at a time in"
      "initial block download, so a turn serves about what one getdata is"
      "worth and the Peers behind it get their turn. The rest of the queue"
      "waits for the next turn, which the shortened poll brings round in a"
      "tenth of a second (Infra.Peers.pollBudget)."
    16

verify servedPerTurn
    servedPerTurn() => 16

fn servingWithin(state: Following, left: Int) -> Result<Following, String>
    ? "Another Block if this turn has one left in it."
    ! [Console.error, Console.print, Disk.readBytesAt, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    match servingMore(left)
        true -> servingNext(state, left)
        false -> Result.Ok(state)

fn servingMore(left: Int) -> Bool
    ? "Whether this turn may still read a Block."
      "Nothing else counts the turn, so this is where a budget that never"
      "reached zero would show up."
    left > 0

verify servingMore
    servingMore(servedPerTurn()) => true
    servingMore(1) => true
    servingMore(0) => false

fn servingNext(state: Following, left: Int) -> Result<Following, String>
    ? "The Peer whose turn it is, if any Peer is owed a Block and has room."
    ! [Console.error, Console.print, Disk.readBytesAt, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    match Infra.Peers.nextBlockWanted(state.pool)
        Option.None -> Result.Ok(state)
        Option.Some(wanted) -> servingBlock(state, wanted, left)

fn servingBlock(state: Following, wanted: Infra.Peers.Wanted, left: Int) -> Result<Following, String>
    ? "One Block, by the Id the getdata named it with."
      "The identifier leaves the queue before the bytes are looked for, so"
      "neither a Block we do not hold nor a Peer that goes mid-write can put"
      "this turn back where it started. It counts against the turn either"
      "way, because looking is what costs the lookup."
    ! [Console.error, Console.print, Disk.readBytesAt, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    located = Infra.Store.get(state.store, Domain.IndexKeys.blockKey(Domain.Hash.reversedHex(wanted.hash))?)?
    servingLocated(withPool(state, Infra.Peers.blockServed(state.pool, wanted.key)), wanted.key, located, left - 1)

fn servingLocated(state: Following, key: Int, located: Option<Bytes>, left: Int) -> Result<Following, String>
    ? "A Block we never fetched, or one whose bytes we can read back."
    ! [Console.error, Console.print, Disk.readBytesAt, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    match located
        Option.None -> servingWithin(state, left)
        Option.Some(stored) -> sendingBlock(state, key, Domain.Index.decodeLocation(stored)?, left)

fn sendingBlock(state: Following, key: Int, location: Location, left: Int) -> Result<Following, String>
    ? "The Block off the Segment and onto the wire, exactly as it was stored."
    ! [Console.error, Console.print, Disk.readBytesAt, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    payload = Infra.Blocks.read(state.blocks, location)?
    sent = Infra.Peers.tell(state.pool, key, "block", payload)?
    _said = saidLineIfPlain(state.watch, "served a Block of {List.len(Bytes.octets(payload))} bytes to peer {key}")
    servingWithin(relayedBlock(withPool(state, sent)), left)

fn serving(pool: Pool, mempool: Mempool, key: Int, asked: List<List<Int>>) -> Result<Pool, String>
    ? "Each identifier asked for, answered from what we hold."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    match asked
        [] -> Result.Ok(pool)
        [head, ..tail] -> servingOne(pool, mempool, key, head, tail)

fn servingOne(pool: Pool, mempool: Mempool, key: Int, hash: List<Int>, rest: List<List<Int>>) -> Result<Pool, String>
    ? "One of them, if it is still held."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    match Domain.Mempool.heldFor(mempool, Domain.Hash.reversedHex(hash))
        Option.None -> serving(pool, mempool, key, rest)
        Option.Some(held) -> served(pool, mempool, key, held, rest)

fn served(pool: Pool, mempool: Mempool, key: Int, held: Domain.Mempool.Held, rest: List<List<Int>>) -> Result<Pool, String>
    ? "The bytes that arrived, back out unchanged."
      "Unchanged matters: a SegWit Transaction re-serialised from its decoded"
      "shape is a different string of bytes, and a Peer checking what it asked"
      "for against what it got would find a Transaction it did not ask for."
    ! [Console.error, Tcp.close, Tcp.writeNow]
    serving(Infra.Peers.tell(pool, key, "tx", Bytes.fromHex(held.raw)?)?, mempool, key, rest)

fn onAnnouncedBlocks(state: Following, key: Int, announced: List<List<Int>>, first: List<Int>) -> Result<Following, String>
    ? "A Block was announced. Ask for it as a compact Block if nothing else"
      "is being rebuilt, and otherwise take the ordinary path."
      "One rebuild at a time, deliberately. Two would need a queue and a"
      "second timeout, and the case they would serve -- two Blocks announced"
      "within a second of each other -- ends with the ordinary catch-up"
      "fetching both anyway. n1bor/btc-listener#29 keeps the loop simple and"
      "lets the fallback do the work."
    ! [Console.error, Disk.appendText, Infra.Kv.get, Tcp.close, Tcp.writeNow, Time.unixMs]
    fresh = unplacedIds(state.store, announced, [])?
    match fresh
        [] -> ignoredAnnouncement(state, key, "an inv naming {List.len(announced)} Block(s)")
        [head, ..tail] -> onFreshBlocks(state, key, fresh, head)

fn onFreshBlocks(state: Following, key: Int, announced: List<List<Int>>, first: List<Int>) -> Result<Following, String>
    ? "Ask for it as a compact Block if nothing else is being rebuilt, and"
      "otherwise take the ordinary path."
    ! [Console.error, Disk.appendText, Tcp.close, Tcp.writeNow, Time.unixMs]
    match state.rebuilding
        Option.Some(pending) -> onMoved(state, key, "{List.len(announced)} Block(s) announced by peer {key}")
        Option.None -> askingCompact(state, key, announced, first)

fn unplacedIds(store: Store, hashes: List<List<Int>>, acc: List<List<Int>>) -> Result<List<List<Int>>, String>
    ? "The announced Block Ids the Header tree has not placed."
      "A Block the tree has placed can tell us nothing by being announced"
      "again: the tree has already decided where it sits and whether we"
      "follow it. Announcing one used to be answered with a getdata and, if"
      "a rebuild was already in flight, with a whole Catch-up (#300)."
    ! [Infra.Kv.get]
    match hashes
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> unplacedInto(store, head, tail, acc, Infra.Store.get(store, Domain.TreeStore.headerKey(Domain.Hash.reversedHex(head))?)?)

fn unplacedInto(store: Store, hash: List<Int>, rest: List<List<Int>>, acc: List<List<Int>>, held: Option<Bytes>) -> Result<List<List<Int>>, String>
    ? "Kept when the tree has not placed it, dropped when it has."
    ! [Infra.Kv.get]
    match held
        Option.None -> unplacedIds(store, rest, List.prepend(hash, acc))
        Option.Some(stored) -> unplacedIds(store, rest, acc)

fn askingCompact(state: Following, key: Int, announced: List<List<Int>>, first: List<Int>) -> Result<Following, String>
    ? "getdata, with the type that asks for a Block by its parts."
      "Low bandwidth mode: the Peer announced, we ask. What comes back is a"
      "Header, a nonce, six-byte names for the Transactions it expects us to"
      "hold, and whole copies of the ones it does not."
    ! [Console.error, Tcp.close, Tcp.writeNow, Time.unixMs]
    payload = Domain.Inventory.getDataPayload(compactBlockType(), [first])?
    sent = Infra.Peers.tell(state.pool, key, "getdata", payload)?
    Result.Ok(waitingFor(withPool(state, sent), key, first, Time.unixMs()))

fn compactBlockType() -> Int
    ? "The inventory type that asks for a compact Block: MSG_CMPCT_BLOCK."
      "One past the witness Block type, and the reason a getdata can ask for"
      "the same Block three different ways."
    4

verify compactBlockType
    compactBlockType() => 4

fn withPool(state: Following, pool: Pool) -> Following
    ? "The state, with the pool moved on."
    Following(pool = pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate)

fn waitingFor(state: Following, key: Int, hash: List<Int>, nowMs: Int) -> Following
    ? "Remember which Block we are rebuilding and when we asked."
      "The clock matters: a Peer that never answers must not leave the node"
      "waiting for a Block it could simply have fetched."
    Following(pool = state.pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = Option.Some(Rebuilding(blockId = Domain.Hash.reversedHex(hash), hash = hash, key = key, askedMs = nowMs, compact = Option.None, asked = [])), log = state.log, board = state.board, gate = state.gate)

fn givenUp(state: Following) -> Following
    ? "Nothing being rebuilt any more."
    Following(pool = state.pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = Option.None, log = state.log, board = state.board, gate = state.gate)

fn rebuildDeadlineMs() -> Int
    ? "How long a Peer has to answer a compact Block request."
      "Ten seconds. A Peer that has the Block answers in milliseconds on any"
      "network worth following; one that does not answer at all must not stop"
      "the node from fetching the Block the ordinary way."
    10000

verify rebuildDeadlineMs
    rebuildDeadlineMs() => 10000

fn onCompact(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "A compact Block arrived. Rebuild it from the Mempool if we can."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.close, Tcp.writeNow,
        Time.unixMs,
    ]
    match Domain.CompactBlock.decodeCompact(body)
        Result.Err(why) -> fellBack(state, key, "a compact Block would not decode: {why}")
        Result.Ok(compact) -> filling(state, key, compact)

fn filling(state: Following, key: Int, compact: Compact) -> Result<Following, String>
    ? "Rename the Mempool under this Block's key, and see what is missing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.close, Tcp.writeNow,
        Time.unixMs,
    ]
    held = Domain.CompactBlock.holdingsFor(Domain.CompactBlock.keyOf(compact.header, compact.nonce), heldBytes(state.mempool, Domain.Mempool.txids(state.mempool), []))
    wanted = Domain.CompactBlock.wantedFrom(compact, Map.keys(held))
    match wanted.indexes
        [] -> completed(state, key, compact, Domain.CompactBlock.rebuilt(compact, held, []), 0)
        [head, ..tail] -> askingFor(state, key, compact, wanted.indexes)

fn heldBytes(pool: Mempool, txids: List<String>, acc: List<List<Int>>) -> List<List<Int>>
    ? "Every held Transaction as the bytes it arrived as."
    match txids
        [] -> acc
        [head, ..tail] -> heldBytes(pool, tail, prependedRaw(pool, head, acc))

verify heldBytes
    heldBytes(Domain.Mempool.empty(1000), [], []) => []

fn prependedRaw(pool: Mempool, txid: String, acc: List<List<Int>>) -> List<List<Int>>
    ? "One entry's bytes, or nothing if it has just left."
    match Domain.Mempool.heldFor(pool, txid)
        Option.None -> acc
        Option.Some(held) -> List.prepend(Bytes.octets(Result.withDefault(Bytes.fromHex(held.raw), Bytes.fromList([]))), acc)

verify prependedRaw
    prependedRaw(Domain.Mempool.empty(1000), "aa", []) => []

fn askingFor(state: Following, key: Int, compact: Compact, indexes: List<Int>) -> Result<Following, String>
    ? "getblocktxn for the positions the Mempool could not fill."
    ! [Console.error, Console.print, Tcp.close, Tcp.writeNow]
    _said = saidAsking(state, List.len(indexes), Domain.CompactBlock.totalOf(compact))
    payload = Domain.CompactBlock.getBlockTxnPayload(hashOfRebuild(state.rebuilding), indexes)?
    sent = Infra.Peers.tell(state.pool, key, "getblocktxn", payload)?
    Result.Ok(awaiting(withPool(state, sent), compact, indexes))

fn saidAsking(state: Following, missing: Int, total: Int) -> Unit
    ? "Say how much of the Block the Mempool already held, which is the whole"
      "point of a compact Block and the number worth watching."
    ! [Console.print]
    saidLineIfPlain(state.watch, "compact Block: {total - missing} of {total} Transaction(s) already held, asking for {missing}")

fn hashOfRebuild(rebuilding: Option<Rebuilding>) -> List<Int>
    ? "The Block Id a getblocktxn names, in wire order."
    match rebuilding
        Option.None -> []
        Option.Some(pending) -> pending.hash

verify hashOfRebuild
    hashOfRebuild(Option.None) => []
    hashOfRebuild(Option.Some(Rebuilding(blockId = "", hash = [1, 2], key = 0, askedMs = 0, compact = Option.None, asked = []))) => [1, 2]

fn awaiting(state: Following, compact: Compact, indexes: List<Int>) -> Following
    ? "Hold the compact Block while its missing parts are fetched."
    Following(pool = state.pool, store = state.store, blocks = state.blocks, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = heldRebuild(state.rebuilding, compact, indexes), log = state.log, board = state.board, gate = state.gate)

fn heldRebuild(rebuilding: Option<Rebuilding>, compact: Compact, indexes: List<Int>) -> Option<Rebuilding>
    ? "The same rebuild, now carrying what it is waiting on."
    match rebuilding
        Option.None -> Option.None
        Option.Some(pending) -> Option.Some(Rebuilding(blockId = pending.blockId, hash = pending.hash, key = pending.key, askedMs = pending.askedMs, compact = Option.Some(compact), asked = indexes))

verify heldRebuild
    heldRebuild(Option.None, Compact(header = [], nonce = 0, shortIds = [], prefilled = []), []) => Option.None
    hashOfRebuild(heldRebuild(Option.Some(Rebuilding(blockId = "", hash = [9], key = 0, askedMs = 0, compact = Option.None, asked = [])), Compact(header = [], nonce = 0, shortIds = [], prefilled = []), [3])) => [9]

fn onBlockTxn(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "The Transactions we asked for, to finish a rebuild."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.unixMs,
    ]
    match Domain.CompactBlock.decodeBlockTxn(body)
        Result.Err(why) -> fellBack(state, key, "a blocktxn would not decode: {why}")
        Result.Ok(answer) -> withAnswer(state, key, answer)

fn withAnswer(state: Following, key: Int, answer: Tuple<List<Int>, List<Int>>) -> Result<Following, String>
    ? "The Block it answers for, and the Transactions in it."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.unixMs,
    ]
    match answer
        (named, rest) -> finishing(state, key, Domain.Block.carriedOf(Result.withDefault(Bytes.fromList(rest), Bytes.fromList([]))))

fn finishing(state: Following, key: Int, carried: Result<List<Carried>, String>) -> Result<Following, String>
    ? "Decode what arrived, keeping each Transaction's own bytes."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.unixMs,
    ]
    match carried
        Result.Err(why) -> fellBack(state, key, "a blocktxn carried Transactions that would not decode: {why}")
        Result.Ok(supplied) -> assembling(state, key, bytesOf(supplied, []))

fn bytesOf(carried: List<Carried>, acc: List<List<Int>>) -> List<List<Int>>
    ? "Each carried Transaction as its own bytes, in the order they came."
    match carried
        [] -> List.reverse(acc)
        [head, ..tail] -> bytesOf(tail, List.prepend(head.bytes, acc))

verify bytesOf
    bytesOf([], []) => []

fn assembling(state: Following, key: Int, supplied: List<List<Int>>) -> Result<Following, String>
    ? "Fill the holes with what arrived and check the whole Block."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.unixMs,
    ]
    match state.rebuilding
        Option.None -> onMoved(state, key, "a blocktxn arrived with nothing being rebuilt")
        Option.Some(pending) -> withPending(state, key, pending, supplied)

fn withPending(state: Following, key: Int, pending: Rebuilding, supplied: List<List<Int>>) -> Result<Following, String>
    ? "The compact Block we kept, now that its missing parts are here."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.unixMs,
    ]
    match pending.compact
        Option.None -> onMoved(state, key, "a blocktxn arrived before the compact Block it belongs to")
        Option.Some(compact) -> completed(state, key, compact, Domain.CompactBlock.rebuilt(compact, Domain.CompactBlock.holdingsFor(Domain.CompactBlock.keyOf(compact.header, compact.nonce), heldBytes(state.mempool, Domain.Mempool.txids(state.mempool), [])), supplied), List.len(supplied))

fn completed(state: Following, key: Int, compact: Compact, built: Result<Bytes, String>, supplied: Int) -> Result<Following, String>
    ? "A rebuilt Block, or the reason it could not be rebuilt."
      "Either way the chain moves on: a failure here costs a round trip and"
      "falls back to fetching the Block whole, which is what BIP152 says to"
      "do and what the node would have done anyway."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.unixMs,
    ]
    match built
        Result.Err(why) -> fellBack(state, key, "a compact Block would not rebuild: {why}")
        Result.Ok(payload) -> storing(state, key, compact, payload, supplied)

fn storing(state: Following, key: Int, compact: Compact, payload: Bytes, supplied: Int) -> Result<Following, String>
    ? "Put the rebuilt Block where a fetched one would have gone -- once it"
      "is proved to be a Block this node is waiting for (#283). It has to"
      "be the one being rebuilt, its Header has to pass the same pipeline"
      "a Header out of getheaders passes, and its body has to pass"
      "Domain.Body like any fetched one. Anything else falls back to the"
      "ordinary fetch, which asks for Headers first and checks them."
      "The Header used to be required to be in the tree already, which was"
      "the same check by another route while a compact Block could only"
      "follow a getheaders. A compact response carries its own Header, so"
      "it is absorbed here and then looked for: absorbing is what checks"
      "it, and a Header the tree did not keep is a Header it refused."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.unixMs,
    ]
    blockId = Domain.Block.blockIdOf(Result.withDefault(Bytes.fromList(compact.header), Bytes.fromList([])))
    match compactStore(state.pool.network, state.store, state.rebuilding, compact.header, payload, blockId, Int.div(Time.unixMs(), 1000))
        Result.Err(why) -> fellBack(state, key, why)
        Result.Ok(store) -> putAway(Following.update(state, store = store), key, compact, payload, supplied, blockId)

fn compactStore(network: Network, store: Store, rebuilding: Option<Rebuilding>, header: List<Int>, payload: Bytes, blockId: String, nowSecs: Int) -> Result<Store, String>
    ? "The three questions a rebuilt Block has to answer, in the order that"
      "costs least to a Peer sending nonsense."
      "First whether this is the Block that was asked for, so an"
      "unexpected one is refused before any part of it is looked at."
      "Then whether the bytes hash to the Id they claim, so a Peer cannot"
      "get a Header into the tree by attaching it to a body that is not"
      "that Header's. Only then is the Header absorbed."
    ! [Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll]
    _expected = expectedCompact(rebuilding, blockId)?
    match Domain.Body.fault(payload, blockId)
        Option.Some(why) -> Result.Err(why)
        Option.None -> placedCompact(network, store, header, blockId, nowSecs)

fn expectedCompact(rebuilding: Option<Rebuilding>, blockId: String) -> Result<Unit, String>
    ? "Whether this is the compact Block that was asked for."
      "A compact Block arrives because this node asked for one. One naming"
      "something else, or arriving while nothing is being rebuilt, is a"
      "Peer offering the tree a Header unasked, and the tree does not take"
      "Headers from whoever offers."
    match rebuilding
        Option.None -> Result.Err("a compact Block {blockId} was rebuilt with nothing being rebuilt")
        Option.Some(pending) -> match pending.blockId == blockId
            true -> Result.Ok(Unit)
            false -> Result.Err("a compact Block {blockId} arrived while {pending.blockId} was being rebuilt")

verify expectedCompact
    expectedCompact(Option.None, "aa") => Result.Err("a compact Block aa was rebuilt with nothing being rebuilt")
    expectedCompact(Option.Some(sampleRebuilding("bb")), "aa") => Result.Err("a compact Block aa arrived while bb was being rebuilt")
    expectedCompact(Option.Some(sampleRebuilding("aa")), "aa") => Result.Ok(Unit)

fn placedCompact(network: Network, store: Store, header: List<Int>, blockId: String, nowSecs: Int) -> Result<Store, String>
    ? "The carried Header through Infra.Headers, then looked for in the"
      "tree."
      "Absorbing is what checks proof of work, the parent, the target and"
      "the timestamp, so none of those rules is written a second time"
      "here. A Header that is not in the tree afterwards is an orphan or a"
      "refusal, and either way there is nowhere to file the Block."
    ! [Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll]
    decoded = Domain.Block.decodeHeader(header)?
    settled = Infra.Headers.absorbed(network, store, [decoded], nowSecs)?
    placed = Infra.Store.get(settled.store, Domain.TreeStore.headerKey(blockId)?)?
    match storablePlaced(blockId, placed, Option.None)
        Option.Some(why) -> Result.Err(why)
        Option.None -> Result.Ok(settled.store)

fn storable(rebuilding: Option<Rebuilding>, blockId: String, placed: Option<Bytes>, fault: Option<String>) -> Option<String>
    ? "Why a rebuilt Block may not be kept, or nothing."
    match rebuilding
        Option.None -> Option.Some("a compact Block {blockId} was rebuilt with nothing being rebuilt")
        Option.Some(pending) -> storableFor(pending, blockId, placed, fault)

verify storable
    storable(Option.None, "aa", Option.None, Option.None) => Option.Some("a compact Block aa was rebuilt with nothing being rebuilt")
    storable(Option.Some(sampleRebuilding("aa")), "aa", Option.Some(Domain.Index.emptyBytes()), Option.None) => Option.None
    storable(Option.Some(sampleRebuilding("bb")), "aa", Option.Some(Domain.Index.emptyBytes()), Option.None) => Option.Some("a compact Block aa arrived while bb was being rebuilt")
    storable(Option.Some(sampleRebuilding("aa")), "aa", Option.None, Option.None) => Option.Some("a compact Block aa has no Header in the tree")
    storable(Option.Some(sampleRebuilding("aa")), "aa", Option.Some(Domain.Index.emptyBytes()), Option.Some("no")) => Option.Some("no")

fn storableFor(pending: Rebuilding, blockId: String, placed: Option<Bytes>, fault: Option<String>) -> Option<String>
    ? "The one being rebuilt, placed, and sound."
    match pending.blockId == blockId
        false -> Option.Some("a compact Block {blockId} arrived while {pending.blockId} was being rebuilt")
        true -> storablePlaced(blockId, placed, fault)

verify storableFor
    storableFor(sampleRebuilding("aa"), "aa", Option.Some(Domain.Index.emptyBytes()), Option.None) => Option.None
    storableFor(sampleRebuilding("bb"), "aa", Option.Some(Domain.Index.emptyBytes()), Option.None) => Option.Some("a compact Block aa arrived while bb was being rebuilt")

fn storablePlaced(blockId: String, placed: Option<Bytes>, fault: Option<String>) -> Option<String>
    ? "Placed in the tree, and sound."
    match placed
        Option.None -> Option.Some("a compact Block {blockId} has no Header in the tree")
        Option.Some(held) -> fault

verify storablePlaced
    storablePlaced("aa", Option.None, Option.None) => Option.Some("a compact Block aa has no Header in the tree")
    storablePlaced("aa", Option.Some(Domain.Index.emptyBytes()), Option.None) => Option.None
    storablePlaced("aa", Option.Some(Domain.Index.emptyBytes()), Option.Some("no")) => Option.Some("no")

fn sampleRebuilding(blockId: String) -> Rebuilding
    ? "A rebuild in flight, for the cases here."
    Rebuilding(blockId = blockId, hash = [], key = 0, askedMs = 0, compact = Option.None, asked = [])

verify sampleRebuilding
    sampleRebuilding("aa").blockId => "aa"

fn putAway(state: Following, key: Int, compact: Compact, payload: Bytes, supplied: Int, blockId: String) -> Result<Following, String>
    ? "Proved, so put where a fetched Block would have gone."
      "The Segment is made durable between the append and the Location, the"
      "same way the body phase does it (#301). One Block rather than a batch"
      "of thousands, so this is one fsync for one Block -- which is what a"
      "Block arriving on its own is worth, and it happens once per Block"
      "mined rather than once per Block downloaded."
    ! [
        Console.print,
        Disk.appendBytes, Disk.appendText, Disk.size, Disk.sync,
        Infra.Kv.putAll,
        Time.unixMs,
    ]
    appended = Infra.Blocks.append(state.blocks, payload)?
    durable = Infra.Blocks.synced(appended.store)?
    kept = Infra.Store.put(state.store, Domain.IndexKeys.blockKey(blockId)?, Domain.Index.encodeLocation(appended.location))?
    _said = saidRebuilt(state.watch, blockId, Domain.CompactBlock.totalOf(compact), supplied, List.len(Bytes.octets(payload)))
    onMoved(givenUp(Following(pool = state.pool, store = kept, blocks = durable, book = state.book, nextKey = state.nextKey, watch = state.watch, mempool = state.mempool, rebuilding = state.rebuilding, log = state.log, board = state.board, gate = state.gate)), key, "Block {blockId} rebuilt from the Mempool")

fn saidRebuilt(watch: Watching, blockId: String, total: Int, supplied: Int, bytes: Int) -> Unit
    ? "What the rebuild saved, which is the reason the stage exists."
    ! [Console.print]
    saidLineIfPlain(watch, "compact Block {blockId}: {total} Transaction(s), {supplied} fetched, {bytes} bytes rebuilt from the Mempool")

fn fellBack(state: Following, key: Int, why: String) -> Result<Following, String>
    ? "A rebuild that did not work is a Block to fetch the ordinary way."
      "Never an error. Every reason a reconstruction fails -- a Peer that"
      "answered oddly, a short id collision, a Mempool that had moved on --"
      "is answered by asking for the whole Block, and the node is exactly"
      "where it would have been without compact Blocks at all."
    ! [Console.print, Disk.appendText, Time.unixMs]
    _said = saidLineIfPlain(state.watch, "{why}; fetching it whole instead")
    onMoved(givenUp(state), key, "falling back to a whole Block from peer {key}")

fn onAskedHeaders(state: Following, key: Int, body: List<Int>) -> Result<Following, String>
    ? "A Peer asking what follows the newest Block it knows."
      "This is how a node syncs from us, and the whole of what makes this a"
      "Peer worth connecting to rather than a Peer that only takes. The"
      "Locator names Block Ids newest first; the first one we hold is the"
      "newest thing we agree about, and everything above it is what they are"
      "missing."
    ! [Console.error, Console.print, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    locator = Domain.Block.locatorIn(body)
    match Domain.Block.locatorFault(locator)
        Option.Some(why) -> losingPeer(state, key, why)
        Option.None -> answeringHeaders(state, key, locator)

fn answeringHeaders(state: Following, key: Int, locator: List<List<Int>>) -> Result<Following, String>
    ? "The Headers above the newest Id in a Locator we know, to the Peer that asked."
    ! [Console.error, Console.print, Infra.Kv.get, Tcp.close, Tcp.writeNow]
    from = agreedHeight(state.store, locator)?
    headers = headersFrom(state.store, from + 1, Domain.Block.headersCap(), [])?
    headersOut = sendingHeaders(state, key, headers)?
    Result.Ok(headersOut)

fn sendingHeaders(state: Following, key: Int, headers: List<String>) -> Result<Following, String>
    ? "The Headers we hold above what they know, up to the cap."
      "An empty answer is still an answer: it tells a Peer it is level with"
      "us, which is what it asked."
    ! [Console.error, Console.print, Tcp.close, Tcp.writeNow]
    payload = Domain.Block.headersPayload(headers)?
    sent = Infra.Peers.tell(state.pool, key, "headers", payload)?
    _said = saidServed(state.watch, List.len(headers), key)
    Result.Ok(withPool(state, sent))

fn saidServed(watch: Watching, howMany: Int, key: Int) -> Unit
    ? "Say what was served, unless it was nothing."
    ! [Console.print]
    match howMany == 0
        true -> Unit
        false -> saidLineIfPlain(watch, "served {howMany} Header(s) to peer {key}")

fn agreedHeight(store: Store, locator: List<List<Int>>) -> Result<Int, String>
    ? "The Height of the newest Block Id in the Locator that is on our active"
      "chain."
      "Zero when we recognise none of them, which means starting from genesis"
      "-- the honest answer to a Peer on a chain we have never seen."
    ! [Infra.Kv.get]
    match locator
        [] -> Result.Ok(0)
        [head, ..tail] -> heightOfKnown(store, head, tail)

fn heightOfKnown(store: Store, hash: List<Int>, rest: List<List<Int>>) -> Result<Int, String>
    ? "This one, if we hold it, otherwise the next."
    ! [Infra.Kv.get]
    held = Infra.Store.get(store, Domain.TreeStore.headerKey(Domain.Hash.reversedHex(hash))?)?
    heightOfHeld(store, hash, held, rest)

fn heightOfHeld(store: Store, hash: List<Int>, held: Option<Bytes>, rest: List<List<Int>>) -> Result<Int, String>
    ? "A Header we hold sends us on to ask whether we still stand on it; one"
      "we do not sends us further back down the Locator, which is exactly"
      "what a Locator is for."
    ! [Infra.Kv.get]
    match held
        Option.None -> agreedHeight(store, rest)
        Option.Some(stored) -> heightIfActive(store, Domain.Hash.reversedHex(hash), stored, rest)

fn heightIfActive(store: Store, blockId: String, stored: Bytes, rest: List<List<Int>>) -> Result<Int, String>
    ? "Holding a Header is not agreeing about it (#171)."
      "After a reorganisation the abandoned branch's Headers are still held,"
      "so a Peer left on that branch matches one of them -- and every Header"
      "we would serve from above it belongs to the branch we moved to, whose"
      "parent is not the Block the Peer asked from. It rejects them, asks"
      "again, and neither side ever moves. Bitcoin Core draws the same line"
      "in FindForkInGlobalIndex, which takes the first Locator entry that is"
      "in the active chain rather than the first one in the block index."
    ! [Infra.Kv.get]
    height = Domain.TreeStore.decodeHeld(blockId, stored)?.placement.height
    named = Infra.Store.get(store, Domain.IndexKeys.heightKey(height)?)?
    activeAt(store, blockId, height, rest, Domain.Index.blockIdIn(named))

fn activeAt(store: Store, blockId: String, height: Int, rest: List<List<Int>>, named: Option<String>) -> Result<Int, String>
    ? "The round trip the h: keyspace already affords: a Height re-points when"
      "the chain moves, so an Id is on the active chain exactly when its own"
      "Height names it back. A Height the Index does not name is above the"
      "end of our chain, which is not agreement either."
    ! [Infra.Kv.get]
    match named
        Option.None -> agreedHeight(store, rest)
        Option.Some(active) -> agreedIfNamed(store, blockId, height, rest, active)

verify activeAt
    activeAt(Infra.Store.fixture([]), "aa", 7, [], Option.None) => Result.Ok(0)
    activeAt(Infra.Store.fixture([]), "aa", 7, [], Option.Some("aa")) => Result.Ok(7)
    activeAt(Infra.Store.fixture([]), "aa", 7, [], Option.Some("bb")) => Result.Ok(0)

fn agreedIfNamed(store: Store, blockId: String, height: Int, rest: List<List<Int>>, active: String) -> Result<Int, String>
    ? "An Id its own Height names back is one we genuinely agree about. An"
      "abandoned one sends us further down the Locator, which is where the"
      "newest Height the Peer and this chain still share is waiting -- and"
      "Headers from there connect to what it holds."
    ! [Infra.Kv.get]
    match active == blockId
        true -> Result.Ok(height)
        false -> agreedHeight(store, rest)

verify agreedIfNamed
    agreedIfNamed(Infra.Store.fixture([]), "aa", 7, [], "aa") => Result.Ok(7)
    agreedIfNamed(Infra.Store.fixture([]), "aa", 7, [], "bb") => Result.Ok(0)

fn headersFrom(store: Store, height: Int, left: Int, acc: List<String>) -> Result<List<String>, String>
    ? "The Headers at these Heights, in order, stopping at the tip or the cap."
    ! [Infra.Kv.get]
    match left <= 0
        true -> Result.Ok(List.reverse(acc))
        false -> headerAt(store, height, left, acc)

fn headerAt(store: Store, height: Int, left: Int, acc: List<String>) -> Result<List<String>, String>
    ? "The Block Id at this Height, if the chain reaches it."
    ! [Infra.Kv.get]
    named = Infra.Store.get(store, Domain.IndexKeys.heightKey(height)?)?
    headerNamed(store, height, left, acc, Domain.Index.blockIdIn(named))

fn headerNamed(store: Store, height: Int, left: Int, acc: List<String>, blockId: Option<String>) -> Result<List<String>, String>
    ? "Past the tip there is nothing to serve, and that is not a fault."
    ! [Infra.Kv.get]
    match blockId
        Option.None -> Result.Ok(List.reverse(acc))
        Option.Some(named) -> headerHeld(store, height, left, acc, named, Infra.Store.get(store, Domain.TreeStore.headerKey(named)?)?)

fn headerHeld(store: Store, height: Int, left: Int, acc: List<String>, blockId: String, held: Option<Bytes>) -> Result<List<String>, String>
    ? "A Height the Index names but the tree has no Header for is a directory"
      "half-built rather than a chain with a hole; it stops the answer where"
      "it is instead of claiming the Headers above it do not exist."
    ! [Infra.Kv.get]
    match held
        Option.None -> Result.Ok(List.reverse(acc))
        Option.Some(stored) -> headersFrom(store, height + 1, left - 1, List.prepend(Domain.TreeStore.decodeHeld(blockId, stored)?.headerHex, acc))
