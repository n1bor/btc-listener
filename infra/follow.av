module Follow
    intent =
        "Following the tip on one Peer: the listen loop grown from"
        "Transactions to Blocks."
        "Stages 1 to 3 make a node that can check the chain it is handed. This"
        "is the one that stays current. It is the same three phases the"
        "download commands run -- Headers, then bodies, then the UTXO Set --"
        "only driven by a Peer saying something arrived rather than by a range"
        "somebody typed, and run again every time it does."
        "An Announcement of a Block is answered with getheaders rather than"
        "getdata, which is a deliberate departure from how it was first"
        "written down (#26). A Block whose Header the tree has not placed"
        "cannot be connected and cannot even be told from a Block on a branch"
        "we are not following, so asking for the body first buys nothing and"
        "loses the ordering. Headers first is also what Bitcoin Core does with"
        "an inv it did not expect, and for the same reason. The getdata still"
        "happens -- it is what the body phase is -- one Header later."
        "Exactly one Peer and one blocking socket, so nothing here waits on"
        "the concurrency answer. The Mempool, many Peers and compact Blocks"
        "are Stages 5 to 7; a Transaction announced here is simply not asked"
        "for, because there is nowhere yet to put one."
    exposes [follow]
    depends [Bytes, Domain.Address, Domain.HeaderTree, Domain.Inbox, Domain.Inventory, Domain.Network, Infra.Blocks, Infra.Bodies, Infra.ChainState, Infra.Download, Infra.Headers, Infra.Peers, Infra.Rewind, Infra.Store]
    effects [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]

record Following
    pool: Pool
    store: Store
    blocks: BlockStore

fn follow(network: Network, addresses: List<PeerAddress>, store: Store, blocks: BlockStore) -> Result<Unit, String>
    ? "Connect to every Peer given, catch up, then stay caught up."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    pool = joining(Infra.Peers.opened(network), addresses, 0)?
    outcome = session(Following(pool = pool, store = store, blocks = blocks))
    closeAfter(pool, outcome)

fn joining(pool: Pool, addresses: List<PeerAddress>, key: Int) -> Result<Pool, String>
    ? "Every Peer given, each handshaked before the next is dialled."
      "Sequentially rather than at once, because a Handshake is a"
      "conversation and ADR 0008 puts conversations on the loop rather than"
      "in branches. It costs a few seconds at startup and buys the property"
      "that every Peer in the pool has already been read from once."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match addresses
        [] -> Result.Ok(pool)
        [head, ..tail] -> joiningOne(pool, head, tail, key)

fn joiningOne(pool: Pool, address: PeerAddress, rest: List<PeerAddress>, key: Int) -> Result<Pool, String>
    ? "One Peer that will not answer is one Peer, not the end of the node."
      "With a single Peer a failed Handshake was the run failing, because"
      "there was nothing else to be connected to. With several it is a fact"
      "about that Peer, said out loud and stepped past."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match Infra.Peers.joined(pool, key, address)
        Result.Err(why) -> refused(pool, address, rest, key, why)
        Result.Ok(joined) -> accepted(joined, address, rest, key)

fn refused(pool: Pool, address: PeerAddress, rest: List<PeerAddress>, key: Int, why: String) -> Result<Pool, String>
    ? "Say which Peer would not have us, then try the next."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _said = Console.error("peer {Domain.Address.toString(address)} refused: {why}")
    joining(pool, rest, key)

fn accepted(pool: Pool, address: PeerAddress, rest: List<PeerAddress>, key: Int) -> Result<Pool, String>
    ? "Say who answered, then go on to the next."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _said = Console.print("peer {key} is {Domain.Address.toString(address)}")
    joining(pool, rest, key + 1)

fn closeAfter(pool: Pool, outcome: Result<Unit, String>) -> Result<Unit, String>
    ? "Always release every socket, whatever the session did."
    ! [Tcp.close]
    _closed = Infra.Peers.closeAll(pool)
    outcome

fn session(state: Following) -> Result<Unit, String>
    ? "Catch up on what was missed, then listen."
      "The catch-up before the first Announcement is not optional. A node that"
      "waited would sit idle for as long as it took the next Block to be"
      "mined, and would then connect it onto a Set that was hours or years"
      "behind -- which is to say it would refuse it, correctly, and stop."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    started = caughtUp(state, firstKey(state.pool))?
    listen(started)

fn firstKey(pool: Pool) -> Int
    ? "Which Peer to ask first, before any of them has announced anything."
    Result.withDefault(lowestKey(Map.keys(pool.sockets)), 0)

fn lowestKey(keys: List<Int>) -> Result<Int, String>
    ? "The lowest identifier held, or nothing when the pool is empty."
    match keys
        [] -> Result.Err("no Peers")
        [head, ..tail] -> Result.Ok(head)

verify lowestKey
    lowestKey([]) => Result.Err("no Peers")
    lowestKey([0, 1]) => Result.Ok(0)

fn caughtUp(state: Following, key: Int) -> Result<Following, String>
    ? "The three phases in the one order they can go in, asking one Peer."
      "Headers first, because nothing below can act on a Block it cannot"
      "place. Then the Set is taken back off any branch the Headers have just"
      "abandoned, because the bodies to fetch are the ones above the fork and"
      "not the ones above where the Set happened to stand. Then the bodies,"
      "then the Set forward over them."
      "The Peer asked is whichever one told us the chain had moved. Every"
      "other Peer is read and kept alive throughout, which is the whole"
      "reason this stage exists -- the single-Peer shape left them unheard"
      "and unanswered for as long as a catch-up took."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    have = haveOf(state.store)?
    grown = Infra.Download.headersOn(state.pool, key, state.store, have)?
    tipHeight = tipHeightOf(grown.store)?
    aligned = Infra.Rewind.realigned(grown.store, state.blocks)?
    fetched = Infra.Bodies.bodiesOn(grown.pool, key, aligned.store, state.blocks, aligned.from, tipHeight)?
    connected(Following(pool = fetched.pool, store = fetched.store, blocks = fetched.blocks), tipHeight)

fn connected(state: Following, tipHeight: Int) -> Result<Following, String>
    ? "The Set forward to the tip, and one line saying where that leaves it."
    ! [
        Console.print,
        Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Time.now, Time.unixMs,
    ]
    built = Infra.ChainState.build(state.pool.network, state.store, state.blocks, tipHeight)?
    _said = Console.print("following at Height {built.reached}: {built.blocks} connected, {built.dropped} disconnected, set +{built.added} -{built.removed}")
    Result.Ok(Following(pool = state.pool, store = built.store, blocks = state.blocks))

fn haveOf(store: Store) -> Result<Int, String>
    ? "How many Heights the Header tree already reaches, for the Locator."
      "One more than the tip's Height, counting genesis -- so one for a tree"
      "that holds nothing yet, because the phase below plants genesis before"
      "it asks for anything. The download phase gets the same number by"
      "counting h: up from genesis, which is a walk of the whole chain and is"
      "not something to do every time a Block is announced."
    ! [Infra.Kv.get]
    tip = Infra.Headers.tipOf(store)?
    Result.Ok(heightOf(tip) + 1)

verify haveOf
    haveOf(Infra.Store.fixture([])) => Result.Ok(1)
    haveOf(Infra.Store.fixture([("meta:bestTip", "aa"), ("k:aa", "318980:1:pp:hh")])) => Result.Ok(318981)

fn tipHeightOf(store: Store) -> Result<Int, String>
    ? "The Height of the branch with the most work."
    ! [Infra.Kv.get]
    tip = Infra.Headers.tipOf(store)?
    Result.Ok(heightOf(tip))

verify tipHeightOf
    tipHeightOf(Infra.Store.fixture([])) => Result.Ok(0)
    tipHeightOf(Infra.Store.fixture([("meta:bestTip", "aa"), ("k:aa", "318980:1:pp:hh")])) => Result.Ok(318980)

fn heightOf(tip: Option<Placement>) -> Int
    ? "Where a tip sits, or genesis when there is no tip yet."
      "Zero for nothing planted is right rather than convenient: the Header"
      "phase plants genesis before it asks anything, so a tree with no tip is"
      "a tree about to have genesis for one."
    match tip
        Option.None -> 0
        Option.Some(placement) -> placement.height

verify heightOf
    heightOf(Option.None) => 0
    heightOf(Option.Some(Placement(blockId = "aa", parentId = "pp", height = 7, work = 1))) => 7

fn listen(state: Following) -> Result<Unit, String>
    ? "Read Messages from every Peer for as long as any of them keeps sending."
      "This never returns of its own accord: the process runs until it is"
      "stopped, until every Peer has gone quiet, or until a Block will not"
      "connect. The call is in tail position, so the recursion does not grow"
      "the stack however long it runs."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    waited = Infra.Peers.awaitAnyPeer(state.pool)?
    handle(Following(pool = waited.pool, store = state.store, blocks = state.blocks), waited.key, waited.frame.command, waited.frame.body)

fn handle(state: Following, key: Int, command: String, body: List<Int>) -> Result<Unit, String>
    ? "The three Messages this loop acts on; every other one is ignored."
      "A ping has to be answered or the Peer eventually drops the connection,"
      "and it is answered to the Peer that sent it rather than to whichever"
      "one the node happens to be talking to."
      "An unsolicited headers is treated exactly as an Announcement: a Peer"
      "that was sent no sendheaders should not be sending one, and a Peer that"
      "does is still telling us the chain moved."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    match command
        "inv" -> onAnnouncement(state, key, body)
        "headers" -> onMoved(state, key, "peer {key} sent Headers unasked")
        "ping" -> onPing(state, key, body)
        _ -> listen(state)

fn onAnnouncement(state: Following, key: Int, body: List<Int>) -> Result<Unit, String>
    ? "An Announcement carrying no Blocks changes nothing here."
      "Transactions are announced down the same Message and are not asked for:"
      "there is no Mempool to put one in until Stage 6, and asking for what"
      "cannot be kept would be noise on the wire and a lie about what this"
      "program does."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    announced = Domain.Inventory.blockHashesOf(body)
    match announced
        [] -> listen(state)
        [head, ..tail] -> onMoved(state, key, "{List.len(announced)} Block(s) announced by peer {key}")

fn onMoved(state: Following, key: Int, why: String) -> Result<Unit, String>
    ? "The chain says it has moved, so ask that Peer how far."
      "What arrived is not trusted to be the new tip, or to be on the branch"
      "with the most work, or to be anything but a Block Id -- the Header"
      "phase settles all three, and a Peer that announced something already"
      "held simply moves nothing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    _said = Console.print("{Time.now()}  {why}")
    moved = caughtUp(state, key)?
    listen(moved)

fn onPing(state: Following, key: Int, body: List<Int>) -> Result<Unit, String>
    ? "Reply with the same nonce, to the Peer that sent it."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.readBytesAt,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    payload = Bytes.fromList(body)?
    sent = Infra.Peers.send(state.pool, key, "pong", payload)?
    listen(Following(pool = sent, store = state.store, blocks = state.blocks))
