module Chain
    intent =
        "What the Index and the Segments together hold for a Height."
        "The read side of everything the download wrote. A Height names a Block"
        "Id, a Block Id may name a Location, and a Location names bytes on disk —"
        "and each of those steps can come up empty for a different reason, which"
        "is the whole point of asking through one place rather than three."
        "Absent is not one answer. A body we never fetched and a body we deleted"
        "on purpose look identical in the Index, and the Prune Watermark is what"
        "tells them apart. A caller that treats them alike either re-downloads"
        "what it discarded or reports a hole where there was a decision."
    exposes [withoutBodies, Body, Found, at, transactionAt, watermark, networkOf]
    depends [Bytes, Domain.Block, Domain.Index, Domain.Network, Infra.Blocks, Infra.Store]
    effects [Disk.readBytesAt, Infra.Kv.get]

type Body
    Held(Location, Bytes)
    NotFetched
    Discarded

record Found
    height: Int
    blockId: String
    parentBlockId: Option<String>
    body: Body

fn networkOf(store: Store) -> Result<Option<Network>, String>
    ? "Which Network filled this directory, from the genesis it was seeded with."
      "Asked once when a directory opens, because a Script's address depends on"
      "it and nothing else in the directory says. The download writes h:0 ="
      "genesis before it asks for a single Header -- the Locator has to name"
      "something -- so this is a fingerprint every directory already carries"
      "rather than a new record to keep."
      "Nothing means the Index names no Block at Height zero, or names one no"
      "arm recognises. Both are answered by showing raw Script hex, which is"
      "what an unrecognised Script already gets."
    ! [Infra.Kv.get]
    seeded = Infra.Store.get(store, Domain.Index.heightKey(0))?
    Result.Ok(recognised(seeded))

verify networkOf
    networkOf(Infra.Store.fixture([])) => Result.Ok(Option.None)
    networkOf(Infra.Store.fixture([("h:00000000", "000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")])) => Result.Ok(Option.Some(Network.Mainnet))
    networkOf(Infra.Store.fixture([("h:00000000", "00000008819873e925422c1ff0f99f7cc9bbb232af63a077a480a3633bee1ef6")])) => Result.Ok(Option.Some(Network.Signet))
    networkOf(Infra.Store.fixture([("h:00000000", "nonsense")])) => Result.Ok(Option.None)

fn recognised(seeded: Option<String>) -> Option<Network>
    ? "A Height zero the Index does not name says as little as one it does not recognise."
    match seeded
        Option.None -> Option.None
        Option.Some(genesisId) -> Domain.Block.networkOf(genesisId)

verify recognised
    recognised(Option.None) => Option.None
    recognised(Option.Some("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")) => Option.Some(Network.Mainnet)
    recognised(Option.Some("nonsense")) => Option.None

fn at(store: Store, blocks: BlockStore, height: Int) -> Result<Found, String>
    ? "Everything known about one Height, including why its body is absent."
    ! [Disk.readBytesAt, Infra.Kv.get]
    named = Infra.Store.get(store, Domain.Index.heightKey(height))?
    match named
        Option.None -> Result.Err("no header for height {height}; run the header phase first")
        Option.Some(blockId) -> withBlockId(store, blocks, height, blockId)

fn withBlockId(store: Store, blocks: BlockStore, height: Int, blockId: String) -> Result<Found, String>
    ? "The Height names a Block; whether the bytes are here is a second question."
    ! [Disk.readBytesAt, Infra.Kv.get]
    stored = Infra.Store.get(store, Domain.Index.blockKey(blockId))?
    below = watermark(store)?
    state = Domain.Index.bodyStateOf(stored, height, below)?
    parent = parentOf(store, height)?
    bodyFor(blocks, height, blockId, parent, state)

fn parentOf(store: Store, height: Int) -> Result<Option<String>, String>
    ? "The Block Id the Index holds one Height down, if there is one."
      "Genesis has no parent and neither has a Height below the Prune Watermark"
      "whose Header has gone, so this is an Option rather than an error."
    ! [Infra.Kv.get]
    match height <= 0
        true -> Result.Ok(Option.None)
        false -> parentNamed(store, height)

verify parentOf
    parentOf(Infra.Store.fixture([]), 0) => Result.Ok(Option.None)
    parentOf(Infra.Store.fixture([]), 5) => Result.Ok(Option.None)
    parentOf(Infra.Store.fixture([("h:00000004", "aa")]), 5) => Result.Ok(Option.Some("aa"))
    parentOf(Infra.Store.fixture([]), 0 - 4) => Result.Ok(Option.None)
    parentOf(Infra.Store.fixture([("h:00000004", "")]), 5) => Result.Err("index has no Block Id at height 4")

fn parentNamed(store: Store, height: Int) -> Result<Option<String>, String>
    ? "A Height below the one asked about may name a Block, or may be gone."
    ! [Infra.Kv.get]
    held = Infra.Store.get(store, Domain.Index.heightKey(height - 1))?
    match held
        Option.None -> Result.Ok(Option.None)
        Option.Some(blockId) -> parentIsNamed(height, blockId)

verify parentNamed
    parentNamed(Infra.Store.fixture([]), 5) => Result.Ok(Option.None)
    parentNamed(Infra.Store.fixture([("h:00000004", "aa")]), 5) => Result.Ok(Option.Some("aa"))
    parentNamed(Infra.Store.fixture([("h:00000004", "")]), 5) => Result.Err("index has no Block Id at height 4")

fn parentIsNamed(height: Int, blockId: String) -> Result<Option<String>, String>
    ? "A Height that names nothing is a damaged Index, not a missing parent."
    match String.len(blockId) > 0
        false -> Result.Err("index has no Block Id at height {height - 1}")
        true -> Result.Ok(Option.Some(blockId))

verify parentIsNamed
    parentIsNamed(5, "aa") => Result.Ok(Option.Some("aa"))
    parentIsNamed(5, "") => Result.Err("index has no Block Id at height 4")

fn watermark(store: Store) -> Result<Int, String>
    ? "The Prune Watermark, or zero when nothing has ever been pruned."
      "One place reads it, so one place decides what an absent record means."
    ! [Infra.Kv.get]
    held = Infra.Store.get(store, Domain.Index.prunedBelowKey())?
    Domain.Index.prunedBelowOf(held)

verify watermark
    watermark(Infra.Store.fixture([])) => Result.Ok(0)
    watermark(Infra.Store.fixture([("meta:prunedBelow", "500")])) => Result.Ok(500)
    watermark(Infra.Store.fixture([("meta:prunedBelow", "x")])) => Result.Err("Height must be a whole number, got 'x'")

fn bodyFor(blocks: BlockStore, height: Int, blockId: String, parent: Option<String>, state: BodyState) -> Result<Found, String>
    ? "Read the bytes when there are bytes, and say why when there are not."
    ! [Disk.readBytesAt]
    match state
        BodyState.Missing -> Result.Ok(Found(height = height, blockId = blockId, parentBlockId = parent, body = Body.NotFetched))
        BodyState.Pruned -> Result.Ok(Found(height = height, blockId = blockId, parentBlockId = parent, body = Body.Discarded))
        BodyState.Stored(location) -> readHeld(blocks, height, blockId, parent, location)

fn readHeld(blocks: BlockStore, height: Int, blockId: String, parent: Option<String>, location: Location) -> Result<Found, String>
    ? "One Block on its own, so read rather than fetch."
      "A scan over many Heights should hold the Segment between calls; this asks"
      "for one Block and is done, and read is the cheaper of the two for that."
    ! [Disk.readBytesAt]
    payload = Infra.Blocks.read(blocks, location)?
    Result.Ok(Found(height = height, blockId = blockId, parentBlockId = parent, body = Body.Held(location, payload)))

fn transactionAt(store: Store, blocks: BlockStore, txid: String) -> Result<Found, String>
    ? "The Block a Transaction sits in, found through the t: keyspace."
      "Returns the Block rather than the Transaction, because picking the"
      "Transaction out needs the position and the caller has that already."
    ! [Disk.readBytesAt, Infra.Kv.get]
    sited = Infra.Store.get(store, Domain.Index.txKey(txid))?
    match sited
        Option.None -> Result.Err("no record of transaction {txid}; index the Heights that hold it first")
        Option.Some(text) -> blockOfSite(store, blocks, text)

fn blockOfSite(store: Store, blocks: BlockStore, text: String) -> Result<Found, String>
    ? "The site names a Block; the Index says where its bytes are."
    ! [Disk.readBytesAt, Infra.Kv.get]
    site = Domain.Index.decodeTxSite(text)?
    located = Infra.Store.get(store, Domain.Index.blockKey(site.blockId))?
    match located
        Option.None -> Result.Err("transaction is in block {site.blockId}, whose body is not held")
        Option.Some(where) -> heldAt(store, blocks, site.blockId, where)

fn heldAt(store: Store, blocks: BlockStore, blockId: String, where: String) -> Result<Found, String>
    ? "Read the Block the site named, and ask what Height it sits at."
      "The Height decides which soft forks were in force, so a Transaction"
      "reached by its Id cannot be judged without it. The n: keyspace answers,"
      "having been written by the same phase that wrote the t: entry this"
      "lookup arrived through."
    ! [Disk.readBytesAt, Infra.Kv.get]
    location = Domain.Index.decodeLocation(where)?
    payload = Infra.Blocks.read(blocks, location)?
    height = heightOf(store, blockId)?
    Result.Ok(Found(height = height, blockId = blockId, parentBlockId = Option.None, body = Body.Held(location, payload)))

fn heightOf(store: Store, blockId: String) -> Result<Int, String>
    ? "The Height a Block sits at, or minus one when nothing recorded it."
      "Minus one is the answer for a directory whose t: entries were written"
      "before the n: keyspace existed. It means unknown rather than zero, and"
      "the callers that judge Scripts read it as unknown and say so; re-running"
      "the txindex phase over the range fills it in."
    ! [Infra.Kv.get]
    recorded = Infra.Store.get(store, Domain.Index.blockHeightKey(blockId))?
    match recorded
        Option.None -> Result.Ok(0 - 1)
        Option.Some(text) -> Domain.Index.decodeHeight(text)

verify heightOf
    heightOf(Infra.Store.fixture([]), "aa") => Result.Ok(0 - 1)
    heightOf(Infra.Store.fixture([("n:aa", "300000")]), "aa") => Result.Ok(300000)
    heightOf(Infra.Store.fixture([("n:aa", "0")]), "aa") => Result.Ok(0)
    heightOf(Infra.Store.fixture([("n:bb", "300000")]), "aa") => Result.Ok(0 - 1)
    heightOf(Infra.Store.fixture([("n:aa", "x")]), "aa") => Result.Err("Height must be a whole number, got 'x'")

fn withoutBodies(store: Store, from: Int, to: Int, acc: Int) -> Result<Int, String>
    ? "How many Heights in a range the Index names but holds no body for."
      "Asked after the phase says it is done, because the phase cannot see its"
      "own gap: the walk either stores a Block or fails, so a Height that is"
      "still empty afterwards was never walked -- a range boundary that moved,"
      "or two runs over overlapping ranges. Three such Heights sat in this"
      "chain from August 14th to August 20th, and what found them was an audit"
      "108,000 Blocks later reporting 908 spends it could not resolve."
      "A Height the Index does not name is not counted. That is the header"
      "phase's business and the walk refuses it outright."
    ! [Infra.Kv.get]
    match from > to
        true -> Result.Ok(acc)
        false -> withoutBody(store, from, to, acc)

verify withoutBodies
    withoutBodies(Infra.Store.fixture([]), 5, 4, 0) => Result.Ok(0)
    withoutBodies(Infra.Store.fixture([]), 1, 3, 0) => Result.Ok(0)

fn withoutBody(store: Store, from: Int, to: Int, acc: Int) -> Result<Int, String>
    ? "One Height: named and held, named and empty, or not named at all."
    ! [Infra.Kv.get]
    named = Infra.Store.get(store, Domain.Index.heightKey(from))?
    match named
        Option.None -> withoutBodies(store, from + 1, to, acc)
        Option.Some(blockId) -> countedIfEmpty(store, from, to, acc, blockId)

verify withoutBody
    withoutBody(Infra.Store.fixture([]), 1, 1, 0) => Result.Ok(0)

fn countedIfEmpty(store: Store, from: Int, to: Int, acc: Int, blockId: String) -> Result<Int, String>
    ? "Count the Height when the Index names a Block it does not hold."
    ! [Infra.Kv.get]
    held = Infra.Store.has(store, Domain.Index.blockKey(blockId))?
    match held
        true -> withoutBodies(store, from + 1, to, acc)
        false -> withoutBodies(store, from + 1, to, acc + 1)

verify countedIfEmpty
    countedIfEmpty(Infra.Store.fixture([]), 1, 1, 0, "aa") => Result.Ok(1)
    countedIfEmpty(Infra.Store.fixture([("b:aa", "0:0")]), 1, 1, 0, "aa") => Result.Ok(0)
