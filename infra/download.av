module Download
    intent =
        "Downloading the chain from one Peer, in two phases."
        "Headers first, because a getdata names Block Ids and never Heights, so"
        "the chain has to be known before any body can be asked for. Every Header"
        "is fetched — all of them fit comfortably — and each one records a Height"
        "against a Block Id in the Index."
        "Bodies second, for a range of Heights the caller chooses, written to"
        "Segments with their Locations recorded against their Block Ids."
        "Both phases resume. Neither holds anything it has not already written"
        "down, so stopping is always safe and restarting costs at most the batch"
        "or the Block that was in flight."
    exposes [Progress, headers, bodies]
    depends [Bytes, Domain.Address, Domain.Block, Domain.Index, Domain.Inventory, Domain.Message, Domain.Network, Infra.Blocks, Infra.Peer, Infra.Store]
    effects [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]

record Progress
    store: Store
    blocks: BlockStore
    pending: List<Entry>
    waiting: Int
    count: Int

fn locationBatch() -> Int
    ? "How many Locations to hold before writing them."
      "A Store hands back a copy of itself, so one put per Block costs the size"
      "of the whole Index per Block, and the Index holds a Height for every Block"
      "in the chain. Writing in batches trades a wider crash window for that: a"
      "crash loses up to this many Locations, and the Blocks they name are"
      "fetched again on the next run, which is the direction that is safe."
    2000

verify locationBatch
    locationBatch() => 2000

fn frameBudget() -> Int
    ? "How many unrelated Messages to read before giving up on the one wanted."
      "A Peer sends ping, inv and addr traffic whenever it likes, so the reply to"
      "a request is rarely the next thing to arrive."
    200

verify frameBudget
    frameBudget() => 200

fn headers(network: Network, address: PeerAddress, store: Store) -> Result<Store, String>
    ? "Fetch every Block Header the Peer has, recording Height against Block Id."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    connection = Tcp.connect(Domain.Address.hostOf(address), Domain.Address.portOf(address))?
    outcome = headerSession(connection, network, address, store)
    closeAfter(connection, outcome)

fn closeAfter(connection: Tcp.Connection, outcome: Result<Store, String>) -> Result<Store, String>
    ? "Always release the socket, whatever the session did."
    ! [Tcp.close]
    _closed = Tcp.close(connection)
    outcome

fn headerSession(connection: Tcp.Connection, network: Network, address: PeerAddress, store: Store) -> Result<Store, String>
    ? "Handshake, then ask for Headers from wherever the Index already reaches."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Random.int,
        Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _greeting = Infra.Peer.introduce(connection, network, address)?
    seeded = withGenesis(network, store)?
    have = heightsHeld(seeded, 0)?
    _said = Console.print("have {have} headers; asking for more")
    headerBatch(connection, network, seeded, have)

fn withGenesis(network: Network, store: Store) -> Result<Store, String>
    ? "Put the first Block in the Index, because no Peer will send it."
      "A getheaders is answered with the Headers that follow the Locator, and the"
      "Locator has to name something — so genesis is always the question and never"
      "the answer. Left out, every Height in the Index is one too low and nothing"
      "says so."
    ! [Disk.appendText, Infra.Kv.get, Infra.Kv.putAll]
    seeded = Infra.Store.has(store, Domain.Index.heightKey(0))?
    match seeded
        true -> Result.Ok(store)
        false -> Infra.Store.put(store, Domain.Index.heightKey(0), Domain.Block.genesisBlockId(network))

fn heightsHeld(store: Store, height: Int) -> Result<Int, String>
    ? "How many Heights the Index already names, counting up from genesis."
      "Walking beats keeping a tip record: a lookup is cheap, and a count that"
      "cannot disagree with the entries is worth more than one that can."
      "What is counted is checked, but only for presence. A Height that names"
      "nothing is not a Height the Index names."
    ! [Infra.Kv.get]
    named = Infra.Store.get(store, Domain.Index.heightKey(height))?
    match named
        Option.None -> Result.Ok(height)
        Option.Some(blockId) -> heightAfter(store, height, blockId)

verify heightsHeld
    heightsHeld(Infra.Store.fixture([]), 0) => Result.Ok(0)
    heightsHeld(Infra.Store.fixture([("h:00000000", "aa")]), 0) => Result.Ok(1)
    heightsHeld(Infra.Store.fixture([("h:00000000", "aa"), ("h:00000001", "bb")]), 0) => Result.Ok(2)
    heightsHeld(Infra.Store.fixture([("h:00000001", "bb")]), 0) => Result.Ok(0)
    heightsHeld(Infra.Store.fixture([("h:00000000", "")]), 0) => Result.Err("index has no Block Id at height 0")

fn heightAfter(store: Store, height: Int, blockId: String) -> Result<Int, String>
    ? "A Height has to name something, then the walk carries on."
      "Presence rather than a decode, and the difference is measured rather than"
      "assumed. Reading the value instead of only asking whether the key is there"
      "costs 0.2 seconds per sixty thousand Heights; decoding each one as well"
      "costs 3.2, which is near a minute on a finished Index and is paid on every"
      "run, including a resume that then fetches nothing. The Locator decodes the"
      "Block Ids it actually uses, so a malformed one is still caught -- there,"
      "where it is about to be sent, rather than here where it is being counted."
    ! [Infra.Kv.get]
    match String.len(blockId) > 0
        false -> Result.Err("index has no Block Id at height {height}")
        true -> heightsHeld(store, height + 1)

verify heightAfter
    heightAfter(Infra.Store.fixture([]), 0, "aa") => Result.Ok(1)
    heightAfter(Infra.Store.fixture([]), 0, "") => Result.Err("index has no Block Id at height 0")

fn headerBatch(connection: Tcp.Connection, network: Network, store: Store, have: Int) -> Result<Store, String>
    ? "Ask for the Headers after the ones held, store them, and go round again."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    locator = locatorFor(network, store, have)?
    payload = Domain.Block.getHeadersPayload(locator)?
    _sent = Infra.Peer.send(connection, network, "getheaders", payload)?
    frame = awaitFrame(connection, network, "headers", frameBudget())?
    decoded = Domain.Block.headersOf(frame.body)?
    absorb(connection, network, store, have, decoded)

fn absorb(connection: Tcp.Connection, network: Network, store: Store, have: Int, decoded: List<BlockHeader>) -> Result<Store, String>
    ? "An empty batch means the Peer has nothing after what we hold."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    match decoded
        [] -> done(store, have)
        [head, ..tail] -> stored(connection, network, store, have, decoded)

fn done(store: Store, have: Int) -> Result<Store, String>
    ? "Report where the Index now reaches and stop."
    ! [Console.print]
    _said = Console.print("headers complete: {have} known")
    Result.Ok(store)

fn stored(connection: Tcp.Connection, network: Network, store: Store, have: Int, decoded: List<BlockHeader>) -> Result<Store, String>
    ? "Write the batch in one append, then ask for the next."
      "One putAll rather than a put per Header: a Store hands back a copy of"
      "itself, so a batch of two thousand costs one copy instead of two thousand."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    grown = Infra.Store.putAll(store, entriesFor(decoded, have, []))?
    reached = have + List.len(decoded)
    _said = Console.print("headers to {reached}")
    headerBatch(connection, network, grown, reached)

fn entriesFor(decoded: List<BlockHeader>, height: Int, acc: List<Entry>) -> List<Entry>
    ? "One Index entry per Header: this Height names this Block Id."
    match decoded
        [] -> List.reverse(acc)
        [head, ..tail] -> entriesFor(tail, height + 1, List.prepend(Entry(key = Domain.Index.heightKey(height), value = head.blockId), acc))

verify entriesFor
    entriesFor([], 0, []) => []
    entriesFor([headerNamed("aa")], 5, []) => [Entry(key = Domain.Index.heightKey(5), value = "aa")]
    entriesFor([headerNamed("aa"), headerNamed("bb")], 5, []) => [Entry(key = Domain.Index.heightKey(5), value = "aa"), Entry(key = Domain.Index.heightKey(6), value = "bb")]
    entriesFor([headerNamed("aa"), headerNamed("bb")], 0, []) => [Entry(key = Domain.Index.heightKey(0), value = "aa"), Entry(key = Domain.Index.heightKey(1), value = "bb")]

fn headerNamed(blockId: String) -> BlockHeader
    ? "A Header standing in for a real one, carrying the one field that matters."
      "The Block Id is all entriesFor reads, and it is the parameter because a"
      "case cannot tell one entry from another unless the Headers differ. Fixing"
      "it and varying something unread — the nonce, as this once did — leaves"
      "every entry identical, so the order the accumulator is reversed into"
      "cannot be pinned and neither can which Height a Block Id landed on."
    BlockHeader(blockId = blockId, version = 1, previousBlockId = "cc", merkleRoot = "dd", timestamp = 0, bits = 0, nonce = 0)

verify headerNamed
    headerNamed("aa").blockId => "aa"
    headerNamed("bb").blockId => "bb"

fn locatorFor(network: Network, store: Store, have: Int) -> Result<List<List<Int>>, String>
    ? "The Block Ids a getheaders should carry, newest first."
      "Never empty. A Peer given a Locator of no Block Ids does not answer at all"
      "— measured against Bitcoin Core 27.0, which replies to a Locator naming"
      "genesis and stays silent on an empty one — so an Index with nothing in it"
      "still has to say where the chain starts."
    ! [Infra.Kv.get]
    ids = idsHeld(store, have)?
    match ids
        [] -> Result.Ok([wireOrder(Domain.Block.genesisBlockId(network))?])
        [head, ..tail] -> Result.Ok(ids)

verify locatorFor
    locatorFor(Network.Mainnet, Infra.Store.fixture([]), 0) => Result.Ok([wireOrder(Domain.Block.genesisBlockId(Network.Mainnet))?])
    locatorFor(Network.Mainnet, Infra.Store.fixture([("h:00000000", "0102")]), 1) => Result.Ok([[2, 1]])
    locatorFor(Network.Mainnet, Infra.Store.fixture([]), 1) => Result.Ok([wireOrder(Domain.Block.genesisBlockId(Network.Mainnet))?])
    locatorFor(Network.Mainnet, Infra.Store.fixture([("h:00000000", "zz")]), 1) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn idsHeld(store: Store, have: Int) -> Result<List<List<Int>>, String>
    ? "The Block Ids the Index can supply for a Locator."
    ! [Infra.Kv.get]
    match have == 0
        true -> Result.Ok([])
        false -> idsAt(store, Domain.Block.locatorHeights(have - 1), [])

verify idsHeld
    idsHeld(Infra.Store.fixture([]), 0) => Result.Ok([])
    idsHeld(Infra.Store.fixture([("h:00000000", "0102")]), 1) => Result.Ok([[2, 1]])
    idsHeld(Infra.Store.fixture([("h:00000000", "zz")]), 1) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn idsAt(store: Store, heights: List<Int>, acc: List<List<Int>>) -> Result<List<List<Int>>, String>
    ? "The Block Id held at each Height, in wire order rather than display order."
    ! [Infra.Kv.get]
    match heights
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> nextId(store, head, tail, acc)

verify idsAt
    idsAt(Infra.Store.fixture([]), [], []) => Result.Ok([])
    idsAt(Infra.Store.fixture([("h:00000000", "0102")]), [0], []) => Result.Ok([[2, 1]])
    idsAt(Infra.Store.fixture([]), [0], []) => Result.Ok([])
    idsAt(Infra.Store.fixture([("h:00000000", "zz")]), [0], []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn nextId(store: Store, height: Int, tail: List<Int>, acc: List<List<Int>>) -> Result<List<List<Int>>, String>
    ? "Take the Block Id at one Height, then carry on with the rest."
    ! [Infra.Kv.get]
    grown = prependId(store, height, acc)?
    idsAt(store, tail, grown)

verify nextId
    nextId(Infra.Store.fixture([("h:00000000", "0102")]), 0, [], []) => Result.Ok([[2, 1]])
    nextId(Infra.Store.fixture([]), 0, [], []) => Result.Ok([])
    nextId(Infra.Store.fixture([("h:00000000", "zz")]), 0, [], []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn prependId(store: Store, height: Int, acc: List<List<Int>>) -> Result<List<List<Int>>, String>
    ? "Add the Block Id at a Height, skipping a Height the Index does not name."
    ! [Infra.Kv.get]
    found = Infra.Store.get(store, Domain.Index.heightKey(height))?
    match found
        Option.None -> Result.Ok(acc)
        Option.Some(id) -> prependDecoded(id, acc)

verify prependId
    prependId(Infra.Store.fixture([]), 0, []) => Result.Ok([])
    prependId(Infra.Store.fixture([("h:00000000", "0102")]), 0, []) => Result.Ok([[2, 1]])
    prependId(Infra.Store.fixture([("h:00000000", "zz")]), 0, []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn prependDecoded(id: String, acc: List<List<Int>>) -> Result<List<List<Int>>, String>
    ? "The Index named a Block Id, which still has to be one."
    wire = wireOrder(id)?
    Result.Ok(List.prepend(wire, acc))

verify prependDecoded
    prependDecoded("0102", []) => Result.Ok([[2, 1]])
    prependDecoded("zz", []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn wireOrder(blockId: String) -> Result<List<Int>, String>
    ? "A Block Id goes back to front on the wire, being displayed reversed."
      "Hex that will not decode is an error rather than an empty entry. It used"
      "to be swallowed, on the grounds that every Block Id here comes from a"
      "genesisBlockId literal or from Domain.Hash.identifierOf over a digest and"
      "so cannot be malformed -- true, but it made the one thing that could go"
      "wrong go wrong invisibly. Neither getHeadersPayload nor getDataPayload"
      "checks that an entry is thirty-two bytes, so a short one would be sent as"
      "it stands, the count prefix would disagree with the bytes after it, and"
      "the Peer would answer a malformed Message with silence. That surfaced as"
      "'no headers after 200 messages', naming neither the Block Id nor the hex."
      "Reading it back out of the Store is what makes this reachable: the Index"
      "is a file, and a file can be truncated, edited or corrupted between runs."
    bytes = Bytes.fromHex(blockId)?
    Result.Ok(List.reverse(Bytes.toList(bytes)))

verify wireOrder
    wireOrder("0102") => Result.Ok([2, 1])
    wireOrder("") => Result.Ok([])
    wireOrder("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")
    wireOrder("0") => Result.Err("Bytes.fromHex: expected an even number of hex characters")

fn awaitFrame(connection: Tcp.Connection, network: Network, wanted: String, budget: Int) -> Result<Frame, String>
    ? "Read until the wanted Message arrives, dealing with whatever else turns up."
    ! [Tcp.readBytes, Tcp.writeBytes]
    match budget <= 0
        true -> Result.Err("no {wanted} after {frameBudget()} messages")
        false -> matching(connection, network, wanted, budget)

fn matching(connection: Tcp.Connection, network: Network, wanted: String, budget: Int) -> Result<Frame, String>
    ? "One frame: the one wanted, or another turn of the loop."
    ! [Tcp.readBytes, Tcp.writeBytes]
    frame = Infra.Peer.readFrame(connection)?
    keepOrSkip(connection, network, wanted, budget, frame)

fn keepOrSkip(connection: Tcp.Connection, network: Network, wanted: String, budget: Int, frame: Frame) -> Result<Frame, String>
    ? "Keep the frame if it is the one asked for."
    ! [Tcp.readBytes, Tcp.writeBytes]
    match frame.command == wanted
        true -> Result.Ok(frame)
        false -> skip(connection, network, wanted, budget, frame)

fn skip(connection: Tcp.Connection, network: Network, wanted: String, budget: Int, frame: Frame) -> Result<Frame, String>
    ? "A ping has to be answered even while waiting for something else."
      "A Peer drops a connection that stops answering, and fetching every Header"
      "takes long enough — some hundreds of round trips — that one will arrive."
    ! [Tcp.readBytes, Tcp.writeBytes]
    match frame.command
        "ping" -> pongThen(connection, network, wanted, budget, frame)
        _ -> awaitFrame(connection, network, wanted, budget - 1)

fn pongThen(connection: Tcp.Connection, network: Network, wanted: String, budget: Int, frame: Frame) -> Result<Frame, String>
    ? "Echo the nonce back, then carry on waiting."
    ! [Tcp.readBytes, Tcp.writeBytes]
    payload = Bytes.fromList(frame.body)?
    _sent = Infra.Peer.send(connection, network, "pong", payload)?
    awaitFrame(connection, network, wanted, budget - 1)

fn bodies(network: Network, address: PeerAddress, store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Progress, String>
    ? "Fetch the Blocks for a range of Heights and write them to Segments."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    connection = Tcp.connect(Domain.Address.hostOf(address), Domain.Address.portOf(address))?
    outcome = bodySession(connection, network, address, store, blocks, from, to)
    closeBodies(connection, outcome)

fn closeBodies(connection: Tcp.Connection, outcome: Result<Progress, String>) -> Result<Progress, String>
    ? "Always release the socket, whatever the session did."
    ! [Tcp.close]
    _closed = Tcp.close(connection)
    outcome

fn bodySession(connection: Tcp.Connection, network: Network, address: PeerAddress, store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Progress, String>
    ? "Handshake, then walk the range one Block at a time."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Random.int,
        Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _greeting = Infra.Peer.introduce(connection, network, address)?
    walked = walk(connection, network, Progress(store = store, blocks = blocks, pending = [], waiting = 0, count = 0), from, to)?
    settled(walked)

fn settled(progress: Progress) -> Result<Progress, String>
    ? "Write whatever Locations are still held back."
    ! [Disk.appendText, Infra.Kv.putAll]
    grown = Infra.Store.putAll(progress.store, List.reverse(progress.pending))?
    Result.Ok(Progress(store = grown, blocks = progress.blocks, pending = [], waiting = 0, count = progress.count))

fn walk(connection: Tcp.Connection, network: Network, progress: Progress, height: Int, to: Int) -> Result<Progress, String>
    ? "Each Height in turn, until the range is exhausted."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    match height > to
        true -> Result.Ok(progress)
        false -> atHeight(connection, network, progress, height, to)

fn atHeight(connection: Tcp.Connection, network: Network, progress: Progress, height: Int, to: Int) -> Result<Progress, String>
    ? "A Height the Index does not name cannot be fetched, and ends the walk."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    named = Infra.Store.get(progress.store, Domain.Index.heightKey(height))?
    match named
        Option.None -> Result.Err("no header for height {height}; run the header phase first")
        Option.Some(blockId) -> maybeFetch(connection, network, progress, height, to, blockId)

fn maybeFetch(connection: Tcp.Connection, network: Network, progress: Progress, height: Int, to: Int, blockId: String) -> Result<Progress, String>
    ? "A Block already held is skipped, which is what makes the phase resumable."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    held = Infra.Store.has(progress.store, Domain.Index.blockKey(blockId))?
    match held
        true -> walk(connection, network, progress, height + 1, to)
        false -> fetch(connection, network, progress, height, to, blockId)

fn fetch(connection: Tcp.Connection, network: Network, progress: Progress, height: Int, to: Int, blockId: String) -> Result<Progress, String>
    ? "Ask for one Block and wait for it."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    wanted = wireOrder(blockId)?
    payload = Domain.Inventory.getDataPayload(Domain.Inventory.witnessBlockType(), [wanted])?
    _sent = Infra.Peer.send(connection, network, "getdata", payload)?
    frame = awaitFrame(connection, network, "block", frameBudget())?
    keep(connection, network, progress, height, to, blockId, frame)

fn keep(connection: Tcp.Connection, network: Network, progress: Progress, height: Int, to: Int, blockId: String, frame: Frame) -> Result<Progress, String>
    ? "Write the Block to a Segment, then record where it went."
      "The bytes are on disk before the Index names them, so a crash between the"
      "two costs a Block that is fetched again rather than an entry pointing at"
      "nothing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    payload = Bytes.fromList(frame.body)?
    appended = Infra.Blocks.append(progress.blocks, payload)?
    held = Progress(store = progress.store, blocks = appended.store, pending = List.prepend(Entry(key = Domain.Index.blockKey(blockId), value = Domain.Index.encodeLocation(appended.location)), progress.pending), waiting = progress.waiting + 1, count = progress.count + 1)
    written = maybeWrite(held)?
    announce(connection, network, written, height, to, List.len(frame.body))

fn maybeWrite(progress: Progress) -> Result<Progress, String>
    ? "Write the batch once it is big enough, and start a new one."
    ! [Disk.appendText, Infra.Kv.putAll]
    match progress.waiting >= locationBatch()
        false -> Result.Ok(progress)
        true -> settled(progress)

fn announce(connection: Tcp.Connection, network: Network, progress: Progress, height: Int, to: Int, size: Int) -> Result<Progress, String>
    ? "Say what arrived, then move on."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Tcp.readBytes, Tcp.writeBytes,
    ]
    _said = Console.print("block {height}  {size} bytes  segment {Infra.Blocks.currentSegment(progress.blocks)}")
    walk(connection, network, progress, height + 1, to)
