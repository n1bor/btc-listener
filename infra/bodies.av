module Bodies
    intent =
        "The body phase: turning Heights the Header tree knows about into"
        "Block bodies on disk."
        "Held apart from the Header phase because the two share nothing but a"
        "socket -- one walks a Locator and writes k: and h:, the other walks a"
        "range of Heights and writes Segments and b: -- and because the file"
        "that held both outgrew what a reader can hold at once."
        "Not to be confused with Infra.Blocks. This is the phase that asks a"
        "Peer for a body; that is the Segment store the body is appended to."
        "A Height whose Block is already held is skipped, which is what makes"
        "the phase resumable and what lets the follow loop run it over a range"
        "that overlaps what it already has."
    exposes [Progress, bodies, bodiesOn]
    depends [Bytes, Domain.Address, Domain.Block, Domain.Inbox, Domain.Index, Domain.Inventory, Domain.Network, Infra.Blocks, Infra.Peers, Infra.Store, Domain.IndexKeys, Domain.Screen, Domain.Screenlines, Domain.Snapshot, Infra.Pace, Infra.Screen]
    effects [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]

record Progress
    pool: Pool
    store: Store
    blocks: BlockStore
    pending: List<Entry>
    waiting: Int
    count: Int
    pace: Pace
    eye: Eye

fn locationBatch() -> Int
    ? "How many Locations to hold before writing them."
      "A Store hands back a copy of itself, so one put per Block costs the size"
      "of the whole Index per Block, and the Index holds a Height for every Block"
      "in the chain. Writing in batches trades a wider crash window for that: a"
      "crash loses up to this many Locations, and the Blocks they name are"
      "fetched again on the next run, which is the direction that is safe."
    2000

verify locationBatch
    locationBatch() => 2000

fn bodies(network: Network, address: PeerAddress, store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Progress, String>
    ? "Fetch the Blocks for a range of Heights and write them to Segments."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    pool = Infra.Peers.joined(Infra.Peers.opened(network), soleKey(), address)?
    closed(pool, bodiesOn(pool, soleKey(), store, blocks, from, to, Infra.Screen.unwatched(Domain.Snapshot.started(Time.unixMs()))))

fn soleKey() -> Int
    ? "The identifier a pool of one Peer keys it under."
    0

verify soleKey
    soleKey() => 0

fn closed(pool: Pool, outcome: Result<Progress, String>) -> Result<Progress, String>
    ? "Always release the sockets, whatever the session did."
    ! [Tcp.close]
    _closed = Infra.Peers.closeAll(pool)
    outcome

fn bodiesOn(pool: Pool, key: Int, store: Store, blocks: BlockStore, from: Int, to: Int, eye: Eye) -> Result<Progress, String>
    ? "The same range walk on a pool somebody else opened."
      "What a node following the tip needs: the Headers say a Block exists and"
      "where it sits, and this is what turns that into a body on disk the"
      "UTXO Set can be connected from. A Height whose Block is already held is"
      "skipped, so re-running it over a range that overlaps costs nothing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    walked = walk(Progress(pool = pool, store = store, blocks = blocks, pending = [], waiting = 0, count = 0, pace = Infra.Pace.pacedFrom(Time.unixMs()), eye = eye), key, from, to)?
    settled(walked)

fn settled(progress: Progress) -> Result<Progress, String>
    ? "Write whatever Locations are still held back."
    ! [Infra.Kv.putAll]
    grown = Infra.Store.putAll(progress.store, List.reverse(progress.pending))?
    Result.Ok(Progress(pool = progress.pool, store = grown, blocks = progress.blocks, pending = [], waiting = 0, count = progress.count, pace = progress.pace, eye = progress.eye))

fn walk(progress: Progress, key: Int, height: Int, to: Int) -> Result<Progress, String>
    ? "Each Height in turn, until the range is exhausted."
      "Each turn asks the stop flag first, so a Ctrl-C during a long fetch"
      "ends the walk at a Block boundary with what is already stored, and the"
      "command's claim is released the ordinary way (#112)."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Bool.or(height > to, Bool.or(Process.stopRequested(), progress.eye.stopped))
        true -> Result.Ok(progress)
        false -> atHeight(progress, key, height, to)

fn atHeight(progress: Progress, key: Int, height: Int, to: Int) -> Result<Progress, String>
    ? "A Height the Index does not name cannot be fetched, and ends the walk."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    named = Domain.Index.blockIdIn(Infra.Store.get(progress.store, Domain.IndexKeys.heightKey(height)?)?)
    match named
        Option.None -> Result.Err("no header for height {height}; run the header phase first")
        Option.Some(blockId) -> maybeFetch(progress, key, height, to, blockId)

fn maybeFetch(progress: Progress, key: Int, height: Int, to: Int, blockId: String) -> Result<Progress, String>
    ? "A Block already held is skipped, which is what makes the phase resumable."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    held = Infra.Store.has(progress.store, Domain.IndexKeys.blockKey(blockId)?)?
    match held
        true -> walk(progress, key, height + 1, to)
        false -> fetch(progress, key, height, to, blockId)

fn fetch(progress: Progress, key: Int, height: Int, to: Int, blockId: String) -> Result<Progress, String>
    ? "Ask for one Block and wait for it."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    wanted = Domain.Block.wireOrder(blockId)?
    payload = Domain.Inventory.getDataPayload(Domain.Inventory.witnessBlockType(), [wanted])?
    sent = Infra.Peers.send(progress.pool, key, "getdata", payload)?
    waited = Infra.Peers.awaitFrom(sent, key, "block")?
    keep(asked(progress, waited.pool), key, height, to, blockId, waited.frame)

fn asked(progress: Progress, pool: Pool) -> Progress
    ? "The walk, carrying the pool the last question left."
    Progress(pool = pool, store = progress.store, blocks = progress.blocks, pending = progress.pending, waiting = progress.waiting, count = progress.count, pace = progress.pace, eye = progress.eye)

fn keep(progress: Progress, key: Int, height: Int, to: Int, blockId: String, frame: Frame) -> Result<Progress, String>
    ? "Write the Block to a Segment, then record where it went."
      "The bytes are on disk before the Index names them, so a crash between the"
      "two costs a Block that is fetched again rather than an entry pointing at"
      "nothing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    payload = Bytes.fromList(frame.body)?
    _matched = matchesRequest(key, blockId, Domain.Block.idOfWholeBlock(payload))?
    appended = Infra.Blocks.append(progress.blocks, payload)?
    held = Progress(pool = progress.pool, store = progress.store, blocks = appended.store, pending = List.prepend(Entry(key = Domain.IndexKeys.blockKey(blockId)?, value = Domain.Index.encodeLocation(appended.location)), progress.pending), waiting = progress.waiting + 1, count = progress.count + 1, pace = progress.pace, eye = progress.eye)
    written = maybeWrite(held)?
    announce(written, key, height, to, List.len(frame.body))

fn matchesRequest(key: Int, wanted: String, arrived: String) -> Result<Unit, String>
    ? "The Block that arrived has to be the Block that was asked for."
      "A getdata names a Block Id and a Peer answers with bytes. Nothing made"
      "those the same thing: until this check, whatever arrived was written"
      "to a Segment and the Index was told it was the Block we wanted, so one"
      "dishonest or confused Peer could put anything under any Block Id."
      "It is cheap -- one double-SHA256 over eighty bytes -- and it is the"
      "difference between an Index that records what a Peer said and one that"
      "records what it checked. show has always verified this on the way back"
      "out, which is how it would eventually have been noticed, a long way"
      "from the Peer that did it."
      "idOfWholeBlock rather than blockIdOf: a Block is its eighty-byte"
      "Header followed by its Transactions and only the Header is hashed."
      "Written the wrong way round first, which accused an honest Bitcoin"
      "Core node of sending the wrong Block for every Block it sent -- the"
      "check was right and the thing being compared was not."
    match wanted == arrived
        true -> Result.Ok(Unit)
        false -> Result.Err("peer {key} was asked for Block {wanted} and sent {arrived}")

verify matchesRequest
    matchesRequest(0, "aa", "aa") => Result.Ok(Unit)
    matchesRequest(3, "aa", "bb") => Result.Err("peer 3 was asked for Block aa and sent bb")

fn maybeWrite(progress: Progress) -> Result<Progress, String>
    ? "Write the batch once it is big enough, and start a new one."
    ! [Infra.Kv.putAll]
    match progress.waiting >= locationBatch()
        false -> Result.Ok(progress)
        true -> settled(progress)

fn announce(progress: Progress, key: Int, height: Int, to: Int, size: Int) -> Result<Progress, String>
    ? "A progress line each minute, rather than a line for every Block."
      "The walk fetches thousands of Blocks a minute at the start of the"
      "chain, and a reader watching it wants where it is, how fast it is"
      "going and how long is left (#129) -- not one line per Block. The line"
      "goes through the same minute gate every long walk uses."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    saying(progress, key, height, to, Time.unixMs())

fn saying(progress: Progress, key: Int, height: Int, to: Int, nowMs: Int) -> Result<Progress, String>
    ? "Say where the walk is when a line is due, and stay quiet otherwise."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    looked = Infra.Screen.glanced(Infra.Screen.eyeing(progress.eye, Domain.Snapshot.bodiesAt(progress.eye.snapshot, height, to, nowMs)), nowMs)?
    seen = withEye(progress, looked)
    match Bool.and(Infra.Pace.due(seen.pace, nowMs, seen.count - 1), plainly(seen.eye))
        false -> walk(seen, key, height + 1, to)
        true -> said(seen, key, height, to, nowMs)

fn withEye(progress: Progress, eye: Eye) -> Progress
    ? "The walk's state, with its Eye moved on."
    Progress(pool = progress.pool, store = progress.store, blocks = progress.blocks, pending = progress.pending, waiting = progress.waiting, count = progress.count, pace = progress.pace, eye = eye)

fn plainly(eye: Eye) -> Bool
    ? "Whether this walk speaks in printed lines; the Screen draws instead."
    match eye.view
        Option.None -> true
        Option.Some(view) -> false

verify plainly
    plainly(Infra.Screen.unwatched(Domain.Snapshot.started(0))) => true
    plainly(Infra.Screen.watchedBy(Option.Some(Domain.Screen.opened()), Domain.Snapshot.started(0))) => false

fn said(progress: Progress, key: Int, height: Int, to: Int, nowMs: Int) -> Result<Progress, String>
    ? "The line, and the Pace the next one measures from."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    _said = Console.print("{lineAt(height, to, progress.count, progress.pace, nowMs)}")
    walk(Progress(pool = progress.pool, store = progress.store, blocks = progress.blocks, pending = progress.pending, waiting = progress.waiting, count = progress.count, pace = Infra.Pace.advanced(progress.pace, nowMs, progress.count, 0), eye = progress.eye), key, height + 1, to)

fn lineAt(height: Int, to: Int, count: Int, pace: Pace, nowMs: Int) -> String
    ? "The walk's first line has no window to read a rate off, and says so"
      "by saying less: where the walk starts and how far it goes. Rate and"
      "eta wait for a real minute -- the first draft of this line read"
      "'1000.0/s eta 0s' after one Block and one millisecond."
    match nowMs - pace.lastMs >= Infra.Pace.reportEveryMs()
        true -> paceLine(height, to, count, pace, nowMs)
        false -> "blocks {height}/{to} ({percentAt(height, to)}%)"

verify lineAt
    lineAt(1, 168, 1, Infra.Pace.pacedFrom(0), 1) => "blocks 1/168 (0%)"
    lineAt(300, 1000, 240, Infra.Pace.advanced(Infra.Pace.pacedFrom(0), 0, 0, 0), 60000) => "blocks 300/1000 (30%) 4.0/s eta 2m55s"

fn paceLine(height: Int, to: Int, count: Int, pace: Pace, nowMs: Int) -> String
    ? "Where the walk is, how fast it is going, and how long is left at that"
      "speed -- the sentence a chain download is watched by (#129)."
    "blocks {height}/{to} ({percentAt(height, to)}%) {Infra.Pace.perSecond(count - pace.lastBlocks, nowMs - pace.lastMs)}/s eta {etaText(to - height, count - pace.lastBlocks, nowMs - pace.lastMs)}"

verify paceLine
    paceLine(300, 1000, 240, Infra.Pace.advanced(Infra.Pace.pacedFrom(0), 0, 0, 0), 60000) => "blocks 300/1000 (30%) 4.0/s eta 2m55s"
    paceLine(1000, 1000, 240, Infra.Pace.advanced(Infra.Pace.pacedFrom(0), 0, 240, 0), 60000) => "blocks 1000/1000 (100%) 0.0/s eta ?"

fn percentAt(height: Int, to: Int) -> Int
    ? "How far up the range the walk has reached, in whole percent."
    match to > 0
        true -> Result.withDefault(Int.div(height * 100, to), 0)
        false -> 0

verify percentAt
    percentAt(300, 1000) => 30
    percentAt(0, 0) => 0

fn etaText(remaining: Int, recent: Int, elapsedMs: Int) -> String
    ? "How long the rest takes at the recent rate, or a question mark while"
      "there is no rate to read."
      "No elapsed time is as unreadable as no count: the first line of a walk"
      "was claiming eta 0s, which is a finished download it had not started."
    match Bool.and(recent > 0, elapsedMs > 0)
        true -> Domain.Screenlines.spanText(Result.withDefault(Int.div(remaining * elapsedMs, recent * 1000), 0))
        false -> "?"

verify etaText
    etaText(700, 240, 60000) => "2m55s"
    etaText(0, 240, 60000) => "0s"
    etaText(700, 0, 60000) => "?"
    etaText(700, 1, 0) => "?"
