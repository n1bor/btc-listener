module Bodies
    intent =
        "The body phase: turning Heights the Header tree knows about into"
        "Block bodies on disk."
        "Held apart from the Header phase because the two share nothing but a"
        "socket -- one walks a Locator and writes k: and h:, the other walks a"
        "range of Heights and writes Segments and b: -- and because the file"
        "that held both outgrew what a reader can hold at once."
        "Not to be confused with Infra.Blocks. This is the phase that asks a"
        "Peer for a body; that is the Segment store the body is appended to."
        "A Height whose Block is already held is skipped, which is what makes"
        "the phase resumable and what lets the follow loop run it over a range"
        "that overlaps what it already has."
    exposes [Progress, bodies, bodiesOn]
    depends [Bytes, Domain.Address, Domain.Block, Domain.Inbox, Domain.Index, Domain.Inventory, Domain.Network, Infra.Blocks, Infra.Peers, Infra.Store]
    effects [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]

record Progress
    pool: Pool
    store: Store
    blocks: BlockStore
    pending: List<Entry>
    waiting: Int
    count: Int

fn locationBatch() -> Int
    ? "How many Locations to hold before writing them."
      "A Store hands back a copy of itself, so one put per Block costs the size"
      "of the whole Index per Block, and the Index holds a Height for every Block"
      "in the chain. Writing in batches trades a wider crash window for that: a"
      "crash loses up to this many Locations, and the Blocks they name are"
      "fetched again on the next run, which is the direction that is safe."
    2000

verify locationBatch
    locationBatch() => 2000

fn bodies(network: Network, address: PeerAddress, store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Progress, String>
    ? "Fetch the Blocks for a range of Heights and write them to Segments."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    pool = Infra.Peers.joined(Infra.Peers.opened(network), soleKey(), address)?
    closed(pool, bodiesOn(pool, soleKey(), store, blocks, from, to))

fn soleKey() -> Int
    ? "The identifier a pool of one Peer keys it under."
    0

verify soleKey
    soleKey() => 0

fn closed(pool: Pool, outcome: Result<Progress, String>) -> Result<Progress, String>
    ? "Always release the sockets, whatever the session did."
    ! [Tcp.close]
    _closed = Infra.Peers.closeAll(pool)
    outcome

fn bodiesOn(pool: Pool, key: Int, store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Progress, String>
    ? "The same range walk on a pool somebody else opened."
      "What a node following the tip needs: the Headers say a Block exists and"
      "where it sits, and this is what turns that into a body on disk the"
      "UTXO Set can be connected from. A Height whose Block is already held is"
      "skipped, so re-running it over a range that overlaps costs nothing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    walked = walk(Progress(pool = pool, store = store, blocks = blocks, pending = [], waiting = 0, count = 0), key, from, to)?
    settled(walked)

fn settled(progress: Progress) -> Result<Progress, String>
    ? "Write whatever Locations are still held back."
    ! [Infra.Kv.putAll]
    grown = Infra.Store.putAll(progress.store, List.reverse(progress.pending))?
    Result.Ok(Progress(pool = progress.pool, store = grown, blocks = progress.blocks, pending = [], waiting = 0, count = progress.count))

fn walk(progress: Progress, key: Int, height: Int, to: Int) -> Result<Progress, String>
    ? "Each Height in turn, until the range is exhausted."
      "Each turn asks the stop flag first, so a Ctrl-C during a long fetch"
      "ends the walk at a Block boundary with what is already stored, and the"
      "command's claim is released the ordinary way (#112)."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match Bool.or(height > to, Process.stopRequested())
        true -> Result.Ok(progress)
        false -> atHeight(progress, key, height, to)

fn atHeight(progress: Progress, key: Int, height: Int, to: Int) -> Result<Progress, String>
    ? "A Height the Index does not name cannot be fetched, and ends the walk."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    named = Infra.Store.get(progress.store, Domain.Index.heightKey(height))?
    match named
        Option.None -> Result.Err("no header for height {height}; run the header phase first")
        Option.Some(blockId) -> maybeFetch(progress, key, height, to, blockId)

fn maybeFetch(progress: Progress, key: Int, height: Int, to: Int, blockId: String) -> Result<Progress, String>
    ? "A Block already held is skipped, which is what makes the phase resumable."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    held = Infra.Store.has(progress.store, Domain.Index.blockKey(blockId))?
    match held
        true -> walk(progress, key, height + 1, to)
        false -> fetch(progress, key, height, to, blockId)

fn fetch(progress: Progress, key: Int, height: Int, to: Int, blockId: String) -> Result<Progress, String>
    ? "Ask for one Block and wait for it."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    wanted = Domain.Block.wireOrder(blockId)?
    payload = Domain.Inventory.getDataPayload(Domain.Inventory.witnessBlockType(), [wanted])?
    sent = Infra.Peers.send(progress.pool, key, "getdata", payload)?
    waited = Infra.Peers.awaitFrom(sent, key, "block")?
    keep(asked(progress, waited.pool), key, height, to, blockId, waited.frame)

fn asked(progress: Progress, pool: Pool) -> Progress
    ? "The walk, carrying the pool the last question left."
    Progress(pool = pool, store = progress.store, blocks = progress.blocks, pending = progress.pending, waiting = progress.waiting, count = progress.count)

fn keep(progress: Progress, key: Int, height: Int, to: Int, blockId: String, frame: Frame) -> Result<Progress, String>
    ? "Write the Block to a Segment, then record where it went."
      "The bytes are on disk before the Index names them, so a crash between the"
      "two costs a Block that is fetched again rather than an entry pointing at"
      "nothing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    payload = Bytes.fromList(frame.body)?
    _matched = matchesRequest(key, blockId, Domain.Block.idOfWholeBlock(payload))?
    appended = Infra.Blocks.append(progress.blocks, payload)?
    held = Progress(pool = progress.pool, store = progress.store, blocks = appended.store, pending = List.prepend(Entry(key = Domain.Index.blockKey(blockId), value = Domain.Index.encodeLocation(appended.location)), progress.pending), waiting = progress.waiting + 1, count = progress.count + 1)
    written = maybeWrite(held)?
    announce(written, key, height, to, List.len(frame.body))

fn matchesRequest(key: Int, wanted: String, arrived: String) -> Result<Unit, String>
    ? "The Block that arrived has to be the Block that was asked for."
      "A getdata names a Block Id and a Peer answers with bytes. Nothing made"
      "those the same thing: until this check, whatever arrived was written"
      "to a Segment and the Index was told it was the Block we wanted, so one"
      "dishonest or confused Peer could put anything under any Block Id."
      "It is cheap -- one double-SHA256 over eighty bytes -- and it is the"
      "difference between an Index that records what a Peer said and one that"
      "records what it checked. show has always verified this on the way back"
      "out, which is how it would eventually have been noticed, a long way"
      "from the Peer that did it."
      "idOfWholeBlock rather than blockIdOf: a Block is its eighty-byte"
      "Header followed by its Transactions and only the Header is hashed."
      "Written the wrong way round first, which accused an honest Bitcoin"
      "Core node of sending the wrong Block for every Block it sent -- the"
      "check was right and the thing being compared was not."
    match wanted == arrived
        true -> Result.Ok(Unit)
        false -> Result.Err("peer {key} was asked for Block {wanted} and sent {arrived}")

verify matchesRequest
    matchesRequest(0, "aa", "aa") => Result.Ok(Unit)
    matchesRequest(3, "aa", "bb") => Result.Err("peer 3 was asked for Block aa and sent bb")

fn maybeWrite(progress: Progress) -> Result<Progress, String>
    ? "Write the batch once it is big enough, and start a new one."
    ! [Infra.Kv.putAll]
    match progress.waiting >= locationBatch()
        false -> Result.Ok(progress)
        true -> settled(progress)

fn announce(progress: Progress, key: Int, height: Int, to: Int, size: Int) -> Result<Progress, String>
    ? "Say what arrived, then move on."
    ! [
        Console.error, Console.print,
        Disk.appendBytes,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _said = Console.print("block {height}  {size} bytes  segment {Infra.Blocks.currentSegment(progress.blocks)}")
    walk(progress, key, height + 1, to)
