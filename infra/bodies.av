module Bodies
    intent =
        "The body phase: turning Heights the Header tree knows about into"
        "Block bodies on disk."
        "Held apart from the Header phase because the two share nothing but a"
        "socket -- one walks a Locator and writes k: and h:, the other walks a"
        "range of Heights and writes Segments and b: -- and because the file"
        "that held both outgrew what a reader can hold at once."
        "Not to be confused with Infra.Blocks. This is the phase that asks a"
        "Peer for a body; that is the Segment store the body is appended to."
        "The walk state is named Fetched rather than Progress, which"
        "Domain.Snapshot also exposes: distinct names, so the two are never"
        "twins to anything that resolves by unqualified name."
        "A Height whose Block is already held is skipped, which is what makes"
        "the phase resumable and what lets the follow loop run it over a range"
        "that overlaps what it already has."
    exposes [Fetched, bodies, bodiesOn]
    depends [Bytes, Domain.Address, Domain.AddressBook, Infra.Metrics, Domain.Block, Domain.Inbox, Domain.Index, Domain.Inventory, Domain.Network, Infra.Blocks, Infra.Peers, Infra.Store, Domain.IndexKeys, Domain.Screen, Domain.Screenlines, Domain.Snapshot, Infra.Pace, Infra.Screen]
    effects [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]

record Fetched
    pool: Pool
    store: Store
    blocks: BlockStore
    pending: List<Entry>
    waiting: Int
    count: Int
    bytes: Int
    pace: Pace
    eye: Eye
    book: Map<String, Candidate>
    nextKey: Int

record Owed
    key: Int
    height: Int

record Claim
    blockId: String
    height: Int

record Plan
    wanted: List<Int>
    owed: Map<String, Owed>

record Flight
    progress: Fetched
    plan: Plan
    heardMs: Int
    dialledMs: Int

fn locationBatch() -> Int
    ? "How many Locations to hold before writing them."
      "A Store hands back a copy of itself, so one put per Block costs the size"
      "of the whole Index per Block, and the Index holds a Height for every Block"
      "in the chain. Writing in batches trades a wider crash window for that: a"
      "crash loses up to this many Locations, and the Blocks they name are"
      "fetched again on the next run, which is the direction that is safe."
    2000

verify locationBatch
    locationBatch() => 2000

fn bodies(network: Network, address: PeerAddress, store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Fetched, String>
    ? "Fetch the Blocks for a range of Heights and write them to Segments."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    pool = Infra.Peers.joinedOnly(Infra.Peers.opened(network), soleKey(), address)?
    closed(pool, bodiesOn(pool, soleKey(), store, blocks, from, to, Infra.Screen.unwatched(Domain.Snapshot.started(Time.unixMs()), Infra.Metrics.none()), Domain.AddressBook.noBook(), soleKey() + 1))

fn soleKey() -> Int
    ? "The identifier a pool of one Peer keys it under."
    0

verify soleKey
    soleKey() => 0

fn closed(pool: Pool, outcome: Result<Fetched, String>) -> Result<Fetched, String>
    ? "Always release the sockets, whatever the session did."
    ! [Tcp.close, Tcp.closeDial, Tcp.closeListener]
    _closed = Infra.Peers.closeAll(pool)
    outcome

fn bodiesOn(pool: Pool, key: Int, store: Store, blocks: BlockStore, from: Int, to: Int, eye: Eye, book: Map<String, Candidate>, nextKey: Int) -> Result<Fetched, String>
    ? "The same range walk on a pool somebody else opened."
      "What a node following the tip needs: the Headers say a Block exists and"
      "where it sits, and this is what turns that into a body on disk the"
      "UTXO Set can be connected from. A Height whose Block is already held is"
      "skipped, so re-running it over a range that overlaps costs nothing."
      "The key names the Peer the caller was talking to; it is where the"
      "first Blocks are asked from and no longer the only Peer asked (#168)."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    started = Fetched(pool = pool, store = store, blocks = blocks, pending = [], waiting = 0, count = 0, bytes = 0, pace = Infra.Pace.pacedFrom(Time.unixMs()), eye = eye, book = book, nextKey = nextKey)
    flown = flying(Flight(progress = started, plan = Plan(wanted = heightsFrom(from, to, []), owed = Map.fromList([])), heardMs = Time.unixMs(), dialledMs = Time.unixMs()), to)?
    settled(flown)

fn heightsFrom(from: Int, to: Int, acc: List<Int>) -> List<Int>
    ? "The Heights in a range, lowest first, which is the order they are"
      "asked for in."
    match to < from
        true -> acc
        false -> heightsFrom(from, to - 1, List.prepend(to, acc))

verify heightsFrom
    heightsFrom(1, 3, []) => [1, 2, 3]
    heightsFrom(2, 2, []) => [2]
    heightsFrom(5, 4, []) => []
    heightsFrom(0, 0, []) => [0]

fn perPeer() -> Int
    ? "How many Blocks one Peer may owe at once."
      "Sixteen is Bitcoin Core's own MAX_BLOCKS_IN_TRANSIT_PER_PEER, and the"
      "reason for a ceiling at all is that the slowest Peer decides when the"
      "walk finishes: whatever it has been given, everyone else is waiting"
      "on. Bounded work per Peer means a slow one holds up a bounded amount"
      "of the range and the rest of the pool absorbs it."
    16

verify perPeer
    perPeer() => 16

fn tickMs() -> Int
    ? "How long one turn waits for a Block before looking at its own clock."
      "The same cadence the loop uses: long enough not to spin, short enough"
      "that a Screen redraw and the stop flag are answered promptly."
    1000

verify tickMs
    tickMs() => 1000

fn stallMs() -> Int
    ? "How long the walk waits with Blocks owed and nothing arriving before"
      "it decides the Peers owing them are not going to answer."
      "A Peer that takes a getdata and says nothing is worse than one that"
      "refuses: it holds part of the range and the walk cannot finish. Thirty"
      "seconds is well past any honest round trip, including a Peer serving a"
      "Block from spinning disk."
    30000

verify stallMs
    stallMs() => 30000

fn settled(progress: Fetched) -> Result<Fetched, String>
    ? "Write whatever Locations are still held back."
    ! [Infra.Kv.putAll]
    grown = Infra.Store.putAll(progress.store, List.reverse(progress.pending))?
    Result.Ok(Fetched(pool = progress.pool, store = grown, blocks = progress.blocks, pending = [], waiting = 0, count = progress.count, bytes = progress.bytes, pace = progress.pace, eye = progress.eye, book = progress.book, nextKey = progress.nextKey))

fn flying(flight: Flight, to: Int) -> Result<Fetched, String>
    ? "One turn: hand out what can be handed out, then take whatever comes"
      "back from whoever has it."
      "Each turn asks the stop flag first, so a Ctrl-C during a long fetch"
      "ends the walk at a Block boundary with what is already stored, and the"
      "command's claim is released the ordinary way (#112)."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Bool.or(Process.stopRequested(), flight.progress.eye.stopped)
        true -> Result.Ok(flight.progress)
        false -> flyingOn(flight, to)

fn flyingOn(flight: Flight, to: Int) -> Result<Fetched, String>
    ? "Nothing wanted and nothing owed is a range that is on disk."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Bool.and(List.len(flight.plan.wanted) == 0, Map.len(flight.plan.owed) == 0)
        true -> Result.Ok(flight.progress)
        false -> turning(flight, to)

fn turning(flight: Flight, to: Int) -> Result<Fetched, String>
    ? "A turn needs somebody to ask. The pool emptying is the one way this"
      "walk fails outright: every other fault costs one Peer and is carried"
      "by the others."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Infra.Peers.peerKeys(flight.progress.pool)
        [] -> Result.Err("no Peer is left to fetch Blocks from")
        [head, ..tail] -> asking(requeued(flight, List.prepend(head, tail)), List.prepend(head, tail), to)

fn asking(flight: Flight, live: List<Int>, to: Int) -> Result<Fetched, String>
    ? "Every Peer topped up to what it may hold, then one wait."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    filled = assigned(flight, live)?
    dialledIfDue(filled, to, Time.unixMs())

fn requeued(flight: Flight, live: List<Int>) -> Flight
    ? "Blocks owed by a Peer that has gone go back on the wanted list (#168)."
      "A Peer that closes mid-walk is dropped inside the pool, quietly and"
      "correctly -- it is one Peer of several. What it was owing would"
      "otherwise be owed by nobody, and the walk would wait for a Block that"
      "nothing was going to send. They go to the front, because they are the"
      "lowest Heights outstanding and the walk is measured by its lowest."
    withPlan(flight, regathered(flight.plan, Map.keys(flight.plan.owed), live))

fn regathered(plan: Plan, ids: List<String>, live: List<Int>) -> Plan
    ? "Each owed Block in turn."
    match ids
        [] -> plan
        [head, ..tail] -> regathered(backIfGone(plan, head, Map.get(plan.owed, head), live), tail, live)

verify regathered
    regathered(samplePlan(), ["aa"], [0]) => samplePlan()
    regathered(samplePlan(), ["aa"], [9]) => Plan(wanted = [5, 3, 7], owed = Map.fromList([]))
    regathered(samplePlan(), [], []) => samplePlan()

fn backIfGone(plan: Plan, blockId: String, owed: Option<Owed>, live: List<Int>) -> Plan
    ? "One owed Block, back on the list if the Peer that owed it is gone."
    match owed
        Option.None -> plan
        Option.Some(one) -> backUnlessLive(plan, blockId, one, List.contains(live, one.key))

verify backIfGone
    backIfGone(samplePlan(), "zz", Option.None, []) => samplePlan()
    backIfGone(samplePlan(), "aa", Option.Some(Owed(key = 0, height = 5)), [0]) => samplePlan()

fn backUnlessLive(plan: Plan, blockId: String, owed: Owed, alive: Bool) -> Plan
    ? "A live Peer keeps what it owes; a departed one gives it up."
    match alive
        true -> plan
        false -> Plan(wanted = List.prepend(owed.height, plan.wanted), owed = Map.remove(plan.owed, blockId))

verify backUnlessLive
    backUnlessLive(samplePlan(), "aa", Owed(key = 0, height = 5), true) => samplePlan()
    backUnlessLive(samplePlan(), "aa", Owed(key = 0, height = 5), false) => Plan(wanted = [5, 3, 7], owed = Map.fromList([]))

fn samplePlan() -> Plan
    ? "A Plan for the cases above: one Height wanted and one owed by Peer 0."
    Plan(wanted = [3, 7], owed = Map.fromList([("aa", Owed(key = 0, height = 5))]))

verify samplePlan
    samplePlan().wanted => [3, 7]
    Map.len(samplePlan().owed) => 1

fn assigned(flight: Flight, live: List<Int>) -> Result<Flight, String>
    ? "Each Peer given as much as it has room for."
    ! [Infra.Kv.get, Tcp.writeBytes]
    match live
        [] -> Result.Ok(flight)
        [head, ..tail] -> assignedOn(flight, head, tail)

fn assignedOn(flight: Flight, key: Int, rest: List<Int>) -> Result<Flight, String>
    ? "One Peer topped up, then the others."
    ! [Infra.Kv.get, Tcp.writeBytes]
    toppedUp = batching(flight, key, perPeer() - owedBy(flight.plan, Map.keys(flight.plan.owed), key, 0), [])?
    assigned(toppedUp, rest)

fn owedBy(plan: Plan, ids: List<String>, key: Int, acc: Int) -> Int
    ? "How many Blocks this Peer already owes."
    match ids
        [] -> acc
        [head, ..tail] -> owedBy(plan, tail, key, countedFor(Map.get(plan.owed, head), key, acc))

verify owedBy
    owedBy(samplePlan(), Map.keys(samplePlan().owed), 0, 0) => 1
    owedBy(samplePlan(), Map.keys(samplePlan().owed), 9, 0) => 0
    owedBy(samplePlan(), [], 0, 0) => 0

fn countedFor(owed: Option<Owed>, key: Int, acc: Int) -> Int
    ? "One more if this Block is owed by that Peer."
    match owed
        Option.None -> acc
        Option.Some(one) -> addedIfSame(one.key == key, acc)

verify countedFor
    countedFor(Option.None, 0, 4) => 4
    countedFor(Option.Some(Owed(key = 0, height = 3)), 0, 4) => 5
    countedFor(Option.Some(Owed(key = 1, height = 3)), 0, 4) => 4

fn batching(flight: Flight, key: Int, room: Int, taken: List<Claim>) -> Result<Flight, String>
    ? "Take Heights off the wanted list until this Peer is full."
    ! [Infra.Kv.get, Tcp.writeBytes]
    match Bool.or(room <= 0, List.len(flight.plan.wanted) == 0)
        true -> requesting(flight, key, taken)
        false -> nextWanted(flight, key, room, taken)

fn nextWanted(flight: Flight, key: Int, room: Int, taken: List<Claim>) -> Result<Flight, String>
    ? "The next Height, or nothing left to want."
    ! [Infra.Kv.get, Tcp.writeBytes]
    match flight.plan.wanted
        [] -> requesting(flight, key, taken)
        [head, ..tail] -> claiming(withPlan(flight, withWanted(flight.plan, tail)), key, room, taken, head)

fn claiming(flight: Flight, key: Int, room: Int, taken: List<Claim>, height: Int) -> Result<Flight, String>
    ? "A Height the Index does not name cannot be fetched, and ends the walk."
    ! [Infra.Kv.get, Tcp.writeBytes]
    named = Domain.Index.blockIdIn(Infra.Store.get(flight.progress.store, Domain.IndexKeys.heightKey(height)?)?)
    match named
        Option.None -> Result.Err("no header for height {height}; run the header phase first")
        Option.Some(blockId) -> claimingHeld(flight, key, room, taken, height, blockId)

fn claimingHeld(flight: Flight, key: Int, room: Int, taken: List<Claim>, height: Int, blockId: String) -> Result<Flight, String>
    ? "A Block already held is skipped, which is what makes the phase"
      "resumable. A skipped Height costs no room, so a walk over a range"
      "mostly held still fills every Peer."
    ! [Infra.Kv.get, Tcp.writeBytes]
    held = Infra.Store.has(flight.progress.store, Domain.IndexKeys.blockKey(blockId)?)?
    match held
        true -> batching(flight, key, room, taken)
        false -> batching(flight, key, room - 1, List.prepend(Claim(blockId = blockId, height = height), taken))

fn requesting(flight: Flight, key: Int, taken: List<Claim>) -> Result<Flight, String>
    ? "Nothing to ask for is the ordinary end of a top-up."
    ! [Tcp.writeBytes]
    match taken
        [] -> Result.Ok(flight)
        [head, ..tail] -> requested(flight, key, List.prepend(head, tail))

fn requested(flight: Flight, key: Int, taken: List<Claim>) -> Result<Flight, String>
    ? "One getdata naming every Block this Peer is being given."
      "A getdata carries a list, so a batch is one Message rather than one"
      "each: the Peer sees the whole of what it owes at once and can answer"
      "in whatever order suits it."
    ! [Tcp.writeBytes]
    payload = Domain.Inventory.getDataPayload(Domain.Inventory.witnessBlockType(), hashesOf(taken, [])?)?
    sent = Infra.Peers.send(flight.progress.pool, key, "getdata", payload)?
    Result.Ok(Flight(progress = withPool(flight.progress, sent), plan = owedWith(flight.plan, taken, key), heardMs = flight.heardMs, dialledMs = flight.dialledMs))

fn owedWith(plan: Plan, taken: List<Claim>, key: Int) -> Plan
    ? "Every claimed Block recorded against the Peer that was asked for it."
    match taken
        [] -> plan
        [head, ..tail] -> owedWith(Plan(wanted = plan.wanted, owed = Map.set(plan.owed, head.blockId, Owed(key = key, height = head.height))), tail, key)

verify owedWith
    owedWith(samplePlan(), [], 1) => samplePlan()
    Map.len(owedWith(samplePlan(), [Claim(blockId = "bb", height = 7)], 1).owed) => 2
    owedWith(samplePlan(), [Claim(blockId = "bb", height = 7)], 1).wanted => [3, 7]

fn waitingFor(flight: Flight, to: Int) -> Result<Fetched, String>
    ? "One bounded wait on the whole pool."
      "Where the single-Peer walk waited on one identifier, this waits on"
      "everybody and takes whichever answers first -- which is the whole of"
      "the speed-up (#168). A tick with nothing in it is a turn to look at"
      "the clock, not a fault."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    ticked = Infra.Peers.awaitTick(flight.progress.pool, tickMs())?
    landed(withPool2(flight, ticked.pool), ticked.arrived, to)

fn landed(flight: Flight, arrived: Option<Spare>, to: Int) -> Result<Fetched, String>
    ? "Something said, or a tick of silence."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match arrived
        Option.None -> quiet(flight, to)
        Option.Some(one) -> sorted(flight, one, to)

fn sorted(flight: Flight, one: Spare, to: Int) -> Result<Fetched, String>
    ? "A Block is the walk's business, a ping has to be answered, and"
      "anything else is kept for the loop that will want it (#168)."
      "The walk hears everything every Peer says while it runs -- an inv, an"
      "addr, a headers -- and none of it is its to decide about. Keeping"
      "rather than dropping is what lets follow answer it the moment the"
      "walk returns."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match one.frame.command
        "block" -> blockIn(flight, one.frame, to)
        "ping" -> ponged(flight, one.key, one.frame, to)
        _ -> flying(withPool2(flight, Infra.Peers.spared(flight.progress.pool, one.key, one.frame)), to)

fn ponged(flight: Flight, key: Int, frame: Frame, to: Int) -> Result<Fetched, String>
    ? "A ping answered mid-walk, because a Peer that is not ponged drops us"
      "-- and over a body phase of hours it will."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    payload = Bytes.fromList(frame.body)?
    sent = Infra.Peers.send(flight.progress.pool, key, "pong", payload)?
    flying(withPool2(flight, sent), to)

fn blockIn(flight: Flight, frame: Frame, to: Int) -> Result<Fetched, String>
    ? "Which Block this is, decided by hashing it rather than by who sent"
      "it or when."
      "A getdata names a Block Id and a Peer answers with bytes; nothing on"
      "the wire makes those the same thing. Hashing what arrived and looking"
      "it up in what is owed answers both questions at once -- whether it"
      "was asked for, and which Height it belongs at -- so Blocks arriving"
      "out of order and interleaved across Peers attribute themselves, and"
      "one dishonest Peer cannot put anything under any Block Id."
      "idOfWholeBlock rather than blockIdOf: a Block is its eighty-byte"
      "Header followed by its Transactions and only the Header is hashed."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    payload = Bytes.fromList(frame.body)?
    arrived = Domain.Block.idOfWholeBlock(payload)
    matched(flight, payload, arrived, Map.get(flight.plan.owed, arrived), List.len(frame.body), to)

fn matched(flight: Flight, payload: Bytes, blockId: String, owed: Option<Owed>, size: Int, to: Int) -> Result<Fetched, String>
    ? "A Block nobody is owed is passed over rather than treated as a fault."
      "It is the ordinary outcome of a requeue: a Peer that went quiet long"
      "enough to have its work reassigned may still answer, and by then the"
      "Block is on disk from somebody else. Nothing is gained by dropping"
      "the Peer for being late."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match owed
        Option.None -> flying(flight, to)
        Option.Some(one) -> kept(flight, payload, blockId, one, size, to)

fn kept(flight: Flight, payload: Bytes, blockId: String, owed: Owed, size: Int, to: Int) -> Result<Fetched, String>
    ? "Write the Block to a Segment, then record where it went."
      "The bytes are on disk before the Index names them, so a crash between"
      "the two costs a Block that is fetched again rather than an entry"
      "pointing at nothing."
      "Segments hold Blocks in the order they were fetched and never in"
      "Height order -- Infra.Prune says so and looks rather than assumes --"
      "so Blocks arriving from several Peers at once need no reordering"
      "before the write. The Location records where each one went."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    appended = Infra.Blocks.append(flight.progress.blocks, payload)?
    held = Fetched(pool = flight.progress.pool, store = flight.progress.store, blocks = appended.store, pending = List.prepend(Entry(key = Domain.IndexKeys.blockKey(blockId)?, value = Domain.Index.encodeLocation(appended.location)), flight.progress.pending), waiting = flight.progress.waiting + 1, count = flight.progress.count + 1, bytes = flight.progress.bytes + size, pace = flight.progress.pace, eye = flight.progress.eye, book = flight.progress.book, nextKey = flight.progress.nextKey)
    written = maybeWrite(held)?
    reporting(Flight(progress = written, plan = Plan(wanted = flight.plan.wanted, owed = Map.remove(flight.plan.owed, blockId)), heardMs = Time.unixMs(), dialledMs = flight.dialledMs), to)

fn quiet(flight: Flight, to: Int) -> Result<Fetched, String>
    ? "A tick with no Block in it. Usually there is simply nothing to say"
      "yet; past the stall deadline it means the Peers owing Blocks are not"
      "going to send them."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Bool.and(Time.unixMs() - flight.heardMs > stallMs(), Map.len(flight.plan.owed) > 0)
        true -> stalled(flight, to)
        false -> reporting(flight, to)

fn dialEveryMs() -> Int
    ? "How often the walk takes a turn at dialling."
      "Ten seconds. The first version of this dialled on a tick with no Block"
      "in it, which never fires: a walk keeping sixteen Blocks in flight per"
      "Peer has a Block on almost every tick, so the turn never came and the"
      "pool still only shrank. A clock fires whether the walk is busy or not,"
      "which is the point -- it is busy precisely when losing a Peer costs"
      "most."
    10000

verify dialEveryMs
    dialEveryMs() => 10000

fn dialledIfDue(flight: Flight, to: Int, nowMs: Int) -> Result<Fetched, String>
    ? "One Candidate dialled on a tick that had no Block in it (#199)."
      "The walk was waiting on the network anyway, so a dial costs a turn"
      "that was idle. Without it the pool could only shrink for the hours a"
      "body phase takes: a Peer that drops is gone until the walk ends, and"
      "since the walk keeps sixteen Blocks in flight per Peer, losing one"
      "costs a sixteenth of the download rather than a share of a queue."
      "Infra.Peers.toppedUp answers with the pool unchanged when it is"
      "already at its target or the Book has nothing untried, which is the"
      "ordinary case and costs nothing."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    match Bool.and(nowMs - flight.dialledMs >= dialEveryMs(), List.len(Infra.Peers.peerKeys(flight.progress.pool)) < Infra.Peers.targetPeers())
        false -> waitingFor(flight, to)
        true -> dialling(flight, to, nowMs)

fn dialling(flight: Flight, to: Int, nowMs: Int) -> Result<Fetched, String>
    ? "The dial itself, and the clock reset whether or not it seated anyone --"
      "a Candidate that will not answer must not be retried every turn."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    topped = Infra.Peers.toppedUp(flight.progress.pool, flight.progress.book, flight.progress.nextKey)?
    waitingFor(Flight(progress = Fetched(pool = topped.pool, store = flight.progress.store, blocks = flight.progress.blocks, pending = flight.progress.pending, waiting = flight.progress.waiting, count = flight.progress.count, bytes = flight.progress.bytes, pace = flight.progress.pace, eye = flight.progress.eye, book = topped.book, nextKey = topped.nextKey), plan = flight.plan, heardMs = flight.heardMs, dialledMs = nowMs), to)

fn stalled(flight: Flight, to: Int) -> Result<Fetched, String>
    ? "Drop every Peer that owes a Block and has not sent one, and want"
      "again what they were owing."
      "A Peer that accepts a getdata and then says nothing holds part of the"
      "range for as long as it is left in the pool, and nothing else can"
      "make progress on it. Dropping is what makes the walk finish: the"
      "Heights go back on the list, whoever is left is asked, and a pool"
      "that empties this way ends the walk with a reason rather than"
      "hanging."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    shed = dropping(flight.progress.pool, owingKeys(flight.plan, Map.keys(flight.plan.owed), []))?
    flying(Flight(progress = withPool(flight.progress, shed), plan = Plan(wanted = List.concat(owedHeights(flight.plan, Map.keys(flight.plan.owed), []), flight.plan.wanted), owed = Map.fromList([])), heardMs = Time.unixMs(), dialledMs = flight.dialledMs), to)

fn dropping(pool: Pool, keys: List<Int>) -> Result<Pool, String>
    ? "Each silent Peer closed and forgotten."
    ! [Console.error, Tcp.close]
    match keys
        [] -> Result.Ok(pool)
        [head, ..tail] -> droppingOn(pool, head, tail)

fn droppingOn(pool: Pool, key: Int, rest: List<Int>) -> Result<Pool, String>
    ? "One of them, said out loud because a Peer leaving is worth knowing."
    ! [Console.error, Tcp.close]
    _said = Console.error("dropping peer {key}: owed Blocks and sent none for {Int.div(stallMs(), 1000)} seconds")
    dropping(Infra.Peers.dropOne(pool, key)?, rest)

fn owingKeys(plan: Plan, ids: List<String>, acc: List<Int>) -> List<Int>
    ? "Every Peer that owes at least one Block, named once."
    match ids
        [] -> acc
        [head, ..tail] -> owingKeys(plan, tail, keyOnce(Map.get(plan.owed, head), acc))

verify owingKeys
    owingKeys(samplePlan(), Map.keys(samplePlan().owed), []) => [0]
    owingKeys(samplePlan(), [], []) => []

fn addedUnlessThere(key: Int, acc: List<Int>) -> List<Int>
    ? "A list that names each Peer once."
    match List.contains(acc, key)
        true -> acc
        false -> List.prepend(key, acc)

verify addedUnlessThere
    addedUnlessThere(2, []) => [2]
    addedUnlessThere(2, [2]) => [2]
    addedUnlessThere(2, [3]) => [2, 3]

fn owedHeights(plan: Plan, ids: List<String>, acc: List<Int>) -> List<Int>
    ? "The Heights that were owed, to be wanted again."
    match ids
        [] -> acc
        [head, ..tail] -> owedHeights(plan, tail, heightOnce(Map.get(plan.owed, head), acc))

verify owedHeights
    owedHeights(samplePlan(), Map.keys(samplePlan().owed), []) => [5]
    owedHeights(samplePlan(), [], []) => []

fn reporting(flight: Flight, to: Int) -> Result<Fetched, String>
    ? "A progress line each minute, rather than a line for every Block."
      "The walk fetches thousands of Blocks a minute at the start of the"
      "chain, and a reader watching it wants where it is, how fast it is"
      "going and how long is left (#129) -- not one line per Block. The line"
      "goes through the same minute gate every long walk uses."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    saying(flight, to, Time.unixMs())

fn saying(flight: Flight, to: Int, nowMs: Int) -> Result<Fetched, String>
    ? "Say where the walk is when a line is due, and stay quiet otherwise."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    at = positionOf(flight.plan, to)
    recorded = Infra.Metrics.marked(flight.progress.eye.log, "bodies", at, to, flight.progress.count, flight.progress.bytes, Infra.Peers.polledMsOf(flight.progress.pool), List.len(Infra.Peers.peerKeys(flight.progress.pool)), flight.progress.eye.candidates, 0, 0, false)?
    looked = Infra.Screen.glanced(Infra.Screen.logging(Infra.Screen.eyeing(flight.progress.eye, Domain.Snapshot.withPeers(Domain.Snapshot.bodiesAt(flight.progress.eye.snapshot, at, to, nowMs), Infra.Peers.company(flight.progress.pool))), recorded), nowMs)?
    seen = withEye(flight.progress, looked)
    match Bool.and(Infra.Pace.due(seen.pace, nowMs, seen.count - 1), plainly(seen.eye))
        false -> flying(withProgress(flight, seen), to)
        true -> said(flight, seen, at, to, nowMs)

fn said(flight: Flight, progress: Fetched, at: Int, to: Int, nowMs: Int) -> Result<Fetched, String>
    ? "The line, and the Pace the next one measures from."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.appendText,
        Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    _said = Console.print("{lineAt(at, to, progress.count, progress.pace, nowMs)}")
    flying(withProgress(flight, Fetched(pool = progress.pool, store = progress.store, blocks = progress.blocks, pending = progress.pending, waiting = progress.waiting, count = progress.count, bytes = progress.bytes, pace = Infra.Pace.advanced(progress.pace, nowMs, progress.count, 0), eye = progress.eye, book = progress.book, nextKey = progress.nextKey)), to)

fn positionOf(plan: Plan, to: Int) -> Int
    ? "Where the walk has got to: the lowest Height it still wants or is"
      "still owed. Everything below that is on disk."
      "With one Peer the position was simply the Height being fetched. With"
      "several there is no single Height being fetched, and the honest"
      "number is the low-water mark -- which is also the one that cannot go"
      "backwards when a high Block arrives before a low one."
    settledAt(lowestOwed(plan, Map.keys(plan.owed), Option.None), plan.wanted, to)

verify positionOf
    positionOf(samplePlan(), 100) => 3
    positionOf(Plan(wanted = [], owed = Map.fromList([])), 100) => 100
    positionOf(Plan(wanted = [9], owed = Map.fromList([])), 100) => 9

fn settledAt(owedLow: Option<Int>, wanted: List<Int>, to: Int) -> Int
    ? "The lower of what is owed and what is still wanted; the end of the"
      "range when neither holds anything."
    match owedLow
        Option.None -> firstOr(wanted, to)
        Option.Some(low) -> lowerOfHead(low, wanted)

verify settledAt
    settledAt(Option.None, [], 100) => 100
    settledAt(Option.None, [7, 8], 100) => 7
    settledAt(Option.Some(4), [7, 8], 100) => 4
    settledAt(Option.Some(9), [7, 8], 100) => 7

fn firstOr(wanted: List<Int>, to: Int) -> Int
    ? "The first Height still wanted, or the end of the range."
    match wanted
        [] -> to
        [head, ..tail] -> head

verify firstOr
    firstOr([], 100) => 100
    firstOr([7, 8], 100) => 7

fn lowerOfHead(low: Int, wanted: List<Int>) -> Int
    ? "The lower of an owed Height and the first still wanted."
    match wanted
        [] -> low
        [head, ..tail] -> lowerOf(low, head)

verify lowerOfHead
    lowerOfHead(4, []) => 4
    lowerOfHead(4, [7]) => 4
    lowerOfHead(9, [7]) => 7

fn lowerOf(a: Int, b: Int) -> Int
    ? "The smaller of two Heights."
    match a <= b
        true -> a
        false -> b

verify lowerOf
    lowerOf(4, 7) => 4
    lowerOf(7, 4) => 4
    lowerOf(4, 4) => 4

fn lowestOwed(plan: Plan, ids: List<String>, best: Option<Int>) -> Option<Int>
    ? "The lowest Height any Peer still owes."
    match ids
        [] -> best
        [head, ..tail] -> lowestOwed(plan, tail, betterLow(best, Map.get(plan.owed, head)))

verify lowestOwed
    lowestOwed(samplePlan(), Map.keys(samplePlan().owed), Option.None) => Option.Some(5)
    lowestOwed(samplePlan(), [], Option.None) => Option.None

fn loweredBy(best: Option<Int>, height: Int) -> Option<Int>
    ? "The lower of a Height and one we may not have."
    match best
        Option.None -> Option.Some(height)
        Option.Some(current) -> Option.Some(lowerOf(current, height))

verify loweredBy
    loweredBy(Option.None, 5) => Option.Some(5)
    loweredBy(Option.Some(3), 5) => Option.Some(3)
    loweredBy(Option.Some(7), 5) => Option.Some(5)

fn withWanted(plan: Plan, wanted: List<Int>) -> Plan
    ? "The Plan, with its wanted list moved on."
    Plan(wanted = wanted, owed = plan.owed)

verify withWanted
    withWanted(samplePlan(), [9]).wanted => [9]
    Map.len(withWanted(samplePlan(), [9]).owed) => 1

fn withPlan(flight: Flight, plan: Plan) -> Flight
    ? "The flight, with its bookkeeping moved on."
    Flight(progress = flight.progress, plan = plan, heardMs = flight.heardMs, dialledMs = flight.dialledMs)

fn withProgress(flight: Flight, progress: Fetched) -> Flight
    ? "The flight, with the walk's own state moved on."
    Flight(progress = progress, plan = flight.plan, heardMs = flight.heardMs, dialledMs = flight.dialledMs)

fn withPool2(flight: Flight, pool: Pool) -> Flight
    ? "The flight, carrying the pool a wait or a send left behind."
    withProgress(flight, withPool(flight.progress, pool))

fn withPool(progress: Fetched, pool: Pool) -> Fetched
    ? "The walk, carrying the pool the last question left."
    Fetched(pool = pool, store = progress.store, blocks = progress.blocks, pending = progress.pending, waiting = progress.waiting, count = progress.count, bytes = progress.bytes, pace = progress.pace, eye = progress.eye, book = progress.book, nextKey = progress.nextKey)

fn addedIfSame(same: Bool, acc: Int) -> Int
    ? "One more, or the same."
    match same
        true -> acc + 1
        false -> acc

verify addedIfSame
    addedIfSame(true, 3) => 4
    addedIfSame(false, 3) => 3

fn maybeWrite(progress: Fetched) -> Result<Fetched, String>
    ? "Write the batch once it is big enough, and start a new one."
    ! [Infra.Kv.putAll]
    match progress.waiting >= locationBatch()
        false -> Result.Ok(progress)
        true -> settled(progress)

fn withEye(progress: Fetched, eye: Eye) -> Fetched
    ? "The walk's state, with its Eye moved on."
    Fetched(pool = progress.pool, store = progress.store, blocks = progress.blocks, pending = progress.pending, waiting = progress.waiting, count = progress.count, bytes = progress.bytes, pace = progress.pace, eye = eye, book = progress.book, nextKey = progress.nextKey)

fn plainly(eye: Eye) -> Bool
    ? "Whether this walk speaks in printed lines; the Screen draws instead."
    match eye.view
        Option.None -> true
        Option.Some(view) -> false

verify plainly
    plainly(Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none())) => true
    plainly(Infra.Screen.watchedBy(Option.Some(Domain.Screen.opened()), Domain.Snapshot.started(0), Infra.Metrics.none(), 0)) => false

fn hashesOf(taken: List<Claim>, acc: List<List<Int>>) -> Result<List<List<Int>>, String>
    ? "Every claimed Block Id in the order the wire wants them."
    match taken
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> hashesOf(tail, List.prepend(Domain.Block.wireOrder(head.blockId)?, acc))

verify hashesOf
    hashesOf([], []) => Result.Ok([])
    List.len(Result.withDefault(hashesOf([Claim(blockId = "00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff", height = 1)], []), [])) => 1

fn keyOnce(owed: Option<Owed>, acc: List<Int>) -> List<Int>
    ? "One Peer added, unless it is already named."
    match owed
        Option.None -> acc
        Option.Some(one) -> addedUnlessThere(one.key, acc)

verify keyOnce
    keyOnce(Option.None, [4]) => [4]
    keyOnce(Option.Some(Owed(key = 2, height = 9)), []) => [2]

fn heightOnce(owed: Option<Owed>, acc: List<Int>) -> List<Int>
    ? "One Height added, if the Block is owed at all."
    match owed
        Option.None -> acc
        Option.Some(one) -> List.prepend(one.height, acc)

verify heightOnce
    heightOnce(Option.None, [4]) => [4]
    heightOnce(Option.Some(Owed(key = 2, height = 9)), []) => [9]

fn betterLow(best: Option<Int>, owed: Option<Owed>) -> Option<Int>
    ? "Keep whichever Height is lower."
    match owed
        Option.None -> best
        Option.Some(one) -> loweredBy(best, one.height)

verify betterLow
    betterLow(Option.Some(3), Option.None) => Option.Some(3)
    betterLow(Option.None, Option.Some(Owed(key = 0, height = 5))) => Option.Some(5)
    betterLow(Option.Some(9), Option.Some(Owed(key = 0, height = 5))) => Option.Some(5)

fn lineAt(height: Int, to: Int, count: Int, pace: Pace, nowMs: Int) -> String
    ? "The walk's first line has no window to read a rate off, and says so"
      "by saying less: where the walk starts and how far it goes. Rate and"
      "eta wait for a real minute -- the first draft of this line read"
      "'1000.0/s eta 0s' after one Block and one millisecond."
    match nowMs - pace.lastMs >= Infra.Pace.reportEveryMs()
        true -> paceLine(height, to, count, pace, nowMs)
        false -> "blocks {height}/{to} ({percentAt(height, to)}%)"

verify lineAt
    lineAt(1, 168, 1, Infra.Pace.pacedFrom(0), 1) => "blocks 1/168 (0%)"
    lineAt(300, 1000, 240, Infra.Pace.advanced(Infra.Pace.pacedFrom(0), 0, 0, 0), 60000) => "blocks 300/1000 (30%) 4.0/s eta 2m55s"

fn paceLine(height: Int, to: Int, count: Int, pace: Pace, nowMs: Int) -> String
    ? "Where the walk is, how fast it is going, and how long is left at that"
      "speed -- the sentence a chain download is watched by (#129)."
    "blocks {height}/{to} ({percentAt(height, to)}%) {Infra.Pace.perSecond(count - pace.lastBlocks, nowMs - pace.lastMs)}/s eta {etaText(to - height, count - pace.lastBlocks, nowMs - pace.lastMs)}"

verify paceLine
    paceLine(300, 1000, 240, Infra.Pace.advanced(Infra.Pace.pacedFrom(0), 0, 0, 0), 60000) => "blocks 300/1000 (30%) 4.0/s eta 2m55s"
    paceLine(1000, 1000, 240, Infra.Pace.advanced(Infra.Pace.pacedFrom(0), 0, 240, 0), 60000) => "blocks 1000/1000 (100%) 0.0/s eta ?"

fn percentAt(height: Int, to: Int) -> Int
    ? "How far up the range the walk has reached, in whole percent."
    match to > 0
        true -> Result.withDefault(Int.div(height * 100, to), 0)
        false -> 0

verify percentAt
    percentAt(300, 1000) => 30
    percentAt(0, 0) => 0

fn etaText(remaining: Int, recent: Int, elapsedMs: Int) -> String
    ? "How long the rest takes at the recent rate, or a question mark while"
      "there is no rate to read."
      "No elapsed time is as unreadable as no count: the first line of a walk"
      "was claiming eta 0s, which is a finished download it had not started."
    match Bool.and(recent > 0, elapsedMs > 0)
        true -> Domain.Screenlines.spanText(Result.withDefault(Int.div(remaining * elapsedMs, recent * 1000), 0))
        false -> "?"

verify etaText
    etaText(700, 240, 60000) => "2m55s"
    etaText(0, 240, 60000) => "0s"
    etaText(700, 0, 60000) => "?"
    etaText(700, 1, 0) => "?"
