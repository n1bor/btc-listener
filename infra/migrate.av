module Migrate
    intent =
        "Moving a directory's index from the append-only log into the database"
        "beside it, once."
        "Its own module because it is a one-shot tool rather than part of what a"
        "Store does. Nothing in the daily path calls it, and Infra.Store is"
        "close enough to the file-size limit that a command run once should not"
        "be the thing that pushes it over."
        "The log is left where it is. Moving forward is this command and moving"
        "back is renaming a directory, which is the whole reason Infra.Store.open"
        "decides by what is on disk rather than by a flag."
        "It refuses a directory that already has a database. Running it twice"
        "would usually be harmless, since the keys are the same and a put is"
        "idempotent, but a second run over a log that has since been added to"
        "would write stale values over fresher ones, and there is no reading of"
        "the request under which that is what was wanted."
    exposes [migrate]
    depends [Infra.Kv, Infra.Store]
    effects [Disk.exists, Disk.makeDir, Disk.readText, Infra.Kv.open, Infra.Kv.putAll]

fn migrate(dir: String) -> Result<Int, String>
    ? "Copy everything the log in this directory holds into a database beside it."
      "One shot, and it does not delete the log. Moving forward is this command"
      "and moving back is renaming a directory, which is the whole reason open"
      "decides by what is on disk rather than by a flag."
      "It refuses a directory that already has a database. Running it twice"
      "would be harmless — the keys are the same and a put is idempotent — but a"
      "second run over a log that has since been added to would quietly write"
      "stale values over fresher ones, and there is no reading of the request"
      "under which that is what was wanted."
    ! [Disk.exists, Disk.makeDir, Disk.readText, Infra.Kv.open, Infra.Kv.putAll]
    already = Infra.Store.databaseHere(dir)?
    poured(dir, already)

fn poured(dir: String, already: Bool) -> Result<Int, String>
    ? "Replay the log into a database, unless there is already one there."
    ! [Disk.exists, Disk.makeDir, Disk.readText, Infra.Kv.open, Infra.Kv.putAll]
    match already
        true -> Result.Err("{Infra.Store.databasePath(dir)} already holds a database; remove or rename it to migrate again")
        false -> intoDatabase(dir, Infra.Store.openLogged(dir))

fn intoDatabase(dir: String, logged: Result<Store, String>) -> Result<Int, String>
    ? "Open the database and pour the log's entries into it."
    ! [Infra.Kv.open, Infra.Kv.putAll]
    entries = Infra.Store.heldBy(logged?)?
    handle = Infra.Kv.open(Infra.Store.databasePath(dir))?
    pouredIn(entries, handle, 0)

fn pouredIn(pairs: List<Tuple<String, String>>, handle: Infra.Kv.Handle, done: Int) -> Result<Int, String>
    ? "Write the entries in batches, counting what has gone in."
      "In batches because one WriteBatch of 1484520 records would be built in"
      "memory before any of it reached the disk, and one batch per record would"
      "be 1484520 round trips. The number is the same order as the batches the"
      "callers already use."
    ! [Infra.Kv.putAll]
    match pairs
        [] -> Result.Ok(done)
        [head, ..tail] -> pouredNext(pairs, handle, done)

fn pouredNext(pairs: List<Tuple<String, String>>, handle: Infra.Kv.Handle, done: Int) -> Result<Int, String>
    ? "One batch, then the rest."
    ! [Infra.Kv.putAll]
    batch = List.take(pairs, batchSize())
    _written = Infra.Kv.putAll(handle, batch)?
    pouredIn(List.drop(pairs, batchSize()), handle, done + List.len(batch))

fn batchSize() -> Int
    ? "How many entries go into the database at once."
    20000

verify batchSize
    batchSize() > 0 => true
