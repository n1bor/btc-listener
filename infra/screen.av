module Screen
    intent =
        "The one piece of the Screen that touches a terminal."
        "Domain.Screen decides every character and every cursor position;"
        "this executes those decisions, owns the raw-mode lifecycle, and"
        "drains the keyboard. Restoring the terminal ignores errors on"
        "purpose: restore is the last thing done on every way out, and a"
        "restore that fails has nowhere better to send its complaint than"
        "the terminal it failed to restore (#130)."
    exposes [keeping, chunking, chunkDone, blockWatched, stopAskedAt, Eye, entered, restored, shown, drainedKeys, unwatched, watchedBy, glanced, eyeing, logging, counting]
    depends [Domain.AddressBook, Domain.Network, Domain.Screen, Domain.Snapshot, Domain.Watchdog, Infra.Board, Infra.Metrics, Infra.Peers, Infra.Tending]
    effects [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.unixMs,
    ]

record Eye
    view: Option<View>
    snapshot: Snapshot
    shownMs: Int
    stopped: Bool
    log: Log
    candidates: Int
    board: Option<Board>
    boardMs: Int
    chunkFrom: Int
    chunkTo: Int
    chunkStartedMs: Int
    chunkBudgetMs: Int
    chunkSaid: Bool
    blockEndedMs: Int
    stopAskedMs: Int
    company: Option<Kept>
    tendedMs: Int

fn unwatched(snapshot: Snapshot, log: Log) -> Eye
    ? "An Eye for a caller with no Screen: every glance is free and blind."
      "Blind to a terminal, not to the metrics log -- a run with no Screen"
      "still records itself (#180)."
    Eye(view = Option.None, snapshot = snapshot, shownMs = 0, stopped = false, log = log, candidates = 0, board = Option.None, boardMs = 0, chunkFrom = 0, chunkTo = 0, chunkStartedMs = 0, chunkBudgetMs = 0, chunkSaid = false, blockEndedMs = 0, stopAskedMs = 0, company = Option.None, tendedMs = 0)

fn watchedBy(view: Option<View>, snapshot: Snapshot, log: Log, candidates: Int, board: Option<Board>) -> Eye
    ? "The Eye a screened follow threads through its walks (#130), carrying"
      "the metrics log those walks write to (#180)."
      "The Eye is what a long walk carries to report itself, and there are"
      "two ways to report: draw a frame, and write a record. It carries the"
      "log rather than writing it, so the walk decides what a record says --"
      "only the walk knows which phase it is or how far along."
    Eye(view = view, snapshot = snapshot, shownMs = 0, stopped = false, log = log, candidates = candidates, board = board, boardMs = 0, chunkFrom = 0, chunkTo = 0, chunkStartedMs = 0, chunkBudgetMs = 0, chunkSaid = false, blockEndedMs = 0, stopAskedMs = 0, company = Option.None, tendedMs = 0)

fn eyeing(eye: Eye, snapshot: Snapshot) -> Eye
    ? "The Eye, with the Snapshot it will draw from moved on."
    Eye(view = eye.view, snapshot = snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs)

fn counting(eye: Eye, candidates: Int) -> Eye
    ? "The Eye, with the Candidate count brought up to date (#230)."
      "Taken at the start of a walk and never moved after, which was fine"
      "while only the metrics log read it and wrong the moment the Panel"
      "did: a catch-up of hours would have reported the Book it held when"
      "it began."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs)

verify counting
    counting(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 7).candidates => 7

fn logging(eye: Eye, log: Log) -> Eye
    ? "The Eye, with the metrics log moved on after a record."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs)

fn redrawEveryMs() -> Int
    ? "How often a catch-up frame is redrawn: every ten seconds, the cadence"
      "the front screen was specified with (#128)."
    10000

verify redrawEveryMs
    redrawEveryMs() => 10000

fn glanced(eye: Eye, nowMs: Int) -> Result<Eye, String>
    ? "One look at the terminal from inside a long walk: keys handled, the"
      "frame redrawn when its ten seconds are up, and a stop remembered."
      "With no Screen this is one match and nothing else, so the walks can"
      "call it unconditionally."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.unixMs,
    ]
    boarded = answeredBoard(chunkWatched(tendedCompany(eye, nowMs)?, nowMs)?, nowMs)
    match boarded.view
        Option.None -> Result.Ok(boarded)
        Option.Some(view) -> glancedAt(boarded, view, nowMs)

fn chunking(eye: Eye, from: Int, to: Int, startedMs: Int, budgetMs: Int) -> Eye
    ? "The Eye told which chunk it is walking and how long that may take"
      "(#268), so a glance inside the walk can say when it has run over."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = from, chunkTo = to, chunkStartedMs = startedMs, chunkBudgetMs = budgetMs, chunkSaid = false, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs)

verify chunking
    chunking(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 10, 20, 500, 50000).chunkTo => 20
    chunking(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 10, 20, 500, 50000).chunkSaid => false

fn chunkWatched(eye: Eye, nowMs: Int) -> Result<Eye, String>
    ? "One line to debug.log the first time the chunk runs past its budget"
      "(#268): the range, how long, where it has got to. Said once; the"
      "chunk's end says the rest. #266 would have been this line in its"
      "first minute."
    ! [Disk.appendText, Time.unixMs]
    match Bool.and(Bool.not(eye.chunkSaid), Domain.Watchdog.overrun(eye.chunkStartedMs, nowMs, eye.chunkBudgetMs))
        false -> Result.Ok(eye)
        true -> chunkSaidNow(eye, Infra.Metrics.noting(eye.log, "watchdog", Domain.Watchdog.slowChunk(eye.chunkFrom, eye.chunkTo, eye.snapshot.sets.done, nowMs - eye.chunkStartedMs, eye.chunkBudgetMs))?)

fn chunkSaidNow(eye: Eye, log: Log) -> Result<Eye, String>
    ? "The Eye remembering it has said so."
    Result.Ok(Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = true, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs))

verify chunkSaidNow
    chunkSaidNow(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), Infra.Metrics.none())?.chunkSaid => true

fn chunkDone(eye: Eye, reached: Int, nowMs: Int) -> Result<Eye, String>
    ? "The end of a chunk that was said to be slow, said too (#268)."
    ! [Disk.appendText, Time.unixMs]
    match eye.chunkSaid
        false -> Result.Ok(eye)
        true -> Result.Ok(logging(eye, Infra.Metrics.noting(eye.log, "watchdog", Domain.Watchdog.slowChunkDone(eye.chunkFrom, eye.chunkTo, reached, nowMs - eye.chunkStartedMs))?))

fn blockWatched(eye: Eye, view: BlockView) -> Result<Eye, String>
    ? "A Block that took longer than its budget to connect, said after"
      "the fact (#268): the clock is the previous Block's end, which the"
      "Eye keeps, and a Block is one call nothing looks inside."
    ! [Disk.appendText, Time.unixMs]
    match Bool.and(eye.blockEndedMs > 0, Domain.Watchdog.overrun(eye.blockEndedMs, view.atMs, Domain.Watchdog.blockBudgetMs()))
        false -> Result.Ok(blockEndedAt(eye, view.atMs))
        true -> Result.Ok(blockEndedAt(logging(eye, Infra.Metrics.noting(eye.log, "watchdog", Domain.Watchdog.slowBlock(view.height, view.blockId, view.transactions, view.bytes, view.atMs - eye.blockEndedMs))?), view.atMs))

fn blockEndedAt(eye: Eye, nowMs: Int) -> Eye
    ? "The clock the next Block is measured from."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = nowMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs)

verify blockEndedAt
    blockEndedAt(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 77).blockEndedMs => 77

fn stopAskedAt(eye: Eye, nowMs: Int) -> Eye
    ? "When the stop was first asked for, kept so the loop can say how"
      "long it took to land (#268); a second asking does not move it."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = askedAt(eye.stopAskedMs, nowMs), company = eye.company, tendedMs = eye.tendedMs)

verify stopAskedAt
    stopAskedAt(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 500).stopAskedMs => 500
    stopAskedAt(stopAskedAt(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 500), 900).stopAskedMs => 500

fn askedAt(before: Int, nowMs: Int) -> Int
    ? "The first asking wins."
    match before > 0
        true -> before
        false -> nowMs

verify askedAt
    askedAt(0, 9) => 9
    askedAt(4, 9) => 4

fn keeping(eye: Eye, company: Kept) -> Eye
    ? "The Eye handed the company to keep while it walks (#275)."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = Option.Some(company), tendedMs = eye.tendedMs)

verify keeping
    keeping(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), Infra.Tending.kept(Infra.Peers.opened(Network.Regtest), Domain.AddressBook.noBook(), 3, Infra.Metrics.none())).tendedMs => 0

fn tendEveryMs() -> Int
    ? "How often a walk tends the company it keeps: once a second, the"
      "loop's own cadence (#275)."
    1000

verify tendEveryMs
    tendEveryMs() => 1000

fn tendedCompany(eye: Eye, nowMs: Int) -> Result<Eye, String>
    ? "The company tended from inside the walk, once a second (#275):"
      "Peers read, the dial asked, a Candidate seated, the next dial begun."
      "The log rides with the company so a seat is noted where the loop"
      "would note it; a walk with no company glances for free."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match eye.company
        Option.None -> Result.Ok(eye)
        Option.Some(company) -> tendedCompanyDue(eye, company, nowMs, nowMs - eye.tendedMs >= tendEveryMs())

fn tendedCompanyDue(eye: Eye, company: Kept, nowMs: Int, due: Bool) -> Result<Eye, String>
    ? "Only when a second has passed since the last tending."
    ! [
        Console.error, Console.print,
        Disk.appendText,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match due
        false -> Result.Ok(eye)
        true -> Result.Ok(tendedAt(eye, Infra.Tending.tended(Infra.Tending.kept(company.pool, company.book, company.nextKey, eye.log))?, nowMs))

fn tendedAt(eye: Eye, company: Kept, nowMs: Int) -> Eye
    ? "The company and its log back on the Eye, and the clock moved on."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = company.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = Option.Some(company), tendedMs = nowMs)

verify tendedAt
    tendedAt(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), Infra.Tending.kept(Infra.Peers.opened(Network.Regtest), Domain.AddressBook.noBook(), 3, Infra.Metrics.none()), 500).tendedMs => 500

fn boardEveryMs() -> Int
    ? "How often a walk answers the Board: once a second, the loop's own"
      "cadence, so a page asked for during a catch-up is a second away"
      "rather than a chunk away (#261)."
    1000

verify boardEveryMs
    boardEveryMs() => 1000

fn answeredBoard(eye: Eye, nowMs: Int) -> Eye
    ? "The Board answered from inside a walk, once a second, from the"
      "Snapshot the Eye holds; a walk with no Board glances for free."
    ! [Tcp.accept, Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes]
    match eye.board
        Option.None -> eye
        Option.Some(board) -> answeredBoardDue(eye, board, nowMs, nowMs - eye.boardMs >= boardEveryMs())

fn answeredBoardDue(eye: Eye, board: Board, nowMs: Int, due: Bool) -> Eye
    ? "Only when a second has passed since the last answer."
    ! [Tcp.accept, Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes]
    match due
        false -> eye
        true -> answeredBoardNow(eye, nowMs, Infra.Board.served(board, eye.snapshot, nowMs))

fn answeredBoardNow(eye: Eye, nowMs: Int, served: Result<Unit, String>) -> Eye
    ? "The clock moved on whatever the Board did: a Reader is its own"
      "business, never the walk's."
    Eye(view = eye.view, snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = nowMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs)

verify answeredBoardNow
    answeredBoardNow(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 5000, Result.Ok(Unit)).boardMs => 5000
    answeredBoardNow(unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), 5000, Result.Err("x")).boardMs => 5000

fn glancedAt(eye: Eye, view: View, nowMs: Int) -> Result<Eye, String>
    ? "Keys folded, then the redraw decision."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey]
    keys = drainedKeys()?
    acted = Domain.Screen.pressedAll(view, keys)
    match acted.answer
        Answer.StopNode -> Result.Ok(Eye(view = Option.Some(acted.view), snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = true, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = askedAt(eye.stopAskedMs, nowMs), company = eye.company, tendedMs = eye.tendedMs))
        Answer.Redraw -> drawnAt(eye, acted.view, nowMs)
        Answer.Unchanged -> maybeDrawn(eye, acted.view, nowMs)

fn maybeDrawn(eye: Eye, view: View, nowMs: Int) -> Result<Eye, String>
    ? "Redraw only when the last frame has gone stale."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    match nowMs - eye.shownMs >= redrawEveryMs()
        true -> drawnAt(eye, view, nowMs)
        false -> Result.Ok(Eye(view = Option.Some(view), snapshot = eye.snapshot, shownMs = eye.shownMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs))

fn drawnAt(eye: Eye, view: View, nowMs: Int) -> Result<Eye, String>
    ? "The frame onto the terminal, and the clock that gates the next one."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    _drawn = shown(Domain.Screen.frameOf(view, eye.snapshot, nowMs))?
    Result.Ok(Eye(view = Option.Some(view), snapshot = eye.snapshot, shownMs = nowMs, stopped = eye.stopped, log = eye.log, candidates = eye.candidates, board = eye.board, boardMs = eye.boardMs, chunkFrom = eye.chunkFrom, chunkTo = eye.chunkTo, chunkStartedMs = eye.chunkStartedMs, chunkBudgetMs = eye.chunkBudgetMs, chunkSaid = eye.chunkSaid, blockEndedMs = eye.blockEndedMs, stopAskedMs = eye.stopAskedMs, company = eye.company, tendedMs = eye.tendedMs))

fn entered() -> Result<Unit, String>
    ? "Take the terminal: raw mode, no cursor, a clean slate."
    ! [Terminal.clear, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor]
    _raw = Terminal.enableRawMode()?
    _hidden = Terminal.hideCursor()?
    _cleared = Terminal.clear()?
    Terminal.flush()

fn restored() -> Unit
    ? "Give the terminal back, whatever state the Screen died in."
      "Each step is attempted regardless of the one before: a cursor that"
      "cannot be shown is no reason to leave raw mode on."
    ! [Terminal.disableRawMode, Terminal.flush, Terminal.showCursor]
    _cursor = Terminal.showCursor()
    _raw = Terminal.disableRawMode()
    _flushed = Terminal.flush()
    Unit

fn shown(ops: List<DrawOp>) -> Result<Unit, String>
    ? "One frame onto the terminal, flushed as a whole."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    executing(ops)

fn executing(ops: List<DrawOp>) -> Result<Unit, String>
    ? "Each operation in order; the flush is the frame ending."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    match ops
        [] -> Terminal.flush()
        [head, ..tail] -> stepped(head, tail)

fn stepped(op: DrawOp, rest: List<DrawOp>) -> Result<Unit, String>
    ? "One operation, then the rest."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    match op
        DrawOp.ClearAll -> after(Terminal.clear(), rest)
        DrawOp.MoveTo(x, y) -> after(Terminal.moveTo(x, y), rest)
        DrawOp.Text(text) -> after(Terminal.print(text), rest)

fn after(done: Result<Unit, String>, rest: List<DrawOp>) -> Result<Unit, String>
    ? "Carry on only while the terminal is still taking instructions."
    ! [Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print]
    _ok = done?
    executing(rest)

fn keyBudget() -> Int
    ? "How many keys one drain will take."
      "A bound, so a wedged input stream cannot hold the loop; nobody"
      "presses thirty-two meaningful keys in one second."
    32

verify keyBudget
    keyBudget() => 32

fn drainedKeys() -> Result<List<String>, String>
    ? "Every key pressed since the last drain, oldest first."
    ! [Terminal.readKey]
    draining(keyBudget(), [])

fn draining(budget: Int, acc: List<String>) -> Result<List<String>, String>
    ? "Read until the terminal has nothing more, or the budget is spent."
    ! [Terminal.readKey]
    match budget <= 0
        true -> Result.Ok(List.reverse(acc))
        false -> drainedOne(budget, acc, Terminal.readKey()?)

fn drainedOne(budget: Int, acc: List<String>, got: Option<String>) -> Result<List<String>, String>
    ? "One key taken, or the drain complete."
    ! [Terminal.readKey]
    match got
        Option.None -> Result.Ok(List.reverse(acc))
        Option.Some(key) -> draining(budget - 1, List.prepend(key, acc))
