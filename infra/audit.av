module Audit
    intent =
        "Run every check we have over a range of Heights and report what fails."
        "A prefix of the chain is self-contained: every Input names a parent at a"
        "lower Height, so holding 1..N means holding every parent. Over such a"
        "prefix an unresolved Input is a defect rather than a gap in coverage,"
        "which is what makes this worth running."
        "That holds until the directory is pruned, and then it does not: a parent"
        "below the Prune Watermark is gone on purpose. So unresolved is counted"
        "on its own rather than folded into the faults, and the reader decides"
        "which it is looking at. A Transaction that is wrong -- value created, or"
        "an Output that cannot exist -- is a fault either way."
        "The Block checks come from Domain.Checks, which is where show gets them"
        "too. Counting what is wrong and describing it are different jobs; making"
        "the same judgement twice is not."
        "Progress is reported as it goes. A run over a hundred thousand Blocks"
        "takes hours, and one that says nothing until it finishes cannot be told"
        "from one that has stopped."
        "Every Block is read through Infra.Blocks.read: one positional read of"
        "exactly its bytes, wherever in whichever Segment it sits."
    exposes [Counts, run, standing, breakdown]
    depends [Domain.Network, Bytes, Domain.TxCheck, Domain.BlockWork, Domain.ScriptWork, Infra.Pace, Domain.Block, Domain.Checks, Domain.Index, Domain.Rules, Domain.Spend, Domain.SpendScript, Domain.Transaction, Infra.Blocks, Infra.Chain, Infra.Spends, Infra.Store, Domain.IndexKeys]
    effects [
        Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
        Time.now, Time.unixMs,
    ]

record Counts
    blocks: Int
    transactions: Int
    resolved: Int
    coinbase: Int
    unresolved: Int
    faults: Int
    scripts: Outcomes

fn run(network: Network, dir: String, from: Int, to: Int) -> Result<Counts, String>
    ? "Walk the range, checking every Block and every Transaction in it."
    ! [
        Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
        Time.now, Time.unixMs,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open("{dir}/blocks")?
    walk(network, store, blocks, from, to, Counts(blocks = 0, transactions = 0, resolved = 0, coinbase = 0, unresolved = 0, faults = 0, scripts = Domain.SpendScript.noOutcomes()), Infra.Pace.pacedFrom(Time.unixMs()))

fn standing(counts: Counts) -> String
    ? "One word for whether anything went wrong."
      "There was none, and the one that looked like it -- FAULTS, last on the"
      "line and the only capitals -- answered a narrower question. A failed"
      "Script is not a fault -- faults are the Block and Transaction level"
      "findings, counted apart on purpose -- but it means this engine believes"
      "the chain contains a spend that does not verify, which is the most"
      "serious thing this program can find. n1bor/btc-listener#76, found by an"
      "experiment that printed '105 failed ... FAULTS 0' and read as good news."
    match Bool.or(counts.faults > 0, counts.scripts.failed > 0)
        true -> "FAILED"
        false -> "CLEAN"

verify standing
    standing(zero()) => "CLEAN"
    standing(Counts(blocks = 1, transactions = 0, resolved = 0, coinbase = 0, unresolved = 0, faults = 1, scripts = Domain.SpendScript.noOutcomes())) => "FAILED"
    standing(Counts(blocks = 1, transactions = 0, resolved = 0, coinbase = 0, unresolved = 0, faults = 0, scripts = Outcomes(passed = 0, failed = 1, undecided = 0, note = Option.None))) => "FAILED"
    standing(Counts(blocks = 1, transactions = 0, resolved = 0, coinbase = 0, unresolved = 0, faults = 0, scripts = Outcomes(passed = 9, failed = 0, undecided = 3, note = Option.None))) => "CLEAN"

fn breakdown(counts: Counts) -> String
    ? "What went wrong, for the reader who has read the standing. Both numbers"
      "always, nought included, so the shape of the line never changes, and"
      "the count after the word so that one of anything still reads."
    "faults {counts.faults}, script failures {counts.scripts.failed}"

verify breakdown
    breakdown(zero()) => "faults 0, script failures 0"
    breakdown(Counts(blocks = 1, transactions = 0, resolved = 0, coinbase = 0, unresolved = 0, faults = 2, scripts = Outcomes(passed = 0, failed = 3, undecided = 0, note = Option.None))) => "faults 2, script failures 3"

fn parentOf(store: Store, height: Int) -> Result<Option<String>, String>
    ? "The Block Id one Height down, which the parent check needs."
    ! [Infra.Kv.get]
    match height <= 0
        true -> Result.Ok(Option.None)
        false -> named(store, height)

verify parentOf
    parentOf(Infra.Store.fixture([]), 0) => Result.Ok(Option.None)
    parentOf(Infra.Store.fixture([(Domain.IndexKeys.heightKey(4)?, "aa")]), 5) => Result.Ok(Option.Some("aa"))
    parentOf(Infra.Store.fixture([]), 5) => Result.Ok(Option.None)
    parentOf(Infra.Store.fixture([(Domain.IndexKeys.heightKey(4)?, "")]), 5) => Result.Err("index has no Block Id at height 4")

fn named(store: Store, height: Int) -> Result<Option<String>, String>
    ? "A Height that names nothing is a damaged Index, not a missing parent."
    ! [Infra.Kv.get]
    held = Infra.Store.get(store, Domain.IndexKeys.heightKey(height - 1)?)?
    match held
        Option.None -> Result.Ok(Option.None)
        Option.Some(blockId) -> nonEmpty(height, blockId)

verify named
    named(Infra.Store.fixture([]), 5) => Result.Ok(Option.None)
    named(Infra.Store.fixture([(Domain.IndexKeys.heightKey(4)?, "aa")]), 5) => Result.Ok(Option.Some("aa"))
    named(Infra.Store.fixture([(Domain.IndexKeys.heightKey(4)?, "")]), 5) => Result.Err("index has no Block Id at height 4")

fn nonEmpty(height: Int, blockId: String) -> Result<Option<String>, String>
    ? "An empty Block Id is corruption."
    match String.len(blockId) > 0
        false -> Result.Err("index has no Block Id at height {height - 1}")
        true -> Result.Ok(Option.Some(blockId))

verify nonEmpty
    nonEmpty(5, "aa") => Result.Ok(Option.Some("aa"))
    nonEmpty(5, "") => Result.Err("index has no Block Id at height 4")

fn faultsIn(findings: List<Finding>, acc: List<Finding>) -> List<Finding>
    ? "Only the findings that are something wrong."
    match findings
        [] -> List.reverse(acc)
        [head, ..tail] -> faultsIn(tail, keptIfFault(head, acc))

verify faultsIn
    faultsIn([], []) => []
    faultsIn([Finding.MerkleAgrees], []) => []
    faultsIn([Finding.WorkUnmet], []) => [Finding.WorkUnmet]
    faultsIn([Finding.MerkleAgrees, Finding.WorkUnmet], []) => [Finding.WorkUnmet]

fn keptIfFault(finding: Finding, acc: List<Finding>) -> List<Finding>
    ? "Keep it only if it is a fault."
    match Domain.Checks.isFault(finding)
        false -> acc
        true -> List.prepend(finding, acc)

verify keptIfFault
    keptIfFault(Finding.MerkleAgrees, []) => []
    keptIfFault(Finding.WorkUnmet, []) => [Finding.WorkUnmet]

fn reportFaults(height: Int, faults: List<Finding>) -> Unit
    ? "Print any Block-level fault as it is found."
    ! [Console.print]
    match faults
        [] -> Unit
        [head, ..tail] -> printFault(height, head, tail)

fn printFault(height: Int, fault: Finding, rest: List<Finding>) -> Unit
    ? "One fault, then the rest."
    ! [Console.print]
    _printed = Console.print("height {height}: {faultText(fault)}")
    reportFaults(height, rest)

fn faultText(finding: Finding) -> String
    ? "A fault in one line."
    match finding
        Finding.MerkleDiffers(root) -> "transactions build merkle root {root}, not the one in the header"
        Finding.MerkleUncomputable(why) -> "cannot compute merkle root: {why}"
        Finding.IdDiffers(id) -> "header hashes to {id}, not the id the index recorded"
        Finding.ParentDiffers(parent) -> "header names parent {parent}, not the block below it"
        Finding.WorkUnmet -> "block id is above the target"
        Finding.WorkUncheckable(why) -> "cannot check work: {why}"
        Finding.MerkleAgrees -> "merkle agrees"
        Finding.IdAgrees -> "id agrees"
        Finding.ParentAgrees -> "parent agrees"
        Finding.ParentUnrecorded -> "no parent recorded"
        Finding.WorkMet -> "work met"

verify faultText
    faultText(Finding.WorkUnmet) => "block id is above the target"
    faultText(Finding.MerkleDiffers("aa")) => "transactions build merkle root aa, not the one in the header"
    faultText(Finding.IdDiffers("aa")) => "header hashes to aa, not the id the index recorded"
    faultText(Finding.ParentDiffers("aa")) => "header names parent aa, not the block below it"
    faultText(Finding.MerkleUncomputable("why")) => "cannot compute merkle root: why"
    faultText(Finding.WorkUncheckable("why")) => "cannot check work: why"
    faultText(Finding.MerkleAgrees) => "merkle agrees"
    faultText(Finding.IdAgrees) => "id agrees"
    faultText(Finding.ParentAgrees) => "parent agrees"
    faultText(Finding.ParentUnrecorded) => "no parent recorded"
    faultText(Finding.WorkMet) => "work met"

fn batchSize() -> Int
    ? "How many Blocks are decoded and checked before any of them is walked."
      "Decoding a Block's body is most of what an audit does outside the"
      "Scripts and it used one core while the rest waited. Blocks do not"
      "depend on each other until spends have to resolve, so a batch of them"
      "goes out to branches first and the walk picks the answers up in order."
      "Two, down from the eight the machine has cores for, because the batch"
      "bounds memory as well as feeding cores: eight of signet's four-megabyte"
      "spam-era Blocks, with their witness and Taproot Script contexts"
      "prepared, peaked past thirty-one gigabytes and the kernel killed the"
      "audit at Height 234,222. Two keeps the fan-out and fits the machine."
    2

verify batchSize
    batchSize() >= 1 => true

record Gathered
    waiting: List<Unchecked>
    next: Int
    ended: Bool

fn walk(network: Network, store: Store, blocks: BlockStore, height: Int, to: Int, counts: Counts, pace: Pace) -> Result<Counts, String>
    ? "A batch of Heights at a time."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Time.now, Time.unixMs]
    match height > to
        true -> Result.Ok(counts)
        false -> overBatch(network, store, blocks, height, to, counts, pace)

fn overBatch(network: Network, store: Store, blocks: BlockStore, height: Int, to: Int, counts: Counts, pace: Pace) -> Result<Counts, String>
    ? "Gather what the chain has to say, decide it away from the chain, then walk it."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Time.now, Time.unixMs]
    got = gathering(store, blocks, height, to, batchSize(), [])?
    prepared = Domain.BlockWork.preparedAcross(got.waiting)?
    done = processed(network, store, blocks, prepared, counts, pace)?
    match done
        (settled, stepped) -> continued(network, store, blocks, got, height, to, settled, stepped)

fn continued(network: Network, store: Store, blocks: BlockStore, got: Gathered, height: Int, to: Int, counts: Counts, pace: Pace) -> Result<Counts, String>
    ? "Stop where the Index stopped naming Heights, or where a batch got nowhere."
      "The second is not reachable from the gathering below, which always moves"
      "on or ends, but a walk that could loop over the same Height forever is"
      "not a thing to leave to reasoning."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Time.now, Time.unixMs]
    match Bool.or(got.ended, got.next <= height)
        true -> Result.Ok(counts)
        false -> walk(network, store, blocks, got.next, to, counts, pace)

fn gathering(store: Store, blocks: BlockStore, height: Int, to: Int, left: Int, acc: List<Unchecked>) -> Result<Gathered, String>
    ? "Read up to left Blocks out of the chain, and nothing else."
      "Everything here touches the disk or the database, and nothing here"
      "decides anything, which is what lets the deciding be fanned out."
    ! [Disk.readBytesAt, Infra.Kv.get]
    match Bool.or(left < 1, height > to)
        true -> Result.Ok(Gathered(waiting = List.reverse(acc), next = height, ended = false))
        false -> atHeight(store, blocks, height, to, left, acc)

fn atHeight(store: Store, blocks: BlockStore, height: Int, to: Int, left: Int, acc: List<Unchecked>) -> Result<Gathered, String>
    ? "A Height the Index does not name ends the range."
    ! [Disk.readBytesAt, Infra.Kv.get]
    holding = Infra.Store.get(store, Domain.IndexKeys.heightKey(height)?)?
    match holding
        Option.None -> Result.Ok(Gathered(waiting = List.reverse(acc), next = height, ended = true))
        Option.Some(blockId) -> atBlock(store, blocks, height, to, left, acc, blockId)

fn atBlock(store: Store, blocks: BlockStore, height: Int, to: Int, left: Int, acc: List<Unchecked>, blockId: String) -> Result<Gathered, String>
    ? "A Block whose body is not held is stepped over, and does not fill a place."
      "A pruned stretch would otherwise hand the branches a batch of one."
    ! [Disk.readBytesAt, Infra.Kv.get]
    located = Infra.Store.get(store, Domain.IndexKeys.blockKey(blockId)?)?
    match located
        Option.None -> gathering(store, blocks, height + 1, to, left, acc)
        Option.Some(text) -> readBlock(store, blocks, height, to, left, acc, blockId, text)

fn readBlock(store: Store, blocks: BlockStore, height: Int, to: Int, left: Int, acc: List<Unchecked>, blockId: String, text: String) -> Result<Gathered, String>
    ? "One positional read of exactly the Block's bytes."
    ! [Disk.readBytesAt, Infra.Kv.get]
    location = Domain.Index.decodeLocation(text)?
    payload = Infra.Blocks.read(blocks, location)?
    parent = parentOf(store, height)?
    gathering(store, blocks, height + 1, to, left - 1, List.prepend(Domain.BlockWork.Unchecked(height = height, blockId = blockId, parentBlockId = parent, payload = payload), acc))

fn processed(network: Network, store: Store, blocks: BlockStore, prepared: List<Prepared>, counts: Counts, pace: Pace) -> Result<Tuple<Counts, Pace>, String>
    ? "Each prepared Block in turn: its spends resolved, then its Scripts run."
      "In order, because a spend can name an Output made in the Block before"
      "it, and because a report that jumped about would be unreadable."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Time.now, Time.unixMs]
    match prepared
        [] -> Result.Ok((counts, pace))
        [head, ..tail] -> oneBlock(network, store, blocks, head, tail, counts, pace)

fn oneBlock(network: Network, store: Store, blocks: BlockStore, one: Prepared, rest: List<Prepared>, counts: Counts, pace: Pace) -> Result<Tuple<Counts, Pace>, String>
    ? "One Block's findings counted, its spends resolved, its Scripts run."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.get, Time.now, Time.unixMs]
    faults = faultsIn(one.findings, [])
    _said = reportFaults(one.height, faults)
    stepped = maybeReport(one.height, counts, pace)?
    counted = Counts(blocks = counts.blocks + 1, transactions = counts.transactions, resolved = counts.resolved, coinbase = counts.coinbase, unresolved = counts.unresolved, faults = counts.faults + List.len(faults), scripts = counts.scripts)
    work = resolvedAll(store, blocks, one.transactions, Domain.Rules.at(network, one.height), [])?
    answered = Infra.Spends.scriptsAcross(work, Domain.Rules.at(network, one.height), one.height, one.blockId)?
    processed(network, store, blocks, rest, tallied(work, counted, answered, one.height, one.blockId), stepped)

fn resolvedAll(store: Store, blocks: BlockStore, transactions: List<Transaction>, rules: Rules, acc: List<Work>) -> Result<List<Work>, String>
    ? "Resolve every Input of every Transaction in the Block, in order."
      "One pass, sequential, and the only place a spend touches the disk or"
      "the database. What it leaves is pure work the Block can then fan out."
    ! [Disk.readBytesAt, Infra.Kv.get]
    match transactions
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> nextResolved(store, blocks, head, tail, rules, acc)

fn nextResolved(store: Store, blocks: BlockStore, transaction: Transaction, tail: List<Transaction>, rules: Rules, acc: List<Work>) -> Result<List<Work>, String>
    ? "One Transaction resolved, then the rest."
    ! [Disk.readBytesAt, Infra.Kv.get]
    one = Infra.Spends.resolved(store, blocks, transaction, rules)?
    resolvedAll(store, blocks, tail, rules, List.prepend(one, acc))

fn maybeReport(height: Int, counts: Counts, pace: Pace) -> Result<Pace, String>
    ? "Say where the walk has got to, every so often, and how fast."
      "Reported before this Block is counted, so the numbers are what was true"
      "at the Height named rather than one ahead of it."
      "Two spans, because they answer different questions. Recent is since the"
      "last line and is what shows a Block costing seconds where its"
      "neighbours cost milliseconds; overall is what an estimate of the time"
      "left should be built on."
      "Both in Blocks and in Transactions, because a Block is not a unit of"
      "work and a Transaction is nearer to one. Blocks a second falls by two"
      "orders of magnitude across this chain as Blocks fill up; Transactions a"
      "second should hold far steadier, and where it does not, the reason is"
      "something other than the Blocks having got bigger."
      "The clock is read once per Block, and that was measured rather than"
      "assumed. Reading it only every 64th Block was tried and made no"
      "difference: three runs of 20000 Blocks gave 6.12, 5.48 and 5.81"
      "seconds reading it every time against 5.34, 5.76 and 6.30 reading it"
      "every 64th, so the spread within each is wider than the gap between"
      "them. The gate was deleted rather than kept on a hunch."
      "The first line goes out immediately rather than after a minute, so a"
      "long run says it has started."
    ! [Console.print, Time.now, Time.unixMs]
    nowMs = Time.unixMs()
    match Infra.Pace.due(pace, nowMs, counts.blocks)
        false -> Result.Ok(pace)
        true -> reported(height, counts, pace, nowMs)

fn reported(height: Int, counts: Counts, pace: Pace, nowMs: Int) -> Result<Pace, String>
    ? "One progress line, and the Pace the next one measures from."
    ! [Console.print, Time.now]
    _said = Console.print("  {Time.now()}  height {height}: {standing(counts)} ({breakdown(counts)}), {counts.blocks} blocks, {counts.transactions} transactions, {counts.resolved} spends, {counts.scripts.undecided} undecided scripts, recent {Infra.Pace.perSecond(counts.blocks - pace.lastBlocks, nowMs - pace.lastMs)} blocks/s {Infra.Pace.perSecond(counts.transactions - pace.lastItems, nowMs - pace.lastMs)} tx/s, overall {Infra.Pace.perSecond(counts.blocks, nowMs - pace.startedMs)} blocks/s {Infra.Pace.perSecond(counts.transactions, nowMs - pace.startedMs)} tx/s")
    Result.Ok(Infra.Pace.advanced(pace, nowMs, counts.blocks, counts.transactions))

fn tallied(work: List<Work>, counts: Counts, answered: Tuple<Outcomes, List<String>>, height: Int, blockId: String) -> Counts
    ? "Add the Block's Script answers in, say what did not settle, then judge"
      "each Transaction's sums."
      "Scripts and sums are counted apart because the division only reorders"
      "the Scripts. The sums walk the Transactions in Block order as they"
      "always did, and need nothing from the branches."
    ! [Console.print]
    match answered
        (scripts, lines) -> afterScripts(work, withScripts(counts, scripts), lines, height, blockId)

verify tallied
    tallied([], zero(), (Domain.SpendScript.noOutcomes(), []), 0, "aa") => zero()

fn afterScripts(work: List<Work>, counts: Counts, lines: List<String>, height: Int, blockId: String) -> Counts
    ? "Judge the sums, then say everything the Block found that did not settle."
      "The Script lines arrive whole -- the branch that ran the pair names the"
      "Height and the Block Id itself, see Infra.Spends.notedFrom. The sums are"
      "walked here rather than in a branch, so this is where their lines are"
      "built and where the Height comes from."
    ! [Console.print]
    match judgedAll(work, counts, height, blockId, [])
        (settled, sums) -> said(settled, List.concat(lines, sums))

verify afterScripts
    afterScripts([], zero(), [], 0, "aa") => zero()

fn said(counts: Counts, lines: List<String>) -> Counts
    ? "Print the lot in one write and hand the counts back."
    ! [Console.print]
    _printed = printLines(lines)
    counts

verify said trace
    said(zero(), []) => zero()

fn printLines(lines: List<String>) -> Unit
    ? "Everything the Block found that did not settle, in one write."
      "One Console.print rather than one per line, because the alternative is"
      "a recursive effectful function and Oracle v1 cannot trace one."
    ! [Console.print]
    match List.len(lines) > 0
        false -> Unit
        true -> Console.print(String.join(lines, "\n"))

verify printLines trace
    printLines([]) => Unit

fn judgedAll(work: List<Work>, counts: Counts, height: Int, blockId: String, lines: List<String>) -> Tuple<Counts, List<String>>
    ? "Every Transaction's sums, in Block order, and a line for each that did"
      "not settle."
      "Counting a thing without naming it leaves it unchaseable. Three Blocks"
      "whose bodies were never fetched left 908 unresolved Inputs in one"
      "segment, and finding which three took eleven audit runs bisecting a"
      "range the program could have named in one line."
    match work
        [] -> (counts, List.reverse(lines))
        [head, ..tail] -> nextJudged(head, tail, counts, height, blockId, lines)

verify judgedAll
    judgedAll([], zero(), 0, "aa", []) => (zero(), [])
    judgedAll([Work(transaction = wholeTx(), tally = Domain.Spend.started(), spent = [])], zero(), 0, "aa", []) => nextJudged(Work(transaction = wholeTx(), tally = Domain.Spend.started(), spent = []), [], zero(), 0, "aa", [])

fn nextJudged(one: Work, rest: List<Work>, counts: Counts, height: Int, blockId: String, lines: List<String>) -> Tuple<Counts, List<String>>
    ? "One Transaction judged and, if it did not settle, named."
    verdict = shapeFirst(one.transaction, Domain.Spend.verdictOf(one.tally, paidBy(Domain.Transaction.outputsOf(one.transaction), 0)))
    judgedAll(rest, judged(counts, one.transaction, verdict), height, blockId, notedVerdict(one.transaction, verdict, height, blockId, lines))

verify nextJudged
    nextJudged(Work(transaction = wholeTx(), tally = Domain.Spend.started(), spent = []), [], zero(), 0, "aa", []) => judgedAll([], judged(zero(), wholeTx(), shapeFirst(wholeTx(), Domain.Spend.verdictOf(Domain.Spend.started(), paidBy(Domain.Transaction.outputsOf(wholeTx()), 0)))), 0, "aa", notedVerdict(wholeTx(), shapeFirst(wholeTx(), Domain.Spend.verdictOf(Domain.Spend.started(), paidBy(Domain.Transaction.outputsOf(wholeTx()), 0))), 0, "aa", []))

fn shapeFirst(transaction: Transaction, verdict: Verdict) -> Verdict
    ? "Bitcoin checks a Transaction's shape before it checks anything else,"
      "and a Transaction that fails there is invalid whatever its sums say:"
      "no Inputs, an amount that cannot exist, the same Output spent twice."
      "Broken rather than a fourth kind of answer, because it already counts"
      "as a fault and is already named -- what is wrong is stated in the"
      "message, which is where a reader looks anyway."
      "Nothing on this chain should reach this. Every Transaction in a Block"
      "that was accepted passed these checks when it was accepted, so a fault"
      "here means either this check is wrong or the Block is not what it"
      "claims -- and the first is far likelier."
    match Domain.TxCheck.wrongWith(transaction)
        Option.Some(why) -> Verdict.Broken(why)
        Option.None -> verdict

verify shapeFirst
    shapeFirst(wholeTx(), Verdict.Conserved) => Verdict.Conserved
    shapeFirst(wholeTx(), Verdict.Created(5)) => Verdict.Created(5)
    shapeFirst(sampleTx(), Verdict.Conserved) => Verdict.Broken("no inputs")

fn wholeTx() -> Transaction
    ? "A Transaction whose shape is not the thing under test."
      "sampleTx has neither Inputs nor Outputs, which is exactly what"
      "CheckTransaction refuses, so it cannot stand in for a Transaction that"
      "gets past it."
    Transaction(version = 1, inputs = [Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = [])], outputs = [Output(value = 1, script = "51")], lockTime = 0, txid = "dd", size = 9, isSegWit = false)

verify wholeTx
    Domain.TxCheck.wrongWith(wholeTx()) => Option.None

fn notedVerdict(transaction: Transaction, verdict: Verdict, height: Int, blockId: String, lines: List<String>) -> List<String>
    ? "A line for a Transaction whose sums did not settle."
      "Incomplete is an Input whose parent Output is not held. It is not a"
      "fault -- the parent may be perfectly good and simply absent, which is"
      "why unresolved is counted apart -- but it is the thing a reader most"
      "needs the Transaction Id for, because the answer is always somewhere"
      "else in the chain."
    match verdict
        Verdict.Conserved -> lines
        Verdict.Coinbase -> lines
        Verdict.Incomplete(why) -> List.prepend("  !! height {height} block {blockId} tx {Domain.Transaction.txidOf(transaction)}: unresolved, {why}", lines)
        Verdict.Created(excess) -> List.prepend("  !! height {height} block {blockId} tx {Domain.Transaction.txidOf(transaction)}: creates {excess} satoshis", lines)
        Verdict.Broken(why) -> List.prepend("  !! height {height} block {blockId} tx {Domain.Transaction.txidOf(transaction)}: {why}", lines)

verify notedVerdict
    notedVerdict(sampleTx(), Verdict.Conserved, 7, "aa", []) => []
    notedVerdict(sampleTx(), Verdict.Coinbase, 7, "aa", []) => []
    List.len(notedVerdict(sampleTx(), Verdict.Incomplete("no record"), 7, "aa", [])) => 1
    List.len(notedVerdict(sampleTx(), Verdict.Created(5), 7, "aa", [])) => 1
    List.len(notedVerdict(sampleTx(), Verdict.Broken("x"), 7, "aa", [])) => 1

fn withScripts(counts: Counts, scripts: Outcomes) -> Counts
    ? "Roll one Transaction's Script outcomes into the running total."
    Counts(blocks = counts.blocks, transactions = counts.transactions, resolved = counts.resolved, coinbase = counts.coinbase, unresolved = counts.unresolved, faults = counts.faults, scripts = Domain.SpendScript.merged(counts.scripts, scripts))

verify withScripts
    withScripts(zero(), Domain.SpendScript.noOutcomes()) => zero()
    withScripts(zero(), Domain.SpendScript.Outcomes(passed = 1, failed = 2, undecided = 3, note = Option.None)).scripts => Domain.SpendScript.Outcomes(passed = 1, failed = 2, undecided = 3, note = Option.None)

fn paidBy(outputs: List<Output>, acc: Int) -> Int
    ? "Total the Output values."
    match outputs
        [] -> acc
        [head, ..tail] -> paidBy(tail, acc + Domain.Transaction.valueOf(head))

verify paidBy
    paidBy([], 0) => 0
    paidBy([Output(value = 5, script = "")], 0) => 5

fn judged(counts: Counts, transaction: Transaction, verdict: Verdict) -> Counts
    ? "Count the verdict, and report anything that is not clean."
      "Over a prefix of the chain every Input has its parent held, so Incomplete"
      "is a fault here even though it is an honest answer elsewhere."
    seen = counts.transactions + 1
    faulted = counts.faults + 1
    match verdict
        Verdict.Coinbase -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase + 1, unresolved = counts.unresolved, faults = counts.faults, scripts = counts.scripts)
        Verdict.Conserved -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved + 1, coinbase = counts.coinbase, unresolved = counts.unresolved, faults = counts.faults, scripts = counts.scripts)
        Verdict.Created(excess) -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase, unresolved = counts.unresolved, faults = faulted, scripts = counts.scripts)
        Verdict.Broken(why) -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase, unresolved = counts.unresolved, faults = faulted, scripts = counts.scripts)
        Verdict.Incomplete(why) -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase, unresolved = counts.unresolved + 1, faults = counts.faults, scripts = counts.scripts)

verify judged
    judged(zero(), sampleTx(), Verdict.Conserved).resolved => 1
    judged(zero(), sampleTx(), Verdict.Coinbase).coinbase => 1
    judged(zero(), sampleTx(), Verdict.Created(5)).faults => 1
    judged(zero(), sampleTx(), Verdict.Broken("x")).faults => 1
    judged(zero(), sampleTx(), Verdict.Incomplete("x")).unresolved => 1
    judged(zero(), sampleTx(), Verdict.Incomplete("x")).faults => 0

fn zero() -> Counts
    ? "Nothing counted yet."
    Counts(blocks = 0, transactions = 0, resolved = 0, coinbase = 0, unresolved = 0, faults = 0, scripts = Domain.SpendScript.noOutcomes())

verify zero
    zero().faults => 0

fn sampleTx() -> Transaction
    ? "A Transaction, for the cases above."
    Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "cc", size = 9, isSegWit = false)

verify sampleTx
    Domain.Transaction.txidOf(sampleTx()) => "cc"
