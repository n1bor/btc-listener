module Rewind
    intent =
        "Taking the UTXO Set back to the fork, when the chain has moved out"
        "from under it."
        "Every walk that builds the Set starts here, because every walk has to"
        "answer the same question first: is the Block the Set stands on still"
        "on the chain? While the Index only ever grew, the answer was always"
        "yes and nobody asked. A node following a live tip is asked it every"
        "time a Header arrives."
        "The walk down is the Set's own branch, read parent by parent out of"
        "k:, because h: has already been re-pointed and no longer leads there."
        "It is bounded below by the Undo window: past that the Undo Data is"
        "gone, and a Set that cannot be taken back is a Set that has to be"
        "rebuilt. Saying so and stopping is the whole of D8."
        "Nothing here decides anything. It reads the branch, hands it to"
        "Domain.Rewind, and carries out what comes back."
    exposes [Realigned, realigned, branchOf]
    depends [Bytes, Domain.Block, Domain.Disconnect, Domain.HeaderTree, Domain.Index, Domain.Reorg, Domain.Rewind, Domain.Screen, Domain.Snapshot, Domain.Transaction, Domain.TreeStore, Domain.UtxoStore, Infra.Blocks, Infra.Screen, Infra.Store, Infra.Utxo, Domain.IndexKeys]
    effects [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]

record Realigned
    store: Store
    from: Int
    dropped: Int
    unconfirmed: List<Carried>

record Removed
    store: Store
    unconfirmed: List<Carried>

fn realigned(store: Store, blocks: BlockStore, eye: Eye) -> Result<Realigned, String>
    ? "Where the next Block goes, once the Set is back on the chain h: names."
      "What a disconnected Block confirmed comes back out as unconfirmed --"
      "bounded by the Undo window, and exactly what a Mempool wants offered"
      "back (#28, #133). The Eye keeps the walk's lines off a Screen's frame."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    held = Infra.Store.get(store, Domain.UtxoStore.reachedKey()?)?
    standsOn(store, blocks, held, eye)

fn standsOn(store: Store, blocks: BlockStore, held: Option<Bytes>, eye: Eye) -> Result<Realigned, String>
    ? "Nothing recorded means nothing connected, so the walk starts at Height 1."
      "One rather than zero, because genesis is not a Block that connects. It"
      "is the base the chain is measured from: no Peer will send its body, and"
      "its Output is not spendable -- Bitcoin Core never puts it in the UTXO"
      "Set either, which is why the fifty coins of Block 0 are missing from"
      "the supply that can ever move."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    match held
        Option.None -> Result.Ok(Realigned(store = store, from = 1, dropped = 0, unconfirmed = []))
        Option.Some(stored) -> decoded(store, blocks, Domain.UtxoStore.decodeReached(stored), eye)

fn decoded(store: Store, blocks: BlockStore, reached: Result<Reached, String>, eye: Eye) -> Result<Realigned, String>
    ? "A standing that will not decode stops the walk before it touches the Set."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    match reached
        Result.Err(why) -> Result.Err(why)
        Result.Ok(where) -> comparing(store, blocks, where, eye)

fn comparing(store: Store, blocks: BlockStore, where: Reached, eye: Eye) -> Result<Realigned, String>
    ? "Read the branch the Set stands on, then do what it says has to be done."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    floor = undoFloor(store)?
    branch = branchOf(store, where.blockId, floor, [])?
    acted(store, blocks, Domain.Rewind.rewinding(branch), eye)

fn undoFloor(store: Store) -> Result<Int, String>
    ? "The lowest Height whose Undo Data is still kept, and so how far back a"
      "reorganisation can be undone at all."
    ! [Infra.Kv.get]
    below = Infra.Store.get(store, Domain.UtxoStore.undoWindowKey()?)?
    Domain.Index.prunedBelowOf(below)

verify undoFloor
    undoFloor(Infra.Store.fixture([])) => Result.Ok(0)
    undoFloor(Infra.Store.fixture([(Domain.UtxoStore.undoWindowKey()?, Domain.Index.encodeHeight(712))])) => Result.Ok(712)
    undoFloor(Infra.Store.fixture([(Domain.UtxoStore.undoWindowKey()?, Domain.Index.emptyBytes())])) => Result.Err("a Height record is 4 bytes, got 0")

fn branchOf(store: Store, blockId: String, floor: Int, acc: List<Standing>) -> Result<List<Standing>, String>
    ? "The branch down from a Block, each Height beside what h: records there."
      "Tip first, ending at the first Height that agrees with h: -- which is"
      "the fork -- or at the Undo window's floor, which is as far back as the"
      "Set can be taken."
    ! [Infra.Kv.get]
    held = Infra.Store.get(store, Domain.TreeStore.headerKey(blockId)?)?
    match held
        Option.None -> Result.Err("the Set stands on Block {blockId}, which the Header tree does not hold; the Index and the Set describe different chains, so rebuild the Set")
        Option.Some(text) -> atPlacement(store, blockId, text, floor, acc)

verify branchOf
    branchOf(sample()?, "bb", 0, []) => Result.Ok([differing(), agreeing()])
    branchOf(sample()?, "aa", 0, []) => Result.Ok([agreeing()])
    branchOf(sample()?, "bb", 2, []) => Result.Ok([differing()])
    branchOf(sample()?, "ff", 0, []) => Result.Err("the Set stands on Block ff, which the Header tree does not hold; the Index and the Set describe different chains, so rebuild the Set")
    branchOf(sample()?, "zz", 0, []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn atPlacement(store: Store, blockId: String, stored: Bytes, floor: Int, acc: List<Standing>) -> Result<List<Standing>, String>
    ? "A k: record that will not decode is corruption."
    ! [Infra.Kv.get]
    match Domain.TreeStore.decodeHeld(blockId, stored)
        Result.Err(why) -> Result.Err(why)
        Result.Ok(named) -> beside(store, named.placement, floor, acc)

fn beside(store: Store, placement: Placement, floor: Int, acc: List<Standing>) -> Result<List<Standing>, String>
    ? "This Height of the branch, beside the Block Id h: holds there."
    ! [Infra.Kv.get]
    recorded = Domain.Index.blockIdIn(Infra.Store.get(store, Domain.IndexKeys.heightKey(placement.height)?)?)
    onwards(store, Standing(placement = placement, recorded = recorded), floor, acc)

fn onwards(store: Store, one: Standing, floor: Int, acc: List<Standing>) -> Result<List<Standing>, String>
    ? "An agreeing Height is the fork; keep it and stop."
    ! [Infra.Kv.get]
    match Domain.Reorg.agrees(one)
        true -> Result.Ok(List.reverse(List.prepend(one, acc)))
        false -> deeper(store, one, floor, acc)

fn deeper(store: Store, one: Standing, floor: Int, acc: List<Standing>) -> Result<List<Standing>, String>
    ? "Carry on down, unless this is as far as the Undo window reaches."
      "The Block at the floor can still be disconnected -- the floor is the"
      "lowest Height whose Undo Data is kept -- so it is the one below it that"
      "the walk must not ask for."
    ! [Infra.Kv.get]
    match one.placement.height <= floor
        true -> Result.Ok(List.reverse(List.prepend(one, acc)))
        false -> branchOf(store, one.placement.parentId, floor, List.prepend(one, acc))

fn acted(store: Store, blocks: BlockStore, plan: Rewinding, eye: Eye) -> Result<Realigned, String>
    ? "Nothing to do, something to undo, or nothing that can be done."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    match plan
        Rewinding.Aligned(height) -> Result.Ok(Realigned(store = store, from = height + 1, dropped = 0, unconfirmed = []))
        Rewinding.Stranded(height) -> Result.Err(strandedWhy(height))
        Rewinding.Dropping(fork, blocksOff) -> dropping(store, blocks, fork, blocksOff, eye)

fn strandedWhy(height: Int) -> String
    ? "A reorganisation deeper than the Undo window, which is not survivable."
      "D8 of the full-node plan: a bounded window is a deliberate trade, and"
      "the price of it is that a fork below the window stops the node rather"
      "than being guessed past. Two hundred and eighty-eight Blocks is two"
      "days; the deepest reorganisation Bitcoin has had was twenty-four."
    "the chain forked below Height {height}, which is further back than the Undo window reaches; the UTXO Set cannot be taken back that far and has to be rebuilt"

verify strandedWhy
    strandedWhy(712) => "the chain forked below Height 712, which is further back than the Undo window reaches; the UTXO Set cannot be taken back that far and has to be rebuilt"

fn dropping(store: Store, blocks: BlockStore, fork: Int, blocksOff: List<Placement>, eye: Eye) -> Result<Realigned, String>
    ? "Disconnect the branch that lost, highest first, then stand on the fork."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    count = List.len(blocksOff)
    _said = saidIfPlain(eye, "REORGANISED: the Set stands on a branch the chain has left; taking it back to Height {fork}, disconnecting {count} Block(s)")
    unwound = removing(store, blocks, blocksOff, eye)?
    Result.Ok(Realigned(store = unwound.store, from = fork + 1, dropped = count, unconfirmed = unwound.unconfirmed))

fn saidIfPlain(eye: Eye, line: String) -> Unit
    ? "A line for the plain log; the Screen draws the same fact."
    ! [Console.print]
    match eye.view
        Option.None -> Console.print(line)
        Option.Some(view) -> Unit

fn removing(store: Store, blocks: BlockStore, blocksOff: List<Placement>, eye: Eye) -> Result<Removed, String>
    ? "One Block at a time, in the order they were given."
      "The order is the whole of it: each Block's Undo Data restores what its"
      "own Inputs spent, so the Set has to reach a Block in the state that"
      "Block left it, which means the one above it has to be off first."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    match blocksOff
        [] -> Result.Ok(Removed(store = store, unconfirmed = []))
        [head, ..tail] -> removingOne(store, blocks, head, tail, eye)

fn removingOne(store: Store, blocks: BlockStore, placement: Placement, rest: List<Placement>, eye: Eye) -> Result<Removed, String>
    ? "Read this Block back out of its Segment and take it off the Set,"
      "keeping what it had confirmed -- those Transactions may still be"
      "valid on the branch the chain now follows, and a Mempool can offer"
      "them back. The coinbase is not kept: a mint on an abandoned branch"
      "is money that never happened. The carry comes out lowest Block"
      "first, because a child spends its parent and a Mempool re-admitting"
      "them meets them in an order that can work."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get]
    carried = bodyOf(store, blocks, placement.blockId)?
    applied = Infra.Utxo.disconnectBlock(store, placement.blockId, transactionsIn(carried, []), Reached(height = placement.height - 1, blockId = placement.parentId))?
    _said = saidIfPlain(eye, "  height {placement.height} disconnected: set +{applied.added} -{applied.removed}")
    deeper2 = removing(applied.store, blocks, rest, eye)?
    Result.Ok(Removed(store = deeper2.store, unconfirmed = List.concat(deeper2.unconfirmed, restorable(carried))))

fn restorable(carried: List<Carried>) -> List<Carried>
    ? "Everything but the coinbase, each Transaction beside the bytes it"
      "arrived as -- a Mempool re-admitting one must be able to serve it"
      "verbatim, and nothing here can re-serialise (#28, #29)."
    match carried
        [] -> []
        [coinbase, ..rest] -> rest

verify restorable
    restorable([]) => []
    restorable([Carried(transaction = Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "cb", size = 0, isSegWit = false), bytes = [1])]) => []

fn transactionsIn(carried: List<Carried>, acc: List<Transaction>) -> List<Transaction>
    ? "Just the decoded Transactions, for the disconnect that spends them."
    match carried
        [] -> List.reverse(acc)
        [head, ..tail] -> transactionsIn(tail, List.prepend(head.transaction, acc))

verify transactionsIn
    transactionsIn([], []) => []
    transactionsIn([Carried(transaction = Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "cb", size = 0, isSegWit = false), bytes = [1])], []) => [Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "cb", size = 0, isSegWit = false)]

fn bodyOf(store: Store, blocks: BlockStore, blockId: String) -> Result<List<Carried>, String>
    ? "A Block being disconnected has to be read, because its Undo Data says"
      "what it spent and only the Block itself says what it made."
    ! [Disk.readBytesAt, Infra.Kv.get]
    located = Infra.Store.get(store, Domain.IndexKeys.blockKey(blockId)?)?
    match located
        Option.None -> Result.Err("Block {blockId} has to come off the Set but its body is not held; it was pruned or never fetched, so the Set has to be rebuilt")
        Option.Some(text) -> bodyAt(blocks, Domain.Index.decodeLocation(text))

fn bodyAt(blocks: BlockStore, location: Result<Location, String>) -> Result<List<Carried>, String>
    ? "The Transactions at a Location, each beside its bytes."
    ! [Disk.readBytesAt]
    at = location?
    Domain.Block.carriedOf(Infra.Blocks.read(blocks, at)?)

fn sample() -> Result<Store, String>
    ? "A two-Block branch whose tip h: has stopped naming, for the cases here."
      "aa sits at Height 1 and h: still names it; bb sits at Height 2 and h:"
      "names cc there instead, which is exactly what a reorganisation leaves"
      "behind for the Set to walk back through."
    Result.Ok(Infra.Store.fixture([(Domain.TreeStore.headerKey("aa")?, Domain.TreeStore.encodeHeld(Domain.TreeStore.heldFor(Domain.HeaderTree.Placement(blockId = "aa", parentId = "00", height = 1, work = 8590065666), "0100"))?), (Domain.TreeStore.headerKey("bb")?, Domain.TreeStore.encodeHeld(Domain.TreeStore.heldFor(Domain.HeaderTree.Placement(blockId = "aa", parentId = "aa", height = 2, work = 12885098499), "0200"))?), (Domain.IndexKeys.heightKey(1)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.heightKey(2)?, Domain.Index.encodeBlockId("cc")?)]))

fn agreeing() -> Standing
    ? "Height 1 of that branch, which h: still names."
    Standing(placement = Placement(blockId = "aa", parentId = "00", height = 1, work = 8590065666), recorded = Option.Some("aa"))

verify agreeing
    Domain.Reorg.agrees(agreeing()) => true

fn differing() -> Standing
    ? "Height 2 of that branch, which h: has given to another Block."
    Standing(placement = Placement(blockId = "bb", parentId = "aa", height = 2, work = 12885098499), recorded = Option.Some("cc"))

verify differing
    Domain.Reorg.agrees(differing()) => false
