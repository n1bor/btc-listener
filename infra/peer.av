module Peer
    intent =
        "The listen command: one Peer, and every Transaction it announces"
        "decoded and printed."
        "This is where the project started and it is now the smallest thing"
        "that uses the pool -- a pool of one. It keeps its own loop rather"
        "than sharing the node's because it wants a different thing: the node"
        "follows Blocks and ignores Transactions, and this does the opposite."
        "Everything about sockets, Handshakes and framing belongs to"
        "Infra.Peers, so a Message is read off a wire in one place in this"
        "program and not two."
    exposes [run]
    depends [Bytes, Domain.Address, Domain.Inbox, Domain.Inventory, Domain.Network, Domain.Transaction, Infra.Peers]
    effects [
        Console.error, Console.print,
        Disk.appendText,
        Infra.Kv.getAll,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]

fn soleKey() -> Int
    ? "The identifier a pool of one Peer keys it under."
    0

verify soleKey
    soleKey() => 0

fn run(network: Network, address: PeerAddress) -> Result<Unit, String>
    ? "Connect, complete the Handshake, then listen until the process is stopped."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    pool = Infra.Peers.joinedOnly(Infra.Peers.opened(network), soleKey(), address)?
    _reported = Console.print("handshake complete")
    closeAfter(pool, listen(pool))

fn closeAfter(pool: Pool, outcome: Result<Unit, String>) -> Result<Unit, String>
    ? "Always release the socket, whatever the session did."
    ! [Tcp.close, Tcp.closeDial, Tcp.closeListener]
    _closed = Infra.Peers.closeAll(pool)
    outcome

fn listen(pool: Pool) -> Result<Unit, String>
    ? "Read Messages for as long as the Peer keeps sending them."
      "This never returns of its own accord: the program runs until it is"
      "stopped, or until a read fails. The call is in tail position, so the"
      "recursion does not grow the stack however long it runs."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    waited = Infra.Peers.awaitAnyPeer(pool)?
    handle(waited.pool, waited.key, waited.frame)

fn handle(pool: Pool, key: Int, frame: Frame) -> Result<Unit, String>
    ? "The three Messages this program acts on; every other one is ignored."
      "A ping must be answered, or the Peer eventually drops the connection."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match frame.command
        "inv" -> onAnnouncement(pool, key, frame.body)
        "tx" -> onTransaction(pool, key, frame.body)
        "ping" -> onPing(pool, key, frame.body)
        _ -> listen(pool)

fn onAnnouncement(pool: Pool, key: Int, body: List<Int>) -> Result<Unit, String>
    ? "Ask for every Transaction the Peer just offered."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    hashes = Domain.Inventory.txHashesOf(body)
    request(pool, key, hashes)

fn request(pool: Pool, key: Int, hashes: List<List<Int>>) -> Result<Unit, String>
    ? "An Announcement carrying no Transactions needs no reply."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match hashes
        [] -> listen(pool)
        [head, ..tail] -> sendGetData(pool, key, hashes)

fn sendGetData(pool: Pool, key: Int, hashes: List<List<Int>>) -> Result<Unit, String>
    ? "Send the getdata that turns identifiers into Transactions."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    payload = Domain.Inventory.getDataPayload(Domain.Inventory.witnessTxType(), hashes)?
    sent = Infra.Peers.send(pool, key, "getdata", payload)?
    listen(sent)

fn onTransaction(pool: Pool, key: Int, body: List<Int>) -> Result<Unit, String>
    ? "Decode and print the Transaction, then go back to listening."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _shown = show(pool.network, Domain.Transaction.decode(body))
    listen(pool)

fn show(network: Network, decoded: Result<Transaction, String>) -> Unit
    ? "Print a decoded Transaction, or say why it could not be read."
      "The Network is known outright here rather than read off a directory:"
      "this Transaction arrived down a connection to a Peer on that chain, so"
      "there is nothing to be uncertain about and the Option is always Some."
    ! [Console.error, Console.print]
    match decoded
        Result.Ok(transaction) -> printLines(Domain.Transaction.summaryLines(Option.Some(network), transaction))
        Result.Err(reason) -> Console.error("could not decode transaction: {reason}")

fn onPing(pool: Pool, key: Int, body: List<Int>) -> Result<Unit, String>
    ? "Reply with the same nonce the Peer sent."
    ! [
        Console.error, Console.print,
        Infra.Kv.getAll,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    payload = Bytes.fromList(body)?
    sent = Infra.Peers.send(pool, key, "pong", payload)?
    listen(sent)

fn printLines(lines: List<String>) -> Unit
    ? "Print each line in turn."
    ! [Console.print]
    match lines
        [] -> Unit
        [head, ..tail] -> printThen(head, tail)

fn printThen(line: String, rest: List<String>) -> Unit
    ? "Print one line, then continue with the rest."
    ! [Console.print]
    _printed = Console.print(line)
    printLines(rest)
