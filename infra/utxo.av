module Utxo
    intent =
        "Connecting and disconnecting a Block against a Store."
        "The deciding is Domain.Connect and Domain.Disconnect, both of which"
        "are pure and carry their own cases. What is here is the part that"
        "cannot be: reading the Outputs a Block's Inputs name, and writing the"
        "answer down."
        "Every Input the Block spends is looked up once, before anything is"
        "decided. Some of those lookups come back empty and are not faults --"
        "an Input may be spending an Output made earlier in the same Block,"
        "which the Set does not hold and will not until the Block connects."
        "Domain.Connect knows the difference; this only has to hand it"
        "everything the Store could find."
        "The three writes go together and in order: the Outputs the Block"
        "made, the keys it spent, and the Undo Data that says what those keys"
        "held. A Store that stopped between them would hold a Set that never"
        "existed, so they are one batch."
    exposes [Applied, connectBlock, prepared, written, disconnectBlock, prunedUndo]
    depends [Bytes, Domain.Connect, Domain.Disconnect, Domain.Index, Domain.IndexKeys, Domain.Network, Domain.Spend, Domain.Transaction, Domain.UtxoStore, Infra.Store]
    effects [Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.getAll, Infra.Kv.putAll]

record Applied
    store: Store
    added: Int
    removed: Int
    fees: Int
    confirmed: List<TxFee>

fn connectBlock(network: Network, store: Store, height: Int, blockId: String, transactions: List<Transaction>) -> Result<Applied, String>
    ? "Take this Block's spends out of the Set and put its Outputs in."
    ! [Infra.Kv.applyAll, Infra.Kv.getAll]
    written(store, blockId, prepared(network, store, height, transactions)?)

fn prepared(network: Network, store: Store, height: Int, transactions: List<Transaction>) -> Result<Connecting, String>
    ? "What this Block does to the Set: its Inputs resolved and the change"
      "worked out, nothing written (#233)."
      "The half of connecting a Block that only reads, kept apart from the"
      "half that writes so the Set walk can run it beside the next Block's"
      "fetch and keep every write on the one thread that owns the Store."
    ! [Infra.Kv.getAll]
    fromStore = resolved(store, spentKeys(transactions, [])?, Map.fromList([]))?
    Result.Ok(Domain.Connect.connected(network, height, transactions, fromStore))

fn written(store: Store, blockId: String, connection: Connecting) -> Result<Applied, String>
    ? "A refusal is a fact about the Block, not a failure of the Store."
      "It still comes back as an Err: the caller asked for a Block to be"
      "connected and it was not, and a node that carried on would be"
      "following a chain it had not checked."
    ! [Infra.Kv.applyAll]
    match connection
        Connecting.Refused(why) -> Result.Err("Block {blockId} cannot connect: {why}")
        Connecting.Applied(change) -> applying(store, blockId, change)

fn applying(store: Store, blockId: String, change: Change) -> Result<Applied, String>
    ? "The Outputs, the Undo Data and the spends, as one change (#235)."
      "One batch rather than a put and then a delete: one crossing, one"
      "fsync, and no moment at which the Set holds both an Output and the"
      "Outputs it spent."
    ! [Infra.Kv.applyAll]
    changed = Infra.Store.applyAll(store, entriesFor(change.added, [Entry(key = Domain.UtxoStore.undoKey(blockId)?, value = Domain.UtxoStore.encodeUndo(change.removed)?)])?, keysOf(change.removed, [])?)?
    Result.Ok(Applied(store = changed, added = List.len(change.added), removed = List.len(change.removed), fees = change.fees, confirmed = change.confirmed))

fn entriesFor(added: List<Unspent>, acc: List<Entry>) -> Result<List<Entry>, String>
    ? "One Set entry per Output the Block leaves unspent."
    match added
        [] -> Result.Ok(acc)
        [head, ..tail] -> entriesFor(tail, List.prepend(Entry(key = Domain.UtxoStore.keyOf(head)?, value = Domain.UtxoStore.encodeCoin(head)?), acc))

verify entriesFor
    entriesFor([], []) => Result.Ok([])
    List.len(entriesFor([Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false)], [])?) => 1
    entriesFor([Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false)], []) => Result.Ok([Entry(key = Domain.UtxoStore.unspentKey("aa", 0)?, value = Domain.UtxoStore.encodeCoin(Domain.UtxoStore.Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false))?)])

fn keysOf(unspents: List<Unspent>, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "Where each of these Outputs lived."
    match unspents
        [] -> Result.Ok(acc)
        [head, ..tail] -> keysOf(tail, List.prepend(Domain.UtxoStore.keyOf(head)?, acc))

verify keysOf
    keysOf([], []) => Result.Ok([])
    keysOf([Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false)], []) => Result.Ok([Domain.UtxoStore.unspentKey("aa", 0)?])

fn spentKeys(transactions: List<Transaction>, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "Every Output this Block's Inputs name."
      "The coinbase is the first Transaction and its Input names no Output, so"
      "it is dropped rather than looked up. Everything else is asked for, even"
      "the ones the Block itself is about to make -- the Store will not have"
      "those, and Domain.Connect is what knows that is fine."
    match transactions
        [] -> Result.Ok(acc)
        [coinbase, ..rest] -> namedBy(rest, acc)

verify spentKeys
    spentKeys([], []) => Result.Ok([])
    spentKeys([coinbaseTx()], []) => Result.Ok([])
    spentKeys([coinbaseTx(), spendingTx("aa", 0)], []) => Result.Ok([Domain.UtxoStore.unspentKey("aa", 0)?])

fn namedBy(transactions: List<Transaction>, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "The Outputs named by every Transaction after the coinbase."
    match transactions
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> namedBy(tail, fromInputs(head.inputs, acc)?)

verify namedBy
    namedBy([], []) => Result.Ok([])
    namedBy([spendingTx("aa", 0)], []) => Result.Ok([Domain.UtxoStore.unspentKey("aa", 0)?])

fn fromInputs(inputs: List<Input>, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "One key per Input, skipping any that names no Transaction."
    match inputs
        [] -> Result.Ok(acc)
        [head, ..tail] -> fromInputs(tail, keptUnlessCoinbase(head, acc)?)

verify fromInputs
    fromInputs([], []) => Result.Ok([])
    List.len(fromInputs([Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = [])], [])?) => 1

fn keptUnlessCoinbase(input: Input, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "An Input naming the empty Transaction Id spends nothing."
    match Domain.Spend.isCoinbaseInput(input.previousTxid)
        true -> Result.Ok(acc)
        false -> Result.Ok(List.prepend(Domain.Connect.outpointKey(input.previousTxid, input.previousIndex)?, acc))

verify keptUnlessCoinbase
    keptUnlessCoinbase(Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = []), []) => Result.Ok([Domain.UtxoStore.unspentKey("aa", 0)?])
    keptUnlessCoinbase(Input(previousTxid = Domain.Spend.coinbaseTxid(), previousIndex = 0, script = "", sequence = 0, witness = []), []) => Result.Ok([])

fn resolved(store: Store, keys: List<Bytes>, acc: Map<Bytes, Unspent>) -> Result<Map<Bytes, Unspent>, String>
    ? "Everything the Set holds for these keys, in one round trip (#227) --"
      "or four at once when there are enough of them (#236)."
      "A big Block names thousands of Outputs. Below the threshold one"
      "getAll and one fold; above it the keys are quartered and each quarter"
      "is fetched and decoded on its own branch, and only the Map is built"
      "here, because a Map cannot cross a product's carrier and building"
      "one is the cheap part."
    ! [Infra.Kv.getAll]
    match List.len(keys) < apartAbove()
        true -> pairsInto(decodedAll(store, keys)?, acc)
        false -> apart(store, keys, acc)

fn apartAbove() -> Int
    ? "How many keys make quartering worth its threads."
    512

verify apartAbove
    apartAbove() => 512

fn apart(store: Store, keys: List<Bytes>, acc: Map<Bytes, Unspent>) -> Result<Map<Bytes, Unspent>, String>
    ? "Four quarters, each fetched and decoded independently (#236)."
      "Reads only, of keys the Set will not change until the Block is"
      "written, so the four cannot disagree; the answers are folded in key"
      "order so the Map is the one a single round trip would have built."
    ! [Infra.Kv.getAll]
    half = Int.div(List.len(keys), 2)
    left = List.take(keys, half)
    right = List.drop(keys, half)
    both = (halved(store, left), halved(store, right))?!
    match both
        (l, r) -> pairsInto(r, pairsInto(l, acc)?)

fn halved(store: Store, keys: List<Bytes>) -> Result<List<Tuple<Bytes, Unspent>>, String>
    ? "One half, as two quarters on their own branches."
    ! [Infra.Kv.getAll]
    half = Int.div(List.len(keys), 2)
    both = (decodedAll(store, List.take(keys, half)), decodedAll(store, List.drop(keys, half)))?!
    match both
        (l, r) -> Result.Ok(List.concat(l, r))

fn decodedAll(store: Store, keys: List<Bytes>) -> Result<List<Tuple<Bytes, Unspent>>, String>
    ? "These keys asked for together, and every answer the Set had decoded."
    ! [Infra.Kv.getAll]
    decodedPairs(keys, Infra.Store.getAll(store, keys)?, [])

fn decodedPairs(keys: List<Bytes>, answers: List<Option<Bytes>>, acc: List<Tuple<Bytes, Unspent>>) -> Result<List<Tuple<Bytes, Unspent>>, String>
    ? "The answers zipped back against the keys that asked for them; an"
      "absent one is simply not in the list."
    match keys
        [] -> Result.Ok(List.reverse(acc))
        [key, ..rest] -> decodedOne(key, rest, answers, acc)

verify decodedPairs
    decodedPairs([], [], []) => Result.Ok([])
    decodedPairs([Domain.UtxoStore.unspentKey("aa", 0)?], [Option.None], []) => Result.Ok([])
    List.len(decodedPairs([Domain.UtxoStore.unspentKey("aa", 0)?], [Option.Some(Domain.UtxoStore.encodeCoin(Domain.UtxoStore.Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false))?)], [])?) => 1
    decodedPairs([Domain.UtxoStore.unspentKey("aa", 0)?], [], []) => Result.Err("the Store answered fewer keys than were asked")
    decodedPairs([Domain.UtxoStore.unspentKey("aa", 0)?], [Option.Some(Domain.Index.emptyBytes())], []) => Result.Err("a Set entry is at least 13 bytes, got 0")

fn decodedOne(key: Bytes, rest: List<Bytes>, answers: List<Option<Bytes>>, acc: List<Tuple<Bytes, Unspent>>) -> Result<List<Tuple<Bytes, Unspent>>, String>
    ? "One key's answer, then the rest."
    match answers
        [] -> Result.Err("the Store answered fewer keys than were asked")
        [answer, ..more] -> decodedWith(key, rest, more, acc, answer)

verify decodedOne
    decodedOne(Domain.UtxoStore.unspentKey("aa", 0)?, [], [], []) => Result.Err("the Store answered fewer keys than were asked")
    decodedOne(Domain.UtxoStore.unspentKey("aa", 0)?, [], [Option.None], []) => Result.Ok([])

fn decodedWith(key: Bytes, rest: List<Bytes>, more: List<Option<Bytes>>, acc: List<Tuple<Bytes, Unspent>>, answer: Option<Bytes>) -> Result<List<Tuple<Bytes, Unspent>>, String>
    ? "Absent is left out; present is decoded and kept."
    match answer
        Option.None -> decodedPairs(rest, more, acc)
        Option.Some(value) -> decodedKept(key, rest, more, acc, Domain.UtxoStore.decodeCoin(txidIn(key), indexIn(key), value))

verify decodedWith
    decodedWith(Domain.UtxoStore.unspentKey("aa", 0)?, [], [], [], Option.None) => Result.Ok([])
    List.len(decodedWith(Domain.UtxoStore.unspentKey("aa", 0)?, [], [], [], Option.Some(Domain.UtxoStore.encodeCoin(Domain.UtxoStore.Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false))?))?) => 1

fn decodedKept(key: Bytes, rest: List<Bytes>, more: List<Option<Bytes>>, acc: List<Tuple<Bytes, Unspent>>, decoded: Result<Unspent, String>) -> Result<List<Tuple<Bytes, Unspent>>, String>
    ? "A Set entry that will not decode is corruption and stops the walk."
    match decoded
        Result.Err(why) -> Result.Err(why)
        Result.Ok(unspent) -> decodedPairs(rest, more, List.prepend((key, unspent), acc))

verify decodedKept
    decodedKept(Domain.UtxoStore.unspentKey("aa", 0)?, [], [], [], Result.Err("bad")) => Result.Err("bad")
    List.len(decodedKept(Domain.UtxoStore.unspentKey("aa", 0)?, [], [], [], Result.Ok(Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false)))?) => 1

fn pairsInto(pairs: List<Tuple<Bytes, Unspent>>, acc: Map<Bytes, Unspent>) -> Result<Map<Bytes, Unspent>, String>
    ? "The decoded answers into the Map, in argument position of the tail call."
    match pairs
        [] -> Result.Ok(acc)
        [head, ..tail] -> pairInto(head, tail, acc)

verify pairsInto
    Map.len(pairsInto([], noCoins())?) => 0
    Map.len(pairsInto([(Domain.UtxoStore.unspentKey("aa", 0)?, Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false))], noCoins())?) => 1

fn noCoins() -> Map<Bytes, Unspent>
    ? "An empty Map of the resolved kind, for the cases here."
    Map.fromList([])

verify noCoins
    Map.len(noCoins()) => 0

fn pairInto(pair: Tuple<Bytes, Unspent>, tail: List<Tuple<Bytes, Unspent>>, acc: Map<Bytes, Unspent>) -> Result<Map<Bytes, Unspent>, String>
    ? "One pair in, then the rest."
    match pair
        (key, unspent) -> pairsInto(tail, Map.set(acc, key, unspent))

verify pairInto
    Map.len(pairInto((Domain.UtxoStore.unspentKey("aa", 0)?, Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false)), [], noCoins())?) => 1

fn txidIn(key: Bytes) -> Bytes
    ? "The Transaction Id a Set key names."
      "Fixed-width now, so this is a slice rather than a split: one tag byte,"
      "then the Transaction Id, then the position. It used to split on colons,"
      "which only worked because the key was text."
      "Taken by exclusion rather than by a length of thirty-two -- the tag"
      "off the front and the position off the back, and whatever is between"
      "is the Id. A real one is thirty-two bytes; the cases here use short"
      "ones, and a slice that assumed the length silently swallowed the"
      "position bytes into the Id."
      "As bytes now (#234): what the key holds is what decodeCoin wants, and"
      "rendering it to hexadecimal in between was a cost paid once an Input."
      "Total: a key is octets by construction, so its slice is too."
    Result.withDefault(Bytes.fromList(idBytesIn(Bytes.octets(key))), key)

verify txidIn
    txidIn(Domain.UtxoStore.unspentKey("aa", 0)?) => Bytes.fromList([170])
    txidIn(Domain.UtxoStore.unspentKey("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", 3)?) => Bytes.fromHex("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16")?

fn idBytesIn(octets: List<Int>) -> List<Int>
    ? "The bytes between the tag and the position."
    List.take(List.drop(octets, 1), List.len(octets) - 1 - Domain.IndexKeys.indexWidth())

verify idBytesIn
    idBytesIn([117, 170, 0, 0, 0, 0]) => [170]
    idBytesIn([117, 1, 2, 0, 0, 0, 5]) => [1, 2]

fn indexIn(key: Bytes) -> Int
    ? "The Output position a Set key names."
      "The last four bytes, most significant first, which is the order they"
      "were written in so that a scan sees Outputs in Output order."
    fromScanOrder(List.drop(Bytes.octets(key), List.len(Bytes.octets(key)) - Domain.IndexKeys.indexWidth()), 0)

verify indexIn
    indexIn(Domain.UtxoStore.unspentKey("aa", 0)?) => 0
    indexIn(Domain.UtxoStore.unspentKey("aa", 12)?) => 12
    indexIn(Domain.UtxoStore.unspentKey("aa", 962268)?) => 962268

fn fromScanOrder(bytes: List<Int>, acc: Int) -> Int
    ? "Big-endian bytes back into the number they were written from."
    match bytes
        [] -> acc
        [head, ..tail] -> fromScanOrder(tail, acc * 256 + head)

verify fromScanOrder
    fromScanOrder([], 0) => 0
    fromScanOrder([0, 0, 0, 1], 0) => 1
    fromScanOrder([0, 0, 1, 0], 0) => 256
    fromScanOrder(Domain.IndexKeys.scanOrder(962268, 4), 0) => 962268

fn disconnectBlock(store: Store, blockId: String, transactions: List<Transaction>) -> Result<Applied, String>
    ? "Take this Block back out of the Set, from what it recorded on the way in."
    ! [Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll]
    held = Infra.Store.get(store, Domain.UtxoStore.undoKey(blockId)?)?
    reversing(store, blockId, transactions, held)

fn reversing(store: Store, blockId: String, transactions: List<Transaction>, held: Option<Bytes>) -> Result<Applied, String>
    ? "No Undo Data means the Block was never connected, or the window has passed it."
    ! [Infra.Kv.deleteAll, Infra.Kv.putAll]
    match held
        Option.None -> Result.Err("Block {blockId} has no Undo Data, so it cannot be disconnected")
        Option.Some(stored) -> undoing(store, blockId, transactions, Domain.UtxoStore.decodeUndo(stored))

fn undoing(store: Store, blockId: String, transactions: List<Transaction>, undo: Result<List<Unspent>, String>) -> Result<Applied, String>
    ? "Undo Data that will not decode is corruption."
    ! [Infra.Kv.deleteAll, Infra.Kv.putAll]
    match undo
        Result.Err(why) -> Result.Err(why)
        Result.Ok(removed) -> reversed(store, blockId, Domain.Disconnect.reversal(transactions, removed)?)

fn reversed(store: Store, blockId: String, reversal: Reversal) -> Result<Applied, String>
    ? "Put back what was taken, take out what was made, and forget the record."
      "Restoring before deleting, so that an Output this Block both made and"
      "spent is deleted rather than left behind: it is in neither list, but a"
      "Set that was written in the other order could still be holding one."
    ! [Infra.Kv.deleteAll, Infra.Kv.putAll]
    restored = Infra.Store.putAll(store, entriesFor(reversal.restored, [])?)?
    cleared = Infra.Store.deleteAll(restored, List.prepend(Domain.UtxoStore.undoKey(blockId)?, reversal.deleted))?
    Result.Ok(Applied(store = cleared, added = List.len(reversal.restored), removed = List.len(reversal.deleted), fees = 0, confirmed = []))

fn prunedUndo(store: Store, tipHeight: Int) -> Result<Store, String>
    ? "Forget the Undo Data of Blocks the window has moved past."
      "Walks up from where it last got to, so it does not rescan the chain"
      "every Block. The record it keeps is the lowest Height still held."
    ! [Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll]
    below = Infra.Store.get(store, Domain.UtxoStore.undoWindowKey()?)?
    sweeping(store, Domain.Index.prunedBelowOf(below)?, Domain.Disconnect.windowFrom(tipHeight), [])

verify prunedUndo
    Infra.Store.get(prunedUndo(Infra.Store.fixture([]), 300)?, Domain.UtxoStore.undoWindowKey()?) => Result.Ok(Option.Some(Domain.Index.encodeHeight(13)))
    Infra.Store.get(prunedUndo(Infra.Store.fixture([(Domain.UtxoStore.undoWindowKey()?, Domain.Index.encodeHeight(100))]), 300)?, Domain.UtxoStore.undoWindowKey()?) => Result.Ok(Option.Some(Domain.Index.encodeHeight(100)))
    prunedUndo(Infra.Store.fixture([(Domain.UtxoStore.undoWindowKey()?, Domain.Index.emptyBytes())]), 300) => Result.Err("a Height record is 4 bytes, got 0")

fn sweeping(store: Store, from: Int, target: Int, acc: List<Bytes>) -> Result<Store, String>
    ? "One Height at a time up to the window's new floor."
      "What gets recorded is where the walk actually got to, which is the"
      "target when it started below it and the floor it already had when it"
      "did not. The floor only ever rises: a reorganisation lowers the tip and"
      "so lowers the target, but the Undo Data the last sweep deleted does not"
      "come back, and a floor that followed the target down would be claiming"
      "records that are gone."
    ! [Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll]
    match from >= target
        true -> marked(store, from, acc)
        false -> undoAt(store, from, target, acc)

fn undoAt(store: Store, from: Int, target: Int, acc: List<Bytes>) -> Result<Store, String>
    ? "The Block this Height names, and its Undo Data record."
    ! [Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll]
    named = Domain.Index.blockIdIn(Infra.Store.get(store, Domain.IndexKeys.heightKey(from)?)?)
    sweeping(store, from + 1, target, gathered(named, acc)?)

fn gathered(named: Option<String>, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "A Height that names no Block leaves nothing to forget."
    match named
        Option.None -> Result.Ok(acc)
        Option.Some(blockId) -> Result.Ok(List.prepend(Domain.UtxoStore.undoKey(blockId)?, acc))

verify gathered
    gathered(Option.None, []) => Result.Ok([])
    gathered(Option.Some("aa"), []) => Result.Ok([Domain.UtxoStore.undoKey("aa")?])

fn marked(store: Store, reached: Int, acc: List<Bytes>) -> Result<Store, String>
    ? "Delete what was gathered and record how far the window now reaches."
    ! [Infra.Kv.deleteAll, Infra.Kv.putAll]
    swept = Infra.Store.deleteAll(store, acc)?
    Infra.Store.putAll(swept, [Entry(key = Domain.UtxoStore.undoWindowKey()?, value = Domain.Index.encodeHeight(reached))])

fn coinbaseTx() -> Transaction
    ? "A coinbase, for the cases here."
    Transaction(version = 1, inputs = [Input(previousTxid = Domain.Spend.coinbaseTxid(), previousIndex = 0, script = "", sequence = 0, witness = [])], outputs = [Output(value = 50, script = "")], lockTime = 0, txid = "cb", size = 0, isSegWit = false)

verify coinbaseTx
    coinbaseTx().txid => "cb"

fn spendingTx(txid: String, index: Int) -> Transaction
    ? "A Transaction spending one named Output, for the cases here."
    Transaction(version = 1, inputs = [Input(previousTxid = txid, previousIndex = index, script = "", sequence = 0, witness = [])], outputs = [Output(value = 40, script = "")], lockTime = 0, txid = "t1", size = 0, isSegWit = false)

verify spendingTx
    spendingTx("aa", 0).txid => "t1"
