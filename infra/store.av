module Store
    intent =
        "A keyed byte store: get, put, delete and batch, over a backend that is"
        "either a Map held in memory or a database in the directory it was"
        "opened on."
        "This module is a seam. The Store is opaque, so the representation is"
        "enforced rather than merely agreed: a caller cannot build one, read a"
        "field from it, or match on it, and every attempt is a compile error"
        "rather than something a reviewer has to catch. That is what let the sum"
        "grow the database arm without a caller noticing, and what let the log"
        "arm go the same way."
        "There was a third backend. Logged replayed an append-only text log into"
        "memory on every open -- the format that came before the database, kept"
        "so migrate had something to move from. Nothing read it any more, a text"
        "log cannot hold the binary keys #45 wants, and the directory is rebuilt"
        "from the network rather than migrated (#42), so #44 retired it: the"
        "arm, openLogged, heldBy, Infra.StoreLog and the migrate command are"
        "gone, and a directory still holding only a log is refused by name, as"
        "Infra.Blocks refuses a directory of hex Segments."
        "Memory is not a lesser Store. It is what fixture returns, and the"
        "verify blocks of four other modules are written against it, so it has"
        "to refuse exactly what the database backend refuses or those blocks"
        "stop being evidence about the real thing. Both backends pass every"
        "write through the one gate, acceptable."
        "The key rules -- no empty key, no tab or newline in a key or a value --"
        "are inherited from the log format, and the database could hold what"
        "they refuse. They stay anyway: every key the Index writes is"
        "hexadecimal, digits or a colon, so the rules refuse nothing the"
        "program produces, and they keep a fixture and the database in"
        "agreement until #45 moves keys to bytes and the rules are rewritten"
        "rather than quietly relaxed."
        "The reads return a Result although the Memory backend cannot fail, and"
        "open is given a directory rather than a file name. Both are shaped for"
        "the database: a read from it can fail for reasons a Map has not got,"
        "and what a Store keeps inside its directory is the Store's business."
        "Write in batches. One putAll is one LevelDB write batch, so the cost"
        "of a write is round trips rather than copying, and a loop over put"
        "hands back a Store per call where putAll hands back one."
    exposes [Entry, open, get, has, size, put, putAll, delete, deleteAll, fixture]
    exposes opaque [Store]
    depends [Bytes, Infra.Kv]
    effects [
        Disk.exists, Disk.makeDir,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]

type Store
    Memory(Map<String, String>)
    Database(Infra.Kv.Handle)

record Entry
    key: Bytes
    value: String

fn open(dir: String) -> Result<Store, String>
    ? "Open the database in a directory, creating either if it is absent."
      "A directory rather than a file, because what a Store keeps inside it is"
      "the Store's business. This one keeps a LevelDB in kv; no caller has to"
      "be told."
      "The directory is created if absent, and so is the database: since #44"
      "there is nothing else a directory could hold, so a fresh one starts as"
      "a database rather than waiting for a migration to make it one."
    ! [Disk.exists, Disk.makeDir, Infra.Kv.open]
    _made = Disk.makeDir(dir)?
    openBacking(dir, Disk.exists(databaseMark(dir)))

fn openBacking(dir: String, database: Bool) -> Result<Store, String>
    ? "Open the database that is here, or decide what its absence means."
    ! [Disk.exists, Infra.Kv.open]
    match database
        true -> holding(Infra.Kv.open(databasePath(dir)))
        false -> openFresh(dir, Disk.exists(logPath(dir)))

fn openFresh(dir: String, logHere: Bool) -> Result<Store, String>
    ? "No database yet: a leftover log is refused by name, anything else starts one."
      "A directory holding index.log and no database was written by the log"
      "backend this module no longer has. Opening it as an empty database would"
      "silently ignore every entry the log holds, so it is refused the way"
      "Infra.Blocks refuses a directory of hex Segments: the data is in a shape"
      "this program no longer reads, and the directory is rebuilt from the"
      "network (#42). A log left beside an existing database is dead weight"
      "from before #44 and does not refuse anything -- the database wins."
    ! [Infra.Kv.open]
    match logHere
        true -> Result.Err("{logPath(dir)} holds a log-backed Index, the format before the database; rebuild the directory from the network")
        false -> holding(Infra.Kv.open(databasePath(dir)))

fn holding(opened: Result<Infra.Kv.Handle, String>) -> Result<Store, String>
    ? "A database that opened is a Store; one that did not is the reason it did not."
    Result.Ok(Store.Database(opened?))

fn databasePath(dir: String) -> String
    ? "Where this implementation keeps the database inside the directory it is given."
    "{dir}/kv"

verify databasePath
    databasePath("chain") => "chain/kv"
    databasePath("/tmp/chain") => "/tmp/chain/kv"

fn databaseMark(dir: String) -> String
    ? "The file LevelDB always writes, and so the sign that there is a database."
      "Asking for the directory would not do: open makes the directory it is"
      "given, and a half-made one holding no database still has to be told from"
      "one holding a leftover log."
    "{databasePath(dir)}/CURRENT"

verify databaseMark
    databaseMark("chain") => "chain/kv/CURRENT"

fn logPath(dir: String) -> String
    ? "Where the retired log backend kept its records, checked only to refuse it."
    "{dir}/index.log"

verify logPath
    logPath("chain") => "chain/index.log"
    logPath("/tmp/chain") => "/tmp/chain/index.log"

fn empty() -> Map<String, String>
    ? "A Store with nothing in it."
    Map.fromList([])

verify empty
    Map.len(empty()) => 0

fn get(store: Store, key: Bytes) -> Result<Option<String>, String>
    ? "What is stored under a key, if anything."
      "A key the rules refuse is refused rather than answered with None. The two"
      "are not the same thing: absent is a fact about the data, a malformed key"
      "is a fault in the question, and reporting the second as the first hides a"
      "caller's bug behind ordinary-looking data. put has always enforced this;"
      "reads enforcing it too is what makes it a contract."
    ! [Infra.Kv.get]
    match usableKey(key)
        false -> Result.Err(keyRefused())
        true -> looked(store, key)

verify get
    get(fixture([(keyed("a"), "b")]), keyed("a")) => Result.Ok(Option.Some("b"))
    get(fixture([]), keyed("a")) => Result.Ok(Option.None)
    get(fixture([]), keyed("")) => Result.Err("Store key must not be empty")
    get(fixture([]), keyed("a\tb")) => Result.Ok(Option.None)

fn looked(store: Store, key: Bytes) -> Result<Option<String>, String>
    ? "The key is usable, so whichever backend holds the entries answers from them."
    ! [Infra.Kv.get]
    match store
        Store.Memory(held) -> Result.Ok(Map.get(held, indexed(key)))
        Store.Database(handle) -> asText(Infra.Kv.get(handle, key))

verify looked
    looked(Store.Memory(Map.fromList([(indexed(keyed("a")), "b")])), keyed("a")) => Result.Ok(Option.Some("b"))
    looked(Store.Memory(Map.fromList([])), keyed("a")) => Result.Ok(Option.None)

fn has(store: Store, key: Bytes) -> Result<Bool, String>
    ? "Whether a key is present, refusing one that could never have been stored."
    ! [Infra.Kv.get]
    match usableKey(key)
        false -> Result.Err(keyRefused())
        true -> present(store, key)

verify has
    has(fixture([(keyed("a"), "b")]), keyed("a")) => Result.Ok(true)
    has(fixture([]), keyed("a")) => Result.Ok(false)
    has(fixture([]), keyed("")) => Result.Err("Store key must not be empty")

fn present(store: Store, key: Bytes) -> Result<Bool, String>
    ? "The key is usable, so ask the entries the backend holds."
    ! [Infra.Kv.get]
    match store
        Store.Memory(held) -> Result.Ok(Map.has(held, indexed(key)))
        Store.Database(handle) -> wasFound(Infra.Kv.get(handle, key))

verify present
    present(Store.Memory(Map.fromList([(indexed(keyed("a")), "b")])), keyed("a")) => Result.Ok(true)
    present(Store.Memory(Map.fromList([])), keyed("a")) => Result.Ok(false)

fn wasFound(found: Result<Option<Bytes>, String>) -> Result<Bool, String>
    ? "Whether a lookup found anything."
      "The database has no cheaper existence check than a read, so has costs a"
      "read and throws the value away rather than pretending otherwise."
    Result.Ok(anything(found?))

verify wasFound
    wasFound(Result.Ok(Option.Some(asBytes("b")))) => Result.Ok(true)
    wasFound(Result.Ok(Option.None)) => Result.Ok(false)
    wasFound(Result.Err("no")) => Result.Err("no")

fn anything(found: Option<Bytes>) -> Bool
    ? "Whether a lookup found anything."
    match found
        Option.Some(value) -> true
        Option.None -> false

verify anything
    anything(Option.Some(asBytes("b"))) => true
    anything(Option.None) => false

fn size(store: Store) -> Result<Int, String>
    ? "How many keys the Store holds."
      "It costs the database a walk of the keyspace. LevelDB keeps no count and"
      "keeping one would mean a second write on every batch; the single caller"
      "asks once, at the end of a build, so the walk is paid once."
    ! [Infra.Kv.count]
    match store
        Store.Memory(held) -> Result.Ok(Map.len(held))
        Store.Database(handle) -> Infra.Kv.count(handle)

fn fixture(pairs: List<Tuple<Bytes, String>>) -> Store
    ? "A Store holding exactly these pairs, for verify blocks in other modules."
      "An opaque Store cannot be built from outside, and functions elsewhere that"
      "take one still have to be checked, so the seam supplies the fixture rather"
      "than leaving each caller to invent a representation it should not know."
      "It touches no disk, and says so in the type. A Store made this way refuses"
      "the same keys the database does and can be written to; what it cannot do"
      "is outlive the call."
    Store.Memory(Map.fromList(asIndexed(pairs, [])))

verify fixture
    fixture([]) => Store.Memory(Map.fromList([]))
    fixture([(keyed("a"), "b")]) => Store.Memory(Map.set(Map.fromList([]), indexed(keyed("a")), "b"))
    fixture([(keyed("a"), "b"), (keyed("c"), "d")]) => Store.Memory(Map.fromList([(indexed(keyed("a")), "b"), (indexed(keyed("c")), "d")]))

fn put(store: Store, key: Bytes, value: String) -> Result<Store, String>
    ? "Record one key."
      "Convenience for a single change. Anything in bulk should go through"
      "putAll: one putAll is one write batch, and a loop over put pays a round"
      "trip per key."
    ! [Infra.Kv.putAll]
    putAll(store, [Entry(key = key, value = value)])

fn putAll(store: Store, entries: List<Entry>) -> Result<Store, String>
    ? "Record several keys in one batch, which the database makes atomic."
    ! [Infra.Kv.putAll]
    match store
        Store.Memory(held) -> heldPut(held, entries)
        Store.Database(handle) -> storedPut(handle, entries)

fn storedPut(handle: Infra.Kv.Handle, entries: List<Entry>) -> Result<Store, String>
    ? "Hand the batch to the database, which is where it then lives."
      "No Map comes back, which is the whole point: this is the only backend"
      "whose Store does not grow with what has been written to it."
    ! [Infra.Kv.putAll]
    _checked = acceptable(entries)?
    _written = Infra.Kv.putAll(handle, asPairs(entries, []))?
    Result.Ok(Store.Database(handle))

fn asPairs(entries: List<Entry>, acc: List<Tuple<Bytes, Bytes>>) -> List<Tuple<Bytes, Bytes>>
    ? "The batch as the pairs the contract carries."
    match entries
        [] -> List.reverse(acc)
        [head, ..tail] -> asPairs(tail, List.prepend((head.key, asBytes(head.value)), acc))

verify asPairs
    asPairs([], []) => []
    asPairs([Entry(key = keyed("a"), value = "b")], []) => [(asBytes("a"), asBytes("b"))]
    asPairs([Entry(key = keyed("a"), value = "b"), Entry(key = keyed("c"), value = "d")], []) => [(asBytes("a"), asBytes("b")), (asBytes("c"), asBytes("d"))]

fn asIndexed(pairs: List<Tuple<Bytes, String>>, acc: List<Tuple<String, String>>) -> List<Tuple<String, String>>
    ? "The fixture's pairs, keyed the way the in-memory backing finds them."
    match pairs
        [] -> List.reverse(acc)
        [head, ..tail] -> asIndexed(tail, List.prepend(indexedPair(head), acc))

verify asIndexed
    asIndexed([], []) => []
    asIndexed([(keyed("a"), "b")], []) => [("61", "b")]

fn indexedPair(pair: Tuple<Bytes, String>) -> Tuple<String, String>
    ? "One fixture pair, keyed the way the in-memory backing finds it."
    match pair
        (key, value) -> (indexed(key), value)

verify indexedPair
    indexedPair((keyed("a"), "b")) => ("61", "b")

fn indexed(key: Bytes) -> String
    ? "How the in-memory backing indexes a key."
      "Hexadecimal, because Aver's Map cannot key on Bytes: the generated"
      "Rust derives neither Eq nor Hash for it (jasisz/aver#1127). The"
      "Store's keys are bytes and the database sees them as bytes; this is"
      "only how a fixture's Map finds one, and it is one-to-one, so nothing"
      "about which keys are distinct changes."
    Bytes.toHex(key)

verify indexed
    indexed(keyed("a")) => "61"
    indexed(keyed("")) => ""

fn keyed(text: String) -> Bytes
    ? "A key spelled as text, for the cases in this module."
      "Only the cases. Every real key is built by Domain.IndexKeys and arrives"
      "already bytes; this exists so a case about the Store can say which key"
      "it means without naming an encoding the Store does not own."
    String.toUtf8(text)

verify keyed
    Bytes.octets(keyed("a")) => [97]

fn asBytes(text: String) -> Bytes
    ? "A key or a value on its way to the database."
      "The database is bytes and this Store's keys are text, so the encoding"
      "is named here rather than assumed at the far end. UTF-8, which for the"
      "keys this program writes -- hexadecimal, digits, colons and one-letter"
      "prefixes -- is one byte per character, so the stored format is exactly"
      "what it was when the contract said String."
    String.toUtf8(text)

verify asBytes
    Bytes.octets(asBytes("")) => []
    Bytes.octets(asBytes("b:aa")) => [98, 58, 97, 97]
    Bytes.octets(asBytes("h:00000001")) => [104, 58, 48, 48, 48, 48, 48, 48, 48, 49]

fn asText(found: Result<Option<Bytes>, String>) -> Result<Option<String>, String>
    ? "What the database answered, back as the text the Store deals in."
    match found
        Result.Err(why) -> Result.Err(why)
        Result.Ok(value) -> textIn(value)

verify asText
    asText(Result.Ok(Option.None)) => Result.Ok(Option.None)
    asText(Result.Ok(Option.Some(asBytes("b")))) => Result.Ok(Option.Some("b"))
    asText(Result.Err("no")) => Result.Err("no")

fn textIn(value: Option<Bytes>) -> Result<Option<String>, String>
    ? "An absent key stays absent; a present one has to be text."
    match value
        Option.None -> Result.Ok(Option.None)
        Option.Some(bytes) -> someText(String.fromUtf8(bytes))

verify textIn
    textIn(Option.None) => Result.Ok(Option.None)
    textIn(Option.Some(asBytes("b"))) => Result.Ok(Option.Some("b"))

fn someText(decoded: Result<String, String>) -> Result<Option<String>, String>
    ? "A stored value that is not text was written by something else."
      "The provider used to make this claim in Rust, where no caller could see"
      "it fail. It is a fact about the world -- somebody else wrote this file"
      "-- so it is an Err, and now it is one an Aver caller is handed."
    match decoded
        Result.Err(why) -> Result.Err("the database holds a value that is not text: {why}")
        Result.Ok(text) -> Result.Ok(Option.Some(text))

verify someText
    someText(Result.Ok("b")) => Result.Ok(Option.Some("b"))
    someText(Result.Err("invalid utf-8")) => Result.Err("the database holds a value that is not text: invalid utf-8")

fn asKeyBytes(keys: List<String>, acc: List<Bytes>) -> List<Bytes>
    ? "A batch of keys on its way to the database."
    match keys
        [] -> List.reverse(acc)
        [head, ..tail] -> asKeyBytes(tail, List.prepend(asBytes(head), acc))

verify asKeyBytes
    asKeyBytes([], []) => []
    asKeyBytes(["a", "b"], []) => [asBytes("a"), asBytes("b")]

fn heldPut(held: Map<String, String>, entries: List<Entry>) -> Result<Store, String>
    ? "Absorb a batch into memory, having first passed it through the same gate."
      "Memory has no database to refuse a key, so it borrows the refusal rather"
      "than repeating the rule, which is what keeps a fixture evidence about the"
      "Store the program actually runs on."
    _checked = acceptable(entries)?
    Result.Ok(Store.Memory(absorbAll(entries, held)))

verify heldPut
    heldPut(empty(), [Entry(key = keyed("a"), value = "b")]) => Result.Ok(Store.Memory(Map.set(empty(), indexed(keyed("a")), "b")))
    heldPut(empty(), [Entry(key = keyed("a\tb"), value = "c")]) => Result.Ok(Store.Memory(Map.set(empty(), indexed(keyed("a\tb")), "c")))
    heldPut(empty(), [Entry(key = keyed("a"), value = "b\nc")]) => Result.Err("Store value must not contain a tab or newline, got 'b\nc'")

fn delete(store: Store, key: Bytes) -> Result<Store, String>
    ? "Forget one key."
      "Pruning needs this: a Block whose Segment was deleted must have no Location"
      "entry, or the Prune Watermark could not tell a discarded Block from one"
      "that never arrived."
    ! [Infra.Kv.deleteAll]
    deleteAll(store, [key])

fn deleteAll(store: Store, keys: List<Bytes>) -> Result<Store, String>
    ? "Forget several keys in one batch, as putAll records several in one."
      "Pruning drops the Location of every Block in a deleted Segment, which is"
      "tens of thousands of keys at once, and one batch is one round trip."
    ! [Infra.Kv.deleteAll]
    match store
        Store.Memory(held) -> heldDelete(held, keys)
        Store.Database(handle) -> storedDelete(handle, keys)

fn storedDelete(handle: Infra.Kv.Handle, keys: List<Bytes>) -> Result<Store, String>
    ? "Ask the database to forget the keys, in one batch."
    ! [Infra.Kv.deleteAll]
    _checked = acceptableKeys(keys)?
    _removed = Infra.Kv.deleteAll(handle, keys)?
    Result.Ok(Store.Database(handle))

fn heldDelete(held: Map<String, String>, keys: List<Bytes>) -> Result<Store, String>
    ? "Forget the keys in memory, refusing any the Store could never have held."
    _checked = acceptableKeys(keys)?
    Result.Ok(Store.Memory(forgetAll(keys, held)))

verify heldDelete
    heldDelete(Map.set(empty(), indexed(keyed("a")), "b"), [keyed("a")]) => Result.Ok(Store.Memory(empty()))
    heldDelete(empty(), [keyed("")]) => Result.Err("Store key must not be empty")

fn forgetAll(keys: List<Bytes>, into: Map<String, String>) -> Map<String, String>
    ? "Remove the same keys from the in-memory map."
    match keys
        [] -> into
        [head, ..tail] -> forgetAll(tail, Map.remove(into, indexed(head)))

verify forgetAll
    forgetAll([], empty()) => empty()
    forgetAll([keyed("a")], Map.set(empty(), indexed(keyed("a")), "b")) => empty()
    Map.len(forgetAll([keyed("a")], Map.set(Map.set(empty(), indexed(keyed("a")), "b"), indexed(keyed("c")), "d"))) => 1

fn absorbAll(entries: List<Entry>, into: Map<String, String>) -> Map<String, String>
    ? "Apply the same entries to the in-memory map, in the order they were given."
    match entries
        [] -> into
        [head, ..tail] -> absorbAll(tail, Map.set(into, indexed(head.key), head.value))

verify absorbAll
    absorbAll([], empty()) => empty()
    absorbAll([Entry(key = keyed("a"), value = "b")], empty()) => Map.set(empty(), indexed(keyed("a")), "b")
    Map.get(absorbAll([Entry(key = keyed("a"), value = "b"), Entry(key = keyed("a"), value = "c")], empty()), indexed(keyed("a"))) => Option.Some("c")

fn keyRefused() -> String
    ? "Why a key cannot be used, in the one wording every entry point gives."
      "Reads and writes reject the same keys, so they say so the same way; a"
      "caller that learns the rule from a put should recognise it from a get."
      "One rule is left. A key used to be text and could not hold a tab or a"
      "newline, because the backing was an append-only log with one record per"
      "line; that backing went with n1bor/btc-listener#44 and the keys became"
      "bytes with #45, so there is no byte a key may not contain. Empty is"
      "still refused: it names nothing, and a caller asking for it has a bug"
      "rather than a miss."
    "Store key must not be empty"

verify keyRefused
    keyRefused() => "Store key must not be empty"

fn valueRefused(value: String) -> String
    ? "Why a value cannot be stored, in the one wording every entry point gives."
    "Store value must not contain a tab or newline, got '{value}'"

verify valueRefused
    valueRefused("a\tb") => "Store value must not contain a tab or newline, got 'a\tb'"
    valueRefused("a\nb") => "Store value must not contain a tab or newline, got 'a\nb'"

fn acceptable(entries: List<Entry>) -> Result<Unit, String>
    ? "Whether a whole batch could be stored, naming the first entry that could not."
      "The one gate both backends pass every write through, so a fixture and the"
      "database cannot drift apart in what they accept."
    match entries
        [] -> Result.Ok(Unit)
        [head, ..tail] -> acceptableNext(head, tail)

verify acceptable
    acceptable([]) => Result.Ok(Unit)
    acceptable([Entry(key = keyed("a"), value = "b")]) => Result.Ok(Unit)
    acceptable([Entry(key = keyed("a\tb"), value = "c")]) => Result.Ok(Unit)
    acceptable([Entry(key = keyed("a"), value = "b\nc")]) => Result.Err("Store value must not contain a tab or newline, got 'b\nc'")

fn acceptableNext(head: Entry, tail: List<Entry>) -> Result<Unit, String>
    ? "Refuse this entry's key, then its value, then carry on with the rest."
    match usableKey(head.key)
        false -> Result.Err(keyRefused())
        true -> acceptableValue(head.value, tail)

verify acceptableNext
    acceptableNext(Entry(key = keyed("a"), value = "b"), []) => Result.Ok(Unit)
    acceptableNext(Entry(key = keyed(""), value = "b"), []) => Result.Err("Store key must not be empty")

fn acceptableValue(value: String, tail: List<Entry>) -> Result<Unit, String>
    ? "The key was usable; the value still has to be."
    match usableValue(value)
        false -> Result.Err(valueRefused(value))
        true -> acceptable(tail)

verify acceptableValue
    acceptableValue("b", []) => Result.Ok(Unit)
    acceptableValue("b\tc", []) => Result.Err("Store value must not contain a tab or newline, got 'b\tc'")

fn acceptableKeys(keys: List<Bytes>) -> Result<Unit, String>
    ? "Whether every key in a batch could have been stored."
    match keys
        [] -> Result.Ok(Unit)
        [head, ..tail] -> acceptableKeyNext(head, tail)

verify acceptableKeys
    acceptableKeys([]) => Result.Ok(Unit)
    acceptableKeys([keyed("a"), keyed("b")]) => Result.Ok(Unit)
    acceptableKeys([keyed("a"), keyed("")]) => Result.Err("Store key must not be empty")

fn acceptableKeyNext(head: Bytes, tail: List<Bytes>) -> Result<Unit, String>
    ? "Refuse this key, then carry on with the rest."
    match usableKey(head)
        false -> Result.Err(keyRefused())
        true -> acceptableKeys(tail)

verify acceptableKeyNext
    acceptableKeyNext(keyed("a"), []) => Result.Ok(Unit)
    acceptableKeyNext(keyed(""), []) => Result.Err("Store key must not be empty")

fn usableKey(key: Bytes) -> Bool
    ? "A key must name something."
    List.len(Bytes.octets(key)) > 0

verify usableKey
    usableKey(keyed("b:aa")) => true
    usableKey(keyed("")) => false
    usableKey(keyed("a\tb")) => true
    usableKey(keyed("a\nb")) => true

fn usableValue(value: String) -> Bool
    ? "No tab or newline, the rule inherited from the log format and kept until"
      "#45 moves keys and values to bytes. Every key and value the Index uses is"
      "hexadecimal, digits or a colon, so this rejects nothing the program"
      "itself produces."
    match String.contains(value, "\t")
        true -> false
        false -> String.contains(value, "\n") == false

verify usableValue
    usableValue("7:1234") => true
    usableValue("") => true
    usableValue("a\tb") => false
    usableValue("a\nb") => false
