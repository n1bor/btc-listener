module Store
    intent =
        "A keyed byte store: get, put, delete and batch, backed by an append-only"
        "log that is replayed into memory when it is opened."
        "This module is a seam. When a real key-value database is reachable from"
        "Aver, its body is replaced and its signatures are not. The Store is"
        "opaque, so the representation is enforced rather than merely agreed: a"
        "caller cannot build one, read a field from it, or match on it, and every"
        "attempt is a compile error rather than something a reviewer has to catch."
        "The reads return a Result although this implementation cannot fail, and"
        "open is given a directory rather than a file name. Both are shaped for"
        "the database rather than for the log. A caller written against a total"
        "lookup or a known file name would have to be restructured when the"
        "database arrives; written this way it only has to be recompiled."
        "What is left to do at that point is declare the effects a read performs."
        "Adding an effect is mechanical and the checker names every site; changing"
        "a return type is not, which is why the Result is here already."
        "Appending one record per put and rebuilding on open is not a shortcut"
        "around writing a real index. It is the shape a log-structured store"
        "already has, which is why it can be swapped for one. Rewriting the whole"
        "file on every put would work at a hundred entries and cost a terabyte of"
        "writes at a million."
        "Capacity, not capability, is what bounds this implementation: it holds"
        "every entry in memory, so it suits the Index at around a million entries"
        "and cannot back a UTXO set at two hundred million. Opening a log of"
        "962268 entries takes 1.9 seconds and 414 MB; two hundred million would"
        "want some eighty gigabytes."
        "Write in batches. A Map returned from a function is copied in Aver"
        "0.28.1, and every mutation here hands back a Store holding one, so the"
        "cost of a call is the size of the Store rather than the size of the"
        "change. One putAll of 40000 entries takes 64 milliseconds; the same"
        "40000 entries one put at a time take 35 seconds."
        "That is jasisz/aver#890 and it is still open. Re-measured compiled on 17"
        "August 2026, 40000 entries: 52 milliseconds through one putAll against"
        "24404 one put at a time, so the ratio stands at about 470 and so does"
        "every batch in the callers."
    exposes [Entry, open, get, has, size, put, putAll, delete, deleteAll, compact, fixture]
    exposes opaque [Store]
    depends [Domain.Text]
    effects [Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText]

record Entry
    key: String
    value: String

type Change
    Put(Entry)
    Drop(String)

record Store
    path: String
    entries: Map<String, String>

fn open(dir: String) -> Result<Store, String>
    ? "Rebuild a Store from what is in a directory, or start an empty one."
      "A directory rather than a file, because what a Store keeps inside it is the"
      "Store's business. This one keeps a single log; a database would keep a"
      "directory of its own, and no caller would have to be told."
      "The directory is created if absent, so a caller never has to know that this"
      "implementation appends to a file and will not make the folder holding it."
    ! [Disk.exists, Disk.makeDir, Disk.readText]
    _made = Disk.makeDir(dir)?
    openLog(logPath(dir))

fn logPath(dir: String) -> String
    ? "Where this implementation keeps its records inside the directory it is given."
    "{dir}/index.log"

verify logPath
    logPath("chain") => "chain/index.log"
    logPath("/tmp/chain") => "/tmp/chain/index.log"

fn openLog(path: String) -> Result<Store, String>
    ? "Replay the log if it is there, otherwise start empty."
    ! [Disk.exists, Disk.readText]
    match Disk.exists(path)
        false -> Result.Ok(Store(path = path, entries = empty()))
        true -> reopen(path, Disk.readText(path))

fn reopen(path: String, contents: Result<String, String>) -> Result<Store, String>
    ? "Replay a log that was read, or report why it could not be."
    log = contents?
    entries = replayed(Domain.Text.completeLines(log), empty())?
    Result.Ok(Store(path = path, entries = entries))

verify reopen
    reopen("s.log", Result.Ok("+a\tb\n"))?.entries => Map.set(empty(), "a", "b")
    reopen("s.log", Result.Ok(""))?.entries => empty()
    reopen("s.log", Result.Err("no such file")) => Result.Err("no such file")
    reopen("s.log", Result.Ok("?bad\n")) => Result.Err("Store log record is neither a put nor a delete: '?bad'")

fn empty() -> Map<String, String>
    ? "A Store with nothing in it."
    Map.fromList([])

verify empty
    Map.len(empty()) => 0

fn get(store: Store, key: String) -> Result<Option<String>, String>
    ? "What is stored under a key, if anything."
      "A key the log format could not have written is refused rather than answered"
      "with None. The two are not the same thing: absent is a fact about the data,"
      "a malformed key is a fault in the question, and reporting the second as the"
      "first hides a caller's bug behind ordinary-looking data. put has always"
      "enforced this; reads enforcing it too is what makes it a contract."
      "That is also what the seam needs. A read from a real database can fail for"
      "reasons this one has not got, and a caller written against a total lookup"
      "would have to be restructured rather than recompiled when one arrives."
    match usableKey(key)
        false -> Result.Err(keyRefused(key))
        true -> Result.Ok(Map.get(store.entries, key))

verify get
    get(fixture([("a", "b")]), "a") => Result.Ok(Option.Some("b"))
    get(fixture([]), "a") => Result.Ok(Option.None)
    get(fixture([]), "") => Result.Err("Store key must not be empty or contain a tab or newline, got ''")
    get(fixture([]), "a\tb") => Result.Err("Store key must not be empty or contain a tab or newline, got 'a\tb'")

fn has(store: Store, key: String) -> Result<Bool, String>
    ? "Whether a key is present, refusing one that could never have been stored."
    match usableKey(key)
        false -> Result.Err(keyRefused(key))
        true -> Result.Ok(Map.has(store.entries, key))

verify has
    has(fixture([("a", "b")]), "a") => Result.Ok(true)
    has(fixture([]), "a") => Result.Ok(false)
    has(fixture([]), "") => Result.Err("Store key must not be empty or contain a tab or newline, got ''")

fn size(store: Store) -> Int
    ? "How many keys the Store holds."
      "The one read that names no key, and so the one with nothing to refuse and"
      "no Result to carry. Left total deliberately rather than for symmetry: a"
      "database would make this fallible, but it has a single caller and that"
      "caller already sits inside a Result, so the change costs one line there"
      "rather than the restructuring a total get or has would have cost."
    Map.len(store.entries)

verify size
    size(fixture([])) => 0
    size(fixture([("a", "b")])) => 1

fn fixture(pairs: List<Tuple<String, String>>) -> Store
    ? "A Store holding exactly these pairs, for verify blocks in other modules."
      "An opaque Store cannot be built from outside, and functions elsewhere that"
      "take one still have to be checked, so the seam supplies the fixture rather"
      "than leaving each caller to invent a representation it should not know."
      "It touches no disk. The path is empty because nothing here writes; a Store"
      "made this way is for reading in a verify block and nothing else, and an"
      "implementation backed by a database would open a scratch handle instead."
    Store(path = "", entries = Map.fromList(pairs))

verify fixture
    size(fixture([])) => 0
    size(fixture([("a", "b"), ("c", "d")])) => 2
    get(fixture([("a", "b")]), "a") => Result.Ok(Option.Some("b"))

fn put(store: Store, key: String, value: String) -> Result<Store, String>
    ? "Record one key, appending to the log before believing it in memory."
      "Convenience for a single change. Anything in bulk should go through"
      "putAll: this returns a Store, and returning one costs a copy of every"
      "entry it holds, so a loop over put is quadratic in the size of the Store."
    ! [Disk.appendText]
    putAll(store, [Entry(key = key, value = value)])

fn putAll(store: Store, entries: List<Entry>) -> Result<Store, String>
    ? "Record several keys in one append, which is as close to atomic as Disk gets."
      "Aver cannot flush or fence, so a batch is one appendText call rather than a"
      "transaction: it either reaches the file or it does not, and a torn tail is"
      "discarded on the next open."
    ! [Disk.appendText]
    records = recordsFor(entries)?
    _written = appended(store.path, records)?
    Result.Ok(Store(path = store.path, entries = absorbAll(entries, store.entries)))

fn delete(store: Store, key: String) -> Result<Store, String>
    ? "Forget one key, leaving a tombstone in the log so a replay forgets it too."
      "Pruning needs this: a Block whose Segment was deleted must have no Location"
      "entry, or the Prune Watermark could not tell a discarded Block from one"
      "that never arrived."
    ! [Disk.appendText]
    tombstone = deleteRecordFor(key)?
    _written = appended(store.path, tombstone)?
    Result.Ok(Store(path = store.path, entries = Map.remove(store.entries, key)))

fn deleteAll(store: Store, keys: List<String>) -> Result<Store, String>
    ? "Forget several keys in one append, as putAll records several in one."
      "Pruning drops the Location of every Block in a deleted Segment, which is"
      "tens of thousands of keys at once. delete hands back a Store and handing"
      "one back copies every entry it holds, so a loop over delete is quadratic"
      "in the size of the Store rather than in the size of the change."
    ! [Disk.appendText]
    records = deleteRecordsFor(keys)?
    _written = appended(store.path, records)?
    Result.Ok(Store(path = store.path, entries = forgetAll(keys, store.entries)))

fn deleteRecordsFor(keys: List<String>) -> Result<String, String>
    ? "The log text for a batch of tombstones, or the first key that cannot be stored."
    parts = deletePartsFor(keys, [])?
    Result.Ok(String.join(parts, ""))

verify deleteRecordsFor
    deleteRecordsFor([]) => Result.Ok("")
    deleteRecordsFor(["a"]) => Result.Ok("-a\n")
    deleteRecordsFor(["a", "b"]) => Result.Ok("-a\n-b\n")
    deleteRecordsFor([""]) => Result.Err("Store key must not be empty or contain a tab or newline, got ''")

fn deletePartsFor(keys: List<String>, acc: List<String>) -> Result<List<String>, String>
    ? "One tombstone per key, in order."
    match keys
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> nextTombstone(head, tail, acc)

verify deletePartsFor
    deletePartsFor([], []) => Result.Ok([])
    deletePartsFor(["a"], []) => Result.Ok(["-a\n"])
    deletePartsFor([""], []) => Result.Err("Store key must not be empty or contain a tab or newline, got ''")

fn nextTombstone(head: String, tail: List<String>, acc: List<String>) -> Result<List<String>, String>
    ? "Encode one tombstone and continue with the rest."
    text = deleteRecordFor(head)?
    deletePartsFor(tail, List.prepend(text, acc))

verify nextTombstone
    nextTombstone("a", [], []) => Result.Ok(["-a\n"])
    nextTombstone("", [], []) => Result.Err("Store key must not be empty or contain a tab or newline, got ''")

fn forgetAll(keys: List<String>, into: Map<String, String>) -> Map<String, String>
    ? "Remove the same keys from the in-memory map."
      "Map.remove appears in the recursive call rather than behind a helper, for"
      "the reason replayApplied gives: a Map handed back from a function is copied."
    match keys
        [] -> into
        [head, ..tail] -> forgetAll(tail, Map.remove(into, head))

verify forgetAll
    forgetAll([], empty()) => empty()
    forgetAll(["a"], Map.set(empty(), "a", "b")) => empty()
    Map.len(forgetAll(["a"], Map.set(Map.set(empty(), "a", "b"), "c", "d"))) => 1

fn compact(store: Store) -> Result<Store, String>
    ? "Rewrite the log as one put per surviving key, discarding overwrites and tombstones."
      "The one place the whole file is rewritten, done deliberately and rarely"
      "rather than on every put. A log-structured store calls this compaction and"
      "does it in the background; here the caller chooses the moment."
    ! [Disk.writeText]
    records = recordsFor(asEntries(Map.entries(store.entries), []))?
    _rewritten = Disk.writeText(store.path, records)?
    Result.Ok(store)

fn asEntries(pairs: List<Tuple<String, String>>, acc: List<Entry>) -> List<Entry>
    ? "The Store's contents as Entries, ready to be written back."
    match pairs
        [] -> List.reverse(acc)
        [head, ..tail] -> asEntries(tail, List.prepend(entryOf(head), acc))

verify asEntries
    asEntries([], []) => []
    asEntries([("a", "b")], []) => [Entry(key = "a", value = "b")]

fn entryOf(pair: Tuple<String, String>) -> Entry
    ? "One key and value from the map."
    match pair
        (key, value) -> Entry(key = key, value = value)

verify entryOf
    entryOf(("a", "b")) => Entry(key = "a", value = "b")

fn appended(path: String, records: String) -> Result<Unit, String>
    ? "Put the records on the end of the log."
    ! [Disk.appendText]
    Disk.appendText(path, records)

fn absorbAll(entries: List<Entry>, into: Map<String, String>) -> Map<String, String>
    ? "Apply the same entries to the in-memory map, in the order they were logged."
    match entries
        [] -> into
        [head, ..tail] -> absorbAll(tail, Map.set(into, head.key, head.value))

verify absorbAll
    absorbAll([], empty()) => empty()
    absorbAll([Entry(key = "a", value = "b")], empty()) => Map.set(empty(), "a", "b")
    Map.get(absorbAll([Entry(key = "a", value = "b"), Entry(key = "a", value = "c")], empty()), "a") => Option.Some("c")

fn recordsFor(entries: List<Entry>) -> Result<String, String>
    ? "The log text for a batch, or the first entry that cannot be stored."
      "Joined at the end rather than concatenated as it goes: repeated `acc + text`"
      "copies the whole accumulator each time, which took 4.1 seconds for 80000"
      "short pieces where one join takes milliseconds."
    parts = recordPartsFor(entries, [])?
    Result.Ok(String.join(parts, ""))

verify recordsFor
    recordsFor([]) => Result.Ok("")
    recordsFor([Entry(key = "a", value = "b")]) => Result.Ok("+a\tb\n")
    recordsFor([Entry(key = "a", value = "b"), Entry(key = "c", value = "d")]) => Result.Ok("+a\tb\n+c\td\n")
    recordsFor([Entry(key = "a\tb", value = "c")]) => Result.Err("Store key must not be empty or contain a tab or newline, got 'a\tb'")

fn recordPartsFor(entries: List<Entry>, acc: List<String>) -> Result<List<String>, String>
    ? "One log record per entry, in order."
    match entries
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> nextRecord(head, tail, acc)

verify recordPartsFor
    recordPartsFor([], []) => Result.Ok([])
    recordPartsFor([Entry(key = "a", value = "b")], []) => Result.Ok(["+a\tb\n"])
    recordPartsFor([Entry(key = "", value = "b")], []) => Result.Err("Store key must not be empty or contain a tab or newline, got ''")

fn nextRecord(head: Entry, tail: List<Entry>, acc: List<String>) -> Result<List<String>, String>
    ? "Encode one entry and continue with the rest."
    text = putRecordFor(head.key, head.value)?
    recordPartsFor(tail, List.prepend(text, acc))

verify nextRecord
    nextRecord(Entry(key = "a", value = "b"), [], []) => Result.Ok(["+a\tb\n"])
    nextRecord(Entry(key = "", value = "b"), [], []) => Result.Err("Store key must not be empty or contain a tab or newline, got ''")

fn keyRefused(key: String) -> String
    ? "Why a key cannot be used, in the one wording every entry point gives."
      "Reads and writes reject the same keys, so they say so the same way; a"
      "caller that learns the rule from a put should recognise it from a get."
    "Store key must not be empty or contain a tab or newline, got '{key}'"

verify keyRefused
    keyRefused("") => "Store key must not be empty or contain a tab or newline, got ''"
    keyRefused("a\tb") => "Store key must not be empty or contain a tab or newline, got 'a\tb'"

fn putRecordFor(key: String, value: String) -> Result<String, String>
    ? "A put record, once the key and value are known to survive the log format."
    match usableKey(key)
        false -> Result.Err(keyRefused(key))
        true -> withKey(key, value)

verify putRecordFor
    putRecordFor("a", "b") => Result.Ok("+a\tb\n")
    putRecordFor("a", "") => Result.Ok("+a\t\n")
    putRecordFor("", "b") => Result.Err("Store key must not be empty or contain a tab or newline, got ''")
    putRecordFor("a", "b\nc") => Result.Err("Store value must not contain a tab or newline, got 'b\nc'")

fn withKey(key: String, value: String) -> Result<String, String>
    ? "The key was usable; the value still has to be."
    match usableValue(value)
        false -> Result.Err("Store value must not contain a tab or newline, got '{value}'")
        true -> Result.Ok("+{key}\t{value}\n")

verify withKey
    withKey("a", "b") => Result.Ok("+a\tb\n")
    withKey("a", "b\tc") => Result.Err("Store value must not contain a tab or newline, got 'b\tc'")

fn deleteRecordFor(key: String) -> Result<String, String>
    ? "A tombstone record for a key."
    match usableKey(key)
        false -> Result.Err(keyRefused(key))
        true -> Result.Ok("-{key}\n")

verify deleteRecordFor
    deleteRecordFor("a") => Result.Ok("-a\n")
    deleteRecordFor("") => Result.Err("Store key must not be empty or contain a tab or newline, got ''")

fn usableKey(key: String) -> Bool
    ? "A key must be present and must not disturb the record format."
    match String.len(key) > 0
        false -> false
        true -> usableValue(key)

verify usableKey
    usableKey("b:aa") => true
    usableKey("") => false
    usableKey("a\tb") => false
    usableKey("a\nb") => false

fn usableValue(value: String) -> Bool
    ? "Records are one line with one separator, so neither may appear in the text."
      "Every key and value the Index uses is hexadecimal, digits or a colon, so"
      "this rejects nothing the program itself produces."
    match String.contains(value, "\t")
        true -> false
        false -> String.contains(value, "\n") == false

verify usableValue
    usableValue("7:1234") => true
    usableValue("") => true
    usableValue("a\tb") => false
    usableValue("a\nb") => false

fn replayed(records: List<String>, into: Map<String, String>) -> Result<Map<String, String>, String>
    ? "Read the log into a Map, one record at a time, so a later record wins."
      "This was two passes until 17 August 2026, because threading a Map through"
      "a Result-returning recursion used to be quadratic while either half alone"
      "was linear. jasisz/aver#961 closed that. Measured on the shape this file"
      "has, compiled: fused and split now agree at every size tried, 41 ms"
      "against 45 at 40000 records and 216 against 219 at 160000. The"
      "intermediate list of Changes bought nothing and is gone."
      "What has not changed is where Map.set may appear. See replayApplied."
    match records
        [] -> Result.Ok(into)
        [head, ..tail] -> replayNext(head, tail, into)

verify replayed
    replayed([], empty()) => Result.Ok(empty())
    replayed(["+a\tb"], empty()) => Result.Ok(Map.set(empty(), "a", "b"))
    replayed(["+a\tb", "-a"], empty()) => Result.Ok(empty())
    replayed(["+a\tb", "+a\tc"], empty()) => Result.Ok(Map.set(empty(), "a", "c"))
    replayed(["nope"], empty()) => Result.Err("Store log record is neither a put nor a delete: 'nope'")

fn replayNext(head: String, tail: List<String>, into: Map<String, String>) -> Result<Map<String, String>, String>
    ? "Parse one record, then apply it and continue."
    parsed = parseOne(head)?
    replayApplied(parsed, tail, into)

verify replayNext
    replayNext("+a\tb", [], empty()) => Result.Ok(Map.set(empty(), "a", "b"))
    replayNext("bad", [], empty()) => Result.Err("Store log record is neither a put nor a delete: 'bad'")
    replayNext("", [], empty()) => Result.Err("Store log record is neither a put nor a delete: ''")

fn replayApplied(change: Change, tail: List<String>, into: Map<String, String>) -> Result<Map<String, String>, String>
    ? "A put sets a key and a tombstone forgets one, each continuing by tail call."
      "Map.set and Map.remove appear directly in the tail call, and no helper here"
      "hands a Map back. jasisz/aver#890 is open: a Map returned from a function"
      "is copied, so a fold routed through one costs quadratic time. Re-measured"
      "compiled on 17 August 2026 at 80000 entries: 48 ms with the insert inline,"
      "49 ms branching first as this does, 105633 ms through a helper. That is why"
      "this branches into a third function rather than calling a fourth."
    match change
        Change.Put(entry) -> replayed(tail, Map.set(into, entry.key, entry.value))
        Change.Drop(key) -> replayed(tail, Map.remove(into, key))

verify replayApplied
    replayApplied(Change.Put(Entry(key = "a", value = "b")), [], empty()) => Result.Ok(Map.set(empty(), "a", "b"))
    replayApplied(Change.Drop("a"), [], Map.set(empty(), "a", "b")) => Result.Ok(empty())
    replayApplied(Change.Put(Entry(key = "a", value = "b")), ["nope"], empty()) => Result.Err("Store log record is neither a put nor a delete: 'nope'")

fn parseOne(line: String) -> Result<Change, String>
    ? "A record is a put or a tombstone, told apart by its first character."
    body = String.slice(line, 1, String.len(line))
    match String.slice(line, 0, 1)
        "+" -> parsePut(line, String.split(body, "\t"))
        "-" -> Result.Ok(Change.Drop(body))
        _ -> Result.Err("Store log record is neither a put nor a delete: '{line}'")

verify parseOne
    parseOne("+a\tb") => Result.Ok(Change.Put(Entry(key = "a", value = "b")))
    parseOne("-a") => Result.Ok(Change.Drop("a"))
    parseOne("") => Result.Err("Store log record is neither a put nor a delete: ''")
    parseOne("+a") => Result.Err("Store log put has no separator: '+a'")

fn parsePut(line: String, parts: List<String>) -> Result<Change, String>
    ? "A put carries a key and a value, separated once."
    match parts
        [] -> Result.Err("Store log put has no separator: '{line}'")
        [key, ..rest] -> withParsedKey(line, key, rest)

verify parsePut
    parsePut("+a\tb", ["a", "b"]) => Result.Ok(Change.Put(Entry(key = "a", value = "b")))
    parsePut("+a", ["a"]) => Result.Err("Store log put has no separator: '+a'")
    parsePut("+", []) => Result.Err("Store log put has no separator: '+'")
    parsePut("", []) => Result.Err("Store log put has no separator: ''")

fn withParsedKey(line: String, key: String, rest: List<String>) -> Result<Change, String>
    ? "Everything after the separator is the value."
    match rest
        [] -> Result.Err("Store log put has no separator: '{line}'")
        [value, ..extra] -> Result.Ok(Change.Put(Entry(key = key, value = value)))

verify withParsedKey
    withParsedKey("+a\tb", "a", ["b"]) => Result.Ok(Change.Put(Entry(key = "a", value = "b")))
    withParsedKey("+a", "a", []) => Result.Err("Store log put has no separator: '+a'")
