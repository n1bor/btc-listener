module TxIndex
    intent =
        "Recording where each Transaction lives, so one can be found by its Id."
        "The Index knows Heights and Blocks. Nothing in it can answer 'where is"
        "this Transaction', which is the question every spend asks: an Input"
        "names the Output it spends by Transaction Id, and without this that"
        "means reading the whole chain to find one Transaction."
        "Built over a range of Heights rather than all of them, deliberately. The"
        "chain holds well over a billion Transactions and Infra.Store keeps every"
        "entry in memory, so a whole-chain Transaction index is exactly the case"
        "its own intent says it cannot back. Over a range it is useful now, and"
        "the keyspace is the one a real database would be given."
        "Blocks are read through Infra.Blocks.read, one positional read each,"
        "which the binary Segments make as cheap as holding one open."
        "Entries are held back and written in batches. A Store hands back a copy"
        "of itself, so one putAll per Block costs the size of the whole Index per"
        "Block: indexing thirty thousand Blocks that way took fourteen minutes"
        "for thirty thousand Transactions. The batch is counted in entries rather"
        "than in Blocks, because a Block near the tip holds several thousand"
        "Transactions and one near genesis holds one."
        "Infra.StoreLog is a dependency this module has no use for. Entry is"
        "declared there and re-exposed by Infra.Store, and a re-exposed type"
        "resolves for the module being checked and not for one reached as a"
        "dependency. That is jasisz/aver#992; when it closes this line goes."
    exposes [Built, build]
    depends [Domain.Block, Domain.Index, Infra.Blocks, Infra.Chain, Infra.Store, Infra.StoreLog]
    effects [Disk.appendText, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll]

record Built
    blocks: Int
    transactions: Int

record Walk
    store: Store
    blocks: BlockStore
    pending: List<Entry>
    waiting: Int
    counted: Built

fn batchSize() -> Int
    ? "How many entries to hold before writing them."
      "Large enough that the Store is copied rarely, small enough that what is"
      "held is bounded whatever a Block turns out to contain."
    20000

verify batchSize
    batchSize() => 20000

fn build(store: Store, blocks: BlockStore, from: Int, to: Int) -> Result<Built, String>
    ? "Record every Transaction in a range of Heights against where it sits."
      "A Height whose body is absent is stepped over rather than refused: the"
      "range is what the caller asked for, and what is held inside it is what"
      "there is to index."
    ! [Disk.appendText, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll]
    walked = walk(Walk(store = store, blocks = blocks, pending = [], waiting = 0, counted = Built(blocks = 0, transactions = 0)), from, to)?
    _flushed = flushed(walked)?
    Result.Ok(walked.counted)

fn flushed(state: Walk) -> Result<Store, String>
    ? "Write whatever is still held back."
      "The accumulator is built by prepending, so it is turned round here rather"
      "than concatenated on every Block, which would cost the batch twice over."
    ! [Disk.appendText, Infra.Kv.putAll]
    Infra.Store.putAll(state.store, List.reverse(state.pending))

fn walk(state: Walk, height: Int, to: Int) -> Result<Walk, String>
    ? "Each Height in turn."
    ! [Disk.appendText, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll]
    match height > to
        true -> Result.Ok(state)
        false -> atHeight(state, height, to)

fn atHeight(state: Walk, height: Int, to: Int) -> Result<Walk, String>
    ? "A Height the Index does not name ends the range early."
    ! [Disk.appendText, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll]
    named = Infra.Store.get(state.store, Domain.Index.heightKey(height))?
    match named
        Option.None -> Result.Ok(state)
        Option.Some(blockId) -> atBlock(state, height, to, blockId)

fn atBlock(state: Walk, height: Int, to: Int, blockId: String) -> Result<Walk, String>
    ? "A Block whose body is not held has no Transactions to record."
    ! [Disk.appendText, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll]
    located = Infra.Store.get(state.store, Domain.Index.blockKey(blockId))?
    match located
        Option.None -> walk(state, height + 1, to)
        Option.Some(text) -> indexBody(state, height, to, blockId, text)

fn indexBody(state: Walk, height: Int, to: Int, blockId: String, text: String) -> Result<Walk, String>
    ? "Read the Block and write one entry per Transaction it holds."
    ! [Disk.appendText, Disk.readBytesAt, Infra.Kv.get, Infra.Kv.putAll]
    location = Domain.Index.decodeLocation(text)?
    payload = Infra.Blocks.read(state.blocks, location)?
    transactions = Domain.Block.transactionsOf(payload)?
    entries = sitesFor(Domain.Block.txidsOf(transactions), blockId, 0, List.prepend(heightEntry(blockId, height), state.pending))
    added = List.len(transactions)
    carried = Walk(store = state.store, blocks = state.blocks, pending = entries, waiting = state.waiting + added + 1, counted = Built(blocks = state.counted.blocks + 1, transactions = state.counted.transactions + added))
    recorded = maybeWrite(carried)?
    walk(recorded, height + 1, to)

fn maybeWrite(state: Walk) -> Result<Walk, String>
    ? "Write the batch once it is big enough, and start a new one."
    ! [Disk.appendText, Infra.Kv.putAll]
    match state.waiting >= batchSize()
        false -> Result.Ok(state)
        true -> written(state)

fn written(state: Walk) -> Result<Walk, String>
    ? "One putAll for everything held back."
    ! [Disk.appendText, Infra.Kv.putAll]
    grown = flushed(state)?
    Result.Ok(Walk(store = grown, blocks = state.blocks, pending = [], waiting = 0, counted = state.counted))

fn heightEntry(blockId: String, height: Int) -> Entry
    ? "This Block sits at this Height, written the one place that can say so."
      "The walk holds both halves already -- it reached the Block by asking h:"
      "which Block is at this Height -- so recording the reverse costs one entry"
      "per Block against the several thousand Transaction entries beside it."
      "It belongs here rather than with the Headers because it has to be as"
      "fresh as t: is: a Transaction found by its Id is found through an entry"
      "this phase wrote, and the Height it is judged at should have been written"
      "by the same pass over the same Block."
    Entry(key = Domain.Index.blockHeightKey(blockId), value = Domain.Index.encodeHeight(height))

verify heightEntry
    heightEntry("aa", 0) => Entry(key = "n:aa", value = "0")
    heightEntry("aa", 300000) => Entry(key = "n:aa", value = "300000")

fn sitesFor(txids: List<String>, blockId: String, position: Int, acc: List<Entry>) -> List<Entry>
    ? "One entry per Transaction: this Id sits at this place in this Block."
      "Prepends onto whatever is already waiting and does not turn the result"
      "round; the batch is reversed once, when it is written."
    match txids
        [] -> acc
        [head, ..tail] -> sitesFor(tail, blockId, position + 1, List.prepend(Entry(key = Domain.Index.txKey(head), value = Domain.Index.encodeTxSite(Domain.Index.TxSite(blockId = blockId, position = position))), acc))

verify sitesFor
    sitesFor([], "aa", 0, []) => []
    sitesFor(["cc"], "aa", 0, []) => [Entry(key = "t:cc", value = "aa:0")]
    List.reverse(sitesFor(["cc", "dd"], "aa", 0, [])) => [Entry(key = "t:cc", value = "aa:0"), Entry(key = "t:dd", value = "aa:1")]
    sitesFor(["cc"], "aa", 7, []) => [Entry(key = "t:cc", value = "aa:7")]
    List.len(sitesFor(["cc"], "aa", 0, [Entry(key = "t:zz", value = "aa:9")])) => 2
