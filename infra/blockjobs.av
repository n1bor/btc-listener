module BlockJobs
    kind = capability
    semantics = effectful
    intent =
        "The arithmetic of a Block, done somewhere the loop is not."
        "Decoding a Block and working out what it spends is the one thing"
        "this node does that takes long enough for a Peer to notice, and it"
        "needs nothing but the bytes. So it is a capability: begin hands"
        "over a Task, take collects the answer, and in between the loop"
        "goes on reading its Peers and answering their pings."
        "A job kind may name the types of the modules it depends on"
        "(jasisz/aver#1401), so a Task carries Domain.Transaction's"
        "Transactions and Domain.UtxoStore's coins as they are, and a Reply"
        "carries Domain.Connect's Change. Their layouts are part of this"
        "contract's hash: a field added to any of them is a new contract."
        "Nothing but data crosses this. No socket, no Store, no write: the"
        "answer goes back to the owner and the owner applies it, which is"
        "the single writer ADR 0008 asks for."
    depends [Bytes, Work, Domain.Connect, Domain.Network, Domain.Transaction, Domain.UtxoStore]
    exposes [Task, Reply, begin, take]

type Task
    Decode(Bytes)
    Connect(Domain.Network.Network, Int, List<Domain.Transaction.Transaction>, Map<Bytes, Domain.UtxoStore.Unspent>, List<Bytes>)

type Reply
    Decoded(List<Domain.Transaction.Transaction>)
    Connected(Domain.Connect.Change)
    Refused(String)

operation begin(task: Task) -> Result<Work.Job, String>
    ? "Start one pure calculation without waiting for its answer."
    oracle = generativeOutput
    replay = recorded

operation take(job: Work.Job) -> Result<Option<Reply>, String>
    ? "Collect one answer, or None while the calculation is still running."
    oracle = generativeOutput
    replay = recorded
