module Prune
    intent =
        "Deleting the Blocks below a Height, and recording that it was deliberate."
        "Three things have to happen together or the Index starts lying. The"
        "Segments go, the Locations naming Blocks inside them go, and the Prune"
        "Watermark rises to say that what is now absent below it was discarded"
        "rather than never fetched. Doing the first without the second leaves the"
        "Index pointing into files that are gone; doing either without the third"
        "leaves nothing able to tell a pruned Block from a missing one."
        "Which Segments may go is found by looking rather than by assuming. A"
        "Segment is a unit of deletion and holds many Blocks, and Blocks are"
        "appended in the order they were fetched rather than in Height order, so"
        "a range fetched out of order can put a low Height in a high Segment. The"
        "floor is therefore the lowest Segment any surviving Height sits in, not"
        "the Segment the Height happens to land in."
        "The Segment currently being appended to is never deleted. It is where"
        "the next Block goes, and Blocks.open resumes from the highest Segment"
        "present, so removing it would move the append point backwards."
    exposes [Pruned, run]
    depends [Bytes, Domain.Index, Domain.IndexKeys, Infra.Blocks, Infra.Chain, Infra.Store]
    effects [
        Disk.appendText, Disk.delete, Disk.exists,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.getAll, Infra.Kv.putAll,
    ]

record Pruned
    segments: Int
    locations: Int
    watermark: Int

record Sweep
    store: Store
    below: Int
    floor: Int

fn run(store: Store, blocks: BlockStore, below: Int) -> Result<Pruned, String>
    ? "Delete what only holds Blocks below a Height, and record the Watermark."
      "The Segments go first. A crash after that leaves Locations naming files"
      "that are gone, which reads as a corrupt Index; the other order leaves"
      "Blocks on disk that nothing names, which merely wastes the space pruning"
      "was trying to reclaim. Neither is good and the second is recoverable, so"
      "the Watermark is written last and the whole thing is safe to run again."
    ! [Disk.delete, Disk.exists, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.getAll, Infra.Kv.putAll]
    watermark = watermarkFor(store, below)?
    floor = floorSegment(store, watermark, Infra.Blocks.currentSegment(blocks))?
    segments = Infra.Blocks.prune(blocks, floor)?
    keys = locationsBelow(Sweep(store = store, below = watermark, floor = floor), 0, [])?
    swept = Infra.Store.deleteAll(store, keys)?
    _marked = Infra.Store.put(swept, Domain.IndexKeys.prunedBelowKey()?, Domain.Index.encodeHeight(watermark))?
    Result.Ok(Pruned(segments = segments, locations = List.len(keys), watermark = watermark))

fn watermarkFor(store: Store, below: Int) -> Result<Int, String>
    ? "The Prune Watermark only ever rises."
      "Pruning below a Height already pruned past would otherwise lower it, and"
      "a lowered Watermark reports Blocks that were discarded on purpose as ones"
      "that simply never arrived. Nothing can put them back, so nothing should"
      "be able to forget that they went."
    ! [Infra.Kv.get]
    existing = Infra.Chain.watermark(store)?
    Result.Ok(higher(existing, below))

verify watermarkFor
    watermarkFor(Infra.Store.fixture([]), 100) => Result.Ok(100)
    watermarkFor(Infra.Store.fixture([(Domain.IndexKeys.prunedBelowKey()?, Domain.Index.encodeHeight(500))]), 100) => Result.Ok(500)
    watermarkFor(Infra.Store.fixture([(Domain.IndexKeys.prunedBelowKey()?, Domain.Index.encodeHeight(100))]), 500) => Result.Ok(500)
    watermarkFor(Infra.Store.fixture([(Domain.IndexKeys.prunedBelowKey()?, Domain.Index.emptyBytes())]), 100) => Result.Err("a Height record is 4 bytes, got 0")

fn higher(a: Int, b: Int) -> Int
    ? "The larger of two Heights."
    match a >= b
        true -> a
        false -> b

verify higher
    higher(5, 3) => 5
    higher(3, 5) => 5

fn floorSegment(store: Store, below: Int, current: Int) -> Result<Int, String>
    ? "The lowest Segment that has to survive."
      "Everything beneath it holds only Blocks below the Height, so deleting it"
      "loses nothing that is being kept. Bounded by the Segment in hand, so that"
      "an Index naming no Height at or above the Watermark still does not delete"
      "the file the next Block is going into."
    ! [Infra.Kv.get]
    lowestAtOrAbove(store, below, current)

verify floorSegment
    floorSegment(Infra.Store.fixture([]), 5, 9) => Result.Ok(9)
    floorSegment(Infra.Store.fixture([(Domain.IndexKeys.heightKey(5)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.encodeLocation(Domain.Index.Location(segment = 3, offset = 0, length = 80)))]), 5, 9) => Result.Ok(3)
    floorSegment(Infra.Store.fixture([(Domain.IndexKeys.heightKey(5)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.emptyBytes())]), 5, 9) => Result.Err("a Location record is 16 bytes, got 0")

fn lowestAtOrAbove(store: Store, height: Int, best: Int) -> Result<Int, String>
    ? "Walk the Heights the Index still names, keeping the lowest Segment used."
      "Stops at the first Height with no Block Id, because the Index names a"
      "prefix of the chain and there is nothing above the end of it."
    ! [Infra.Kv.get]
    named = Domain.Index.blockIdIn(Infra.Store.get(store, Domain.IndexKeys.heightKey(height)?)?)
    match named
        Option.None -> Result.Ok(best)
        Option.Some(blockId) -> lowestWith(store, height, blockId, best)

verify lowestAtOrAbove
    lowestAtOrAbove(Infra.Store.fixture([]), 0, 4) => Result.Ok(4)
    lowestAtOrAbove(Infra.Store.fixture([(Domain.IndexKeys.heightKey(0)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.encodeLocation(Domain.Index.Location(segment = 1, offset = 0, length = 80)))]), 0, 4) => Result.Ok(1)
    lowestAtOrAbove(Infra.Store.fixture([(Domain.IndexKeys.heightKey(0)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.emptyBytes())]), 0, 4) => Result.Err("a Location record is 16 bytes, got 0")

fn lowestWith(store: Store, height: Int, blockId: String, best: Int) -> Result<Int, String>
    ? "A Height the Index names: lower the answer only if its Block is held."
    ! [Infra.Kv.get]
    located = Infra.Store.get(store, Domain.IndexKeys.blockKey(blockId)?)?
    match located
        Option.None -> lowestAtOrAbove(store, height + 1, best)
        Option.Some(text) -> lowerBy(store, height, text, best)

verify lowestWith
    lowestWith(Infra.Store.fixture([]), 0, "aa", 4) => Result.Ok(4)
    lowestWith(Infra.Store.fixture([(Domain.IndexKeys.blockKey("aa")?, Domain.Index.encodeLocation(Domain.Index.Location(segment = 1, offset = 0, length = 80)))]), 0, "aa", 4) => Result.Ok(1)
    lowestWith(Infra.Store.fixture([(Domain.IndexKeys.blockKey("aa")?, Domain.Index.emptyBytes())]), 0, "aa", 4) => Result.Err("a Location record is 16 bytes, got 0")

fn lowerBy(store: Store, height: Int, stored: Bytes, best: Int) -> Result<Int, String>
    ? "The Block is held, so the Segment holding it cannot be deleted."
    ! [Infra.Kv.get]
    location = Domain.Index.decodeLocation(stored)?
    lowestAtOrAbove(store, height + 1, lower(best, location.segment))

verify lowerBy
    lowerBy(Infra.Store.fixture([]), 0, Domain.Index.encodeLocation(Domain.Index.Location(segment = 1, offset = 0, length = 80)), 4) => Result.Ok(1)
    lowerBy(Infra.Store.fixture([]), 0, Domain.Index.encodeLocation(Domain.Index.Location(segment = 7, offset = 0, length = 80)), 4) => Result.Ok(4)
    lowerBy(Infra.Store.fixture([]), 0, Domain.Index.emptyBytes(), 4) => Result.Err("a Location record is 16 bytes, got 0")

fn lower(a: Int, b: Int) -> Int
    ? "The smaller of two Segment numbers."
    match a <= b
        true -> a
        false -> b

verify lower
    lower(3, 5) => 3
    lower(5, 3) => 3

fn locationsBelow(sweep: Sweep, height: Int, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "The b: keys naming Blocks that the deleted Segments were holding."
      "Only Heights below the Watermark are examined: a Height at or above it"
      "sits at or above the floor by the way the floor was chosen, so its"
      "Location was never in a deleted Segment."
    ! [Infra.Kv.get]
    match height >= sweep.below
        true -> Result.Ok(List.reverse(acc))
        false -> locationAt(sweep, height, acc)

verify locationsBelow
    locationsBelow(Sweep(store = Infra.Store.fixture([]), below = 0, floor = 1), 0, []) => Result.Ok([])
    locationsBelow(Sweep(store = Infra.Store.fixture([(Domain.IndexKeys.heightKey(0)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.encodeLocation(Domain.Index.Location(segment = 0, offset = 0, length = 80)))]), below = 1, floor = 1), 0, []) => Result.Ok([Domain.IndexKeys.blockKey("aa")?])
    locationsBelow(Sweep(store = Infra.Store.fixture([(Domain.IndexKeys.heightKey(0)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.encodeLocation(Domain.Index.Location(segment = 5, offset = 0, length = 80)))]), below = 1, floor = 1), 0, []) => Result.Ok([])
    locationsBelow(Sweep(store = Infra.Store.fixture([(Domain.IndexKeys.heightKey(0)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.emptyBytes())]), below = 1, floor = 1), 0, []) => Result.Err("a Location record is 16 bytes, got 0")

fn locationAt(sweep: Sweep, height: Int, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "A Height with no Block Id names nothing to forget."
      "Unlike the walk that finds the floor, this one does not stop at a gap: a"
      "Height the Index has lost still leaves the Heights above it to sweep."
    ! [Infra.Kv.get]
    named = Domain.Index.blockIdIn(Infra.Store.get(sweep.store, Domain.IndexKeys.heightKey(height)?)?)
    match named
        Option.None -> locationsBelow(sweep, height + 1, acc)
        Option.Some(blockId) -> locationOf(sweep, height, blockId, acc)

verify locationAt
    locationAt(Sweep(store = Infra.Store.fixture([]), below = 1, floor = 1), 0, []) => Result.Ok([])
    locationAt(Sweep(store = Infra.Store.fixture([(Domain.IndexKeys.heightKey(0)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.encodeLocation(Domain.Index.Location(segment = 0, offset = 0, length = 80)))]), below = 1, floor = 1), 0, []) => Result.Ok([Domain.IndexKeys.blockKey("aa")?])
    locationAt(Sweep(store = Infra.Store.fixture([(Domain.IndexKeys.heightKey(0)?, Domain.Index.encodeBlockId("aa")?), (Domain.IndexKeys.blockKey("aa")?, Domain.Index.emptyBytes())]), below = 1, floor = 1), 0, []) => Result.Err("a Location record is 16 bytes, got 0")

fn locationOf(sweep: Sweep, height: Int, blockId: String, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "A Block Id with no Location has nothing on disk to have lost."
    ! [Infra.Kv.get]
    located = Infra.Store.get(sweep.store, Domain.IndexKeys.blockKey(blockId)?)?
    match located
        Option.None -> locationsBelow(sweep, height + 1, acc)
        Option.Some(text) -> keepIfGone(sweep, height, blockId, text, acc)

verify locationOf
    locationOf(Sweep(store = Infra.Store.fixture([]), below = 1, floor = 1), 0, "aa", []) => Result.Ok([])
    locationOf(Sweep(store = Infra.Store.fixture([(Domain.IndexKeys.blockKey("aa")?, Domain.Index.encodeLocation(Domain.Index.Location(segment = 0, offset = 0, length = 80)))]), below = 1, floor = 1), 0, "aa", []) => Result.Ok([Domain.IndexKeys.blockKey("aa")?])
    locationOf(Sweep(store = Infra.Store.fixture([(Domain.IndexKeys.blockKey("aa")?, Domain.Index.emptyBytes())]), below = 1, floor = 1), 0, "aa", []) => Result.Err("a Location record is 16 bytes, got 0")

fn keepIfGone(sweep: Sweep, height: Int, blockId: String, stored: Bytes, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "Forget the Location only if its Segment was one of the deleted ones."
    ! [Infra.Kv.get]
    location = Domain.Index.decodeLocation(stored)?
    locationsBelow(sweep, height + 1, dropped(location.segment, sweep.floor, blockId, acc)?)

verify keepIfGone
    keepIfGone(Sweep(store = Infra.Store.fixture([]), below = 1, floor = 1), 0, "aa", Domain.Index.encodeLocation(Domain.Index.Location(segment = 0, offset = 0, length = 80)), []) => Result.Ok([Domain.IndexKeys.blockKey("aa")?])
    keepIfGone(Sweep(store = Infra.Store.fixture([]), below = 1, floor = 1), 0, "aa", Domain.Index.encodeLocation(Domain.Index.Location(segment = 1, offset = 0, length = 80)), []) => Result.Ok([])
    keepIfGone(Sweep(store = Infra.Store.fixture([]), below = 1, floor = 1), 0, "aa", Domain.Index.emptyBytes(), []) => Result.Err("a Location record is 16 bytes, got 0")

fn dropped(segment: Int, floor: Int, blockId: String, acc: List<Bytes>) -> Result<List<Bytes>, String>
    ? "A Location in a Segment that is gone is a Location to forget."
      "A Result since n1bor/btc-listener#45: building the key can fail, because"
      "a Block Id that is not hexadecimal names no key."
    match segment < floor
        true -> Result.Ok(List.prepend(Domain.IndexKeys.blockKey(blockId)?, acc))
        false -> Result.Ok(acc)

verify dropped
    dropped(0, 1, "aa", []) => Result.Ok([Domain.IndexKeys.blockKey("aa")?])
    dropped(1, 1, "aa", []) => Result.Ok([])
    dropped(5, 1, "aa", []) => Result.Ok([])
    dropped(0, 1, "zz", []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")
