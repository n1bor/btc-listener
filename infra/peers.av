module Peers
    intent =
        "Several Peers on one loop: the sockets, the Handshakes, and the"
        "bytes that arrive on their own schedule rather than on ours."
        "The single-Peer code asked a socket for exactly twenty-four bytes and"
        "then for exactly the payload they announced. With one Peer that is"
        "the clearest thing to write. With several it is the thing that stops"
        "the node: a read of an exact length holds the loop until that length"
        "arrives, and every other Peer waits behind it -- including their"
        "pings, which go unanswered until they drop us."
        "So bytes are taken as they come, kept per Peer, and Messages cut out"
        "of what has accumulated (Domain.Inbox). Readiness comes from one"
        "Tcp.poll over every socket, which is the primitive this stage was"
        "waiting for (jasisz/aver#1013)."
        "The conversation is still written as straight-line code. A caller"
        "that wants an answer from one Peer says so, and while it waits every"
        "other Peer is read, buffered and kept alive. That is the whole trick:"
        "the schedule is the loop's, the question is the caller's, and neither"
        "has to be written in terms of the other."
        "Per ADR 0008 this module is the only thing here that touches a"
        "socket, and it hands values back rather than writing anything down."
    exposes [Pool, Spare, Tick, Waited, WaitedFrom, Accepted, Joined, opened, listening, accepting, inboundLimit, listenerKey, peerKeys, awaitTick, idleDeadlineMs, joined, joinedOnly, awaitFrom, awaitAny, awaitAnyPeer, send, closeAll, dropOne, pumped, answerDeadlineMs, spareOf, withoutSpare, company]
    depends [Bytes, Domain.Address, Domain.Inbox, Domain.Message, Domain.Network, Domain.Snapshot, Domain.Version]
    effects [
        Console.error, Console.print,
        Random.int,
        Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.closeListener, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]

record Spare
    key: Int
    frame: Frame

record Pool
    network: Network
    sockets: Map<Int, Tcp.Socket>
    standing: Map<Int, Standing>
    spare: List<Spare>
    serves: Int
    height: Int
    heardMs: Map<Int, Int>
    anyHeardMs: Int

record Waited
    pool: Pool
    frame: Frame

record WaitedFrom
    pool: Pool
    key: Int
    frame: Frame

record Tick
    pool: Pool
    arrived: Option<Spare>

fn readChunk() -> Int
    ? "How many bytes to take off a ready socket at once."
      "A ceiling rather than a target: Tcp.readSome returns as soon as"
      "anything is there, so this only bounds how much one Peer can hand over"
      "before the loop looks at the others. Sixty-four kilobytes is about"
      "what a socket buffer holds, so a bigger number would rarely be filled"
      "and a much smaller one would cut a Block into needless pieces."
    65536

verify readChunk
    readChunk() => 65536

fn idleDeadlineMs() -> Int
    ? "How long every Peer may be silent before the loop gives up on them."
      "Bitcoin Core pings an otherwise-quiet connection every two minutes, so"
      "two and a half minutes of nothing at all -- from any Peer, not merely"
      "the one being waited on -- means the loop is not connected to anything"
      "that is still talking."
    150000

verify idleDeadlineMs
    idleDeadlineMs() => 150000

fn answerDeadlineMs() -> Int
    ? "How long one Peer may take to answer the question it was asked."
      "Separate from the idle deadline, and the reason is many Peers: a"
      "chatty Peer keeps the loop from ever going idle, so silence from the"
      "whole pool can no longer be what notices a Peer that has stopped"
      "answering. Sixty seconds is far longer than a getheaders or a getdata"
      "takes against Core and far shorter than a Peer that is gone."
    60000

verify answerDeadlineMs
    answerDeadlineMs() => 60000

fn pollable(pool: Pool) -> Map<Int, Tcp.Socket>
    ? "Every socket the wait should watch, which is every Peer and not the"
      "listener."
      "The listener is deliberately left out. A caller queued on it makes it"
      "readable and keeps it readable until somebody accepts, so a poll that"
      "included it would report ready on every turn, and a loop that reads"
      "whatever polled ready would spin on a socket that has no bytes --"
      "never reaching the quiet turn where accepting happens. Leaving it out"
      "makes accepting a thing the loop does on its own schedule rather than"
      "a thing readiness drags it into, at the cost of a caller waiting one"
      "tick to be greeted."
    pollableIn(pool.sockets, peerKeys(pool), Map.fromList([]))

fn pollableIn(sockets: Map<Int, Tcp.Socket>, keys: List<Int>, acc: Map<Int, Tcp.Socket>) -> Map<Int, Tcp.Socket>
    ? "The named sockets, gathered into a map of their own."
    match keys
        [] -> acc
        [head, ..tail] -> pollableIn(sockets, tail, withSocket(acc, head, Map.get(sockets, head)))

verify pollableIn
    Map.len(pollableIn(Map.fromList([]), [], Map.fromList([]))) => 0
    Map.len(pollableIn(Map.fromList([]), [3], Map.fromList([]))) => 0

fn withSocket(acc: Map<Int, Tcp.Socket>, key: Int, socket: Option<Tcp.Socket>) -> Map<Int, Tcp.Socket>
    ? "One socket in, if the key still names one."
    match socket
        Option.None -> acc
        Option.Some(one) -> Map.set(acc, key, one)

verify withSocket
    Map.len(withSocket(Map.fromList([]), 1, Option.None)) => 0

fn company(pool: Pool) -> List<PeerView>
    ? "One row per connected Peer, oldest key first (#168)."
      "The Peers Panel used to be built by the follow loop alone, from the"
      "loop's own record of who had been heard when -- so the header and"
      "body walks, which hold the pool and redraw frames for hours, drew a"
      "Panel with nobody on it. Everything a row needs is in the pool, so"
      "anything holding the pool can build one."
    companyFrom(pool, peerKeys(pool), [])

fn companyFrom(pool: Pool, keys: List<Int>, acc: List<PeerView>) -> List<PeerView>
    ? "Each key in turn."
    match keys
        [] -> List.reverse(acc)
        [head, ..tail] -> companyFrom(pool, tail, List.prepend(rowFor(pool, head), acc))

verify companyFrom
    companyFrom(opened(Network.Regtest), [], []) => []
    List.len(companyFrom(opened(Network.Regtest), [3], [])) => 1
    List.len(companyFrom(opened(Network.Regtest), [3, 4], [])) => 2

fn rowFor(pool: Pool, key: Int) -> PeerView
    ? "What the Snapshot shows of one Peer."
      "A Peer never heard from is shown heard at the moment the pool last"
      "heard anything, which errs towards patience."
    viewOf(key, Domain.Inbox.standingAt(pool.standing, key), Option.withDefault(Map.get(pool.heardMs, key), pool.anyHeardMs))

fn viewOf(key: Int, standing: Option<Standing>, heardMs: Int) -> PeerView
    ? "The Standing folded into a view, or the unknown Peer."
      "A Peer somehow missing from the standing renders as unknown rather"
      "than being invented."
    match standing
        Option.None -> PeerView(key = key, address = "unknown", version = 0, agent = "", lastHeardMs = heardMs, sent = 0, received = 0, inbound = false)
        Option.Some(one) -> PeerView(key = key, address = one.address, version = one.version, agent = one.agent, lastHeardMs = heardMs, sent = one.sent, received = one.received, inbound = one.inbound)

verify viewOf
    viewOf(2, Option.None, 7) => PeerView(key = 2, address = "unknown", version = 0, agent = "", lastHeardMs = 7, sent = 0, received = 0, inbound = false)
    viewOf(2, Option.Some(Standing(address = "1.2.3.4:8333", buffer = [], version = 70016, agent = "/Satoshi/", sent = 120, received = 4096, inbound = false)), 7) => PeerView(key = 2, address = "1.2.3.4:8333", version = 70016, agent = "/Satoshi/", lastHeardMs = 7, sent = 120, received = 4096, inbound = false)
    viewOf(2, Option.Some(Standing(address = "1.2.3.4:8333", buffer = [], version = 70016, agent = "/Satoshi/", sent = 0, received = 0, inbound = true)), 7) => PeerView(key = 2, address = "1.2.3.4:8333", version = 70016, agent = "/Satoshi/", lastHeardMs = 7, sent = 0, received = 0, inbound = true)

fn peerKeys(pool: Pool) -> List<Int>
    ? "Every key that names a Peer, which is every key but the listener's."
      "The pool holds all three socket states in one map now, so anything"
      "that fans a Message out over every key has to leave the listener out"
      "or it will try to speak to a socket that cannot be spoken to. Chosen"
      "by key rather than by matching the socket, because the key is a plain"
      "Int a case can be written about and a Tcp.Socket is a capability"
      "resource that nothing outside the provider can build."
    peerKeysIn(Map.keys(pool.sockets), [])

fn peerKeysIn(keys: List<Int>, acc: List<Int>) -> List<Int>
    ? "One key at a time, keeping the ones that are Peers."
    match keys
        [] -> List.reverse(acc)
        [head, ..tail] -> peerKeysIn(tail, keptIfPeer(head, acc))

verify peerKeysIn
    peerKeysIn([], []) => []
    peerKeysIn([0, 1], []) => [0, 1]
    peerKeysIn([listenerKey(), 0], []) => [0]

fn keptIfPeer(key: Int, acc: List<Int>) -> List<Int>
    ? "A Peer key is not negative; the listener's is."
    match key >= 0
        true -> List.prepend(key, acc)
        false -> acc

verify keptIfPeer
    keptIfPeer(0, []) => [0]
    keptIfPeer(listenerKey(), []) => []

record Accepted
    pool: Pool
    seated: Option<Int>

fn accepting(pool: Pool, key: Int) -> Result<Accepted, String>
    ? "Take one caller off the listener, if one is queued and there is room."
      "Non-blocking by construction (jasisz/aver#1138): None is a legal answer"
      "meaning an empty backlog, so this can be asked on every quiet turn"
      "without a wait of its own. One per turn, deliberately -- a burst of"
      "callers is admitted at the tick rate rather than all at once, which"
      "costs a caller a second and costs a flood its whole point."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.accept, Tcp.close, Tcp.peerAddress, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match Map.get(pool.sockets, listenerKey())
        Option.None -> Result.Ok(Accepted(pool = pool, seated = Option.None))
        Option.Some(socket) -> acceptingOn(pool, key, socket)

fn acceptingOn(pool: Pool, key: Int, socket: Tcp.Socket) -> Result<Accepted, String>
    ? "Only a Listener can be accepted from; the other two states are not"
      "errors here, just nothing to do."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.accept, Tcp.close, Tcp.peerAddress, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match socket
        Tcp.Socket.Listening(listener) -> acceptedFrom(pool, key, Tcp.accept(listener)?)
        Tcp.Socket.Connected(connection) -> Result.Ok(Accepted(pool = pool, seated = Option.None))
        Tcp.Socket.Dialing(dial) -> Result.Ok(Accepted(pool = pool, seated = Option.None))

fn acceptedFrom(pool: Pool, key: Int, taken: Option<Tcp.Connection>) -> Result<Accepted, String>
    ? "Nobody was waiting, or somebody was."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.peerAddress, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match taken
        Option.None -> Result.Ok(Accepted(pool = pool, seated = Option.None))
        Option.Some(connection) -> admitting(pool, key, connection)

fn admitting(pool: Pool, key: Int, connection: Tcp.Connection) -> Result<Accepted, String>
    ? "A caller is only admitted if there is an inbound slot for it."
      "Refusing is closing: there is no Message for it, and a node that held"
      "the socket open while ignoring it would be worse than one that says"
      "no by hanging up."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.peerAddress, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match inboundHeld(pool) >= inboundLimit()
        true -> refusedInbound(pool, connection)
        false -> seating(pool, key, connection, Tcp.peerAddress(connection)?)

fn refusedInbound(pool: Pool, connection: Tcp.Connection) -> Result<Accepted, String>
    ? "The cap reached: close the caller and carry on."
    ! [Console.error, Tcp.close]
    _closed = Tcp.close(connection)
    _said = Console.error("refused an inbound Peer: already holding {inboundLimit()}")
    Result.Ok(Accepted(pool = pool, seated = Option.None))

fn seating(pool: Pool, key: Int, connection: Tcp.Connection, address: String) -> Result<Accepted, String>
    ? "The caller into the pool, then the Handshake from the answering side."
      "It goes in exactly where a dialled Peer goes -- same map, same key"
      "space, same standing -- so everything downstream that counts bytes,"
      "reads Messages or drops a misbehaving Peer works on it without"
      "knowing which side dialled. The one thing that differs is recorded"
      "rather than implied: inbound is true."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    seated = Pool(network = pool.network, sockets = Map.set(pool.sockets, key, Tcp.Socket.Connected(connection)), standing = Domain.Inbox.seated(pool.standing, key, address, true), spare = pool.spare, serves = pool.serves, height = pool.height, heardMs = pool.heardMs, anyHeardMs = pool.anyHeardMs)
    _said = Console.print("peer {key} dialled us from {address}")
    greetedOrDropped(seated, key, address, greeting(seated, key, 0, "", true))

fn greetedOrDropped(pool: Pool, key: Int, address: String, greeted: Result<Pool, String>) -> Result<Accepted, String>
    ? "A caller that will not complete a Handshake costs itself its slot, and"
      "costs this node nothing else."
      "Never an error upward. Anybody at all may dial us, so a caller that"
      "sends nonsense, or nothing, or hangs up mid-greeting is an ordinary"
      "event -- and one that took the whole loop down with it would be the"
      "easiest denial of service imaginable: connect, stay silent, watch the"
      "node stop following the chain."
      "What this does not yet defend against is the same caller doing it"
      "slowly and repeatedly: the Handshake runs inline, so a silent caller"
      "holds the loop for the answer deadline before this line is reached."
      "n1bor/btc-listener#30 wants the greeting driven by the loop instead,"
      "which is the real fix and a larger one."
    ! [Console.error, Tcp.close]
    match greeted
        Result.Ok(after) -> Result.Ok(Accepted(pool = after, seated = Option.Some(key)))
        Result.Err(why) -> droppedCaller(pool, key, address, why)

fn droppedCaller(pool: Pool, key: Int, address: String, why: String) -> Result<Accepted, String>
    ? "Close it, forget it, say why, and carry on."
    ! [Console.error, Tcp.close]
    _said = Console.error("dropping inbound peer {key} from {address}: {why}")
    without = dropOne(pool, key)?
    Result.Ok(Accepted(pool = without, seated = Option.None))

fn inboundHeld(pool: Pool) -> Int
    ? "How many of the Peers we hold arrived on their own initiative."
    inboundAmong(pool.standing, Map.keys(pool.standing), 0)

fn inboundAmong(standing: Map<Int, Standing>, keys: List<Int>, sofar: Int) -> Int
    ? "One at a time, counting only the ones that dialled us."
      "Over the standing rather than the pool, because the standing is what"
      "records direction and is the half a case can build."
    match keys
        [] -> sofar
        [head, ..tail] -> inboundAmong(standing, tail, sofar + oneIfInbound(Domain.Inbox.standingAt(standing, head)))

verify inboundAmong
    inboundAmong(Domain.Inbox.noStanding(), [], 0) => 0
    inboundAmong(Domain.Inbox.noStanding(), [7], 0) => 0
    inboundAmong(Domain.Inbox.seated(Domain.Inbox.noStanding(), 1, "1.2.3.4:8333", true), [1], 0) => 1
    inboundAmong(Domain.Inbox.seated(Domain.Inbox.noStanding(), 1, "1.2.3.4:8333", false), [1], 0) => 0

fn oneIfInbound(standing: Option<Standing>) -> Int
    ? "One for a Peer that dialled us, nothing for one we dialled."
    match standing
        Option.None -> 0
        Option.Some(held) -> countedDirection(held.inbound)

verify oneIfInbound
    oneIfInbound(Option.None) => 0
    oneIfInbound(Option.Some(Standing(address = "", buffer = [], version = 0, agent = "", sent = 0, received = 0, inbound = true))) => 1
    oneIfInbound(Option.Some(Standing(address = "", buffer = [], version = 0, agent = "", sent = 0, received = 0, inbound = false))) => 0

fn countedDirection(inbound: Bool) -> Int
    ? "A Bool as the number it contributes to the count."
    match inbound
        true -> 1
        false -> 0

verify countedDirection
    countedDirection(true) => 1
    countedDirection(false) => 0

fn listenerKey() -> Int
    ? "The key the listening socket sits under in the pool."
      "Negative, so it cannot collide with a Peer: Peer keys start at zero"
      "and only ever count up. One map holds all three socket states now"
      "(jasisz/aver#1138), which is what lets a single Tcp.poll wait on"
      "Peers and on callers at once -- an accept loop that needed its own"
      "wait would need its own thread, and ADR 0008 has one writer."
    0 - 1

verify listenerKey
    listenerKey() => 0 - 1

fn inboundLimit() -> Int
    ? "How many Peers may arrive on their own initiative."
      "Inbound slots are an attack surface outbound ones are not: we choose"
      "who we dial, and anybody at all may dial us. Eight is small enough"
      "that a flood cannot crowd out the Peers we chose and large enough to"
      "be worth serving. n1bor/btc-listener#30 wants eviction of the least"
      "useful inbound Peer on top of this; a cap is the part that cannot be"
      "skipped, because without it there is nothing to evict from."
    8

verify inboundLimit
    inboundLimit() => 8

fn listening(pool: Pool, port: Int, services: Int, height: Int) -> Result<Pool, String>
    ? "Bind the port and put the listener in the pool beside the Peers."
      "A backlog of sixteen: twice the inbound limit, so a burst of callers"
      "queues rather than being refused by the kernel before this node has"
      "had a chance to refuse them itself, and small enough that the queue"
      "is not its own memory to fill."
    ! [Tcp.listen]
    listener = Tcp.listen(port, 16)?
    Result.Ok(Pool(network = pool.network, sockets = Map.set(pool.sockets, listenerKey(), Tcp.Socket.Listening(listener)), standing = pool.standing, spare = pool.spare, serves = services, height = height, heardMs = pool.heardMs, anyHeardMs = pool.anyHeardMs))

fn opened(network: Network) -> Pool
    ? "A pool with nothing in it."
    Pool(network = network, sockets = Map.fromList([]), standing = Domain.Inbox.noStanding(), spare = [], serves = 0, height = 0, heardMs = Map.fromList([]), anyHeardMs = 0)

fn withStanding(pool: Pool, standing: Map<Int, Standing>) -> Pool
    ? "The pool, with what is known about the Peers moved on."
      "The sockets and the standing are kept in step by only ever changing"
      "one of them here: the pure half is Domain.Inbox's and this is the one"
      "place it is folded back in."
    Pool(network = pool.network, sockets = pool.sockets, standing = standing, spare = pool.spare, serves = pool.serves, height = pool.height, heardMs = pool.heardMs, anyHeardMs = pool.anyHeardMs)

fn spareLimit() -> Int
    ? "How many unasked-for Messages to keep for the caller."
      "A caller waiting on one Message gets others in the meantime, and some"
      "of them matter -- an addr answering a getaddr arrives exactly while"
      "the Header phase is waiting for headers, which is when this program"
      "asks for both. They are kept rather than discarded, and the keeping is"
      "bounded, because a Peer chooses how many it sends."
    64

verify spareLimit
    spareLimit() => 64

fn spareOf(pool: Pool) -> List<Spare>
    ? "The Messages that arrived while something else was being waited for."
    pool.spare

fn withoutSpare(pool: Pool) -> Pool
    ? "The pool, with the kept Messages handed over and forgotten."
    Pool(network = pool.network, sockets = pool.sockets, standing = pool.standing, spare = [], serves = pool.serves, height = pool.height, heardMs = pool.heardMs, anyHeardMs = pool.anyHeardMs)

fn sparing(pool: Pool, key: Int, frame: Frame) -> Pool
    ? "One unasked-for Message kept, oldest dropped once the bound is reached."
    Pool(network = pool.network, sockets = pool.sockets, standing = pool.standing, spare = bounded(List.concat(pool.spare, [Spare(key = key, frame = frame)])), serves = pool.serves, height = pool.height, heardMs = pool.heardMs, anyHeardMs = pool.anyHeardMs)

fn bounded(spare: List<Spare>) -> List<Spare>
    ? "Keep the newest, because an address heard a minute ago is worth more"
      "than one heard an hour ago."
    keptFrom(spare, List.len(spare))

fn keptFrom(spare: List<Spare>, held: Int) -> List<Spare>
    ? "Drop from the front once there are more than the bound allows."
    match held > spareLimit()
        true -> List.drop(spare, held - spareLimit())
        false -> spare

verify keptFrom
    keptFrom([], 0) => []
    keptFrom([sampleSpare()], 1) => [sampleSpare()]
    List.len(keptFrom(manySpare(spareLimit() + 3, []), spareLimit() + 3)) => 64

fn sampleSpare() -> Spare
    ? "One kept Message, for the cases here."
    Spare(key = 0, frame = Frame(command = "addr", body = []))

fn manySpare(count: Int, acc: List<Spare>) -> List<Spare>
    ? "That many kept Messages, for the cases here."
    match count <= 0
        true -> acc
        false -> manySpare(count - 1, List.prepend(sampleSpare(), acc))

verify manySpare
    List.len(manySpare(3, [])) => 3
    manySpare(0, []) => []

fn dialBudgetMs() -> Int
    ? "How long a dial may stay in flight before this loop gives up on it."
      "Normally nothing here ends a dead dial: the runtime has a deadline of"
      "its own (connect_timeout_secs, in aver.toml), Tcp.poll clips its wait"
      "to that deadline so an expiring attempt cannot sleep behind a longer"
      "one, and Tcp.dialled then says what went wrong. This is the backstop"
      "for the case that never arrives -- a dial that keeps waking the poll"
      "without ever settling -- so it is a multiple of the runtime's budget"
      "rather than a competitor to it."
    15000

verify dialBudgetMs
    dialBudgetMs() => 15000

fn dialTickMs() -> Int
    ? "How long one turn of the dial's poll waits."
      "Short enough that the backstop above is looked at while a dial is in"
      "flight, and nothing to do with how quickly the dial itself is"
      "noticed: the poll wakes when the dial settles, not when this expires."
    1000

verify dialTickMs
    dialTickMs() => 1000

record Joined
    pool: Pool
    seated: Bool
    why: String

fn joined(pool: Pool, key: Int, address: PeerAddress) -> Result<Joined, String>
    ? "Dial a Peer and complete the Handshake, keeping the rest alive while"
      "it happens."
      "The dial is one more key in the same Tcp.poll (jasisz/aver#1125), so"
      "a Candidate that never answers costs this pool nothing but the key it"
      "was going to have. It used to cost every Peer five seconds of"
      "silence, because Tcp.connect blocked -- and blocking is not something"
      "one Candidate should be able to do to eight Peers that have pings to"
      "answer."
      "The dial is held here rather than parked in the pool. It is a state"
      "no frame can show -- this call is straight-line, so nothing repaints"
      "while it is in flight -- and putting it in pool.sockets would leave a"
      "key with no Standing in front of everything that walks peerKeys."
      "A Candidate that will not have us is not an error, in the same way"
      "that a caller we drop is not an error: seated says whether there is a"
      "Peer now, why says what happened, and the pool comes back either way"
      "because the others were being read the whole time. An Err here is the"
      "poll itself failing, which is the loop and not one Candidate."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match Tcp.beginConnect(Domain.Address.hostOf(address), Domain.Address.portOf(address))
        Result.Err(why) -> Result.Ok(Joined(pool = pool, seated = false, why = why))
        Result.Ok(dial) -> settling(pool, key, address, dial, Time.unixMs() + dialBudgetMs())

fn joinedOnly(pool: Pool, key: Int, address: PeerAddress) -> Result<Pool, String>
    ? "The same, for the tools that have exactly one Peer to talk to."
      "With nobody else in the pool there is nothing to keep alive and"
      "nothing worth handing back, so a Candidate that will not have us is"
      "the end of the run rather than one Candidate out of eight."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    outcome = joined(pool, key, address)?
    match outcome.seated
        true -> Result.Ok(outcome.pool)
        false -> Result.Err(outcome.why)

fn settling(pool: Pool, key: Int, address: PeerAddress, dial: Tcp.Dial, deadlineMs: Int) -> Result<Joined, String>
    ? "Wait for the dial to settle, reading every other Peer while it does."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match Time.unixMs() > deadlineMs
        true -> abandoned(pool, dial, "dial did not settle within {Int.div(dialBudgetMs(), 1000)} seconds")
        false -> settlingOn(pool, key, address, dial, deadlineMs)

fn settlingOn(pool: Pool, key: Int, address: PeerAddress, dial: Tcp.Dial, deadlineMs: Int) -> Result<Joined, String>
    ? "One turn of the poll, with the dial among the sockets in it."
      "What comes back from the other Peers is read before the dial is"
      "looked at, because those bytes are the reason this is a poll and not"
      "a wait: they belong in their Inbox whether or not this Candidate ever"
      "answers."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    ready = Tcp.poll(dialledWith(pool, key, dial), dialTickMs())?
    settlingAfter(reading(pool, ready)?, key, address, dial, deadlineMs, List.contains(ready, key))

fn dialledWith(pool: Pool, key: Int, dial: Tcp.Dial) -> Map<Int, Tcp.Socket>
    ? "Every Peer's socket, and the dial as one more key beside them."
      "The listener is left out for the reason pollable gives: a queued"
      "caller keeps it ready, and a key that is always ready would spin this"
      "loop rather than let it wait."
    Map.set(pollable(pool), key, Tcp.Socket.Dialing(dial))

fn settlingAfter(pool: Pool, key: Int, address: PeerAddress, dial: Tcp.Dial, deadlineMs: Int, arrived: Bool) -> Result<Joined, String>
    ? "The dial woke the poll, or one of the Peers did."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match arrived
        false -> settling(pool, key, address, dial, deadlineMs)
        true -> promoting(pool, key, address, dial, deadlineMs)

fn promoting(pool: Pool, key: Int, address: PeerAddress, dial: Tcp.Dial, deadlineMs: Int) -> Result<Joined, String>
    ? "Ask what the dial settled into."
      "An Err is this Candidate refusing or running out its deadline, which"
      "is the ordinary answer for an address out of an Address Book and not"
      "a reason to stop."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match Tcp.dialled(dial)
        Result.Err(why) -> abandoned(pool, dial, why)
        Result.Ok(taken) -> promoted(pool, key, address, dial, deadlineMs, taken)

fn promoted(pool: Pool, key: Int, address: PeerAddress, dial: Tcp.Dial, deadlineMs: Int, taken: Option<Tcp.Connection>) -> Result<Joined, String>
    ? "None is readiness that meant nothing, which a poll is allowed to"
      "report; Some is a Peer."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match taken
        Option.None -> settling(pool, key, address, dial, deadlineMs)
        Option.Some(connection) -> seatedOut(pool, key, address, connection)

fn abandoned(pool: Pool, dial: Tcp.Dial, why: String) -> Result<Joined, String>
    ? "Cancel an attempt that came to nothing, and say what it was."
      "The cancel matters even when the dial has already failed: the handle"
      "is the only thing holding a socket the runtime opened, and a node"
      "that walks an Address Book for days would otherwise leak one per"
      "Candidate that would not answer."
    ! [Tcp.closeDial]
    _cancelled = Tcp.closeDial(dial)
    Result.Ok(Joined(pool = pool, seated = false, why = why))

fn seatedOut(pool: Pool, key: Int, address: PeerAddress, connection: Tcp.Connection) -> Result<Joined, String>
    ? "A dial that became a Connection is a Peer we called, so it is seated"
      "outbound and then introduced."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    seated = Pool(network = pool.network, sockets = Map.set(pool.sockets, key, Tcp.Socket.Connected(connection)), standing = Domain.Inbox.seated(pool.standing, key, Domain.Address.toString(address), false), spare = pool.spare, serves = pool.serves, height = pool.height, heardMs = pool.heardMs, anyHeardMs = pool.anyHeardMs)
    introducedOrDropped(seated, key, address)

fn introducedOrDropped(pool: Pool, key: Int, address: PeerAddress) -> Result<Joined, String>
    ? "A Handshake that does not finish leaves a socket open, and an open"
      "socket nobody is talking on is the leak a long-running node notices."
      "The same shape as droppedCaller on the inbound side, and for the same"
      "reason: whoever opened it closes it."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.dialled, Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match introduced(pool, key, address)
        Result.Ok(talking) -> Result.Ok(Joined(pool = talking, seated = true, why = ""))
        Result.Err(why) -> droppedDial(pool, key, why)

fn droppedDial(pool: Pool, key: Int, why: String) -> Result<Joined, String>
    ? "Close what the dial opened, and hand the pool back without it."
    ! [Tcp.close]
    shed = dropOne(pool, key)?
    Result.Ok(Joined(pool = shed, seated = false, why = why))

fn introduced(pool: Pool, key: Int, address: PeerAddress) -> Result<Pool, String>
    ? "Send our version, then read until this Peer sends verack."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    body = Domain.Version.payloadOffering(address, Time.unixMs(), Random.int(1, 2147483647), servicesOf(pool), pool.height)?
    sent = send(pool, key, "version", body)?
    greeting(sent, key, 0, "", false)

fn greeting(pool: Pool, key: Int, seenVersion: Int, seenAgent: String, inbound: Bool) -> Result<Pool, String>
    ? "Read this Peer's Messages until its verack arrives."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    waited = awaitAny(pool, key, Time.unixMs() + answerDeadlineMs())?
    handshaking(waited.pool, key, seenVersion, seenAgent, waited.frame, inbound)

fn handshaking(pool: Pool, key: Int, seenVersion: Int, seenAgent: String, frame: Frame, inbound: Bool) -> Result<Pool, String>
    ? "verack ends the Handshake; version says who we are talking to."
      "Anything else is a Peer being chatty before it agrees, and is put back"
      "for the caller rather than thrown away -- a Peer that sends its addr"
      "before our verack has still told us something, and Stage 5's whole"
      "second half is about not throwing that away."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match frame.command
        "verack" -> Result.Ok(withStanding(pool, Domain.Inbox.greeted(pool.standing, key, seenVersion, seenAgent)))
        "version" -> acknowledged(pool, key, frame.body, inbound)
        "ping" -> pongThen(pool, key, seenVersion, seenAgent, frame, inbound)
        _ -> greeting(sparing(pool, key, frame), key, seenVersion, seenAgent, inbound)

fn acknowledged(pool: Pool, key: Int, body: List<Int>, inbound: Bool) -> Result<Pool, String>
    ? "Send verack in reply, then keep waiting for theirs."
      "A Peer that dialled us has not seen our version yet -- it opened with"
      "its own and is waiting -- so ours goes first, before the verack that"
      "answers it. Outbound we sent ours before any of this began. Getting"
      "this the wrong way round leaves both sides waiting politely forever."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    presented = ourVersionIfInbound(pool, key, inbound)?
    sent = send(presented, key, "verack", Bytes.fromList([]))?
    greeting(sent, key, Domain.Version.peerVersionOf(body), Domain.Version.peerUserAgentOf(body), inbound)

fn ourVersionIfInbound(pool: Pool, key: Int, inbound: Bool) -> Result<Pool, String>
    ? "Our own version, but only to a Peer that dialled us."
    ! [Random.int, Tcp.writeBytes, Time.unixMs]
    match inbound
        false -> Result.Ok(pool)
        true -> ourVersionTo(pool, key)

fn ourVersionTo(pool: Pool, key: Int) -> Result<Pool, String>
    ? "The version Message, addressed to whoever is on the other end."
      "The address a version carries is the sender's view of who it is"
      "talking to; for an inbound Peer that is what Tcp.peerAddress reported"
      "when it arrived, which the standing already holds as text."
      "Read with fromPeerText rather than fromString, because what"
      "Tcp.peerAddress reports is host and port together -- an ephemeral port"
      "at that, since it is the caller's end of the socket. fromString takes"
      "a bare address and would read the whole thing as octets, which it"
      "says so in as many words: octet '1:55724' is not a number."
      "A Peer whose address will not parse is refused rather than greeted"
      "with a made-up one. In practice that means IPv6: Domain.Address is"
      "four octets and a port, and Tcp.peerAddress spells an IPv6 endpoint in"
      "brackets. Refusing is the honest answer to a caller this node cannot"
      "represent, and it says so rather than failing further away."
    ! [Random.int, Tcp.writeBytes, Time.unixMs]
    address = Domain.Address.fromPeerText(addressTextOf(Domain.Inbox.standingAt(pool.standing, key)), Domain.Network.portOf(pool.network))?
    body = Domain.Version.payloadOffering(address, Time.unixMs(), Random.int(1, 2147483647), servicesOf(pool), pool.height)?
    send(pool, key, "version", body)

fn servicesOf(pool: Pool) -> Int
    ? "What this node promises."
      "Held as the bits themselves rather than as a Bool, because there are"
      "three answers and not two: nothing, the whole chain, and -- for a"
      "pruned directory -- only the recent part of it. A Peer picks who to"
      "sync from by these bits, so claiming more than we hold wastes its time"
      "and ours."
    pool.serves

verify servicesOf
    servicesOf(opened(Network.Regtest)) => 0

fn addressTextOf(standing: Option<Standing>) -> String
    ? "The text a standing holds, or one that will not parse -- which is the"
      "right answer for a key naming nothing, and is refused upstream."
    match standing
        Option.None -> ""
        Option.Some(held) -> held.address

verify addressTextOf
    addressTextOf(Option.None) => ""
    addressTextOf(Option.Some(Standing(address = "1.2.3.4:8333", buffer = [], version = 0, agent = "", sent = 0, received = 0, inbound = true))) => "1.2.3.4:8333"

fn pongThen(pool: Pool, key: Int, seenVersion: Int, seenAgent: String, frame: Frame, inbound: Bool) -> Result<Pool, String>
    ? "Answer a ping that arrived mid-Handshake, then carry on."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.poll, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    payload = Bytes.fromList(frame.body)?
    sent = send(pool, key, "pong", payload)?
    greeting(sent, key, seenVersion, seenAgent, inbound)

fn send(pool: Pool, key: Int, command: String, payload: Bytes) -> Result<Pool, String>
    ? "Frame a payload for this Network and put it on one Peer's wire."
    ! [Tcp.writeBytes]
    match Map.get(pool.sockets, key)
        Option.None -> Result.Err("no Peer is held under identifier {key}")
        Option.Some(socket) -> sendingTo(pool, key, socket, command, payload)

fn sendingTo(pool: Pool, key: Int, socket: Tcp.Socket, command: String, payload: Bytes) -> Result<Pool, String>
    ? "One key names one socket state (jasisz/aver#1138): a Listener waiting"
      "for callers, a Dial still in flight, or a Connection that can be read"
      "and written. Only the last can carry a Message, and the type says so"
      "rather than the run time -- writeBytes on a Listener does not compile."
      "The other two are answered rather than ignored, because a caller"
      "addressing a Message to a Listener has made a mistake worth naming."
    ! [Tcp.writeBytes]
    match socket
        Tcp.Socket.Connected(connection) -> written(pool, key, connection, command, payload)
        Tcp.Socket.Listening(listener) -> Result.Err("identifier {key} is the listener, which cannot be sent to")
        Tcp.Socket.Dialing(dial) -> Result.Err("identifier {key} is still dialling and cannot be sent to yet")

fn written(pool: Pool, key: Int, connection: Tcp.Connection, command: String, payload: Bytes) -> Result<Pool, String>
    ? "The framed Message onto the socket, and its bytes onto the Peer's"
      "sent count (#131)."
    ! [Tcp.writeBytes]
    framed = Domain.Message.frame(pool.network, command, payload)?
    _sent = Tcp.writeBytes(connection, framed)?
    Result.Ok(withStanding(pool, Domain.Inbox.saidBytes(pool.standing, key, List.len(Bytes.octets(framed)))))

fn awaitFrom(pool: Pool, key: Int, wanted: String) -> Result<Waited, String>
    ? "The next Message of this command from this Peer, with the deadline"
      "measured from now."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    awaitingFrom(pool, key, wanted, Time.unixMs() + answerDeadlineMs())

fn awaitingFrom(pool: Pool, key: Int, wanted: String, deadlineMs: Int) -> Result<Waited, String>
    ? "The next Message of this command from this Peer, servicing the others"
      "while it is waited for."
      "Every Message from every other Peer is read and kept in the meantime,"
      "so nothing arrives while we are not listening, and asking one Peer a"
      "question costs the others nothing -- including their pings, which is"
      "what the single-Peer shape could not manage."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    waited = awaitAny(pool, key, deadlineMs)?
    matching(waited.pool, key, wanted, deadlineMs, waited.frame)

fn matching(pool: Pool, key: Int, wanted: String, deadlineMs: Int, frame: Frame) -> Result<Waited, String>
    ? "The Message asked for, a ping answered, or one put by and another wait."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    match frame.command == wanted
        true -> Result.Ok(Waited(pool = pool, frame = frame))
        false -> skipped(pool, key, wanted, deadlineMs, frame)

fn skipped(pool: Pool, key: Int, wanted: String, deadlineMs: Int, frame: Frame) -> Result<Waited, String>
    ? "A ping has to be answered even while waiting for something else."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    match frame.command
        "ping" -> answeredPing(pool, key, wanted, deadlineMs, frame)
        _ -> awaitingFrom(sparing(pool, key, frame), key, wanted, deadlineMs)

fn answeredPing(pool: Pool, key: Int, wanted: String, deadlineMs: Int, frame: Frame) -> Result<Waited, String>
    ? "Echo the nonce back, then carry on waiting."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    payload = Bytes.fromList(frame.body)?
    sent = send(pool, key, "pong", payload)?
    awaitingFrom(sent, key, wanted, deadlineMs)

fn awaitAny(pool: Pool, key: Int, deadlineMs: Int) -> Result<Waited, String>
    ? "The next Message this Peer has for us, whatever it is."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    match Domain.Inbox.popped(pool.network, pool.standing, key)
        Result.Err(why) -> Result.Err("peer {key}: {why}")
        Result.Ok(found) -> orPump(pool, key, deadlineMs, found)

fn orPump(pool: Pool, key: Int, deadlineMs: Int, found: Option<Popped>) -> Result<Waited, String>
    ? "A Message already read, or another turn of the loop."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    match found
        Option.Some(one) -> Result.Ok(Waited(pool = withStanding(pool, one.standing), frame = one.frame))
        Option.None -> pumpedFor(pool, key, deadlineMs)

fn pumpedFor(pool: Pool, key: Int, deadlineMs: Int) -> Result<Waited, String>
    ? "Nothing held for this Peer yet, so read from every Peer and look again."
      "The deadline is this Peer's alone. With one Peer, silence from the pool"
      "and silence from the Peer were the same fact; with several they are"
      "not, and a chatty Peer would otherwise keep the loop from ever noticing"
      "that the one being waited on had stopped answering."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Tcp.writeBytes, Time.unixMs]
    match Time.unixMs() > deadlineMs
        true -> Result.Err("Peer {key} did not answer within {Int.div(answerDeadlineMs(), 1000)} seconds")
        false -> awaitAny(pumped(pool)?, key, deadlineMs)

fn awaitAnyPeer(pool: Pool) -> Result<WaitedFrom, String>
    ? "The next Message from whichever Peer speaks first, and which one it was."
      "The node's loop rather than a caller's question: nothing is being"
      "waited for, so nothing is put back and nothing is skipped. The only"
      "deadline is the pool's own -- silence from everybody, which is a node"
      "that is no longer connected to the Network."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    match Domain.Inbox.poppedAny(pool.network, pool.standing)
        Result.Err(why) -> misbehaving(pool, why)
        Result.Ok(found) -> orPumpAny(pool, found)

fn misbehaving(pool: Pool, why: String) -> Result<WaitedFrom, String>
    ? "A Peer that broke the protocol costs itself, not the node."
      "With one Peer there was nothing to do but stop. With several, a stream"
      "this program will not read on from is a fact about one Peer: it is"
      "dropped, said out loud, and the node carries on with the others. The"
      "run ends only when the last Peer has gone, which the pump reports."
      "Every fault detectable here -- a Message framed for another Network, a"
      "payload that does not match its own checksum, a length no Message may"
      "have -- is one Bitcoin Core disconnects on outright rather than"
      "scoring, so there is nothing here a counter would usefully count."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    match Domain.Inbox.faultyIn(pool.network, pool.standing)
        Option.None -> Result.Err(why)
        Option.Some(key) -> dropped(pool, key, why)

fn dropped(pool: Pool, key: Int, why: String) -> Result<WaitedFrom, String>
    ? "Close the offender and go back to listening to everybody else."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    _said = Console.error("dropping peer {key}: {why}")
    awaitAnyPeer(dropOne(pool, key)?)

fn orPumpAny(pool: Pool, found: Option<PoppedAt>) -> Result<WaitedFrom, String>
    ? "A Message already read from somebody, or another turn of the loop."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    match found
        Option.Some(one) -> Result.Ok(WaitedFrom(pool = withStanding(pool, one.standing), key = one.key, frame = one.frame))
        Option.None -> pumpedAny(pool)

fn pumpedAny(pool: Pool) -> Result<WaitedFrom, String>
    ? "Nothing queued anywhere, so read from every Peer and look again."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    awaitAnyPeer(pumped(pool)?)

fn awaitTick(pool: Pool, tickMs: Int) -> Result<Tick, String>
    ? "The next Message from whichever Peer speaks first, or a tick of"
      "silence -- whichever comes sooner."
      "The Screen's clock (#129): where awaitAnyPeer waits out the whole"
      "idle deadline, this returns after tickMs with nothing in hand, so the"
      "caller gets a turn on which to look at its own clock -- print a due"
      "progress line, notice a Peer silent too long, redraw. Silence here is"
      "an answer, never an error: what silence means is the caller's to"
      "judge, because only the caller knows how long each Peer has been"
      "quiet."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    match Domain.Inbox.poppedAny(pool.network, pool.standing)
        Result.Err(why) -> misbehavingTick(pool, tickMs, why)
        Result.Ok(found) -> orPumpTick(pool, tickMs, found)

fn misbehavingTick(pool: Pool, tickMs: Int, why: String) -> Result<Tick, String>
    ? "A Peer that broke the protocol costs itself here too."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    match Domain.Inbox.faultyIn(pool.network, pool.standing)
        Option.None -> Result.Err(why)
        Option.Some(key) -> droppedTick(pool, tickMs, key, why)

fn droppedTick(pool: Pool, tickMs: Int, key: Int, why: String) -> Result<Tick, String>
    ? "Close the offender and go back to listening to everybody else."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    _said = Console.error("dropping peer {key}: {why}")
    awaitTick(dropOne(pool, key)?, tickMs)

fn orPumpTick(pool: Pool, tickMs: Int, found: Option<PoppedAt>) -> Result<Tick, String>
    ? "A Message already read from somebody, or one bounded poll."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    match found
        Option.Some(one) -> Result.Ok(Tick(pool = withStanding(pool, one.standing), arrived = Option.Some(Spare(key = one.key, frame = one.frame))))
        Option.None -> pumpedTick(pool, tickMs)

fn pumpedTick(pool: Pool, tickMs: Int) -> Result<Tick, String>
    ? "Ask which Peers have something, waiting at most one tick."
      "A poll that reports nobody is the tick itself, handed back with"
      "nothing in it."
    ! [Console.error, Console.print, Tcp.close, Tcp.poll, Tcp.readSome, Time.unixMs]
    ready = Tcp.poll(pollable(pool), tickMs)?
    match ready
        [] -> Result.Ok(Tick(pool = pool, arrived = Option.None))
        [head, ..tail] -> awaitTick(reading(pool, ready)?, tickMs)

fn pumped(pool: Pool) -> Result<Pool, String>
    ? "One turn of the loop: ask which Peers have something, and read them."
      "A poll that reports nobody is the whole pool silent for the idle"
      "deadline, which is not a slow Peer but a connection that is gone."
    ! [Console.error, Console.print, Tcp.poll, Tcp.readSome, Time.unixMs]
    ready = Tcp.poll(pollable(pool), idleDeadlineMs())?
    match ready
        [] -> Result.Err("no Peer said anything for {Int.div(idleDeadlineMs(), 1000)} seconds")
        [head, ..tail] -> reading(pool, ready)

fn reading(pool: Pool, ready: List<Int>) -> Result<Pool, String>
    ? "Take what each ready Peer has said, one after another."
    ! [Console.error, Console.print, Tcp.readSome, Time.unixMs]
    match ready
        [] -> Result.Ok(pool)
        [head, ..tail] -> readingOne(pool, head, tail)

fn readingOne(pool: Pool, key: Int, rest: List<Int>) -> Result<Pool, String>
    ? "One Peer's bytes into its buffer, and the Messages out of it."
    ! [Console.error, Console.print, Tcp.readSome, Time.unixMs]
    match Map.get(pool.sockets, key)
        Option.None -> reading(pool, rest)
        Option.Some(socket) -> readingFrom(pool, key, socket, rest)

fn readingFrom(pool: Pool, key: Int, socket: Tcp.Socket, rest: List<Int>) -> Result<Pool, String>
    ? "Only a Connection has bytes to read. A Listener that polled ready has"
      "a caller waiting on it, which the accept loop takes, and a Dial that"
      "polled ready has finished connecting -- neither belongs here, and both"
      "are passed over rather than treated as a Peer that said nothing."
    ! [Console.error, Console.print, Tcp.readSome, Time.unixMs]
    match socket
        Tcp.Socket.Connected(connection) -> readingInto(pool, key, connection, rest)
        Tcp.Socket.Listening(listener) -> reading(pool, rest)
        Tcp.Socket.Dialing(dial) -> reading(pool, rest)

fn readingInto(pool: Pool, key: Int, connection: Tcp.Connection, rest: List<Int>) -> Result<Pool, String>
    ? "An empty read is a clean close, and a Peer closing is not an error."
      "It is one Peer gone, which with several is a fact about the pool and"
      "not the end of the run. What ends the run is the pool emptying, which"
      "the caller notices rather than this."
    ! [Console.error, Console.print, Tcp.readSome, Time.unixMs]
    arrived = Bytes.octets(Tcp.readSome(connection, readChunk())?)
    match arrived
        [] -> closedBy(pool, key, rest)
        [head, ..tail] -> buffered(pool, key, rest, arrived)

fn closedBy(pool: Pool, key: Int, rest: List<Int>) -> Result<Pool, String>
    ? "Say which Peer went, then carry on with the others."
    ! [Console.error, Console.print, Tcp.readSome, Time.unixMs]
    _said = Console.error("peer {key} closed the connection")
    reading(forgotten(pool, key), rest)

fn buffered(pool: Pool, key: Int, rest: List<Int>, arrived: List<Int>) -> Result<Pool, String>
    ? "Cut whole Messages out of what this Peer has sent so far, and mark"
      "when it was heard."
      "Bytes off the socket are the only honest moment to take: a Message is"
      "cut out of them later and a Peer sending a long one has still been"
      "heard from. The pool keeps this rather than the loop (#168) because"
      "the catch-up walks hold the pool and do not hold the loop's own"
      "bookkeeping -- and they are the hours when somebody is most likely to"
      "be looking at the Peers Panel."
    ! [Console.error, Console.print, Tcp.readSome, Time.unixMs]
    heard = Time.unixMs()
    marked = Pool(network = pool.network, sockets = pool.sockets, standing = Domain.Inbox.absorbedInto(pool.standing, key, arrived), spare = pool.spare, serves = pool.serves, height = pool.height, heardMs = Map.set(pool.heardMs, key, heard), anyHeardMs = heard)
    reading(marked, rest)

fn forgotten(pool: Pool, key: Int) -> Pool
    ? "Forget a Peer, without closing anything."
    Pool(network = pool.network, sockets = Map.remove(pool.sockets, key), standing = Domain.Inbox.forgotten(pool.standing, key), spare = pool.spare, serves = pool.serves, height = pool.height, heardMs = pool.heardMs, anyHeardMs = pool.anyHeardMs)

fn dropOne(pool: Pool, key: Int) -> Result<Pool, String>
    ? "Close one Peer's socket and forget it."
    ! [Tcp.close]
    match Map.get(pool.sockets, key)
        Option.None -> Result.Ok(pool)
        Option.Some(socket) -> closingSocket(pool, key, socket)

fn closingSocket(pool: Pool, key: Int, socket: Tcp.Socket) -> Result<Pool, String>
    ? "Each state is released by its own call; none of them is the others."
    ! [Tcp.close]
    match socket
        Tcp.Socket.Connected(connection) -> closedOne(pool, key, connection)
        Tcp.Socket.Listening(listener) -> Result.Ok(forgotten(pool, key))
        Tcp.Socket.Dialing(dial) -> Result.Ok(forgotten(pool, key))

fn closedOne(pool: Pool, key: Int, connection: Tcp.Connection) -> Result<Pool, String>
    ? "The socket released, then the Peer forgotten."
    ! [Tcp.close]
    _closed = Tcp.close(connection)
    Result.Ok(forgotten(pool, key))

fn closeAll(pool: Pool) -> Result<Pool, String>
    ? "Release every socket the pool holds."
    ! [Tcp.close]
    closingEach(pool, Map.keys(pool.sockets))

fn closingEach(pool: Pool, keys: List<Int>) -> Result<Pool, String>
    ? "One at a time, so one failure does not strand the rest."
    ! [Tcp.close]
    match keys
        [] -> Result.Ok(pool)
        [head, ..tail] -> closingEach(dropOne(pool, head)?, tail)
