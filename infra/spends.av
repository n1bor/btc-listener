module Spends
    intent =
        "Following an Input back to the Output it spends."
        "An Input names its parent by Transaction Id, so this is the t: keyspace"
        "used for the thing it was built for: find the Transaction, take the"
        "Output at the named position, and that is what is being spent."
        "Every step can come up empty for a different reason, and only one of"
        "them means the Input is wrong. Not indexed and not held are gaps in"
        "what we have; a position past the end of a Transaction that we do hold"
        "is a fault in the Input itself. Domain.Spend keeps the two apart and"
        "this decides which is which."
        "Each parent read costs a whole Block, and the parents of one"
        "Transaction are scattered across the chain, so there is nothing to"
        "share between them the way a scan in Height order shares a Segment."
        "Reading through Infra.Blocks.read rather than fetch, and that is the"
        "right way round here. read decodes the one line it wants; fetch decodes"
        "every Block in the Segment, which pays for itself only when the next"
        "lookup lands in the same one. Threading a held Segment through these"
        "lookups was tried and made an audit of two thousand Blocks go from two"
        "and a half minutes to over ten, because scattered parents miss."
    exposes [Work, Pending, resolved, scriptsAcross, resolve]
    depends [Domain.Block, Domain.Rules, Domain.Primitives, Domain.Index, Domain.Spend, Domain.SpendContext, Domain.SpendScript, Domain.Transaction, Infra.Blocks, Infra.Store]
    effects [Disk.readText, Infra.Kv.get]

record Checked
    tally: Tally
    scripts: Outcomes

fn resolved(store: Store, blocks: BlockStore, transaction: Transaction, rules: Rules) -> Result<Work, String>
    ? "Look up every Input of a Transaction and hold what its Scripts will need."
      "Resolution is where every effect in a spend lives, so it stays in the"
      "walk. What it leaves behind is pure -- an Input, the Output it spends,"
      "the Rules and the Context -- and pure work over a list is work that can"
      "be declared independent."
      "The Outputs are fetched once and carried, so the Script pass costs no"
      "lookups at all."
    ! [Disk.readText, Infra.Kv.get]
    gathered = over(store, blocks, transaction, 0, Domain.Transaction.inputsOf(transaction), Gathered(tally = Domain.Spend.started(), pending = []), rules)?
    Result.Ok(Work(transaction = transaction, tally = gathered.tally, spent = List.reverse(gathered.pending)))

record Pending
    index: Int
    input: Input
    spend: Spend

record Work
    transaction: Transaction
    tally: Tally
    spent: List<Pending>

record Gathered
    tally: Tally
    pending: List<Pending>

fn chunkSize() -> Int
    ? "How many Transactions one branch checks before another is started."
      "The unit is a Transaction rather than an Input, which is the whole"
      "point. A Transaction in Blocks 170000-170200 has two Inputs on average,"
      "so fanning within one bought a ceiling of two-way parallelism however"
      "many cores were free -- measured at 11% for 33% more CPU. A Block near"
      "the tip holds hundreds or thousands of Transactions, and those are what"
      "there are enough of to fill the machine."
      "Sixteen keeps the branch count proportional to the Block: a 30"
      "Transaction Block starts two branches, a 2000 Transaction Block starts"
      "125. A branch is a thread, and a thread that checks sixteen"
      "Transactions is worth starting where one that checks two is not."
    16

verify chunkSize
    chunkSize() > 0 => true

fn chunked(work: List<Work>, acc: List<List<Work>>) -> List<List<Work>>
    ? "The Block's Transactions in runs of chunkSize, so a branch is worth starting."
    match work
        [] -> List.reverse(acc)
        [head, ..tail] -> chunked(List.drop(work, chunkSize()), List.prepend(List.take(work, chunkSize()), acc))

verify chunked
    chunked([], []) => []
    List.len(chunked(manyWork(1, []), [])) => 1
    List.len(chunked(manyWork(16, []), [])) => 1
    List.len(chunked(manyWork(17, []), [])) => 2
    List.len(chunked(manyWork(200, []), [])) => 13

fn manyWork(count: Int, acc: List<Work>) -> List<Work>
    ? "That many copies of the same resolved Transaction, for the cases here."
    match count <= 0
        true -> acc
        false -> manyWork(count - 1, List.prepend(sampleWork(), acc))

verify manyWork
    List.len(manyWork(0, [])) => 0
    List.len(manyWork(5, [])) => 5

fn scriptsAcross(work: List<Work>, rules: Rules) -> Result<Tuple<List<Work>, List<Outcomes>>, String>
    ? "The Script pairs of every Transaction in a Block, one answer each."
      "Longest first. A branch takes as long as the Transactions in it, and a"
      "Block's Transactions are wildly uneven -- one with 168 Inputs beside"
      "five hundred with one. Left in Block order, a late chunk holding the"
      "big one finishes long after the rest and every other core waits on it."
      "Started longest first, the big ones are underway while the short ones"
      "fill in around them, which is the oldest scheduling heuristic there is."
      "The Work comes back with the answers because the order is no longer the"
      "Block's, and the caller pairs them to name a Transaction that did not"
      "settle. Handing back both is what keeps that honest rather than"
      "assuming an order that sorting has just changed."
    ordered = longestFirst(work)
    answers = fanned(chunked(ordered, []), rules)?
    Result.Ok((ordered, answers))

verify scriptsAcross
    scriptsAcross([], Domain.Rules.latest()) => Result.Ok(([], []))
    scriptsAcross([sampleWork()], Domain.Rules.latest()) => Result.Ok(([sampleWork()], [Domain.SpendScript.count(Domain.SpendScript.noOutcomes(), Domain.SpendScript.check("51", "51", Domain.SpendContext.bare(Domain.Rules.latest())))]))

fn longestFirst(work: List<Work>) -> List<Work>
    ? "The Block's Transactions, most Inputs first."
      "Insertion into a sorted list rather than a merge sort, because the list"
      "is already nearly uniform -- almost every Transaction has one or two"
      "Inputs -- so the few long ones travel a short way and the rest do not"
      "move at all."
    inserted(work, [])

verify longestFirst
    longestFirst([]) => []
    List.len(longestFirst(manyWork(4, []))) => 4
    List.len(List.take(longestFirst(List.concat(manyWork(2, []), [wideWork()])), 1)) => 1
    inputsIn(List.take(longestFirst(List.concat(manyWork(2, []), [wideWork()])), 1)) => 3

fn inserted(work: List<Work>, acc: List<Work>) -> List<Work>
    ? "Each Transaction put where it belongs in what is sorted so far."
    match work
        [] -> acc
        [head, ..tail] -> inserted(tail, placed(head, acc, []))

verify inserted
    inserted([], []) => []
    List.len(inserted(manyWork(3, []), [])) => 3

fn placed(one: Work, sorted: List<Work>, seen: List<Work>) -> List<Work>
    ? "In front of the first Transaction with fewer Inputs than this one."
    match sorted
        [] -> List.concat(List.reverse(seen), [one])
        [head, ..tail] -> placedAgainst(one, head, tail, seen)

verify placed
    placed(sampleWork(), [], []) => [sampleWork()]
    inputsIn(placed(wideWork(), [sampleWork()], [])) => 4

fn placedAgainst(one: Work, head: Work, tail: List<Work>, seen: List<Work>) -> List<Work>
    ? "Compare against the next one along."
    match List.len(one.spent) > List.len(head.spent)
        true -> List.concat(List.reverse(seen), List.prepend(one, List.prepend(head, tail)))
        false -> placed(one, tail, List.prepend(head, seen))

verify placedAgainst
    inputsIn(placedAgainst(wideWork(), sampleWork(), [], [])) => 4
    inputsIn(placedAgainst(sampleWork(), wideWork(), [], [])) => 4

fn inputsIn(work: List<Work>) -> Int
    ? "How many Inputs the Transactions in this list hold, for the cases here."
    match work
        [] -> 0
        [head, ..tail] -> List.len(head.spent) + inputsIn(tail)

verify inputsIn
    inputsIn([]) => 0
    inputsIn([sampleWork()]) => 1
    inputsIn([wideWork()]) => 3

fn wideWork() -> Work
    ? "A resolved Transaction with three Inputs, for the sorting cases."
    Work(transaction = Domain.SpendContext.emptyTransaction(), tally = Domain.Spend.started(), spent = [samplePending(), samplePending(), samplePending()])

verify wideWork
    List.len(wideWork().spent) => 3

fn fanned(chunks: List<List<Work>>, rules: Rules) -> Result<List<Outcomes>, String>
    ? "Every chunk of Transactions, declared independent of every other."
      "The VM runs the branches one after another, so verify and the corpus see"
      "exactly what they always saw. Compiled Rust runs a thread per branch."
    match chunks
        [] -> Result.Ok([])
        [head, ..tail] -> fannedStep(head, tail, rules)

verify fanned
    fanned([], Domain.Rules.latest()) => Result.Ok([])
    List.len(fanned([manyWork(2, [])], Domain.Rules.latest())?) => 2

fn fannedStep(chunk: List<Work>, rest: List<List<Work>>, rules: Rules) -> Result<List<Outcomes>, String>
    ? "This chunk, and the rest of them if there are any."
      "A lone chunk is run where it stands rather than declared independent of"
      "nothing, which is every Block with sixteen Transactions or fewer."
    match rest
        [] -> eachInChunk(chunk, [], rules)
        [head, ..tail] -> paired(chunk, rest, rules)

verify fannedStep
    fannedStep([], [], Domain.Rules.latest()) => Result.Ok([])
    List.len(fannedStep(manyWork(2, []), [], Domain.Rules.latest())?) => 2
    List.len(fannedStep(manyWork(2, []), [manyWork(3, [])], Domain.Rules.latest())?) => 5

fn paired(chunk: List<Work>, rest: List<List<Work>>, rules: Rules) -> Result<List<Outcomes>, String>
    ? "This chunk and the rest of them, as an independent product."
      "Left before right, so the answers come back in Block order whichever"
      "branch finished first."
    data = (eachInChunk(chunk, [], rules), fanned(rest, rules))?!
    match data
        (mine, others) -> Result.Ok(List.concat(mine, others))

verify paired
    paired([], [[]], Domain.Rules.latest()) => Result.Ok([])
    List.len(paired(manyWork(2, []), [manyWork(3, [])], Domain.Rules.latest())?) => 5

fn eachInChunk(chunk: List<Work>, acc: List<Outcomes>, rules: Rules) -> Result<List<Outcomes>, String>
    ? "One chunk of Transactions, in order, inside a single branch."
      "A Result although nothing here can fail, because an independent product"
      "unwraps Results and both branches have to agree on the error type."
    match chunk
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> eachInChunk(tail, List.prepend(outcomesOf(head, rules), acc), rules)

verify eachInChunk
    eachInChunk([], [], Domain.Rules.latest()) => Result.Ok([])
    List.len(eachInChunk(manyWork(3, []), [], Domain.Rules.latest())?) => 3

fn outcomesOf(work: Work, rules: Rules) -> Outcomes
    ? "Every Script pair of one Transaction, run in order."
    sequentially(work.transaction, work.spent, Domain.SpendScript.noOutcomes(), rules)

verify outcomesOf
    outcomesOf(sampleWork(), Domain.Rules.latest()).passed => 1

fn sequentially(transaction: Transaction, held: List<Pending>, counts: Outcomes, rules: Rules) -> Outcomes
    ? "One Transaction's Inputs, in order."
    match held
        [] -> counts
        [head, ..tail] -> sequentially(transaction, tail, scriptCounts(transaction, head.index, head.input, head.spend, counts, rules), rules)

verify sequentially
    sequentially(Domain.SpendContext.emptyTransaction(), [], Domain.SpendScript.noOutcomes(), Domain.Rules.latest()) => Domain.SpendScript.noOutcomes()
    sequentially(Domain.SpendContext.emptyTransaction(), [samplePending()], Domain.SpendScript.noOutcomes(), Domain.Rules.latest()).passed => 1

fn samplePending() -> Pending
    ? "One resolved Input whose Script pair passes, for the blocks above."
    Pending(index = 0, input = Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), spend = Spend.Resolved(5, "51"))

verify samplePending
    samplePending().index => 0

fn sampleWork() -> Work
    ? "One resolved Transaction with one passing Input, for the blocks above."
    Work(transaction = Domain.SpendContext.emptyTransaction(), tally = Domain.Spend.started(), spent = [samplePending()])

verify sampleWork
    List.len(sampleWork().spent) => 1

fn over(store: Store, blocks: BlockStore, transaction: Transaction, index: Int, inputs: List<Input>, held: Gathered, rules: Rules) -> Result<Gathered, String>
    ? "Each Input in turn, carrying the Transaction they belong to and which"
      "one of them this is. A signature commits to both, so a walk that keeps"
      "only the Input cannot check one -- which is what this walk used to be."
    ! [Disk.readText, Infra.Kv.get]
    match inputs
        [] -> Result.Ok(held)
        [head, ..tail] -> nextInput(store, blocks, transaction, index, head, tail, held, rules)

fn nextInput(store: Store, blocks: BlockStore, transaction: Transaction, index: Int, input: Input, tail: List<Input>, held: Gathered, rules: Rules) -> Result<Gathered, String>
    ? "A coinbase Input spends nothing, and marks the whole Transaction."
      "It has no Script to run either: the bytes in a coinbase Input are"
      "arbitrary data that consensus never executes."
    ! [Disk.readText, Infra.Kv.get]
    match Domain.Spend.isCoinbaseInput(Domain.Transaction.previousTxidOf(input))
        true -> over(store, blocks, transaction, index + 1, tail, Gathered(tally = Domain.Spend.markCoinbase(held.tally), pending = held.pending), rules)
        false -> resolvedInput(store, blocks, transaction, index, input, tail, held, rules)

fn resolvedInput(store: Store, blocks: BlockStore, transaction: Transaction, index: Int, input: Input, tail: List<Input>, held: Gathered, rules: Rules) -> Result<Gathered, String>
    ? "Follow one Input back, fold the value in, and hold the Script work back."
      "Prepended rather than appended, and turned round once by the caller."
    ! [Disk.readText, Infra.Kv.get]
    spend = resolve(store, blocks, Domain.Transaction.previousTxidOf(input), Domain.Transaction.previousIndexOf(input))?
    over(store, blocks, transaction, index + 1, tail, Gathered(tally = Domain.Spend.absorb(held.tally, spend), pending = List.prepend(Pending(index = index, input = input, spend = spend), held.pending)), rules)

fn scriptCounts(transaction: Transaction, index: Int, input: Input, spend: Spend, counts: Outcomes, rules: Rules) -> Outcomes
    ? "A Script pair can only be run when the Output it spends was found."
      "An Input whose parent is not held is not counted at all, rather than"
      "counted as undecided: undecided is about what the engine cannot answer,"
      "and this is about what we have not got."
      "The Output's Script is both the second half of the pair and the Script"
      "code a legacy signature is taken over, which is why it appears twice."
    match spend
        Spend.Resolved(value, script) -> Domain.SpendScript.count(counts, Domain.SpendScript.check(Domain.Transaction.scriptOf(input), script, Domain.SpendContext.committed(rules, transaction, index, value, script)))
        Spend.Unknown(why) -> counts
        Spend.Invalid(why) -> counts

verify scriptCounts
    scriptCounts(Domain.SpendContext.emptyTransaction(), 0, Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), Spend.Resolved(5, "51"), Domain.SpendScript.noOutcomes(), Domain.Rules.latest()).passed => 1
    scriptCounts(Domain.SpendContext.emptyTransaction(), 0, Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), Spend.Resolved(5, "a7"), Domain.SpendScript.noOutcomes(), Domain.Rules.latest()).undecided => 1
    scriptCounts(Domain.SpendContext.emptyTransaction(), 0, Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), Spend.Resolved(5, "00"), Domain.SpendScript.noOutcomes(), Domain.Rules.latest()).failed => 1
    scriptCounts(Domain.SpendContext.emptyTransaction(), 0, Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), Spend.Unknown("no"), Domain.SpendScript.noOutcomes(), Domain.Rules.latest()) => Domain.SpendScript.noOutcomes()
    scriptCounts(Domain.SpendContext.emptyTransaction(), 0, Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), Spend.Invalid("no"), Domain.SpendScript.noOutcomes(), Domain.Rules.latest()) => Domain.SpendScript.noOutcomes()

fn resolve(store: Store, blocks: BlockStore, previousTxid: String, position: Int) -> Result<Spend, String>
    ? "What the Output at this position of this Transaction is worth."
      "The o: keyspace holds the Output itself, so it is asked first and the"
      "answer costs one lookup. Everything below this is the route taken when"
      "it has nothing: a t: lookup, a b: lookup, and the whole Block read and"
      "decoded for one Output."
      "Falling through rather than reporting Unknown matters. o: covers the"
      "Heights someone ran the outputs command over, and an Input naming a"
      "position past the end of a Transaction we do hold is Invalid rather"
      "than absent -- a distinction only the longer route can draw."
    ! [Disk.readText, Infra.Kv.get]
    direct = Infra.Store.get(store, Domain.Index.outputKey(previousTxid, position))?
    match direct
        Option.Some(text) -> spent(text)
        Option.None -> throughTransaction(store, blocks, previousTxid, position)

fn spent(text: String) -> Result<Spend, String>
    ? "An Output read straight out of the o: keyspace."
    output = Domain.Index.decodeSpentOutput(text)?
    Result.Ok(Spend.Resolved(output.value, output.script))

verify spent
    spent("5000:51") => Result.Ok(Spend.Resolved(5000, "51"))
    spent("5000:") => Result.Ok(Spend.Resolved(5000, ""))
    spent("nope") => Result.Err("Output record has no separator: 'nope'")

fn throughTransaction(store: Store, blocks: BlockStore, previousTxid: String, position: Int) -> Result<Spend, String>
    ? "The longer route: find the parent Transaction, then the Block holding it."
      "Not indexed is Unknown rather than Invalid: the t: keyspace covers the"
      "Heights someone chose to index, and everything else in the chain is"
      "simply absent from it."
    ! [Disk.readText, Infra.Kv.get]
    sited = Infra.Store.get(store, Domain.Index.txKey(previousTxid))?
    match sited
        Option.None -> Result.Ok(Spend.Unknown("transaction {previousTxid} is not indexed"))
        Option.Some(text) -> atSite(store, blocks, text, position)

fn atSite(store: Store, blocks: BlockStore, text: String, position: Int) -> Result<Spend, String>
    ? "The site names a Block; the Index says whether its bytes are held."
    ! [Disk.readText, Infra.Kv.get]
    site = Domain.Index.decodeTxSite(text)?
    located = Infra.Store.get(store, Domain.Index.blockKey(site.blockId))?
    match located
        Option.None -> Result.Ok(Spend.Unknown("block {site.blockId} is not held"))
        Option.Some(where) -> inBlock(blocks, where, site, position)

fn inBlock(blocks: BlockStore, where: String, site: TxSite, position: Int) -> Result<Spend, String>
    ? "Read the Block and take the Transaction the site points at."
    ! [Disk.readText]
    location = Domain.Index.decodeLocation(where)?
    payload = Infra.Blocks.read(blocks, location)?
    transactions = Domain.Block.transactionsOf(payload)?
    Result.Ok(outputAt(nth(transactions, site.position), site, position))

fn nth(transactions: List<Transaction>, remaining: Int) -> Option<Transaction>
    ? "The Transaction at a position, or nothing when the Block is shorter."
    match transactions
        [] -> Option.None
        [head, ..tail] -> takeOrWalk(head, tail, remaining)

verify nth
    nth([], 0) => Option.None
    nth([sampleTx()], 0) => Option.Some(sampleTx())
    nth([sampleTx()], 1) => Option.None

fn takeOrWalk(head: Transaction, tail: List<Transaction>, remaining: Int) -> Option<Transaction>
    ? "This is the one when the count runs out."
    match remaining <= 0
        true -> Option.Some(head)
        false -> nth(tail, remaining - 1)

verify takeOrWalk
    takeOrWalk(sampleTx(), [], 0) => Option.Some(sampleTx())
    takeOrWalk(sampleTx(), [], 1) => Option.None

fn outputAt(found: Option<Transaction>, site: TxSite, position: Int) -> Spend
    ? "A Block we hold that is shorter than its own Index entry is broken."
    match found
        Option.None -> Spend.Invalid("block {site.blockId} has no transaction at position {site.position}")
        Option.Some(transaction) -> valueAt(Domain.Transaction.outputsOf(transaction), position, position)

verify outputAt
    outputAt(Option.None, Domain.Index.TxSite(blockId = "aa", position = 3), 0) => Spend.Invalid("block aa has no transaction at position 3")
    outputAt(Option.Some(sampleTx()), Domain.Index.TxSite(blockId = "aa", position = 0), 0) => Spend.Resolved(5000, "")
    outputAt(Option.Some(sampleTx()), Domain.Index.TxSite(blockId = "aa", position = 0), 4) => Spend.Invalid("output 4 is past the end of the transaction")

fn valueAt(outputs: List<Output>, remaining: Int, position: Int) -> Spend
    ? "What the Output at a position holds."
      "An Input naming an Output past the end of a Transaction we hold is wrong,"
      "not unknown. That is the one thing here that condemns an Input outright."
    match outputs
        [] -> Spend.Invalid("output {position} is past the end of the transaction")
        [head, ..tail] -> valueOrWalk(head, tail, remaining, position)

verify valueAt
    valueAt([], 0, 0) => Spend.Invalid("output 0 is past the end of the transaction")
    valueAt([Output(value = 5000, script = ""), Output(value = 7000, script = "")], 0, 0) => Spend.Resolved(5000, "")
    valueAt([Output(value = 5000, script = ""), Output(value = 7000, script = "")], 1, 1) => Spend.Resolved(7000, "")
    valueAt([Output(value = 5000, script = ""), Output(value = 7000, script = "")], 2, 2) => Spend.Invalid("output 2 is past the end of the transaction")

fn valueOrWalk(head: Output, tail: List<Output>, remaining: Int, position: Int) -> Spend
    ? "This is the Output when the count runs out."
    match remaining <= 0
        true -> Spend.Resolved(Domain.Transaction.valueOf(head), Domain.Transaction.outputScriptOf(head))
        false -> valueAt(tail, remaining - 1, position)

verify valueOrWalk
    valueOrWalk(Output(value = 5000, script = ""), [], 0, 0) => Spend.Resolved(5000, "")
    valueOrWalk(Output(value = 5000, script = ""), [], 1, 1) => Spend.Invalid("output 1 is past the end of the transaction")

fn sampleOutputs() -> List<Output>
    ? "Two Outputs, for the cases above."
    [Output(value = 5000, script = ""), Output(value = 7000, script = "")]

verify sampleOutputs
    List.len(sampleOutputs()) => 2

fn sampleTx() -> Transaction
    ? "A Transaction carrying those Outputs, for the cases above."
    Transaction(version = 1, inputs = [], outputs = sampleOutputs(), lockTime = 0, txid = "cc", size = 9, isSegWit = false)

verify sampleTx
    Domain.Transaction.txidOf(sampleTx()) => "cc"
