module Blocks
    intent =
        "Segments on disk: appending a Block, reading one back, and deleting the"
        "Segments that pruning has finished with."
        "The only module that knows a Segment is a file. Where a Block goes is"
        "decided in Domain.Segment, which is pure; this carries the decision to"
        "Disk and nothing more."
        "Every read is positional — a Location names its bytes exactly, so no"
        "read touches more of a Segment than the Block asked for."
        "Resume reads the directory rather than counting up from zero, because"
        "pruning removes the low Segments — after it, Segment 0 is absent while"
        "Segment 400 is current, and probing upward from zero would report an"
        "empty store. Reopening walks the current Segment's record headers and"
        "truncates a torn final record, so the framing invariant — a Segment is"
        "whole records, end to end — survives a crash mid-append."
    exposes [BlockStore, Appended, open, append, read, prune, currentSegment, segmentPath, segmentNumberOf]
    depends [Bytes, Domain.Index, Domain.Segment]
    effects [
        Disk.appendBytes, Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.getAll,
    ]

record BlockStore
    dir: String
    state: SegmentState

record Appended
    store: BlockStore
    location: Location

fn open(dir: String) -> Result<BlockStore, String>
    ? "Pick up where the last run left off, creating the directory if absent."
      "A directory of hex Segments — the format before this one — is refused by"
      "name rather than misread; there is no migration, only a fresh download."
      "makeDir is create_dir_all, so calling it on a directory that already"
      "exists succeeds and needs no guard."
    ! [Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes]
    _made = Disk.makeDir(dir)?
    names = Disk.listDir(dir)?
    match hexIn(names)
        true -> Result.Err("{dir} holds hex Segments, the format before binary; Blocks must be downloaded fresh into a new directory")
        false -> resume(dir, highestSegment(names, Option.None))

fn resume(dir: String, highest: Option<Int>) -> Result<BlockStore, String>
    ? "An empty directory starts at the beginning; otherwise reopen the last Segment."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes]
    match highest
        Option.None -> Result.Ok(BlockStore(dir = dir, state = Domain.Segment.initial()))
        Option.Some(segment) -> reopen(dir, segment)

fn reopen(dir: String, segment: Int) -> Result<BlockStore, String>
    ? "Walk the last Segment's records, so the next Block lands after the last"
      "whole one. A torn final record — a crash between believing an append and"
      "finishing it — is cut off, which loses that Block rather than leaving"
      "bytes no walk can frame; it was never in the Index and is simply"
      "fetched again."
    ! [Disk.readBytesAt, Disk.size, Disk.writeBytes]
    path = segmentPath(dir, segment)
    size = Disk.size(path)?
    whole = wholeRecordsEnd(path, size, 0)?
    match whole == size
        true -> Result.Ok(BlockStore(dir = dir, state = SegmentState(segment = segment, used = size)))
        false -> repaired(dir, segment, whole)

fn wholeRecordsEnd(path: String, size: Int, headerAt: Int) -> Result<Int, String>
    ? "How far the Segment consists of whole records: walk header to header"
      "until the end of the file, or until a record the file does not fully"
      "hold — a short header or a missing tail both stop the walk there."
    ! [Disk.readBytesAt]
    match headerAt >= size
        true -> Result.Ok(headerAt)
        false -> stepPast(path, size, headerAt)

fn stepPast(path: String, size: Int, headerAt: Int) -> Result<Int, String>
    ? "Read one header and continue past its record if the Segment holds it all."
    ! [Disk.readBytesAt]
    header = Disk.readBytesAt(path, headerAt, Domain.Segment.headerBytes())?
    match Domain.Segment.lengthOf(header)
        Result.Err(e) -> Result.Ok(headerAt)
        Result.Ok(length) -> pastIfComplete(path, size, headerAt, length)

fn pastIfComplete(path: String, size: Int, headerAt: Int, length: Int) -> Result<Int, String>
    ? "A record the file holds in full is walked past; one it does not ends the walk."
    ! [Disk.readBytesAt]
    match Domain.Segment.complete(size, headerAt, length)
        true -> wholeRecordsEnd(path, size, Domain.Segment.nextHeader(headerAt, length))
        false -> Result.Ok(headerAt)

fn repaired(dir: String, segment: Int, keep: Int) -> Result<BlockStore, String>
    ? "Rewrite the Segment as its whole records only, dropping the torn tail."
    ! [Disk.readBytesAt, Disk.writeBytes]
    path = segmentPath(dir, segment)
    whole = Disk.readBytesAt(path, 0, keep)?
    _written = Disk.writeBytes(path, whole)?
    Result.Ok(BlockStore(dir = dir, state = SegmentState(segment = segment, used = keep)))

fn hexIn(names: List<String>) -> Bool
    ? "Whether the directory holds Segments in the old hex format."
    match names
        [] -> false
        [head, ..tail] -> hexOrRest(head, tail)

verify hexIn
    hexIn([]) => false
    hexIn(["blk000000.dat"]) => false
    hexIn(["blk000000.hex"]) => true
    hexIn(["notes.txt", "blk000003.hex"]) => true
    hexIn(["notes.txt", "kv"]) => false

fn hexOrRest(head: String, tail: List<String>) -> Bool
    ? "One name checked, then the rest."
    match Bool.and(String.startsWith(head, "blk"), String.endsWith(head, ".hex"))
        true -> true
        false -> hexIn(tail)

verify hexOrRest
    hexOrRest("blk000000.hex", []) => true
    hexOrRest("blk000000.dat", ["blk000001.hex"]) => true
    hexOrRest("blk000000.dat", []) => false

fn highestSegment(names: List<String>, best: Option<Int>) -> Option<Int>
    ? "The largest Segment number in the directory, ignoring anything else in it."
    match names
        [] -> best
        [head, ..tail] -> highestSegment(tail, better(best, segmentNumberOf(head)))

verify highestSegment
    highestSegment([], Option.None) => Option.None
    highestSegment(["blk000000.dat"], Option.None) => Option.Some(0)
    highestSegment(["blk000007.dat", "blk000003.dat"], Option.None) => Option.Some(7)
    highestSegment(["notes.txt"], Option.None) => Option.None
    highestSegment(["blk000400.dat"], Option.None) => Option.Some(400)

fn better(best: Option<Int>, found: Option<Int>) -> Option<Int>
    ? "Keep whichever Segment number is larger."
    match found
        Option.None -> best
        Option.Some(n) -> largest(best, n)

verify better
    better(Option.None, Option.Some(4)) => Option.Some(4)
    better(Option.Some(9), Option.None) => Option.Some(9)
    better(Option.Some(9), Option.Some(4)) => Option.Some(9)
    better(Option.Some(2), Option.Some(4)) => Option.Some(4)

fn largest(best: Option<Int>, n: Int) -> Option<Int>
    ? "The larger of a number and a number we may not have."
    match best
        Option.None -> Option.Some(n)
        Option.Some(current) -> Option.Some(higher(current, n))

verify largest
    largest(Option.None, 3) => Option.Some(3)
    largest(Option.Some(5), 3) => Option.Some(5)

fn higher(a: Int, b: Int) -> Int
    ? "The larger of two numbers."
    match a >= b
        true -> a
        false -> b

verify higher
    higher(5, 3) => 5
    higher(3, 5) => 5

fn segmentNumberOf(name: String) -> Option<Int>
    ? "The Segment a file name denotes, or nothing when it names something else."
    match Bool.and(String.startsWith(name, "blk"), String.endsWith(name, ".dat"))
        false -> Option.None
        true -> numberIn(String.slice(name, 3, String.len(name) - 4))

verify segmentNumberOf
    segmentNumberOf("blk000000.dat") => Option.Some(0)
    segmentNumberOf("blk000042.dat") => Option.Some(42)
    segmentNumberOf("blk999999.dat") => Option.Some(999999)
    segmentNumberOf("notes.txt") => Option.None
    segmentNumberOf("blk000000.hex") => Option.None
    segmentNumberOf("blk.dat") => Option.None
    segmentNumberOf("blkxxxxxx.dat") => Option.None

fn numberIn(digits: String) -> Option<Int>
    ? "The digits between the prefix and the suffix, if that is what they are."
    match Int.fromString(digits)
        Result.Err(e) -> Option.None
        Result.Ok(value) -> Option.Some(value)

verify numberIn
    numberIn("000042") => Option.Some(42)
    numberIn("") => Option.None
    numberIn("xx") => Option.None

fn currentSegment(store: BlockStore) -> Int
    ? "The Segment being appended to, which is also the last one that exists."
      "Saves every caller walking store.state.segment to find out, and is the"
      "one Segment pruning must never delete: it is where the next Block goes."
    store.state.segment

verify currentSegment
    currentSegment(BlockStore(dir = "d", state = Domain.Segment.initial())) => 0
    currentSegment(BlockStore(dir = "d", state = SegmentState(segment = 7, used = 40))) => 7

fn segmentPath(dir: String, segment: Int) -> String
    ? "Where a Segment lives."
    "{dir}/{Domain.Segment.nameOf(segment)}"

verify segmentPath
    segmentPath("blocks", 0) => "blocks/blk000000.dat"
    segmentPath("/tmp/chain", 42) => "/tmp/chain/blk000042.dat"

fn append(store: BlockStore, payload: Bytes) -> Result<Appended, String>
    ? "Put a Block at the end of the current Segment, or at the start of the next."
      "Two appends — the length header, then the payload — and the record is"
      "written before the Location is believed, so a crash anywhere in between"
      "loses the Block rather than inventing one: reopen truncates whatever"
      "tail the headers cannot frame."
    ! [Disk.appendBytes]
    blockBytes = List.len(Bytes.octets(payload))
    placement = Domain.Segment.place(store.state, blockBytes)
    path = segmentPath(store.dir, placement.location.segment)
    header = Domain.Segment.headerFor(blockBytes)?
    _header = Disk.appendBytes(path, header)?
    _payload = Disk.appendBytes(path, payload)?
    Result.Ok(Appended(store = BlockStore(dir = store.dir, state = placement.state), location = placement.location))

fn read(store: BlockStore, location: Location) -> Result<Bytes, String>
    ? "The Block a Location names: one positional read of exactly its bytes."
      "A short answer means the Segment ends before the Block the Index"
      "promised, which is a fault worth naming, not an empty Block."
    ! [Disk.readBytesAt]
    payload = Disk.readBytesAt(segmentPath(store.dir, location.segment), location.offset, location.length)?
    got = List.len(Bytes.octets(payload))
    match got == location.length
        true -> Result.Ok(payload)
        false -> Result.Err("Segment {location.segment} holds {got} of the {location.length} bytes at offset {location.offset}")

fn prune(store: BlockStore, belowSegment: Int) -> Result<Int, String>
    ? "Delete every Segment below the given one, and say how many went."
      "Pruning is prefix-shaped: the scan walks Heights upward and discards behind"
      "itself, so there is never a hole to describe — only a floor that rises."
    ! [Disk.delete, Disk.exists, Infra.Kv.getAll]
    pruneFrom(store.dir, 0, belowSegment, 0)

fn pruneFrom(dir: String, segment: Int, belowSegment: Int, deleted: Int) -> Result<Int, String>
    ? "Walk up to the floor, removing the Segments that are still there."
    ! [Disk.delete, Disk.exists]
    match segment < belowSegment
        false -> Result.Ok(deleted)
        true -> pruneOne(dir, segment, belowSegment, deleted)

fn pruneOne(dir: String, segment: Int, belowSegment: Int, deleted: Int) -> Result<Int, String>
    ? "Remove one Segment if it survives; a gap is not an error."
    ! [Disk.delete, Disk.exists]
    match Disk.exists(segmentPath(dir, segment))
        false -> pruneFrom(dir, segment + 1, belowSegment, deleted)
        true -> pruneExisting(dir, segment, belowSegment, deleted)

fn pruneExisting(dir: String, segment: Int, belowSegment: Int, deleted: Int) -> Result<Int, String>
    ? "Delete the Segment, then carry on."
    ! [Disk.delete, Disk.exists]
    _gone = Disk.delete(segmentPath(dir, segment))?
    pruneFrom(dir, segment + 1, belowSegment, deleted + 1)
