module ChainState
    intent =
        "Building the UTXO Set by connecting Blocks, one Height at a time."
        "The walk that made Stage 2 a thing you can run. Where the outputs"
        "phase records what every Block created and never looks back, this"
        "connects each Block against the Set the one below it left, so it can"
        "say that value was conserved rather than only that Outputs existed."
        "It has no range. A UTXO Set is the state after connecting every Block"
        "up to one Height, so the only thing it can be asked for is a Height"
        "to reach; where it resumes from is whatever it last recorded."
        "It starts at Height 1. Genesis is the base of the chain rather than a"
        "Block that connects -- no Peer sends its body and its Output cannot"
        "be spent, which is why the fifty coins of Block 0 are missing from"
        "the supply that can ever move."
        "A Height whose body is not held ends the walk rather than being"
        "stepped over, which is the opposite of what the outputs phase does"
        "and for a reason: a skipped Block leaves a Set that never existed,"
        "and every Block after it would be checked against a lie. The outputs"
        "keyspace can afford a gap because each entry stands alone."
        "A Block that will not connect stops the walk with the reason. That is"
        "a consensus failure, not a fault to be counted and walked past: the"
        "chain the Index is following is not one this program can follow."
        "Each step reads the next Block beside resolving this one (#233) and"
        "holds what recent Blocks made and spent in a window that is written"
        "through in batches (#247); the shape of both is in overlapped."
    exposes [Built, Setting, Stepped, build, buildFrom, begunChunk, stepOnce, endedChunk, eyeOfSetting, reachedOf, withSettingEye, sampleBuilt, sampleSetting]
    depends [Work, Wait, Infra.BlockJobs, Domain.BlockWorkJob, Bytes, Domain.AssumeValid, Infra.Metrics, Domain.Connect, Domain.Transaction, Domain.Screen, Infra.Screen, Domain.Block, Domain.Disconnect, Domain.Index, Domain.Network, Domain.Snapshot, Domain.UtxoStore, Infra.Blocks, Infra.Chain, Infra.Pace, Infra.Rewind, Infra.Store, Infra.Utxo, Domain.IndexKeys]
    effects [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.getAll, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]

record Built
    store: Store
    blocks: Int
    added: Int
    removed: Int
    fees: Int
    reached: Int
    dropped: Int
    views: List<BlockView>
    eye: Eye
    unconfirmed: List<Carried>

record Walk
    blocks: BlockStore
    counted: Built
    pace: Pace
    eye: Eye
    target: Int

fn build(network: Network, store: Store, blocks: BlockStore, to: Int, target: Int, eye: Eye) -> Result<Built, String>
    ? "Connect every Block from where the Set stands up to this Height."
      "Where it stands is asked before anything is connected, because it is a"
      "Block and not merely a Height: a reorganisation since the last walk"
      "leaves the Set holding Outputs of Blocks the chain has left, and those"
      "have to come off before anything goes on."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.getAll, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]
    buildFrom(network, store, blocks, to, target, eye, Option.None)

fn buildFrom(network: Network, store: Store, blocks: BlockStore, to: Int, target: Int, eye: Eye, sofar: Option<Built>) -> Result<Built, String>
    ? "The same walk, continuing the counts of an earlier chunk (#238)."
      "A walk built in chunks used to start each one at zero, so the metrics"
      "log's window took a fresh chunk's few Blocks for the whole window's."
      "Everything the earlier chunk counted -- Blocks, Outputs, fees, the"
      "Blocks dropped realigning, the views and the unconfirmed -- is the"
      "starting point here, and the Store and the Eye are the caller's."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.getAll, Infra.Kv.putAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]
    begun = begunChunk(network, store, blocks, to, target, eye, sofar)?
    endedChunk(walked(begun)?)

record Setting
    network: Network
    walk: Walk
    window: Window
    height: Int
    to: Int
    reading: Option<Reading>
    ahead: Option<Ahead>
    connecting: Option<Work.Job>
    next: Option<Reading>

type Stepped
    Waiting(Setting, Work.Job)
    Connected(Setting)
    Finished(Setting)

fn begunChunk(network: Network, store: Store, blocks: BlockStore, to: Int, target: Int, eye: Eye, sofar: Option<Built>) -> Result<Setting, String>
    ? "A chunk of the walk set up and nothing read yet: the Set taken back"
      "to the fork first, then the counts continued from sofar, with an"
      "empty window. Every Block after this is one stepOnce at a time, so"
      "whoever drives the walk decides what to do while a job runs."
    ! [Console.print, Disk.readBytesAt, Infra.Kv.applyAll, Infra.Kv.get, Time.unixMs]
    aligned = Infra.Rewind.realigned(store, blocks, eye)?
    _said = saidRangeIfPlain(eye, aligned.from, to, target)
    Result.Ok(Setting(network = network, walk = Walk(blocks = blocks, counted = continuing(sofar, aligned.store, aligned.from - 1, aligned.dropped, eye, aligned.unconfirmed), pace = Infra.Pace.pacedFrom(Time.unixMs()), eye = eye, target = target), window = Infra.Utxo.emptyWindow(), height = aligned.from, to = to, reading = Option.None, ahead = Option.None, connecting = Option.None, next = Option.None))

fn walked(setting: Setting) -> Result<Setting, String>
    ? "The chunk walked to its end by a caller with nothing else to do"
      "while a job runs: one wait on the job alone, then the next step."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]
    match stepOnce(setting)?
        Stepped.Waiting(waiting, job) -> walkedAfter(waiting, Wait.poll({0 => Wait.Item.Job(job)}, 100))
        Stepped.Connected(next) -> walked(next)
        Stepped.Finished(done) -> Result.Ok(done)

fn walkedAfter(setting: Setting, polled: Result<List<Int>, String>) -> Result<Setting, String>
    ? "The job reported, or a tenth of a second passed; either way, ask it again."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
        Wait.poll,
        Work.cancel,
    ]
    _ready = polled?
    walked(setting)

fn stepOnce(setting: Setting) -> Result<Stepped, String>
    ? "One step of the walk that does not wait: a job asked whether it has"
      "finished, or begun. Waiting names the job the caller should wait on"
      "before asking again; Connected is one Block into the window; Finished"
      "is a chunk with nothing left in it -- the end of the range, a Height"
      "whose body is not held, or a stop asked for."
      "Each step reads the next Block beside resolving this one (#233): the"
      "connect job for Height h and the decode job for h + 1 run at once."
    ! [
        Console.print,
        Disk.appendText, Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.applyAll, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
        Work.cancel,
    ]
    match setting.connecting
        Option.Some(job) -> connectTaken(setting, job, Infra.BlockJobs.take(job))
        Option.None -> aheadOr(setting)

fn aheadOr(setting: Setting) -> Result<Stepped, String>
    ? "A Block decoded and not yet connected is connected next."
    ! [
        Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Work.cancel,
    ]
    match setting.ahead
        Option.Some(this) -> connectingFrom(setting, this)
        Option.None -> readingOr(setting)

fn readingOr(setting: Setting) -> Result<Stepped, String>
    ? "A decode already begun is asked about; otherwise the next Block is read."
    ! [
        Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.BlockJobs.take, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Work.cancel,
    ]
    match setting.reading
        Option.Some(reading) -> decodeTaken(setting, reading, Infra.BlockJobs.take(reading.job))
        Option.None -> readingNow(setting)

fn readingNow(setting: Setting) -> Result<Stepped, String>
    ? "The stop flag and the Screen's q, asked before every Block, then the"
      "Block read off the disk and its decode begun. Nothing fetched ends"
      "the chunk: a Height the Index does not name, or a body not held."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin, Infra.Kv.get, Process.stopRequested]
    match Bool.or(setting.height > setting.to, Bool.or(Process.stopRequested(), setting.walk.eye.stopped))
        true -> Result.Ok(Stepped.Finished(setting))
        false -> match fetched(setting.walk.counted.store, setting.walk.blocks, setting.height)?
            Option.None -> Result.Ok(Stepped.Finished(setting))
            Option.Some(one) -> Result.Ok(Stepped.Waiting(Setting.update(setting, reading = Option.Some(one)), one.job))

fn decodeTaken(setting: Setting, reading: Reading, taken: Result<Option<Infra.BlockJobs.Reply>, String>) -> Result<Stepped, String>
    ? "A decode not finished yet is waited on again; a finished one is connected."
    ! [
        Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Work.cancel,
    ]
    match taken?
        Option.None -> Result.Ok(Stepped.Waiting(setting, reading.job))
        Option.Some(reply) -> decodedInto(setting, decodedAhead(reading.height, reading.blockId, reading.location, decodedTransactions(reply))?)

fn decodedInto(setting: Setting, ahead: Option<Ahead>) -> Result<Stepped, String>
    ? "The decoded Block, connected next."
    ! [
        Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Work.cancel,
    ]
    match ahead
        Option.None -> Result.Ok(Stepped.Finished(Setting.update(setting, reading = Option.None)))
        Option.Some(this) -> connectingFrom(Setting.update(setting, reading = Option.None, ahead = Option.Some(this)), this)

fn connectingFrom(setting: Setting, this: Ahead) -> Result<Stepped, String>
    ? "The stop flag again, then this Block's inputs split between the"
      "window and the Store."
    ! [
        Disk.readBytesAt,
        Infra.BlockJobs.begin, Infra.Kv.get, Infra.Kv.getAll,
        Process.stopRequested,
        Work.cancel,
    ]
    match Bool.or(this.height > setting.to, Bool.or(Process.stopRequested(), setting.walk.eye.stopped))
        true -> Result.Ok(Stepped.Finished(setting))
        false -> connectBegun(setting, this, Infra.Utxo.partitioned(this.transactions, setting.window.created, setting.window.spent)?)

fn connectBegun(setting: Setting, this: Ahead, split: Infra.Utxo.Split) -> Result<Stepped, String>
    ? "This Block's inputs resolved against the Store, the next Block's"
      "decode begun, and this Block's connection begun beside it."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin, Infra.Kv.get, Infra.Kv.getAll, Work.cancel]
    inputs = Infra.Utxo.resolvedFor(setting.walk.counted.store, split)?
    held = Infra.Utxo.alreadyHeld(setting.walk.counted.store, setting.window.created, this.transactions)?
    next = readNext(setting.walk.counted.store, setting.walk.blocks, this.height + 1, setting.to)?
    connectJobFor(setting, next, Infra.BlockJobs.begin(Domain.BlockWorkJob.connectionTask(setting.network, this.height, this.transactions, inputs, held)))

fn connectJobFor(setting: Setting, next: Option<Reading>, begun: Result<Work.Job, String>) -> Result<Stepped, String>
    ? "A connection that would not begin lets the lookahead go with it."
    ! [Work.cancel]
    match begun
        Result.Err(why) -> failedAfter(next, why)
        Result.Ok(job) -> Result.Ok(Stepped.Waiting(Setting.update(setting, connecting = Option.Some(job), next = next), job))

fn failedAfter(next: Option<Reading>, why: String) -> Result<Stepped, String>
    ? "The lookahead cancelled, then the reason handed on."
    ! [Work.cancel]
    _cancelled = cancelReading(next)
    Result.Err(why)

fn connectTaken(setting: Setting, job: Work.Job, taken: Result<Option<Infra.BlockJobs.Reply>, String>) -> Result<Stepped, String>
    ? "A connection not finished yet is waited on again; a finished one goes"
      "into the window."
    ! [
        Console.print,
        Disk.appendText,
        Infra.Kv.applyAll,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
    ]
    match taken?
        Option.None -> Result.Ok(Stepped.Waiting(setting, job))
        Option.Some(answer) -> absorbedFrom(setting, answer)

fn absorbedFrom(setting: Setting, answer: Infra.BlockJobs.Reply) -> Result<Stepped, String>
    ? "The Block the connection was for, into the window and counted."
      "The window's parts are bound by a match and the Setting carried on"
      "holds an empty window, so the parts have exactly one use here, the"
      "call that absorbs the Block, and are moved into it: nothing else"
      "holds a Map when it is set (#227). Absorbed while the Setting still"
      "held them, every Block copied the whole window once."
    ! [
        Console.print,
        Disk.appendText,
        Infra.Kv.applyAll,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
    ]
    match setting.ahead
        Option.None -> Result.Err("a connection landed with no Block waiting for it")
        Option.Some(this) -> match (setting.window.created, setting.window.spent, setting.window.undos, setting.window.held)
            (created, spent, undos, held) -> absorbedInto(Setting.update(setting, window = Infra.Utxo.emptyWindow()), this, Infra.Utxo.absorbed(created, spent, undos, held, this.height, this.blockId, Domain.BlockWorkJob.connection(answer)))

fn absorbedInto(setting: Setting, this: Ahead, absorbed: Result<Tuple<Map<Bytes, Unspent>, Map<Bytes, Bool>, List<Entry>, Int, Option<Reached>, Absorbed>, String>) -> Result<Stepped, String>
    ? "The window moved on and the Block counted, which is also where the"
      "Screen and the metrics log hear about it. The parts come back through"
      "a tuple bound by the match, so each is moved on into the window kept."
    ! [
        Console.print,
        Disk.appendText,
        Infra.Kv.applyAll,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
    ]
    match absorbed
        Result.Err(why) -> Result.Err(why)
        Result.Ok((createdNow, spentNow, undosNow, heldNow, standing, counts)) -> advanced(setting, recorded(setting.network, setting.walk, this.height, this.blockId, counts.added, counts.removed, counts.fees, counts.confirmed, BlockView(height = this.height, blockId = this.blockId, transactions = List.len(this.transactions), bytes = this.location.length, atMs = Time.unixMs()))?, Window(created = createdNow, spent = spentNow, undos = undosNow, held = heldNow, standing = standing))

fn advanced(setting: Setting, walk: Walk, window: Window) -> Result<Stepped, String>
    ? "The window written through when it has grown past its bound (#247);"
      "the lookahead becomes the next Block's read."
    ! [Infra.Kv.applyAll]
    match Infra.Utxo.flushDue(window.held)
        false -> Result.Ok(Stepped.Connected(Setting.update(setting, walk = walk, window = window, height = setting.height + 1, reading = setting.next, ahead = Option.None, connecting = Option.None, next = Option.None)))
        true -> Result.Ok(Stepped.Connected(Setting.update(setting, walk = withStore(walk, Infra.Utxo.flushed(walk.counted.store, window)?), window = Infra.Utxo.emptyWindow(), height = setting.height + 1, reading = setting.next, ahead = Option.None, connecting = Option.None, next = Option.None)))

fn endedChunk(setting: Setting) -> Result<Built, String>
    ? "The chunk over: any job still running cancelled, the window written,"
      "Undo Data below the window pruned, and the claim line said."
    ! [
        Console.print,
        Infra.Kv.applyAll, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.putAll,
        Process.stopRequested,
        Time.unixMs,
        Work.cancel,
    ]
    _cancelled = cancelledAll(setting)
    counted = Built.update(setting.walk.counted, eye = stopNoted(setting.walk.counted.eye, Process.stopRequested(), Time.unixMs()))
    swept = Infra.Utxo.prunedUndo(Infra.Utxo.flushed(counted.store, setting.window)?, counted.reached)?
    _told = toldIfPlain(counted.eye, swept, counted.reached)?
    Result.Ok(counting(counted, swept))

fn cancelledAll(setting: Setting) -> Unit
    ? "Every job the chunk still holds, let go."
    ! [Work.cancel]
    _reading = cancelReading(setting.reading)
    _next = cancelReading(setting.next)
    match setting.connecting
        Option.None -> Unit
        Option.Some(job) -> Work.cancel(job)

fn eyeOfSetting(setting: Setting) -> Eye
    ? "The Eye the chunk is drawing and logging with."
    setting.walk.counted.eye

fn reachedOf(setting: Setting) -> Int
    ? "The last Height the chunk connected."
    setting.walk.counted.reached

fn withSettingEye(setting: Setting, eye: Eye) -> Setting
    ? "The chunk, carrying an Eye the node has moved on since the last step."
    Setting.update(setting, walk = Walk.update(setting.walk, eye = eye, counted = Built.update(setting.walk.counted, eye = eye)))

fn saidRangeIfPlain(eye: Eye, from: Int, to: Int, target: Int) -> Unit
    ? "The range line for the plain log; the Screen draws the walk instead."
    ! [Console.print]
    match plainly(eye)
        true -> saidRange(from, to, target)
        false -> Unit

fn plainly(eye: Eye) -> Bool
    ? "Whether this walk speaks in printed lines; the Screen draws instead."
    match eye.view
        Option.None -> true
        Option.Some(view) -> false

verify plainly
    plainly(Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none())) => true
    plainly(Infra.Screen.watchedBy(Option.Some(Domain.Screen.opened()), Domain.Snapshot.started(0), Infra.Metrics.none(), 0, Option.None)) => false

fn saidRange(from: Int, to: Int, target: Int) -> Unit
    ? "Say what is about to be connected, when anything is."
      "A node following the tip runs this every time any Peer announces a"
      "Block, and most of those announce a Block it already has -- so the"
      "usual case is a range with nothing in it, and 'connecting 107..106'"
      "is not a sentence. Silence is the honest report of no work."
      "The target is named as well as the range because since #217 a plain"
      "catch-up prints one of these per 250-Block chunk, and a reader"
      "watching them go by has no other way to tell 3,857 of them from four."
    ! [Console.print]
    match from > to
        true -> Unit
        false -> Console.print("utxo    connecting {from}..{to} of {target}")

fn continuing(sofar: Option<Built>, store: Store, reached: Int, dropped: Int, eye: Eye, unconfirmed: List<Carried>) -> Built
    ? "Where a chunk starts counting: at zero, or where the last one left off."
    match sofar
        Option.None -> Built(store = store, blocks = 0, added = 0, removed = 0, fees = 0, reached = reached, dropped = dropped, views = [], eye = eye, unconfirmed = unconfirmed)
        Option.Some(before) -> Built(store = store, blocks = before.blocks, added = before.added, removed = before.removed, fees = before.fees, reached = reached, dropped = before.dropped + dropped, views = before.views, eye = eye, unconfirmed = List.concat(before.unconfirmed, unconfirmed))

verify continuing
    continuing(Option.None, Infra.Store.fixture([]), 4, 1, Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), []).blocks => 0
    continuing(Option.None, Infra.Store.fixture([]), 4, 1, Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), []).reached => 4
    continuing(Option.Some(Built(store = Infra.Store.fixture([]), blocks = 9, added = 20, removed = 7, fees = 3, reached = 12, dropped = 2, views = [], eye = Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), unconfirmed = [])), Infra.Store.fixture([]), 12, 1, Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), []).blocks => 9
    continuing(Option.Some(Built(store = Infra.Store.fixture([]), blocks = 9, added = 20, removed = 7, fees = 3, reached = 12, dropped = 2, views = [], eye = Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), unconfirmed = [])), Infra.Store.fixture([]), 12, 1, Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), []).dropped => 3

fn counting(counted: Built, store: Store) -> Built
    ? "The counts, carrying the Store the walk finished with."
      "Handed back rather than dropped because a caller that goes round again"
      "-- a node following a tip does, every Block -- has to carry the Store"
      "the last round left, exactly as every other phase in this program does."
    Built(store = store, blocks = counted.blocks, added = counted.added, removed = counted.removed, fees = counted.fees, reached = counted.reached, dropped = counted.dropped, views = counted.views, eye = counted.eye, unconfirmed = counted.unconfirmed)

record Ahead
    height: Int
    blockId: String
    location: Location
    transactions: List<Domain.Transaction.Transaction>

record Reading
    height: Int
    blockId: String
    location: Location
    job: Work.Job

fn stopNoted(eye: Eye, asked: Bool, nowMs: Int) -> Eye
    ? "If the walk is ending because a stop was asked for, the Eye keeps"
      "when (#268)."
    match asked
        false -> eye
        true -> Infra.Screen.stopAskedAt(eye, nowMs)

verify stopNoted
    stopNoted(Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), false, 5).stopAskedMs => 0
    stopNoted(Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), true, 5).stopAskedMs => 5

fn withStore(state: Walk, store: Store) -> Walk
    ? "The walk, its Store moved on by a flush."
    Walk(blocks = state.blocks, counted = counting(state.counted, store), pace = state.pace, eye = state.eye, target = state.target)

fn fetched(store: Store, blocks: BlockStore, height: Int) -> Result<Option<Reading>, String>
    ? "The Block at a Height, read off the disk and handed to a decode job,"
      "if the Index names one and its body is held."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin, Infra.Kv.get]

    fetchedNamed(store, blocks, height, Domain.Index.blockIdIn(Infra.Store.get(store, Domain.IndexKeys.heightKey(height)?)?))

fn fetchedNamed(store: Store, blocks: BlockStore, height: Int, named: Option<String>) -> Result<Option<Reading>, String>
    ? "A Height the Index does not name is nothing to fetch, and is the end"
      "of the chain we hold: h: names a prefix, so the first Height it does"
      "not name is above everything we have."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin, Infra.Kv.get]

    match named
        Option.None -> Result.Ok(Option.None)
        Option.Some(blockId) -> fetchedHeld(store, blocks, height, blockId)

fn fetchedHeld(store: Store, blocks: BlockStore, height: Int, blockId: String) -> Result<Option<Reading>, String>
    ? "A Height the Index does name, whose body may or may not be held."
      "Why it is absent is the whole of #302. It used to be read as the end"
      "of the walk either way, so a prune that had crossed above where the"
      "Set stood was reported as the target reached and the Set silently"
      "stopped short. Domain.Index.bodyStateOf has drawn the distinction"
      "since pruning was written -- show and spend have always asked it --"
      "and the walk simply never did."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin, Infra.Kv.get]

    located = Infra.Store.get(store, Domain.IndexKeys.blockKey(blockId)?)?
    below = Infra.Chain.watermark(store)?
    fetchedLocated(blocks, height, blockId, Domain.Index.bodyStateOf(located, height, below)?)

fn fetchedLocated(blocks: BlockStore, height: Int, blockId: String, state: BodyState) -> Result<Option<Reading>, String>
    ? "Held, never fetched, or deliberately deleted."
      "Never fetched ends the walk, which is what an interrupted download"
      "leaves and is not a fault. Pruned is a fault and says so: the Index"
      "names the Height, so the chain goes on past here and the walk cannot,"
      "and reporting the target reached would be a lie about a Set that"
      "stopped short."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin]

    match state
        BodyState.Missing -> Result.Ok(Option.None)
        BodyState.Pruned -> Result.Err("Height {height}, Block {blockId}, was pruned; the Set cannot be built past it without those bodies")
        BodyState.Stored(location) -> fetchedAt(blocks, height, blockId, location)

fn fetchedAt(blocks: BlockStore, height: Int, blockId: String, location: Location) -> Result<Option<Reading>, String>
    ? "Read the Block and put the decoding of its Transactions on a job."
      "The bytes are hashed against the Block Id the Index filed them under"
      "(#283, #280 item 8): a Segment's tail can be torn by a crash after the"
      "Location that names it was synced, and the next download writes at"
      "that offset. Before this the wrong Block's Transactions would have"
      "been connected under the right Id. Either failure names the Height,"
      "because it is the chain directory that is wrong and no Peer."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin]

    payload = Infra.Blocks.read(blocks, location)?
    match Domain.Block.idOfWholeBlock(payload) == blockId
        false -> Result.Err("the body filed for Height {height} hashes to {Domain.Block.idOfWholeBlock(payload)}, not the {blockId} the Index names; the chain directory needs reindex")
        true -> Result.Ok(Option.Some(Reading(height = height, blockId = blockId, location = location, job = Infra.BlockJobs.begin(Infra.BlockJobs.Task.Decode(payload))?)))

fn decodedAhead(height: Int, blockId: String, location: Location, transactions: Result<List<Domain.Transaction.Transaction>, String>) -> Result<Option<Ahead>, String>
    ? "The Transactions, or the reason the body on disk has none."
    match transactions
        Result.Err(why) -> Result.Err("the body filed for Height {height}, Block {blockId}, would not decode: {why}; the chain directory needs reindex")
        Result.Ok(decoded) -> Result.Ok(Option.Some(Ahead(height = height, blockId = blockId, location = location, transactions = decoded)))

verify decodedAhead
    decodedAhead(5, "aa", Location(segment = 0, offset = 0, length = 0), Result.Err("no")) => Result.Err("the body filed for Height 5, Block aa, would not decode: no; the chain directory needs reindex")
    decodedAhead(5, "aa", Location(segment = 0, offset = 0, length = 0), Result.Ok([])) => Result.Ok(Option.Some(Ahead(height = 5, blockId = "aa", location = Location(segment = 0, offset = 0, length = 0), transactions = [])))

fn recorded(network: Network, state: Walk, height: Int, blockId: String, added: Int, removed: Int, fees: Int, confirmed: List<TxFee>, view: BlockView) -> Result<Walk, String>
    ? "Count it. Where the Set stands is written with the window (#247)."
      "Written every Block rather than at the end, because a walk that stopped"
      "would otherwise leave a Set whose contents and whose recorded standing"
      "disagree -- and the standing is the only thing that says what the Set"
      "means. The Block Id goes down beside the Height because a Height alone"
      "would stop being true the next time h: is re-pointed."
    ! [
        Console.print,
        Disk.appendText,
        Tcp.accept, Tcp.close, Tcp.readNow, Tcp.writeNow,
        Terminal.clear, Terminal.flush, Terminal.moveTo, Terminal.print, Terminal.readKey,
        Time.now, Time.unixMs,
    ]
    watched = Infra.Screen.blockWatched(state.eye, view)?
    setRecord = Infra.Metrics.marked(watched.log, "set", height, state.target, state.counted.blocks, 0, 0, 0, watched.candidates, state.counted.added, state.counted.removed, false)?
    looked = Infra.Screen.glanced(Infra.Screen.logging(Infra.Screen.eyeing(watched, Domain.Snapshot.withCandidates(confirmedInto(Domain.Snapshot.setsAt(state.eye.snapshot, height, state.target, view.atMs), confirmed, view.atMs), state.eye.candidates)), setRecord), view.atMs)?
    counted = Built(store = state.counted.store, blocks = state.counted.blocks + 1, added = state.counted.added + added, removed = state.counted.removed + removed, fees = state.counted.fees + fees, reached = height, dropped = state.counted.dropped, views = List.take(List.prepend(view, state.counted.views), Domain.Snapshot.blockLimit()), eye = looked, unconfirmed = state.counted.unconfirmed)
    stepped = maybeReportIfPlain(looked, height, counted, state.pace)?
    Result.Ok(Walk(blocks = state.blocks, counted = counted, pace = stepped, eye = looked, target = state.target))

fn confirmedInto(snapshot: Snapshot, confirmed: List<TxFee>, nowMs: Int) -> Snapshot
    ? "Every Transaction this Block confirmed, into the ring with the fee"
      "connect computed for it (#133). Block order in, so the newest ends"
      "up at the front of the ring."
    match confirmed
        [] -> snapshot
        [head, ..tail] -> confirmedInto(Domain.Snapshot.notedTransaction(snapshot, TxView(txId = head.txid, fee = head.fee, coinbase = head.coinbase, atMs = nowMs, confirmed = true)), tail, nowMs)

verify confirmedInto
    confirmedInto(Domain.Snapshot.started(0), [], 9).rings.transactions => []
    List.len(confirmedInto(Domain.Snapshot.started(0), [TxFee(txid = "cb", fee = 0, coinbase = true), TxFee(txid = "bb", fee = 10, coinbase = false)], 9).rings.transactions) => 2
    confirmedInto(Domain.Snapshot.started(0), [TxFee(txid = "cb", fee = 0, coinbase = true), TxFee(txid = "bb", fee = 10, coinbase = false)], 9).rings.transactions => [TxView(txId = "bb", fee = 10, coinbase = false, atMs = 9, confirmed = true), TxView(txId = "cb", fee = 0, coinbase = true, atMs = 9, confirmed = true)]

fn maybeReportIfPlain(eye: Eye, height: Int, counted: Built, pace: Pace) -> Result<Pace, String>
    ? "The minute line for the plain log; the Screen draws the walk instead."
    ! [Console.print, Time.now, Time.unixMs]
    match plainly(eye)
        true -> maybeReport(height, counted, pace)
        false -> Result.Ok(pace)

fn maybeReport(height: Int, counted: Built, pace: Pace) -> Result<Pace, String>
    ? "Say where the walk has got to, about once a minute."
    ! [Console.print, Time.now, Time.unixMs]
    nowMs = Time.unixMs()
    match Infra.Pace.due(pace, nowMs, counted.blocks)
        false -> Result.Ok(pace)
        true -> reported(height, counted, pace, nowMs)

fn reported(height: Int, counted: Built, pace: Pace, nowMs: Int) -> Result<Pace, String>
    ? "One progress line, and the Pace the next one measures from."
      "Outputs into the Set and out of it, because those are what the work is"
      "and the Block rate says little once Blocks stop being small."
    ! [Console.print, Time.now]
    _said = Console.print("  {Time.now()}  height {height}: {counted.blocks} blocks, set +{counted.added} -{counted.removed}, recent {Infra.Pace.perSecond(counted.blocks - pace.lastBlocks, nowMs - pace.lastMs)} blocks/s {Infra.Pace.perSecond(counted.added - pace.lastItems, nowMs - pace.lastMs)} outputs/s, overall {Infra.Pace.perSecond(counted.blocks, nowMs - pace.startedMs)} blocks/s")
    Result.Ok(Infra.Pace.advanced(pace, nowMs, counted.blocks, counted.added))

fn toldIfPlain(eye: Eye, store: Store, reached: Int) -> Result<Unit, String>
    ? "The claim line for the plain log."
      "Under the Screen it is skipped: the fact belongs on a Panel, and a"
      "printed line would stair-step the frame. The claim itself is still"
      "checked on every audit, which is where Broken stops being a line and"
      "becomes a verdict."
    ! [Console.print, Infra.Kv.get]
    match plainly(eye)
        true -> claimTold(store, reached)
        false -> Result.Ok(Unit)

fn claimTold(store: Store, reached: Int) -> Result<Unit, String>
    ? "Say what the Assume-valid Height covered, and whether it still holds."
      "Printed at the end of every walk rather than only when it is set,"
      "because a claim nobody restates is a claim nobody checks."
    ! [Console.print, Infra.Kv.get]
    held = Infra.Store.get(store, Domain.AssumeValid.claimKey()?)?
    claim = claimIn(held)?
    standingTold(store, claim, reached)

fn claimIn(held: Option<Bytes>) -> Result<Option<Claim>, String>
    ? "The claim the Store holds, if it holds one."
    match held
        Option.None -> Result.Ok(Option.None)
        Option.Some(stored) -> someClaim(Domain.AssumeValid.decodeClaim(stored))

verify claimIn
    claimIn(Option.None) => Result.Ok(Option.None)
    claimIn(Option.Some(Domain.AssumeValid.encodeClaim(Claim(height = 100, blockId = "aa"))?)) => Result.Ok(Option.Some(Claim(height = 100, blockId = "aa")))
    claimIn(Option.Some(Domain.Index.emptyBytes())) => Result.Err("an Assume-valid claim is at least 4 bytes, got 0")

fn someClaim(decoded: Result<Claim, String>) -> Result<Option<Claim>, String>
    ? "A claim that will not decode is corruption."
    match decoded
        Result.Err(why) -> Result.Err(why)
        Result.Ok(claim) -> Result.Ok(Option.Some(claim))

verify someClaim
    someClaim(Result.Ok(Claim(height = 1, blockId = "aa"))) => Result.Ok(Option.Some(Claim(height = 1, blockId = "aa")))
    someClaim(Result.Err("no")) => Result.Err("no")

fn standingTold(store: Store, claim: Option<Claim>, reached: Int) -> Result<Unit, String>
    ? "Look up what the Index names at the claimed Height, and report."
    ! [Console.print, Infra.Kv.get]
    namedNow = heldAt(store, claim)?
    Result.Ok(said(Domain.AssumeValid.standing(claim, namedNow), Domain.AssumeValid.skippedBelow(claim, reached)))

fn heldAt(store: Store, claim: Option<Claim>) -> Result<Option<String>, String>
    ? "What h: names at the claimed Height, if there is a claim to check."
    ! [Infra.Kv.get]
    match claim
        Option.None -> Result.Ok(Option.None)
        Option.Some(held) -> namedAt(Infra.Store.get(store, Domain.IndexKeys.heightKey(held.height)?))

fn namedAt(found: Result<Option<Bytes>, String>) -> Result<Option<String>, String>
    ? "The Block Id h: holds at the claimed Height, spelled the way the report reads it."
    Result.Ok(Domain.Index.blockIdIn(found?))

fn said(standing: Standing, skipped: Int) -> Unit
    ? "One line, and a loud one when the claim has been undermined."
      "These lines used to say that Scripts above the claimed Height had been"
      "run and Scripts below it had not. Neither was true (#303): this walk"
      "runs no Scripts at any Height -- Domain.Connect has no Script"
      "dependency and never has -- so there was nothing to defer and nothing"
      "to compare the deferral against. What the claim actually is is a"
      "record of which range audit may take as settled, and a tripwire for a"
      "Reorganisation moving the Block it pinned. The lines say that now."
    ! [Console.print]
    match standing
        Standing.Unset -> Console.print("no Assume-valid Height is set, so audit takes nothing on trust; the Set phase runs no Scripts at any Height either way (ADR 0007)")
        Standing.Holding(height) -> Console.print("Assume-valid Height {height} still pins its Block: {skipped} Block(s) audit may take as settled; the Set phase runs no Scripts at any Height (ADR 0007)")
        Standing.Broken(height, why) -> broken(height, why)

fn broken(height: Int, why: String) -> Unit
    ? "The claim pinned a Block the Index no longer names at that Height."
    ! [Console.print]
    Console.print("ASSUME-VALID BROKEN at Height {height}: {why}. The skipped Blocks are not the Blocks there now; re-run audit over that range or clear the claim")

fn readNext(store: Store, blocks: BlockStore, height: Int, to: Int) -> Result<Option<Reading>, String>
    ? "The Block one Height further on, unless that is past what the caller"
      "asked to reach."
      "The Index may well name it and hold its body. Reading it would cost"
      "a Segment read and a decode of a Block this walk is not going to"
      "connect."
    ! [Disk.readBytesAt, Infra.BlockJobs.begin, Infra.Kv.get]
    match height > to
        true -> Result.Ok(Option.None)
        false -> fetched(store, blocks, height)

fn cancelReading(reading: Option<Reading>) -> Unit
    ? "The lookahead let go, whichever way this step is leaving."
      "Cancelling a job whose answer has already been taken does nothing,"
      "so this can run on every path rather than only the failing ones."
    ! [Work.cancel]
    match reading
        Option.None -> Unit
        Option.Some(one) -> Work.cancel(one.job)

fn decodedTransactions(reply: Infra.BlockJobs.Reply) -> Result<List<Domain.Transaction.Transaction>, String>
    ? "The reply read back as Transactions, or the reason the job refused"
      "the body it was given."
      "A connection result arriving here would mean two jobs had been"
      "mistaken for one another, so it is refused by name rather than"
      "quietly read as a Block with nothing in it."
    match reply
        Infra.BlockJobs.Reply.Refused(why) -> Result.Err(why)
        Infra.BlockJobs.Reply.Decoded(txs) -> Result.Ok(txs)
        Infra.BlockJobs.Reply.Connected(_) -> Result.Err("a connection result cannot settle a decode job")

verify decodedTransactions
    decodedTransactions(Infra.BlockJobs.Reply.Refused("bad body")) => Result.Err("bad body")
    decodedTransactions(Infra.BlockJobs.Reply.Decoded([])) => Result.Ok([])

fn sampleBuilt(reached: Int) -> Built
    ? "A chunk that connected nothing and stands at this Height, for the cases elsewhere."
    Built(store = Infra.Store.fixture([]), blocks = 0, added = 0, removed = 0, fees = 0, reached = reached, dropped = 0, views = [], eye = Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), unconfirmed = [])

verify sampleBuilt
    sampleBuilt(7).reached => 7

fn sampleSetting(height: Int) -> Setting
    ? "A chunk about to read this Height, holding no job, for the cases elsewhere."
    Setting(network = Network.Regtest, walk = Walk(blocks = Infra.Blocks.fixture("d"), counted = sampleBuilt(height - 1), pace = Infra.Pace.pacedFrom(0), eye = Infra.Screen.unwatched(Domain.Snapshot.started(0), Infra.Metrics.none()), target = height), window = Infra.Utxo.emptyWindow(), height = height, to = height, reading = Option.None, ahead = Option.None, connecting = Option.None, next = Option.None)

verify sampleSetting
    sampleSetting(5).height => 5
    reachedOf(sampleSetting(5)) => 4
