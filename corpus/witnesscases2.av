module WitnessCases2
    intent =
        "The Witness rows of Bitcoin Core's script_tests.json: part 2 of 3."
        "A Witness belongs to an Input and these rows do not carry one, so"
        "Core's harness builds two Transactions around each pair and this"
        "reproduces that construction exactly -- BuildCreditingTransaction and"
        "BuildSpendingTransaction from src/test/util/transaction_utils.cpp."
        "That makes them whole Transactions spending one known Output, which"
        "is the shape Domain.TxCase runs, so they join the corpus there rather"
        "than beside the Script pairs."
        "The answer recorded is this engine's, not Core's, so this is a"
        "regression corpus and not a conformance one. What Core says is on the"
        "comment above each case, and where the two differ the case records"
        "what this engine does today."
        "Each case carries the rules Core ran it under, built from the flag"
        "names in the row. script_tests.json passes its flags to VerifyScript"
        "as they stand, so these read Domain.Rules.underFlags -- unlike"
        "tx_valid.json, which names the flags to leave out."
        "Standing as this was generated: 108 cases, 108 agree with"
        "Core, 0 disagree, 0 this engine cannot answer. Of"
        "the disagreements, 0 are a rule this engine does not implement and"
        "0 are this engine refusing what Core accepts -- which is the"
        "direction a defect shows up in, so any of those is a bug until shown"
        "otherwise."
        "Nothing here was written by hand and nothing should be. Regenerate it"
        "with tools/witness_tests_to_aver.py."
    exposes [case]
    depends [Domain.Rules, Domain.ScriptState, Domain.TxCase]
    effects []

fn case(rawHex: String, prevouts: List<Prevout>, rules: Rules) -> Outcome
    ? "One whole Transaction, its single Input run against the Output Core's"
      "harness credited it with, under the rules the row's flags ask for."
    Domain.TxCase.verdict(rawHex, prevouts, rules)

verify case
    // Core: valid  flags P2SH,WITNESS,WITNESS_PUBKEYTYPE  -- P2WSH CHECKMULTISIG with compressed keys
    case("", [Prevout(txid = "43212a94e4fbd6b0b086ba7a908f7409bcb7b7e60ea138e126559ac09adcd850", index = 0, script = "002006c24420938f0fa3c1cb2707d867154220dca365cdbfa0dd2a83854730221460", amount = 1)], Domain.Rules.underFlags(["P2SH", "WITNESS", "WITNESS_PUBKEYTYPE"])) => Outcome.Decided(Ending.Passed)
    // Core: valid  flags P2SH,WITNESS,WITNESS_PUBKEYTYPE  -- P2SH(P2WSH) CHECKMULTISIG with compressed keys
    case("", [Prevout(txid = "87bac67d0abc26a28d9175bb229b1ba55192471d1804027fdc280c8f864b16f9", index = 0, script = "a91426282aad7c29369d15fed062a778b6100d31a34087", amount = 1)], Domain.Rules.underFlags(["P2SH", "WITNESS", "WITNESS_PUBKEYTYPE"])) => Outcome.Decided(Ending.Passed)
