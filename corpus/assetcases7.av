module AssetCases7
    intent =
        "Bitcoin Core's own script_assets_test.json, entries 1501 to 1750 of 2244, as"
        "verify cases: part 7 of 9."
        "The only published corpus that tests tapscript execution. Two spenders"
        "per entry and they are opposite claims: success must pass and failure"
        "must fail, so every case expects the same word, PASS, meaning this"
        "engine agreed with the file. The claim is Core's, never the engine's."
        "Nothing here was written by hand and nothing should be. Regenerate it"
        "with tools/script_assets_to_aver.py. n1bor/btc-listener#101."
    exposes [case]
    depends [Domain.AssetSweep]
    effects []

fn case(tx: String, prevouts: List<String>, index: Int, flags: String, scriptSig: String, witness: List<String>, mustPass: Bool) -> String
    ? "One spender of one entry, judged against the file's claim about it."
    Domain.AssetSweep.judged(tx, prevouts, index, flags, scriptSig, witness, mustPass)

verify case
