fn hashPrevouts(rawHex: String) -> Result<String, String>
    ? "Every outpoint, hashed once."
    Result.Ok(hexOf(Domain.Bip341.hashPrevouts(Domain.Transaction.inputsOf(decoded(rawHex)?))))

verify hashPrevouts
    hashPrevouts("") => Result.Ok("e3b33bb4ef3a52ad1fffb555c0d82828eb22737036eaeb02a235d82b909c4c3f")
    // The refusal arm, which no vector can reach: the raw hex must parse.
    hashPrevouts("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn hashAmounts(prevouts: List<Spent>) -> String
    ? "Every spent amount, hashed once."
      "New in BIP341, and the reason a Taproot signer cannot be lied to about"
      "what it is spending."
    hexOf(Domain.Bip341.hashAmounts(prevouts))

verify hashAmounts
    hashAmounts([Spent(amount = 420000000, script = "512053a1f6e454df1aa2776a2814a721372d6258050de330b3c6d10ee8f4e0dda343"), Spent(amount = 462000000, script = "5120147c9c57132f6e7ecddba9800bb0c4449251c92a1e60371ee77557b6620f3ea3"), Spent(amount = 294000000, script = "76a914751e76e8199196d454941c45d1b3a323f1433bd688ac"), Spent(amount = 504000000, script = "5120e4d810fd50586274face62b8a807eb9719cef49c04177cc6b76a9a4251d5450e"), Spent(amount = 630000000, script = "512091b64d5324723a985170e4dc5a0f84c041804f2cd12660fa5dec09fc21783605"), Spent(amount = 378000000, script = "00147dd65592d0ab2fe0d0257d571abf032cd9db93dc"), Spent(amount = 672000000, script = "512075169f4001aa68f15bbed28b218df1d0a62cbbcf1188c6665110c293c907b831"), Spent(amount = 546000000, script = "5120712447206d7a5238acc7ff53fbe94a3b64539ad291c7cdbc490b7577e4b17df5"), Spent(amount = 588000000, script = "512077e30a5522dd9f894c3f8b8bd4c4b2cf82ca7da8a3ea6a239655c39c050ab220")]) => "58a6964a4f5f8f0b642ded0a8a553be7622a719da71d1f5befcefcdee8e0fde6"

fn hashScriptPubKeys(prevouts: List<Spent>) -> String
    ? "Every spent Output Script, hashed once."
    hexOf(Domain.Bip341.hashScriptPubKeys(prevouts))

verify hashScriptPubKeys
    hashScriptPubKeys([Spent(amount = 420000000, script = "512053a1f6e454df1aa2776a2814a721372d6258050de330b3c6d10ee8f4e0dda343"), Spent(amount = 462000000, script = "5120147c9c57132f6e7ecddba9800bb0c4449251c92a1e60371ee77557b6620f3ea3"), Spent(amount = 294000000, script = "76a914751e76e8199196d454941c45d1b3a323f1433bd688ac"), Spent(amount = 504000000, script = "5120e4d810fd50586274face62b8a807eb9719cef49c04177cc6b76a9a4251d5450e"), Spent(amount = 630000000, script = "512091b64d5324723a985170e4dc5a0f84c041804f2cd12660fa5dec09fc21783605"), Spent(amount = 378000000, script = "00147dd65592d0ab2fe0d0257d571abf032cd9db93dc"), Spent(amount = 672000000, script = "512075169f4001aa68f15bbed28b218df1d0a62cbbcf1188c6665110c293c907b831"), Spent(amount = 546000000, script = "5120712447206d7a5238acc7ff53fbe94a3b64539ad291c7cdbc490b7577e4b17df5"), Spent(amount = 588000000, script = "512077e30a5522dd9f894c3f8b8bd4c4b2cf82ca7da8a3ea6a239655c39c050ab220")]) => "23ad0f61ad2bca5ba6a7693f50fce988e17c3780bf2b1e720cfbb38fbdd52e21"

fn hashSequences(rawHex: String) -> Result<String, String>
    ? "Every sequence, hashed once."
    Result.Ok(hexOf(Domain.Bip341.hashSequences(Domain.Transaction.inputsOf(decoded(rawHex)?))))

verify hashSequences
    hashSequences("") => Result.Ok("18959c7221ab5ce9e26c3cd67b22c24f8baa54bac281d8e6b05e400e6c3a957e")
    // The refusal arm, which no vector can reach: the raw hex must parse.
    hashSequences("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn hashOutputs(rawHex: String) -> Result<String, String>
    ? "Every Output, hashed once."
    Result.Ok(hexOf(Domain.Bip341.hashOutputs(Domain.Transaction.outputsOf(decoded(rawHex)?))))

verify hashOutputs
    hashOutputs("") => Result.Ok("a2e6dab7c1f0dcd297c8d61647fd17d821541ea69c3cc37dcbad7f90d4eb4bc5")
    // The refusal arm, which no vector can reach: the raw hex must parse.
    hashOutputs("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn merkleRoot(root: List<Int>) -> String
    ? "A script tree's root, built from its leaves rather than walked up to."
      "The argument is the tree itself, spelled as nested Domain.Taproot calls"
      "by the generator, so what each case tests is leafHashOf and the"
      "smaller-first joined. Verification only ever walks a path upward from"
      "one leaf; these build the whole tree, which is the direction a wallet"
      "uses and the one nothing here had exercised."
      "The two vectors with no tree are left out: they have no root."
    hexOf(root)

verify merkleRoot
    merkleRoot(Domain.Taproot.leafHashOf(192, "20d85a959b0290bf19bb89ed43c916be835475d013da4b362117393e25a48229b8ac")) => "5b75adecf53548f3ec6ad7d78383bf84cc57b55a3127c72b9a2481752dd88b21"
    merkleRoot(Domain.Taproot.leafHashOf(192, "20b617298552a72ade070667e86ca63b8f5789a9fe8731ef91202a91c9f3459007ac")) => "c525714a7f49c28aedbbba78c005931a81c234b2f6c99a73e4d06082adc8bf2b"
    merkleRoot(Domain.Taproot.joined(Domain.Taproot.leafHashOf(192, "20387671353e273264c495656e27e39ba899ea8fee3bb69fb2a680e22093447d48ac"), Domain.Taproot.leafHashOf(250, "06424950333431"))) => "6c2dc106ab816b73f9d07e3cd1ef2c8c1256f519748e0813e4edd2405d277bef"
    merkleRoot(Domain.Taproot.joined(Domain.Taproot.leafHashOf(192, "2044b178d64c32c4a05cc4f4d1407268f764c940d20ce97abfd44db5c3592b72fdac"), Domain.Taproot.leafHashOf(192, "07546170726f6f74"))) => "ab179431c28d3b68fb798957faf5497d69c883c6fb1e1cd9f81483d87bac90cc"
    merkleRoot(Domain.Taproot.joined(Domain.Taproot.leafHashOf(192, "2072ea6adcf1d371dea8fba1035a09f3d24ed5a059799bae114084130ee5898e69ac"), Domain.Taproot.joined(Domain.Taproot.leafHashOf(192, "202352d137f2f3ab38d1eaa976758873377fa5ebb817372c71e2c542313d4abda8ac"), Domain.Taproot.leafHashOf(192, "207337c0dd4253cb86f2c43a2351aadd82cccb12a172cd120452b9bb8324f2186aac")))) => "ccbd66c6f7e8fdab47b3a486f59d28262be857f30d4773f2d5ea47f7761ce0e2"
    merkleRoot(Domain.Taproot.joined(Domain.Taproot.leafHashOf(192, "2071981521ad9fc9036687364118fb6ccd2035b96a423c59c5430e98310a11abe2ac"), Domain.Taproot.joined(Domain.Taproot.leafHashOf(192, "20d5094d2dbe9b76e2c245a2b89b6006888952e2faa6a149ae318d69e520617748ac"), Domain.Taproot.leafHashOf(192, "20c440b462ad48c7a77f94cd4532d8f2119dcebbd7c9764557e62726419b08ad4cac")))) => "2f6b2c5397b6d68ca18e09a3f05161668ffe93a988582d55c6f07bd5b3329def"

fn address(scriptHex: String) -> Result<String, String>
    ? "The Bech32m address an Output Script pays to."
      "BIP350 addresses, from the BIP that defines them. Domain.Bech32 has"
      "chosen Bech32m for every version above zero since it was written and no"
      "published vector had ever contradicted it; these seven are the first"
      "that could."
    Domain.Payto.addressFor(Network.Mainnet, scriptHex)

verify address
    address("512053a1f6e454df1aa2776a2814a721372d6258050de330b3c6d10ee8f4e0dda343") => Result.Ok("bc1p2wsldez5mud2yam29q22wgfh9439spgduvct83k3pm50fcxa5dps59h4z5")
    address("5120147c9c57132f6e7ecddba9800bb0c4449251c92a1e60371ee77557b6620f3ea3") => Result.Ok("bc1pz37fc4cn9ah8anwm4xqqhvxygjf9rjf2resrw8h8w4tmvcs0863sa2e586")
    address("5120e4d810fd50586274face62b8a807eb9719cef49c04177cc6b76a9a4251d5450e") => Result.Ok("bc1punvppl2stp38f7kwv2u2spltjuvuaayuqsthe34hd2dyy5w4g58qqfuag5")
    address("5120712447206d7a5238acc7ff53fbe94a3b64539ad291c7cdbc490b7577e4b17df5") => Result.Ok("bc1pwyjywgrd0ffr3tx8laflh6228dj98xkjj8rum0zfpd6h0e930h6saqxrrm")
    address("512077e30a5522dd9f894c3f8b8bd4c4b2cf82ca7da8a3ea6a239655c39c050ab220") => Result.Ok("bc1pwl3s54fzmk0cjnpl3w9af39je7pv5ldg504x5guk2hpecpg2kgsqaqstjq")
    address("512091b64d5324723a985170e4dc5a0f84c041804f2cd12660fa5dec09fc21783605") => Result.Ok("bc1pjxmy65eywgafs5tsunw95ruycpqcqnev6ynxp7jaasylcgtcxczs6n332e")
    address("512075169f4001aa68f15bbed28b218df1d0a62cbbcf1188c6665110c293c907b831") => Result.Ok("bc1pw5tf7sqp4f50zka7629jrr036znzew70zxyvvej3zrpf8jg8hqcssyuewe")
    // The refusal arm: OP_RETURN pays nobody.
    address("6a0b68656c6c6f20776f726c64") => Result.Err("no address for OP_RETURN")

fn script(text: String) -> Result<String, String>
    ? "And the Output Script that address pays to, back again."
    Domain.ReadAddress.scriptFor(Network.Mainnet, text)

verify script
    script("bc1p2wsldez5mud2yam29q22wgfh9439spgduvct83k3pm50fcxa5dps59h4z5") => Result.Ok("512053a1f6e454df1aa2776a2814a721372d6258050de330b3c6d10ee8f4e0dda343")
    script("bc1pz37fc4cn9ah8anwm4xqqhvxygjf9rjf2resrw8h8w4tmvcs0863sa2e586") => Result.Ok("5120147c9c57132f6e7ecddba9800bb0c4449251c92a1e60371ee77557b6620f3ea3")
    script("bc1punvppl2stp38f7kwv2u2spltjuvuaayuqsthe34hd2dyy5w4g58qqfuag5") => Result.Ok("5120e4d810fd50586274face62b8a807eb9719cef49c04177cc6b76a9a4251d5450e")
    script("bc1pwyjywgrd0ffr3tx8laflh6228dj98xkjj8rum0zfpd6h0e930h6saqxrrm") => Result.Ok("5120712447206d7a5238acc7ff53fbe94a3b64539ad291c7cdbc490b7577e4b17df5")
    script("bc1pwl3s54fzmk0cjnpl3w9af39je7pv5ldg504x5guk2hpecpg2kgsqaqstjq") => Result.Ok("512077e30a5522dd9f894c3f8b8bd4c4b2cf82ca7da8a3ea6a239655c39c050ab220")
    script("bc1pjxmy65eywgafs5tsunw95ruycpqcqnev6ynxp7jaasylcgtcxczs6n332e") => Result.Ok("512091b64d5324723a985170e4dc5a0f84c041804f2cd12660fa5dec09fc21783605")
    script("bc1pw5tf7sqp4f50zka7629jrr036znzew70zxyvvej3zrpf8jg8hqcssyuewe") => Result.Ok("512075169f4001aa68f15bbed28b218df1d0a62cbbcf1188c6665110c293c907b831")
    // The refusal arm: an empty string is no address.
    script("") => Result.Err("an address needs a prefix and a separator")

fn decoded(rawHex: String) -> Result<Transaction, String>
    ? "The Transaction the vector gives, as bytes then as fields."
    Domain.Transaction.decode(Bytes.octets(Bytes.fromHex(rawHex)?))

verify decoded
    Domain.Transaction.versionOf(decoded("")?) => 2
    decoded("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn hexOf(bytes: List<Int>) -> String
    ? "Bytes as text."
      "Total: every list here comes from a hash or a preimage builder and is"
      "octets by construction, so Bytes.fromList cannot refuse it."
    match Bytes.fromList(bytes)
        Result.Err(message) -> ""
        Result.Ok(raw) -> Bytes.toHex(raw)

verify hexOf
    hexOf([170, 187]) => "aabb"
    hexOf([]) => ""
