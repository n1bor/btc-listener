module Audit
    intent =
        "Run every check we have over a range of Heights and report what fails."
        "A prefix of the chain is self-contained: every Input names a parent at a"
        "lower Height, so holding 1..N means holding every parent. Over a prefix"
        "an unresolved Input is a defect rather than a gap in coverage, which is"
        "what makes this worth running."
    exposes [main]
    depends [Bytes, Domain.Block, Domain.Index, Domain.Spend, Domain.Transaction, Infra.Blocks, Infra.Chain, Infra.Spends, Infra.Store]
    effects [
        Args.get,
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
    ]

record Counts
    blocks: Int
    transactions: Int
    resolved: Int
    coinbase: Int
    faults: Int

fn main() -> Unit
    ? "Audit a range of Heights."
    ! [
        Args.get,
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
    ]
    run(Args.get())

fn run(args: List<String>) -> Unit
    ? "Directory, first Height, last Height."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match args
        [] -> Console.error("usage: <dir> <from> <to>")
        [dir, ..rest] -> withFrom(dir, rest)

fn withFrom(dir: String, rest: List<String>) -> Unit
    ? "The first Height."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match rest
        [] -> Console.error("usage: <dir> <from> <to>")
        [from, ..more] -> withTo(dir, from, more)

fn withTo(dir: String, from: String, more: List<String>) -> Unit
    ? "The last Height."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match more
        [] -> Console.error("usage: <dir> <from> <to>")
        [to, ..extra] -> started(dir, Int.fromString(from), Int.fromString(to))

fn started(dir: String, from: Result<Int, String>, to: Result<Int, String>) -> Unit
    ? "Open the store and walk."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    reported(audited(dir, from, to))

fn audited(dir: String, from: Result<Int, String>, to: Result<Int, String>) -> Result<Counts, String>
    ? "Walk the range, checking every Block and every Transaction in it."
    ! [Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    a = from?
    b = to?
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open("{dir}/blocks")?
    walk(store, blocks, a, b, Counts(blocks = 0, transactions = 0, resolved = 0, coinbase = 0, faults = 0))

fn walk(store: Store, blocks: BlockStore, height: Int, to: Int, counts: Counts) -> Result<Counts, String>
    ? "Each Height in turn."
    ! [Console.print, Disk.readText]
    match height > to
        true -> Result.Ok(counts)
        false -> atHeight(store, blocks, height, to, counts)

fn atHeight(store: Store, blocks: BlockStore, height: Int, to: Int, counts: Counts) -> Result<Counts, String>
    ? "Check one Block, then its Transactions."
    ! [Console.print, Disk.readText]
    found = Infra.Chain.at(store, blocks, height)?
    next = height + 1
    match found.body
        Body.NotFetched -> walk(store, blocks, next, to, counts)
        Body.Discarded -> walk(store, blocks, next, to, counts)
        Body.Held(location, payload) -> checkedBlock(store, blocks, height, to, counts, found, payload)

fn checkedBlock(store: Store, blocks: BlockStore, height: Int, to: Int, counts: Counts, found: Found, payload: Bytes) -> Result<Counts, String>
    ? "The Block's own checks, then every Transaction it holds."
    ! [Console.print, Disk.readText]
    transactions = Domain.Block.transactionsOf(payload)?
    root = Domain.Block.merkleRootOf(Domain.Block.txidsOf(transactions))?
    header = Domain.Block.decodeHeader(List.take(Bytes.toList(payload), Domain.Block.headerLength()))?
    faults = blockFaults(height, found, header, root)
    _said = reportBlock(height, faults)
    overTransactions(store, blocks, height, to, Counts(blocks = counts.blocks + 1, transactions = counts.transactions, resolved = counts.resolved, coinbase = counts.coinbase, faults = counts.faults + List.len(faults)), transactions)

fn blockFaults(height: Int, found: Found, header: BlockHeader, root: String) -> List<String>
    ? "Whatever is wrong with the Block itself."
    List.concat(merkleFault(height, header, root), List.concat(idFault(height, found, header), workFault(height, found, header)))

fn merkleFault(height: Int, header: BlockHeader, root: String) -> List<String>
    ? "The Transactions must build the Root the Header committed to."
    match root == header.merkleRoot
        true -> []
        false -> ["height {height}: merkle root {root} but header says {header.merkleRoot}"]

verify merkleFault
    merkleFault(1, sampleHeader("aa"), "aa") => []
    List.len(merkleFault(1, sampleHeader("aa"), "bb")) => 1

fn idFault(height: Int, found: Found, header: BlockHeader) -> List<String>
    ? "The Header must hash to the Block Id the Index recorded."
    match header.blockId == found.blockId
        true -> []
        false -> ["height {height}: header hashes to {header.blockId} but index says {found.blockId}"]

verify idFault
    idFault(1, sampleFound("cc"), sampleHeaderWithId("cc")) => []
    List.len(idFault(1, sampleFound("cc"), sampleHeaderWithId("dd"))) => 1

fn workFault(height: Int, found: Found, header: BlockHeader) -> List<String>
    ? "The Block Id must fall under the target."
    match Domain.Block.meetsTarget(found.blockId, header.bits)
        Result.Err(message) -> ["height {height}: cannot check work: {message}"]
        Result.Ok(met) -> workOrNot(height, met)

verify workFault
    workFault(1, sampleFound("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f"), sampleHeader("aa")) => []
    List.len(workFault(1, sampleFound("zz"), sampleHeader("aa"))) => 1
    List.len(workFault(1, sampleFound("ff0000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f"), sampleHeader("aa"))) => 1

fn workOrNot(height: Int, met: Bool) -> List<String>
    ? "Report only a failure."
    match met
        true -> []
        false -> ["height {height}: block id is above the target"]

verify workOrNot
    workOrNot(1, true) => []
    List.len(workOrNot(1, false)) => 1

fn sampleHeader(root: String) -> BlockHeader
    ? "A Header with a chosen Merkle Root, for the cases above."
    BlockHeader(blockId = "cc", version = 1, previousBlockId = "bb", merkleRoot = root, timestamp = 0, bits = 486604799, nonce = 0)

verify sampleHeader
    sampleHeader("aa").merkleRoot => "aa"

fn sampleHeaderWithId(blockId: String) -> BlockHeader
    ? "A Header with a chosen Block Id, for the cases above."
    BlockHeader(blockId = blockId, version = 1, previousBlockId = "bb", merkleRoot = "aa", timestamp = 0, bits = 486604799, nonce = 0)

verify sampleHeaderWithId
    sampleHeaderWithId("cc").blockId => "cc"

fn sampleFound(blockId: String) -> Found
    ? "A Found with a chosen Block Id, for the cases above."
    Found(height = 1, blockId = blockId, parentBlockId = Option.None, body = Body.NotFetched)

verify sampleFound
    sampleFound("cc").blockId => "cc"

fn reportBlock(height: Int, faults: List<String>) -> Unit
    ? "Print any Block-level fault as it is found."
    ! [Console.print]
    match faults
        [] -> Unit
        [head, ..tail] -> printAll(faults)

fn printAll(lines: List<String>) -> Unit
    ? "Print each line."
    ! [Console.print]
    match lines
        [] -> Unit
        [head, ..tail] -> printThen(head, tail)

fn printThen(line: String, rest: List<String>) -> Unit
    ? "One line, then the rest."
    ! [Console.print]
    _printed = Console.print(line)
    printAll(rest)

fn overTransactions(store: Store, blocks: BlockStore, height: Int, to: Int, counts: Counts, transactions: List<Transaction>) -> Result<Counts, String>
    ? "Check what each Transaction spends."
    ! [Console.print, Disk.readText]
    match transactions
        [] -> walk(store, blocks, height + 1, to, counts)
        [head, ..tail] -> oneTransaction(store, blocks, height, to, counts, head, tail)

fn oneTransaction(store: Store, blocks: BlockStore, height: Int, to: Int, counts: Counts, transaction: Transaction, tail: List<Transaction>) -> Result<Counts, String>
    ? "Resolve its Inputs and judge the sums."
    ! [Console.print, Disk.readText]
    tally = Infra.Spends.checked(store, blocks, transaction)?
    paid = paidBy(Domain.Transaction.outputsOf(transaction), 0)
    grown = judged(height, counts, transaction, Domain.Spend.verdictOf(tally, paid))
    overTransactions(store, blocks, height, to, grown, tail)

fn paidBy(outputs: List<Output>, acc: Int) -> Int
    ? "Total the Output values."
    match outputs
        [] -> acc
        [head, ..tail] -> paidBy(tail, acc + Domain.Transaction.valueOf(head))

verify paidBy
    paidBy([], 0) => 0
    paidBy([Output(value = 5, script = "")], 0) => 5

fn judged(height: Int, counts: Counts, transaction: Transaction, verdict: Verdict) -> Counts
    ? "Count the verdict, and report anything that is not clean."
      "Over a prefix of the chain every Input has its parent held, so Incomplete"
      "is a fault here even though it is an honest answer elsewhere."
    seen = counts.transactions + 1
    faulted = counts.faults + 1
    match verdict
        Verdict.Coinbase -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase + 1, faults = counts.faults)
        Verdict.Conserved -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved + 1, coinbase = counts.coinbase, faults = counts.faults)
        Verdict.Created(excess) -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase, faults = faulted)
        Verdict.Broken(why) -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase, faults = faulted)
        Verdict.Incomplete(why) -> Counts(blocks = counts.blocks, transactions = seen, resolved = counts.resolved, coinbase = counts.coinbase, faults = faulted)

verify judged
    judged(1, zero(), sampleTx(), Verdict.Conserved).resolved => 1
    judged(1, zero(), sampleTx(), Verdict.Coinbase).coinbase => 1
    judged(1, zero(), sampleTx(), Verdict.Created(5)).faults => 1
    judged(1, zero(), sampleTx(), Verdict.Broken("x")).faults => 1
    judged(1, zero(), sampleTx(), Verdict.Incomplete("x")).faults => 1

fn zero() -> Counts
    ? "Nothing counted yet."
    Counts(blocks = 0, transactions = 0, resolved = 0, coinbase = 0, faults = 0)

verify zero
    zero().faults => 0

fn sampleTx() -> Transaction
    ? "A Transaction, for the cases above."
    Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "cc", size = 9, isSegWit = false)

verify sampleTx
    Domain.Transaction.txidOf(sampleTx()) => "cc"

fn reported(outcome: Result<Counts, String>) -> Unit
    ? "The totals, or why the walk stopped."
    ! [Console.error, Console.print]
    match outcome
        Result.Err(message) -> Console.error("error: {message}")
        Result.Ok(counts) -> Console.print("blocks {counts.blocks}  transactions {counts.transactions}  spends resolved {counts.resolved}  coinbase {counts.coinbase}  FAULTS {counts.faults}")
