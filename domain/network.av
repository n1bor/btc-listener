module Network
    intent =
        "Which Bitcoin network a Peer belongs to."
        "A Network is only ever used for its magic bytes, but it is a type rather"
        "than a constant because those bytes are what make a Message meaningful:"
        "the same payload framed for the wrong Network is rejected by the Peer."
    exposes [Network, magicOf, nameOf, portOf]
    effects []

type Network
    Mainnet
    Testnet
    Signet
    Regtest

fn magicOf(network: Network) -> List<Int>
    ? "The four bytes that prefix every Message on this Network."
    match network
        Network.Mainnet -> [249, 190, 180, 217]
        Network.Testnet -> [11, 17, 9, 7]
        Network.Signet -> [10, 3, 207, 64]
        Network.Regtest -> [250, 191, 181, 218]

verify magicOf
    magicOf(Network.Mainnet) => [249, 190, 180, 217]
    magicOf(Network.Testnet) => [11, 17, 9, 7]
    magicOf(Network.Signet) => [10, 3, 207, 64]
    magicOf(Network.Regtest) => [250, 191, 181, 218]

fn nameOf(network: Network) -> String
    ? "How this Network is named to a reader."
    match network
        Network.Mainnet -> "mainnet"
        Network.Testnet -> "testnet"
        Network.Signet -> "signet"
        Network.Regtest -> "regtest"

verify nameOf
    nameOf(Network.Mainnet) => "mainnet"
    nameOf(Network.Testnet) => "testnet"
    nameOf(Network.Signet) => "signet"
    nameOf(Network.Regtest) => "regtest"

fn portOf(network: Network) -> Int
    ? "The port a Peer on this Network listens on by default."
    match network
        Network.Mainnet -> 8333
        Network.Testnet -> 18333
        Network.Signet -> 38333
        Network.Regtest -> 18444

verify portOf
    portOf(Network.Mainnet) => 8333
    portOf(Network.Testnet) => 18333
    portOf(Network.Signet) => 38333
    portOf(Network.Regtest) => 18444
