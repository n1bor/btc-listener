module Handshake
    intent =
        "What a Peer may say before its verack, and how much of it."
        "A Handshake is version then verack, and between the two a modern"
        "Peer says a little more: Core sends wtxidrelay, sendaddrv2 and"
        "sendtxrcncl after its version and before its verack, and would be"
        "dropped by a node that tolerated nothing. So those are kept for"
        "later, as they were. What is new (n1bor/btc-listener#284) is the"
        "edge on it: nothing at all before version, which is Core's own"
        "rule, and only so many kept Messages before verack -- a caller"
        "that sends a ping every fifty-nine seconds and never a verack used"
        "to hold the loop for ever, because every frame bought it another"
        "answer deadline. The deadline is now one per Handshake and lives"
        "with whoever waits; this module only says what each frame is."
    exposes [Step, stepOf, versionFault]
    depends [Domain.Version]
    effects []

type Step
    Done
    Version
    Ping
    Spared
    Refused(String)

fn sparedLimit() -> Int
    ? "How many Messages a Peer may have kept for it before its verack."
      "Core sends three between version and verack; eight leaves room for"
      "a Peer that also announces addresses early, and is nowhere near the"
      "sixty-four the spare holds."
    8

verify sparedLimit
    sparedLimit() => 8

fn stepOf(command: String, seenVersion: Bool, spared: Int) -> Step
    ? "What this frame is, given whether version has arrived and how many"
      "frames have already been kept."
    match seenVersion
        false -> beforeVersion(command)
        true -> afterVersion(command, spared)

verify stepOf
    stepOf("version", false, 0) => Step.Version
    stepOf("verack", false, 0) => Step.Refused("sent verack before its version")
    stepOf("ping", false, 0) => Step.Refused("sent ping before its version")
    stepOf("verack", true, 0) => Step.Done
    stepOf("ping", true, 0) => Step.Ping
    stepOf("wtxidrelay", true, 0) => Step.Spared
    stepOf("sendaddrv2", true, 7) => Step.Spared
    stepOf("sendaddrv2", true, 8) => Step.Refused("sent 8 Messages after its version and no verack")
    stepOf("version", true, 0) => Step.Refused("sent a second version")

fn beforeVersion(command: String) -> Step
    ? "Only a version may open."
    match command
        "version" -> Step.Version
        _ -> Step.Refused("sent {command} before its version")

verify beforeVersion
    beforeVersion("version") => Step.Version
    beforeVersion("addr") => Step.Refused("sent addr before its version")

fn afterVersion(command: String, spared: Int) -> Step
    ? "verack ends it; a ping is answered; anything else is kept, up to the limit."
    match command
        "verack" -> Step.Done
        "version" -> Step.Refused("sent a second version")
        "ping" -> Step.Ping
        _ -> sparedOrEnough(spared)

verify afterVersion
    afterVersion("verack", 0) => Step.Done
    afterVersion("ping", 0) => Step.Ping
    afterVersion("addr", 0) => Step.Spared
    afterVersion("version", 0) => Step.Refused("sent a second version")

fn sparedOrEnough(spared: Int) -> Step
    ? "One more kept Message, unless enough have been."
    match spared >= sparedLimit()
        true -> Step.Refused("sent {spared} Messages after its version and no verack")
        false -> Step.Spared

verify sparedOrEnough
    sparedOrEnough(0) => Step.Spared
    sparedOrEnough(7) => Step.Spared
    sparedOrEnough(8) => Step.Refused("sent 8 Messages after its version and no verack")

fn versionFault(version: Int, services: Int, ourNonce: Bool, inbound: Bool) -> Option<String>
    ? "Why a version Message ends the Handshake, if it does (#280 item 16)."
      "Our own nonce first: a node that dialled itself has nothing to say to"
      "itself whatever else it offers. Then the protocol floor, then the"
      "witness bit, which only an outbound Peer is refused for -- we dialled"
      "it to ask for Blocks -- where an inbound one may be a light client we"
      "will serve and never ask."
    match ourNonce
        true -> Option.Some("is this node: its version carries our own nonce")
        false -> versionFaultOffering(version, services, inbound)

verify versionFault
    versionFault(70016, 9, false, false) => Option.None
    versionFault(70016, 9, true, false) => Option.Some("is this node: its version carries our own nonce")
    versionFault(70015, 9, false, false) => Option.Some("speaks protocol 70015, below the 70016 this node needs")
    versionFault(70016, 1, false, false) => Option.Some("offers no NODE_WITNESS, and was dialled for Blocks it cannot serve")
    versionFault(70016, 1, false, true) => Option.None
    versionFault(0, 0, false, true) => Option.Some("speaks protocol 0, below the 70016 this node needs")

verify versionFault law refusesExactlyTheThree
    given version: Int = [0, 209, 70015, 70016, 70017]
    given services: Int = [0, 1, 8, 9, 1033]
    given ourNonce: Bool = [true, false]
    given inbound: Bool = [true, false]
    isNone(versionFault(version, services, ourNonce, inbound)) => Bool.and(Bool.not(ourNonce), Bool.and(version >= Domain.Version.minimumVersion(), Bool.or(inbound, Domain.Version.servesWitness(services))))

fn versionFaultOffering(version: Int, services: Int, inbound: Bool) -> Option<String>
    ? "The floor, then the bit."
    match version < Domain.Version.minimumVersion()
        true -> Option.Some("speaks protocol {version}, below the {Domain.Version.minimumVersion()} this node needs")
        false -> witnessFault(services, inbound)

verify versionFaultOffering
    versionFaultOffering(70016, 9, false) => Option.None
    versionFaultOffering(1, 9, false) => Option.Some("speaks protocol 1, below the 70016 this node needs")

fn witnessFault(services: Int, inbound: Bool) -> Option<String>
    ? "An outbound Peer without NODE_WITNESS."
    match Bool.or(inbound, Domain.Version.servesWitness(services))
        true -> Option.None
        false -> Option.Some("offers no NODE_WITNESS, and was dialled for Blocks it cannot serve")

verify witnessFault
    witnessFault(8, false) => Option.None
    witnessFault(0, true) => Option.None
    witnessFault(0, false) => Option.Some("offers no NODE_WITNESS, and was dialled for Blocks it cannot serve")

fn isNone(fault: Option<String>) -> Bool
    ? "No fault."
    match fault
        Option.None -> true
        Option.Some(_) -> false

verify isNone
    isNone(Option.None) => true
    isNone(Option.Some("x")) => false
