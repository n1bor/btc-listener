module StackItem
    intent =
        "What a Script stack holds, and what it means."
        "Everything on the stack is a byte string. Reading one as a number and"
        "asking whether one is true are two different questions with two"
        "different answers, and conflating them is a classic way to be wrong:"
        "the empty string is false and reads as zero, but so does a single"
        "eighty, which is negative zero and is not the same string."
        "Numbers are little-endian with the sign in the top bit of the last"
        "byte, so the sign lives at the far end from where a reader looks first."
        "Arithmetic takes at most four bytes. That is not a property of the"
        "encoding -- the stack holds longer numbers happily -- it is a rule the"
        "arithmetic opcodes apply to their inputs, so it is offered here as a"
        "question rather than enforced."
        "Minimal encoding is a rule about how a push was written rather than"
        "what it pushed, so it needs the opcode as well as the bytes."
    exposes [asNumber, fromNumber, isTruthy, fitsArithmetic, isMinimalNumber, isMinimalPush, isConditionMinimal, arithmeticFault, minimalFault, arithmeticFaultIn, pushFault]
    depends [Domain.Opcode]
    effects []

fn asNumber(item: List<Int>) -> Int
    ? "A stack item read as a number."
      "The empty string is zero. So is a single eighty, which is negative zero:"
      "a different string that means the same number, which is why the minimal"
      "encoding rule exists at all."
    match List.reverse(item)
        [] -> 0
        [top, ..rest] -> valued(top, rest)

verify asNumber
    asNumber([]) => 0
    asNumber([1]) => 1
    asNumber([129]) => 0 - 1
    asNumber([128]) => 0
    asNumber([0]) => 0
    asNumber([255, 0]) => 255
    asNumber([255, 128]) => 0 - 255
    asNumber([1, 2]) => 513
    asNumber([255, 255, 255, 127]) => 2147483647
    asNumber([255, 255, 255, 255]) => 0 - 2147483647

verify asNumber law readsWhatFromNumberWrote
    given value: Int = [-2147483648, -2147483647, -8388608, -8388607, -32768, -32767, -256, -255, -129, -128, -127, -1, 0, 1, 127, 128, 129, 255, 256, 32767, 32768, 8388607, 8388608, 2147483647, 2147483648]
    because numberReadbackReason(value)
    using [littleEndian.zeroDigitWindow, littleEndian.outsideByteRangeIsNeverAdded, littleEndian.readsBackBigEndian, placed.placementReadsBack, magnitudeOf.signAndSizeMakeTheNumber]
    asNumber(fromNumber(value)) => value

verify asNumber law rewritingPreservesTheNumber
    given item: List<Int> = [[], [0], [128], [0, 128], [1, 0], [128, 0], [255, 255, 255, 127], [-1, 256]]
    using [asNumber.readsWhatFromNumberWrote]
    asNumber(fromNumber(asNumber(item))) => asNumber(item)

verify asNumber law minimalEncodingIdentifiesBytes
    given left: List<Int> = [[], [1], [129], [128, 0], [128, 128], [0], [256]]
    given right: List<Int> = [[], [1], [129], [128, 0], [128, 128], [128], [256]]
    when Bool.and(Bool.and(validBytes(left), isMinimalNumber(left)), Bool.and(validBytes(right), isMinimalNumber(right)))
    using [fromNumber.minimalItemsAreFixedPoints]
    asNumber(left) == asNumber(right) => left == right

fn valued(top: Int, rest: List<Int>) -> Int
    ? "The most significant byte carries the sign; the rest are magnitude."
    signedBy(bigEndian(List.prepend(unsigned(top), rest), 0), top >= 128)

verify valued
    valued(1, []) => 1
    valued(129, []) => 0 - 1
    valued(0, [255]) => 255

fn unsigned(top: Int) -> Int
    ? "The magnitude bits of the top byte, with the sign taken off."
    match top >= 128
        true -> top - 128
        false -> top

verify unsigned
    unsigned(1) => 1
    unsigned(129) => 1
    unsigned(128) => 0

fn signedBy(magnitude: Int, negative: Bool) -> Int
    ? "Apply the sign."
    match negative
        true -> 0 - magnitude
        false -> magnitude

verify signedBy
    signedBy(5, false) => 5
    signedBy(5, true) => 0 - 5

fn bigEndian(bytes: List<Int>, acc: Int) -> Int
    ? "Most significant byte first, which is what reversing the item gives."
    match bytes
        [] -> acc
        [head, ..tail] -> bigEndian(tail, acc * 256 + head)

verify bigEndian
    bigEndian([], 0) => 0
    bigEndian([1], 0) => 1
    bigEndian([1, 2], 0) => 258

verify bigEndian law readsTheLastByteLast
    given bytes: List<Int> = [[], [1], [1, 2], [255, 0, 7]]
    given b: Int = [0, 1, 128, 255]
    given acc: Int = [0, 1, 300]
    bigEndian(List.concat(bytes, [b]), acc) => bigEndian(bytes, acc) * 256 + b

verify bigEndian law largerPrefixStaysLarger
    given bytes: List<Int> = [[], [1, 2], [255, 0, 7], [-1, 256]]
    given lower: Int = [-2, 0, 300]
    given upper: Int = [-1, 1, 301]
    when lower < upper
    because largerPrefixReason(bytes, lower, upper)
    using []
    bigEndian(bytes, lower) < bigEndian(bytes, upper) holds

verify bigEndian law writingReadDigitsPreservesThem
    given bytes: List<Int> = [[], [0], [255, 0], [1, 2, 3]]
    given prefix: Int = [1, 127, 128, 256]
    when Bool.and(validBytes(bytes), prefix > 0)
    because digitsReadbackReason(bytes, prefix)
    using [littleEndian.positivePrefixAndDigit]
    List.concat(List.reverse(bytes), littleEndian(prefix, [])) => littleEndian(bigEndian(bytes, prefix), [])

verify bigEndian law headStartsPrefix
    given head: Int = [-1, 0, 128, 255]
    given tail: List<Int> = [[], [1], [0, 255]]
    given prefix: Int = [-1, 0, 1, 128]
    bigEndian(List.prepend(head, tail), prefix) => bigEndian(tail, prefix * 256 + head)

verify bigEndian law positivePrefixStaysPositive
    given bytes: List<Int> = [[], [0], [255, 0], [1, 2, 3]]
    given prefix: Int = [1, 127, 128, 256]
    when Bool.and(validBytes(bytes), prefix > 0)
    because positiveReadReason(bytes, prefix)
    using []
    bigEndian(bytes, prefix) > 0 holds

fn fromNumber(value: Int) -> List<Int>
    ? "A number written the way Script writes one, minimally."
      "Zero is the empty string rather than a zero byte, which is the one case"
      "that surprises everybody."
    match value == 0
        true -> []
        false -> signedBytes(magnitudeOf(value), value < 0)

verify fromNumber
    fromNumber(0) => []
    fromNumber(1) => [1]
    fromNumber(0 - 1) => [129]
    fromNumber(127) => [127]
    fromNumber(128) => [128, 0]
    fromNumber(0 - 128) => [128, 128]
    fromNumber(255) => [255, 0]
    fromNumber(256) => [0, 1]
    fromNumber(513) => [1, 2]
    fromNumber(2147483647) => [255, 255, 255, 127]

verify fromNumber law encodingIdentifiesTheNumber
    given left: Int = [-2147483648, -128, -1, 0, 1, 128, 2147483648]
    given right: Int = [-2147483648, -128, -1, 0, 1, 128, 2147483648]
    using [asNumber.readsWhatFromNumberWrote]
    fromNumber(left) == fromNumber(right) => left == right

verify fromNumber law signedMagnitudeEncoding
    given magnitude: Int = [1, 127, 128, 256]
    given negative: Bool = [false, true]
    when magnitude > 0
    fromNumber(signedBy(magnitude, negative)) => withSign(littleEndian(magnitude, []), negative)

verify fromNumber law minimalItemsAreFixedPoints
    given item: List<Int> = [[], [1], [129], [128], [0], [1, 0], [128, 0], [128, 128], [255, 255, 255, 127], [0, 0, 0, 128, 0]]
    when Bool.and(validBytes(item), isMinimalNumber(item))
    because validBytes(List.reverse(item))
    because minimalFromTop(List.reverse(item))
    because canonicalDigitsReason(item)
    because canonicalReason(item)
    using [canonicalDigitsReason.minimalItemDigitsReadBack, canonicalReason.readsFromTheTop, restoredFromTop.minimalReversedIsRestored, restoredFromTop.minimalValueIsRestored, List.reverse.involutive, withSign.restoresMagnitudeTop, withSign.restoresSeparateSign, validBytes.headAndTail, validBytes.reversal, bigEndian.headStartsPrefix, fromNumber.signedMagnitudeEncoding]
    fromNumber(asNumber(item)) => item

verify fromNumber law canonicalExactlyWhenMinimal
    given item: List<Int> = [[], [1], [129], [128], [0], [1, 0], [128, 0], [128, 128], [255, 255, 255, 127], [0, 0, 0, 128, 0]]
    when validBytes(item)
    using [fromNumber.minimalItemsAreFixedPoints, isMinimalNumber.acceptsWhatFromNumberWrites]
    fromNumber(asNumber(item)) == item => isMinimalNumber(item)

verify fromNumber
    fromNumber(asNumber([128])) => []
    fromNumber(asNumber([1, 0])) => [1]
    fromNumber(asNumber([128, 0])) => [128, 0]
    fromNumber(asNumber([256])) => [128, 128]

fn magnitudeOf(value: Int) -> Int
    ? "Size without sign."
    match value < 0
        true -> 0 - value
        false -> value

verify magnitudeOf
    magnitudeOf(5) => 5
    magnitudeOf(0 - 5) => 5

verify magnitudeOf law signAndSizeMakeTheNumber
    given value: Int = [-2147483648, -256, -1, 0, 1, 255, 2147483647]
    signedBy(magnitudeOf(value), value < 0) => value

fn signedBytes(magnitude: Int, negative: Bool) -> List<Int>
    ? "The magnitude little-endian, then somewhere to put the sign."
      "When the top byte already uses its high bit there is nowhere to put the"
      "sign, so another byte is added for it alone."
    bytes = littleEndian(magnitude, [])
    withSign(bytes, negative)

verify signedBytes
    signedBytes(1, false) => [1]
    signedBytes(1, true) => [129]
    signedBytes(128, false) => [128, 0]
    signedBytes(128, true) => [128, 128]

verify signedBytes law byteStep
    given magnitude: Int = [256, 65535, 65536, 2147483648]
    given negative: Bool = [false, true]
    when magnitude >= 256
    using [littleEndian.lowDigitStep, littleEndian.positiveHasDigits, withSign.preservesLowByte]
    signedBytes(magnitude, negative) => List.prepend(Int.mod(magnitude, 256), signedBytes(Int.div(magnitude, 256), negative))

verify signedBytes law smallMagnitudeSize
    given magnitude: Int = [0, 1, 127, 128, 255]
    given negative: Bool = [false, true]
    when Bool.and(magnitude >= 0, magnitude < 256)
    because littleEndian(magnitude, []) == match magnitude > 0
        true -> [magnitude]
        false -> []
    using [littleEndian.nonpositiveHasNoDigits, littleEndian.oneDigitEncoding]
    List.len(signedBytes(magnitude, negative)) => smallSize(magnitude)

verify signedBytes law lengthStep
    given magnitude: Int = [256, 65535, 65536, 2147483648]
    given negative: Bool = [false, true]
    when magnitude >= 256
    because signedBytes(magnitude, negative) == List.prepend(Int.mod(magnitude, 256), signedBytes(Int.div(magnitude, 256), negative))
    using [signedBytes.byteStep]
    List.len(signedBytes(magnitude, negative)) => 1 + List.len(signedBytes(Int.div(magnitude, 256), negative))

verify signedBytes law positiveHasBytes
    given magnitude: Int = [1, 127, 128, 256, 2147483648]
    given negative: Bool = [false, true]
    when magnitude > 0
    because sizeRecurrenceReason(magnitude, negative)
    using [signedBytes.smallMagnitudeSize, signedBytes.lengthStep]
    List.len(signedBytes(magnitude, negative)) > 0 holds

verify signedBytes law oneByteRange
    given magnitude: Int = [0, 1, 127, 128, 255, 256, 65536]
    given negative: Bool = [false, true]
    when magnitude >= 0
    because sizeRecurrenceReason(magnitude, negative)
    using [signedBytes.smallMagnitudeSize, signedBytes.lengthStep, signedBytes.positiveHasBytes]
    List.len(signedBytes(magnitude, negative)) <= 1 => magnitude < 128

verify signedBytes law smallMagnitudeSizeUnfolded
    given magnitude: Int = [0, 1, 127, 128, 255]
    given negative: Bool = [false, true]
    when Bool.and(magnitude >= 0, magnitude < 256)
    using [signedBytes.smallMagnitudeSize]
    List.len(withSign(littleEndian(magnitude, []), negative)) => smallSize(magnitude)

verify signedBytes law highBytesNeedTwo
    given magnitude: Int = [32768, 65535, 65536]
    when magnitude >= 32768
    Int.div(magnitude, 256) >= 128 holds

verify signedBytes law twoByteRangeUnfoldedAbove
    given magnitude: Int = [32768, 65535, 65536, 2147483648]
    given negative: Bool = [false, true]
    when magnitude >= 32768
    because Bool.not(List.len(signedBytes(Int.div(magnitude, 256), negative)) <= 1)
    using [signedBytes.oneByteRange, signedBytes.highBytesNeedTwo]
    1 + List.len(withSign(littleEndian(Int.div(magnitude, 256), []), negative)) <= 2 => false

verify signedBytes law twoByteRange
    given magnitude: Int = [0, 1, 32767, 32768, 65536]
    given negative: Bool = [false, true]
    when magnitude >= 0
    because sizeRecurrenceReason(magnitude, negative)
    using [signedBytes.smallMagnitudeSizeUnfolded, signedBytes.twoByteRangeUnfoldedAbove, signedBytes.smallMagnitudeSize, signedBytes.lengthStep, signedBytes.oneByteRange]
    List.len(signedBytes(magnitude, negative)) <= 2 => magnitude < 32768

verify signedBytes law threeByteRangeUnfoldedAbove
    given magnitude: Int = [8388608, 16777216, 2147483648]
    given negative: Bool = [false, true]
    when magnitude >= 8388608
    because Bool.not(List.len(signedBytes(Int.div(magnitude, 256), negative)) <= 2)
    using [signedBytes.twoByteRange]
    1 + List.len(withSign(littleEndian(Int.div(magnitude, 256), []), negative)) <= 3 => false

verify signedBytes law threeByteRangeUnfoldedBelow
    given magnitude: Int = [256, 65536, 8388607]
    given negative: Bool = [false, true]
    when Bool.and(magnitude >= 256, magnitude < 8388608)
    because List.len(signedBytes(Int.div(magnitude, 256), negative)) <= 2
    using [signedBytes.twoByteRange]
    1 + List.len(withSign(littleEndian(Int.div(magnitude, 256), []), negative)) <= 3 => true

verify signedBytes law threeByteRange
    given magnitude: Int = [0, 1, 8388607, 8388608, 16777216]
    given negative: Bool = [false, true]
    when magnitude >= 0
    because sizeRecurrenceReason(magnitude, negative)
    using [signedBytes.smallMagnitudeSizeUnfolded, signedBytes.threeByteRangeUnfoldedAbove, signedBytes.threeByteRangeUnfoldedBelow, signedBytes.smallMagnitudeSize, signedBytes.lengthStep, signedBytes.twoByteRange]
    List.len(signedBytes(magnitude, negative)) <= 3 => magnitude < 8388608

verify signedBytes law fourByteRangeUnfoldedAbove
    given magnitude: Int = [2147483648, 4294967296]
    given negative: Bool = [false, true]
    when magnitude >= 2147483648
    because Bool.not(List.len(signedBytes(Int.div(magnitude, 256), negative)) <= 3)
    using [signedBytes.threeByteRange]
    1 + List.len(withSign(littleEndian(Int.div(magnitude, 256), []), negative)) <= 4 => false

verify signedBytes law fourByteRangeUnfoldedBelow
    given magnitude: Int = [256, 65536, 2147483647]
    given negative: Bool = [false, true]
    when Bool.and(magnitude >= 256, magnitude < 2147483648)
    because List.len(signedBytes(Int.div(magnitude, 256), negative)) <= 3
    using [signedBytes.threeByteRange]
    1 + List.len(withSign(littleEndian(Int.div(magnitude, 256), []), negative)) <= 4 => true

verify signedBytes law fourByteRange
    given magnitude: Int = [0, 1, 2147483647, 2147483648, 4294967296]
    given negative: Bool = [false, true]
    when magnitude >= 0
    because sizeRecurrenceReason(magnitude, negative)
    using [signedBytes.smallMagnitudeSizeUnfolded, signedBytes.fourByteRangeUnfoldedAbove, signedBytes.fourByteRangeUnfoldedBelow, signedBytes.smallMagnitudeSize, signedBytes.lengthStep, signedBytes.threeByteRange]
    List.len(signedBytes(magnitude, negative)) <= 4 => magnitude < 2147483648

verify signedBytes law fitsFourBytesUnfolded
    given magnitude: Int = [0, 1, 2147483647]
    given negative: Bool = [false, true]
    when Bool.and(magnitude >= 0, magnitude < 2147483648)
    because List.len(signedBytes(magnitude, negative)) <= 4
    using [signedBytes.fourByteRange]
    List.len(withSign(littleEndian(magnitude, []), negative)) <= 4 => true

verify signedBytes law exceedsFourBytesUnfolded
    given magnitude: Int = [2147483648, 4294967296]
    given negative: Bool = [false, true]
    when magnitude >= 2147483648
    because Bool.not(List.len(signedBytes(magnitude, negative)) <= 4)
    using [signedBytes.fourByteRange]
    List.len(withSign(littleEndian(magnitude, []), negative)) <= 4 => false

fn littleEndian(value: Int, acc: List<Int>) -> List<Int>
    ? "Least significant byte first, with no leading zero."
      "The guard reads `value > 0` rather than `value == 0` on purpose (#336):"
      "on a negative value the old guard never held and the recursion never"
      "returned, and nothing showed the prover that it ends. Every caller"
      "passes a magnitude, so the two guards agree on every value that"
      "arrives; only the exported definition changes, from an opaque partial"
      "one to a total one the kernel can check."
    match value > 0
        true -> littleEndian(Int.div(value, 256), List.prepend(Int.mod(value, 256), acc))
        false -> List.reverse(acc)

verify littleEndian
    littleEndian(0, []) => []
    littleEndian(1, []) => [1]
    littleEndian(258, []) => [2, 1]

verify littleEndian law accumulatorComesFirst
    given value: Int = [-1, 0, 1, 255, 256, 65536, 2147483648]
    given acc: List<Int> = [[], [9], [1, 2]]
    littleEndian(value, acc) => List.concat(List.reverse(acc), littleEndian(value, []))

verify littleEndian law readsBackBigEndian
    given m: Int = [0, 1, 127, 128, 255, 256, 65535, 65536, 2147483647, 2147483648]
    when m >= 0
    using [littleEndian.accumulatorComesFirst, bigEndian.readsTheLastByteLast]
    bigEndian(List.reverse(littleEndian(m, [])), 0) => m

verify littleEndian law outsideByteRangeIsNeverAdded
    given m: Int = [-1, 0, 1, 127, 128, 255, 256, 32767, 32768, 8388607, 8388608, 2147483647, 2147483648]
    given acc: List<Int> = [[], [-1], [256], [1, 2], [-128, 300]]
    given b: Int = [-128, -1, 0, 1, 127, 128, 255, 256, 300]
    when Bool.or(b < 0, b >= 256)
    List.contains(littleEndian(m, acc), b) => List.contains(acc, b)

verify littleEndian law zeroDigitWindow
    given m: Int = [-1, 0, 1, 127, 128, 255, 256, 32767, 32768, 8388607, 8388608, 2147483647, 2147483648]
    given acc: List<Int> = [[], [0], [1, 2], [-1, 300]]
    using [littleEndian.accumulatorComesFirst, List.len.ofConcat, List.len.ofReverse]
    List.len(littleEndian(m, acc)) <= List.len(acc) => m < 1

verify littleEndian law topDigitOntoAccIsNotZero
    given m: Int = [-1, 0, 1, 127, 128, 255, 256, 65536]
    given acc: List<Int> = [[], [0], [1], [1, 0], [0, 1]]
    when Bool.or(m > 0, List.contains(List.take(acc, 1), 0) == false)
    using [List.reverse.involutive]
    List.contains(List.take(List.reverse(littleEndian(m, acc)), 1), 0) => false

verify littleEndian law mostSignificantDigitIsNotZero
    given m: Int = [-1, 0, 1, 127, 128, 255, 256, 32767, 32768, 8388607, 8388608, 2147483647, 2147483648]
    using [littleEndian.topDigitOntoAccIsNotZero]
    List.contains(List.take(List.reverse(littleEndian(m, [])), 1), 0) => false

verify littleEndian law firstDigitIsPreserved
    given value: Int = [0, 1, 128, 256]
    given digit: Int = [0, 1, 255]
    using [littleEndian.accumulatorComesFirst]
    littleEndian(value, [digit]) => List.prepend(digit, littleEndian(value, []))

verify littleEndian law positiveStep
    given value: Int = [1, 127, 128, 256, 2147483648]
    when value > 0
    afterFirstDigit(value) => littleEndian(value, [])

verify littleEndian law positivePrefixAndDigit
    given prefix: Int = [1, 127, 128, 256, 2147483648]
    given digit: Int = [0, 1, 127, 128, 255]
    when Bool.and(prefix > 0, Bool.and(digit >= 0, digit < 256))
    because digitStepReason(prefix, digit)
    using [littleEndian.positiveStep, littleEndian.firstDigitIsPreserved]
    littleEndian(prefix * 256 + digit, []) => List.prepend(digit, littleEndian(prefix, []))

verify littleEndian law oneDigitEncoding
    given digit: Int = [1, 127, 128, 255]
    when Bool.and(digit > 0, digit < 256)
    littleEndian(digit, []) => [digit]

verify littleEndian law writesReadBytesThenDigit
    given bytes: List<Int> = [[], [0], [255, 0], [1, 2, 3]]
    given digit: Int = [1, 127, 128, 255]
    when Bool.and(validBytes(bytes), Bool.and(digit > 0, digit < 256))
    because List.concat(List.reverse(bytes), littleEndian(digit, [])) == littleEndian(bigEndian(bytes, digit), [])
    using [bigEndian.writingReadDigitsPreservesThem, littleEndian.oneDigitEncoding]
    littleEndian(bigEndian(bytes, digit), []) => List.concat(List.reverse(bytes), [digit])

verify littleEndian law positiveHasDigits
    given value: Int = [1, 127, 128, 256, 2147483648]
    when value > 0
    using [littleEndian.firstDigitIsPreserved]
    List.len(littleEndian(value, [])) > 0 holds

verify littleEndian law lowDigitStep
    given value: Int = [1, 127, 128, 256, 2147483648]
    when value > 0
    because afterFirstDigit(value) == littleEndian(value, [])
    because littleEndian(Int.div(value, 256), [Int.mod(value, 256)]) == List.prepend(Int.mod(value, 256), littleEndian(Int.div(value, 256), []))
    using [littleEndian.firstDigitIsPreserved, littleEndian.positiveStep]
    littleEndian(value, []) => List.prepend(Int.mod(value, 256), littleEndian(Int.div(value, 256), []))

verify littleEndian law nonpositiveHasNoDigits
    given value: Int = [-1, 0]
    when value <= 0
    littleEndian(value, []) => []

fn withSign(bytes: List<Int>, negative: Bool) -> List<Int>
    ? "Put the sign in the top byte, or in a new one when that byte is full."
    match List.reverse(bytes)
        [] -> []
        [top, ..rest] -> placed(top, rest, negative)

verify withSign
    withSign([1], false) => [1]
    withSign([1], true) => [129]
    withSign([128], false) => [128, 0]
    withSign([128], true) => [128, 128]

verify withSign law restoresMagnitudeTop
    given top: Int = [1, 127, 129, 255]
    given rest: List<Int> = [[], [0], [1, 255]]
    when Bool.and(Bool.and(top >= 0, top < 256), unsigned(top) > 0)
    using [List.reverse.ofConcat, List.reverse.involutive]
    withSign(List.reverse(List.prepend(unsigned(top), rest)), top >= 128) => List.reverse(List.prepend(top, rest))

verify withSign law restoresSeparateSign
    given top: Int = [0, 128]
    given head: Int = [128, 255]
    given tail: List<Int> = [[], [0], [1, 255]]
    when Bool.and(Bool.or(top == 0, top == 128), head >= 128)
    using [List.reverse.ofConcat, List.reverse.involutive]
    withSign(List.reverse(List.prepend(head, tail)), top >= 128) => List.reverse(List.prepend(top, List.prepend(head, tail)))

verify withSign law preservesLowByte
    given digit: Int = [-1, 0, 128, 255]
    given tail: List<Int> = [[0], [1], [128], [1, 2, 255]]
    given negative: Bool = [false, true]
    when List.len(tail) > 0
    because lowByteReason(digit, tail, negative)
    using []
    withSign(List.prepend(digit, tail), negative) => List.prepend(digit, withSign(tail, negative))

fn placed(top: Int, rest: List<Int>, negative: Bool) -> List<Int>
    ? "The top byte has room for the sign only if its high bit is clear."
    match top >= 128
        true -> List.concat(List.reverse(List.prepend(top, rest)), [signByte(negative)])
        false -> List.reverse(List.prepend(orSign(top, negative), rest))

verify placed
    placed(1, [], false) => [1]
    placed(1, [], true) => [129]
    placed(128, [], false) => [128, 0]
    placed(128, [], true) => [128, 128]

verify placed law placementReadsBack
    given top: Int = [0, 1, 127, 128, 255, 256, 32767, 32768, 8388607, 8388608, 2147483647, 2147483648]
    given rest: List<Int> = [[], [0], [255], [-1, 300], [255, 255, 255]]
    given negative: Bool = [false, true]
    when top >= 0
    using [List.reverse.ofConcat, List.reverse.involutive]
    asNumber(placed(top, rest, negative)) => signedBy(bigEndian(List.prepend(top, rest), 0), negative)

verify placed law positiveTopMakesPlacementMinimal
    given top: Int = [0, 1, 127, 128, 255, 256, 32767, 32768, 8388607, 8388608, 2147483647, 2147483648]
    given rest: List<Int> = [[], [0], [255], [-1, 300], [255, 255, 255]]
    given negative: Bool = [false, true]
    when top > 0
    using [List.reverse.ofConcat]
    isMinimalNumber(placed(top, rest, negative)) holds

verify placed law positiveTopIsTruthy
    given top: Int = [1, 127, 128, 255, 256, 32768, 2147483648]
    given rest: List<Int> = [[], [0], [255], [-1, 300], [0, 0, 0]]
    given negative: Bool = [false, true]
    when top > 0
    using [anyNonZero.setHeadIsEnough, List.reverse.ofConcat]
    isTruthy(placed(top, rest, negative)) holds

fn signByte(negative: Bool) -> Int
    ? "The extra byte that carries a sign and nothing else."
    match negative
        true -> 128
        false -> 0

verify signByte
    signByte(true) => 128
    signByte(false) => 0

fn orSign(top: Int, negative: Bool) -> Int
    ? "Set the sign bit on a byte that has room for it."
    match negative
        true -> top + 128
        false -> top

verify orSign
    orSign(1, true) => 129
    orSign(1, false) => 1

fn isTruthy(item: List<Int>) -> Bool
    ? "Whether Script counts this item as true."
      "False is the empty string, all zeroes, and all zeroes with a sign bit --"
      "negative zero. Everything else is true, including a long string of"
      "nothing but a single one somewhere in the middle."
    match List.reverse(item)
        [] -> false
        [top, ..rest] -> Bool.or(Bool.and(top != 0, top != 128), anyNonZero(rest))

verify isTruthy
    isTruthy([]) => false
    isTruthy([0]) => false
    isTruthy([128]) => false
    isTruthy([0, 128]) => false
    isTruthy([0, 0, 0]) => false
    isTruthy([1]) => true
    isTruthy([0, 1]) => true
    isTruthy([1, 0]) => true
    isTruthy([129]) => true
    isTruthy([0, 0, 1]) => true

verify isTruthy law zeroIsFalse
    given value: Int = [-2147483648, -256, -129, -128, -127, -1, 0, 1, 127, 128, 129, 255, 256, 2147483647]
    because truthinessReason(value)
    using [littleEndian.mostSignificantDigitIsNotZero, littleEndian.outsideByteRangeIsNeverAdded, littleEndian.zeroDigitWindow, placed.positiveTopIsTruthy]
    isTruthy(fromNumber(value)) => value != 0

verify isTruthy law negativeZeroIsFalse
    given item: List<Int> = [[], [0], [1], [0, 0], [0, 1], [255], [128], [0, 128]]
    because negativeZeroReason(item)
    using [anyNonZero.reversal]
    isTruthy(List.concat(item, [128])) => anyNonZero(item)

fn anyNonZero(bytes: List<Int>) -> Bool
    ? "Whether anything below the top byte is set."
      "Accumulator form so the recursion stays in tail position; a stack item"
      "can be five hundred and twenty bytes."
    match bytes
        [] -> false
        [head, ..tail] -> nonZeroOrOn(head, tail)

verify anyNonZero
    anyNonZero([]) => false
    anyNonZero([0]) => false
    anyNonZero([0, 0]) => false
    anyNonZero([1]) => true
    anyNonZero([0, 1]) => true

verify anyNonZero law setHeadIsEnough
    given head: Int = [-1, 1, 128, 255, 256]
    given tail: List<Int> = [[], [0], [0, 0], [1]]
    when head != 0
    anyNonZero(List.prepend(head, tail)) holds

verify anyNonZero law concatenation
    given left: List<Int> = [[], [0], [1], [0, 0], [0, 1]]
    given right: List<Int> = [[], [0], [1], [0, 128]]
    because concatenationReason(left, right)
    using []
    anyNonZero(List.concat(left, right)) => Bool.or(anyNonZero(left), anyNonZero(right))

verify anyNonZero law reversal
    given bytes: List<Int> = [[], [0], [1], [0, 0], [0, 1], [1, 0], [0, 0, 128]]
    because reversalReason(bytes)
    using [anyNonZero.concatenation]
    anyNonZero(List.reverse(bytes)) => anyNonZero(bytes)

fn nonZeroOrOn(head: Int, tail: List<Int>) -> Bool
    ? "Stop at the first byte that is set."
    match head != 0
        true -> true
        false -> anyNonZero(tail)

verify nonZeroOrOn
    nonZeroOrOn(1, []) => true
    nonZeroOrOn(0, []) => false
    nonZeroOrOn(0, [1]) => true

fn fitsArithmetic(item: List<Int>) -> Bool
    ? "Whether the arithmetic opcodes will accept this item."
      "Four bytes. The stack holds longer numbers and they are not invalid; the"
      "arithmetic opcodes simply refuse them, so this is a question rather than"
      "a rule enforced here."
    List.len(item) <= 4

verify fitsArithmetic
    fitsArithmetic([]) => true
    fitsArithmetic([1, 2, 3, 4]) => true
    fitsArithmetic([1, 2, 3, 4, 5]) => false

verify fitsArithmetic law acceptsCoreOperandRange
    given value: Int = [-4294967296, -2147483649, -2147483648, -2147483647, -2147483646, -8388608, -8388607, -128, -127, -1, 0, 1, 127, 128, 8388607, 8388608, 2147483646, 2147483647, 2147483648, 4294967295, 4294967296]
    using [signedBytes.fourByteRange, signedBytes.fitsFourBytesUnfolded, signedBytes.exceedsFourBytesUnfolded]
    fitsArithmetic(fromNumber(value)) => Bool.and(value >= 0 - 2147483647, value <= 2147483647)

fn isMinimalNumber(item: List<Int>) -> Bool
    ? "Whether a number is written the shortest way it could be."
      "A trailing zero byte is redundant unless the byte below it needs the"
      "high bit that byte is carrying the sign for."
    match List.reverse(item)
        [] -> true
        [top, ..rest] -> topIsNeeded(top, rest)

verify isMinimalNumber
    isMinimalNumber([]) => true
    isMinimalNumber([1]) => true
    isMinimalNumber([129]) => true
    isMinimalNumber([0]) => false
    isMinimalNumber([128]) => false
    isMinimalNumber([1, 0]) => false
    isMinimalNumber([128, 0]) => true
    isMinimalNumber([255, 0]) => true
    isMinimalNumber([1, 2]) => true

verify isMinimalNumber law acceptsWhatFromNumberWrites
    given value: Int = [-2147483648, -2147483647, -8388608, -8388607, -32768, -32767, -256, -255, -129, -128, -127, -1, 0, 1, 127, 128, 129, 255, 256, 32767, 32768, 8388607, 8388608, 2147483647, 2147483648]
    because minimalReason(value)
    using [littleEndian.mostSignificantDigitIsNotZero, littleEndian.outsideByteRangeIsNeverAdded, littleEndian.zeroDigitWindow, placed.positiveTopMakesPlacementMinimal]
    isMinimalNumber(fromNumber(value)) holds

verify isMinimalNumber
    isMinimalNumber([256]) => true

fn topIsNeeded(top: Int, rest: List<Int>) -> Bool
    ? "A top byte of zero or eighty is spare unless the byte under it is full."
    match Bool.or(top == 0, top == 128)
        false -> true
        true -> underneathIsFull(rest)

verify topIsNeeded
    topIsNeeded(1, []) => true
    topIsNeeded(0, []) => false
    topIsNeeded(0, [128]) => true
    topIsNeeded(0, [1]) => false

fn underneathIsFull(rest: List<Int>) -> Bool
    ? "The byte below the top, and whether it already uses its high bit."
    match rest
        [] -> false
        [next, ..deeper] -> next >= 128

verify underneathIsFull
    underneathIsFull([]) => false
    underneathIsFull([128]) => true
    underneathIsFull([1]) => false

fn isMinimalPush(code: Int, data: List<Int>) -> Bool
    ? "Whether these bytes were pushed by the smallest opcode that could."
      "A rule about how the push was written rather than what it pushed, so it"
      "needs the opcode. Anything one byte long that OP_1 to OP_16 or"
      "OP_1NEGATE could have pushed had to use those."
    length = List.len(data)
    match length
        0 -> code == 0
        1 -> singleByteMinimal(code, data)
        _ -> widthMinimal(code, length)

verify isMinimalPush
    isMinimalPush(0, []) => true
    isMinimalPush(1, []) => false
    isMinimalPush(81, [1]) => true
    isMinimalPush(1, [1]) => false
    isMinimalPush(96, [16]) => true
    isMinimalPush(79, [129]) => true
    isMinimalPush(1, [17]) => true
    isMinimalPush(76, [17]) => false
    isMinimalPush(75, [1, 2, 3]) => false

verify isMinimalPush law directPushIsMinimalUnlessSmallNumber
    given b: Int = 0..255
    when Bool.and(b >= 0, b <= 255)
    isMinimalPush(1, [b]) => Bool.not(Bool.or(Bool.and(b >= 1, b <= 16), b == 129))

fn singleByteMinimal(code: Int, data: List<Int>) -> Bool
    ? "One byte: the small-number opcodes claim 1 to 16 and negative one."
    value = asNumber(data)
    match value == 0 - 1
        true -> code == 79
        false -> smallOrDirect(code, value)

verify singleByteMinimal
    singleByteMinimal(79, [129]) => true
    singleByteMinimal(1, [129]) => false
    singleByteMinimal(81, [1]) => true
    singleByteMinimal(1, [17]) => true

fn smallOrDirect(code: Int, value: Int) -> Bool
    ? "One to sixteen must use their own opcode; anything else a direct push."
    match Bool.and(value >= 1, value <= 16)
        true -> code == value + 80
        false -> code == 1

verify smallOrDirect
    smallOrDirect(81, 1) => true
    smallOrDirect(1, 1) => false
    smallOrDirect(96, 16) => true
    smallOrDirect(1, 17) => true
    smallOrDirect(76, 17) => false

fn widthMinimal(code: Int, length: Int) -> Bool
    ? "Longer data must use the narrowest push wide enough to say its length."
    match length <= 75
        true -> code == length
        false -> wideMinimal(code, length)

verify widthMinimal
    widthMinimal(3, 3) => true
    widthMinimal(76, 3) => false
    widthMinimal(76, 76) => true
    widthMinimal(77, 76) => false

fn wideMinimal(code: Int, length: Int) -> Bool
    ? "One byte of length up to 255, two up to 65535, four beyond."
    match length <= 255
        true -> code == 76
        false -> widerMinimal(code, length)

verify wideMinimal
    wideMinimal(76, 100) => true
    wideMinimal(77, 100) => false
    wideMinimal(77, 300) => true

fn widerMinimal(code: Int, length: Int) -> Bool
    ? "Two bytes of length, or four."
    match length <= 65535
        true -> code == 77
        false -> code == 78

verify widerMinimal
    widerMinimal(77, 300) => true
    widerMinimal(78, 300) => false
    widerMinimal(78, 70000) => true

fn arithmeticFault(item: List<Int>, minimal: Bool) -> Option<String>
    ? "Why this item cannot be read as an arithmetic operand, if it cannot."
      "Two rules in the order the reference client applies them. CScriptNum's"
      "constructor throws on the width first and only then on the encoding, so"
      "a five byte item that is also non-minimal is refused for its width --"
      "which is the answer Core's corpus expects and not the same answer as"
      "asking the other way round."
      "None is not an assurance that the item is a sensible number. It says"
      "no rule in force objects to reading it as one."
    match fitsArithmetic(item)
        false -> Option.Some("is over four bytes")
        true -> minimalFault(item, minimal)

verify arithmeticFault
    arithmeticFault([1], false) => Option.None
    arithmeticFault([1], true) => Option.None
    arithmeticFault([1, 2, 3, 4, 5], false) => Option.Some("is over four bytes")
    arithmeticFault([1, 2, 3, 4, 5], true) => Option.Some("is over four bytes")
    arithmeticFault([1, 0], false) => Option.None
    arithmeticFault([1, 0], true) => Option.Some("is not minimally encoded")
    arithmeticFault([], true) => Option.None

fn minimalFault(item: List<Int>, minimal: Bool) -> Option<String>
    ? "MINIMALDATA over a number: written longer than it needed to be."
      "Off unless the flag asks, because the chain is full of Scripts that"
      "break it and were valid when they were mined."
    match Bool.and(minimal, isMinimalNumber(item) == false)
        true -> Option.Some("is not minimally encoded")
        false -> Option.None

verify minimalFault
    minimalFault([1, 0], true) => Option.Some("is not minimally encoded")
    minimalFault([1, 0], false) => Option.None
    minimalFault([128], true) => Option.Some("is not minimally encoded")
    minimalFault([1], true) => Option.None
    minimalFault([], true) => Option.None

fn arithmeticFaultIn(items: List<List<Int>>, minimal: Bool) -> Option<String>
    ? "The first of these operands that cannot be read, if any cannot."
      "The order is the order they are given, and callers give them top of"
      "stack first so the message names the same operand the reference client"
      "would have named."
    match items
        [] -> Option.None
        [head, ..tail] -> faultOrNext(head, tail, minimal)

verify arithmeticFaultIn
    arithmeticFaultIn([], true) => Option.None
    arithmeticFaultIn([[1], [2]], true) => Option.None
    arithmeticFaultIn([[1], [1, 0]], true) => Option.Some("is not minimally encoded")
    arithmeticFaultIn([[1, 2, 3, 4, 5], [1, 0]], true) => Option.Some("is over four bytes")

fn faultOrNext(head: List<Int>, tail: List<List<Int>>, minimal: Bool) -> Option<String>
    ? "This one, or whatever is wrong with the ones after it."
    match arithmeticFault(head, minimal)
        Option.Some(why) -> Option.Some(why)
        Option.None -> arithmeticFaultIn(tail, minimal)

verify faultOrNext
    faultOrNext([1], [], true) => Option.None
    faultOrNext([1, 0], [], true) => Option.Some("is not minimally encoded")
    faultOrNext([1], [[1, 0]], true) => Option.Some("is not minimally encoded")

fn pushFault(code: Int, data: List<Int>, minimal: Bool) -> Option<String>
    ? "MINIMALDATA over the push itself: a rule about how it was written."
      "Distinct from the one above, which is about a number being read. This"
      "one is about the opcode chosen to put the bytes there, and the two have"
      "separate errors in Core -- MINIMALDATA against SCRIPTNUM -- because"
      "they catch different mistakes."
    match Bool.and(minimal, isMinimalPush(code, data) == false)
        true -> Option.Some("push is not written the shortest way it could be")
        false -> Option.None

verify pushFault
    pushFault(1, [1], true) => Option.Some("push is not written the shortest way it could be")
    pushFault(1, [1], false) => Option.None
    pushFault(1, [17], true) => Option.None
    pushFault(76, [17], true) => Option.Some("push is not written the shortest way it could be")
    pushFault(0, [], true) => Option.None

fn isConditionMinimal(item: List<Int>) -> Bool
    ? "Whether OP_IF's argument is exactly true or exactly false."
      "The empty push or a single byte holding one, and nothing else. This is"
      "narrower than isMinimalNumber, which would accept any number written"
      "the shortest way -- OP_IF casts to a Bool and every non-zero item casts"
      "to true, so without this a Witness could carry any of a great many"
      "items where a one is meant and change the Transaction Id by choosing"
      "between them. That is what BIP147's sibling rule closes."
    match item
        [] -> true
        [head, ..rest] -> onlyOne(head, rest)

verify isConditionMinimal
    isConditionMinimal([]) => true
    isConditionMinimal([1]) => true
    isConditionMinimal([0]) => false
    isConditionMinimal([2]) => false
    isConditionMinimal([1, 0]) => false
    isConditionMinimal([129]) => false

fn onlyOne(head: Int, rest: List<Int>) -> Bool
    ? "One byte, and that byte a one."
    match rest
        [] -> head == 1
        [next, ..more] -> false

verify onlyOne
    onlyOne(1, []) => true
    onlyOne(0, []) => false
    onlyOne(1, [0]) => false

fn minimalReason(value: Int) -> Bool
    ? "Zero is minimal. Otherwise the leading element belongs to the digit list,"
      "is positive, and admits a minimal sign placement. An empty digit list"
      "would require a non-positive magnitude."
    m = magnitudeOf(value)
    bytes = littleEndian(m, [])
    match value == 0
        true -> isMinimalNumber(fromNumber(value))
        false -> match List.reverse(bytes)
            [] -> m <= 0
            [top, ..rest] -> Bool.and(
                List.contains(bytes, top),
                Bool.and(top > 0, isMinimalNumber(placed(top, rest, value < 0)))
            )

verify minimalReason
    minimalReason(0) => true
    minimalReason(1) => true
    minimalReason(-1) => true
    minimalReason(128) => true
    minimalReason(2147483648) => true

fn numberReadbackReason(value: Int) -> Bool
    ? "Read the magnitude, then remove exactly the sign that was placed."
    m = magnitudeOf(value)
    bytes = littleEndian(m, [])
    match value == 0
        true -> asNumber(fromNumber(value)) == value
        false -> match List.reverse(bytes)
            [] -> m <= 0
            [top, ..rest] -> Bool.and(
                List.contains(bytes, top),
                Bool.and(top >= 0, Bool.and(
                    asNumber(placed(top, rest, value < 0)) == signedBy(bigEndian(List.prepend(top, rest), 0), value < 0),
                    bigEndian(List.prepend(top, rest), 0) == m
                ))
            )

verify numberReadbackReason
    numberReadbackReason(0) => true
    numberReadbackReason(-128) => true
    numberReadbackReason(2147483648) => true

fn truthinessReason(value: Int) -> Bool
    ? "Zero is the empty string, which is false. Otherwise the leading digit"
      "belongs to the digit list, is positive, and stays set through sign"
      "placement. An empty digit list would require a non-positive magnitude."
    m = magnitudeOf(value)
    bytes = littleEndian(m, [])
    match value == 0
        true -> isTruthy(fromNumber(value)) == false
        false -> match List.reverse(bytes)
            [] -> m <= 0
            [top, ..rest] -> Bool.and(
                List.contains(bytes, top),
                Bool.and(top > 0, isTruthy(placed(top, rest, value < 0)))
            )

verify truthinessReason
    truthinessReason(0) => true
    truthinessReason(1) => true
    truthinessReason(-1) => true
    truthinessReason(128) => true
    truthinessReason(-128) => true
    truthinessReason(2147483648) => true

fn negativeZeroReason(item: List<Int>) -> Bool
    ? "A sign byte appended to an item leads its reversal, and looking for a"
      "set byte below it does not care which way round the rest is read."
    Bool.and(
        List.reverse(List.concat(item, [128])) == List.prepend(128, List.reverse(item)),
        anyNonZero(List.reverse(item)) == anyNonZero(item)
    )

verify negativeZeroReason
    negativeZeroReason([]) => true
    negativeZeroReason([0, 1]) => true
    negativeZeroReason([1, 0, 128]) => true

fn concatenationReason(left: List<Int>, right: List<Int>) -> Bool
    ? "A set byte in the joined list is on one side or the other, one byte of"
      "the left side at a time."
    match left
        [] -> anyNonZero(List.concat(left, right)) == anyNonZero(right)
        [head, ..tail] -> Bool.and(
            concatenationReason(tail, right),
            anyNonZero(List.concat(left, right)) == Bool.or(anyNonZero(left), anyNonZero(right))
        )

verify concatenationReason
    concatenationReason([], [0, 1]) => true
    concatenationReason([0, 1], []) => true
    concatenationReason([0, 0], [0, 128]) => true

fn reversalReason(bytes: List<Int>) -> Bool
    ? "Reversal moves the head to the end, where the concatenation law finds it."
    match bytes
        [] -> anyNonZero(List.reverse(bytes)) == anyNonZero(bytes)
        [head, ..tail] -> Bool.and(
            reversalReason(tail),
            anyNonZero(List.reverse(bytes)) == anyNonZero(bytes)
        )

verify reversalReason
    reversalReason([]) => true
    reversalReason([0, 1]) => true
    reversalReason([1, 0, 0]) => true

fn largerPrefixReason(bytes: List<Int>, lower: Int, upper: Int) -> Bool
    ? "A larger prefix stays larger after each byte, with both prefixes advancing together."
    match bytes
        [] -> lower < upper
        [head, ..tail] -> Bool.and(
            largerPrefixReason(tail, lower * 256 + head, upper * 256 + head),
            bigEndian(bytes, lower) < bigEndian(bytes, upper)
        )

verify largerPrefixReason
    largerPrefixReason([], 0, 1) => true
    largerPrefixReason([255, 0, 7], -2, 300) => true
    largerPrefixReason([1, 2], 1, 1) => false
    largerPrefixReason([1, 2], 1, 0) => false

fn validBytes(bytes: List<Int>) -> Bool
    ? "Every element is an octet."
    match bytes
        [] -> true
        [head, ..tail] -> Bool.and(Bool.and(head >= 0, head < 256), validBytes(tail))

verify validBytes
    validBytes([]) => true
    validBytes([0, 128, 255]) => true
    validBytes([-1]) => false
    validBytes([256]) => false

verify validBytes law headAndTail
    given head: Int = [-1, 0, 255, 256]
    given tail: List<Int> = [[], [1, 2], [256]]
    validBytes(List.prepend(head, tail)) => Bool.and(Bool.and(head >= 0, head < 256), validBytes(tail))

verify validBytes law concatenation
    given left: List<Int> = [[], [1, 2], [-1]]
    given right: List<Int> = [[], [255], [256]]
    induction left
    validBytes(List.concat(left, right)) => Bool.and(validBytes(left), validBytes(right))

verify validBytes law reversal
    given bytes: List<Int> = [[], [1, 2], [-1, 256], [255, 0, 128]]
    using [validBytes.concatenation]
    validBytes(List.reverse(bytes)) => validBytes(bytes)

fn afterFirstDigit(value: Int) -> List<Int>
    ? "Write the remaining magnitude with its first digit already collected."
    littleEndian(Int.div(value, 256), [Int.mod(value, 256)])

verify afterFirstDigit
    afterFirstDigit(1) => [1]
    afterFirstDigit(256) => [0, 1]

fn digitStepReason(prefix: Int, digit: Int) -> Bool
    ? "The quotient recovers the prefix and the remainder recovers the digit."
    value = prefix * 256 + digit
    Bool.and(value > 0, Bool.and(
        littleEndian(value, []) == afterFirstDigit(value),
        Bool.and(Int.div(value, 256) == prefix, Bool.and(Int.mod(value, 256) == digit,
            littleEndian(prefix, [digit]) == List.prepend(digit, littleEndian(prefix, []))))
    ))

verify digitStepReason
    digitStepReason(1, 0) => true
    digitStepReason(128, 255) => true

fn digitsReadbackReason(bytes: List<Int>, prefix: Int) -> Bool
    ? "An existing positive prefix stays positive; each read octet is written back first."
    match bytes
        [] -> littleEndian(bigEndian(bytes, prefix), []) == List.concat(List.reverse(bytes), littleEndian(prefix, []))
        [head, ..tail] -> Bool.and(
            digitsReadbackReason(tail, prefix * 256 + head),
            littleEndian(bigEndian(bytes, prefix), []) == List.concat(List.reverse(bytes), littleEndian(prefix, []))
        )

verify digitsReadbackReason
    digitsReadbackReason([], 1) => true
    digitsReadbackReason([0, 255], 128) => true
    digitsReadbackReason([0], 0) => false

fn positiveReadReason(bytes: List<Int>, prefix: Int) -> Bool
    ? "A positive magnitude prefix stays positive after every valid octet."
    match bytes
        [] -> bigEndian(bytes, prefix) > 0
        [head, ..tail] -> Bool.and(positiveReadReason(tail, prefix * 256 + head), bigEndian(bytes, prefix) > 0)

verify positiveReadReason
    positiveReadReason([], 1) => true
    positiveReadReason([0, 255], 128) => true
    positiveReadReason([], 0) => false

fn minimalFromTop(reversed: List<Int>) -> Bool
    ? "The minimal encoding rule read from the top byte down, on an item already reversed."
    match reversed
        [] -> true
        [top, ..rest] -> topIsNeeded(top, rest)

verify minimalFromTop
    minimalFromTop([]) => true
    minimalFromTop([0, 128]) => true
    minimalFromTop([128]) => false

verify minimalFromTop law topHasMagnitude
    given top: Int = [0, 1, 127, 128, 129, 255]
    given rest: List<Int> = [[], [0], [128], [255, 0], [1, 2, 3]]
    when Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest)))
    because validBytes(rest)
    using [validBytes.headAndTail, bigEndian.headStartsPrefix, bigEndian.positivePrefixStaysPositive]
    bigEndian(List.prepend(unsigned(top), rest), 0) > 0 holds

fn digitsFromTop(reversed: List<Int>) -> Bool
    ? "The digit readback of a minimal item, read from the top byte down on an item already reversed."
    match reversed
        [] -> true
        [top, ..rest] -> match unsigned(top) > 0
            true -> Bool.and(validBytes(rest), Bool.and(
                bigEndian(rest, unsigned(top)) > 0,
                littleEndian(bigEndian(rest, unsigned(top)), []) == List.concat(List.reverse(rest), [unsigned(top)])
            ))
            false -> match rest
                [] -> false
                [head, ..tail] -> Bool.and(validBytes(reversed), Bool.and(
                    Bool.or(top == 0, top == 128), Bool.and(head >= 128, Bool.and(validBytes(tail), Bool.and(
                        bigEndian(tail, head) > 0,
                        littleEndian(bigEndian(tail, head), []) == List.concat(List.reverse(tail), [head])
                    )))
                ))

verify digitsFromTop
    digitsFromTop([]) => true
    digitsFromTop([0, 128]) => true
    digitsFromTop([128]) => false

verify digitsFromTop law minimalTopReadsBack
    given top: Int = [0, 1, 127, 128, 129, 255]
    given rest: List<Int> = [[], [0], [128], [255, 0], [1, 2, 3]]
    when Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest)))
    using [bigEndian.positivePrefixStaysPositive, littleEndian.writesReadBytesThenDigit]
    digitsFromTop(List.prepend(top, rest)) holds

verify digitsFromTop law minimalReversedReadsBack
    given reversed: List<Int> = [[], [0], [1], [128], [0, 128], [128, 0], [127, 255, 255, 255]]
    when Bool.and(validBytes(reversed), minimalFromTop(reversed))
    using [digitsFromTop.minimalTopReadsBack]
    digitsFromTop(reversed) holds

fn canonicalDigitsReason(item: List<Int>) -> Bool
    ? "A minimal top byte is either a magnitude digit or a necessary separate sign byte."
    match List.reverse(item)
        [] -> item == []
        [top, ..rest] -> match unsigned(top) > 0
            true -> Bool.and(validBytes(rest), Bool.and(
                bigEndian(rest, unsigned(top)) > 0,
                littleEndian(bigEndian(rest, unsigned(top)), []) == List.concat(List.reverse(rest), [unsigned(top)])
            ))
            false -> match rest
                [] -> false
                [head, ..tail] -> Bool.and(validBytes(List.reverse(item)), Bool.and(
                    Bool.or(top == 0, top == 128), Bool.and(head >= 128, Bool.and(validBytes(tail), Bool.and(
                        bigEndian(tail, head) > 0,
                        littleEndian(bigEndian(tail, head), []) == List.concat(List.reverse(tail), [head])
                    )))
                ))

verify canonicalDigitsReason
    canonicalDigitsReason([]) => true
    canonicalDigitsReason([128, 0]) => true
    canonicalDigitsReason([255, 128]) => true

verify canonicalDigitsReason law readsFromTheTop
    given low: Int = [0, 1, 128, 255]
    given higher: List<Int> = [[], [0], [128], [1, 0], [255, 255, 127]]
    using [List.len.ofReverse, List.len.ofConcat]
    canonicalDigitsReason(List.prepend(low, higher)) => digitsFromTop(List.reverse(List.prepend(low, higher)))

verify canonicalDigitsReason law minimalItemDigitsReadBack
    given item: List<Int> = [[], [1], [129], [128], [0], [1, 0], [128, 0], [128, 128], [255, 255, 255, 127], [0, 0, 0, 128, 0]]
    when Bool.and(validBytes(item), isMinimalNumber(item))
    because validBytes(List.reverse(item))
    because minimalFromTop(List.reverse(item))
    because canonicalDigitsReason(item)
    using [validBytes.headAndTail, validBytes.reversal, bigEndian.positivePrefixStaysPositive, bigEndian.writingReadDigitsPreservesThem, littleEndian.oneDigitEncoding, canonicalDigitsReason.readsFromTheTop, digitsFromTop.minimalReversedReadsBack]
    canonicalDigitsReason(item) holds

fn restoredFromTop(reversed: List<Int>) -> Bool
    ? "The top byte restored after reading magnitude and sign, on an item already reversed."
    match reversed
        [] -> true
        [top, ..rest] -> match unsigned(top) > 0
            true -> fromNumber(valued(top, rest)) == List.reverse(List.prepend(top, rest))
            false -> match rest
                [] -> false
                [head, ..tail] -> fromNumber(valued(top, rest)) == List.reverse(List.prepend(top, rest))

verify restoredFromTop
    restoredFromTop([]) => true
    restoredFromTop([0, 128]) => true
    restoredFromTop([128]) => false

verify restoredFromTop law magnitudeTopIsRestored
    given top: Int = [1, 127, 129, 255]
    given rest: List<Int> = [[], [0], [128], [255, 0], [1, 2, 3]]
    when Bool.and(Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest))), unsigned(top) > 0)
    because digitsFromTop(List.prepend(top, rest))
    using [digitsFromTop.minimalTopReadsBack, minimalFromTop.topHasMagnitude, withSign.restoresMagnitudeTop, validBytes.headAndTail, bigEndian.headStartsPrefix, fromNumber.signedMagnitudeEncoding]
    fromNumber(valued(top, rest)) => List.reverse(List.prepend(top, rest))

verify restoredFromTop law positiveSignByteValueIsRestored
    given top: Int = [0]
    given rest: List<Int> = [[], [0], [128], [255, 0], [128, 2, 3]]
    when Bool.and(top == 0, Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest))))
    using [bigEndian.positivePrefixStaysPositive, littleEndian.writesReadBytesThenDigit, withSign.restoresSeparateSign, fromNumber.signedMagnitudeEncoding]
    induction rest
    fromNumber(valued(top, rest)) => List.reverse(List.prepend(top, rest))

verify restoredFromTop law negativeSignByteValueIsRestored
    given top: Int = [128]
    given rest: List<Int> = [[], [0], [128], [255, 0], [128, 2, 3]]
    when Bool.and(top == 128, Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest))))
    using [bigEndian.positivePrefixStaysPositive, littleEndian.writesReadBytesThenDigit, withSign.restoresSeparateSign, fromNumber.signedMagnitudeEncoding]
    induction rest
    fromNumber(valued(top, rest)) => List.reverse(List.prepend(top, rest))

verify restoredFromTop law minimalTopIsRestored
    given top: Int = [0, 1, 127, 128, 129, 255]
    given rest: List<Int> = [[], [0], [128], [255, 0], [1, 2, 3]]
    when Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest)))
    using [restoredFromTop.magnitudeTopIsRestored, restoredFromTop.positiveSignByteValueIsRestored, restoredFromTop.negativeSignByteValueIsRestored]
    induction rest
    restoredFromTop(List.prepend(top, rest)) holds

verify restoredFromTop law signByteValueIsRestored
    given top: Int = [0, 128]
    given rest: List<Int> = [[], [0], [128], [255, 0], [128, 2, 3]]
    when Bool.and(Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest))), Bool.not(unsigned(top) > 0))
    using [restoredFromTop.negativeSignByteValueIsRestored, restoredFromTop.positiveSignByteValueIsRestored]
    fromNumber(valued(top, rest)) => List.reverse(List.prepend(top, rest))

verify restoredFromTop law minimalValueIsRestored
    given top: Int = [0, 1, 127, 128, 129, 255]
    given rest: List<Int> = [[], [0], [128], [255, 0], [1, 2, 3]]
    when Bool.and(validBytes(List.prepend(top, rest)), minimalFromTop(List.prepend(top, rest)))
    using [restoredFromTop.magnitudeTopIsRestored, restoredFromTop.signByteValueIsRestored]
    fromNumber(valued(top, rest)) => List.reverse(List.prepend(top, rest))

verify restoredFromTop law minimalReversedIsRestored
    given reversed: List<Int> = [[], [0], [1], [128], [0, 128], [128, 0], [127, 255, 255, 255]]
    when Bool.and(validBytes(reversed), minimalFromTop(reversed))
    using [restoredFromTop.minimalTopIsRestored]
    restoredFromTop(reversed) holds

fn canonicalReason(item: List<Int>) -> Bool
    ? "Restore the original top byte after reading the magnitude and sign."
    match List.reverse(item)
        [] -> fromNumber(asNumber(item)) == item
        [top, ..rest] -> match unsigned(top) > 0
            true -> fromNumber(valued(top, rest)) == List.reverse(List.prepend(top, rest))
            false -> match rest
                [] -> false
                [head, ..tail] -> fromNumber(valued(top, rest)) == List.reverse(List.prepend(top, rest))

verify canonicalReason
    canonicalReason([]) => true
    canonicalReason([1]) => true
    canonicalReason([128, 0]) => true
    canonicalReason([128, 128]) => true
    canonicalReason([128]) => false
    canonicalReason([0, 1]) => true

verify canonicalReason law readsFromTheTop
    given low: Int = [0, 1, 128, 255]
    given higher: List<Int> = [[], [0], [128], [1, 0], [255, 255, 127]]
    using [List.len.ofReverse, List.len.ofConcat]
    canonicalReason(List.prepend(low, higher)) => restoredFromTop(List.reverse(List.prepend(low, higher)))

fn smallSize(magnitude: Int) -> Int
    ? "Byte count for a nonnegative magnitude below 256: zero, a byte with sign room, or a byte plus sign."
    match magnitude > 0
        false -> 0
        true -> match magnitude < 128
            true -> 1
            false -> 2

verify smallSize
    smallSize(0) => 0
    smallSize(127) => 1
    smallSize(128) => 2
    smallSize(255) => 2

fn sizeRecurrenceReason(magnitude: Int, negative: Bool) -> Bool
    ? "A small magnitude is the base case; otherwise one low byte precedes the quotient encoding."
    match magnitude < 256
        true -> List.len(signedBytes(magnitude, negative)) == smallSize(magnitude)
        false -> Bool.and(
            Int.div(magnitude, 256) > 0,
            List.len(signedBytes(magnitude, negative)) == 1 + List.len(signedBytes(Int.div(magnitude, 256), negative))
        )

verify sizeRecurrenceReason
    sizeRecurrenceReason(0, false) => true
    sizeRecurrenceReason(128, true) => true
    sizeRecurrenceReason(256, false) => true
    sizeRecurrenceReason(2147483648, true) => true

fn lowByteReason(digit: Int, tail: List<Int>, negative: Bool) -> Bool
    ? "The sign lives at the far end, so a nonempty tail keeps a prepended byte untouched."
    match List.reverse(tail)
        [] -> false
        [top, ..rest] -> withSign(List.prepend(digit, tail), negative) == List.prepend(digit, withSign(tail, negative))

verify lowByteReason
    lowByteReason(7, [], false) => false
    lowByteReason(7, [128], true) => true
