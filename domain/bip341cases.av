module Bip341Cases
    intent =
        "BIP341's own key path spending vectors, the sighash half."
        "One Transaction with nine Inputs and seven signed spends across it,"
        "covering DEFAULT, ALL, NONE, SINGLE and the ANYONECANPAY forms. The"
        "expected hashes are the BIP's, not this engine's, so this is a"
        "conformance corpus and not a regression one -- the only other in the"
        "project is Core's sighash.json for the legacy hash."
        "Taken from bip-0341/wallet-test-vectors.json, keyPathSpending, the"
        "intermediary sigHash of each inputSpending entry. Nothing here was"
        "written by hand."
    exposes [check]
    depends [Bytes, Domain.Bip341, Domain.Transaction]
    effects []

fn check(rawHex: String, inputIndex: Int, prevouts: List<Prevout>, hashType: Int) -> Result<String, String>
    ? "One vector: the Transaction, which Input, what it spends, and how."
    Domain.Bip341.message(Domain.Transaction.decode(Bytes.toList(Bytes.fromHex(rawHex)?))?, inputIndex, prevouts, hashType, Option.None)

verify check
    check("", 0, [Prevout(amount = 420000000, script = "512053a1f6e454df1aa2776a2814a721372d6258050de330b3c6d10ee8f4e0dda343"), Prevout(amount = 462000000, script = "5120147c9c57132f6e7ecddba9800bb0c4449251c92a1e60371ee77557b6620f3ea3"), Prevout(amount = 294000000, script = "76a914751e76e8199196d454941c45d1b3a323f1433bd688ac"), Prevout(amount = 504000000, script = "5120e4d810fd50586274face62b8a807eb9719cef49c04177cc6b76a9a4251d5450e"), Prevout(amount = 630000000, script = "512091b64d5324723a985170e4dc5a0f84c041804f2cd12660fa5dec09fc21783605"), Prevout(amount = 378000000, script = "00147dd65592d0ab2fe0d0257d571abf032cd9db93dc"), Prevout(amount = 672000000, script = "512075169f4001aa68f15bbed28b218df1d0a62cbbcf1188c6665110c293c907b831"), Prevout(amount = 546000000, script = "5120712447206d7a5238acc7ff53fbe94a3b64539ad291c7cdbc490b7577e4b17df5"), Prevout(amount = 588000000, script = "512077e30a5522dd9f894c3f8b8bd4c4b2cf82ca7da8a3ea6a239655c39c050ab220")], 3) => Result.Ok("2514a6272f85cfa0f45eb907fcb0d121b808ed37c6ea160a5a9046ed5526d555")
