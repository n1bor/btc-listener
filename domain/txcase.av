module TxCase
    intent =
        "One whole Transaction run against the Outputs it spends."
        "Bitcoin Core keeps two corpora and they test different things."
        "script_tests.json is pairs of Scripts, and its harness builds the"
        "crediting Transaction out of the Output Script -- so the Transaction"
        "Id, and therefore the signature hash, depends on the Script. A"
        "signature embedded in that Script would have to sign a digest that"
        "depends on itself, and there is no fixed point to find. Everything"
        "that depends on the Transaction rather than the Script therefore"
        "lives in tx_valid.json and tx_invalid.json instead: FindAndDelete,"
        "the SIGHASH_SINGLE bug, hash types, sequence and lock time."
        "This is what runs one of those. It takes the Outputs inline rather"
        "than from a Store, because a case carries its own prevouts and"
        "building a Store around them would put a database in the way of a"
        "pure question."
    exposes [Prevout, verdict]
    depends [Bytes, Domain.Bip341, Domain.Rules, Domain.TxCheck, Domain.ScriptState, Domain.SpendContext, Domain.SpendScript, Domain.Transaction]
    effects []

record Prevout
    txid: String
    index: Int
    script: String
    amount: Int

fn verdict(rawHex: String, prevouts: List<Prevout>, rules: Rules) -> Outcome
    ? "Every Input of this Transaction, against the Output it names."
      "One answer for the whole Transaction: a failure anywhere fails it, and"
      "anything this engine cannot decide leaves it undecided, because a"
      "Transaction is valid only if every one of its Inputs is."
    match Bytes.fromHex(rawHex)
        Result.Err(why) -> Outcome.Decided(Ending.Failed(why))
        Result.Ok(raw) -> decoded(Domain.Transaction.decode(Bytes.octets(raw)), prevouts, rules)

verify verdict
    verdict("zz", [], Domain.Rules.latest()) => Outcome.Decided(Ending.Failed("Bytes.fromHex: invalid hexadecimal character 'z'"))
    verdict("", [], Domain.Rules.latest()) => Outcome.Decided(Ending.Failed("Transaction ends before its lock time"))

fn decoded(transaction: Result<Transaction, String>, prevouts: List<Prevout>, rules: Rules) -> Outcome
    ? "A Transaction that will not decode fails before any Script runs."
    match transaction
        Result.Err(why) -> Outcome.Decided(Ending.Failed(why))
        Result.Ok(whole) -> shaped(whole, prevouts, rules)

verify decoded
    decoded(Result.Err("no"), [], Domain.Rules.latest()) => Outcome.Decided(Ending.Failed("no"))
    decoded(Result.Ok(Domain.SpendContext.emptyTransaction()), [], Domain.Rules.latest()) => Outcome.Decided(Ending.Failed("no inputs"))

fn shaped(transaction: Transaction, prevouts: List<Prevout>, rules: Rules) -> Outcome
    ? "Bitcoin's CheckTransaction runs before any Script does, and rejects a"
      "Transaction on its shape alone: no Inputs, an amount that cannot"
      "exist, the same Output spent twice. Core marks those cases BADTX and"
      "they are as much consensus as anything a Script decides."
    match Domain.TxCheck.wrongWith(transaction)
        Option.Some(why) -> Outcome.Decided(Ending.Failed(why))
        Option.None -> eachInput(transaction, Domain.Transaction.inputsOf(transaction), 0, prevouts, rules, Outcome.Decided(Ending.Passed))

verify shaped
    shaped(Domain.SpendContext.emptyTransaction(), [], Domain.Rules.latest()) => Outcome.Decided(Ending.Failed("no inputs"))

fn eachInput(transaction: Transaction, inputs: List<Input>, position: Int, prevouts: List<Prevout>, rules: Rules, sofar: Outcome) -> Outcome
    ? "In order, carrying the worst answer so far."
    match inputs
        [] -> sofar
        [head, ..tail] -> stepInput(transaction, head, tail, position, prevouts, rules, sofar)

verify eachInput
    eachInput(Domain.SpendContext.emptyTransaction(), [], 0, [], Domain.Rules.latest(), Outcome.Decided(Ending.Passed)) => Outcome.Decided(Ending.Passed)
    eachInput(Domain.SpendContext.emptyTransaction(), [Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = [])], 0, [], Domain.Rules.latest(), Outcome.Decided(Ending.Passed)) => Outcome.Decided(Ending.Failed("no prevout supplied for input 0"))

fn stepInput(transaction: Transaction, input: Input, rest: List<Input>, position: Int, prevouts: List<Prevout>, rules: Rules, sofar: Outcome) -> Outcome
    ? "An Input whose Output the case did not supply is the case's own fault"
      "and is said so, rather than being counted as a Script that failed."
    match matching(prevouts, Domain.Transaction.previousTxidOf(input), Domain.Transaction.previousIndexOf(input))
        Option.None -> Outcome.Decided(Ending.Failed("no prevout supplied for input {position}"))
        Option.Some(prevout) -> eachInput(transaction, rest, position + 1, prevouts, rules, worse(sofar, oneInput(transaction, input, position, prevout, spentOutputs(transaction, prevouts), rules)))

verify stepInput
    stepInput(Domain.SpendContext.emptyTransaction(), Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = []), [], 0, [], Domain.Rules.latest(), Outcome.Decided(Ending.Passed)) => Outcome.Decided(Ending.Failed("no prevout supplied for input 0"))

fn spentOutputs(transaction: Transaction, prevouts: List<Prevout>) -> List<Spent>
    ? "Every Input's spent Output, in Input order, as Taproot needs them."
      "In order and complete or not at all: an Input whose Output the case did"
      "not supply would shift every later index if it were simply left out, so"
      "a gap gives the empty list and Domain.Bip341 refuses a message whose"
      "count does not match the Input count. Undecided, never a wrong hash."
    gathered(Domain.Transaction.inputsOf(transaction), prevouts, [])

verify spentOutputs
    spentOutputs(Domain.SpendContext.emptyTransaction(), []) => []

fn gathered(inputs: List<Input>, prevouts: List<Prevout>, acc: List<Spent>) -> List<Spent>
    ? "Each Input's Output looked up by name, in order."
    match inputs
        [] -> List.reverse(acc)
        [head, ..tail] -> gatheredOne(head, tail, prevouts, acc)

verify gathered
    gathered([], [], []) => []
    gathered([Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = [])], [], []) => []

fn gatheredOne(input: Input, rest: List<Input>, prevouts: List<Prevout>, acc: List<Spent>) -> List<Spent>
    ? "One Input; a miss abandons the whole list rather than shortening it."
    match matching(prevouts, Domain.Transaction.previousTxidOf(input), Domain.Transaction.previousIndexOf(input))
        Option.None -> []
        Option.Some(found) -> gathered(rest, prevouts, List.prepend(Spent(amount = found.amount, script = found.script), acc))

verify gatheredOne
    gatheredOne(Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = []), [], [], []) => []
    gatheredOne(Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = []), [], [Prevout(txid = "aa", index = 0, script = "51", amount = 5)], []) => [Spent(amount = 5, script = "51")]

fn oneInput(transaction: Transaction, input: Input, position: Int, prevout: Prevout, spent: List<Spent>, rules: Rules) -> Outcome
    ? "The Input Script and the Output Script, run the way a spend runs them,"
      "over a Context that names the Transaction so a signature has something"
      "to have committed to."
    Domain.SpendScript.check(Domain.Transaction.scriptOf(input), prevout.script, Domain.SpendContext.withPrevouts(Domain.SpendContext.committed(rules, transaction, position, prevout.amount, prevout.script, Domain.Transaction.witnessOf(input)), spent))

verify oneInput
    oneInput(Domain.SpendContext.emptyTransaction(), Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), 0, Prevout(txid = "aa", index = 0, script = "51", amount = 0), [], Domain.Rules.latest()) => Outcome.Decided(Ending.Passed)

fn matching(prevouts: List<Prevout>, txid: String, index: Int) -> Option<Prevout>
    ? "The Output an Input names, out of the ones the case supplied."
    match prevouts
        [] -> Option.None
        [head, ..tail] -> thisOrNext(head, tail, txid, index)

verify matching
    matching([], "aa", 0) => Option.None
    matching([Prevout(txid = "aa", index = 0, script = "51", amount = 5)], "aa", 0) => Option.Some(Prevout(txid = "aa", index = 0, script = "51", amount = 5))
    matching([Prevout(txid = "aa", index = 0, script = "51", amount = 5)], "aa", 1) => Option.None

fn thisOrNext(head: Prevout, tail: List<Prevout>, txid: String, index: Int) -> Option<Prevout>
    ? "Matched on both halves of the name, because an Input names a position."
    match Bool.and(head.txid == txid, head.index == index)
        true -> Option.Some(head)
        false -> matching(tail, txid, index)

verify thisOrNext
    thisOrNext(Prevout(txid = "aa", index = 0, script = "51", amount = 5), [], "aa", 0) => Option.Some(Prevout(txid = "aa", index = 0, script = "51", amount = 5))
    thisOrNext(Prevout(txid = "aa", index = 0, script = "51", amount = 5), [], "bb", 0) => Option.None

fn worse(sofar: Outcome, next: Outcome) -> Outcome
    ? "A failure anywhere beats an undecided anywhere beats a pass."
      "Order matters for the message: the first failure is the one reported,"
      "so a reader is sent to the earliest Input that went wrong rather than"
      "the last."
    match sofar
        Outcome.Undecided(why) -> stillUndecided(why, next)
        Outcome.Decided(ending) -> afterDecided(ending, next)

verify worse
    worse(Outcome.Decided(Ending.Passed), Outcome.Decided(Ending.Passed)) => Outcome.Decided(Ending.Passed)
    worse(Outcome.Decided(Ending.Passed), Outcome.Undecided("x")) => Outcome.Undecided("x")
    worse(Outcome.Undecided("x"), Outcome.Decided(Ending.Failed("y"))) => Outcome.Decided(Ending.Failed("y"))
    worse(Outcome.Decided(Ending.Failed("y")), Outcome.Decided(Ending.Failed("z"))) => Outcome.Decided(Ending.Failed("y"))

fn stillUndecided(why: String, next: Outcome) -> Outcome
    ? "Only a failure displaces an undecided."
    match next
        Outcome.Undecided(other) -> Outcome.Undecided(why)
        Outcome.Decided(ending) -> keptUnlessFailed(why, ending)

verify stillUndecided
    stillUndecided("x", Outcome.Decided(Ending.Passed)) => Outcome.Undecided("x")
    stillUndecided("x", Outcome.Undecided("y")) => Outcome.Undecided("x")
    stillUndecided("x", Outcome.Decided(Ending.Failed("y"))) => Outcome.Decided(Ending.Failed("y"))

fn keptUnlessFailed(why: String, ending: Ending) -> Outcome
    ? "The undecided stands unless the next Input actually failed."
    match ending
        Ending.Failed(reason) -> Outcome.Decided(Ending.Failed(reason))
        Ending.Passed -> Outcome.Undecided(why)

verify keptUnlessFailed
    keptUnlessFailed("x", Ending.Passed) => Outcome.Undecided("x")
    keptUnlessFailed("x", Ending.Failed("y")) => Outcome.Decided(Ending.Failed("y"))

fn afterDecided(ending: Ending, next: Outcome) -> Outcome
    ? "A failure already found is kept; a pass gives way to anything worse."
    match ending
        Ending.Failed(why) -> Outcome.Decided(Ending.Failed(why))
        Ending.Passed -> next

verify afterDecided
    afterDecided(Ending.Failed("y"), Outcome.Decided(Ending.Passed)) => Outcome.Decided(Ending.Failed("y"))
    afterDecided(Ending.Passed, Outcome.Undecided("x")) => Outcome.Undecided("x")
