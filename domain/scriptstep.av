module ScriptStep
    intent =
        "The three ways an opcode finishes, kept where more than one module can"
        "reach them."
        "Putting an item on the stack, replacing the stack, and stopping when an"
        "answer came out false. Every opcode ends in one of these, and the"
        "signature opcodes are in their own module because Domain.ScriptOps had"
        "no room left, so these had to come out from under it."
        "The stack limit lives here rather than in each caller because it is"
        "checked on the way out of every opcode that grows the stack, and one"
        "place is easier to be sure of than fifteen."
    exposes [landed, pushing, pushingMinimal, nopped, stoppedUnless, undecidedUnlessNop]
    depends [Domain.Network, Domain.Opcode, Domain.Rules, Domain.ScriptState, Domain.StackItem]
    effects []

fn landed(stack: List<List<Int>>, state: State) -> Step
    ? "Carry on with a new data stack, unless the two stacks together have"
      "grown past the limit."
    limit = Domain.ScriptState.maxStack()
    match List.len(stack) + List.len(state.alt) > limit
        true -> Step.Stop(Outcome.Decided(Ending.Failed("stack is over the {limit} item limit")))
        false -> Step.Continue(Domain.ScriptState.withStack(state, stack))

verify landed
    landed([[1]], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    landed(Domain.ScriptState.repeated(1001, [1]), Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("stack is over the 1000 item limit")))

fn pushing(item: List<Int>, state: State) -> Step
    ? "One more item on the data stack."
    landed(List.prepend(item, state.stack), state)

verify pushing
    pushing([1], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    pushing([1], Domain.ScriptState.holding(Domain.ScriptState.repeated(1000, [2]))) => Step.Stop(Outcome.Decided(Ending.Failed("stack is over the 1000 item limit")))

fn pushingMinimal(code: Int, item: List<Int>, state: State, minimal: Bool) -> Step
    ? "One more item, unless MINIMALDATA objects to how it was pushed."
      "It is here rather than in Domain.ScriptOps because that file had no"
      "room, and here rather than folded into pushing because most callers"
      "are opcodes putting a computed value on the stack and there is no push"
      "opcode behind those to be minimal or not."
    match Domain.StackItem.pushFault(code, item, minimal)
        Option.Some(why) -> Step.Stop(Outcome.Decided(Ending.Failed(why)))
        Option.None -> pushing(item, state)

verify pushingMinimal
    pushingMinimal(1, [1], Domain.ScriptState.empty(), false) => Step.Continue(Domain.ScriptState.holding([[1]]))
    pushingMinimal(1, [1], Domain.ScriptState.empty(), true) => Step.Stop(Outcome.Decided(Ending.Failed("push is not written the shortest way it could be")))
    pushingMinimal(1, [17], Domain.ScriptState.empty(), true) => Step.Continue(Domain.ScriptState.holding([[17]]))

fn nopped(code: Int, state: State, rules: Rules) -> Step
    ? "An opcode that does nothing, unless the rules object to it doing"
      "nothing."
      "DISCOURAGE_UPGRADABLE_NOPS refuses OP_NOP1 and OP_NOP4 to OP_NOP10,"
      "which are the ones a future soft fork could still give a meaning to. It"
      "does not refuse OP_NOP itself, which is spelled for exactly this and is"
      "not going to become anything. Core has the two in separate cases of the"
      "same switch for that reason."
      "Refusing them is Policy rather than consensus and could not be anything"
      "else: a Block containing one is valid, and will stay valid unless and"
      "until a soft fork says otherwise. What the flag buys is that a wallet"
      "cannot get such a Script relayed and so cannot come to depend on it"
      "meaning nothing."
    match Bool.and(rules.policy.discourageUpgradableNops, code != 97)
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} is a NOP a soft fork could still claim")))
        false -> Step.Continue(state)

verify nopped
    nopped(97, Domain.ScriptState.empty(), Domain.Rules.latest()) => Step.Continue(Domain.ScriptState.empty())
    nopped(176, Domain.ScriptState.empty(), Domain.Rules.latest()) => Step.Continue(Domain.ScriptState.empty())
    nopped(97, Domain.ScriptState.empty(), Domain.Rules.underFlags(["DISCOURAGE_UPGRADABLE_NOPS"])) => Step.Continue(Domain.ScriptState.empty())
    nopped(176, Domain.ScriptState.empty(), Domain.Rules.underFlags(["DISCOURAGE_UPGRADABLE_NOPS"])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_NOP1 is a NOP a soft fork could still claim")))
    nopped(185, Domain.ScriptState.empty(), Domain.Rules.underFlags(["DISCOURAGE_UPGRADABLE_NOPS"])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_NOP10 is a NOP a soft fork could still claim")))

fn stoppedUnless(ok: Bool, why: String, tail: List<List<Int>>, state: State) -> Step
    ? "The shape every VERIFY opcode has: consume the items, and stop when the"
      "answer was false rather than pushing it."
    match ok
        false -> Step.Stop(Outcome.Decided(Ending.Failed(why)))
        true -> Step.Continue(Domain.ScriptState.withStack(state, tail))

verify stoppedUnless
    stoppedUnless(false, "no", [], Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("no")))
    stoppedUnless(true, "no", [[1]], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))

fn undecidedUnlessNop(code: Int, state: State, rules: Rules) -> Step
    ? "An opcode this engine cannot decide, unless the rules of the day had"
      "not given it a meaning yet, in which case it was a NOP and did nothing."
      "It is charged against the opcode limit either way, because the caller"
      "charged it before dispatching and Bitcoin counts a NOP like any other."
    match Domain.Rules.stillNop(rules, code)
        true -> Step.Continue(state)
        false -> Step.Stop(Outcome.Undecided(Domain.ScriptState.missing(code)))

verify undecidedUnlessNop
    undecidedUnlessNop(171, Domain.ScriptState.empty(), Domain.Rules.at(Network.Mainnet, 0)) => Step.Stop(Outcome.Undecided("OP_CODESEPARATOR needs the sighash it changes"))
