module Segment
    intent =
        "Segments: what they are called, how much they hold, and where the next"
        "Block goes."
        "A Block is one length-framed record — a four-byte little-endian length"
        "and then the Block's bytes — so a Segment is self-framing and a"
        "Location can name the bytes by offset alone. A Block never straddles"
        "two Segments, which is what lets pruning delete whole files, and an"
        "oversized Block is given a Segment of its own rather than split."
        "Everything here is pure arithmetic, so a Segment's layout is settled"
        "without touching Disk."
        "The arithmetic is only ever right about the file it was told about."
        "place counts from a running total the process carries, and the write"
        "lands wherever the file actually ends; the day those two differ, every"
        "Location placed afterwards is off by the same number of bytes and"
        "nothing at write time can tell (#327). agreesWithDisk is the one rule"
        "that compares them, and Infra.Blocks asks it once per batch."
    exposes [Placement, SegmentState, capBytes, headerBytes, nameOf, initial, place, agreesWithDisk, headerFor, lengthOf, payloadAt, nextHeader, complete]
    depends [Bytes, Domain.Index, Domain.Message, Domain.Text]
    effects []

record SegmentState
    segment: Int
    used: Int

record Placement
    location: Location
    state: SegmentState

fn capBytes() -> Int
    ? "How many bytes a Segment holds before the next one starts."
      "One hundred and twenty-eight mebibytes, the size Bitcoin Core settled"
      "on. A Segment is never read whole — every read is positional — so the"
      "cap no longer protects a read path; it only sets how coarsely pruning"
      "deletes and how many files a chain becomes. See ADR 0004 for the two"
      "mebibytes this used to be, and why."
    134217728

verify capBytes
    capBytes() => 134217728

fn headerBytes() -> Int
    ? "Every record starts with this many bytes of little-endian length."
    4

verify headerBytes
    headerBytes() => 4

fn nameWidth() -> Int
    ? "Segment numbers are padded to this width so a directory listing sorts in order."
    6

verify nameWidth
    nameWidth() => 6

fn nameOf(segment: Int) -> String
    ? "The file a Segment lives in. Six digits allows a million of them, which"
      "at this cap is more chain than exists."
    "blk{Domain.Text.padLeft(String.fromInt(segment), nameWidth())}.dat"

verify nameOf
    nameOf(0) => "blk000000.dat"
    nameOf(1) => "blk000001.dat"
    nameOf(42) => "blk000042.dat"
    nameOf(999999) => "blk999999.dat"
    nameOf(1000000) => "blk1000000.dat"

verify nameOf law sortsWithSegment
    given lower: Int = [0, 1, 42, 999998, 999999]
    given higher: Int = [0, 1, 42, 999998, 999999]
    when Bool.and(Bool.and(0 <= lower, lower < 1000000), Bool.and(0 <= higher, higher < 1000000))
    nameOf(lower) < nameOf(higher) => lower < higher

fn initial() -> SegmentState
    ? "Where a Store with no Segments starts."
    SegmentState(segment = 0, used = 0)

verify initial
    initial() => SegmentState(segment = 0, used = 0)

fn place(state: SegmentState, blockBytes: Int) -> Placement
    ? "Where the next Block goes, and the state that follows it."
      "The Location names the Block's own bytes: its offset is past the record's"
      "header. A Block that would take the current Segment past the cap starts"
      "a new one. An empty Segment always accepts the Block, however large,"
      "because a Block cannot be split — so a Block above the cap simply gets a"
      "Segment to itself."
    match rolls(state, blockBytes)
        true -> rolled(state, blockBytes)
        false -> appended(state, blockBytes)

verify place
    place(initial(), 100) => Placement(location = Location(segment = 0, offset = 4, length = 100), state = SegmentState(segment = 0, used = 104))
    place(SegmentState(segment = 0, used = 104), 200) => Placement(location = Location(segment = 0, offset = 108, length = 200), state = SegmentState(segment = 0, used = 308))
    place(SegmentState(segment = 3, used = 134217700), 100) => Placement(location = Location(segment = 4, offset = 4, length = 100), state = SegmentState(segment = 4, used = 104))
    place(initial(), 200000000) => Placement(location = Location(segment = 0, offset = 4, length = 200000000), state = SegmentState(segment = 0, used = 200000004))
    place(SegmentState(segment = 1, used = 14), 200000000) => Placement(location = Location(segment = 2, offset = 4, length = 200000000), state = SegmentState(segment = 2, used = 200000004))
    place(SegmentState(segment = 0, used = 134217624), 100) => Placement(location = Location(segment = 0, offset = 134217628, length = 100), state = SegmentState(segment = 0, used = 134217728))

verify place law recordEndsAtUsed
    given state: SegmentState = [initial(), SegmentState(segment = 0, used = 104), SegmentState(segment = 1, used = 14), SegmentState(segment = 3, used = 134217700)]
    given blockBytes: Int = [0, 1, 100, 200000000]
    when Bool.and(state.used >= 0, blockBytes >= 0)
    endsAtUsed(place(state, blockBytes), blockBytes) => true

verify place law consecutiveRecordsTile
    given state: SegmentState = [initial(), SegmentState(segment = 0, used = 104), SegmentState(segment = 3, used = 134217600)]
    given first: Int = [0, 1, 100, 200000000]
    given second: Int = [0, 1, 100, 200000000]
    when Bool.and(state.used >= 0, Bool.and(first >= 0, second >= 0))
    tiles(place(state, first), place(place(state, first).state, second)) => true

verify place law staysUnderCap
    given state: SegmentState = [initial(), SegmentState(segment = 0, used = 104), SegmentState(segment = 0, used = 134217624), SegmentState(segment = 3, used = 134217728)]
    given blockBytes: Int = [0, 1, 100, 134217724]
    when Bool.and(headerBytes() + blockBytes <= capBytes(), state.used <= capBytes())
    place(state, blockBytes).state.used <= capBytes() => true

verify place law agreesWithTheReader
    given state: SegmentState = [initial(), SegmentState(segment = 0, used = 104), SegmentState(segment = 3, used = 134217600)]
    given blockBytes: Int = [0, 1, 100, 200000000]
    when Bool.and(Bool.and(state.used >= 0, blockBytes >= 0), Bool.not(rolls(state, blockBytes)))
    readerAgrees(state, blockBytes, place(state, blockBytes)) => true

fn rolls(state: SegmentState, blockBytes: Int) -> Bool
    ? "A non-empty Segment rolls when the record would take it past the cap."
    match state.used > 0
        true -> state.used + headerBytes() + blockBytes > capBytes()
        false -> false

verify rolls
    rolls(initial(), 100) => false
    rolls(initial(), 200000000) => false
    rolls(SegmentState(segment = 0, used = 134217700), 100) => true
    rolls(SegmentState(segment = 0, used = 134217624), 100) => false
    rolls(SegmentState(segment = 0, used = 104), 100) => false

fn rolled(state: SegmentState, blockBytes: Int) -> Placement
    ? "Start the next Segment, with this Block as its first record."
    next = state.segment + 1
    Placement(location = Location(segment = next, offset = headerBytes(), length = blockBytes), state = SegmentState(segment = next, used = headerBytes() + blockBytes))

verify rolled
    rolled(initial(), 100) => Placement(location = Location(segment = 1, offset = 4, length = 100), state = SegmentState(segment = 1, used = 104))

fn appended(state: SegmentState, blockBytes: Int) -> Placement
    ? "Add the Block to the Segment already open."
    Placement(location = Location(segment = state.segment, offset = state.used + headerBytes(), length = blockBytes), state = SegmentState(segment = state.segment, used = state.used + headerBytes() + blockBytes))

verify appended
    appended(initial(), 100) => Placement(location = Location(segment = 0, offset = 4, length = 100), state = SegmentState(segment = 0, used = 104))
    appended(SegmentState(segment = 2, used = 60), 40) => Placement(location = Location(segment = 2, offset = 64, length = 40), state = SegmentState(segment = 2, used = 104))

fn endsAtUsed(placement: Placement, blockBytes: Int) -> Bool
    ? "What a Placement says about itself: the record it names is the last"
      "thing in the Segment its state describes, it is in that Segment, it is"
      "as long as the Block, and it sits past a record header."
    Bool.and(Bool.and(placement.location.offset + placement.location.length == placement.state.used, placement.location.segment == placement.state.segment), Bool.and(placement.location.length == blockBytes, placement.location.offset >= headerBytes()))

verify endsAtUsed
    endsAtUsed(place(initial(), 100), 100) => true
    endsAtUsed(place(SegmentState(segment = 3, used = 134217700), 100), 100) => true
    endsAtUsed(Placement(location = Location(segment = 0, offset = 4, length = 100), state = SegmentState(segment = 0, used = 105)), 100) => false
    endsAtUsed(Placement(location = Location(segment = 0, offset = 4, length = 100), state = SegmentState(segment = 1, used = 104)), 100) => false
    endsAtUsed(Placement(location = Location(segment = 0, offset = 4, length = 100), state = SegmentState(segment = 0, used = 104)), 99) => false
    endsAtUsed(Placement(location = Location(segment = 0, offset = 0, length = 104), state = SegmentState(segment = 0, used = 104)), 104) => false

fn tiles(first: Placement, second: Placement) -> Bool
    ? "Two consecutive Placements leave no gap and no overlap: the second"
      "either opens the next Segment at its first record, or starts one"
      "header past where the first ends."
    Bool.or(opensNext(first, second), followsOn(first, second))

verify tiles
    tiles(place(initial(), 100), place(SegmentState(segment = 0, used = 104), 200)) => true
    tiles(place(SegmentState(segment = 3, used = 134217600), 100), place(SegmentState(segment = 3, used = 134217704), 100)) => true
    tiles(place(initial(), 100), place(SegmentState(segment = 0, used = 105), 200)) => false
    tiles(place(initial(), 100), place(SegmentState(segment = 0, used = 103), 200)) => false
    tiles(place(initial(), 100), place(SegmentState(segment = 2, used = 0), 200)) => false

fn opensNext(first: Placement, second: Placement) -> Bool
    ? "The second record is the first in the Segment after the first record's."
    Bool.and(second.location.segment == first.location.segment + 1, second.location.offset == headerBytes())

verify opensNext
    opensNext(place(initial(), 100), place(SegmentState(segment = 1, used = 0), 200)) => true
    opensNext(place(initial(), 100), place(SegmentState(segment = 0, used = 104), 200)) => false

fn followsOn(first: Placement, second: Placement) -> Bool
    ? "The second record starts one header past the end of the first, in the same Segment."
    Bool.and(second.location.segment == first.location.segment, second.location.offset == first.location.offset + first.location.length + headerBytes())

verify followsOn
    followsOn(place(initial(), 100), place(SegmentState(segment = 0, used = 104), 200)) => true
    followsOn(place(initial(), 100), place(SegmentState(segment = 0, used = 108), 200)) => false
    followsOn(place(initial(), 100), place(SegmentState(segment = 1, used = 0), 200)) => false

fn readerAgrees(state: SegmentState, blockBytes: Int, placement: Placement) -> Bool
    ? "The writer's arithmetic and the reader's are the same arithmetic: a"
      "record placed at the Segment's end is where payloadAt says its payload"
      "is, the state after it is where nextHeader says the next record goes,"
      "and complete holds for it against the Segment that size."
    Bool.and(Bool.and(placement.location.offset == payloadAt(state.used), placement.state.used == nextHeader(state.used, blockBytes)), complete(placement.state.used, state.used, blockBytes))

verify readerAgrees
    readerAgrees(initial(), 100, place(initial(), 100)) => true
    readerAgrees(SegmentState(segment = 0, used = 104), 200, place(SegmentState(segment = 0, used = 104), 200)) => true
    readerAgrees(SegmentState(segment = 3, used = 134217700), 100, place(SegmentState(segment = 3, used = 134217700), 100)) => false

fn agreesWithDisk(state: SegmentState, size: Int) -> Result<Unit, String>
    ? "Whether the Segment on the disk is as long as the count says (#327)."
      "The count is what place derives every Location from; the size is where"
      "the next append actually lands. When they differ by N bytes every"
      "Location placed from the count is N bytes off, and nothing else at"
      "write time can tell. So this is asked before a batch's first append"
      "and again before its Locations are written, and a refusal here is a"
      "fault on this node's own side, never a Peer's: the disk changed under"
      "the count -- a second writer, a Segment appended to by hand -- and"
      "no Location placed from the count has been believed. Reopening the"
      "directory counts from the disk again."
    match size == state.used
        true -> Result.Ok(Unit)
        false -> Result.Err("Segment {state.segment} is {size} bytes on the disk where the count says {state.used}; a Location placed from the count would be {Int.abs(size - state.used)} bytes off, so none was written, and the next open counts from the disk again")

verify agreesWithDisk
    agreesWithDisk(initial(), 0) => Result.Ok(Unit)
    agreesWithDisk(SegmentState(segment = 0, used = 104), 104) => Result.Ok(Unit)
    agreesWithDisk(SegmentState(segment = 5745, used = 100591405), 135794015) => Result.Err("Segment 5745 is 135794015 bytes on the disk where the count says 100591405; a Location placed from the count would be 35202610 bytes off, so none was written, and the next open counts from the disk again")
    agreesWithDisk(SegmentState(segment = 0, used = 308), 104) => Result.Err("Segment 0 is 104 bytes on the disk where the count says 308; a Location placed from the count would be 204 bytes off, so none was written, and the next open counts from the disk again")

verify agreesWithDisk law theDiskItCountedAgrees
    given state: SegmentState = [initial(), SegmentState(segment = 0, used = 104), SegmentState(segment = 5745, used = 100591405)]
    agreesWithDisk(state, state.used) => Result.Ok(Unit)

verify agreesWithDisk law anyOtherSizeRefuses
    given state: SegmentState = [initial(), SegmentState(segment = 0, used = 104), SegmentState(segment = 5745, used = 100591405)]
    given delta: Int = [-104, -1, 1, 35202610]
    when delta != 0
    agreesWithDisk(state, state.used + delta) => Result.Err("Segment {state.segment} is {state.used + delta} bytes on the disk where the count says {state.used}; a Location placed from the count would be {Int.abs(delta)} bytes off, so none was written, and the next open counts from the disk again")

fn headerFor(length: Int) -> Result<Bytes, String>
    ? "The four bytes that precede a record's payload: its length, little-endian."
      "That lengthOf reads it back is Domain.Message.littleEndian's proven"
      "fourBytesReadBack plus its fixedWidth; stated over Bytes and the"
      "Result it is wrapped in, the Lean export timed out (#349), so the"
      "composition stays a cases block and Message's two laws are the proof."
    Bytes.fromList(Domain.Message.littleEndian(length, 4))

verify headerFor
    headerFor(285) => Result.Ok(Bytes.fromHex("1d010000")?)
    headerFor(0) => Result.Ok(Bytes.fromHex("00000000")?)
    headerFor(134217728) => Result.Ok(Bytes.fromHex("00000008")?)

verify headerFor
    lengthOf(headerFor(0)?) => Result.Ok(0)
    lengthOf(headerFor(1)?) => Result.Ok(1)
    lengthOf(headerFor(285)?) => Result.Ok(285)
    lengthOf(headerFor(134217728)?) => Result.Ok(134217728)
    lengthOf(headerFor(4294967295)?) => Result.Ok(4294967295)

fn lengthOf(header: Bytes) -> Result<Int, String>
    ? "The payload length a record's header declares."
      "Fewer than four bytes is a header the Segment does not fully hold — a"
      "torn append, or an offset past the end — and is refused by name so the"
      "caller can repair or report rather than misread."
    values = Bytes.octets(header)
    match List.len(values) == headerBytes()
        true -> Result.Ok(Domain.Message.readLittleEndian(values))
        false -> Result.Err("record header is {List.len(values)} bytes, not {headerBytes()}")

verify lengthOf
    lengthOf(Bytes.fromHex("1d010000")?) => Result.Ok(285)
    lengthOf(Bytes.fromHex("00000000")?) => Result.Ok(0)
    lengthOf(Bytes.fromHex("1d01")?) => Result.Err("record header is 2 bytes, not 4")
    lengthOf(Bytes.fromHex("")?) => Result.Err("record header is 0 bytes, not 4")

fn payloadAt(headerAt: Int) -> Int
    ? "Where a record's payload starts, from where its header does."
    headerAt + headerBytes()

verify payloadAt
    payloadAt(0) => 4
    payloadAt(104) => 108

fn nextHeader(headerAt: Int, length: Int) -> Int
    ? "Where the record after this one starts."
    headerAt + headerBytes() + length

verify nextHeader
    nextHeader(0, 100) => 104
    nextHeader(104, 200) => 308

fn complete(size: Int, headerAt: Int, length: Int) -> Bool
    ? "Whether the Segment holds every byte the record claims."
      "False means the append was torn: the header landed but the payload did"
      "not all follow."
    nextHeader(headerAt, length) <= size

verify complete
    complete(104, 0, 100) => true
    complete(103, 0, 100) => false
    complete(308, 104, 200) => true
    complete(307, 104, 200) => false
