module Segment
    intent =
        "Segments: what they are called, how much they hold, and where the next"
        "Block goes."
        "A Block is one length-framed record — a four-byte little-endian length"
        "and then the Block's bytes — so a Segment is self-framing and a"
        "Location can name the bytes by offset alone. A Block never straddles"
        "two Segments, which is what lets pruning delete whole files, and an"
        "oversized Block is given a Segment of its own rather than split."
        "Everything here is pure arithmetic, so a Segment's layout is settled"
        "without touching Disk."
    exposes [Placement, SegmentState, capBytes, headerBytes, nameOf, initial, place, headerFor, lengthOf, payloadAt, nextHeader, complete]
    depends [Bytes, Domain.Index, Domain.Message, Domain.Text]
    effects []

record SegmentState
    segment: Int
    used: Int

record Placement
    location: Location
    state: SegmentState

fn capBytes() -> Int
    ? "How many bytes a Segment holds before the next one starts."
      "One hundred and twenty-eight mebibytes, the size Bitcoin Core settled"
      "on. A Segment is never read whole — every read is positional — so the"
      "cap no longer protects a read path; it only sets how coarsely pruning"
      "deletes and how many files a chain becomes. See ADR 0004 for the two"
      "mebibytes this used to be, and why."
    134217728

verify capBytes
    capBytes() => 134217728

fn headerBytes() -> Int
    ? "Every record starts with this many bytes of little-endian length."
    4

verify headerBytes
    headerBytes() => 4

fn nameWidth() -> Int
    ? "Segment numbers are padded to this width so a directory listing sorts in order."
    6

verify nameWidth
    nameWidth() => 6

fn nameOf(segment: Int) -> String
    ? "The file a Segment lives in. Six digits allows a million of them, which"
      "at this cap is more chain than exists."
    "blk{Domain.Text.padLeft(String.fromInt(segment), nameWidth())}.dat"

verify nameOf
    nameOf(0) => "blk000000.dat"
    nameOf(1) => "blk000001.dat"
    nameOf(42) => "blk000042.dat"
    nameOf(999999) => "blk999999.dat"
    nameOf(1000000) => "blk1000000.dat"

fn initial() -> SegmentState
    ? "Where a Store with no Segments starts."
    SegmentState(segment = 0, used = 0)

verify initial
    initial() => SegmentState(segment = 0, used = 0)

fn place(state: SegmentState, blockBytes: Int) -> Placement
    ? "Where the next Block goes, and the state that follows it."
      "The Location names the Block's own bytes: its offset is past the record's"
      "header. A Block that would take the current Segment past the cap starts"
      "a new one. An empty Segment always accepts the Block, however large,"
      "because a Block cannot be split — so a Block above the cap simply gets a"
      "Segment to itself."
    match rolls(state, blockBytes)
        true -> rolled(state, blockBytes)
        false -> appended(state, blockBytes)

verify place
    place(initial(), 100) => Placement(location = Location(segment = 0, offset = 4, length = 100), state = SegmentState(segment = 0, used = 104))
    place(SegmentState(segment = 0, used = 104), 200) => Placement(location = Location(segment = 0, offset = 108, length = 200), state = SegmentState(segment = 0, used = 308))
    place(SegmentState(segment = 3, used = 134217700), 100) => Placement(location = Location(segment = 4, offset = 4, length = 100), state = SegmentState(segment = 4, used = 104))
    place(initial(), 200000000) => Placement(location = Location(segment = 0, offset = 4, length = 200000000), state = SegmentState(segment = 0, used = 200000004))
    place(SegmentState(segment = 1, used = 14), 200000000) => Placement(location = Location(segment = 2, offset = 4, length = 200000000), state = SegmentState(segment = 2, used = 200000004))
    place(SegmentState(segment = 0, used = 134217624), 100) => Placement(location = Location(segment = 0, offset = 134217628, length = 100), state = SegmentState(segment = 0, used = 134217728))

fn rolls(state: SegmentState, blockBytes: Int) -> Bool
    ? "A non-empty Segment rolls when the record would take it past the cap."
    match state.used > 0
        true -> state.used + headerBytes() + blockBytes > capBytes()
        false -> false

verify rolls
    rolls(initial(), 100) => false
    rolls(initial(), 200000000) => false
    rolls(SegmentState(segment = 0, used = 134217700), 100) => true
    rolls(SegmentState(segment = 0, used = 134217624), 100) => false
    rolls(SegmentState(segment = 0, used = 104), 100) => false

fn rolled(state: SegmentState, blockBytes: Int) -> Placement
    ? "Start the next Segment, with this Block as its first record."
    next = state.segment + 1
    Placement(location = Location(segment = next, offset = headerBytes(), length = blockBytes), state = SegmentState(segment = next, used = headerBytes() + blockBytes))

verify rolled
    rolled(initial(), 100) => Placement(location = Location(segment = 1, offset = 4, length = 100), state = SegmentState(segment = 1, used = 104))

fn appended(state: SegmentState, blockBytes: Int) -> Placement
    ? "Add the Block to the Segment already open."
    Placement(location = Location(segment = state.segment, offset = state.used + headerBytes(), length = blockBytes), state = SegmentState(segment = state.segment, used = state.used + headerBytes() + blockBytes))

verify appended
    appended(initial(), 100) => Placement(location = Location(segment = 0, offset = 4, length = 100), state = SegmentState(segment = 0, used = 104))
    appended(SegmentState(segment = 2, used = 60), 40) => Placement(location = Location(segment = 2, offset = 64, length = 40), state = SegmentState(segment = 2, used = 104))

fn headerFor(length: Int) -> Result<Bytes, String>
    ? "The four bytes that precede a record's payload: its length, little-endian."
    Bytes.fromList(Domain.Message.littleEndian(length, 4))

verify headerFor
    headerFor(285) => Result.Ok(Bytes.fromHex("1d010000")?)
    headerFor(0) => Result.Ok(Bytes.fromHex("00000000")?)
    headerFor(134217728) => Result.Ok(Bytes.fromHex("00000008")?)

fn lengthOf(header: Bytes) -> Result<Int, String>
    ? "The payload length a record's header declares."
      "Fewer than four bytes is a header the Segment does not fully hold — a"
      "torn append, or an offset past the end — and is refused by name so the"
      "caller can repair or report rather than misread."
    values = Bytes.octets(header)
    match List.len(values) == headerBytes()
        true -> Result.Ok(Domain.Message.readLittleEndian(values))
        false -> Result.Err("record header is {List.len(values)} bytes, not {headerBytes()}")

verify lengthOf
    lengthOf(Bytes.fromHex("1d010000")?) => Result.Ok(285)
    lengthOf(Bytes.fromHex("00000000")?) => Result.Ok(0)
    lengthOf(Bytes.fromHex("1d01")?) => Result.Err("record header is 2 bytes, not 4")
    lengthOf(Bytes.fromHex("")?) => Result.Err("record header is 0 bytes, not 4")

fn payloadAt(headerAt: Int) -> Int
    ? "Where a record's payload starts, from where its header does."
    headerAt + headerBytes()

verify payloadAt
    payloadAt(0) => 4
    payloadAt(104) => 108

fn nextHeader(headerAt: Int, length: Int) -> Int
    ? "Where the record after this one starts."
    headerAt + headerBytes() + length

verify nextHeader
    nextHeader(0, 100) => 104
    nextHeader(104, 200) => 308

fn complete(size: Int, headerAt: Int, length: Int) -> Bool
    ? "Whether the Segment holds every byte the record claims."
      "False means the append was torn: the header landed but the payload did"
      "not all follow."
    nextHeader(headerAt, length) <= size

verify complete
    complete(104, 0, 100) => true
    complete(103, 0, 100) => false
    complete(308, 104, 200) => true
    complete(307, 104, 200) => false
