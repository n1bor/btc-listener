module TreeStore
    intent =
        "How the Header tree is spelled inside a Store."
        "A fifth keyspace beside b:, h:, t: and o:. The k: space maps a Block"
        "Id to the Header itself and to the two things a Header does not carry"
        "and cannot be placed without: the Height it sits at and the work of"
        "the whole branch below it. Both come from its parent, so both are"
        "fixed the moment the Header is placed and neither ever changes -- k:"
        "is append-only in the way b: is, and unlike h:, which a"
        "reorganisation rewrites."
        "The Header bytes are kept rather than derived because they are not"
        "derived from anything: the Segments hold Block bodies for the range"
        "that was fetched, and a Header above that range exists nowhere else"
        "on disk. Throwing them away would make the tree unrebuildable without"
        "going back to a Peer."
        "The parent's Block Id is stored beside the Header even though the"
        "Header already contains it. That is a deliberate 64 characters per"
        "Block: it lets a walk up the tree read a Placement without decoding a"
        "Header, and this keyspace is walked once per arriving Header."
    exposes [Held, headerKey, bestTipKey, encodeHeld, decodeHeld, heldFor]
    depends [Bytes, Domain.ByteField, Domain.HeaderTree, Domain.Index, Domain.IndexKeys]
    effects []

record Held
    placement: Placement
    headerHex: String

fn encodeHeld(held: Held) -> Result<Bytes, String>
    ? "The Height, the branch's work, the parent, and the Header itself."
      "The Block Id is the key and so is not repeated in the value."
      "The work is length-prefixed rather than given a fixed width. Chain Work"
      "is an arbitrary-precision Int in this program -- a 256-bit target gives"
      "thirty-two bytes today and the type promises nothing -- so a fixed"
      "width would write a ceiling into the format that the arithmetic does"
      "not have. The Header is last, being the field whose length the record"
      "does not say."
    Bytes.fromList(List.concat(Domain.ByteField.number(held.placement.height, Domain.Index.heightWidth()), List.concat(Domain.ByteField.prefixed(workBytes(held.placement.work)), List.concat(Domain.ByteField.prefixed(Bytes.octets(Bytes.fromHex(held.placement.parentId)?)), Bytes.octets(Bytes.fromHex(held.headerHex)?)))))

verify encodeHeld
    List.len(Bytes.octets(encodeHeld(heldFor(Domain.HeaderTree.rootedAt("aa", 486604799), "0100"))?)) => 4 + 1 + 5 + 1 + 32 + 2

fn workBytes(work: Int) -> List<Int>
    ? "A quantity of work, in as few bytes as hold it."
    match work <= 0
        true -> []
        false -> Domain.ByteField.number(work, workWidth(work, 0))

verify workBytes
    workBytes(0) => []
    workBytes(1) => [1]
    workBytes(256) => [1, 0]
    Domain.ByteField.numberIn(workBytes(4295032833)) => 4295032833

fn workWidth(work: Int, acc: Int) -> Int
    ? "How many bytes a quantity of work needs."
    match work <= 0
        true -> acc
        false -> workWidth(Int.div(work, 256), acc + 1)

verify workWidth
    workWidth(0, 0) => 0
    workWidth(255, 0) => 1
    workWidth(256, 0) => 2

fn decodeHeld(blockId: String, stored: Bytes) -> Result<Held, String>
    ? "Read one back, given the Block Id its key named."
    heldIn(blockId, Bytes.octets(stored))

verify decodeHeld
    decodeHeld("aa", encodeHeld(heldFor(Domain.HeaderTree.rootedAt("aa", 486604799), "0100"))?) => Result.Ok(heldFor(Domain.HeaderTree.rootedAt("aa", 486604799), "0100"))
    decodeHeld("bb", encodeHeld(heldFor(Domain.HeaderTree.childOf(Domain.HeaderTree.rootedAt("aa", 486604799), "bb", 486604799), "02"))?) => Result.Ok(heldFor(Domain.HeaderTree.childOf(Domain.HeaderTree.rootedAt("aa", 486604799), "bb", 486604799), "02"))
    decodeHeld("aa", Domain.Index.emptyBytes()) => Result.Err("a Header record is at least 4 bytes, got 0")

fn heldIn(blockId: String, octets: List<Int>) -> Result<Held, String>
    ? "A Height, then a length-prefixed work and parent, then the Header."
    match List.len(octets) < Domain.Index.heightWidth()
        true -> Result.Err("a Header record is at least {Domain.Index.heightWidth()} bytes, got {List.len(octets)}")
        false -> heldFrom(blockId, octets)

verify heldIn
    heldIn("aa", []) => Result.Err("a Header record is at least 4 bytes, got 0")

fn heldFrom(blockId: String, octets: List<Int>) -> Result<Held, String>
    ? "The four fields, in the order they were written."
    afterHeight = Domain.ByteField.after(octets, Domain.Index.heightWidth())
    work = Domain.ByteField.numberIn(Domain.ByteField.prefixedIn(afterHeight))
    afterWork = Domain.ByteField.afterPrefixed(afterHeight)
    parent = Bytes.toHex(Bytes.fromList(Domain.ByteField.prefixedIn(afterWork))?)
    header = Bytes.toHex(Bytes.fromList(Domain.ByteField.afterPrefixed(afterWork))?)
    Result.Ok(heldFor(Placement(blockId = blockId, parentId = parent, height = Domain.ByteField.numberIn(Domain.ByteField.at(octets, 0, Domain.Index.heightWidth())), work = work), header))

verify heldFrom
    heldFrom("aa", Bytes.octets(encodeHeld(heldFor(Domain.HeaderTree.rootedAt("aa", 486604799), "0100"))?)) => Result.Ok(heldFor(Domain.HeaderTree.rootedAt("aa", 486604799), "0100"))

fn headerTag() -> Int
    ? "The byte that begins every Header record: ASCII 'k'."
    107

verify headerTag
    headerTag() => 107

fn headerKey(blockId: String) -> Result<Bytes, String>
    ? "Where a Header and its place in the tree live."
    Domain.IndexKeys.tagged(headerTag(), Domain.IndexKeys.idBytes(blockId)?)

verify headerKey
    Bytes.octets(headerKey("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")?) => List.prepend(headerTag(), Bytes.octets(Bytes.fromHex("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")?))
    Bytes.octets(headerKey("")?) => [headerTag()]

fn bestTipKey() -> Result<Bytes, String>
    ? "The single record naming the tip of the branch with the most work."
      "A record rather than a search, because finding the best tip by walking"
      "every Placement is a walk of the whole tree and the answer only changes when"
      "a Header arrives."
    Domain.IndexKeys.metaKey("bestTip")

verify bestTipKey
    bestTipKey() => Domain.IndexKeys.metaKey("bestTip")

fn heldFor(placement: Placement, headerHex: String) -> Held
    ? "A placed Header, ready to be written down."
    Held(placement = placement, headerHex = headerHex)

verify heldFor
    heldFor(Domain.HeaderTree.rootedAt("aa", 486604799), "01").headerHex => "01"
    heldFor(Domain.HeaderTree.rootedAt("aa", 486604799), "01").placement.height => 0
