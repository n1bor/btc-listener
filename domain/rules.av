module Rules
    intent =
        "Which consensus rules were in force at a Height."
        "A soft fork is not a correction to Bitcoin; it is a change of the rules"
        "from one Block onwards, and the Blocks below it are still valid under"
        "the rules they were mined under. An engine that applies today's rules"
        "to the whole chain rejects spends the network accepted, which is not a"
        "stricter check but a wrong one."
        "That is not hypothetical here. n1bor/btc-listener#19: a P2SH-shaped"
        "Output in Block 170060, three thousand seven hundred and forty-five"
        "Blocks before BIP16 came into force, was refused because the engine"
        "ran the redeem Script anyway and wanted a signature the Input never"
        "had to supply. Under the rules of the day that pair simply passes, and"
        "the coins really were spendable by anyone who knew the preimage. That"
        "is the hole BIP16 closed, and it is a fact about the chain rather than"
        "a bug in it."
        "One record rather than a Height passed around, because a caller that"
        "holds a Height can be tempted to compare it, and every such comparison"
        "is a place the table can be got wrong. Ask once, carry the answer."
        "A Height alone does not say which rules were in force, because it does"
        "not say which chain it is a Height on. Signet turned every one of"
        "these on at Height 1 and has never had a Block without them; mainnet"
        "took nine years to get there. Asking mainnet questions of a signet"
        "Block is not a small inaccuracy -- it judges the whole chain leniently,"
        "and a rule not enforced lets a Script pass rather than fail, so the"
        "mistake hides itself."
        "The timeline this engine will eventually need, mainnet:"
        "BIP16 pay-to-script-hash at 173805, 1 April 2012."
        "BIP34 coinbase Height at 227931. BIP66 strict DER at 363725."
        "BIP65 OP_CHECKLOCKTIMEVERIFY at 388381. BIP68, BIP112 and BIP113 at"
        "419328. SegWit and BIP147 null dummy at 481824. Taproot at 709632."
        "Four are carried. P2SH, because a P2SH-shaped Output below its Height"
        "is an ordinary Script. BIP65 and BIP112, because below their Heights"
        "the two opcodes are OP_NOP2 and OP_NOP3 and do nothing, and Outputs"
        "shaped like a timelock exist in 2012 that were never one. And SegWit,"
        "because below its Height a witness program is an anyone-can-spend push"
        "of a hash and above it the Witness decides -- the same shape with two"
        "different meanings, which is what a soft fork is."
        "BIP147 null dummy came into force with SegWit on every Network, so it"
        "rides on the same field rather than getting one that would always hold"
        "the same value. n1bor/btc-listener#52 splits it out if the policy half"
        "ever needs to differ from the consensus one."
        "BIP66 is the next and Domain.Ecdsa.isValidEncoding is already written"
        "for it, but the chain here stops below 363725, so wiring it in would"
        "ship consensus code no measurement could reach. It goes in when there"
        "are Blocks to check it against, and it costs one field and one line --"
        "which is the whole point of the record being here."
        "Every Height below is from Bitcoin Core's src/kernel/chainparams.cpp."
        "P2SH is the exception and n1bor/btc-listener#66 covers it: Core has no"
        "BIP16 Height at all, because BIP16 activated on a Block timestamp and"
        "Core now enforces P2SH everywhere with one named Block excused."
    exposes [Rules, at, latest, stillNop, payToScriptHashHeight, checkLockTimeVerifyHeight, checkSequenceVerifyHeight, segWitHeight, taprootHeight]
    depends [Domain.Network]
    effects []

record Rules
    payToScriptHash: Bool
    checkLockTimeVerify: Bool
    checkSequenceVerify: Bool
    segWit: Bool
    taproot: Bool

fn at(network: Network, height: Int) -> Rules
    ? "The rules a Block at this Height on this Network was mined under."
    Rules(payToScriptHash = height >= payToScriptHashHeight(network), checkLockTimeVerify = height >= checkLockTimeVerifyHeight(network), checkSequenceVerify = height >= checkSequenceVerifyHeight(network), segWit = height >= segWitHeight(network), taproot = height >= taprootHeight(network))

verify at
    at(Network.Mainnet, 0).payToScriptHash => false
    at(Network.Mainnet, 170060).payToScriptHash => false
    at(Network.Mainnet, 173804).payToScriptHash => false
    at(Network.Mainnet, 173805).payToScriptHash => true
    at(Network.Mainnet, 900000).payToScriptHash => true
    at(Network.Mainnet, 163685).checkLockTimeVerify => false
    at(Network.Mainnet, 388380).checkLockTimeVerify => false
    at(Network.Mainnet, 388381).checkLockTimeVerify => true
    at(Network.Mainnet, 419327).checkSequenceVerify => false
    at(Network.Mainnet, 419328).checkSequenceVerify => true
    at(Network.Mainnet, 481823).segWit => false
    at(Network.Mainnet, 481824).segWit => true
    at(Network.Signet, 1).segWit => true
    at(Network.Signet, 1).payToScriptHash => true
    at(Network.Signet, 1).checkLockTimeVerify => true
    at(Network.Signet, 1).checkSequenceVerify => true
    at(Network.Signet, 318569).segWit => true
    at(Network.Testnet, 834623).segWit => false
    at(Network.Testnet, 834624).segWit => true
    at(Network.Regtest, 0).segWit => true
    at(Network.Mainnet, 709631).taproot => false
    at(Network.Mainnet, 709632).taproot => true
    at(Network.Mainnet, 481824).taproot => false
    at(Network.Signet, 1).taproot => true

fn stillNop(rules: Rules, code: Int) -> Bool
    ? "Whether this opcode had no meaning yet and was simply a NOP."
      "A soft fork gives a spare NOP a meaning. Below the Height it did so,"
      "running it did nothing, and a Script that uses it there passes straight"
      "over it. Refusing such a Script, or declining to judge it, is reading"
      "the chain by today's rules."
    match code
        177 -> rules.checkLockTimeVerify == false
        178 -> rules.checkSequenceVerify == false
        _ -> false

verify stillNop
    stillNop(at(Network.Mainnet, 163685), 177) => true
    stillNop(at(Network.Mainnet, 388381), 177) => false
    stillNop(latest(), 177) => false
    stillNop(at(Network.Mainnet, 163685), 178) => true
    stillNop(at(Network.Mainnet, 419328), 178) => false
    stillNop(at(Network.Signet, 1), 177) => false
    stillNop(at(Network.Mainnet, 163685), 172) => false
    stillNop(latest(), 186) => false

fn checkLockTimeVerifyHeight(network: Network) -> Int
    ? "BIP65 redefined OP_NOP2 as OP_CHECKLOCKTIMEVERIFY at this Height."
      "Below it the opcode is OP_NOP2 and does nothing at all, so a Script"
      "using it simply carries on. There are Blocks in 2012 whose Outputs are"
      "shaped like a timelock and were never one."
    match network
        Network.Mainnet -> 388381
        Network.Testnet -> 581885
        Network.Signet -> 1
        Network.Regtest -> 1

verify checkLockTimeVerifyHeight
    checkLockTimeVerifyHeight(Network.Mainnet) => 388381
    checkLockTimeVerifyHeight(Network.Testnet) => 581885
    checkLockTimeVerifyHeight(Network.Signet) => 1
    checkLockTimeVerifyHeight(Network.Regtest) => 1

fn checkSequenceVerifyHeight(network: Network) -> Int
    ? "BIP112 redefined OP_NOP3 as OP_CHECKSEQUENCEVERIFY at this Height."
      "The same story as BIP65 one opcode along, and BIP68 and BIP113 came"
      "into force with it."
    match network
        Network.Mainnet -> 419328
        Network.Testnet -> 770112
        Network.Signet -> 1
        Network.Regtest -> 1

verify checkSequenceVerifyHeight
    checkSequenceVerifyHeight(Network.Mainnet) => 419328
    checkSequenceVerifyHeight(Network.Testnet) => 770112
    checkSequenceVerifyHeight(Network.Signet) => 1
    checkSequenceVerifyHeight(Network.Regtest) => 1

fn segWitHeight(network: Network) -> Int
    ? "BIP141 made a witness program mean something at this Height, and BIP147"
      "made the null dummy a consensus rule at the same one."
      "Below it a witness program is a version byte and a push of a hash, which"
      "leaves the hash on the stack and comes out true -- so the Output is"
      "spendable by anyone and the Witness is not consulted, because there is"
      "no rule yet that says to consult it. That is what made SegWit a soft"
      "fork, and it is why the same bytes have to be read two ways."
      "Regtest is zero rather than one: Core writes SegwitHeight = 0 there, so"
      "even the genesis Block is under it."
    match network
        Network.Mainnet -> 481824
        Network.Testnet -> 834624
        Network.Signet -> 1
        Network.Regtest -> 0

verify segWitHeight
    segWitHeight(Network.Mainnet) => 481824
    segWitHeight(Network.Testnet) => 834624
    segWitHeight(Network.Signet) => 1
    segWitHeight(Network.Regtest) => 0

fn latest() -> Rules
    ? "Every rule this engine knows, in force."
      "What a Script corpus written today means, and what a caller checking a"
      "Script with no Block behind it should get. Core's own vectors are"
      "written against the current rules and are read that way."
    Rules(payToScriptHash = true, checkLockTimeVerify = true, checkSequenceVerify = true, segWit = true, taproot = true)

verify latest
    latest().payToScriptHash => true
    latest().checkLockTimeVerify => true
    latest().segWit => true
    latest().taproot => true
    latest() => at(Network.Mainnet, taprootHeight(Network.Mainnet))
    latest() => at(Network.Signet, 1)

fn taprootHeight(network: Network) -> Int
    ? "BIP341 and BIP342 came into force at this Height."
      "Below it a version one witness program is a witness program of an"
      "unknown version, which under consensus is spendable by anyone; above"
      "it the same bytes are an output key and the Witness has to satisfy it."
      "Core no longer carries the Height: Taproot activated by BIP9 and the"
      "deployment entry has been retired. What is left is MinBIP9WarningHeight"
      "in src/kernel/chainparams.cpp, commented 'taproot activation height +"
      "miner confirmation window' -- 711648 on mainnet and 2013984 on testnet,"
      "less the 2016 block window, which is where these two numbers come from."
    match network
        Network.Mainnet -> 709632
        Network.Testnet -> 2011968
        Network.Signet -> 1
        Network.Regtest -> 0

verify taprootHeight
    taprootHeight(Network.Mainnet) => 709632
    taprootHeight(Network.Mainnet) => 711648 - 2016
    taprootHeight(Network.Testnet) => 2011968
    taprootHeight(Network.Testnet) => 2013984 - 2016
    taprootHeight(Network.Signet) => 1
    taprootHeight(Network.Regtest) => 0

fn payToScriptHashHeight(network: Network) -> Int
    ? "BIP16 became a consensus rule at this Height on mainnet, 1 April 2012."
      "Unlike every other Height here this one is not Core's. BIP16 activated"
      "on a Block timestamp, 1333238400, and 173805 is the first Block after"
      "it; Core carries no BIP16 Height at all and instead enforces P2SH"
      "everywhere with one named Block excused. The two rules differ over"
      "Heights 170061 to 173804 and n1bor/btc-listener#66 measures whether the"
      "difference is ever reached."
      "The other Networks are one because Core enforces P2SH from the start on"
      "them, which for signet and regtest is also the historical truth: they"
      "have never had a Block that predates it."
    match network
        Network.Mainnet -> 173805
        Network.Testnet -> 1
        Network.Signet -> 1
        Network.Regtest -> 1

verify payToScriptHashHeight
    payToScriptHashHeight(Network.Mainnet) => 173805
    payToScriptHashHeight(Network.Testnet) => 1
    payToScriptHashHeight(Network.Signet) => 1
    payToScriptHashHeight(Network.Regtest) => 1
