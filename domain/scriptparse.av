module ScriptParse
    intent =
        "Turning a Script's bytes into the things it is made of."
        "An Op is a push of data or an opcode, and that is the whole vocabulary."
        "A push carries its bytes rather than a length, so nothing downstream has"
        "to walk back into the original Script to find what was pushed."
        "There is exactly one way to fail: a push that claims more bytes than are"
        "left. Everything else parses, including opcodes that are disabled,"
        "undefined, or make no sense where they are — those are the interpreter's"
        "to refuse, and refusing them here would leave it unable to say which."
        "The opcode that a push came from is kept beside its bytes. Two Scripts"
        "can push the same data with different opcodes, only one of which is the"
        "minimal encoding, and the rule against the others needs to know which"
        "was used."
    exposes [Op, parse, opsIn, bytesOf, minimalPush, withoutPushes]
    depends [Bytes, Domain.Message, Domain.Opcode]
    effects []

type Op
    Push(Int, List<Int>)
    Code(Int)

fn parse(bytes: List<Int>) -> Result<List<Op>, String>
    ? "Every Op in a Script, in order."
    from(bytes, [])

verify parse
    parse([]) => Result.Ok([])
    parse([118]) => Result.Ok([Op.Code(118)])
    parse([2, 170, 187]) => Result.Ok([Op.Push(2, [170, 187])])
    parse([118, 169, 1, 170]) => Result.Ok([Op.Code(118), Op.Code(169), Op.Push(1, [170])])
    parse([2, 170]) => Result.Err("push of 2 bytes runs past the end of the script")
    parse([76, 1, 170]) => Result.Ok([Op.Push(76, [170])])
    parse([76]) => Result.Err("push length runs past the end of the script")
    parse([0]) => Result.Ok([Op.Code(0)])

verify parse law preservesExactBytes
    given bytes: List<Int> = [[], [0], [1, 170], [118, 76, 1, 170], [77, 1, 0, 170], [78, 1, 0, 0, 0, 170], [76, 0], [77, 0, 0], [76], [2, 170]]
    when validOctets(bytes)
    because parseReason(bytes, [])
    using [parseReason.preservesBytes]
    readsExactly(bytes) holds

verify parse law directPushRunsPastTheEnd
    given n: Int = [1, 2, 3, 20, 75]
    when Bool.and(n >= 1, n <= 75)
    parse([n]) => Result.Err("push of {n} bytes runs past the end of the script")

fn opsIn(scriptHex: String) -> Result<List<Op>, String>
    ? "The same, from the hexadecimal a Transaction carries."
    raw = Bytes.fromHex(scriptHex)?
    parse(Bytes.octets(raw))

verify opsIn
    List.len(opsIn("76a914751e76e8199196d454941c45d1b3a323f1433bd688ac")?) => 5
    opsIn("51") => Result.Ok([Op.Code(81)])
    opsIn("76a914") => Result.Err("push of 20 bytes runs past the end of the script")
    opsIn("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn from(bytes: List<Int>, acc: List<Op>) -> Result<List<Op>, String>
    ? "Accumulator form, turned round at the end."
    match bytes
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> nextOp(head, tail, acc)

verify from
    from([], []) => Result.Ok([])
    from([118], []) => Result.Ok([Op.Code(118)])
    from([2, 170], []) => Result.Err("push of 2 bytes runs past the end of the script")

fn nextOp(code: Int, rest: List<Int>, acc: List<Op>) -> Result<List<Op>, String>
    ? "A byte is a direct push, a wide push, or an opcode."
      "OP_0 pushes nothing and is an opcode rather than a push of zero bytes,"
      "which matters because the minimal-encoding rule treats them differently."
    match Domain.Opcode.isPushData(code)
        false -> from(rest, List.prepend(Op.Code(code), acc))
        true -> pushOf(code, rest, acc)

verify nextOp
    nextOp(118, [], []) => Result.Ok([Op.Code(118)])
    nextOp(0, [], []) => Result.Ok([Op.Code(0)])
    nextOp(1, [170], []) => Result.Ok([Op.Push(1, [170])])
    nextOp(2, [170], []) => Result.Err("push of 2 bytes runs past the end of the script")

fn pushOf(code: Int, rest: List<Int>, acc: List<Op>) -> Result<List<Op>, String>
    ? "A direct push says its own length; a wide one says it in the bytes after."
    match Domain.Opcode.pushWidth(code)
        0 -> taken(code, code, rest, acc)
        _ -> wide(code, Domain.Opcode.pushWidth(code), rest, acc)

verify pushOf
    pushOf(1, [170], []) => Result.Ok([Op.Push(1, [170])])
    pushOf(76, [1, 170], []) => Result.Ok([Op.Push(76, [170])])
    pushOf(76, [], []) => Result.Err("push length runs past the end of the script")

fn wide(code: Int, width: Int, rest: List<Int>, acc: List<Op>) -> Result<List<Op>, String>
    ? "Read the length, then the bytes it names."
    length = List.take(rest, width)
    match List.len(length) == width
        false -> Result.Err("push length runs past the end of the script")
        true -> taken(code, Domain.Message.readLittleEndian(length), List.drop(rest, width), acc)

verify wide
    wide(76, 1, [1, 170], []) => Result.Ok([Op.Push(76, [170])])
    wide(76, 1, [], []) => Result.Err("push length runs past the end of the script")
    wide(77, 2, [1, 0, 170], []) => Result.Ok([Op.Push(77, [170])])

fn taken(code: Int, count: Int, rest: List<Int>, acc: List<Op>) -> Result<List<Op>, String>
    ? "Take the pushed bytes, or say the Script ended in the middle of them."
      "This is the only way parsing fails, and it is worth being exact about"
      "which push it was: a Script can be long and the one that runs off the"
      "end is otherwise hard to find."
    data = List.take(rest, count)
    match List.len(data) == count
        false -> Result.Err("push of {count} bytes runs past the end of the script")
        true -> from(List.drop(rest, count), List.prepend(Op.Push(code, data), acc))

verify taken
    taken(0, 0, [], []) => Result.Ok([Op.Push(0, [])])
    taken(1, 1, [170], []) => Result.Ok([Op.Push(1, [170])])
    taken(2, 2, [170], []) => Result.Err("push of 2 bytes runs past the end of the script")
    taken(1, 1, [170, 118], []) => Result.Ok([Op.Push(1, [170]), Op.Code(118)])

fn bytesOf(ops: List<Op>) -> List<Int>
    ? "Ops written back out as the bytes they came from."
      "Exact, not merely equivalent: a Push carries the opcode that made it, so"
      "a Script that pushed one byte with OP_PUSHDATA1 comes back out that way"
      "rather than being tidied into the minimal form. Sighash serialises the"
      "script it was given and a tidier would change the message being signed."
    intoBytes(ops, [])

verify bytesOf
    bytesOf([]) => []
    bytesOf([Op.Code(118)]) => [118]
    bytesOf([Op.Push(2, [170, 187])]) => [2, 170, 187]
    bytesOf([Op.Push(76, [170])]) => [76, 1, 170]
    bytesOf([Op.Push(77, [170])]) => [77, 1, 0, 170]
    bytesOf([Op.Push(78, [170])]) => [78, 1, 0, 0, 0, 170]
    bytesOf(parse([118, 169, 1, 170])?) => [118, 169, 1, 170]

verify bytesOf law prepend
    given head: Op = [Op.Code(81), Op.Push(76, [171])]
    given tail: List<Op> = [[], [Op.Code(82)]]
    using [intoBytes.accumulates, prependReversed.reverseOnto, List.concat.rightIdentity, List.reverse.involutive]
    bytesOf(List.prepend(head, tail)) => List.concat(oneOp(head), bytesOf(tail))

verify bytesOf law concatenates
    given left: List<Op> = [[], [Op.Code(81)], [Op.Push(76, [171]), Op.Code(82)]]
    given right: List<Op> = [[], [Op.Code(83)]]
    using [intoBytes.concatenatesOntoAcc]
    bytesOf(List.concat(left, right)) => List.concat(bytesOf(left), bytesOf(right))

fn intoBytes(ops: List<Op>, acc: List<Int>) -> List<Int>
    ? "Accumulator form, turned round at the end."
    match ops
        [] -> List.reverse(acc)
        [head, ..tail] -> intoBytes(tail, prependReversed(oneOp(head), acc))

verify intoBytes
    intoBytes([], []) => []
    intoBytes([Op.Code(118)], []) => [118]
    intoBytes([Op.Code(118), Op.Code(169)], []) => [118, 169]

verify intoBytes law accumulates
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(76, [171]), Op.Code(82)]]
    given acc: List<Int> = [[], [9, 8]]
    using [prependReversed.reverseOnto, List.reverse.ofConcat, List.concat.rightIdentity, List.concat.assoc]
    intoBytes(ops, acc) => List.concat(List.reverse(acc), bytesOf(ops))

verify intoBytes law concatenatesOntoAcc
    given left: List<Op> = [[], [Op.Code(81)], [Op.Push(76, [171]), Op.Code(82)]]
    given right: List<Op> = [[], [Op.Code(83)]]
    given acc: List<Int> = [[], [9, 8]]
    using [intoBytes.accumulates]
    intoBytes(List.concat(left, right), acc) => List.concat(intoBytes(left, acc), bytesOf(right))

verify intoBytes law consStep
    given head: Op = [Op.Code(81), Op.Push(76, [171])]
    given tail: List<Op> = [[], [Op.Code(82)]]
    given acc: List<Int> = [[], [9]]
    using []
    intoBytes(List.prepend(head, tail), acc) => intoBytes(tail, prependReversed(oneOp(head), acc))

fn oneOp(op: Op) -> List<Int>
    ? "One Op's bytes: its opcode, any length it needs, and its data."
    match op
        Op.Code(code) -> [code]
        Op.Push(code, data) -> List.concat(pushHead(code, List.len(data)), data)

verify oneOp
    oneOp(Op.Code(118)) => [118]
    oneOp(Op.Push(2, [170, 187])) => [2, 170, 187]
    oneOp(Op.Push(76, [170])) => [76, 1, 170]

fn pushHead(code: Int, length: Int) -> List<Int>
    ? "The opcode, and the length field the wide pushes carry after it."
    match Domain.Opcode.pushWidth(code)
        0 -> [code]
        _ -> List.prepend(code, Domain.Message.littleEndian(length, Domain.Opcode.pushWidth(code)))

verify pushHead
    pushHead(2, 2) => [2]
    pushHead(76, 1) => [76, 1]
    pushHead(77, 1) => [77, 1, 0]
    pushHead(78, 1) => [78, 1, 0, 0, 0]

fn prependReversed(bytes: List<Int>, acc: List<Int>) -> List<Int>
    ? "Push a run of bytes onto an accumulator that is being built backwards."
    match bytes
        [] -> acc
        [head, ..tail] -> prependReversed(tail, List.prepend(head, acc))

verify prependReversed
    prependReversed([], [9]) => [9]
    prependReversed([1, 2], [9]) => [2, 1, 9]

verify prependReversed law reverseOnto
    given bytes: List<Int> = [[], [1, 2]]
    given acc: List<Int> = [[], [9]]
    using [List.concat.assoc]
    prependReversed(bytes, acc) => List.concat(List.reverse(bytes), acc)

fn minimalPush(data: List<Int>) -> List<Int>
    ? "These bytes as the push Bitcoin would write for them."
      "CScript() << vch, which is the minimal encoding: a length byte below"
      "seventy-six, OP_PUSHDATA1 up to a byte, OP_PUSHDATA2 beyond. It has to"
      "be the minimal one and not merely an equivalent one, because what"
      "FindAndDelete matches on is these exact bytes -- the same data pushed"
      "with a wider opcode is a different push and is left where it is."
      "Empty data gives a single zero byte, which is OP_0. That is not a"
      "special case dressed up: an empty signature really does delete OP_0"
      "from the script code, and Bitcoin really does that."
    bytesOf([canonical(data)])

verify minimalPush
    minimalPush([]) => [0]
    minimalPush([170]) => [1, 170]
    minimalPush([170, 187]) => [2, 170, 187]
    List.len(minimalPush(zeroes(80, []))) => 82
    List.take(minimalPush(zeroes(80, [])), 2) => [76, 80]

fn canonical(data: List<Int>) -> Op
    ? "The opcode that pushes this many bytes minimally."
    match List.len(data) < 76
        true -> Op.Push(List.len(data), data)
        false -> wider(data)

verify canonical
    canonical([170]) => Op.Push(1, [170])
    canonical([]) => Op.Push(0, [])

fn wider(data: List<Int>) -> Op
    ? "Past seventy-five bytes the length needs a byte of its own, or two."
    match List.len(data) <= 255
        true -> Op.Push(76, data)
        false -> Op.Push(77, data)

verify wider
    wider(zeroes(80, [])) => Op.Push(76, zeroes(80, []))

fn zeroes(count: Int, acc: List<Int>) -> List<Int>
    ? "A run of zero bytes, for the cases above."
    match count < 1
        true -> acc
        false -> zeroes(count - 1, List.prepend(0, acc))

verify zeroes
    zeroes(0, []) => []
    List.len(zeroes(80, [])) => 80

fn withoutPushes(scriptHex: String, items: List<List<Int>>) -> Result<String, String>
    ? "The Script with every push of each of these items taken out."
      "Bitcoin's FindAndDelete, which OP_CHECKSIG applies to its signature and"
      "OP_CHECKMULTISIG applies to all of its signatures before it checks any"
      "of them. It matters when a signature appears inside the Script it is"
      "signing, which is close to unheard of and is on the chain: Height"
      "290329 spends a P2SH redeem Script that carries one of its own"
      "signatures where a public key should be, and the other signature only"
      "verifies once that push is gone. See n1bor/btc-listener#49."
      "Opcode by opcode, because a match only counts at an opcode boundary --"
      "bytes inside a push are data and deleting them would change what was"
      "pushed."
      "Legacy only. BIP143 dropped FindAndDelete, so the SegWit path must not"
      "come through here."
    ops = opsIn(scriptHex)?
    Result.Ok(Bytes.toHex(Bytes.fromList(bytesOf(withoutEach(ops, items)))?))

verify withoutPushes
    withoutPushes("", []) => Result.Ok("")
    withoutPushes("5101ab52", []) => Result.Ok("5101ab52")
    withoutPushes("5101ab52", [[171]]) => Result.Ok("5152")
    withoutPushes("5101ab01ab52", [[171]]) => Result.Ok("5152")
    withoutPushes("5101ab52", [[187]]) => Result.Ok("5101ab52")
    withoutPushes("zz", []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")
    withoutPushes("abc", [[171]]) => Result.Err("Bytes.fromHex: expected an even number of hex characters")
    withoutPushes("4c", [[171]]) => Result.Err("push length runs past the end of the script")
    withoutPushes("02ab", [[171]]) => Result.Err("push of 2 bytes runs past the end of the script")
    withoutPushes("5101AB4C01AB52", [[171], [171]]) => Result.Ok("514c01ab52")

verify withoutPushes law repeatedItemsHaveNoFurtherEffect
    given scriptHex: String = ["", "5101ab52", "5101AB4C01AB52", "00", "zz", "abc", "4c", "02ab"]
    given items: List<List<Int>> = [[], [[]], [[171]], [[171], [171]], [[171], [187]], [[-1], [256]]]
    using [withoutEach.concatenatedBatches, withoutEach.repeatedDeletionIsIdempotent]
    withoutPushes(scriptHex, List.concat(items, items)) => withoutPushes(scriptHex, items)

fn withoutEach(ops: List<Op>, items: List<List<Int>>) -> List<Op>
    ? "One item deleted, then the next, over what the last one left."
    match items
        [] -> ops
        [head, ..tail] -> withoutEach(without(ops, minimalPush(head), []), tail)

verify withoutEach
    withoutEach([], []) => []
    withoutEach([Op.Code(81), Op.Push(1, [171])], [[171]]) => [Op.Code(81)]

verify withoutEach law concatenatedBatches
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given left: List<List<Int>> = [[], [[]], [[171], [187]]]
    given right: List<List<Int>> = [[], [[171]]]
    using []
    induction left
    withoutEach(ops, List.concat(left, right)) => withoutEach(withoutEach(ops, left), right)

verify withoutEach law oneDeletionCommutes
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given items: List<List<Int>> = [[], [[]], [[171], [187]]]
    given target: List<Int> = [[], [1, 171]]
    because onePastManyReason(ops, items, target)
    using [without.deletionCommutes]
    withoutEach(without(ops, target, []), items) => without(withoutEach(ops, items), target, [])

verify withoutEach law repeatedDeletionIsIdempotent
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given items: List<List<Int>> = [[], [[]], [[171], [187]]]
    because manyRepeatReason(ops, items)
    using [without.repeatedDeletion, withoutEach.oneDeletionCommutes]
    withoutEach(withoutEach(ops, items), items) => withoutEach(ops, items)

verify withoutEach law deletionOrderCommutes
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given left: List<List<Int>> = [[], [[]], [[171], [187]]]
    given right: List<List<Int>> = [[], [[171]]]
    because manySwapReason(ops, left, right)
    using [withoutEach.oneDeletionCommutes]
    withoutEach(withoutEach(ops, left), right) => withoutEach(withoutEach(ops, right), left)

fn without(ops: List<Op>, target: List<Int>, acc: List<Op>) -> List<Op>
    ? "Every Op whose own bytes are not the target, in order."
    match ops
        [] -> List.reverse(acc)
        [head, ..tail] -> keptUnlessMatched(head, tail, target, acc)

verify without
    without([], [1, 171], []) => []
    without([Op.Push(1, [171])], [1, 171], []) => []

verify without law stableFilter
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171]), Op.Code(81)]]
    given target: List<Int> = [[], [0], [1, 171]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    using []
    without(ops, target, acc) => List.concat(List.reverse(acc), retained(ops, target))

verify without law emptyAccIsRetained
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given target: List<Int> = [[], [1, 171]]
    using [without.stableFilter]
    without(ops, target, []) => retained(ops, target)

verify without law repeatedDeletion
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given target: List<Int> = [[], [1, 171]]
    using [without.stableFilter, retained.idempotent]
    without(without(ops, target, []), target, []) => without(ops, target, [])

verify without law deletionCommutes
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given left: List<Int> = [[], [1, 171]]
    given right: List<Int> = [[], [1, 187]]
    because retained(retained(ops, left), right) == retained(retained(ops, right), left)
    using [without.emptyAccIsRetained, retained.commutesAsEquality]
    without(without(ops, left, []), right, []) => without(without(ops, right, []), left, [])

fn keptUnlessMatched(op: Op, rest: List<Op>, target: List<Int>, acc: List<Op>) -> List<Op>
    ? "A push written some other way is a different push and stays."
    match bytesOf([op]) == target
        true -> without(rest, target, acc)
        false -> without(rest, target, List.prepend(op, acc))

verify keptUnlessMatched
    keptUnlessMatched(Op.Push(1, [171]), [], [1, 171], []) => []
    keptUnlessMatched(Op.Push(76, [171]), [], [1, 171], []) => [Op.Push(76, [171])]

fn retainedRepeatReason(ops: List<Op>, target: List<Int>) -> Bool
    ? "Deleting one exact encoding twice leaves the same survivors."
    match ops
        [] -> retained(retained(ops, target), target) == retained(ops, target)
        [head, ..tail] -> Bool.and(retainedRepeatReason(tail, target), retained(retained(ops, target), target) == retained(ops, target))

verify retainedRepeatReason
    retainedRepeatReason([], [1, 171]) => true
    retainedRepeatReason([Op.Push(1, [171]), Op.Push(76, [171])], [1, 171]) => true

fn onePastManyReason(ops: List<Op>, items: List<List<Int>>, target: List<Int>) -> Bool
    ? "Move one deletion past a list of deletions, using the checked single-step commutation."
    match items
        [] -> withoutEach(without(ops, target, []), items) == without(withoutEach(ops, items), target, [])
        [head, ..tail] -> Bool.and(onePastManyReason(without(ops, minimalPush(head), []), tail, target), withoutEach(without(ops, target, []), items) == without(withoutEach(ops, items), target, []))

verify onePastManyReason
    onePastManyReason([], [], [1, 171]) => true
    onePastManyReason([Op.Push(1, [171]), Op.Push(1, [187])], [[187], [171]], [1, 171]) => true

fn manyRepeatReason(ops: List<Op>, items: List<List<Int>>) -> Bool
    ? "Remove the first repeated deletion, then apply the argument to the remaining items."
    match items
        [] -> withoutEach(withoutEach(ops, items), items) == withoutEach(ops, items)
        [head, ..tail] -> Bool.and(manyRepeatReason(without(ops, minimalPush(head), []), tail), withoutEach(withoutEach(ops, items), items) == withoutEach(ops, items))

verify manyRepeatReason
    manyRepeatReason([], []) => true
    manyRepeatReason([Op.Push(1, [171]), Op.Push(76, [171])], [[171], [171]]) => true

fn manySwapReason(ops: List<Op>, left: List<List<Int>>, right: List<List<Int>>) -> Bool
    ? "Move the first deletion across the other batch, then exchange the shorter batch."
    match left
        [] -> withoutEach(withoutEach(ops, left), right) == withoutEach(withoutEach(ops, right), left)
        [head, ..tail] -> Bool.and(manySwapReason(without(ops, minimalPush(head), []), tail, right), withoutEach(withoutEach(ops, left), right) == withoutEach(withoutEach(ops, right), left))

verify manySwapReason
    manySwapReason([], [], []) => true
    manySwapReason([Op.Push(1, [171]), Op.Push(1, [187]), Op.Code(81)], [[171]], [[187]]) => true

fn retained(ops: List<Op>, target: List<Int>) -> List<Op>
    ? "The stable filter model: compare whole encoded operations, leaving every survivor in order."
    match ops
        [] -> []
        [head, ..tail] -> match bytesOf([head]) == target
            true -> retained(tail, target)
            false -> List.prepend(head, retained(tail, target))

verify retained
    retained([], [1, 171]) => []
    retained([Op.Push(1, [171]), Op.Push(76, [171]), Op.Code(81)], [1, 171]) => [Op.Push(76, [171]), Op.Code(81)]

verify retained law idempotent
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given target: List<Int> = [[], [1, 171]]
    because retainedRepeatReason(ops, target)
    using []
    retained(retained(ops, target), target) => retained(ops, target)

verify retained law commutes
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given left: List<Int> = [[], [1, 171]]
    given right: List<Int> = [[], [1, 187]]
    using []
    retained(retained(ops, left), right) => retained(retained(ops, right), left)

verify retained law commutesAsEquality
    given ops: List<Op> = [[], [Op.Code(81)], [Op.Push(1, [171]), Op.Push(76, [171])]]
    given left: List<Int> = [[], [1, 171]]
    given right: List<Int> = [[], [1, 187]]
    using [retained.commutes]
    retained(retained(ops, left), right) == retained(retained(ops, right), left) => true

fn validOctets(bytes: List<Int>) -> Bool
    ? "Every integer in the input represents one byte."
    match bytes
        [] -> true
        [head, ..tail] -> Bool.and(Bool.and(head >= 0, head <= 255), validOctets(tail))

verify validOctets law dropStaysValid
    given bytes: List<Int> = [[], [0, 255], [-1, 256]]
    given count: Int = [-1, 0, 1, 2]
    when validOctets(bytes)
    because dropValidReason(bytes, count)
    using []
    validOctets(List.drop(bytes, count)) holds

verify validOctets law takeStaysValid
    given bytes: List<Int> = [[], [0, 255], [-1, 256]]
    given count: Int = [-1, 0, 1, 2]
    when validOctets(bytes)
    because takeValidReason(bytes, count)
    using []
    validOctets(List.take(bytes, count)) holds

fn dropValidReason(bytes: List<Int>, count: Int) -> Bool
    ? "Dropping a prefix preserves the byte range of the remaining elements."
    match bytes
        [] -> validOctets(List.drop(bytes, count))
        [head, ..tail] -> match count <= 0
            true -> validOctets(List.drop(bytes, count))
            false -> Bool.and(dropValidReason(tail, count - 1), validOctets(List.drop(bytes, count)))

verify dropValidReason
    dropValidReason([], -1) => true
    dropValidReason([0, 255], 1) => true
    dropValidReason([256], 0) => false

fn takeValidReason(bytes: List<Int>, count: Int) -> Bool
    ? "Taking a prefix preserves the byte range of the selected elements."
    match bytes
        [] -> validOctets(List.take(bytes, count))
        [head, ..tail] -> match count <= 0
            true -> validOctets(List.take(bytes, count))
            false -> Bool.and(takeValidReason(tail, count - 1), validOctets(List.take(bytes, count)))

verify takeValidReason
    takeValidReason([], 2) => true
    takeValidReason([0, 255], 1) => true
    takeValidReason([256], 1) => false

fn lengthBytesRoundtrip(bytes: List<Int>) -> List<Int>
    ? "Decode a length field and write it back at its original width."
    Domain.Message.littleEndian(Domain.Message.readLittleEndian(bytes), List.len(bytes))

verify lengthBytesRoundtrip law fixedWidths
    given bytes: List<Int> = [[], [0], [255], [1, 0], [1, 0, 0, 0], [255, 255, 255, 255]]
    when Bool.and(validOctets(bytes), List.len(bytes) <= 8)
    because lengthRoundtripReason(bytes)
    using [Domain.Message.littleEndian.lowDigitStep, Domain.Message.readLittleEndian.lowDigitStep]
    Domain.Message.littleEndian(Domain.Message.readLittleEndian(bytes), List.len(bytes)) => bytes

fn lengthRoundtripReason(bytes: List<Int>) -> Bool
    ? "Remove one low byte at a time, retaining its quotient and remainder facts."
    match bytes
        [] -> lengthBytesRoundtrip(bytes) == bytes
        [head, ..tail] -> Bool.and(lengthRoundtripReason(tail), Bool.and(
            Domain.Message.readLittleEndian(bytes) == Domain.Message.readLittleEndian(tail) * 256 + head,
            Bool.and(Int.mod(Domain.Message.readLittleEndian(bytes), 256) == head,
                Bool.and(Int.div(Domain.Message.readLittleEndian(bytes), 256) == Domain.Message.readLittleEndian(tail),
                    lengthBytesRoundtrip(bytes) == bytes))))

verify lengthRoundtripReason
    lengthRoundtripReason([]) => true
    lengthRoundtripReason([1, 0, 0, 0]) => true
    lengthRoundtripReason([256]) => false

fn rejoined(bytes: List<Int>, count: Int) -> List<Int>
    ? "A prefix and its remaining suffix reconstruct the original list."
    List.concat(List.take(bytes, count), List.drop(bytes, count))

verify rejoined law exact
    given bytes: List<Int> = [[], [1, 2, 3]]
    given count: Int = [-1, 0, 2, 10]
    using [List.concat.takeDrop]
    List.concat(List.take(bytes, count), List.drop(bytes, count)) => bytes

fn parsedBytesMatch(bytes: List<Int>, acc: List<Op>) -> Bool
    ? "A successful parser step preserves the accumulated operations and every remaining byte."
    match from(bytes, acc)
        Result.Err(_) -> true
        Result.Ok(ops) -> bytesOf(ops) == List.concat(bytesOf(List.reverse(acc)), bytes)

verify parsedBytesMatch law codeStep
    given code: Int = [0, 118, 255]
    given rest: List<Int> = [[], [1, 170]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    when Bool.and(Bool.not(Domain.Opcode.isPushData(code)), parsedBytesMatch(rest, List.prepend(Op.Code(code), acc)))
    using [bytesOf.prepend, bytesOf.concatenates, rejoined.exact]
    parsedBytesMatch(List.prepend(code, rest), acc) holds

verify parsedBytesMatch law directPushStep
    given code: Int = [1, 2, 75]
    given rest: List<Int> = [[], [1, 170], [170, 118]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    when directStepReady(code, rest, acc)
    using [bytesOf.prepend, bytesOf.concatenates, rejoined.exact]
    parsedBytesMatch(List.prepend(code, rest), acc) holds

verify parsedBytesMatch law widePushStep
    given code: Int = [76, 77, 78]
    given rest: List<Int> = [[], [1, 170], [1, 0, 170], [1, 0, 0, 0, 170]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    when wideStepReady(code, rest, acc)
    because wideStepReason(code, rest, acc)
    using [bytesOf.prepend, bytesOf.concatenates, rejoined.exact, lengthBytesRoundtrip.fixedWidths, pushWidthFits.always]
    parsedBytesMatch(List.prepend(code, rest), acc) holds

verify parsedBytesMatch law truncatedDirect
    given code: Int = [1, 2, 75]
    given rest: List<Int> = [[], [170]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    when Bool.and(Domain.Opcode.isPushData(code), Bool.and(Domain.Opcode.pushWidth(code) == 0, List.len(List.take(rest, code)) != code))
    using []
    parsedBytesMatch(List.prepend(code, rest), acc) holds

verify parsedBytesMatch law truncatedWidth
    given code: Int = [76, 77, 78]
    given rest: List<Int> = [[], [1, 0]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    when Bool.and(Domain.Opcode.isPushData(code), Bool.and(Domain.Opcode.pushWidth(code) != 0, List.len(List.take(rest, Domain.Opcode.pushWidth(code))) != Domain.Opcode.pushWidth(code)))
    using []
    parsedBytesMatch(List.prepend(code, rest), acc) holds

verify parsedBytesMatch law truncatedData
    given code: Int = [76, 77, 78]
    given rest: List<Int> = [[], [3, 170], [3, 0, 170]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    when Bool.and(Domain.Opcode.isPushData(code), Bool.and(Domain.Opcode.pushWidth(code) != 0, Bool.and(List.len(List.take(rest, Domain.Opcode.pushWidth(code))) == Domain.Opcode.pushWidth(code), List.len(List.take(List.drop(rest, Domain.Opcode.pushWidth(code)), Domain.Message.readLittleEndian(List.take(rest, Domain.Opcode.pushWidth(code))))) != Domain.Message.readLittleEndian(List.take(rest, Domain.Opcode.pushWidth(code))))))
    using []
    parsedBytesMatch(List.prepend(code, rest), acc) holds

fn directStepReady(code: Int, rest: List<Int>, acc: List<Op>) -> Bool
    ? "A complete direct push inherits exact bytes from its parsed suffix."
    Bool.and(Domain.Opcode.isPushData(code), Bool.and(Domain.Opcode.pushWidth(code) == 0, Bool.and(List.len(List.take(rest, code)) == code, parsedBytesMatch(List.drop(rest, code), List.prepend(Op.Push(code, List.take(rest, code)), acc)))))

verify directStepReady
    directStepReady(2, [170, 171], []) => true
    directStepReady(2, [170], []) => false
    directStepReady(76, [1, 170], []) => false

fn pushWidthFits(code: Int) -> Bool
    ? "Every supported push length field fits the proven codec width."
    Domain.Opcode.pushWidth(code) <= 8

verify pushWidthFits law always
    given code: Int = [0, 75, 76, 77, 78, 255]
    using []
    Domain.Opcode.pushWidth(code) <= 8 holds

fn wideStepReady(code: Int, rest: List<Int>, acc: List<Op>) -> Bool
    ? "A complete wide push has a byte-valid length field and an exact parsed suffix."
    width = Domain.Opcode.pushWidth(code)
    length = List.take(rest, width)
    body = List.drop(rest, width)
    count = Domain.Message.readLittleEndian(length)
    data = List.take(body, count)
    Bool.and(Domain.Opcode.isPushData(code), Bool.and(width > 0, Bool.and(validOctets(length), Bool.and(List.len(length) == width, Bool.and(List.len(data) == count, parsedBytesMatch(List.drop(body, count), List.prepend(Op.Push(code, data), acc)))))))

verify wideStepReady
    wideStepReady(76, [1, 170], []) => true
    wideStepReady(77, [1, 0, 170], []) => true
    wideStepReady(78, [1, 0, 0, 0, 170], []) => true
    wideStepReady(76, [2, 170], []) => false

fn wideStepReason(code: Int, rest: List<Int>, acc: List<Op>) -> Bool
    ? "First recover the original length field, then the entire push."
    length = List.take(rest, Domain.Opcode.pushWidth(code))
    Bool.and(Domain.Message.littleEndian(Domain.Message.readLittleEndian(length), List.len(length)) == length, parsedBytesMatch(List.prepend(code, rest), acc))

verify wideStepReason
    wideStepReason(76, [1, 170], []) => true
    wideStepReason(77, [1, 0, 170], [Op.Code(82)]) => true

fn suffixFits(bytes: List<Int>, count: Int) -> Bool
    ? "Dropping any prefix cannot increase the remaining work."
    List.len(List.drop(bytes, count)) <= List.len(bytes)

verify suffixFits law always
    given bytes: List<Int> = [[], [1, 2, 3]]
    given count: Int = [-1, 0, 2, 10]
    using []
    List.len(List.drop(bytes, count)) <= List.len(bytes) holds

fn parseReason(bytes: List<Int>, acc: List<Op>) -> Bool
    ? "Follow the parser by induction over the remaining bytes."
    continuation = match bytes
        [] -> true
        [code, ..tail] -> match Domain.Opcode.isPushData(code)
            false -> parseReason(tail, List.prepend(Op.Code(code), acc))
            true -> match Domain.Opcode.pushWidth(code)
                0 -> match List.take(tail, code)
                    data -> match List.len(data) == code
                        false -> true
                        true -> Bool.and(parseReason(List.drop(tail, code), List.prepend(Op.Push(code, data), acc)), directStepReady(code, tail, acc))
                width -> match List.take(tail, width)
                    length -> match List.len(length) == width
                        false -> true
                        true -> match List.drop(tail, width)
                            rest -> match Domain.Message.readLittleEndian(length)
                                count -> match List.take(rest, count)
                                    data -> match List.len(data) == count
                                        false -> true
                                        true -> Bool.and(parseReason(List.drop(rest, count), List.prepend(Op.Push(code, data), acc)), wideStepReady(code, tail, acc))
    Bool.and(continuation, parsedBytesMatch(bytes, acc))

verify parseReason law preservesBytes
    given bytes: List<Int> = [[], [118], [76, 1, 170], [77, 1, 0, 170]]
    given acc: List<Op> = [[], [Op.Code(82)]]
    when validOctets(bytes)
    because parseReason(bytes, acc)
    using [parsedBytesMatch.truncatedDirect, parsedBytesMatch.truncatedWidth, parsedBytesMatch.truncatedData, parsedBytesMatch.codeStep, parsedBytesMatch.directPushStep, parsedBytesMatch.widePushStep, validOctets.dropStaysValid, validOctets.takeStaysValid, suffixFits.always]
    parseReason(bytes, acc) holds

fn readsExactly(bytes: List<Int>) -> Bool
    ? "Every successfully parsed byte sequence serializes back to exactly the same bytes."
    match parse(bytes)
        Result.Err(_) -> true
        Result.Ok(ops) -> bytesOf(ops) == bytes

verify readsExactly
    readsExactly([1, 170]) => true
    readsExactly([76, 1, 170]) => true
    readsExactly([77, 1, 0, 170]) => true
    readsExactly([78, 1, 0, 0, 0, 170]) => true
    readsExactly([77, 256, -1]) => false
