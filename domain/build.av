module Build
    intent =
        "Which build this is: the commit it was compiled from and when."
        "A local build says dev and unstamped. CI's compile jobs rewrite the"
        "two literals before aver compile, so the binary main-build publishes"
        "names its commit (n1bor/btc-listener#383); the status page, the"
        "Screen and the user agent read them from here. aver --version cannot"
        "say which compiler built it, and nothing else in the binary said which"
        "source it was built from."
    exposes [commit, builtAt, label]
    depends []
    effects []

fn commit() -> String
    ? "The short commit the binary was built from, or dev for a local build."
    "dev"

verify commit
    String.len(commit()) >= 3 => true

fn builtAt() -> String
    ? "When CI built it, as an ISO instant, or unstamped for a local build."
    "unstamped"

verify builtAt
    String.len(builtAt()) >= 3 => true

fn label() -> String
    ? "The one line that says which build this is."
    "build {commit()}, {builtAt()}"

verify label
    String.startsWith(label(), "build ") => true
