module Index
    intent =
        "How the Index is spelled inside a Store: its keys, its values, and what"
        "an absent entry means."
        "Several keyspaces share one Store. The `b:` space maps a Block Id to a"
        "Location and is append-only, because a Block Id always names the same"
        "bytes. The `h:` space maps a Height to a Block Id and is the mutable"
        "record of which chain we currently believe, since a reorganisation can"
        "reassign a Height. The `n:` space is its reverse, mapping a Block Id back"
        "to the Height it sits at, and is written where `t:` is."
        "Keys are bytes: a one-byte tag naming the keyspace, then fixed-width"
        "fields. A Transaction Id is thirty-two bytes and was sixty-four"
        "characters of hexadecimal; an Output key is thirty-seven bytes where"
        "it was seventy-two. Measured at 37% of the keyspace on a million"
        "Outputs with the compression the database actually runs -- less than"
        "the halving n1bor/btc-listener#42 estimated against an uncompressed"
        "LevelDB, because hexadecimal is exactly what a compressor eats."
        "Everything here is a pure transformation, so the whole encoding is"
        "covered by verify blocks rather than by a Store."
    depends [Domain.Text]
    exposes [BodyState, Location, TxSite, SpentOutput, encodeSpentOutput, decodeSpentOutput, encodeTxSite, decodeTxSite, encodeLocation, decodeLocation, encodeHeight, decodeHeight, prunedBelowOf, bodyStateOf, scanUsable]
    effects []

record Location
    segment: Int
    offset: Int
    length: Int

record TxSite
    blockId: String
    position: Int

type BodyState
    Stored(Location)
    Missing
    Pruned

fn encodeTxSite(site: TxSite) -> String
    ? "A Transaction is named by its Block and its position in it."
      "The Block rather than the Height, because a Block Id names one Block"
      "and a Height does not: two chains can both have a Block at 300000 and"
      "only one of them is on the chain with the most work. A reorganisation"
      "does not move a Block's Height -- a Block's Height is fixed by where it"
      "sits in its own chain -- but it does change which Block a Transaction"
      "is in, and a Transaction can be in two Blocks at different Heights with"
      "only one of them on the best chain. Naming the Block leaves no doubt."
    "{site.blockId}:{site.position}"

verify encodeTxSite
    encodeTxSite(TxSite(blockId = "aa", position = 0)) => "aa:0"
    encodeTxSite(TxSite(blockId = "00000000d1145790a8694403d4063f323d499e655c83426834d4ce2f8dd4a2ee", position = 1)) => "00000000d1145790a8694403d4063f323d499e655c83426834d4ce2f8dd4a2ee:1"

fn decodeTxSite(text: String) -> Result<TxSite, String>
    ? "Read a Transaction's whereabouts back."
    siteParts(text, String.split(text, ":"))

verify decodeTxSite
    decodeTxSite("aa:0") => Result.Ok(TxSite(blockId = "aa", position = 0))
    decodeTxSite("aa:12") => Result.Ok(TxSite(blockId = "aa", position = 12))
    decodeTxSite("aa") => Result.Err("Transaction site must be blockId:position, got 'aa'")
    decodeTxSite("") => Result.Err("Transaction site must be blockId:position, got ''")
    decodeTxSite("aa:0:1") => Result.Err("Transaction site must be blockId:position, got 'aa:0:1'")
    decodeTxSite("aa:x") => Result.Err("Transaction position must be a whole number, got 'aa:x'")
    decodeTxSite("aa:-1") => Result.Err("Transaction position must be a whole number, got 'aa:-1'")

fn siteParts(text: String, split: List<String>) -> Result<TxSite, String>
    ? "Exactly two colon-separated fields, and no more."
    match split
        [] -> Result.Err("Transaction site must be blockId:position, got '{text}'")
        [blockId, ..rest] -> afterBlockId(text, blockId, rest)

verify siteParts
    siteParts("aa:0", ["aa", "0"]) => Result.Ok(TxSite(blockId = "aa", position = 0))
    siteParts("", []) => Result.Err("Transaction site must be blockId:position, got ''")

fn afterBlockId(text: String, blockId: String, rest: List<String>) -> Result<TxSite, String>
    ? "The position follows, and nothing follows that."
    match rest
        [] -> Result.Err("Transaction site must be blockId:position, got '{text}'")
        [position, ..extra] -> lastPart(text, blockId, position, extra)

verify afterBlockId
    afterBlockId("aa:0", "aa", ["0"]) => Result.Ok(TxSite(blockId = "aa", position = 0))
    afterBlockId("aa", "aa", []) => Result.Err("Transaction site must be blockId:position, got 'aa'")

fn lastPart(text: String, blockId: String, position: String, extra: List<String>) -> Result<TxSite, String>
    ? "A third field means this is not a Transaction site."
    match extra
        [] -> siteFrom(text, blockId, position)
        [head, ..tail] -> Result.Err("Transaction site must be blockId:position, got '{text}'")

verify lastPart
    lastPart("aa:0", "aa", "0", []) => Result.Ok(TxSite(blockId = "aa", position = 0))
    lastPart("aa:0:1", "aa", "0", ["1"]) => Result.Err("Transaction site must be blockId:position, got 'aa:0:1'")

fn siteFrom(text: String, blockId: String, position: String) -> Result<TxSite, String>
    ? "The position has to be a whole number."
    match whole(position)
        Option.None -> Result.Err("Transaction position must be a whole number, got '{text}'")
        Option.Some(value) -> Result.Ok(TxSite(blockId = blockId, position = value))

verify siteFrom
    siteFrom("aa:0", "aa", "0") => Result.Ok(TxSite(blockId = "aa", position = 0))
    siteFrom("aa:x", "aa", "x") => Result.Err("Transaction position must be a whole number, got 'aa:x'")

record SpentOutput
    value: Int
    script: String

fn encodeSpentOutput(output: SpentOutput) -> String
    ? "What an Output is worth and what has to be satisfied to spend it."
      "The whole Output rather than a pointer at one. A pointer would still cost"
      "the Block decode this keyspace exists to avoid; what is saved by holding"
      "less is spent again on every read."
    "{output.value}:{output.script}"

verify encodeSpentOutput
    encodeSpentOutput(SpentOutput(value = 5000000000, script = "")) => "5000000000:"
    encodeSpentOutput(SpentOutput(value = 5000, script = "76a914")) => "5000:76a914"

fn decodeSpentOutput(text: String) -> Result<SpentOutput, String>
    ? "Read an Output back."
    spentParts(text, String.split(text, ":"))

verify decodeSpentOutput
    decodeSpentOutput("5000:76a914") => Result.Ok(SpentOutput(value = 5000, script = "76a914"))
    decodeSpentOutput("5000:") => Result.Ok(SpentOutput(value = 5000, script = ""))
    decodeSpentOutput("5000") => Result.Err("Output record has no separator: '5000'")
    decodeSpentOutput("x:76a914") => Result.Err("Output value must be a whole number, got 'x:76a914'")

fn spentParts(text: String, pieces: List<String>) -> Result<SpentOutput, String>
    ? "A value and a Script, separated once."
    match pieces
        [] -> Result.Err("Output record has no separator: '{text}'")
        [value, ..rest] -> spentFrom(text, value, rest)

verify spentParts
    spentParts("5000:76a914", ["5000", "76a914"]) => Result.Ok(SpentOutput(value = 5000, script = "76a914"))
    spentParts("5000", ["5000"]) => Result.Err("Output record has no separator: '5000'")
    spentParts("", []) => Result.Err("Output record has no separator: ''")

fn spentFrom(text: String, value: String, rest: List<String>) -> Result<SpentOutput, String>
    ? "The value has to be a whole number; everything after it is the Script."
    match rest
        [] -> Result.Err("Output record has no separator: '{text}'")
        [script, ..extra] -> spentValued(text, whole(value), script)

verify spentFrom
    spentFrom("5000:76a914", "5000", ["76a914"]) => Result.Ok(SpentOutput(value = 5000, script = "76a914"))
    spentFrom("5000", "5000", []) => Result.Err("Output record has no separator: '5000'")

fn spentValued(text: String, value: Option<Int>, script: String) -> Result<SpentOutput, String>
    ? "Refuse a value that is not a whole number."
    match value
        Option.None -> Result.Err("Output value must be a whole number, got '{text}'")
        Option.Some(satoshis) -> Result.Ok(SpentOutput(value = satoshis, script = script))

verify spentValued
    spentValued("5000:a", Option.Some(5000), "a") => Result.Ok(SpentOutput(value = 5000, script = "a"))
    spentValued("x:a", Option.None, "a") => Result.Err("Output value must be a whole number, got 'x:a'")

fn encodeLocation(location: Location) -> String
    ? "A Location is its Segment, the byte offset of the Block's bytes within"
      "it, and how many bytes they are."
    "{location.segment}:{location.offset}:{location.length}"

verify encodeLocation
    encodeLocation(Location(segment = 0, offset = 4, length = 285)) => "0:4:285"
    encodeLocation(Location(segment = 7, offset = 1234, length = 80)) => "7:1234:80"

fn decodeLocation(text: String) -> Result<Location, String>
    ? "Read a Location back, rejecting anything that is not three whole numbers."
    parts(text, String.split(text, ":"))

verify decodeLocation
    decodeLocation("0:4:285") => Result.Ok(Location(segment = 0, offset = 4, length = 285))
    decodeLocation("7:1234:80") => Result.Ok(Location(segment = 7, offset = 1234, length = 80))
    decodeLocation("") => Result.Err("Location must be segment:offset:length, got ''")
    decodeLocation("7") => Result.Err("Location must be segment:offset:length, got '7'")
    decodeLocation("7:12") => Result.Err("Location must be segment:offset:length, got '7:12'")
    decodeLocation("7:12:3:4") => Result.Err("Location must be segment:offset:length, got '7:12:3:4'")
    decodeLocation("a:1:2") => Result.Err("Location must be three whole numbers, got 'a:1:2'")
    decodeLocation("7:b:2") => Result.Err("Location must be three whole numbers, got '7:b:2'")
    decodeLocation("7:1:c") => Result.Err("Location must be three whole numbers, got '7:1:c'")
    decodeLocation("-1:0:2") => Result.Err("Location must be three whole numbers, got '-1:0:2'")
    decodeLocation("0:-1:2") => Result.Err("Location must be three whole numbers, got '0:-1:2'")

fn parts(text: String, split: List<String>) -> Result<Location, String>
    ? "Exactly three colon-separated fields, and no more."
    match split
        [] -> Result.Err("Location must be segment:offset:length, got '{text}'")
        [segment, ..rest] -> afterSegment(text, segment, rest)

verify parts
    parts("7:1:2", ["7", "1", "2"]) => Result.Ok(Location(segment = 7, offset = 1, length = 2))
    parts("x", []) => Result.Err("Location must be segment:offset:length, got 'x'")
    parts("7:1", ["7", "1"]) => Result.Err("Location must be segment:offset:length, got '7:1'")
    parts("7:1:2:3", ["7", "1", "2", "3"]) => Result.Err("Location must be segment:offset:length, got '7:1:2:3'")

fn afterSegment(text: String, segment: String, rest: List<String>) -> Result<Location, String>
    ? "The second field is the offset."
    match rest
        [] -> Result.Err("Location must be segment:offset:length, got '{text}'")
        [offset, ..more] -> afterOffset(text, segment, offset, more)

verify afterSegment
    afterSegment("7:1:2", "7", ["1", "2"]) => Result.Ok(Location(segment = 7, offset = 1, length = 2))
    afterSegment("7", "7", []) => Result.Err("Location must be segment:offset:length, got '7'")

fn afterOffset(text: String, segment: String, offset: String, more: List<String>) -> Result<Location, String>
    ? "The third field is the length; a fourth means the text was not a Location."
    match more
        [] -> Result.Err("Location must be segment:offset:length, got '{text}'")
        [length, ..extra] -> afterLength(text, segment, offset, length, extra)

verify afterOffset
    afterOffset("7:1:2", "7", "1", ["2"]) => Result.Ok(Location(segment = 7, offset = 1, length = 2))
    afterOffset("7:1", "7", "1", []) => Result.Err("Location must be segment:offset:length, got '7:1'")

fn afterLength(text: String, segment: String, offset: String, length: String, extra: List<String>) -> Result<Location, String>
    ? "Reject a fourth field before reading the numbers."
    match extra
        [] -> located(text, whole(segment), whole(offset), whole(length))
        [head, ..tail] -> Result.Err("Location must be segment:offset:length, got '{text}'")

verify afterLength
    afterLength("7:1:2", "7", "1", "2", []) => Result.Ok(Location(segment = 7, offset = 1, length = 2))
    afterLength("7:1:2:3", "7", "1", "2", ["3"]) => Result.Err("Location must be segment:offset:length, got '7:1:2:3'")

fn located(text: String, segment: Option<Int>, offset: Option<Int>, length: Option<Int>) -> Result<Location, String>
    ? "All three fields must have parsed as non-negative whole numbers."
    match segment
        Option.None -> Result.Err("Location must be three whole numbers, got '{text}'")
        Option.Some(s) -> withSegment(text, s, offset, length)

verify located
    located("7:1:2", Option.Some(7), Option.Some(1), Option.Some(2)) => Result.Ok(Location(segment = 7, offset = 1, length = 2))
    located("a:1:2", Option.None, Option.Some(1), Option.Some(2)) => Result.Err("Location must be three whole numbers, got 'a:1:2'")

fn withSegment(text: String, segment: Int, offset: Option<Int>, length: Option<Int>) -> Result<Location, String>
    ? "The Segment parsed; the offset still has to."
    match offset
        Option.None -> Result.Err("Location must be three whole numbers, got '{text}'")
        Option.Some(o) -> withOffset(text, segment, o, length)

verify withSegment
    withSegment("7:1:2", 7, Option.Some(1), Option.Some(2)) => Result.Ok(Location(segment = 7, offset = 1, length = 2))
    withSegment("7:b:2", 7, Option.None, Option.Some(2)) => Result.Err("Location must be three whole numbers, got '7:b:2'")

fn withOffset(text: String, segment: Int, offset: Int, length: Option<Int>) -> Result<Location, String>
    ? "The offset parsed; the length still has to."
    match length
        Option.None -> Result.Err("Location must be three whole numbers, got '{text}'")
        Option.Some(l) -> Result.Ok(Location(segment = segment, offset = offset, length = l))

verify withOffset
    withOffset("7:1:2", 7, 1, Option.Some(2)) => Result.Ok(Location(segment = 7, offset = 1, length = 2))
    withOffset("7:1:c", 7, 1, Option.None) => Result.Err("Location must be three whole numbers, got '7:1:c'")

fn whole(text: String) -> Option<Int>
    ? "A non-negative whole number, or nothing. Negative fields are not Locations."
    match Int.fromString(text)
        Result.Err(e) -> Option.None
        Result.Ok(value) -> nonNegative(value)

verify whole
    whole("0") => Option.Some(0)
    whole("1234") => Option.Some(1234)
    whole("a") => Option.None
    whole("") => Option.None
    whole("-1") => Option.None

fn nonNegative(value: Int) -> Option<Int>
    ? "Keep the value only if it is zero or above."
    match value >= 0
        true -> Option.Some(value)
        false -> Option.None

verify nonNegative
    nonNegative(0) => Option.Some(0)
    nonNegative(5) => Option.Some(5)
    nonNegative(0 - 1) => Option.None

fn encodeHeight(height: Int) -> String
    ? "A Height stored as a value rather than a key needs no padding."
    String.fromInt(height)

verify encodeHeight
    encodeHeight(0) => "0"
    encodeHeight(962268) => "962268"

fn decodeHeight(text: String) -> Result<Int, String>
    ? "Read a Height back, rejecting anything that is not a whole number."
    match whole(text)
        Option.None -> Result.Err("Height must be a whole number, got '{text}'")
        Option.Some(value) -> Result.Ok(value)

verify decodeHeight
    decodeHeight("0") => Result.Ok(0)
    decodeHeight("962268") => Result.Ok(962268)
    decodeHeight("") => Result.Err("Height must be a whole number, got ''")
    decodeHeight("x") => Result.Err("Height must be a whole number, got 'x'")
    decodeHeight("-1") => Result.Err("Height must be a whole number, got '-1'")

fn prunedBelowOf(stored: Option<String>) -> Result<Int, String>
    ? "The Prune Watermark a Store holds, or zero when it holds none."
      "A Store with no such record has never pruned, which is the same thing as"
      "a Watermark of zero — so a fresh Index needs no initialisation."
    match stored
        Option.None -> Result.Ok(0)
        Option.Some(text) -> decodeHeight(text)

verify prunedBelowOf
    prunedBelowOf(Option.None) => Result.Ok(0)
    prunedBelowOf(Option.Some("0")) => Result.Ok(0)
    prunedBelowOf(Option.Some("962268")) => Result.Ok(962268)
    prunedBelowOf(Option.Some("x")) => Result.Err("Height must be a whole number, got 'x'")

fn bodyStateOf(stored: Option<String>, height: Int, prunedBelow: Int) -> Result<BodyState, String>
    ? "Why a Block's body is absent, which decides what to do about it."
      "An entry means we hold the bytes. No entry below the Prune Watermark means"
      "we deleted them deliberately and must not fetch them again; no entry at or"
      "above it means we never fetched them."
    match stored
        Option.Some(text) -> asStored(text)
        Option.None -> Result.Ok(absent(height, prunedBelow))

verify bodyStateOf
    bodyStateOf(Option.Some("7:1234:80"), 100, 0) => Result.Ok(BodyState.Stored(Location(segment = 7, offset = 1234, length = 80)))
    bodyStateOf(Option.None, 100, 0) => Result.Ok(BodyState.Missing)
    bodyStateOf(Option.None, 100, 500) => Result.Ok(BodyState.Pruned)
    bodyStateOf(Option.None, 500, 500) => Result.Ok(BodyState.Missing)
    bodyStateOf(Option.Some("nonsense"), 100, 0) => Result.Err("Location must be segment:offset:length, got 'nonsense'")

fn asStored(text: String) -> Result<BodyState, String>
    ? "An entry is a Location, and a Location that will not decode is corruption."
    location = decodeLocation(text)?
    Result.Ok(BodyState.Stored(location))

verify asStored
    asStored("7:1234:80") => Result.Ok(BodyState.Stored(Location(segment = 7, offset = 1234, length = 80)))
    asStored("bad") => Result.Err("Location must be segment:offset:length, got 'bad'")

fn absent(height: Int, prunedBelow: Int) -> BodyState
    ? "Below the Prune Watermark the bytes were discarded; at or above it they never arrived."
    match height < prunedBelow
        true -> BodyState.Pruned
        false -> BodyState.Missing

verify absent
    absent(0, 0) => BodyState.Missing
    absent(100, 0) => BodyState.Missing
    absent(100, 500) => BodyState.Pruned
    absent(500, 500) => BodyState.Missing

fn scanUsable(startHeight: Int, prunedBelow: Int) -> Bool
    ? "Whether a scan from this Height can see every Block it needs."
      "Pruning is prefix-shaped, so one comparison before starting replaces"
      "discovering a gap partway through and having to unwind."
    startHeight >= prunedBelow

verify scanUsable
    scanUsable(0, 0) => true
    scanUsable(500, 0) => true
    scanUsable(500, 500) => true
    scanUsable(499, 500) => false
    scanUsable(0, 1) => false
