module Index
    intent =
        "How the Index is spelled inside a Store: its keys, its values, and what"
        "an absent entry means."
        "Several keyspaces share one Store. The `b:` space maps a Block Id to a"
        "Location and is append-only, because a Block Id always names the same"
        "bytes. The `h:` space maps a Height to a Block Id and is the mutable"
        "record of which chain we currently believe, since a reorganisation can"
        "reassign a Height. The `n:` space is its reverse, mapping a Block Id back"
        "to the Height it sits at, and is written where `t:` is."
        "Keys are bytes: a one-byte tag naming the keyspace, then fixed-width"
        "fields. A Transaction Id is thirty-two bytes and was sixty-four"
        "characters of hexadecimal; an Output key is thirty-seven bytes where"
        "it was seventy-two. Measured at 37% of the keyspace on a million"
        "Outputs with the compression the database actually runs -- less than"
        "the halving n1bor/btc-listener#42 estimated against an uncompressed"
        "LevelDB, because hexadecimal is exactly what a compressor eats."
        "Everything here is a pure transformation, so the whole encoding is"
        "covered by verify blocks rather than by a Store."
    depends [Bytes, Domain.ByteField, Domain.Text]
    exposes [BodyState, Location, TxSite, SpentOutput, emptyBytes, encodeBlockId, decodeBlockId, blockIdIn, idWidth, heightWidth, amountWidth, encodeSpentOutput, decodeSpentOutput, encodeTxSite, decodeTxSite, encodeLocation, decodeLocation, encodeHeight, decodeHeight, prunedBelowOf, bodyStateOf, scanUsable]
    effects []

record Location
    segment: Int
    offset: Int
    length: Int

record TxSite
    blockId: String
    position: Int

type BodyState
    Stored(Location)
    Missing
    Pruned

fn idWidth() -> Int
    ? "How many bytes a Block Id or a Transaction Id takes in a record."
    32

verify idWidth
    idWidth() => 32

fn heightWidth() -> Int
    ? "How many bytes a Height takes in a record."
    4

verify heightWidth
    heightWidth() => 4

fn amountWidth() -> Int
    ? "How many bytes an amount takes."
      "Eight, which is what Bitcoin gives an amount on the wire and more than"
      "the twenty-one million coins can fill. It was up to twenty decimal"
      "digits."
    8

verify amountWidth
    amountWidth() => 8

fn encodeHeight(height: Int) -> Bytes
    ? "A Height as the four bytes a record keeps it in."
    Result.withDefault(Bytes.fromList(Domain.ByteField.number(height, heightWidth())), emptyBytes())

verify encodeHeight
    Bytes.octets(encodeHeight(0)) => [0, 0, 0, 0]
    Bytes.octets(encodeHeight(962268)) => Domain.ByteField.number(962268, 4)

fn emptyBytes() -> Bytes
    ? "No bytes at all, for the fallback that a fixed-width number never takes."
    Bytes.fromList([])

verify emptyBytes
    Bytes.octets(emptyBytes()) => []

fn decodeHeight(stored: Bytes) -> Result<Int, String>
    ? "Read a Height back, refusing a record that is not one."
    heightIn(Bytes.octets(stored))

verify decodeHeight
    decodeHeight(encodeHeight(0)) => Result.Ok(0)
    decodeHeight(encodeHeight(962268)) => Result.Ok(962268)
    decodeHeight(emptyBytes()) => Result.Err("a Height record is 4 bytes, got 0")

fn heightIn(octets: List<Int>) -> Result<Int, String>
    ? "Four bytes and no other number of them."
    match List.len(octets) == heightWidth()
        false -> Result.Err("a Height record is {heightWidth()} bytes, got {List.len(octets)}")
        true -> Result.Ok(Domain.ByteField.numberIn(octets))

verify heightIn
    heightIn([0, 0, 0, 1]) => Result.Ok(1)
    heightIn([]) => Result.Err("a Height record is 4 bytes, got 0")
    heightIn([1, 2]) => Result.Err("a Height record is 4 bytes, got 2")

fn prunedBelowOf(below: Option<Bytes>) -> Result<Int, String>
    ? "The Prune Watermark a Store holds, or zero where it holds none."
      "Absent means nothing was ever pruned, which is a Watermark of zero"
      "rather than a missing answer."
    match below
        Option.None -> Result.Ok(0)
        Option.Some(stored) -> decodeHeight(stored)

verify prunedBelowOf
    prunedBelowOf(Option.None) => Result.Ok(0)
    prunedBelowOf(Option.Some(encodeHeight(7))) => Result.Ok(7)
    prunedBelowOf(Option.Some(emptyBytes())) => Result.Err("a Height record is 4 bytes, got 0")

fn encodeBlockId(blockId: String) -> Result<Bytes, String>
    ? "A Block Id as the thirty-two bytes it names."
      "The h: keyspace holds one against every Height, and n: holds a Height"
      "against one. They were sixty-four characters of hexadecimal, which is"
      "twice what the Id is."
    Bytes.fromHex(blockId)

verify encodeBlockId
    Bytes.octets(encodeBlockId("aa")?) => [170]
    encodeBlockId("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn decodeBlockId(stored: Bytes) -> String
    ? "Read one back. Any bytes are a Block Id; there is nothing to refuse."
    Bytes.toHex(stored)

verify decodeBlockId
    decodeBlockId(encodeBlockId("aa")?) => "aa"
    decodeBlockId(emptyBytes()) => ""

fn blockIdIn(stored: Option<Bytes>) -> Option<String>
    ? "A stored Block Id, where there may not be one."
      "Every keyspace that answers with a Block Id -- h: naming the Block at a"
      "Height, meta:bestTip naming the tip -- reads back through here, so the"
      "hexadecimal spelling the rest of the program uses is arrived at in one"
      "place rather than at each caller."
    match stored
        Option.None -> Option.None
        Option.Some(bytes) -> Option.Some(decodeBlockId(bytes))

verify blockIdIn
    blockIdIn(Option.None) => Option.None
    blockIdIn(Option.Some(encodeBlockId("aa")?)) => Option.Some("aa")

fn encodeTxSite(site: TxSite) -> Result<Bytes, String>
    ? "A Transaction is named by its Block and its position in it."
      "The Block rather than the Height, because a Block Id names one Block"
      "and a Height does not: two chains can both have a Block at 300000 and"
      "only one of them is on the chain with the most work. A reorganisation"
      "does not move a Block's Height -- a Block's Height is fixed by where it"
      "sits in its own chain -- but it does change which Block a Transaction"
      "is in, and a Transaction can be in two Blocks at different Heights with"
      "only one of them on the best chain. Naming the Block leaves no doubt."
      "The Block Id takes a fixed 32 bytes and the position follows it, so an"
      "Id of any other length is refused here rather than written. The fields"
      "are positional: a short Id would shift the position into the bytes"
      "after it, and the record would read back as a different site instead"
      "of as a fault. decodeTxSite refuses a record of the wrong length, so"
      "writing one would only move the complaint to whoever read it next."
    sited(Bytes.octets(Bytes.fromHex(site.blockId)?), site.position)

verify encodeTxSite
    List.len(Bytes.octets(encodeTxSite(TxSite(blockId = "f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", position = 0))?)) => 36
    encodeTxSite(TxSite(blockId = "aa", position = 0)) => Result.Err("a Transaction site names its Block by 32 bytes, got 1")
    encodeTxSite(TxSite(blockId = "zz", position = 0)) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn sited(id: List<Int>, position: Int) -> Result<Bytes, String>
    ? "The Id has to be the width the record reserves for it."
    match List.len(id) == idWidth()
        false -> Result.Err("a Transaction site names its Block by {idWidth()} bytes, got {List.len(id)}")
        true -> Bytes.fromList(List.concat(id, Domain.ByteField.number(position, heightWidth())))

verify sited
    List.len(Bytes.octets(sited(Bytes.octets(Bytes.fromHex("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16")?), 3)?)) => 36
    sited([], 0) => Result.Err("a Transaction site names its Block by 32 bytes, got 0")

fn decodeTxSite(stored: Bytes) -> Result<TxSite, String>
    ? "Read one back: the Block Id, then the position."
    siteIn(Bytes.octets(stored))

verify decodeTxSite
    decodeTxSite(encodeTxSite(TxSite(blockId = "f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", position = 3))?) => Result.Ok(TxSite(blockId = "f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", position = 3))
    decodeTxSite(emptyBytes()) => Result.Err("a Transaction site record is 36 bytes, got 0")

fn siteIn(octets: List<Int>) -> Result<TxSite, String>
    ? "A Block Id and a position, and nothing else."
    match List.len(octets) == idWidth() + heightWidth()
        false -> Result.Err("a Transaction site record is {idWidth() + heightWidth()} bytes, got {List.len(octets)}")
        true -> siteFrom(Domain.ByteField.at(octets, 0, idWidth()), Domain.ByteField.after(octets, idWidth()))

verify siteIn
    siteIn([]) => Result.Err("a Transaction site record is 36 bytes, got 0")

fn siteFrom(id: List<Int>, position: List<Int>) -> Result<TxSite, String>
    ? "The two fields, once their widths are known to be right."
    Result.Ok(TxSite(blockId = Bytes.toHex(Bytes.fromList(id)?), position = Domain.ByteField.numberIn(position)))

verify siteFrom
    siteFrom([170], [0, 0, 0, 3]) => Result.Ok(TxSite(blockId = "aa", position = 3))

fn encodeSpentOutput(output: SpentOutput) -> Result<Bytes, String>
    ? "What an Output is worth and what has to be satisfied to spend it."
      "The whole Output rather than a pointer at one. A pointer would still"
      "cost the Block decode this keyspace exists to avoid; what is saved by"
      "holding less is spent again on every read."
      "The amount is eight bytes and the Script is the rest, which is why the"
      "Script goes last: it is the one field whose length the record does not"
      "say, so nothing may follow it."
    Bytes.fromList(List.concat(Domain.ByteField.number(output.value, amountWidth()), Bytes.octets(Bytes.fromHex(output.script)?)))

verify encodeSpentOutput
    Bytes.octets(encodeSpentOutput(SpentOutput(value = 5000000000, script = ""))?) => Domain.ByteField.number(5000000000, 8)
    Bytes.octets(encodeSpentOutput(SpentOutput(value = 5000, script = "76a914"))?) => List.concat(Domain.ByteField.number(5000, 8), [118, 169, 20])

fn decodeSpentOutput(stored: Bytes) -> Result<SpentOutput, String>
    ? "Read an Output back."
    spentIn(Bytes.octets(stored))

verify decodeSpentOutput
    decodeSpentOutput(encodeSpentOutput(SpentOutput(value = 5000, script = "76a914"))?) => Result.Ok(SpentOutput(value = 5000, script = "76a914"))
    decodeSpentOutput(encodeSpentOutput(SpentOutput(value = 5000000000, script = ""))?) => Result.Ok(SpentOutput(value = 5000000000, script = ""))
    decodeSpentOutput(emptyBytes()) => Result.Err("an Output record is at least 8 bytes, got 0")

fn spentIn(octets: List<Int>) -> Result<SpentOutput, String>
    ? "An amount, then whatever Script follows it."
    match List.len(octets) < amountWidth()
        true -> Result.Err("an Output record is at least {amountWidth()} bytes, got {List.len(octets)}")
        false -> spentFrom(Domain.ByteField.at(octets, 0, amountWidth()), Domain.ByteField.after(octets, amountWidth()))

verify spentIn
    spentIn([]) => Result.Err("an Output record is at least 8 bytes, got 0")

fn spentFrom(value: List<Int>, script: List<Int>) -> Result<SpentOutput, String>
    ? "The amount and the Script, once the record is long enough to hold both."
    Result.Ok(SpentOutput(value = Domain.ByteField.numberIn(value), script = Bytes.toHex(Bytes.fromList(script)?)))

verify spentFrom
    spentFrom([0, 0, 0, 0, 0, 0, 0, 5], []) => Result.Ok(SpentOutput(value = 5, script = ""))
    spentFrom([0, 0, 0, 0, 0, 0, 0, 5], [118]) => Result.Ok(SpentOutput(value = 5, script = "76"))

fn segmentWidth() -> Int
    ? "How many bytes a Segment number takes."
    4

verify segmentWidth
    segmentWidth() => 4

fn offsetWidth() -> Int
    ? "How many bytes a byte offset within a Segment takes."
      "Eight, because a Segment is a file and a file's length is not something"
      "four bytes should be trusted with."
    8

verify offsetWidth
    offsetWidth() => 8

fn encodeLocation(location: Location) -> Bytes
    ? "A Location is its Segment, the byte offset of the Block's bytes within"
      "it, and how many bytes they are."
    Result.withDefault(Bytes.fromList(List.concat(Domain.ByteField.number(location.segment, segmentWidth()), List.concat(Domain.ByteField.number(location.offset, offsetWidth()), Domain.ByteField.number(location.length, segmentWidth())))), emptyBytes())

verify encodeLocation
    List.len(Bytes.octets(encodeLocation(Location(segment = 0, offset = 4, length = 285)))) => 16
    Bytes.octets(encodeLocation(Location(segment = 7, offset = 1234, length = 80))) => List.concat(Domain.ByteField.number(7, 4), List.concat(Domain.ByteField.number(1234, 8), Domain.ByteField.number(80, 4)))

fn decodeLocation(stored: Bytes) -> Result<Location, String>
    ? "Read a Location back, rejecting anything that is not the three fields."
    locationIn(Bytes.octets(stored))

verify decodeLocation
    decodeLocation(encodeLocation(Location(segment = 7, offset = 1234, length = 80))) => Result.Ok(Location(segment = 7, offset = 1234, length = 80))
    decodeLocation(emptyBytes()) => Result.Err("a Location record is 16 bytes, got 0")

fn locationIn(octets: List<Int>) -> Result<Location, String>
    ? "Three fixed fields and nothing else."
    match List.len(octets) == segmentWidth() + offsetWidth() + segmentWidth()
        false -> Result.Err("a Location record is {segmentWidth() + offsetWidth() + segmentWidth()} bytes, got {List.len(octets)}")
        true -> Result.Ok(Location(segment = Domain.ByteField.numberIn(Domain.ByteField.at(octets, 0, segmentWidth())), offset = Domain.ByteField.numberIn(Domain.ByteField.at(octets, segmentWidth(), offsetWidth())), length = Domain.ByteField.numberIn(Domain.ByteField.at(octets, segmentWidth() + offsetWidth(), segmentWidth()))))

verify locationIn
    locationIn([]) => Result.Err("a Location record is 16 bytes, got 0")
    locationIn(Bytes.octets(encodeLocation(Location(segment = 1, offset = 2, length = 3)))) => Result.Ok(Location(segment = 1, offset = 2, length = 3))

record SpentOutput
    value: Int
    script: String

fn bodyStateOf(stored: Option<Bytes>, height: Int, prunedBelow: Int) -> Result<BodyState, String>
    ? "Why a Block's body is absent, which decides what to do about it."
      "An entry means we hold the bytes. No entry below the Prune Watermark means"
      "we deleted them deliberately and must not fetch them again; no entry at or"
      "above it means we never fetched them."
    match stored
        Option.Some(text) -> asStored(text)
        Option.None -> Result.Ok(absent(height, prunedBelow))

verify bodyStateOf
    bodyStateOf(Option.Some(encodeLocation(Location(segment = 7, offset = 1234, length = 80))), 100, 0) => Result.Ok(BodyState.Stored(Location(segment = 7, offset = 1234, length = 80)))
    bodyStateOf(Option.None, 100, 0) => Result.Ok(BodyState.Missing)
    bodyStateOf(Option.None, 100, 500) => Result.Ok(BodyState.Pruned)
    bodyStateOf(Option.None, 500, 500) => Result.Ok(BodyState.Missing)
    bodyStateOf(Option.Some(emptyBytes()), 100, 0) => Result.Err("a Location record is 16 bytes, got 0")

fn asStored(stored: Bytes) -> Result<BodyState, String>
    ? "An entry is a Location, and a Location that will not decode is corruption."
    location = decodeLocation(stored)?
    Result.Ok(BodyState.Stored(location))

verify asStored
    asStored(encodeLocation(Location(segment = 7, offset = 1234, length = 80))) => Result.Ok(BodyState.Stored(Location(segment = 7, offset = 1234, length = 80)))
    asStored(emptyBytes()) => Result.Err("a Location record is 16 bytes, got 0")

fn absent(height: Int, prunedBelow: Int) -> BodyState
    ? "Below the Prune Watermark the bytes were discarded; at or above it they never arrived."
    match height < prunedBelow
        true -> BodyState.Pruned
        false -> BodyState.Missing

verify absent
    absent(0, 0) => BodyState.Missing
    absent(100, 0) => BodyState.Missing
    absent(100, 500) => BodyState.Pruned
    absent(500, 500) => BodyState.Missing

fn scanUsable(startHeight: Int, prunedBelow: Int) -> Bool
    ? "Whether a scan from this Height can see every Block it needs."
      "Pruning is prefix-shaped, so one comparison before starting replaces"
      "discovering a gap partway through and having to unwind."
    startHeight >= prunedBelow

verify scanUsable
    scanUsable(0, 0) => true
    scanUsable(500, 0) => true
    scanUsable(500, 500) => true
    scanUsable(499, 500) => false
    scanUsable(0, 1) => false
