module Snapshot
    intent =
        "One picture of the running node, assembled every tick of follow's"
        "loop and rendered elsewhere -- as lines on stdout in a plain run, as"
        "a Screen when one is asked for (#128). Nothing here draws and"
        "nothing here reads a clock: the loop hands in what happened and"
        "when, and this"
        "module only folds it up and answers arithmetic about it."
        "The rings are bounded on purpose: a Snapshot is what the node would"
        "want to say about now, not a log, so the newest few of everything is"
        "the whole point and forgetting the rest is correct."
    exposes [Phase, Sample, Progress, TipView, PeerView, BlockView, MempoolView, ReorgView, TxView, Company, Rings, Snapshot, started, headersAt, bodiesAt, tipAt, notedBlock, notedReorg, notedOrphan, notedTransaction, notedArrival, advanced, freshProgress, setsAt, withPeers, withCandidates, withMempool, withServing, rateOf, rateTenthsOf, etaSecsOf, percentOf, quietestSecsOf, inboundOf, outboundOf, blockLimit, reorgLimit, orphanLimit, transactionLimit, windowMs]
    depends []
    effects []

type Phase
    Headers
    Bodies
    Listening

record Sample
    atMs: Int
    done: Int

record Progress
    done: Int
    target: Int
    samples: List<Sample>

record TipView
    height: Int
    blockId: String
    atMs: Int

record PeerView
    key: Int
    address: String
    version: Int
    agent: String
    lastHeardMs: Int
    sent: Int
    received: Int
    inbound: Bool

record BlockView
    height: Int
    blockId: String
    transactions: Int
    bytes: Int
    atMs: Int

record ReorgView
    forkHeight: Int
    displaced: Int
    tipHeight: Int
    atMs: Int

record TxView
    txId: String
    fee: Int
    coinbase: Bool
    atMs: Int
    confirmed: Bool

record Company
    peers: List<PeerView>
    candidates: Int
    serving: Option<String>

record MempoolView
    held: Int
    bytes: Int
    cap: Int
    floorRate: Int

record Rings
    blocks: List<BlockView>
    reorgs: List<ReorgView>
    orphans: Int
    orphanMs: Int
    transactions: List<TxView>

record Snapshot
    phase: Phase
    tip: TipView
    headers: Progress
    bodies: Progress
    sets: Progress
    company: Company
    mempool: MempoolView
    rings: Rings

fn windowMs() -> Int
    ? "How far back the rate looks."
      "Sixty seconds: long enough that per-Block jitter averages out, short"
      "enough that a stall shows within the minute it happens."
    60000

verify windowMs
    windowMs() => 60000

fn blockLimit() -> Int
    ? "How many recent Blocks the Snapshot keeps."
    8

verify blockLimit
    blockLimit() => 8

fn reorgLimit() -> Int
    ? "How many recent Reorganisations the Snapshot keeps."
    5

verify reorgLimit
    reorgLimit() => 5

fn orphanLimit() -> Int
    ? "How many recent Orphan Headers the Snapshot keeps."
    5

verify orphanLimit
    orphanLimit() => 5

fn transactionLimit() -> Int
    ? "How many recently connected Transactions the Snapshot keeps."
    16

verify transactionLimit
    transactionLimit() => 16

fn freshProgress() -> Progress
    ? "A Progress that has not moved yet."
    Progress(done = 0, target = 0, samples = [])

verify freshProgress
    freshProgress() => Progress(done = 0, target = 0, samples = [])

fn started(nowMs: Int) -> Snapshot
    ? "The Snapshot a node begins with: no tip, nothing done, nobody met."
    Snapshot(phase = Phase.Headers, tip = TipView(height = 0, blockId = "", atMs = nowMs), headers = freshProgress(), bodies = freshProgress(), sets = freshProgress(), company = Company(peers = [], candidates = 0, serving = Option.None), mempool = MempoolView(held = 0, bytes = 0, cap = 0, floorRate = 0), rings = Rings(blocks = [], reorgs = [], orphans = 0, orphanMs = 0, transactions = []))

verify started
    started(5).tip.height => 0
    started(5).phase => Phase.Headers
    started(5).company.candidates => 0

fn headersAt(snapshot: Snapshot, done: Int, target: Int, nowMs: Int) -> Snapshot
    ? "The Header count moved; remember when, so a rate can be read off."
    Snapshot(phase = Phase.Headers, tip = snapshot.tip, headers = advanced(snapshot.headers, done, target, nowMs), bodies = snapshot.bodies, sets = snapshot.sets, company = snapshot.company, mempool = snapshot.mempool, rings = snapshot.rings)

verify headersAt
    headersAt(started(0), 100, 200, 1000).headers.done => 100
    headersAt(started(0), 100, 200, 1000).headers.target => 200
    headersAt(started(0), 100, 200, 1000).phase => Phase.Headers

fn bodiesAt(snapshot: Snapshot, done: Int, target: Int, nowMs: Int) -> Snapshot
    ? "The body count moved, which also means the Header phase is behind us."
    Snapshot(phase = Phase.Bodies, tip = snapshot.tip, headers = snapshot.headers, bodies = advanced(snapshot.bodies, done, target, nowMs), sets = snapshot.sets, company = snapshot.company, mempool = snapshot.mempool, rings = snapshot.rings)

verify bodiesAt
    bodiesAt(started(0), 7, 9, 1000).bodies.done => 7
    bodiesAt(started(0), 7, 9, 1000).phase => Phase.Bodies

fn setsAt(snapshot: Snapshot, done: Int, target: Int, nowMs: Int) -> Snapshot
    ? "The Set walked forward; the phase stays a catch-up phase, because a"
      "Set still connecting is a node not yet at the tip."
    Snapshot(phase = Phase.Bodies, tip = snapshot.tip, headers = snapshot.headers, bodies = snapshot.bodies, sets = advanced(snapshot.sets, done, target, nowMs), company = snapshot.company, mempool = snapshot.mempool, rings = snapshot.rings)

verify setsAt
    setsAt(started(0), 7, 9, 1000).sets.done => 7
    setsAt(started(0), 7, 9, 1000).phase => Phase.Bodies

fn tipAt(snapshot: Snapshot, height: Int, blockId: String, nowMs: Int) -> Snapshot
    ? "Caught up: the node stands on this Block, listening."
    Snapshot(phase = Phase.Listening, tip = TipView(height = height, blockId = blockId, atMs = nowMs), headers = snapshot.headers, bodies = snapshot.bodies, sets = snapshot.sets, company = snapshot.company, mempool = snapshot.mempool, rings = snapshot.rings)

verify tipAt
    tipAt(started(0), 318980, "aa", 1000).tip.height => 318980
    tipAt(started(0), 318980, "aa", 1000).tip.blockId => "aa"
    tipAt(started(0), 318980, "aa", 1000).phase => Phase.Listening

fn advanced(progress: Progress, done: Int, target: Int, nowMs: Int) -> Progress
    ? "One more reading, with everything older than the window let go."
    Progress(done = done, target = target, samples = List.prepend(Sample(atMs = nowMs, done = done), recentOf(progress.samples, nowMs - windowMs())))

verify advanced
    advanced(freshProgress(), 10, 100, 1000).samples => [Sample(atMs = 1000, done = 10)]
    advanced(advanced(freshProgress(), 10, 100, 1000), 20, 100, 2000).samples => [Sample(atMs = 2000, done = 20), Sample(atMs = 1000, done = 10)]
    advanced(advanced(freshProgress(), 10, 100, 1000), 20, 100, 62000).samples => [Sample(atMs = 62000, done = 20)]

fn recentOf(samples: List<Sample>, cutoff: Int) -> List<Sample>
    ? "The Samples still inside the window."
      "Newest first and taken in order, so the first old one ends the walk."
    List.reverse(gathered(samples, cutoff, []))

verify recentOf
    recentOf([], 0) => []
    recentOf([Sample(atMs = 5, done = 1)], 3) => [Sample(atMs = 5, done = 1)]
    recentOf([Sample(atMs = 5, done = 1)], 6) => []

fn gathered(samples: List<Sample>, cutoff: Int, acc: List<Sample>) -> List<Sample>
    ? "The kept Samples, gathered in reverse; the first old one ends the walk."
    match samples
        [] -> acc
        [head, ..tail] -> gatheredIfRecent(head, tail, cutoff, acc)

verify gathered
    gathered([Sample(atMs = 5, done = 1)], 3, []) => [Sample(atMs = 5, done = 1)]
    gathered([Sample(atMs = 2, done = 1), Sample(atMs = 1, done = 0)], 3, []) => []

fn gatheredIfRecent(head: Sample, tail: List<Sample>, cutoff: Int, acc: List<Sample>) -> List<Sample>
    ? "Keep a Sample the window still covers and carry on; stop at the first"
      "it does not, because newest-first order says the rest are older still."
    match head.atMs >= cutoff
        true -> gathered(tail, cutoff, List.prepend(head, acc))
        false -> acc

verify gatheredIfRecent
    gatheredIfRecent(Sample(atMs = 5, done = 1), [], 3, []) => [Sample(atMs = 5, done = 1)]
    gatheredIfRecent(Sample(atMs = 2, done = 1), [Sample(atMs = 1, done = 0)], 3, []) => []

fn rateOf(progress: Progress) -> Int
    ? "How many items a second, read across the window."
      "Zero when there is nothing to read a rate off: one Sample is a point,"
      "not a slope."
    match progress.samples
        [] -> 0
        [newest, ..older] -> slopeOf(newest, lastOf(older, newest))

verify rateOf
    rateOf(freshProgress()) => 0
    rateOf(advanced(freshProgress(), 10, 100, 1000)) => 0
    rateOf(advanced(advanced(freshProgress(), 1000, 9999, 1000), 4000, 9999, 61000)) => 50
    rateOf(advanced(advanced(freshProgress(), 0, 9, 0), 4, 9, 2000)) => 2

fn rateTenthsOf(progress: Progress) -> Int
    ? "Tenths of an item a second, read across the same window (#260)."
      "The Screen shows this one: at two or three Blocks a second a whole"
      "number hides a fifth of the walk's speed, and a fifth is the size"
      "of change worth seeing."
    match progress.samples
        [] -> 0
        [newest, ..older] -> slopeTenthsOf(newest, lastOf(older, newest))

verify rateTenthsOf
    rateTenthsOf(freshProgress()) => 0
    rateTenthsOf(advanced(freshProgress(), 10, 100, 1000)) => 0
    rateTenthsOf(advanced(advanced(freshProgress(), 1000, 9999, 1000), 4000, 9999, 61000)) => 500
    rateTenthsOf(advanced(advanced(freshProgress(), 0, 9, 0), 7, 9, 3000)) => 23

fn slopeTenthsOf(newest: Sample, oldest: Sample) -> Int
    ? "Tenths of an item a second between two Samples; zero when no time"
      "separates them."
    match newest.atMs - oldest.atMs > 0
        true -> Result.withDefault(Int.div((newest.done - oldest.done) * 10000, newest.atMs - oldest.atMs), 0)
        false -> 0

verify slopeTenthsOf
    slopeTenthsOf(Sample(atMs = 3000, done = 7), Sample(atMs = 0, done = 0)) => 23
    slopeTenthsOf(Sample(atMs = 1000, done = 4), Sample(atMs = 1000, done = 0)) => 0

fn slopeOf(newest: Sample, oldest: Sample) -> Int
    ? "Items a second between two Samples; zero when no time separates them."
    match newest.atMs - oldest.atMs > 0
        true -> Result.withDefault(Int.div((newest.done - oldest.done) * 1000, newest.atMs - oldest.atMs), 0)
        false -> 0

verify slopeOf
    slopeOf(Sample(atMs = 2000, done = 4), Sample(atMs = 0, done = 0)) => 2
    slopeOf(Sample(atMs = 1000, done = 4), Sample(atMs = 1000, done = 0)) => 0

fn lastOf(samples: List<Sample>, fallback: Sample) -> Sample
    ? "The oldest Sample held -- the end of a newest-first list."
    match samples
        [] -> fallback
        [head, ..tail] -> lastOf(tail, head)

verify lastOf
    lastOf([], Sample(atMs = 1, done = 1)) => Sample(atMs = 1, done = 1)
    lastOf([Sample(atMs = 2, done = 2), Sample(atMs = 3, done = 3)], Sample(atMs = 1, done = 1)) => Sample(atMs = 3, done = 3)

fn etaSecsOf(progress: Progress) -> Option<Int>
    ? "Seconds until done at the current rate, or nothing while the rate is"
      "unreadable. None and zero are different answers: zero means finished,"
      "None means nobody can yet say."
    match rateOf(progress) > 0
        true -> Option.Some(Result.withDefault(Int.div(Int.max(progress.target - progress.done, 0), rateOf(progress)), 0))
        false -> Option.None

verify etaSecsOf
    etaSecsOf(freshProgress()) => Option.None
    etaSecsOf(advanced(advanced(freshProgress(), 1000, 9999, 1000), 4000, 9999, 61000)) => Option.Some(119)
    etaSecsOf(advanced(advanced(freshProgress(), 8, 9, 0), 9, 9, 1000)) => Option.Some(0)

fn percentOf(progress: Progress) -> Int
    ? "How far through, in whole percent; zero of an unknown target is zero."
    match progress.target > 0
        true -> Result.withDefault(Int.div(progress.done * 100, progress.target), 0)
        false -> 0

verify percentOf
    percentOf(freshProgress()) => 0
    percentOf(Progress(done = 75, target = 200, samples = [])) => 37
    percentOf(Progress(done = 200, target = 200, samples = [])) => 100

fn notedBlock(snapshot: Snapshot, view: BlockView) -> Snapshot
    ? "A Block connected: newest first, oldest forgotten."
    withRings(snapshot, Rings(blocks = List.take(List.prepend(view, snapshot.rings.blocks), blockLimit()), reorgs = snapshot.rings.reorgs, orphans = snapshot.rings.orphans, orphanMs = snapshot.rings.orphanMs, transactions = snapshot.rings.transactions))

verify notedBlock
    notedBlock(started(0), BlockView(height = 1, blockId = "aa", transactions = 2, bytes = 300, atMs = 5)).rings.blocks => [BlockView(height = 1, blockId = "aa", transactions = 2, bytes = 300, atMs = 5)]

fn notedReorg(snapshot: Snapshot, view: ReorgView) -> Snapshot
    ? "A Reorganisation happened; the Screen's Blocks Panel wants the last few."
    withRings(snapshot, Rings(blocks = snapshot.rings.blocks, reorgs = List.take(List.prepend(view, snapshot.rings.reorgs), reorgLimit()), orphans = snapshot.rings.orphans, orphanMs = snapshot.rings.orphanMs, transactions = snapshot.rings.transactions))

verify notedReorg
    notedReorg(started(0), ReorgView(forkHeight = 7, displaced = 5, tipHeight = 12, atMs = 5)).rings.reorgs => [ReorgView(forkHeight = 7, displaced = 5, tipHeight = 12, atMs = 5)]

fn notedOrphan(snapshot: Snapshot, count: Int, nowMs: Int) -> Snapshot
    ? "Headers arrived whose parents we do not hold."
      "A count rather than names: the tree reports how many of a batch it"
      "could not place, and when the last of them was seen is what a watcher"
      "wants to know."
    withRings(snapshot, Rings(blocks = snapshot.rings.blocks, reorgs = snapshot.rings.reorgs, orphans = snapshot.rings.orphans + count, orphanMs = nowMs, transactions = snapshot.rings.transactions))

verify notedOrphan
    notedOrphan(started(0), 2, 9).rings.orphans => 2
    notedOrphan(notedOrphan(started(0), 2, 9), 1, 12).rings.orphans => 3
    notedOrphan(started(0), 2, 9).rings.orphanMs => 9

fn notedTransaction(snapshot: Snapshot, view: TxView) -> Snapshot
    ? "A Transaction connected, its fee already computed by connect."
      "A Transaction the Mempool already put on the ring flips where it"
      "stands rather than appearing twice under one Id (#164): the row a"
      "watcher has been looking at is the row that changes."
    withRings(snapshot, Rings(blocks = snapshot.rings.blocks, reorgs = snapshot.rings.reorgs, orphans = snapshot.rings.orphans, orphanMs = snapshot.rings.orphanMs, transactions = ringWith(snapshot.rings.transactions, view)))

verify notedTransaction
    notedTransaction(started(0), TxView(txId = "tt", fee = 1000, coinbase = false, atMs = 5, confirmed = true)).rings.transactions => [TxView(txId = "tt", fee = 1000, coinbase = false, atMs = 5, confirmed = true)]

fn notedArrival(snapshot: Snapshot, view: TxView) -> Snapshot
    ? "A Transaction the Mempool admitted, on the ring before any Block holds"
      "it (#164). This is the flow a Core user watches in mempool terms: it"
      "arrives, it waits, and a Block takes it -- and the same row says all"
      "three things in turn."
    withRings(snapshot, Rings(blocks = snapshot.rings.blocks, reorgs = snapshot.rings.reorgs, orphans = snapshot.rings.orphans, orphanMs = snapshot.rings.orphanMs, transactions = List.take(List.prepend(view, snapshot.rings.transactions), transactionLimit())))

verify notedArrival
    notedArrival(started(0), sampleTx("tt", false)).rings.transactions => [sampleTx("tt", false)]
    List.len(notedArrival(notedArrival(started(0), sampleTx("aa", false)), sampleTx("bb", false)).rings.transactions) => 2

fn ringWith(views: List<TxView>, view: TxView) -> List<TxView>
    ? "The ring after a Block took this Transaction: the row it already has"
      "under that Id, replaced in place, or a new row at the front."
    match holdsTx(views, view.txId)
        true -> flippedRows(views, view, [])
        false -> List.take(List.prepend(view, views), transactionLimit())

verify ringWith
    ringWith([], sampleTx("tt", true)) => [sampleTx("tt", true)]
    ringWith([sampleTx("tt", false)], sampleTx("tt", true)) => [sampleTx("tt", true)]
    ringWith([sampleTx("aa", true), sampleTx("tt", false)], sampleTx("tt", true)) => [sampleTx("aa", true), sampleTx("tt", true)]
    List.len(ringWith([sampleTx("aa", true)], sampleTx("tt", true))) => 2

fn holdsTx(views: List<TxView>, txId: String) -> Bool
    ? "Whether the ring already names this Transaction."
    match views
        [] -> false
        [head, ..tail] -> sameTxOrRest(head, txId, tail)

verify holdsTx
    holdsTx([], "tt") => false
    holdsTx([sampleTx("tt", false)], "tt") => true
    holdsTx([sampleTx("aa", false)], "tt") => false

fn sameTxOrRest(head: TxView, txId: String, tail: List<TxView>) -> Bool
    ? "This row, or the rest of them."
    match head.txId == txId
        true -> true
        false -> holdsTx(tail, txId)

verify sameTxOrRest
    sameTxOrRest(sampleTx("tt", false), "tt", []) => true
    sameTxOrRest(sampleTx("aa", false), "tt", [sampleTx("tt", false)]) => true
    sameTxOrRest(sampleTx("aa", false), "tt", []) => false

fn flippedRows(views: List<TxView>, view: TxView, acc: List<TxView>) -> List<TxView>
    ? "Every row kept where it is, with the one under this Id replaced."
    match views
        [] -> List.reverse(acc)
        [head, ..tail] -> flippedRows(tail, view, List.prepend(flippedRow(head, view), acc))

verify flippedRows
    flippedRows([], sampleTx("tt", true), []) => []
    flippedRows([sampleTx("tt", false)], sampleTx("tt", true), []) => [sampleTx("tt", true)]

fn flippedRow(head: TxView, view: TxView) -> TxView
    ? "The Block's view of it, if this is the same Transaction."
    match head.txId == view.txId
        true -> view
        false -> head

verify flippedRow
    flippedRow(sampleTx("tt", false), sampleTx("tt", true)) => sampleTx("tt", true)
    flippedRow(sampleTx("aa", false), sampleTx("tt", true)) => sampleTx("aa", false)

fn sampleTx(txId: String, confirmed: Bool) -> TxView
    ? "A Transaction view for the cases above, which care about two fields."
    TxView(txId = txId, fee = 1000, coinbase = false, atMs = 5, confirmed = confirmed)

verify sampleTx
    sampleTx("tt", true).txId => "tt"
    sampleTx("tt", false).confirmed => false

fn withRings(snapshot: Snapshot, rings: Rings) -> Snapshot
    ? "The Snapshot, with its rings moved on."
    Snapshot(phase = snapshot.phase, tip = snapshot.tip, headers = snapshot.headers, bodies = snapshot.bodies, sets = snapshot.sets, company = snapshot.company, mempool = snapshot.mempool, rings = rings)

fn inboundOf(peers: List<PeerView>) -> Int
    ? "How many of these Peers dialled us (#164)."
    countingIn(peers, 0)

verify inboundOf
    inboundOf([]) => 0
    inboundOf([samplePeer(false), samplePeer(true), samplePeer(true)]) => 2

fn countingIn(peers: List<PeerView>, acc: Int) -> Int
    ? "One Peer at a time, adding the ones that came to us."
    match peers
        [] -> acc
        [head, ..tail] -> countingIn(tail, addedIf(acc, head.inbound))

verify countingIn
    countingIn([], 4) => 4
    countingIn([samplePeer(true)], 4) => 5

fn addedIf(acc: Int, inbound: Bool) -> Int
    ? "One more, or the same."
    match inbound
        true -> acc + 1
        false -> acc

verify addedIf
    addedIf(3, true) => 4
    addedIf(3, false) => 3

fn outboundOf(peers: List<PeerView>) -> Int
    ? "How many of these Peers we dialled: the rest of them."
    List.len(peers) - inboundOf(peers)

verify outboundOf
    outboundOf([]) => 0
    outboundOf([samplePeer(false), samplePeer(true), samplePeer(true)]) => 1

fn samplePeer(inbound: Bool) -> PeerView
    ? "A Peer view for the cases above, which care about one field of it."
    PeerView(key = 0, address = "1.2.3.4:8333", version = 70016, agent = "/Satoshi/", lastHeardMs = 0, sent = 0, received = 0, inbound = inbound)

verify samplePeer
    samplePeer(true).inbound => true
    samplePeer(false).inbound => false

fn withPeers(snapshot: Snapshot, peers: List<PeerView>) -> Snapshot
    ? "Who the node is talking to, refreshed whole each tick."
    Snapshot(phase = snapshot.phase, tip = snapshot.tip, headers = snapshot.headers, bodies = snapshot.bodies, sets = snapshot.sets, company = Company(peers = peers, candidates = snapshot.company.candidates, serving = snapshot.company.serving), mempool = snapshot.mempool, rings = snapshot.rings)

verify withPeers
    List.len(withPeers(started(0), [PeerView(key = 0, address = "1.2.3.4:8333", version = 70016, agent = "/Satoshi/", lastHeardMs = 9, sent = 0, received = 0, inbound = false)]).company.peers) => 1

fn withCandidates(snapshot: Snapshot, count: Int) -> Snapshot
    ? "How many Candidates the Address Book holds."
    Snapshot(phase = snapshot.phase, tip = snapshot.tip, headers = snapshot.headers, bodies = snapshot.bodies, sets = snapshot.sets, company = Company(peers = snapshot.company.peers, candidates = count, serving = snapshot.company.serving), mempool = snapshot.mempool, rings = snapshot.rings)

verify withCandidates
    withCandidates(started(0), 41).company.candidates => 41

fn withServing(snapshot: Snapshot, serving: Option<String>) -> Snapshot
    ? "The Snapshot, told the address this node is advertising itself at."
      "None until enough Peers agree, and None for good on a node that was"
      "not asked to serve -- which is what makes it worth drawing: a watcher"
      "can tell a node nobody can reach from one that is waiting to be"
      "dialled (#214)."
    Snapshot(phase = snapshot.phase, tip = snapshot.tip, headers = snapshot.headers, bodies = snapshot.bodies, sets = snapshot.sets, company = Company(peers = snapshot.company.peers, candidates = snapshot.company.candidates, serving = serving), mempool = snapshot.mempool, rings = snapshot.rings)

verify withServing
    withServing(started(0), Option.Some("1.2.3.4:8333")).company.serving => Option.Some("1.2.3.4:8333")
    withServing(started(0), Option.None).company.serving => Option.None
    withServing(withServing(started(0), Option.Some("1.2.3.4:8333")), Option.None).company.serving => Option.None

fn withMempool(snapshot: Snapshot, view: MempoolView) -> Snapshot
    ? "What the Mempool holds, refreshed whole each tick (#134)."
    Snapshot(phase = snapshot.phase, tip = snapshot.tip, headers = snapshot.headers, bodies = snapshot.bodies, sets = snapshot.sets, company = snapshot.company, mempool = view, rings = snapshot.rings)

verify withMempool
    withMempool(started(0), MempoolView(held = 3, bytes = 900, cap = 5000000, floorRate = 1000)).mempool.held => 3
    withMempool(started(0), MempoolView(held = 3, bytes = 900, cap = 5000000, floorRate = 1000)).mempool.floorRate => 1000

fn quietestSecsOf(peers: List<PeerView>, nowMs: Int) -> Int
    ? "How long the least recently heard Peer has been silent, in seconds."
      "Zero with nobody connected: silence needs someone to be silent."
    match peers
        [] -> 0
        [head, ..tail] -> Int.div(nowMs - earliestHeard(tail, head.lastHeardMs), 1000)

verify quietestSecsOf
    quietestSecsOf([], 99999) => 0
    quietestSecsOf([PeerView(key = 0, address = "a", version = 1, agent = "x", lastHeardMs = 4000, sent = 0, received = 0, inbound = false), PeerView(key = 1, address = "b", version = 1, agent = "x", lastHeardMs = 1000, sent = 0, received = 0, inbound = false)], 10000) => 9

fn earliestHeard(peers: List<PeerView>, sofar: Int) -> Int
    ? "The oldest last-heard among the Peers."
    match peers
        [] -> sofar
        [head, ..tail] -> earliestHeard(tail, Int.min(head.lastHeardMs, sofar))

verify earliestHeard
    earliestHeard([], 7) => 7
    earliestHeard([PeerView(key = 1, address = "b", version = 1, agent = "x", lastHeardMs = 3, sent = 0, received = 0, inbound = false)], 7) => 3
