module UtxoStore
    intent =
        "How the UTXO Set and its Undo Data are spelled inside a Store."
        "Two more keyspaces. The u: space holds every Output no Transaction"
        "has spent yet, and it is the first keyspace here that shrinks: an"
        "Output is written when the Block creating it connects and deleted"
        "when the Block spending it does."
        "That is what makes it different from o:, which holds every Output"
        "ever created and only grows. Both are wanted and neither replaces the"
        "other -- o: answers 'what did this Input spend', which a reorganised"
        "Block still has to be able to ask, and u: answers 'may this Input"
        "spend it', which only the current chain can answer."
        "The d: space is the Undo Data: what connecting a Block removed from"
        "the Set, kept so that disconnecting it can put it back. Without it a"
        "reorganisation means rebuilding the Set from genesis, because a UTXO"
        "Set has no memory of what it used to hold."
        "The value format is Domain.Index's, unchanged. An Output is an amount"
        "and a Script wherever it is written down, and having two spellings of"
        "the same thing would be two things to get wrong."
    exposes [Unspent, Reached, unspentKey, undoKey, undoWindowKey, reachedKey, encodeReached, decodeReached, encodeCoin, decodeCoin, encodeUndo, decodeUndo, unspentAt, keyOf, matured, maturity, neverSpendable]
    depends [Bytes, Domain.ByteField, Domain.Index, Domain.IndexKeys]
    effects []

record Unspent
    txid: String
    index: Int
    value: Int
    script: String
    height: Int
    coinbase: Bool

record Reached
    height: Int
    blockId: String

fn coinbaseFlag() -> Int
    ? "The byte that says an Output was minted rather than paid."
    1

verify coinbaseFlag
    coinbaseFlag() => 1

fn encodeCoin(unspent: Unspent) -> Result<Bytes, String>
    ? "What the Set holds against a key: the amount, the Height that made it,"
      "whether it was minted rather than paid, and the Script."
      "The Transaction Id and the position are the key and are not repeated."
      "The Script goes last because it is the one field whose length the"
      "record does not say."
    Bytes.fromList(List.concat(Domain.ByteField.number(unspent.value, Domain.Index.amountWidth()), List.concat(Domain.ByteField.number(unspent.height, Domain.Index.heightWidth()), List.concat([flagByte(unspent.coinbase)], Bytes.octets(Bytes.fromHex(unspent.script)?)))))

verify encodeCoin
    Bytes.octets(encodeCoin(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))?) => List.concat(Domain.ByteField.number(5, 8), List.concat(Domain.ByteField.number(7, 4), [0, 118]))
    Bytes.octets(encodeCoin(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 0, coinbase = true))?) => List.concat(Domain.ByteField.number(5, 8), List.concat(Domain.ByteField.number(0, 4), [1]))

fn flagByte(coinbase: Bool) -> Int
    ? "The coinbase flag, as one byte."
    match coinbase
        true -> coinbaseFlag()
        false -> 0

verify flagByte
    flagByte(true) => 1
    flagByte(false) => 0

fn coinWidth() -> Int
    ? "How many bytes a Set entry takes before its Script."
    Domain.Index.amountWidth() + Domain.Index.heightWidth() + 1

verify coinWidth
    coinWidth() => 13

fn decodeCoin(txid: String, index: Int, stored: Bytes) -> Result<Unspent, String>
    ? "Read one back, given the key that named it."
    coinIn(txid, index, Bytes.octets(stored))

verify decodeCoin
    decodeCoin("aa", 0, encodeCoin(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))?) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    decodeCoin("aa", 0, encodeCoin(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 0, coinbase = true))?) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 0, coinbase = true))
    decodeCoin("aa", 0, Domain.Index.emptyBytes()) => Result.Err("a Set entry is at least 13 bytes, got 0")

fn coinIn(txid: String, index: Int, octets: List<Int>) -> Result<Unspent, String>
    ? "A record shorter than its fixed part is corruption."
    match List.len(octets) < coinWidth()
        true -> Result.Err("a Set entry is at least {coinWidth()} bytes, got {List.len(octets)}")
        false -> coinFrom(txid, index, octets)

verify coinIn
    coinIn("aa", 0, []) => Result.Err("a Set entry is at least 13 bytes, got 0")

fn coinFrom(txid: String, index: Int, octets: List<Int>) -> Result<Unspent, String>
    ? "The four fields, once the record is long enough to hold them."
    script = Bytes.toHex(Bytes.fromList(Domain.ByteField.after(octets, coinWidth()))?)
    Result.Ok(Unspent(txid = txid, index = index, value = Domain.ByteField.numberIn(Domain.ByteField.at(octets, 0, Domain.Index.amountWidth())), script = script, height = Domain.ByteField.numberIn(Domain.ByteField.at(octets, Domain.Index.amountWidth(), Domain.Index.heightWidth())), coinbase = Domain.ByteField.numberIn(Domain.ByteField.at(octets, coinWidth() - 1, 1)) == coinbaseFlag()))

verify coinFrom
    coinFrom("aa", 0, List.concat(Domain.ByteField.number(5, 8), List.concat(Domain.ByteField.number(7, 4), [0, 118]))) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))

fn encodeUndo(removed: List<Unspent>) -> Result<Bytes, String>
    ? "Everything a Block took out of the Set, as one record."
      "Each Output is its key material and then the entry the Set held, both"
      "length-prefixed so the walk back out needs no separator. It was"
      "semicolon-joined text, which worked only because every field was"
      "hexadecimal and so could not contain one."
    Bytes.fromList(undoInto(removed, [])?)

verify encodeUndo
    Bytes.octets(encodeUndo([])?) => []
    List.len(Bytes.octets(encodeUndo([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])?)) => 25
    List.len(Bytes.octets(encodeUndo([longScriptCoin()])?)) => 281

fn longScriptCoin() -> Unspent
    ? "An Output whose scriptPubKey is 257 bytes, which is the case that broke"
      "the Set at Height 243016 (#218): thirteen bytes of entry and then the"
      "script is 270, and 270 does not fit in the byte that used to say so."
    Unspent(txid = "aa", index = 0, value = 5, script = longScriptHex(), height = 7, coinbase = false)

verify longScriptCoin
    List.len(Bytes.octets(Bytes.fromHex(longScriptCoin().script)?)) => 257

fn longScriptHex() -> String
    ? "257 bytes of script as hexadecimal."
    Bytes.toHex(Result.withDefault(Bytes.fromList(Domain.ByteField.filled(257, 171)), Domain.Index.emptyBytes()))

verify longScriptHex
    List.len(Bytes.octets(Bytes.fromHex(longScriptHex())?)) => 257

fn undoInto(removed: List<Unspent>, acc: List<Int>) -> Result<List<Int>, String>
    ? "One Output at a time, in the order they were taken."
    match removed
        [] -> Result.Ok(acc)
        [head, ..tail] -> undoInto(tail, List.concat(acc, oneUndo(head)?))

verify undoInto
    undoInto([], []) => Result.Ok([])

fn oneUndo(unspent: Unspent) -> Result<List<Int>, String>
    ? "One removed Output: where it was, then what the Set held about it."
      "The key is a Transaction Id and an Output position, so it is thirty-six"
      "bytes whatever the Output was, and one length byte describes it for"
      "good. The entry is thirteen bytes and then the scriptPubKey, which has"
      "no such bound -- so it takes a wide prefix (#218). Behind one byte, a"
      "257-byte script made a 270-byte entry whose length would not fit, and"
      "the Set stopped at Height 243016 and blamed a Peer for it."
    key = Domain.ByteField.prefixed(Bytes.octets(unspentKey(unspent.txid, unspent.index)?))?
    entry = Domain.ByteField.prefixedWide(Bytes.octets(encodeCoin(unspent)?))
    Result.Ok(List.concat(key, entry))

verify oneUndo
    List.len(oneUndo(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))?) => 25
    List.len(oneUndo(longScriptCoin())?) => 281

fn decodeUndo(stored: Bytes) -> Result<List<Unspent>, String>
    ? "Read a Block's Undo Data back."
    eachUndo(Bytes.octets(stored), [])

verify decodeUndo
    decodeUndo(Domain.Index.emptyBytes()) => Result.Ok([])
    decodeUndo(encodeUndo([longScriptCoin()])?) => Result.Ok([longScriptCoin()])
    decodeUndo(encodeUndo([longScriptCoin(), Unspent(txid = "bb", index = 2, value = 7, script = "", height = 1, coinbase = true)])?) => Result.Ok([longScriptCoin(), Unspent(txid = "bb", index = 2, value = 7, script = "", height = 1, coinbase = true)])
    decodeUndo(encodeUndo([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])?) => Result.Ok([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])
    decodeUndo(encodeUndo([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false), Unspent(txid = "bb", index = 2, value = 7, script = "", height = 1, coinbase = true)])?) => Result.Ok([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false), Unspent(txid = "bb", index = 2, value = 7, script = "", height = 1, coinbase = true)])

fn eachUndo(octets: List<Int>, acc: List<Unspent>) -> Result<List<Unspent>, String>
    ? "One length-prefixed pair at a time, until the record runs out."
    match octets
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> undoThen(octets, acc)

verify eachUndo
    eachUndo([], []) => Result.Ok([])

fn undoThen(octets: List<Int>, acc: List<Unspent>) -> Result<List<Unspent>, String>
    ? "The key, then the entry, then whatever follows them."
      "The key behind one length byte and the entry behind four, which is what"
      "oneUndo writes and why (#218)."
    key = Domain.ByteField.prefixedIn(octets)
    rest = Domain.ByteField.afterPrefixed(octets)
    entry = Domain.ByteField.prefixedWideIn(rest)
    one = fromUndo(key, entry)?
    eachUndo(Domain.ByteField.afterPrefixedWide(rest), List.prepend(one, acc))

verify undoThen
    undoThen(Bytes.octets(encodeUndo([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])?), []) => Result.Ok([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])
    undoThen(Bytes.octets(encodeUndo([longScriptCoin()])?), []) => Result.Ok([longScriptCoin()])

fn fromUndo(key: List<Int>, entry: List<Int>) -> Result<Unspent, String>
    ? "One Output, from the key that named it and the entry the Set held."
      "Split apart here and decoded by decodeCoin, so an Undo entry and a Set"
      "entry cannot drift into two different spellings of one Output."
    decodeCoin(txidInKey(key), indexInKey(key), Bytes.fromList(entry)?)

verify fromUndo
    fromUndo(Bytes.octets(unspentKey("aa", 0)?), Bytes.octets(encodeCoin(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))?)) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))

fn txidInKey(key: List<Int>) -> String
    ? "The Transaction Id an Undo record's key names."
    Bytes.toHex(Result.withDefault(Bytes.fromList(Domain.ByteField.at(key, 1, List.len(key) - 1 - Domain.IndexKeys.indexWidth())), Domain.Index.emptyBytes()))

verify txidInKey
    txidInKey(Bytes.octets(unspentKey("aa", 0)?)) => "aa"

fn indexInKey(key: List<Int>) -> Int
    ? "The Output position an Undo record's key names."
    Domain.ByteField.numberIn(Domain.ByteField.after(key, List.len(key) - Domain.IndexKeys.indexWidth()))

verify indexInKey
    indexInKey(Bytes.octets(unspentKey("aa", 12)?)) => 12

fn encodeReached(reached: Reached) -> Result<Bytes, String>
    ? "Where the Set stands: a Height, and the Block it stands on."
      "The Block Id is not decoration beside the Height. A Height alone says"
      "the Set was built along whatever branch h: named at the time, and h: is"
      "the one keyspace a reorganisation rewrites -- so a Height alone stops"
      "being true the moment the chain changes its mind, and nothing on disk"
      "can tell that it has. Naming the Block makes it checkable, and it is"
      "also the only way back down: Undo Data is keyed by Block Id."
    Bytes.fromList(List.concat(Domain.ByteField.number(reached.height, Domain.Index.heightWidth()), Bytes.octets(Bytes.fromHex(reached.blockId)?)))

verify encodeReached
    Bytes.octets(encodeReached(Reached(height = 0, blockId = "aa"))?) => [0, 0, 0, 0, 170]
    Bytes.octets(encodeReached(Reached(height = 4000, blockId = ""))?) => Domain.ByteField.number(4000, 4)

fn decodeReached(stored: Bytes) -> Result<Reached, String>
    ? "Read it back."
      "There is no old spelling to refuse any more. A record written before"
      "the Block Id was kept could be told apart when both were text; the"
      "directory is rebuilt rather than migrated (#42), so what would have"
      "read one is simply not there."
    reachedIn(Bytes.octets(stored))

verify decodeReached
    decodeReached(encodeReached(Reached(height = 0, blockId = "aa"))?) => Result.Ok(Reached(height = 0, blockId = "aa"))
    decodeReached(encodeReached(Reached(height = 4000, blockId = "bb"))?) => Result.Ok(Reached(height = 4000, blockId = "bb"))
    decodeReached(Domain.Index.emptyBytes()) => Result.Err("a Set standing is at least 4 bytes, got 0")

fn reachedIn(octets: List<Int>) -> Result<Reached, String>
    ? "A Height, then the Block Id that follows it."
    match List.len(octets) < Domain.Index.heightWidth()
        true -> Result.Err("a Set standing is at least {Domain.Index.heightWidth()} bytes, got {List.len(octets)}")
        false -> Result.Ok(Reached(height = Domain.ByteField.numberIn(Domain.ByteField.at(octets, 0, Domain.Index.heightWidth())), blockId = Bytes.toHex(Bytes.fromList(Domain.ByteField.after(octets, Domain.Index.heightWidth()))?)))

verify reachedIn
    reachedIn([]) => Result.Err("a Set standing is at least 4 bytes, got 0")
    reachedIn([0, 0, 0, 1, 170]) => Result.Ok(Reached(height = 1, blockId = "aa"))

fn unspentTag() -> Int
    ? "The byte that begins every Set entry: ASCII 'u'."
    117

verify unspentTag
    unspentTag() => 117

fn undoTag() -> Int
    ? "The byte that begins every Undo Data record: ASCII 'd'."
    100

verify undoTag
    undoTag() => 100

fn unspentKey(txid: String, index: Int) -> Result<Bytes, String>
    ? "Where one unspent Output lives, keyed the way an Input names it."
      "The same shape as Domain.Index.outputKey and a different prefix, so the"
      "two keyspaces answer the same question from the same key material and"
      "cannot be confused for one another."
    Domain.IndexKeys.tagged(unspentTag(), List.concat(Domain.IndexKeys.idBytes(txid)?, Domain.IndexKeys.scanOrder(index, Domain.IndexKeys.indexWidth())))

verify unspentKey
    Bytes.octets(unspentKey("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", 0)?) => List.concat([unspentTag()], List.concat(Bytes.octets(Bytes.fromHex("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16")?), Domain.IndexKeys.scanOrder(0, Domain.IndexKeys.indexWidth())))
    Bytes.octets(unspentKey("aa", 1)?) => List.concat([unspentTag()], List.concat(Bytes.octets(Bytes.fromHex("aa")?), Domain.IndexKeys.scanOrder(1, Domain.IndexKeys.indexWidth())))
    Bytes.octets(unspentKey("aa", 12345)?) => List.concat([unspentTag()], List.concat(Bytes.octets(Bytes.fromHex("aa")?), Domain.IndexKeys.scanOrder(12345, Domain.IndexKeys.indexWidth())))

fn keyOf(unspent: Unspent) -> Result<Bytes, String>
    ? "Where this Output lives."
    unspentKey(unspent.txid, unspent.index)

verify keyOf
    keyOf(Unspent(txid = "aa", index = 1, value = 5, script = "76", height = 0, coinbase = false)) => unspentKey("aa", 1)

fn undoKey(blockId: String) -> Result<Bytes, String>
    ? "Where a Block's Undo Data lives."
      "Keyed by Block Id rather than Height: a reorganisation is exactly when"
      "Undo Data is read, and it is exactly when a Height stops naming the"
      "Block it named before."
    Domain.IndexKeys.tagged(undoTag(), Domain.IndexKeys.idBytes(blockId)?)

verify undoKey
    Bytes.octets(undoKey("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")?) => List.prepend(undoTag(), Bytes.octets(Bytes.fromHex("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")?))
    Bytes.octets(undoKey("")?) => List.prepend(undoTag(), Bytes.octets(Bytes.fromHex("")?))

fn undoWindowKey() -> Result<Bytes, String>
    ? "The single record naming the lowest Height whose Undo Data is still kept."
      "Undo Data is bounded: keeping it for the whole chain would cost more"
      "than the chain. A reorganisation reaching below this Height cannot be"
      "undone, and the node has to say so and stop rather than guess."
    Domain.IndexKeys.metaKey("undoBelow")

verify undoWindowKey
    undoWindowKey() => Domain.IndexKeys.metaKey("undoBelow")

fn reachedKey() -> Result<Bytes, String>
    ? "The single record naming the Block the Set has been built up to."
      "A UTXO Set has no meaningful range: it is the state after connecting"
      "every Block up to one, so where it has got to is the only thing that"
      "says what it means. Absent means nothing has been connected, which is a"
      "Set holding nothing rather than a Set at Height zero -- genesis's"
      "Output has to be connected like any other."
    Domain.IndexKeys.metaKey("setTo")

verify reachedKey
    reachedKey() => Domain.IndexKeys.metaKey("setTo")

fn unspentAt(txid: String, index: Int, output: SpentOutput, height: Int, coinbase: Bool) -> Unspent
    ? "An Output of a Transaction, as the Set holds it."
      "The Height and the coinbase flag travel with the Output because a"
      "coinbase Output cannot be spent for a hundred Blocks, and the only way"
      "to know whether a spend is too early is to know when the Output was"
      "made. Bitcoin Core keeps the same two beside every entry, for the same"
      "reason."
    Unspent(txid = txid, index = index, value = output.value, script = output.script, height = height, coinbase = coinbase)

verify unspentAt
    unspentAt("aa", 0, SpentOutput(value = 5, script = "76"), 7, false).value => 5
    unspentAt("aa", 0, SpentOutput(value = 5, script = "76"), 7, false).height => 7
    unspentAt("aa", 0, SpentOutput(value = 5, script = "76"), 7, true).coinbase => true

fn neverSpendable(scriptHex: String) -> Bool
    ? "Whether no witness could ever satisfy this Output Script."
      "Core's IsUnspendable, and the reason its chainstate is smaller than a"
      "naive one: a Script that begins with OP_RETURN refuses in the"
      "interpreter's first step, and one longer than the 10,000 byte Script"
      "size limit is refused before any step runs. Such an Output is history"
      "-- o: records it, because o: answers what a Block created -- but it is"
      "not an unspent Output, and the UTXO Set never holds it (#111)."
      "Every SegWit coinbase carries one: the witness commitment, an"
      "OP_RETURN paying zero. On a chain of SegWit coinbases that is one"
      "unreachable entry per Block, roughly doubling the Set."
    match String.startsWith(scriptHex, "6a")
        true -> true
        false -> String.len(scriptHex) > 20000

verify neverSpendable
    neverSpendable("6a") => true
    neverSpendable("6a24aa21a9ed94aab4ac1f8e2a3ad0ab53b0f2a0fa2a2c1cba4f21d55d2eb3e33e2e3fd3") => true
    neverSpendable("76a914a31c06bd463e3923bc1aadbde48b16976c08071788ac") => false
    neverSpendable("51") => false
    neverSpendable("") => false
    neverSpendable("006a") => false

fn maturity() -> Int
    ? "How many Blocks a coinbase Output waits before it can be spent."
      "A hundred, and the reason is reorganisation: a coinbase is the one"
      "Output that vanishes rather than moves when its Block leaves the chain,"
      "because nothing else created it. Everything paid out of it would vanish"
      "with it, so the chain makes you wait until that is vanishingly unlikely."
    100

verify maturity
    maturity() => 100

fn matured(unspent: Unspent, spendingAt: Int) -> Bool
    ? "Whether this Output may be spent by a Block at this Height."
      "Only a coinbase waits. Core's rule is that the spending Height must be"
      "at least a hundred above the Height that made it, so a coinbase from"
      "Height 1 is first spendable at 101."
    match unspent.coinbase
        false -> true
        true -> spendingAt - unspent.height >= maturity()

verify matured
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = false), 2) => true
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = true), 2) => false
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = true), 100) => false
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = true), 101) => true
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 0, coinbase = true), 100) => true
