module UtxoStore
    intent =
        "How the UTXO Set and its Undo Data are spelled inside a Store."
        "Two more keyspaces. The u: space holds every Output no Transaction"
        "has spent yet, and it is the first keyspace here that shrinks: an"
        "Output is written when the Block creating it connects and deleted"
        "when the Block spending it does."
        "That is what makes it different from o:, which holds every Output"
        "ever created and only grows. Both are wanted and neither replaces the"
        "other -- o: answers 'what did this Input spend', which a reorganised"
        "Block still has to be able to ask, and u: answers 'may this Input"
        "spend it', which only the current chain can answer."
        "The d: space is the Undo Data: what connecting a Block removed from"
        "the Set, kept so that disconnecting it can put it back. Without it a"
        "reorganisation means rebuilding the Set from genesis, because a UTXO"
        "Set has no memory of what it used to hold."
        "The value format is Domain.Index's, unchanged. An Output is an amount"
        "and a Script wherever it is written down, and having two spellings of"
        "the same thing would be two things to get wrong."
    exposes [Unspent, Reached, indexOf, unspentKey, undoKey, undoWindowKey, reachedKey, encodeReached, decodeReached, encodeCoin, decodeCoin, encodeUndo, decodeUndo, unspentAt, keyOf, matured, maturity, neverSpendable]
    depends [Bytes, Domain.Index, Domain.IndexKeys]
    effects []

record Unspent
    txid: String
    index: Int
    value: Int
    script: String
    height: Int
    coinbase: Bool

record Reached
    height: Int
    blockId: String

fn unspentTag() -> Int
    ? "The byte that begins every Set entry: ASCII 'u'."
    117

verify unspentTag
    unspentTag() => 117

fn undoTag() -> Int
    ? "The byte that begins every Undo Data record: ASCII 'd'."
    100

verify undoTag
    undoTag() => 100

fn unspentKey(txid: String, index: Int) -> Result<Bytes, String>
    ? "Where one unspent Output lives, keyed the way an Input names it."
      "The same shape as Domain.Index.outputKey and a different prefix, so the"
      "two keyspaces answer the same question from the same key material and"
      "cannot be confused for one another."
    Domain.IndexKeys.tagged(unspentTag(), List.concat(Domain.IndexKeys.idBytes(txid)?, Domain.IndexKeys.scanOrder(index, Domain.IndexKeys.indexWidth())))

verify unspentKey
    Bytes.octets(unspentKey("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16", 0)?) => List.concat([unspentTag()], List.concat(Bytes.octets(Bytes.fromHex("f4184fc596403b9d638783cf57adfe4c75c605f6356fbc91338530e9831e9e16")?), Domain.IndexKeys.scanOrder(0, Domain.IndexKeys.indexWidth())))
    Bytes.octets(unspentKey("aa", 1)?) => List.concat([unspentTag()], List.concat(Bytes.octets(Bytes.fromHex("aa")?), Domain.IndexKeys.scanOrder(1, Domain.IndexKeys.indexWidth())))
    Bytes.octets(unspentKey("aa", 12345)?) => List.concat([unspentTag()], List.concat(Bytes.octets(Bytes.fromHex("aa")?), Domain.IndexKeys.scanOrder(12345, Domain.IndexKeys.indexWidth())))

fn indexOf(key: Bytes) -> String
    ? "How a Map in memory finds an Output that the Store finds by its key."
      "Hexadecimal of the same bytes. Aver's Map cannot key on Bytes -- the"
      "generated Rust derives neither Eq nor Hash for it (jasisz/aver#1127) --"
      "and the walk in Domain.Connect has to look up the same Output the Store"
      "would. One-to-one, so nothing about which Outputs are distinct changes."
    Bytes.toHex(key)

verify indexOf
    indexOf(unspentKey("aa", 0)?) => "75aa00000000"
    indexOf(unspentKey("aa", 1)?) => "75aa00000001"

fn keyOf(unspent: Unspent) -> Result<Bytes, String>
    ? "Where this Output lives."
    unspentKey(unspent.txid, unspent.index)

verify keyOf
    keyOf(Unspent(txid = "aa", index = 1, value = 5, script = "76", height = 0, coinbase = false)) => unspentKey("aa", 1)

fn undoKey(blockId: String) -> Result<Bytes, String>
    ? "Where a Block's Undo Data lives."
      "Keyed by Block Id rather than Height: a reorganisation is exactly when"
      "Undo Data is read, and it is exactly when a Height stops naming the"
      "Block it named before."
    Domain.IndexKeys.tagged(undoTag(), Domain.IndexKeys.idBytes(blockId)?)

verify undoKey
    Bytes.octets(undoKey("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")?) => List.prepend(undoTag(), Bytes.octets(Bytes.fromHex("000000000019d6689c085ae165831e934ff763ae46a2a6c172b3f1b60a8ce26f")?))
    Bytes.octets(undoKey("")?) => List.prepend(undoTag(), Bytes.octets(Bytes.fromHex("")?))

fn undoWindowKey() -> Result<Bytes, String>
    ? "The single record naming the lowest Height whose Undo Data is still kept."
      "Undo Data is bounded: keeping it for the whole chain would cost more"
      "than the chain. A reorganisation reaching below this Height cannot be"
      "undone, and the node has to say so and stop rather than guess."
    Domain.IndexKeys.metaKey("undoBelow")

verify undoWindowKey
    undoWindowKey() => Domain.IndexKeys.metaKey("undoBelow")

fn reachedKey() -> Result<Bytes, String>
    ? "The single record naming the Block the Set has been built up to."
      "A UTXO Set has no meaningful range: it is the state after connecting"
      "every Block up to one, so where it has got to is the only thing that"
      "says what it means. Absent means nothing has been connected, which is a"
      "Set holding nothing rather than a Set at Height zero -- genesis's"
      "Output has to be connected like any other."
    Domain.IndexKeys.metaKey("setTo")

verify reachedKey
    reachedKey() => Domain.IndexKeys.metaKey("setTo")

fn encodeReached(reached: Reached) -> String
    ? "Where the Set stands: a Height, and the Block it stands on."
      "The Block Id is not decoration beside the Height. A Height alone says"
      "the Set was built along whatever branch h: named at the time, and h: is"
      "the one keyspace a reorganisation rewrites -- so a Height alone stops"
      "being true the moment the chain changes its mind, and nothing on disk"
      "can tell that it has. Naming the Block makes it checkable, and it is"
      "also the only way back down: Undo Data is keyed by Block Id."
    "{reached.height}:{reached.blockId}"

verify encodeReached
    encodeReached(Reached(height = 0, blockId = "aa")) => "0:aa"
    encodeReached(Reached(height = 4000, blockId = "00000086d6b2636cb2a392d45edc4ec544a10024d30141c9adf4bfd9de533b53")) => "4000:00000086d6b2636cb2a392d45edc4ec544a10024d30141c9adf4bfd9de533b53"

fn decodeReached(text: String) -> Result<Reached, String>
    ? "Read it back, refusing a record written before the Block Id was kept."
      "A bare Height is the pre-#26 spelling, and it is refused rather than"
      "read as a Height on the branch h: names now. That reading would be a"
      "guess: if h: was reorganised after the Set was built, the Set describes"
      "Blocks that are no longer on the chain, and the old record holds"
      "nothing that could say so. Rebuilding is cheap; a Set quietly"
      "describing the wrong branch is not."
    reachedParts(text, String.split(text, ":"))

verify decodeReached
    decodeReached("0:aa") => Result.Ok(Reached(height = 0, blockId = "aa"))
    decodeReached("4000:bb") => Result.Ok(Reached(height = 4000, blockId = "bb"))
    decodeReached("4000") => Result.Err("the Set records Height 4000 but not the Block it stands on; it was built before the Block Id was kept, so delete the Set and run utxo again")
    decodeReached("") => Result.Err("Set standing must be height:blockId, got ''")
    decodeReached("x:aa") => Result.Err("Set standing must name a whole Height, got 'x:aa'")
    decodeReached("0:aa:bb") => Result.Err("Set standing must be height:blockId, got '0:aa:bb'")

fn reachedParts(text: String, split: List<String>) -> Result<Reached, String>
    ? "The Height comes first."
    match split
        [] -> Result.Err("Set standing must be height:blockId, got '{text}'")
        [height, ..rest] -> afterReachedHeight(text, height, rest)

verify reachedParts
    reachedParts("0:aa", ["0", "aa"]) => Result.Ok(Reached(height = 0, blockId = "aa"))
    reachedParts("", []) => Result.Err("Set standing must be height:blockId, got ''")

fn afterReachedHeight(text: String, height: String, rest: List<String>) -> Result<Reached, String>
    ? "One field and no more is either the old spelling or not a standing at all."
    match rest
        [] -> soleField(text, Domain.Index.decodeHeight(height))
        [blockId, ..extra] -> afterReachedBlock(text, height, blockId, extra)

verify afterReachedHeight
    afterReachedHeight("0:aa", "0", ["aa"]) => Result.Ok(Reached(height = 0, blockId = "aa"))
    afterReachedHeight("7", "7", []) => Result.Err("the Set records Height 7 but not the Block it stands on; it was built before the Block Id was kept, so delete the Set and run utxo again")
    afterReachedHeight("", "", []) => Result.Err("Set standing must be height:blockId, got ''")

fn soleField(text: String, height: Result<Int, String>) -> Result<Reached, String>
    ? "A lone whole number is what this program wrote before it kept the Block"
      "Id, and is named as such so the reader is told to rebuild rather than"
      "left to guess at corruption. Anything else never was a standing."
    match height
        Result.Ok(at) -> Result.Err(onlyHeight(text))
        Result.Err(why) -> Result.Err("Set standing must be height:blockId, got '{text}'")

verify soleField
    soleField("7", Result.Ok(7)) => Result.Err("the Set records Height 7 but not the Block it stands on; it was built before the Block Id was kept, so delete the Set and run utxo again")
    soleField("", Result.Err("no")) => Result.Err("Set standing must be height:blockId, got ''")

fn onlyHeight(text: String) -> String
    ? "What to say about a Set whose standing predates the Block Id."
    "the Set records Height {text} but not the Block it stands on; it was built before the Block Id was kept, so delete the Set and run utxo again"

verify onlyHeight
    onlyHeight("7") => "the Set records Height 7 but not the Block it stands on; it was built before the Block Id was kept, so delete the Set and run utxo again"

fn afterReachedBlock(text: String, height: String, blockId: String, extra: List<String>) -> Result<Reached, String>
    ? "Refuse a third field, then read the Height."
      "A Block Id is hexadecimal and holds no colon, so a third field means"
      "the text was never a standing."
    match extra
        [] -> reachedWith(text, Domain.Index.decodeHeight(height), blockId)
        [head, ..tail] -> Result.Err("Set standing must be height:blockId, got '{text}'")

verify afterReachedBlock
    afterReachedBlock("0:aa", "0", "aa", []) => Result.Ok(Reached(height = 0, blockId = "aa"))
    afterReachedBlock("0:aa:bb", "0", "aa", ["bb"]) => Result.Err("Set standing must be height:blockId, got '0:aa:bb'")

fn reachedWith(text: String, height: Result<Int, String>, blockId: String) -> Result<Reached, String>
    ? "The Height has to be a whole number."
    match height
        Result.Err(why) -> Result.Err("Set standing must name a whole Height, got '{text}'")
        Result.Ok(at) -> Result.Ok(Reached(height = at, blockId = blockId))

verify reachedWith
    reachedWith("0:aa", Result.Ok(0), "aa") => Result.Ok(Reached(height = 0, blockId = "aa"))
    reachedWith("x:aa", Result.Err("no"), "aa") => Result.Err("Set standing must name a whole Height, got 'x:aa'")

fn unspentAt(txid: String, index: Int, output: SpentOutput, height: Int, coinbase: Bool) -> Unspent
    ? "An Output of a Transaction, as the Set holds it."
      "The Height and the coinbase flag travel with the Output because a"
      "coinbase Output cannot be spent for a hundred Blocks, and the only way"
      "to know whether a spend is too early is to know when the Output was"
      "made. Bitcoin Core keeps the same two beside every entry, for the same"
      "reason."
    Unspent(txid = txid, index = index, value = output.value, script = output.script, height = height, coinbase = coinbase)

verify unspentAt
    unspentAt("aa", 0, SpentOutput(value = 5, script = "76"), 7, false).value => 5
    unspentAt("aa", 0, SpentOutput(value = 5, script = "76"), 7, false).height => 7
    unspentAt("aa", 0, SpentOutput(value = 5, script = "76"), 7, true).coinbase => true

fn neverSpendable(scriptHex: String) -> Bool
    ? "Whether no witness could ever satisfy this Output Script."
      "Core's IsUnspendable, and the reason its chainstate is smaller than a"
      "naive one: a Script that begins with OP_RETURN refuses in the"
      "interpreter's first step, and one longer than the 10,000 byte Script"
      "size limit is refused before any step runs. Such an Output is history"
      "-- o: records it, because o: answers what a Block created -- but it is"
      "not an unspent Output, and the UTXO Set never holds it (#111)."
      "Every SegWit coinbase carries one: the witness commitment, an"
      "OP_RETURN paying zero. On a chain of SegWit coinbases that is one"
      "unreachable entry per Block, roughly doubling the Set."
    match String.startsWith(scriptHex, "6a")
        true -> true
        false -> String.len(scriptHex) > 20000

verify neverSpendable
    neverSpendable("6a") => true
    neverSpendable("6a24aa21a9ed94aab4ac1f8e2a3ad0ab53b0f2a0fa2a2c1cba4f21d55d2eb3e33e2e3fd3") => true
    neverSpendable("76a914a31c06bd463e3923bc1aadbde48b16976c08071788ac") => false
    neverSpendable("51") => false
    neverSpendable("") => false
    neverSpendable("006a") => false

fn maturity() -> Int
    ? "How many Blocks a coinbase Output waits before it can be spent."
      "A hundred, and the reason is reorganisation: a coinbase is the one"
      "Output that vanishes rather than moves when its Block leaves the chain,"
      "because nothing else created it. Everything paid out of it would vanish"
      "with it, so the chain makes you wait until that is vanishingly unlikely."
    100

verify maturity
    maturity() => 100

fn matured(unspent: Unspent, spendingAt: Int) -> Bool
    ? "Whether this Output may be spent by a Block at this Height."
      "Only a coinbase waits. Core's rule is that the spending Height must be"
      "at least a hundred above the Height that made it, so a coinbase from"
      "Height 1 is first spendable at 101."
    match unspent.coinbase
        false -> true
        true -> spendingAt - unspent.height >= maturity()

verify matured
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = false), 2) => true
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = true), 2) => false
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = true), 100) => false
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 1, coinbase = true), 101) => true
    matured(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 0, coinbase = true), 100) => true

fn encodeCoin(unspent: Unspent) -> String
    ? "What the Set holds against a key: the amount, the Script, the Height"
      "that made it, and whether it was minted rather than paid."
      "The Transaction Id and the position are the key and are not repeated."
    "{unspent.value}:{unspent.script}:{unspent.height}:{flagOf(unspent.coinbase)}"

verify encodeCoin
    encodeCoin(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)) => "5:76:7:0"
    encodeCoin(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 0, coinbase = true)) => "5::0:1"

fn flagOf(coinbase: Bool) -> String
    ? "The coinbase flag, as one character."
    match coinbase
        true -> "1"
        false -> "0"

verify flagOf
    flagOf(true) => "1"
    flagOf(false) => "0"

fn decodeCoin(txid: String, index: Int, text: String) -> Result<Unspent, String>
    ? "Read one back, given the key that named it."
    coinParts(txid, index, text, String.split(text, ":"))

verify decodeCoin
    decodeCoin("aa", 0, "5:76:7:0") => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    decodeCoin("aa", 0, "5::0:1") => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "", height = 0, coinbase = true))
    decodeCoin("aa", 0, "5:76:7") => Result.Err("Set entry must be value:script:height:coinbase, got '5:76:7'")
    decodeCoin("aa", 0, "5:76:7:0:x") => Result.Err("Set entry must be value:script:height:coinbase, got '5:76:7:0:x'")
    decodeCoin("aa", 0, "x:76:7:0") => Result.Err("Set entry must hold whole numbers, got 'x:76:7:0'")
    decodeCoin("aa", 0, "5:76:x:0") => Result.Err("Set entry must hold whole numbers, got '5:76:x:0'")

fn coinParts(txid: String, index: Int, text: String, split: List<String>) -> Result<Unspent, String>
    ? "The amount comes first."
    match split
        [] -> Result.Err("Set entry must be value:script:height:coinbase, got '{text}'")
        [value, ..rest] -> afterValue(txid, index, text, value, rest)

verify coinParts
    coinParts("aa", 0, "5:76:7:0", ["5", "76", "7", "0"]) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    coinParts("aa", 0, "", []) => Result.Err("Set entry must be value:script:height:coinbase, got ''")

fn afterValue(txid: String, index: Int, text: String, value: String, rest: List<String>) -> Result<Unspent, String>
    ? "Then the Script."
    match rest
        [] -> Result.Err("Set entry must be value:script:height:coinbase, got '{text}'")
        [script, ..more] -> afterScript(txid, index, text, value, script, more)

verify afterValue
    afterValue("aa", 0, "5:76:7:0", "5", ["76", "7", "0"]) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    afterValue("aa", 0, "5", "5", []) => Result.Err("Set entry must be value:script:height:coinbase, got '5'")

fn afterScript(txid: String, index: Int, text: String, value: String, script: String, more: List<String>) -> Result<Unspent, String>
    ? "Then the Height that made it."
    match more
        [] -> Result.Err("Set entry must be value:script:height:coinbase, got '{text}'")
        [height, ..last] -> afterHeight(txid, index, text, value, script, height, last)

verify afterScript
    afterScript("aa", 0, "5:76:7:0", "5", "76", ["7", "0"]) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    afterScript("aa", 0, "5:76", "5", "76", []) => Result.Err("Set entry must be value:script:height:coinbase, got '5:76'")

fn afterHeight(txid: String, index: Int, text: String, value: String, script: String, height: String, last: List<String>) -> Result<Unspent, String>
    ? "The flag is last, and nothing follows it."
    match last
        [] -> Result.Err("Set entry must be value:script:height:coinbase, got '{text}'")
        [flag, ..extra] -> afterFlag(txid, index, text, value, script, height, flag, extra)

verify afterHeight
    afterHeight("aa", 0, "5:76:7:0", "5", "76", "7", ["0"]) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    afterHeight("aa", 0, "5:76:7", "5", "76", "7", []) => Result.Err("Set entry must be value:script:height:coinbase, got '5:76:7'")

fn afterFlag(txid: String, index: Int, text: String, value: String, script: String, height: String, flag: String, extra: List<String>) -> Result<Unspent, String>
    ? "Refuse a fifth field, then read the two numbers."
    match extra
        [] -> numbered(txid, index, text, Domain.Index.decodeHeight(value), script, Domain.Index.decodeHeight(height), flag)
        [head, ..tail] -> Result.Err("Set entry must be value:script:height:coinbase, got '{text}'")

verify afterFlag
    afterFlag("aa", 0, "5:76:7:0", "5", "76", "7", "0", []) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    afterFlag("aa", 0, "5:76:7:0:x", "5", "76", "7", "0", ["x"]) => Result.Err("Set entry must be value:script:height:coinbase, got '5:76:7:0:x'")

fn numbered(txid: String, index: Int, text: String, value: Result<Int, String>, script: String, height: Result<Int, String>, flag: String) -> Result<Unspent, String>
    ? "The amount has to be a whole number."
    match value
        Result.Err(why) -> Result.Err("Set entry must hold whole numbers, got '{text}'")
        Result.Ok(amount) -> withValue(txid, index, text, amount, script, height, flag)

verify numbered
    numbered("aa", 0, "5:76:7:0", Result.Ok(5), "76", Result.Ok(7), "0") => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    numbered("aa", 0, "x:76:7:0", Result.Err("no"), "76", Result.Ok(7), "0") => Result.Err("Set entry must hold whole numbers, got 'x:76:7:0'")

fn withValue(txid: String, index: Int, text: String, value: Int, script: String, height: Result<Int, String>, flag: String) -> Result<Unspent, String>
    ? "So does the Height."
    match height
        Result.Err(why) -> Result.Err("Set entry must hold whole numbers, got '{text}'")
        Result.Ok(made) -> Result.Ok(Unspent(txid = txid, index = index, value = value, script = script, height = made, coinbase = flag == "1"))

verify withValue
    withValue("aa", 0, "5:76:7:0", 5, "76", Result.Ok(7), "0") => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    withValue("aa", 0, "5:76:7:1", 5, "76", Result.Ok(7), "1") => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = true))
    withValue("aa", 0, "5:76:x:0", 5, "76", Result.Err("no"), "0") => Result.Err("Set entry must hold whole numbers, got '5:76:x:0'")

fn encodeUndo(removed: List<Unspent>) -> String
    ? "Everything a Block took out of the Set, as one record."
      "Semicolons between Outputs, and each Output is its key material"
      "followed by the same four fields the Set holds -- so restoring one is"
      "putting back exactly what was taken, Height and coinbase flag"
      "included. A Script and a Transaction Id are both hexadecimal, so"
      "neither separator can appear inside a field, and the empty list is the"
      "empty string, which is what a Block of nothing but a coinbase removes."
    joined(removed, "")

verify encodeUndo
    encodeUndo([]) => ""
    encodeUndo([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)]) => "aa:0:5:76:7:0"
    encodeUndo([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false), Unspent(txid = "bb", index = 2, value = 7, script = "", height = 1, coinbase = true)]) => "aa:0:5:76:7:0;bb:2:7::1:1"

fn joined(removed: List<Unspent>, acc: String) -> String
    ? "One Output at a time, separated where there is something to separate."
    match removed
        [] -> acc
        [head, ..tail] -> joined(tail, appended(acc, oneUndo(head)))

verify joined
    joined([], "") => ""
    joined([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)], "") => "aa:0:5:76:7:0"

fn appended(acc: String, piece: String) -> String
    ? "A separator only between pieces, never before the first."
    match String.len(acc) == 0
        true -> piece
        false -> "{acc};{piece}"

verify appended
    appended("", "x") => "x"
    appended("x", "y") => "x;y"

fn oneUndo(unspent: Unspent) -> String
    ? "One removed Output: where it was, and everything the Set held about it."
    "{unspent.txid}:{unspent.index}:{encodeCoin(unspent)}"

verify oneUndo
    oneUndo(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)) => "aa:0:5:76:7:0"
    oneUndo(Unspent(txid = "aa", index = 3, value = 0, script = "", height = 0, coinbase = true)) => "aa:3:0::0:1"

fn decodeUndo(text: String) -> Result<List<Unspent>, String>
    ? "Read a Block's Undo Data back."
    match String.len(text) == 0
        true -> Result.Ok([])
        false -> eachUndo(String.split(text, ";"), [])

verify decodeUndo
    decodeUndo("") => Result.Ok([])
    decodeUndo("aa:0:5:76:7:0") => Result.Ok([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])
    decodeUndo("aa:0:5:76:7:0;bb:2:7::1:1") => Result.Ok([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false), Unspent(txid = "bb", index = 2, value = 7, script = "", height = 1, coinbase = true)])
    decodeUndo("aa:0:5") => Result.Err("Set entry must be value:script:height:coinbase, got '5'")
    decodeUndo("aa") => Result.Err("Undo entry must be txid:index followed by the Set entry, got 'aa'")
    decodeUndo("aa:x:5:76:7:0") => Result.Err("Undo entry must name a whole Output position, got 'aa:x:5:76:7:0'")

fn eachUndo(pieces: List<String>, acc: List<Unspent>) -> Result<List<Unspent>, String>
    ? "One piece at a time, in the order they were written."
    match pieces
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> undoThen(head, tail, acc)

verify eachUndo
    eachUndo([], []) => Result.Ok([])
    eachUndo(["aa:0:5:76:7:0"], []) => Result.Ok([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])
    eachUndo(["aa:x:5:76:7:0"], []) => Result.Err("Undo entry must name a whole Output position, got 'aa:x:5:76:7:0'")

fn undoThen(piece: String, rest: List<String>, acc: List<Unspent>) -> Result<List<Unspent>, String>
    ? "Decode this one, then carry on."
    match oneDecoded(piece)
        Result.Err(why) -> Result.Err(why)
        Result.Ok(unspent) -> eachUndo(rest, List.prepend(unspent, acc))

verify undoThen
    undoThen("aa:0:5:76:7:0", [], []) => Result.Ok([Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false)])
    undoThen("bad", [], []) => Result.Err("Undo entry must be txid:index followed by the Set entry, got 'bad'")

fn oneDecoded(piece: String) -> Result<Unspent, String>
    ? "The Transaction Id and the position, then the Set entry behind them."
      "Split apart here and decoded by decodeCoin, so an Undo entry and a Set"
      "entry cannot drift into two different spellings of one Output."
    undoParts(piece, String.split(piece, ":"))

verify oneDecoded
    oneDecoded("aa:0:5:76:7:0") => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    oneDecoded("aa") => Result.Err("Undo entry must be txid:index followed by the Set entry, got 'aa'")

fn undoParts(piece: String, split: List<String>) -> Result<Unspent, String>
    ? "The Transaction Id comes first."
    match split
        [] -> Result.Err("Undo entry must be txid:index followed by the Set entry, got '{piece}'")
        [txid, ..rest] -> afterTxid(piece, txid, rest)

verify undoParts
    undoParts("aa:0:5:76:7:0", ["aa", "0", "5", "76", "7", "0"]) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    undoParts("", []) => Result.Err("Undo entry must be txid:index followed by the Set entry, got ''")

fn afterTxid(piece: String, txid: String, rest: List<String>) -> Result<Unspent, String>
    ? "Then which Output of it, then everything else is the Set entry."
    match rest
        [] -> Result.Err("Undo entry must be txid:index followed by the Set entry, got '{piece}'")
        [index, ..coin] -> withPosition(piece, txid, Domain.Index.decodeHeight(index), coin)

verify afterTxid
    afterTxid("aa:0:5:76:7:0", "aa", ["0", "5", "76", "7", "0"]) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    afterTxid("aa", "aa", []) => Result.Err("Undo entry must be txid:index followed by the Set entry, got 'aa'")

fn withPosition(piece: String, txid: String, index: Result<Int, String>, coin: List<String>) -> Result<Unspent, String>
    ? "The position has to be a whole number; the rest is the Set entry, rejoined."
    match index
        Result.Err(why) -> Result.Err("Undo entry must name a whole Output position, got '{piece}'")
        Result.Ok(at) -> decodeCoin(txid, at, String.join(coin, ":"))

verify withPosition
    withPosition("aa:0:5:76:7:0", "aa", Result.Ok(0), ["5", "76", "7", "0"]) => Result.Ok(Unspent(txid = "aa", index = 0, value = 5, script = "76", height = 7, coinbase = false))
    withPosition("aa:x:5:76:7:0", "aa", Result.Err("no"), ["5", "76", "7", "0"]) => Result.Err("Undo entry must name a whole Output position, got 'aa:x:5:76:7:0'")
