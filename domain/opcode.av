module Opcode
    intent =
        "What each byte of a Script means, by name."
        "Names rather than a sum type of two hundred and fifty-six constructors."
        "Aver matches exhaustively, so every match on such a type would have to"
        "list every opcode or fall through a wildcard that hides the ones nobody"
        "thought about — which is the thing exhaustiveness was for."
        "So an opcode stays a byte, and this says what the byte is called and"
        "which of a few kinds it belongs to. The interpreter matches on the"
        "numbers it implements and asks here about the rest."
        "Every byte has an answer. An undefined one is named as undefined rather"
        "than left to a caller to notice, because a Script containing one is"
        "invalid and saying so needs a name to say it about."
    exposes [Kind, nameOf, isDisabled, isAlwaysInvalid, isPushData, isSmallNumber, pushWidth, smallNumberValue, rearrangeDepth, kindOf]
    depends []
    effects []

type Kind
    SmallNumber
    Rearrange
    UnaryArithmetic
    BinaryArithmetic
    Nop
    Undecidable
    Invalid

fn nameOf(code: Int) -> String
    ? "The name Bitcoin gives this byte."
      "Grouped the way the reference client groups them, so a reader comparing"
      "the two is looking at the same order."
    match code
        0 -> "OP_0"
        76 -> "OP_PUSHDATA1"
        77 -> "OP_PUSHDATA2"
        78 -> "OP_PUSHDATA4"
        79 -> "OP_1NEGATE"
        80 -> "OP_RESERVED"
        _ -> beyondPushes(code)

verify nameOf
    nameOf(0) => "OP_0"
    nameOf(1) => "OP_PUSHBYTES_1"
    nameOf(75) => "OP_PUSHBYTES_75"
    nameOf(76) => "OP_PUSHDATA1"
    nameOf(79) => "OP_1NEGATE"
    nameOf(81) => "OP_1"
    nameOf(96) => "OP_16"
    nameOf(118) => "OP_DUP"
    nameOf(169) => "OP_HASH160"
    nameOf(172) => "OP_CHECKSIG"
    nameOf(186) => "OP_CHECKSIGADD"
    nameOf(255) => "OP_INVALIDOPCODE"

fn beyondPushes(code: Int) -> String
    ? "Everything that is not a plain push or one of the four around them."
    match code < 76
        true -> "OP_PUSHBYTES_{code}"
        false -> named(code)

verify beyondPushes
    beyondPushes(1) => "OP_PUSHBYTES_1"
    beyondPushes(75) => "OP_PUSHBYTES_75"
    beyondPushes(118) => "OP_DUP"

fn named(code: Int) -> String
    ? "The opcodes proper, from OP_1 upward."
    match code
        81 -> "OP_1"
        82 -> "OP_2"
        83 -> "OP_3"
        84 -> "OP_4"
        85 -> "OP_5"
        86 -> "OP_6"
        87 -> "OP_7"
        88 -> "OP_8"
        89 -> "OP_9"
        90 -> "OP_10"
        91 -> "OP_11"
        92 -> "OP_12"
        93 -> "OP_13"
        94 -> "OP_14"
        95 -> "OP_15"
        96 -> "OP_16"
        97 -> "OP_NOP"
        98 -> "OP_VER"
        99 -> "OP_IF"
        100 -> "OP_NOTIF"
        101 -> "OP_VERIF"
        102 -> "OP_VERNOTIF"
        103 -> "OP_ELSE"
        104 -> "OP_ENDIF"
        105 -> "OP_VERIFY"
        106 -> "OP_RETURN"
        _ -> stackNames(code)

verify named
    named(81) => "OP_1"
    named(96) => "OP_16"
    named(99) => "OP_IF"
    named(106) => "OP_RETURN"
    named(118) => "OP_DUP"

fn stackNames(code: Int) -> String
    ? "Moving things about, and the string opcodes that were disabled with them."
    match code
        107 -> "OP_TOALTSTACK"
        108 -> "OP_FROMALTSTACK"
        109 -> "OP_2DROP"
        110 -> "OP_2DUP"
        111 -> "OP_3DUP"
        112 -> "OP_2OVER"
        113 -> "OP_2ROT"
        114 -> "OP_2SWAP"
        115 -> "OP_IFDUP"
        116 -> "OP_DEPTH"
        117 -> "OP_DROP"
        118 -> "OP_DUP"
        119 -> "OP_NIP"
        120 -> "OP_OVER"
        121 -> "OP_PICK"
        122 -> "OP_ROLL"
        123 -> "OP_ROT"
        124 -> "OP_SWAP"
        125 -> "OP_TUCK"
        126 -> "OP_CAT"
        127 -> "OP_SUBSTR"
        128 -> "OP_LEFT"
        129 -> "OP_RIGHT"
        130 -> "OP_SIZE"
        _ -> logicNames(code)

verify stackNames
    stackNames(107) => "OP_TOALTSTACK"
    stackNames(118) => "OP_DUP"
    stackNames(126) => "OP_CAT"
    stackNames(130) => "OP_SIZE"

fn logicNames(code: Int) -> String
    ? "Bitwise logic, mostly disabled, and the comparisons."
    match code
        131 -> "OP_INVERT"
        132 -> "OP_AND"
        133 -> "OP_OR"
        134 -> "OP_XOR"
        135 -> "OP_EQUAL"
        136 -> "OP_EQUALVERIFY"
        137 -> "OP_RESERVED1"
        138 -> "OP_RESERVED2"
        _ -> arithmeticNames(code)

verify logicNames
    logicNames(131) => "OP_INVERT"
    logicNames(135) => "OP_EQUAL"
    logicNames(136) => "OP_EQUALVERIFY"

fn arithmeticNames(code: Int) -> String
    ? "Arithmetic, of which rather more is disabled than survives."
    match code
        139 -> "OP_1ADD"
        140 -> "OP_1SUB"
        141 -> "OP_2MUL"
        142 -> "OP_2DIV"
        143 -> "OP_NEGATE"
        144 -> "OP_ABS"
        145 -> "OP_NOT"
        146 -> "OP_0NOTEQUAL"
        147 -> "OP_ADD"
        148 -> "OP_SUB"
        149 -> "OP_MUL"
        150 -> "OP_DIV"
        151 -> "OP_MOD"
        152 -> "OP_LSHIFT"
        153 -> "OP_RSHIFT"
        154 -> "OP_BOOLAND"
        155 -> "OP_BOOLOR"
        156 -> "OP_NUMEQUAL"
        157 -> "OP_NUMEQUALVERIFY"
        158 -> "OP_NUMNOTEQUAL"
        159 -> "OP_LESSTHAN"
        160 -> "OP_GREATERTHAN"
        161 -> "OP_LESSTHANOREQUAL"
        162 -> "OP_GREATERTHANOREQUAL"
        163 -> "OP_MIN"
        164 -> "OP_MAX"
        165 -> "OP_WITHIN"
        _ -> cryptoNames(code)

verify arithmeticNames
    arithmeticNames(139) => "OP_1ADD"
    arithmeticNames(149) => "OP_MUL"
    arithmeticNames(165) => "OP_WITHIN"

fn cryptoNames(code: Int) -> String
    ? "The hashes and the signature checks, which are the ones we cannot answer."
    match code
        166 -> "OP_RIPEMD160"
        167 -> "OP_SHA1"
        168 -> "OP_SHA256"
        169 -> "OP_HASH160"
        170 -> "OP_HASH256"
        171 -> "OP_CODESEPARATOR"
        172 -> "OP_CHECKSIG"
        173 -> "OP_CHECKSIGVERIFY"
        174 -> "OP_CHECKMULTISIG"
        175 -> "OP_CHECKMULTISIGVERIFY"
        _ -> lateNames(code)

verify cryptoNames
    cryptoNames(166) => "OP_RIPEMD160"
    cryptoNames(169) => "OP_HASH160"
    cryptoNames(172) => "OP_CHECKSIG"
    cryptoNames(175) => "OP_CHECKMULTISIGVERIFY"

fn lateNames(code: Int) -> String
    ? "The no-ops, the two that were given meanings later, and everything after."
      "OP_NOP2 and OP_NOP3 became the timelocks, so they are named for what they"
      "do now rather than for the holes they used to be."
    match code
        176 -> "OP_NOP1"
        177 -> "OP_CHECKLOCKTIMEVERIFY"
        178 -> "OP_CHECKSEQUENCEVERIFY"
        179 -> "OP_NOP4"
        180 -> "OP_NOP5"
        181 -> "OP_NOP6"
        182 -> "OP_NOP7"
        183 -> "OP_NOP8"
        184 -> "OP_NOP9"
        185 -> "OP_NOP10"
        186 -> "OP_CHECKSIGADD"
        255 -> "OP_INVALIDOPCODE"
        _ -> "OP_UNDEFINED_{code}"

verify lateNames
    lateNames(176) => "OP_NOP1"
    lateNames(177) => "OP_CHECKLOCKTIMEVERIFY"
    lateNames(186) => "OP_CHECKSIGADD"
    lateNames(187) => "OP_UNDEFINED_187"
    lateNames(255) => "OP_INVALIDOPCODE"

fn isDisabled(code: Int) -> Bool
    ? "Whether this opcode was removed and makes any Script containing it invalid."
      "Disabled is not the same as undefined. A disabled opcode fails a Script"
      "even in a branch that is never taken, which no other rule here does, so"
      "the interpreter has to know before it decides what to execute."
    match code
        126 -> true
        127 -> true
        128 -> true
        129 -> true
        131 -> true
        132 -> true
        133 -> true
        134 -> true
        141 -> true
        142 -> true
        149 -> true
        150 -> true
        151 -> true
        152 -> true
        153 -> true
        _ -> false

verify isDisabled
    isDisabled(126) => true
    isDisabled(134) => true
    isDisabled(141) => true
    isDisabled(153) => true
    isDisabled(118) => false
    isDisabled(172) => false
    isDisabled(0) => false

fn isPushData(code: Int) -> Bool
    ? "Whether this byte pushes data rather than doing something."
    Bool.or(Bool.and(code >= 1, code <= 75), Bool.and(code >= 76, code <= 78))

verify isPushData
    isPushData(1) => true
    isPushData(75) => true
    isPushData(76) => true
    isPushData(78) => true
    isPushData(0) => false
    isPushData(79) => false

fn pushWidth(code: Int) -> Int
    ? "How many bytes hold the length of a wide push; zero when it is not one."
    match code
        76 -> 1
        77 -> 2
        78 -> 4
        _ -> 0

verify pushWidth
    pushWidth(76) => 1
    pushWidth(77) => 2
    pushWidth(78) => 4
    pushWidth(75) => 0

fn isSmallNumber(code: Int) -> Bool
    ? "OP_1 through OP_16, which push their own value."
    Bool.and(code >= 81, code <= 96)

verify isSmallNumber
    isSmallNumber(81) => true
    isSmallNumber(96) => true
    isSmallNumber(80) => false
    isSmallNumber(97) => false

fn smallNumberValue(code: Int) -> Int
    ? "What OP_1 through OP_16 push."
    code - 80

verify smallNumberValue
    smallNumberValue(81) => 1
    smallNumberValue(96) => 16

fn isNop(code: Int) -> Bool
    ? "OP_NOP and the reserved ones that were left doing nothing."
      "OP_NOP2 and OP_NOP3 are not among them. They became the two timelocks,"
      "and treating them as doing nothing would accept Scripts that consensus"
      "rejects — which is exactly the kind of quiet wrongness this project is"
      "trying not to have."
    Bool.or(code == 97, Bool.or(code == 176, Bool.and(code >= 179, code <= 185)))

verify isNop
    isNop(97) => true
    isNop(176) => true
    isNop(179) => true
    isNop(185) => true
    isNop(177) => false
    isNop(178) => false
    isNop(186) => false

fn rearrangeDepth(code: Int) -> Int
    ? "How deep an opcode reaches, for the ones that only move items about."
      "Thirteen opcodes do nothing but shuffle the top of the stack. They vary"
      "from OP_DROP, which reaches one item down, to OP_2ROT, which reaches"
      "six, and popping that many one at a time needs a chain of five functions"
      "none of which has a name worth reading. So the interpreter takes this"
      "many items and permutes them instead."
      "Nought means this is not one of them. OP_IFDUP is nought despite looking"
      "like one, because what it does depends on the value it finds."
    match code
        109 -> 2
        110 -> 2
        111 -> 3
        112 -> 4
        113 -> 6
        114 -> 4
        117 -> 1
        118 -> 1
        119 -> 2
        120 -> 2
        123 -> 3
        124 -> 2
        125 -> 2
        _ -> 0

verify rearrangeDepth
    rearrangeDepth(109) => 2
    rearrangeDepth(111) => 3
    rearrangeDepth(112) => 4
    rearrangeDepth(113) => 6
    rearrangeDepth(117) => 1
    rearrangeDepth(118) => 1
    rearrangeDepth(125) => 2
    rearrangeDepth(115) => 0
    rearrangeDepth(172) => 0

fn isAlwaysInvalid(code: Int) -> Bool
    ? "OP_VERIF and OP_VERNOTIF, which fail a Script wherever they appear."
      "The same rule as a disabled opcode and for a different reason: these two"
      "were never removed, they are simply refused before the condition stack"
      "is consulted, so an OP_VERIF in a branch that is never taken still"
      "invalidates the Script."
    Bool.or(code == 101, code == 102)

verify isAlwaysInvalid
    isAlwaysInvalid(101) => true
    isAlwaysInvalid(102) => true
    isAlwaysInvalid(98) => false
    isAlwaysInvalid(105) => false

fn kindOf(code: Int) -> Kind
    ? "Which family an opcode belongs to, once the ones handled by number are"
      "out of the way."
      "That proviso is a real precondition and not a turn of phrase. An opcode"
      "the interpreter names individually — OP_DUP, OP_VERIFY, OP_SHA256 and"
      "the dozen others — is answered Invalid here, because this only knows the"
      "families and those opcodes belong to none of them. Ask about one and the"
      "answer is wrong. The alternative was a second list of the named opcodes"
      "kept in step with the interpreter's own, which is a worse trade than one"
      "sentence."
      "It is here rather than in the interpreter because a family is a fact"
      "about an opcode rather than about running one, and because the"
      "interpreter was growing the cascade of predicates this replaces."
    match isSmallNumber(code)
        true -> Kind.SmallNumber
        false -> beyondNumbers(code)

verify kindOf
    kindOf(81) => Kind.SmallNumber
    kindOf(96) => Kind.SmallNumber
    kindOf(118) => Kind.Rearrange
    kindOf(113) => Kind.Rearrange
    kindOf(139) => Kind.UnaryArithmetic
    kindOf(146) => Kind.UnaryArithmetic
    kindOf(147) => Kind.BinaryArithmetic
    kindOf(164) => Kind.BinaryArithmetic
    kindOf(97) => Kind.Nop
    kindOf(185) => Kind.Nop
    kindOf(172) => Kind.Undecidable
    kindOf(177) => Kind.Undecidable
    kindOf(80) => Kind.Invalid
    kindOf(187) => Kind.Invalid

fn beyondNumbers(code: Int) -> Kind
    ? "The opcodes that only move items about."
    match rearrangeDepth(code) > 0
        true -> Kind.Rearrange
        false -> beyondStack(code)

verify beyondNumbers
    beyondNumbers(118) => Kind.Rearrange
    beyondNumbers(139) => Kind.UnaryArithmetic
    beyondNumbers(147) => Kind.BinaryArithmetic
    beyondNumbers(97) => Kind.Nop
    beyondNumbers(172) => Kind.Undecidable
    beyondNumbers(80) => Kind.Invalid

fn beyondStack(code: Int) -> Kind
    ? "Arithmetic on one operand. OP_2MUL and OP_2DIV sit inside this run and"
      "are disabled, which is why it is two ranges rather than one."
    match Bool.or(Bool.and(code >= 139, code <= 140), Bool.and(code >= 143, code <= 146))
        true -> Kind.UnaryArithmetic
        false -> beyondUnary(code)

verify beyondStack
    beyondStack(139) => Kind.UnaryArithmetic
    beyondStack(143) => Kind.UnaryArithmetic
    beyondStack(146) => Kind.UnaryArithmetic
    beyondStack(147) => Kind.BinaryArithmetic
    beyondStack(97) => Kind.Nop
    beyondStack(80) => Kind.Invalid

fn beyondUnary(code: Int) -> Kind
    ? "Arithmetic on two operands, the numeric comparisons included."
      "OP_MUL through OP_RSHIFT lie between the two runs and are disabled."
    match Bool.or(Bool.and(code >= 147, code <= 148), Bool.and(code >= 154, code <= 164))
        true -> Kind.BinaryArithmetic
        false -> beyondArithmetic(code)

verify beyondUnary
    beyondUnary(147) => Kind.BinaryArithmetic
    beyondUnary(154) => Kind.BinaryArithmetic
    beyondUnary(164) => Kind.BinaryArithmetic
    beyondUnary(97) => Kind.Nop
    beyondUnary(172) => Kind.Undecidable
    beyondUnary(80) => Kind.Invalid

fn beyondArithmetic(code: Int) -> Kind
    ? "What is left is a no-op, something we cannot decide, or invalid."
    match isNop(code)
        true -> Kind.Nop
        false -> beyondNops(code)

verify beyondArithmetic
    beyondArithmetic(97) => Kind.Nop
    beyondArithmetic(172) => Kind.Undecidable
    beyondArithmetic(80) => Kind.Invalid

fn beyondNops(code: Int) -> Kind
    ? "Undecidable when the opcode needs a primitive or a Transaction we have"
      "not got; invalid when it is reserved or undefined, both of which fail a"
      "Script that runs them."
      "None of the five hash opcodes is a hole any more. OP_SHA1 was the last"
      "one, on the grounds that SHA-1 was a primitive nothing here had and"
      "nothing in Bitcoin needed badly enough to be worth writing. Auditing"
      "found two spends that run it, at Heights 251684 and 251898, so the"
      "chain disagreed and the chain decides."
    match Bool.or(Bool.and(code >= 171, code <= 175), Bool.or(Bool.and(code >= 177, code <= 178), code == 186))
        true -> Kind.Undecidable
        false -> Kind.Invalid

verify beyondNops
    beyondNops(167) => Kind.Invalid
    beyondNops(168) => Kind.Invalid
    beyondNops(171) => Kind.Undecidable
    beyondNops(175) => Kind.Undecidable
    beyondNops(177) => Kind.Undecidable
    beyondNops(186) => Kind.Undecidable
    beyondNops(80) => Kind.Invalid
    beyondNops(98) => Kind.Invalid
    beyondNops(187) => Kind.Invalid
