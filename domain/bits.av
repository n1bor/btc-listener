module Bits
    intent =
        "Bit operations built from arithmetic."
        "Aver has no bitwise operators, and the Bech32 checksum is defined in"
        "terms of exclusive-or and shifts, so they are reconstructed here from"
        "division and remainder. Shifts are multiplication and division by a"
        "power of two; exclusive-or is done a bit at a time."
    exposes [xor, twoTo, shiftRight, shiftLeft, lowBits, bitAt]
    effects []

fn twoTo(exponent: Int) -> Int
    ? "Two raised to a non-negative power."
    twoToInto(exponent, 1)

verify twoTo
    twoTo(0) => 1
    twoTo(5) => 32
    twoTo(25) => 33554432

fn twoToInto(exponent: Int, acc: Int) -> Int
    ? "Accumulator form so the recursion stays in tail position."
    match exponent <= 0
        true -> acc
        false -> twoToInto(exponent - 1, acc * 2)

verify twoToInto
    twoToInto(3, 1) => 8
    twoToInto(0, 7) => 7

fn shiftRight(value: Int, places: Int) -> Int
    ? "Discard the lowest `places` bits. The divisor is a power of two, so the division cannot fail."
    Result.withDefault(Int.div(value, twoTo(places)), 0)

verify shiftRight
    shiftRight(32, 5) => 1
    shiftRight(33554432, 25) => 1
    shiftRight(7, 0) => 7

fn shiftLeft(value: Int, places: Int) -> Int
    ? "Append `places` zero bits."
    value * twoTo(places)

verify shiftLeft
    shiftLeft(1, 5) => 32
    shiftLeft(3, 0) => 3

fn lowBits(value: Int, count: Int) -> Int
    ? "Keep only the lowest `count` bits. The divisor is a power of two, so the remainder cannot fail."
    Result.withDefault(Int.mod(value, twoTo(count)), 0)

verify lowBits
    lowBits(33, 5) => 1
    lowBits(33554433, 25) => 1
    lowBits(31, 5) => 31

fn bitAt(value: Int, index: Int) -> Int
    ? "The bit at `index`, counting from the least significant."
    Int.mod(shiftRight(value, index), 2)

verify bitAt
    bitAt(1, 0) => 1
    bitAt(2, 0) => 0
    bitAt(2, 1) => 1
    bitAt(8, 3) => 1

fn xor(left: Int, right: Int) -> Int
    ? "Bitwise exclusive-or, one bit at a time, since Aver has no operator for it."
    xorInto(left, right, 1, 0)

verify xor
    xor(0, 0) => 0
    xor(1, 1) => 0
    xor(1, 0) => 1
    xor(5, 3) => 6
    xor(1000000007, 123456789) => 1019283218
    xor(996825010, 642813549) => 490396127
    xor(1, 1073741824) => 1073741825

fn xorInto(left: Int, right: Int, place: Int, acc: Int) -> Int
    ? "Accumulator form: combine the lowest bit of each, then move up."
    match Bool.and(left <= 0, right <= 0)
        true -> acc
        false -> xorStep(left, right, place, acc)

verify xorInto
    xorInto(0, 0, 1, 0) => 0
    xorInto(5, 3, 1, 0) => 6

fn xorStep(left: Int, right: Int, place: Int, acc: Int) -> Int
    ? "One bit of the result, then recurse on what remains."
    bit = Int.mod(Int.mod(left, 2) + Int.mod(right, 2), 2)
    xorInto(Int.div(left, 2), Int.div(right, 2), place * 2, acc + bit * place)

verify xorStep
    xorStep(1, 0, 1, 0) => 1
    xorStep(3, 1, 1, 0) => 2
