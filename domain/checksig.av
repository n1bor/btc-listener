module Checksig
    intent =
        "The four opcodes that check signatures, as far as they can be checked."
        "None of them can be decided in general, and all four can be decided"
        "sometimes, and the stack discipline can always be. That last part is"
        "the reason this is written now rather than with the curve: an opcode"
        "that takes the wrong number of items off the stack is wrong in a way"
        "no signature would reveal, and getting it right is independent of ever"
        "checking one."
        "Two answers need no curve, because the reference client gives them"
        "before it does any arithmetic. An empty signature always fails. So"
        "does a public key that is not a public key. Both are asked of"
        "Domain.Ecdsa, which is where the curve will land."
        "OP_CHECKMULTISIG takes one item more than it uses and throws it away."
        "That is a bug in the original implementation, it has been consensus"
        "since the first Block, and a Script that does not supply the extra"
        "item is invalid. It is reproduced here for the same reason the"
        "SIGHASH_SINGLE bug is reproduced in Domain.Sighash: the chain is full"
        "of Transactions that depend on it."
        "It also charges its public keys against the opcode limit, which is why"
        "a Script can hold fewer multisig checks than it can hold opcodes."
        "The message used to be missing. A signature commits to a Transaction,"
        "and this was handed a stack and nothing else, so even a well formed"
        "signature over a valid key had nothing to be checked against. That gap"
        "is closed: a Domain.SpendContext travels with the run, and when it"
        "carries a spend the message is built from it and handed to"
        "Domain.Ecdsa."
        "So there are now two undecided answers here and the difference"
        "matters. Needing the Transaction means the caller ran a Script on its"
        "own and there is nothing to check against. Needing secp256k1 means"
        "everything is in hand except the arithmetic. The second is the one"
        "a real spend gives, and it is the only thing left between this module"
        "and an answer."
    exposes [step, isSignatureOpcode]
    depends [Domain.Rules, Bytes, Domain.Ecdsa, Domain.Opcode, Domain.ScriptState, Domain.ScriptStep, Domain.SpendContext, Domain.StackItem, Domain.Primitives]
    effects []

fn isSignatureOpcode(code: Int) -> Bool
    ? "The four this module answers for."
    Bool.and(code >= 172, code <= 175)

verify isSignatureOpcode
    isSignatureOpcode(172) => true
    isSignatureOpcode(175) => true
    isSignatureOpcode(171) => false
    isSignatureOpcode(176) => false
    isSignatureOpcode(186) => false

fn step(code: Int, state: State, context: Context) -> Step
    ? "One signature opcode against the machine."
    match code
        172 -> single(code, state, context)
        173 -> single(code, state, context)
        _ -> multiple(code, state, context)

verify step
    step(172, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG needs two items")))
    step(172, Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))
    step(174, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG needs a public key count")))

fn single(code: Int, state: State, context: Context) -> Step
    ? "OP_CHECKSIG and OP_CHECKSIGVERIFY: one signature, one public key."
      "The public key is on top and the signature under it, which is the order"
      "a P2PK or P2PKH Script leaves them in."
    match Domain.ScriptState.topTwo(state.stack, Domain.Opcode.nameOf(code))
        Result.Err(message) -> Step.Stop(Outcome.Decided(Ending.Failed(message)))
        Result.Ok(two) -> singleOn(code, two, state, context)

verify single
    single(172, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG needs two items")))
    single(172, Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))
    single(172, Domain.ScriptState.holding([[2, 3], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))

fn singleOn(code: Int, two: Two, state: State, context: Context) -> Step
    ? "Decide it if it can be decided, and say what is missing if not."
      "A signature that fails for a reason needing no curve is refused first"
      "and never reaches the message, which is the order the reference client"
      "uses and also the only order that works: an empty signature has no hash"
      "type byte to build a message with."
    match refusal(two.second, two.first)
        Option.Some(why) -> answered(code, false, two.rest, state)
        Option.None -> againstMessage(code, two, state, context)

verify singleOn
    singleOn(172, Two(first = [2, 3], second = [4, 5], rest = []), Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))
    singleOn(172, Two(first = validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to"))
    singleOn(173, Two(first = [2, 3], second = [4, 5], rest = []), Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIGVERIFY found a signature that does not check")))

fn againstMessage(code: Int, two: Two, state: State, context: Context) -> Step
    ? "The signature, the key and the message it should have been taken over."
      "Two things can be missing and they are different. Without a spend there"
      "is no message at all, and the answer names the Transaction. With one,"
      "the message is built and handed to Domain.Ecdsa, which still has no"
      "curve -- so the answer names the curve instead. Watching that reason"
      "change is how you can tell this plumbing works before the curve lands."
    match Domain.Ecdsa.hashTypeOf(two.second)
        Result.Err(why) -> Step.Stop(Outcome.Undecided("{Domain.Opcode.nameOf(code)} {why}"))
        Result.Ok(hashType) -> overMessage(code, two, state, Domain.SpendContext.messageFor(context, hashType))

verify againstMessage
    againstMessage(172, Two(first = validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to"))

fn overMessage(code: Int, two: Two, state: State, message: Option<String>) -> Step
    ? "The curve, asked."
      "Without a message there is nothing to ask about and the answer names"
      "the Transaction. With one, the signature, the key and the message go to"
      "Domain.Ecdsa and come back decided."
    match message
        Option.None -> Step.Stop(Outcome.Undecided("{Domain.Opcode.nameOf(code)} needs the transaction its signature commits to"))
        Option.Some(hex) -> ruled(code, two, state, decided(two, hex))

verify overMessage
    overMessage(172, Two(first = validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Option.None) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to"))
    overMessage(172, Two(first = validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Option.Some("00")) => Step.Continue(Domain.ScriptState.holding([[]]))

fn decided(two: Two, messageHex: String) -> Ruling
    ? "The three values a signature check needs, as Bytes."
      "A message that is not hexadecimal cannot happen -- it came from"
      "Domain.Sighash -- so the failure branch answers undecidable rather than"
      "guessing."
    match Bytes.fromHex(messageHex)
        Result.Err(why) -> Domain.Ecdsa.Ruling.Undecidable(why)
        Result.Ok(message) -> Domain.Ecdsa.decide(bytesOf(two.first), bytesOf(two.second), message)

verify decided
    decided(Two(first = validKey(), second = [4, 5], rest = []), "zz") => Domain.Ecdsa.Ruling.Undecidable("Bytes.fromHex: invalid hexadecimal character 'z'")

fn bytesOf(values: List<Int>) -> Bytes
    ? "A stack item as Bytes. Everything on a stack this module sees is bytes"
      "already, so the failure branch is unreachable."
    Result.withDefault(Bytes.fromList(values), Bytes.fromList([]))

verify bytesOf
    Bytes.toList(bytesOf([1, 2])) => [1, 2]

fn ruled(code: Int, two: Two, state: State, ruling: Ruling) -> Step
    ? "The Ruling turned back into a Step. Undecidable stays undecided and"
      "says so in this module's words rather than Domain.Ecdsa's, because the"
      "caller is counting opcodes and not curves."
    match ruling
        Domain.Ecdsa.Ruling.Valid -> answered(code, true, two.rest, state)
        Domain.Ecdsa.Ruling.Invalid(why) -> answered(code, false, two.rest, state)
        Domain.Ecdsa.Ruling.Undecidable(why) -> Step.Stop(Outcome.Undecided("{Domain.Opcode.nameOf(code)} needs secp256k1"))

verify ruled
    ruled(172, Two(first = validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.Ecdsa.Ruling.Undecidable("no")) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs secp256k1"))
    ruled(172, Two(first = [2, 3], second = [4, 5], rest = []), Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.Ecdsa.Ruling.Invalid("no")) => Step.Continue(Domain.ScriptState.holding([[]]))

fn validKey() -> List<Int>
    ? "A public key of the right shape, for the cases above."
      "Its bytes are never looked at beyond the first and the length, because"
      "looking at the rest is what needs a curve."
    List.prepend(2, Domain.ScriptState.zeros(32))

verify validKey
    List.len(validKey()) => 33
    Domain.Ecdsa.isValidPublicKey(validKey()) => true

fn refusal(signature: List<Int>, publicKey: List<Int>) -> Option<String>
    ? "Whether this pair fails for a reason that needs no curve."
      "Some means it definitely fails; None means not on this evidence. The"
      "Valid arm is unreachable -- decideShape has no message and no curve, so"
      "it cannot say a signature is good -- but the type admits it and a"
      "refusal is exactly what Valid is not."
    match Domain.Ecdsa.decideShape(signature, publicKey)
        Domain.Ecdsa.Ruling.Valid -> Option.None
        Domain.Ecdsa.Ruling.Invalid(why) -> Option.Some(why)
        Domain.Ecdsa.Ruling.Undecidable(why) -> Option.None

verify refusal
    refusal([], [2]) => Option.Some("empty signature")
    refusal([4, 5], [2, 3]) => Option.Some("public key is 2 bytes, which is not a public key")
    refusal([4, 5], validKey()) => Option.None

fn answered(code: Int, outcome: Bool, rest: List<List<Int>>, state: State) -> Step
    ? "A check that came out false pushes false, unless the opcode is a VERIFY."
      "OP_CHECKSIG does not fail a Script when the signature is bad. It pushes"
      "false and lets the Script decide what that means, which is what makes"
      "the OP_IF branches in a multisig fallback work."
    match Bool.or(code == 173, code == 175)
        true -> Domain.ScriptStep.stoppedUnless(outcome, "{Domain.Opcode.nameOf(code)} found a signature that does not check", rest, state)
        false -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(oneIf(outcome)), Domain.ScriptState.withStack(state, rest))

verify answered
    answered(172, false, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[]]))
    answered(172, true, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    answered(173, false, [], Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIGVERIFY found a signature that does not check")))
    answered(173, true, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.empty())

fn oneIf(condition: Bool) -> Int
    ? "How Script writes a true or false answer."
    match condition
        true -> 1
        false -> 0

verify oneIf
    oneIf(true) => 1
    oneIf(false) => 0

fn maxKeys() -> Int
    ? "Public keys allowed in one OP_CHECKMULTISIG."
    20

verify maxKeys
    maxKeys() => 20

fn multiple(code: Int, state: State, context: Context) -> Step
    ? "OP_CHECKMULTISIG and OP_CHECKMULTISIGVERIFY."
      "The stack, from the top down: the key count, that many keys, the"
      "signature count, that many signatures, and one item nobody uses."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs a public key count")))
        [head, ..tail] -> withKeyCount(code, Domain.StackItem.asNumber(head), tail, state, context)

verify multiple
    multiple(174, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG needs a public key count")))
    multiple(174, Domain.ScriptState.holding([[], [], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[1]]))
    multiple(174, Domain.ScriptState.holding([[21]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG wants 21 public keys, which is more than 20")))

fn withKeyCount(code: Int, keys: Int, rest: List<List<Int>>, state: State, context: Context) -> Step
    ? "Between nought and twenty keys, and they count against the opcode limit."
    match Bool.or(keys < 0, keys > maxKeys())
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} wants {keys} public keys, which is more than {maxKeys()}")))
        false -> charged(code, keys, rest, state, context)

verify withKeyCount
    withKeyCount(174, 21, [], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG wants 21 public keys, which is more than 20")))
    withKeyCount(174, 0, [[], []], Domain.ScriptState.holding([[], [], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[1]]))

fn charged(code: Int, keys: Int, rest: List<List<Int>>, state: State, context: Context) -> Step
    ? "Each public key is an opcode as far as the limit is concerned."
    limit = Domain.ScriptState.maxOps()
    spent = state.opCount + keys
    match spent > limit
        true -> Step.Stop(Outcome.Decided(Ending.Failed("script uses more than {limit} opcodes")))
        false -> withKeys(code, keys, rest, State(stack = state.stack, alt = state.alt, conditions = state.conditions, opCount = spent), context)

verify charged
    charged(174, 5, [[], []], State(stack = [[], [], []], alt = [], conditions = [], opCount = 200), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("script uses more than 201 opcodes")))
    charged(174, 0, [[], []], Domain.ScriptState.holding([[], [], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(State(stack = [[1]], alt = [], conditions = [], opCount = 0))

fn withKeys(code: Int, keys: Int, rest: List<List<Int>>, state: State, context: Context) -> Step
    ? "Take the keys, then the signature count that sits under them."
    match List.len(rest) < keys + 1
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs {keys} public keys and a signature count")))
        false -> withSigCount(code, keys, List.take(rest, keys), List.drop(rest, keys), state, context)

verify withKeys
    withKeys(174, 3, [[]], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG needs 3 public keys and a signature count")))
    withKeys(174, 0, [[], []], Domain.ScriptState.holding([[], [], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[1]]))

fn withSigCount(code: Int, keys: Int, keyItems: List<List<Int>>, rest: List<List<Int>>, state: State, context: Context) -> Step
    ? "The signature count is the first item under the keys."
    match rest
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs a signature count")))
        [head, ..tail] -> withSigs(code, keys, keyItems, Domain.StackItem.asNumber(head), tail, state, context)

verify withSigCount
    withSigCount(174, 0, [], [], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG needs a signature count")))
    withSigCount(174, 0, [], [[], []], Domain.ScriptState.holding([[], [], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[1]]))

fn withSigs(code: Int, keys: Int, keyItems: List<List<Int>>, sigs: Int, rest: List<List<Int>>, state: State, context: Context) -> Step
    ? "No more signatures than keys, and they have to be on the stack, along"
      "with the item OP_CHECKMULTISIG takes and does not use."
    match Bool.or(sigs < 0, sigs > keys)
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} wants {sigs} signatures for {keys} public keys")))
        false -> withDummy(code, keyItems, sigs, rest, state, context)

verify withSigs
    withSigs(174, 0, [], 1, [[]], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG wants 1 signatures for 0 public keys")))
    withSigs(174, 0, [], 0, [[], []], Domain.ScriptState.holding([[], [], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[1], []]))

fn withDummy(code: Int, keyItems: List<List<Int>>, sigs: Int, rest: List<List<Int>>, state: State, context: Context) -> Step
    ? "One item past the signatures, thrown away, and a Script that does not"
      "supply it is invalid. Everything below it survives."
    consumed = sigs + 1
    match List.len(rest) < consumed
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs {sigs} signatures and the item it discards")))
        false -> decidedMultiple(code, keyItems, List.take(rest, sigs), List.drop(rest, consumed), state, context)

verify withDummy
    withDummy(174, [], 1, [[]], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG needs 1 signatures and the item it discards")))
    withDummy(174, [], 0, [[], []], Domain.ScriptState.holding([[], [], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[1], []]))

fn decidedMultiple(code: Int, keyItems: List<List<Int>>, sigItems: List<List<Int>>, below: List<List<Int>>, state: State, context: Context) -> Step
    ? "No signatures at all succeeds, because there is nothing to check."
      "Anything else goes through the matching below."
    match sigItems
        [] -> answered(code, true, below, state)
        [head, ..tail] -> multiAnswered(code, multiRuling(sigItems, keyItems, context), below, state)

verify decidedMultiple
    decidedMultiple(174, [], [], [], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[1]]))
    decidedMultiple(174, [validKey()], [[]], [], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))
    decidedMultiple(174, [validKey()], [[4, 5]], [], Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Undecided("OP_CHECKMULTISIG needs the transaction its signature commits to"))

fn multiAnswered(code: Int, ruling: Ruling, below: List<List<Int>>, state: State) -> Step
    ? "The whole check, turned back into a Step."
    match ruling
        Domain.Ecdsa.Ruling.Valid -> answered(code, true, below, state)
        Domain.Ecdsa.Ruling.Invalid(why) -> answered(code, false, below, state)
        Domain.Ecdsa.Ruling.Undecidable(why) -> Step.Stop(Outcome.Undecided("{Domain.Opcode.nameOf(code)} needs the transaction its signature commits to"))

verify multiAnswered
    multiAnswered(174, Domain.Ecdsa.Ruling.Valid, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    multiAnswered(174, Domain.Ecdsa.Ruling.Invalid("no"), [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[]]))
    multiAnswered(174, Domain.Ecdsa.Ruling.Undecidable("no"), [], Domain.ScriptState.empty()) => Step.Stop(Outcome.Undecided("OP_CHECKMULTISIG needs the transaction its signature commits to"))

fn multiRuling(sigItems: List<List<Int>>, keyItems: List<List<Int>>, context: Context) -> Ruling
    ? "Signatures against public keys, in order, each key used at most once."
      "This is the reference client's loop and the order is consensus, not"
      "convenience: a signature stays until a key matches it, every key is"
      "spent whether it matched or not, and running out of keys with"
      "signatures still to place fails the whole check. So the signatures must"
      "appear in the same order as the keys that verify them, and a valid set"
      "supplied in the wrong order is invalid."
    match sigItems
        [] -> Domain.Ecdsa.Ruling.Valid
        [head, ..tail] -> multiAgainst(head, tail, keyItems, context)

verify multiRuling
    multiRuling([], [], Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Ecdsa.Ruling.Valid
    multiRuling([[]], [validKey()], Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")

fn multiAgainst(signature: List<Int>, rest: List<List<Int>>, keyItems: List<List<Int>>, context: Context) -> Ruling
    ? "One signature, against the keys that are left."
      "The message is taken once, here, rather than once for every key tried."
      "It is fixed by the signature's hash type and by the Context, and this"
      "loop changes neither: it spends keys. Taking it inside the loop built"
      "the same signature hash once per key, and a signature hash is a whole"
      "modified copy of the Transaction, so a three key check paid for three."
    match keyItems
        [] -> Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")
        [head, ..tail] -> againstKeys(signature, rest, keyItems, context, messageOnce(signature, context))

verify multiAgainst
    multiAgainst([], [], [], Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")
    multiAgainst([], [], [validKey()], Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")

fn messageOnce(signature: List<Int>, context: Context) -> Result<Option<String>, String>
    ? "The message this signature's hash type names, kept for a whole key loop."
      "Err is a hash type the signature does not carry, which refuses the pair"
      "outright; Ok(None) is a Context with no Transaction behind it, which"
      "leaves the pair undecided. The two have to stay apart, which is why"
      "this is a Result of an Option and not either one alone."
    match Domain.Ecdsa.hashTypeOf(signature)
        Result.Err(why) -> Result.Err(why)
        Result.Ok(hashType) -> Result.Ok(Domain.SpendContext.messageFor(context, hashType))

verify messageOnce
    messageOnce([], Domain.SpendContext.bare(Domain.Rules.latest())) => Result.Err("signature is empty and has no hash type")
    messageOnce([4, 5], Domain.SpendContext.bare(Domain.Rules.latest())) => Result.Ok(Option.None)

fn againstKeys(signature: List<Int>, rest: List<List<Int>>, keyItems: List<List<Int>>, context: Context, message: Result<Option<String>, String>) -> Ruling
    ? "The key loop proper, carrying the message it does not change."
    match keyItems
        [] -> Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")
        [head, ..tail] -> multiAdvanced(ruledWith(signature, head, message), signature, rest, tail, context, message)

verify againstKeys
    againstKeys([], [], [], Domain.SpendContext.bare(Domain.Rules.latest()), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")
    againstKeys([], [], [validKey()], Domain.SpendContext.bare(Domain.Rules.latest()), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")

fn ruledWith(signature: List<Int>, publicKey: List<Int>, message: Result<Option<String>, String>) -> Ruling
    ? "One pair, with the message already in hand."
      "The shape is still asked first, so a signature the reference client"
      "refuses before any arithmetic never reaches the curve."
    match Domain.Ecdsa.decideShape(signature, publicKey)
        Domain.Ecdsa.Ruling.Valid -> Domain.Ecdsa.Ruling.Valid
        Domain.Ecdsa.Ruling.Invalid(why) -> Domain.Ecdsa.Ruling.Invalid(why)
        Domain.Ecdsa.Ruling.Undecidable(why) -> overMessageOrWhy(signature, publicKey, message)

verify ruledWith
    ruledWith([], validKey(), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Invalid("empty signature")
    ruledWith([4, 5], validKey(), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Undecidable("no transaction to take a message from")
    ruledWith([4, 5], validKey(), Result.Err("signature is empty and has no hash type")) => Domain.Ecdsa.Ruling.Invalid("signature is empty and has no hash type")

fn overMessageOrWhy(signature: List<Int>, publicKey: List<Int>, message: Result<Option<String>, String>) -> Ruling
    ? "A hash type that was never there refuses the pair; anything else asks the curve."
    match message
        Result.Err(why) -> Domain.Ecdsa.Ruling.Invalid(why)
        Result.Ok(found) -> overOneMessage(signature, publicKey, found)

verify overMessageOrWhy
    overMessageOrWhy([4, 5], validKey(), Result.Err("no hash type")) => Domain.Ecdsa.Ruling.Invalid("no hash type")
    overMessageOrWhy([4, 5], validKey(), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Undecidable("no transaction to take a message from")

fn multiAdvanced(ruling: Ruling, signature: List<Int>, rest: List<List<Int>>, keyRest: List<List<Int>>, context: Context, message: Result<Option<String>, String>) -> Ruling
    ? "A key is spent either way. The signature is only spent when it matched."
    match ruling
        Domain.Ecdsa.Ruling.Valid -> multiRuling(rest, keyRest, context)
        Domain.Ecdsa.Ruling.Invalid(why) -> againstKeys(signature, rest, keyRest, context, message)
        Domain.Ecdsa.Ruling.Undecidable(why) -> Domain.Ecdsa.Ruling.Undecidable(why)

verify multiAdvanced
    multiAdvanced(Domain.Ecdsa.Ruling.Valid, [], [], [], Domain.SpendContext.bare(Domain.Rules.latest()), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Valid
    multiAdvanced(Domain.Ecdsa.Ruling.Undecidable("no"), [], [], [], Domain.SpendContext.bare(Domain.Rules.latest()), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Undecidable("no")
    multiAdvanced(Domain.Ecdsa.Ruling.Invalid("no"), [], [], [], Domain.SpendContext.bare(Domain.Rules.latest()), Result.Ok(Option.None)) => Domain.Ecdsa.Ruling.Invalid("more signatures than public keys that answer them")

fn oneRuling(signature: List<Int>, publicKey: List<Int>, context: Context) -> Ruling
    ? "One pair. The shape is asked first, exactly as it is for OP_CHECKSIG,"
      "so a signature the reference client refuses before any arithmetic never"
      "reaches the curve and never needs a Transaction."
    match Domain.Ecdsa.decideShape(signature, publicKey)
        Domain.Ecdsa.Ruling.Valid -> Domain.Ecdsa.Ruling.Valid
        Domain.Ecdsa.Ruling.Invalid(why) -> Domain.Ecdsa.Ruling.Invalid(why)
        Domain.Ecdsa.Ruling.Undecidable(why) -> overOne(signature, publicKey, context)

verify oneRuling
    oneRuling([], validKey(), Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Ecdsa.Ruling.Invalid("empty signature")
    oneRuling([4, 5], validKey(), Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Ecdsa.Ruling.Undecidable("no transaction to take a message from")

fn overOne(signature: List<Int>, publicKey: List<Int>, context: Context) -> Ruling
    ? "The message this signature's hash type names, and then the curve."
    match Domain.Ecdsa.hashTypeOf(signature)
        Result.Err(why) -> Domain.Ecdsa.Ruling.Invalid(why)
        Result.Ok(hashType) -> overOneMessage(signature, publicKey, Domain.SpendContext.messageFor(context, hashType))

verify overOne
    overOne([4, 5], validKey(), Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Ecdsa.Ruling.Undecidable("no transaction to take a message from")

fn overOneMessage(signature: List<Int>, publicKey: List<Int>, message: Option<String>) -> Ruling
    ? "Undecidable without a Transaction, decided with one."
    match message
        Option.None -> Domain.Ecdsa.Ruling.Undecidable("no transaction to take a message from")
        Option.Some(hex) -> decided(Two(first = publicKey, second = signature, rest = []), hex)

verify overOneMessage
    overOneMessage([4, 5], validKey(), Option.None) => Domain.Ecdsa.Ruling.Undecidable("no transaction to take a message from")
