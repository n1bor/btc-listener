module Checksig
    intent =
        "The four opcodes that check signatures, as far as they can be checked."
        "None of them can be decided in general, and all four can be decided"
        "sometimes, and the stack discipline can always be. That last part is"
        "the reason this is written now rather than with the curve: an opcode"
        "that takes the wrong number of items off the stack is wrong in a way"
        "no signature would reveal, and getting it right is independent of ever"
        "checking one."
        "Two answers need no curve, because the reference client gives them"
        "before it does any arithmetic. An empty signature always fails. So"
        "does a public key that is not a public key. Both are asked of"
        "Domain.Ecdsa, which is where the curve will land."
        "OP_CHECKMULTISIG takes one item more than it uses and throws it away."
        "That is a bug in the original implementation, it has been consensus"
        "since the first Block, and a Script that does not supply the extra"
        "item is invalid. It is reproduced here for the same reason the"
        "SIGHASH_SINGLE bug is reproduced in Domain.Sighash: the chain is full"
        "of Transactions that depend on it."
        "It also charges its public keys against the opcode limit, which is why"
        "a Script can hold fewer multisig checks than it can hold opcodes."
        "The message used to be missing. A signature commits to a Transaction,"
        "and this was handed a stack and nothing else, so even a well formed"
        "signature over a valid key had nothing to be checked against. That gap"
        "is closed: a Domain.SpendContext travels with the run, and when it"
        "carries a spend the message is built from it and handed to"
        "Domain.Ecdsa."
        "So there are now two undecided answers here and the difference"
        "matters. Needing the Transaction means the caller ran a Script on its"
        "own and there is nothing to check against. Needing secp256k1 means"
        "everything is in hand except the arithmetic. The second is the one"
        "a real spend gives, and it is the only thing left between this module"
        "and an answer."
    exposes [step, isSignatureOpcode, answersFor]
    depends [Domain.Rules, Domain.Tapsig, Bytes, Domain.Checkwork, Domain.Multisig, Domain.Ecdsa, Domain.Opcode, Domain.ScriptState, Domain.ScriptStep, Domain.SpendContext, Domain.StackItem, Domain.Primitives]
    effects []

fn answersFor(code: Int, context: Context) -> Bool
    ? "Which opcodes this module answers for, which depends on the version."
      "OP_CHECKSIGADD exists only in tapscript. Below it the opcode is"
      "undefined and running it makes the Script invalid, which is what"
      "Domain.Opcode already says -- so it must not be routed here outside a"
      "tapscript, or a pre-Taproot Script would quietly gain an opcode."
    match Domain.SpendContext.sigVersionOf(context)
        Domain.SpendContext.SigVersion.Tapscript -> Bool.or(isSignatureOpcode(code), code == 186)
        Domain.SpendContext.SigVersion.Base -> isSignatureOpcode(code)
        Domain.SpendContext.SigVersion.WitnessV0 -> isSignatureOpcode(code)

verify answersFor
    answersFor(172, Domain.SpendContext.bare(Domain.Rules.latest())) => true
    answersFor(186, Domain.SpendContext.bare(Domain.Rules.latest())) => false
    answersFor(186, Domain.Tapsig.spending()) => true
    answersFor(81, Domain.Tapsig.spending()) => false

fn isSignatureOpcode(code: Int) -> Bool
    ? "The four this module answers for."
    Bool.and(code >= 172, code <= 175)

verify isSignatureOpcode
    isSignatureOpcode(172) => true
    isSignatureOpcode(175) => true
    isSignatureOpcode(171) => false
    isSignatureOpcode(176) => false
    isSignatureOpcode(186) => false

fn step(code: Int, state: State, context: Context) -> Step
    ? "One signature opcode against the machine."
    match Domain.SpendContext.sigVersionOf(context)
        Domain.SpendContext.SigVersion.Tapscript -> tapscriptStep(code, state, context)
        Domain.SpendContext.SigVersion.Base -> legacyStep(code, state, context)
        Domain.SpendContext.SigVersion.WitnessV0 -> legacyStep(code, state, context)

fn legacyStep(code: Int, state: State, context: Context) -> Step
    ? "One signature opcode under the two older signature versions."
    match code
        172 -> single(code, state, context)
        173 -> single(code, state, context)
        _ -> Domain.Multisig.multiple(code, state, context)

verify legacyStep
    legacyStep(172, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG needs two items")))

fn tapscriptStep(code: Int, state: State, context: Context) -> Step
    ? "BIP342 kept two of these, added one and removed two."
      "OP_CHECKMULTISIG and OP_CHECKMULTISIGVERIFY were removed rather than"
      "left alone: their batch validation cannot be counted in advance, which"
      "the weight budget needs, and OP_CHECKSIGADD does the same job as a sum."
    match code
        172 -> tapscriptSingle(code, state, context)
        173 -> tapscriptSingle(code, state, context)
        186 -> Domain.Tapsig.added(state, context)
        _ -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} does not exist in tapscript")))

verify tapscriptStep
    tapscriptStep(174, Domain.ScriptState.empty(), Domain.Tapsig.spending()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG does not exist in tapscript")))
    tapscriptStep(175, Domain.ScriptState.empty(), Domain.Tapsig.spending()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIGVERIFY does not exist in tapscript")))

fn tapscriptSingle(code: Int, state: State, context: Context) -> Step
    ? "The two items OP_CHECKSIG works on, then BIP342's rules over them."
    match Domain.ScriptState.topTwo(state.stack, Domain.Opcode.nameOf(code))
        Result.Err(why) -> Step.Stop(Outcome.Decided(Ending.Failed(why)))
        Result.Ok(two) -> Domain.Tapsig.checked(code, two, state, context)

verify tapscriptSingle
    tapscriptSingle(172, Domain.ScriptState.empty(), Domain.Tapsig.spending()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG needs two items")))

verify step
    step(172, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG needs two items")))
    step(172, Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))
    step(174, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKMULTISIG needs a public key count")))

fn single(code: Int, state: State, context: Context) -> Step
    ? "OP_CHECKSIG and OP_CHECKSIGVERIFY: one signature, one public key."
      "The public key is on top and the signature under it, which is the order"
      "a P2PK or P2PKH Script leaves them in."
    match Domain.ScriptState.topTwo(state.stack, Domain.Opcode.nameOf(code))
        Result.Err(message) -> Step.Stop(Outcome.Decided(Ending.Failed(message)))
        Result.Ok(two) -> singleOn(code, two, state, context)

verify single
    single(172, Domain.ScriptState.empty(), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG needs two items")))
    single(172, Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))
    single(172, Domain.ScriptState.holding([[2, 3], []]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))

fn singleOn(code: Int, two: Two, state: State, context: Context) -> Step
    ? "Decide it if it can be decided, and say what is missing if not."
      "A signature that fails for a reason needing no curve is refused first"
      "and never reaches the message, which is the order the reference client"
      "uses and also the only order that works: an empty signature has no hash"
      "type byte to build a message with."
    match Domain.Checkwork.refusal(two.second, two.first)
        Option.Some(why) -> Domain.Checkwork.answered(code, false, two.rest, state)
        Option.None -> againstMessage(code, two, state, context)

verify singleOn
    singleOn(172, Two(first = [2, 3], second = [4, 5], rest = []), Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Continue(Domain.ScriptState.holding([[]]))
    singleOn(172, Two(first = Domain.Checkwork.validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to"))
    singleOn(173, Two(first = [2, 3], second = [4, 5], rest = []), Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIGVERIFY found a signature that does not check")))

fn againstMessage(code: Int, two: Two, state: State, context: Context) -> Step
    ? "The signature, the key and the message it should have been taken over."
      "The signature is deleted from the Script code first -- Bitcoin's"
      "FindAndDelete -- so that what it commits to never includes itself."
      "Two things can be missing and they are different. Without a spend there"
      "is no message at all, and the answer names the Transaction. With one,"
      "the message is built and handed to Domain.Ecdsa, which still has no"
      "curve -- so the answer names the curve instead. Watching that reason"
      "change is how you can tell this plumbing works before the curve lands."
    match Domain.Ecdsa.hashTypeOf(two.second)
        Result.Err(why) -> Step.Stop(Outcome.Undecided("{Domain.Opcode.nameOf(code)} {why}"))
        Result.Ok(hashType) -> pastDeletion(code, two, state, context, hashType)

verify againstMessage
    againstMessage(172, Two(first = Domain.Checkwork.validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.SpendContext.bare(Domain.Rules.latest())) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to"))

fn pastDeletion(code: Int, two: Two, state: State, context: Context, hashType: Int) -> Step
    ? "CONST_SCRIPTCODE refuses a Script whose FindAndDelete actually bit."
      "Not the presence of the deletion but its effect: Core keeps the count"
      "FindAndDelete returns and fails only when it is above zero, so a"
      "signature that does not appear in the Script it signs -- which is very"
      "nearly all of them -- is untouched by the flag."
      "It fails the whole Script rather than pushing false. That is the"
      "difference between this and Domain.Checkwork.refusal, which is about"
      "a pair that does not check; here the Script code itself is the thing"
      "objected to and no answer about the signature is reached."
    match Bool.and(Domain.SpendContext.rulesOf(context).policy.constScriptCode, Domain.SpendContext.deletes(context, [two.second]))
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} deletes its own signature from the script, which CONST_SCRIPTCODE forbids")))
        false -> overMessage(code, two, state, Domain.SpendContext.messageFor(Domain.SpendContext.withoutSignatures(context, [two.second]), hashType))

verify pastDeletion
    pastDeletion(172, Two(first = Domain.Checkwork.validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.SpendContext.bare(Domain.Rules.latest()), 1) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to"))
    pastDeletion(172, Two(first = Domain.Checkwork.validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.SpendContext.committed(Domain.Rules.underFlags(["CONST_SCRIPTCODE"]), Domain.SpendContext.emptyTransaction(), 0, 5, "5102040552", []), 1) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG deletes its own signature from the script, which CONST_SCRIPTCODE forbids")))

fn overMessage(code: Int, two: Two, state: State, message: Option<String>) -> Step
    ? "The curve, asked."
      "Without a message there is nothing to ask about and the answer names"
      "the Transaction. With one, the signature, the key and the message go to"
      "Domain.Ecdsa and come back decided."
    match message
        Option.None -> Step.Stop(Outcome.Undecided("{Domain.Opcode.nameOf(code)} needs the transaction its signature commits to"))
        Option.Some(hex) -> ruled(code, two, state, Domain.Checkwork.decided(two, hex))

verify overMessage
    overMessage(172, Two(first = Domain.Checkwork.validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Option.None) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to"))
    overMessage(172, Two(first = Domain.Checkwork.validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Option.Some("00")) => Step.Continue(Domain.ScriptState.holding([[]]))

fn ruled(code: Int, two: Two, state: State, ruling: Ruling) -> Step
    ? "The Ruling turned back into a Step. Undecidable stays undecided and"
      "says so in this module's words rather than Domain.Ecdsa's, because the"
      "caller is counting opcodes and not curves."
    match ruling
        Domain.Ecdsa.Ruling.Valid -> Domain.Checkwork.answered(code, true, two.rest, state)
        Domain.Ecdsa.Ruling.Invalid(why) -> Domain.Checkwork.answered(code, false, two.rest, state)
        Domain.Ecdsa.Ruling.Undecidable(why) -> Step.Stop(Outcome.Undecided("{Domain.Opcode.nameOf(code)} needs secp256k1"))

verify ruled
    ruled(172, Two(first = Domain.Checkwork.validKey(), second = [4, 5], rest = []), Domain.ScriptState.holding([[]]), Domain.Ecdsa.Ruling.Undecidable("no")) => Step.Stop(Outcome.Undecided("OP_CHECKSIG needs secp256k1"))
    ruled(172, Two(first = [2, 3], second = [4, 5], rest = []), Domain.ScriptState.holding([[2, 3], [4, 5]]), Domain.Ecdsa.Ruling.Invalid("no")) => Step.Continue(Domain.ScriptState.holding([[]]))
