module Policy
    intent =
        "The rules a node applies over and above what the chain enforces."
        "Bitcoin Core does not run a Script under a Height; it runs one under a"
        "set of verification flags. Some of those flags are soft forks and have"
        "a Height -- P2SH, SegWit, the two timelock opcodes, BIP147, Taproot --"
        "and those live in Domain.Rules where a Height can answer for them. The"
        "rest are Policy: a Transaction they refuse may still be perfectly"
        "valid, and the Blocks are full of ones that are."
        "That difference is the whole reason this module is separate. A Policy"
        "rule folded into Domain.Rules would be asked at a Height and answered"
        "yes, and the auditor would then reject Transactions that are in the"
        "chain. n1bor/btc-listener#52 says this is the one outcome that must"
        "not happen, so the split is structural rather than a convention: an"
        "auditor builds Rules from a Height and gets none() by construction,"
        "and only a caller that names flags can get anything else."
        "Core's own names are used verbatim, because the corpora are written"
        "in them and a case that says CONST_SCRIPTCODE should be readable"
        "against the line in tx_invalid.json that says the same. The mapping"
        "from name to field is the only place the two vocabularies meet."
        "Eight rules so far. Core has eighteen flag names and some of"
        "them have no field here yet, which is deliberate rather than"
        "unfinished: a field nothing reads is a rule nothing enforces dressed"
        "up as one. An unmodelled flag simply leaves the engine lenient, so a"
        "corpus case that turns on one disagrees with Core, and that"
        "disagreement is the honest record of the gap. The record grows one"
        "field at a time as each rule is actually implemented."
        "BIP147 null dummy is not here and belongs in Domain.Rules, because it"
        "has a Height: it became consensus with SegWit on every Network. Core"
        "has a flag for it because Core has a flag for everything, but a rule"
        "the chain obeys from a Block onwards is a soft fork, and putting it"
        "here would make Domain.Rules.at unable to answer for it."
    exposes [Policy, none, every, named, exceptNamed, asks]
    depends []
    effects []

record Policy
    constScriptCode: Bool
    minimalData: Bool
    discourageUpgradableNops: Bool
    sigPushOnly: Bool
    nullFail: Bool
    minimalIf: Bool
    witnessPubKeyType: Bool
    discourageUpgradableWitness: Bool

fn none() -> Policy
    ? "No Policy rule in force: what a Block was mined under."
      "The default everywhere the engine reads the chain. Domain.Rules.at"
      "returns this and has no way to return anything else, which is what"
      "keeps an audit honest."
    Policy(constScriptCode = false, minimalData = false, discourageUpgradableNops = false, sigPushOnly = false, nullFail = false, minimalIf = false, witnessPubKeyType = false, discourageUpgradableWitness = false)

verify none
    none().constScriptCode => false
    none().minimalData => false
    none().discourageUpgradableNops => false
    none().sigPushOnly => false
    none().nullFail => false
    none().minimalIf => false
    none().witnessPubKeyType => false
    none().discourageUpgradableWitness => false

fn every() -> Policy
    ? "Every Policy rule this module models, in force."
      "What Core's tx_valid.json means by an empty flag list, since that"
      "corpus names the flags to leave out rather than the ones to apply."
    Policy(constScriptCode = true, minimalData = true, discourageUpgradableNops = true, sigPushOnly = true, nullFail = true, minimalIf = true, witnessPubKeyType = true, discourageUpgradableWitness = true)

verify every
    every().constScriptCode => true
    every().minimalData => true
    every().discourageUpgradableNops => true
    every().sigPushOnly => true
    every().nullFail => true
    every().minimalIf => true
    every().witnessPubKeyType => true
    every().discourageUpgradableWitness => true
    every() => named(["CONST_SCRIPTCODE", "MINIMALDATA", "DISCOURAGE_UPGRADABLE_NOPS", "SIGPUSHONLY", "NULLFAIL", "MINIMALIF", "WITNESS_PUBKEYTYPE", "DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM"])

fn named(flags: List<String>) -> Policy
    ? "The rules Core's flag names ask for, and no others."
      "How script_tests.json and tx_invalid.json are read: the list is the"
      "flags passed to VerifyScript, so a name absent means the rule is off."
    Policy(constScriptCode = asks(flags, "CONST_SCRIPTCODE"), minimalData = asks(flags, "MINIMALDATA"), discourageUpgradableNops = asks(flags, "DISCOURAGE_UPGRADABLE_NOPS"), sigPushOnly = asks(flags, "SIGPUSHONLY"), nullFail = asks(flags, "NULLFAIL"), minimalIf = asks(flags, "MINIMALIF"), witnessPubKeyType = asks(flags, "WITNESS_PUBKEYTYPE"), discourageUpgradableWitness = asks(flags, "DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM"))

verify named
    named([]) => none()
    named(["NONE"]) => none()
    named(["CONST_SCRIPTCODE"]).constScriptCode => true
    named(["CONST_SCRIPTCODE"]).minimalData => false
    named(["MINIMALDATA"]).minimalData => true
    named(["DISCOURAGE_UPGRADABLE_NOPS"]).discourageUpgradableNops => true
    named(["SIGPUSHONLY"]).sigPushOnly => true
    named(["NULLFAIL"]).nullFail => true
    named(["MINIMALIF"]).minimalIf => true
    named(["WITNESS_PUBKEYTYPE"]).witnessPubKeyType => true
    named(["DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM"]).discourageUpgradableWitness => true
    named(["NULLDUMMY"]) => none()
    named(["P2SH", "WITNESS"]) => none()

fn exceptNamed(flags: List<String>) -> Policy
    ? "Every rule except the ones Core's flag names list."
      "tx_valid.json is read this way and it is not a stylistic difference:"
      "src/test/transaction_tests.cpp calls CheckTxScripts with ~verify_flags"
      "there and with verify_flags in tx_invalid.json. So the same word means"
      "opposite things in the two files, and a tool that treated them alike"
      "would be running half the corpus under rules Core never applied to it."
    Policy(constScriptCode = asks(flags, "CONST_SCRIPTCODE") == false, minimalData = asks(flags, "MINIMALDATA") == false, discourageUpgradableNops = asks(flags, "DISCOURAGE_UPGRADABLE_NOPS") == false, sigPushOnly = asks(flags, "SIGPUSHONLY") == false, nullFail = asks(flags, "NULLFAIL") == false, minimalIf = asks(flags, "MINIMALIF") == false, witnessPubKeyType = asks(flags, "WITNESS_PUBKEYTYPE") == false, discourageUpgradableWitness = asks(flags, "DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM") == false)

verify exceptNamed
    exceptNamed([]) => every()
    exceptNamed(["CONST_SCRIPTCODE", "MINIMALDATA", "DISCOURAGE_UPGRADABLE_NOPS", "SIGPUSHONLY", "NULLFAIL", "MINIMALIF", "WITNESS_PUBKEYTYPE", "DISCOURAGE_UPGRADABLE_WITNESS_PROGRAM"]) => none()
    exceptNamed(["CONST_SCRIPTCODE"]).constScriptCode => false
    exceptNamed(["CONST_SCRIPTCODE"]).minimalData => true
    exceptNamed(["MINIMALDATA"]).minimalData => false
    exceptNamed(["SIGPUSHONLY"]).sigPushOnly => false
    exceptNamed(["SIGPUSHONLY"]).discourageUpgradableNops => true
    exceptNamed(["DERSIG", "LOW_S", "STRICTENC", "NULLDUMMY"]).constScriptCode => true

fn asks(flags: List<String>, name: String) -> Bool
    ? "Whether Core's flag list names this rule."
      "NONE is Core's word for the empty set and is not a flag, so it names"
      "nothing and needs no special case here -- it simply matches no field."
    List.contains(flags, name)

verify asks
    asks([], "NULLDUMMY") => false
    asks(["NULLDUMMY"], "NULLDUMMY") => true
    asks(["NONE"], "NULLDUMMY") => false
    asks(["P2SH", "NULLDUMMY"], "NULLDUMMY") => true
