module Connect
    intent =
        "What connecting a Block does to the UTXO Set, and whether it is"
        "allowed to."
        "Three rules, and none of them is about signatures. Every Input has to"
        "find an unspent Output it is allowed to spend; no Transaction may pay"
        "out more than it takes in; and the coinbase may claim no more than"
        "the subsidy plus what the other Transactions left behind. Whether the"
        "spender was entitled needs the Script engine, which is not reached"
        "from here and is not reached from anywhere on the connect path: this"
        "module has no Script dependency, so a Block's signatures are checked"
        "by audit and never when the Block is connected to the Set."
        "That is worth stating plainly because it is easy to assume the"
        "opposite (#303), and because the Assume-valid Height sounds like the"
        "switch that turns it on and is not -- it says which range audit may"
        "be taken to have settled. ADR 0007 is the reasoning."
        "Six consensus rules are deferred with it, and CONTEXT.md lists them"
        "under Deferred consensus rules with the reason: BIP34, block weight,"
        "sigop cost, IsFinalTx, BIP68 sequence locks and BIP113. Every one of"
        "them needs a Peer willing to spend real proof of work before it"
        "could matter, which #281 now requires before a Header is placed at"
        "all, so the exposure is a false CLEAN from audit on a"
        "hypothetically-mined bad Block rather than anything a Peer can do."
        "A Transaction may spend an Output made earlier in the same Block, so"
        "the walk carries what the Block has created so far and looks there"
        "before it looks at what the Store resolved. Getting that wrong in"
        "either direction is a consensus bug: refusing them would reject real"
        "Blocks, and letting a Transaction spend an Output made *later* in its"
        "own Block would accept invented value."
        "An Output created and spent inside one Block appears in neither"
        "answer. It must not be left in the Set, and it must not be in the"
        "Undo Data either -- restoring it on a disconnect would put back"
        "something that never existed before this Block."
    exposes [Change, Connecting, TxFee, connected, paidBy, createdBy, outpointKey]
    depends [Bytes, Domain.Network, Domain.Subsidy, Domain.Transaction, Domain.UtxoStore]
    effects []

record TxFee
    txid: String
    fee: Int
    coinbase: Bool

record Change
    added: List<Unspent>
    removed: List<Unspent>
    fees: Int
    confirmed: List<TxFee>

type Connecting
    Applied(Change)
    Refused(String)

record Building
    created: Map<Bytes, Unspent>
    spent: Map<Bytes, Bool>
    removed: List<Unspent>
    fees: Int
    confirmed: List<TxFee>

fn outpointKey(txid: String, index: Int) -> Result<Bytes, String>
    ? "How an Input names the Output it spends."
      "Domain.UtxoStore's key, so the Map the walk carries and the Store are"
      "keyed alike and a lookup reads the same in both."
    Domain.UtxoStore.unspentKey(txid, index)

verify outpointKey
    outpointKey("aa", 0) => Domain.UtxoStore.unspentKey("aa", 0)
    outpointKey("aa", 12) => Domain.UtxoStore.unspentKey("aa", 12)

fn paidBy(transaction: Transaction) -> Int
    ? "Everything a Transaction pays out."
    paidInto(transaction.outputs, 0)

verify paidBy
    paidBy(Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "aa", size = 0, isSegWit = false)) => 0
    paidBy(Transaction(version = 1, inputs = [], outputs = [Output(value = 5, script = "")], lockTime = 0, txid = "aa", size = 0, isSegWit = false)) => 5
    paidBy(Transaction(version = 1, inputs = [], outputs = [Output(value = 5, script = ""), Output(value = 7, script = "")], lockTime = 0, txid = "aa", size = 0, isSegWit = false)) => 12

fn paidInto(outputs: List<Output>, acc: Int) -> Int
    ? "One Output's value at a time."
    match outputs
        [] -> acc
        [head, ..tail] -> paidInto(tail, acc + head.value)

verify paidInto
    paidInto([], 0) => 0
    paidInto([Output(value = 5, script = "")], 0) => 5
    paidInto([Output(value = 5, script = "")], 2) => 7

fn createdBy(transaction: Transaction, height: Int, coinbase: Bool) -> Result<List<Unspent>, String>
    ? "The Outputs a Transaction adds to the Set, in position order."
      "The Transaction Id and each Script are parsed from the decoder's"
      "hexadecimal once, here (#234); everything downstream -- the key, the"
      "entry, the Undo Data -- takes the bytes as they are. A Result because"
      "parsing can refuse, though what the decoder wrote never does."
    createdInto(Bytes.fromHex(transaction.txid)?, transaction.outputs, height, coinbase, 0, [])

verify createdBy
    createdBy(Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "aa", size = 0, isSegWit = false), 7, false) => Result.Ok([])
    List.len(createdBy(Transaction(version = 1, inputs = [], outputs = [Output(value = 5, script = "76"), Output(value = 7, script = "")], lockTime = 0, txid = "aa", size = 0, isSegWit = false), 7, false)?) => 2
    createdBy(Transaction(version = 1, inputs = [], outputs = [Output(value = 5, script = "76")], lockTime = 0, txid = "aa", size = 0, isSegWit = true), 7, true) => Result.Ok([Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.fromList([118]), height = 7, coinbase = true)])
    createdBy(Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "zz", size = 0, isSegWit = false), 7, false) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn createdInto(txid: Bytes, outputs: List<Output>, height: Int, coinbase: Bool, index: Int, acc: List<Unspent>) -> Result<List<Unspent>, String>
    ? "One Output at a time, counting positions as it goes."
    match outputs
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> createdInto(txid, tail, height, coinbase, index + 1, keptIfSpendable(txid, index, head, height, coinbase, acc)?)

verify createdInto
    createdInto(Bytes.fromList([170]), [], 0, false, 0, []) => Result.Ok([])
    List.len(createdInto(Bytes.fromList([170]), [Output(value = 5, script = "")], 0, false, 0, [])?) => 1
    createdInto(Bytes.fromList([170]), [Output(value = 5, script = "")], 3, true, 2, []) => Result.Ok([Unspent(txid = Bytes.fromList([170]), index = 2, value = 5, script = Bytes.empty(), height = 3, coinbase = true)])
    createdInto(Bytes.fromList([170]), [Output(value = 5, script = "zz")], 3, true, 2, []) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn keptIfSpendable(txid: Bytes, index: Int, output: Output, height: Int, coinbase: Bool, acc: List<Unspent>) -> Result<List<Unspent>, String>
    ? "An Output nothing can ever spend never enters the Set."
    match Domain.UtxoStore.neverSpendable(output.script)
        true -> Result.Ok(acc)
        false -> Result.Ok(List.prepend(Unspent(txid = txid, index = index, value = output.value, script = Bytes.fromHex(output.script)?, height = height, coinbase = coinbase), acc))

verify keptIfSpendable
    keptIfSpendable(Bytes.fromList([170]), 0, Output(value = 0, script = "6a24aa21a9ed"), 7, true, []) => Result.Ok([])
    keptIfSpendable(Bytes.fromList([170]), 1, Output(value = 5, script = "51"), 7, false, []) => Result.Ok([Unspent(txid = Bytes.fromList([170]), index = 1, value = 5, script = Bytes.fromList([81]), height = 7, coinbase = false)])

fn connected(network: Network, height: Int, transactions: List<Transaction>, fromStore: Map<Bytes, Unspent>) -> Connecting
    ? "What this Block does to the Set, or why it may not."
      "The first Transaction is the coinbase and is not asked to find its"
      "Inputs; every other one is. Its claim is checked last, because it can"
      "only be judged once the fees the rest of the Block left behind are"
      "known."
    match transactions
        [] -> Connecting.Refused("a Block must hold at least a coinbase")
        [coinbase, ..rest] -> withCoinbase(network, height, coinbase, rest, fromStore)

verify connected
    connected(Network.Mainnet, 0, [], Map.fromList([])) => Connecting.Refused("a Block must hold at least a coinbase")
    List.len(added(connected(Network.Mainnet, 1, [minting(50), paying("a1", "aa", 0, 90), paying("a2", "a1", 0, 80)], holding()?))) => 2
    List.len(removedBy(connected(Network.Mainnet, 1, [minting(50), paying("a1", "aa", 0, 90), paying("a2", "a1", 0, 80)], holding()?))) => 1
    feesOf(connected(Network.Mainnet, 1, [minting(50), paying("a1", "aa", 0, 90), paying("a2", "a1", 0, 80)], holding()?)) => 20
    connected(Network.Mainnet, 1, [minting(50), paying("a1", "aa", 0, 90), paying("a2", "aa", 0, 80)], holding()?) => Connecting.Refused("Input names Output 0 of aa, which this Block has already spent")
    connected(Network.Mainnet, 1, [minting(50), paying("a1", "a2", 0, 90), paying("a2", "aa", 0, 80)], holding()?) => Connecting.Refused("Input names Output 0 of a2, which is not an unspent Output")
    connected(Network.Mainnet, 50, [minting(50), paying("a1", "cc", 0, 90)], holding()?) => Connecting.Refused("Input names Output 0 of cc, a coinbase Output from Height 1 that is not spendable until 101")
    feesOf(connected(Network.Mainnet, 101, [minting(50), paying("a1", "cc", 0, 90)], holding()?)) => 10
    connected(Network.Mainnet, 1, [minting(5000000000)], Map.fromList([])) => Connecting.Applied(Change(added = [Unspent(txid = Bytes.fromList([203]), index = 0, value = 5000000000, script = Bytes.empty(), height = 1, coinbase = true)], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)]))
    connected(Network.Mainnet, 1, [minting(5000000001)], Map.fromList([])) => Connecting.Refused("coinbase claims 5000000001 with 5000000000 allowed")
    connected(Network.Mainnet, 1, [minting(4000000000)], Map.fromList([])) => Connecting.Applied(Change(added = [Unspent(txid = Bytes.fromList([203]), index = 0, value = 4000000000, script = Bytes.empty(), height = 1, coinbase = true)], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)]))

fn withCoinbase(network: Network, height: Int, coinbase: Transaction, rest: List<Transaction>, fromStore: Map<Bytes, Unspent>) -> Connecting
    ? "The rest of the Block first, then what the coinbase is owed."
    settled(network, height, coinbase, walkedFrom(seeded(coinbase, height), rest, height, fromStore))

verify withCoinbase
    withCoinbase(Network.Mainnet, 1, minting(5000000000), [], Map.fromList([])) => Connecting.Applied(Change(added = [Unspent(txid = Bytes.fromList([203]), index = 0, value = 5000000000, script = Bytes.empty(), height = 1, coinbase = true)], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)]))
    withCoinbase(Network.Mainnet, 1, minting(6000000000), [], Map.fromList([])) => Connecting.Refused("coinbase claims 6000000000 with 5000000000 allowed")

fn walkedFrom(start: Result<Building, String>, rest: List<Transaction>, height: Int, fromStore: Map<Bytes, Unspent>) -> Result<Building, String>
    ? "The walk, from the coinbase's Outputs, unless those had no key."
    match start
        Result.Err(why) -> Result.Err(why)
        Result.Ok(begun) -> walked(rest, height, fromStore, begun.created, begun.spent, begun.removed, begun.fees, begun.confirmed)

verify walkedFrom
    walkedFrom(Result.Err("no"), [], 1, holding()?) => Result.Err("no")
    walkedFrom(seeded(minting(50), 1), [paying("a1", "aa", 0, 90)], 1, holding()?)?.fees => 10

fn seeded(coinbase: Transaction, height: Int) -> Result<Building, String>
    ? "The Block's own Outputs, before any of it has been spent."
      "The coinbase's Outputs go in first because a later Transaction in the"
      "same Block may not spend them -- a coinbase waits a hundred Blocks --"
      "but they still have to be in the Set at the end."
    Result.Ok(Building(created = intoMap(createdBy(coinbase, height, true)?, Map.fromList([]))?, spent = Map.fromList([]), removed = [], fees = 0, confirmed = []))

verify seeded
    Map.len(seeded(minting(50), 1)?.created) => 1
    seeded(minting(50), 1)?.fees => 0

fn intoMap(unspents: List<Unspent>, acc: Map<Bytes, Unspent>) -> Result<Map<Bytes, Unspent>, String>
    ? "A list of Outputs, keyed the way an Input names them."
      "A Result since the key became bytes: an Output whose Transaction Id is"
      "not hexadecimal has no key, and inventing one would put it in the Map"
      "under something no Input could ask for."
    match unspents
        [] -> Result.Ok(acc)
        [head, ..tail] -> intoMap(tail, Map.set(acc, Domain.UtxoStore.keyOf(head)?, head))

verify intoMap
    Map.len(intoMap([], Map.fromList([]))?) => 0
    Map.len(intoMap([Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 0, coinbase = false)], Map.fromList([]))?) => 1

record Walking
    transaction: Transaction
    rest: List<Transaction>
    height: Int
    fromStore: Map<Bytes, Unspent>

fn walked(transactions: List<Transaction>, height: Int, fromStore: Map<Bytes, Unspent>, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>) -> Result<Building, String>
    ? "Every Transaction after the coinbase, in the order the Block holds them."
      "The five things the walk accumulates are parameters rather than fields"
      "of a record passed along (#227): a Map.set on a field of a record the"
      "caller still holds copies the whole Map, so the walk was quadratic in"
      "a Block's Inputs -- 122 microseconds an Input on a 4,700-Input Block"
      "against 54 on an average one. A Map in argument position of a tail"
      "call is the shape the runtime updates in place. Building is assembled"
      "once, at the end."
    match transactions
        [] -> Result.Ok(Building(created = created, spent = spent, removed = removed, fees = fees, confirmed = confirmed))
        [head, ..tail] -> spentBy(head.inputs, Walking(transaction = head, rest = tail, height = height, fromStore = fromStore), created, spent, removed, fees, confirmed, 0)

verify walked
    walked([], 1, holding()?, Map.fromList([]), Map.fromList([]), [], 0, [])?.fees => 0
    walked([paying("a1", "aa", 0, 90)], 1, holding()?, Map.fromList([]), Map.fromList([]), [], 0, [])?.fees => 10
    List.len(walked([paying("a1", "aa", 0, 90), paying("a2", "a1", 0, 80)], 1, holding()?, Map.fromList([]), Map.fromList([]), [], 0, [])?.removed) => 1
    Map.len(walked([paying("a1", "aa", 0, 90), paying("a2", "a1", 0, 80)], 1, holding()?, Map.fromList([]), Map.fromList([]), [], 0, [])?.created) => 1
    walked([paying("a1", "aa", 0, 90), paying("a2", "aa", 0, 80)], 1, holding()?, Map.fromList([]), Map.fromList([]), [], 0, []) => Result.Err("Input names Output 0 of aa, which this Block has already spent")

fn spentBy(inputs: List<Input>, walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int) -> Result<Building, String>
    ? "Every Input of one Transaction, and what they add up to."
    match inputs
        [] -> conserving(walking, created, spent, removed, fees, confirmed, taken)
        [head, ..tail] -> resolving(head, tail, walking, created, spent, removed, fees, confirmed, taken)

verify spentBy
    spentBy([], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 50)?.fees => 10
    spentBy(spending("aa", 0, 40).inputs, sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0)?.fees => 60

fn sampleWalking(transaction: Transaction, height: Int) -> Walking
    ? "One Transaction alone at a Height, over what the cases hold, for the cases."
    Walking(transaction = transaction, rest = [], height = height, fromStore = Result.withDefault(holding(), Map.fromList([])))

verify sampleWalking
    sampleWalking(minting(50), 7).height => 7
    Map.len(sampleWalking(minting(50), 7).fromStore) => 2

fn naming(txid: String, index: Int) -> String
    ? "How an Output is named to a reader who has to fix something."
      "The index first, because it is the part a reader of a Transaction"
      "listing has to find; the Transaction Id they will have already."
    "Output {index} of {txid}"

verify naming
    naming("aa", 0) => "Output 0 of aa"
    naming("aa", 3) => "Output 3 of aa"

fn resolving(input: Input, inputs: List<Input>, walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int) -> Result<Building, String>
    ? "Already spent, made in this Block, or resolved from the Store."
    key = outpointKey(input.previousTxid, input.previousIndex)?
    found(key, naming(input.previousTxid, input.previousIndex), inputs, walking, created, spent, removed, fees, confirmed, taken, Map.has(spent, key), Map.get(created, key), Map.get(walking.fromStore, key))

verify resolving
    resolving(Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 0, witness = []), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0)?.fees => 60
    resolving(Input(previousTxid = "zz", previousIndex = 0, script = "", sequence = 0, witness = []), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0) => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn found(key: Bytes, named: String, inputs: List<Input>, walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int, already: Bool, inBlock: Option<Unspent>, inStore: Option<Unspent>) -> Result<Building, String>
    ? "Which of the three answers applies, in the order they have to be asked."
    match already
        true -> Result.Err("Input names {named}, which this Block has already spent")
        false -> notYetSpent(key, named, inputs, walking, created, spent, removed, fees, confirmed, taken, inBlock, inStore)

verify found
    found(Domain.UtxoStore.unspentKey("aa", 0)?, naming("aa", 0), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, true, Option.None, Option.None) => Result.Err("Input names Output 0 of aa, which this Block has already spent")
    found(Domain.UtxoStore.unspentKey("aa", 0)?, naming("aa", 0), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, false, Option.None, Option.Some(Unspent(txid = Bytes.fromList([170]), index = 0, value = 100, script = Bytes.empty(), height = 0, coinbase = false)))?.fees => 60

fn notYetSpent(key: Bytes, named: String, inputs: List<Input>, walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int, inBlock: Option<Unspent>, inStore: Option<Unspent>) -> Result<Building, String>
    ? "An Output made earlier in this Block, before one the Store holds."
    match inBlock
        Option.Some(unspent) -> takenFromBlock(key, named, inputs, walking, created, spent, removed, fees, confirmed, taken, unspent)
        Option.None -> fromTheStore(key, named, inputs, walking, created, spent, removed, fees, confirmed, taken, inStore)

verify notYetSpent
    List.len(notYetSpent(Domain.UtxoStore.unspentKey("aa", 0)?, naming("aa", 0), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, Option.None, Option.Some(Unspent(txid = Bytes.fromList([170]), index = 0, value = 100, script = Bytes.empty(), height = 0, coinbase = false)))?.removed) => 1
    List.len(notYetSpent(Domain.UtxoStore.unspentKey("aa", 0)?, naming("aa", 0), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, Option.Some(Unspent(txid = Bytes.fromList([170]), index = 0, value = 100, script = Bytes.empty(), height = 0, coinbase = false)), Option.None)?.removed) => 0

fn takenFromBlock(key: Bytes, named: String, inputs: List<Input>, walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int, unspent: Unspent) -> Result<Building, String>
    ? "Spent where it was made, so it never reaches the Set at all."
    _mature = matureEnough(named, walking.height, unspent)?
    spentBy(inputs, walking, Map.remove(created, key), Map.set(spent, key, true), removed, fees, confirmed, taken + unspent.value)

verify takenFromBlock
    takenFromBlock(Domain.UtxoStore.unspentKey("cb", 0)?, naming("cb", 0), [], sampleWalking(spending("cb", 0, 40), 101), seeded(minting(50), 1)?.created, Map.fromList([]), [], 0, [], 0, Unspent(txid = Bytes.fromList([203]), index = 0, value = 50, script = Bytes.empty(), height = 1, coinbase = true))?.fees => 10
    Map.len(takenFromBlock(Domain.UtxoStore.unspentKey("cb", 0)?, naming("cb", 0), [], sampleWalking(spending("cb", 0, 40), 101), seeded(minting(50), 1)?.created, Map.fromList([]), [], 0, [], 0, Unspent(txid = Bytes.fromList([203]), index = 0, value = 50, script = Bytes.empty(), height = 1, coinbase = true))?.created) => 1
    takenFromBlock(Domain.UtxoStore.unspentKey("cb", 0)?, naming("cb", 0), [], sampleWalking(spending("cb", 0, 40), 5), seeded(minting(50), 1)?.created, Map.fromList([]), [], 0, [], 0, Unspent(txid = Bytes.fromList([203]), index = 0, value = 50, script = Bytes.empty(), height = 1, coinbase = true)) => Result.Err("Input names Output 0 of cb, a coinbase Output from Height 1 that is not spendable until 101")

fn fromTheStore(key: Bytes, named: String, inputs: List<Input>, walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int, inStore: Option<Unspent>) -> Result<Building, String>
    ? "An Output the Set already held, which does leave Undo Data."
    match inStore
        Option.None -> Result.Err("Input names {named}, which is not an unspent Output")
        Option.Some(unspent) -> takenFromStore(key, inputs, walking, created, spent, removed, fees, confirmed, taken, matureEnough(named, walking.height, unspent), unspent)

verify fromTheStore
    fromTheStore(Domain.UtxoStore.unspentKey("aa", 0)?, naming("aa", 0), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, Option.None) => Result.Err("Input names Output 0 of aa, which is not an unspent Output")
    List.len(fromTheStore(Domain.UtxoStore.unspentKey("aa", 0)?, naming("aa", 0), [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, Option.Some(Unspent(txid = Bytes.fromList([170]), index = 0, value = 100, script = Bytes.empty(), height = 0, coinbase = false)))?.removed) => 1

fn takenFromStore(key: Bytes, inputs: List<Input>, walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int, mature: Result<Unit, String>, unspent: Unspent) -> Result<Building, String>
    ? "Out of the Set and into the Undo Data, once it is old enough."
    match mature
        Result.Err(why) -> Result.Err(why)
        Result.Ok(unit) -> spentBy(inputs, walking, created, Map.set(spent, key, true), List.prepend(unspent, removed), fees, confirmed, taken + unspent.value)

verify takenFromStore
    takenFromStore(Domain.UtxoStore.unspentKey("aa", 0)?, [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, Result.Err("no"), Unspent(txid = Bytes.fromList([170]), index = 0, value = 100, script = Bytes.empty(), height = 0, coinbase = false)) => Result.Err("no")
    takenFromStore(Domain.UtxoStore.unspentKey("aa", 0)?, [], sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 0, Result.Ok(Unit), Unspent(txid = Bytes.fromList([170]), index = 0, value = 100, script = Bytes.empty(), height = 0, coinbase = false))?.fees => 60

fn matureEnough(named: String, height: Int, unspent: Unspent) -> Result<Unit, String>
    ? "A coinbase Output cannot be spent for a hundred Blocks."
    match Domain.UtxoStore.matured(unspent, height)
        true -> Result.Ok(Unit)
        false -> Result.Err("Input names {named}, a coinbase Output from Height {unspent.height} that is not spendable until {unspent.height + Domain.UtxoStore.maturity()}")

verify matureEnough
    matureEnough(naming("aa", 0), 5, Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = false)) => Result.Ok(Unit)
    matureEnough(naming("aa", 0), 5, Unspent(txid = Bytes.fromList([170]), index = 0, value = 5, script = Bytes.empty(), height = 1, coinbase = true)) => Result.Err("Input names Output 0 of aa, a coinbase Output from Height 1 that is not spendable until 101")

fn conserving(walking: Walking, created: Map<Bytes, Unspent>, spent: Map<Bytes, Bool>, removed: List<Unspent>, fees: Int, confirmed: List<TxFee>, taken: Int) -> Result<Building, String>
    ? "A Transaction may not pay out more than it took in."
      "Judged on this Transaction's own Inputs (#227). It used to be judged"
      "on the Block's running total of fees, which let a Transaction pay out"
      "more than it took in as long as the Transactions before it in the"
      "Block had left enough fee behind to cover the difference -- a Block"
      "Core refuses. The difference is the fee, and it belongs to whoever"
      "mined the Block."
    paid = paidBy(walking.transaction)
    match taken < paid
        true -> Result.Err("Transaction {walking.transaction.txid} pays out {paid} against {taken} taken in")
        false -> walked(walking.rest, walking.height, walking.fromStore, intoMap(createdBy(walking.transaction, walking.height, false)?, created)?, spent, removed, fees + (taken - paid), List.prepend(TxFee(txid = walking.transaction.txid, fee = taken - paid, coinbase = false), confirmed))

verify conserving
    conserving(sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 50)?.fees => 10
    conserving(sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 7, [], 50)?.fees => 17
    Map.len(conserving(sampleWalking(spending("aa", 0, 40), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 50)?.created) => 1
    conserving(sampleWalking(spending("aa", 0, 60), 1), Map.fromList([]), Map.fromList([]), [], 0, [], 50) => Result.Err("Transaction bb pays out 60 against 50 taken in")
    conserving(sampleWalking(spending("aa", 0, 60), 1), Map.fromList([]), Map.fromList([]), [], 20, [], 50) => Result.Err("Transaction bb pays out 60 against 50 taken in")

fn settled(network: Network, height: Int, coinbase: Transaction, building: Result<Building, String>) -> Connecting
    ? "The coinbase's claim, judged against the subsidy and the fees."
    match building
        Result.Err(why) -> Connecting.Refused(why)
        Result.Ok(state) -> claimed(network, height, coinbase, state)

verify settled
    settled(Network.Mainnet, 1, minting(50), Result.Err("no")) => Connecting.Refused("no")
    settled(Network.Mainnet, 1, minting(50), Result.Ok(seeded(minting(50), 1)?)) => Connecting.Applied(Change(added = [Unspent(txid = Bytes.fromList([203]), index = 0, value = 50, script = Bytes.empty(), height = 1, coinbase = true)], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)]))

fn claimed(network: Network, height: Int, coinbase: Transaction, state: Building) -> Connecting
    ? "No more than the subsidy plus what the Block's fees left behind."
    allowed(coinbase.txid, paidBy(coinbase), Domain.Subsidy.atHeight(network, height), state)

verify claimed
    claimed(Network.Mainnet, 1, minting(5000000000), seeded(minting(5000000000), 1)?) => Connecting.Applied(Change(added = [Unspent(txid = Bytes.fromList([203]), index = 0, value = 5000000000, script = Bytes.empty(), height = 1, coinbase = true)], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)]))
    claimed(Network.Mainnet, 1, minting(5000000001), seeded(minting(5000000001), 1)?) => Connecting.Refused("coinbase claims 5000000001 with 5000000000 allowed")

fn allowed(coinbaseTxid: String, paid: Int, subsidy: Int, state: Building) -> Connecting
    ? "Within the claim, the Block's changes; over it, the reason."
      "The confirmed list comes out in Block order, the coinbase first, so a"
      "reader sees the Block as the Block was."
    match Domain.Subsidy.withinClaim(paid, subsidy, state.fees)
        false -> Connecting.Refused("coinbase claims {paid} with {Domain.Subsidy.claimAllowed(subsidy, state.fees)} allowed")
        true -> Connecting.Applied(Change(added = Map.values(state.created), removed = List.reverse(state.removed), fees = state.fees, confirmed = List.prepend(TxFee(txid = coinbaseTxid, fee = 0, coinbase = true), List.reverse(state.confirmed))))

verify allowed
    allowed("cb", 50, 50, seeded(minting(50), 1)?) => Connecting.Applied(Change(added = [Unspent(txid = Bytes.fromList([203]), index = 0, value = 50, script = Bytes.empty(), height = 1, coinbase = true)], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)]))
    allowed("cb", 51, 50, seeded(minting(50), 1)?) => Connecting.Refused("coinbase claims 51 with 50 allowed")

fn minting(value: Int) -> Transaction
    ? "A coinbase paying one Output, for the cases here."
    Transaction(version = 1, inputs = [], outputs = [Output(value = value, script = "")], lockTime = 0, txid = "cb", size = 0, isSegWit = false)

verify minting
    minting(50).txid => "cb"
    paidBy(minting(50)) => 50

fn spending(txid: String, index: Int, value: Int) -> Transaction
    ? "A Transaction spending one Output and paying one, for the cases here."
    Transaction(version = 1, inputs = [Input(previousTxid = txid, previousIndex = index, script = "", sequence = 0, witness = [])], outputs = [Output(value = value, script = "")], lockTime = 0, txid = "bb", size = 0, isSegWit = false)

verify spending
    spending("aa", 0, 40).txid => "bb"
    paidBy(spending("aa", 0, 40)) => 40

fn holding() -> Result<Map<Bytes, Unspent>, String>
    ? "What the Set already holds, for the cases here."
      "One ordinary Output worth a hundred, and one coinbase Output from"
      "Height 1 worth the same, so a case can ask whether maturity is being"
      "checked without any other difference between them."
    Result.Ok(Map.fromList([(Domain.UtxoStore.unspentKey("aa", 0)?, Unspent(txid = Bytes.fromList([170]), index = 0, value = 100, script = Bytes.empty(), height = 0, coinbase = false)), (Domain.UtxoStore.unspentKey("cc", 0)?, Unspent(txid = Bytes.fromList([204]), index = 0, value = 100, script = Bytes.empty(), height = 1, coinbase = true))]))

verify holding
    Map.len(holding()?) => 2

fn paying(txid: String, fromTxid: String, fromIndex: Int, value: Int) -> Transaction
    ? "A Transaction spending one named Output and paying one, for the cases here."
    Transaction(version = 1, inputs = [Input(previousTxid = fromTxid, previousIndex = fromIndex, script = "", sequence = 0, witness = [])], outputs = [Output(value = value, script = "")], lockTime = 0, txid = txid, size = 0, isSegWit = false)

verify paying
    paying("a1", "aa", 0, 90).txid => "a1"
    paidBy(paying("a1", "aa", 0, 90)) => 90

fn added(connection: Connecting) -> List<Unspent>
    ? "What a Connecting puts into the Set, or nothing when it was refused."
    match connection
        Connecting.Refused(why) -> []
        Connecting.Applied(change) -> change.added

verify added
    added(Connecting.Refused("no")) => []
    List.len(added(Connecting.Applied(Change(added = [], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)])))) => 0

fn removedBy(connection: Connecting) -> List<Unspent>
    ? "What it takes out, which is the Undo Data."
    match connection
        Connecting.Refused(why) -> []
        Connecting.Applied(change) -> change.removed

verify removedBy
    removedBy(Connecting.Refused("no")) => []
    List.len(removedBy(Connecting.Applied(Change(added = [], removed = [], fees = 0, confirmed = [TxFee(txid = "cb", fee = 0, coinbase = true)])))) => 0

fn feesOf(connection: Connecting) -> Int
    ? "What the Block left for its miner, or below zero when it was refused."
    match connection
        Connecting.Refused(why) -> 0 - 1
        Connecting.Applied(change) -> change.fees

verify feesOf
    feesOf(Connecting.Refused("no")) => 0 - 1
    feesOf(Connecting.Applied(Change(added = [], removed = [], fees = 7, confirmed = []))) => 7
