module ScriptOps
    intent =
        "What one Op does to the machine, and nothing about what comes next."
        "Every function here is a pure transition: it is handed a State and"
        "answers with a Step, either carrying on or stopping. None of them"
        "recurses through the rest of the Script, which is what lets each one be"
        "checked on its own and lets the walk live in a single place."
        "Failures are written out in full rather than through a helper. A helper"
        "returning a Step could only ever return Stop, and the coverage checker"
        "is right to object to a function carrying a constructor it cannot"
        "reach — which is the same objection that split Outcome from Ending in"
        "the first place."
        "The order of the refusals matters and follows the reference client: the"
        "opcode limit is charged first, then disabled opcodes, then OP_VERIF and"
        "OP_VERNOTIF, and only then is the condition stack consulted. All three"
        "fail a Script wherever they appear, so none of them may wait behind a"
        "branch that is not being taken."
    exposes [step]
    depends [Bytes, Crypto.Digest32, Domain.Checksig, Domain.Primitives, Domain.PrimitiveStub, Domain.Hash, Domain.Opcode, Domain.ScriptMath, Domain.ScriptParse, Domain.ScriptState, Domain.ScriptStep, Domain.SpendContext, Domain.StackItem]
    effects []

fn step(op: Op, state: State, context: Context) -> Step
    ? "One Op against the machine."
    match op
        Op.Push(code, data) -> pushed(data, state)
        Op.Code(code) -> coded(code, state, context)

verify step
    step(Op.Push(1, [1]), Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    step(Op.Code(106), Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_RETURN")))

fn pushed(data: List<Int>, state: State) -> Step
    ? "An oversized push fails a Script even in a branch that is not being"
      "taken, so the size is checked before the condition stack is."
    limit = Domain.ScriptState.maxItem()
    width = List.len(data)
    match width > limit
        true -> Step.Stop(Outcome.Decided(Ending.Failed("push of {width} bytes is over the {limit} byte limit")))
        false -> pushedIfExecuting(data, state)

verify pushed
    pushed([1], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    pushed(Domain.ScriptState.zeros(521), Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("push of 521 bytes is over the 520 byte limit")))
    pushed(Domain.ScriptState.zeros(521), State(stack = [], alt = [], conditions = [false], opCount = 0)) => Step.Stop(Outcome.Decided(Ending.Failed("push of 521 bytes is over the 520 byte limit")))

fn pushedIfExecuting(data: List<Int>, state: State) -> Step
    ? "Otherwise a push only happens in a branch being executed."
    match Domain.ScriptState.executing(state.conditions)
        false -> Step.Continue(state)
        true -> Domain.ScriptStep.pushing(data, state)

verify pushedIfExecuting
    pushedIfExecuting([1], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    pushedIfExecuting([1], State(stack = [], alt = [], conditions = [false], opCount = 0)) => Step.Continue(State(stack = [], alt = [], conditions = [false], opCount = 0))
    pushedIfExecuting([1], Domain.ScriptState.holding(Domain.ScriptState.repeated(1000, [2]))) => Step.Stop(Outcome.Decided(Ending.Failed("stack is over the 1000 item limit")))

fn coded(code: Int, state: State, context: Context) -> Step
    ? "Opcodes above OP_16 count against the limit whether executed or not, and"
      "the charge comes before every other refusal -- which is the order the"
      "reference client uses, so a Script that is both too long and disabled"
      "gets told the same thing by both."
    limit = Domain.ScriptState.maxOps()
    match Bool.and(code > 96, state.opCount + 1 > limit)
        true -> Step.Stop(Outcome.Decided(Ending.Failed("script uses more than {limit} opcodes")))
        false -> disabled(code, Domain.ScriptState.spent(state, code), context)

verify coded
    coded(97, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(State(stack = [], alt = [], conditions = [], opCount = 1))
    coded(97, State(stack = [], alt = [], conditions = [], opCount = 201), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("script uses more than 201 opcodes")))

fn disabled(code: Int, state: State, context: Context) -> Step
    ? "A disabled opcode fails a Script wherever it appears, including in a"
      "branch that is never taken."
    match Domain.Opcode.isDisabled(code)
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} is disabled")))
        false -> refused(code, state, context)

verify disabled
    disabled(126, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CAT is disabled")))
    disabled(97, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.empty())

fn refused(code: Int, state: State, context: Context) -> Step
    ? "And so do OP_VERIF and OP_VERNOTIF, for a different reason."
    match Domain.Opcode.isAlwaysInvalid(code)
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} is not allowed anywhere in a script")))
        false -> flowOrRest(code, state, context)

verify refused
    refused(101, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_VERIF is not allowed anywhere in a script")))
    refused(97, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.empty())

fn flowOrRest(code: Int, state: State, context: Context) -> Step
    ? "Flow control runs even inside a branch that is not being taken, because"
      "an OP_IF nested in a skipped branch still needs its OP_ENDIF."
    match code
        99 -> opened(code, state)
        100 -> opened(code, state)
        103 -> switched(state)
        104 -> closed(state)
        _ -> whenExecuting(code, state, context)

verify flowOrRest
    flowOrRest(97, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.empty())
    flowOrRest(104, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_ENDIF outside an OP_IF")))

fn opened(code: Int, state: State) -> Step
    ? "OP_IF and OP_NOTIF open a branch."
      "Inside a branch not being taken nothing is popped, because the pushes"
      "that would have supplied the condition were skipped too."
    match Domain.ScriptState.executing(state.conditions)
        false -> Step.Continue(Domain.ScriptState.withConditions(state, List.prepend(false, state.conditions)))
        true -> openedNow(code, state)

verify opened
    opened(99, Domain.ScriptState.holding([[1]])) => Step.Continue(State(stack = [], alt = [], conditions = [true], opCount = 0))
    opened(99, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_IF on an empty stack")))

fn openedNow(code: Int, state: State) -> Step
    ? "Take the condition off the stack and open the branch on it."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} on an empty stack")))
        [head, ..tail] -> Step.Continue(State(stack = tail, alt = state.alt, conditions = List.prepend(Domain.ScriptState.taken(Domain.StackItem.isTruthy(head), code), state.conditions), opCount = state.opCount))

verify openedNow
    openedNow(99, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_IF on an empty stack")))
    openedNow(100, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_NOTIF on an empty stack")))
    openedNow(99, Domain.ScriptState.holding([[1]])) => Step.Continue(State(stack = [], alt = [], conditions = [true], opCount = 0))
    openedNow(100, Domain.ScriptState.holding([[1]])) => Step.Continue(State(stack = [], alt = [], conditions = [false], opCount = 0))

fn switched(state: State) -> Step
    ? "OP_ELSE flips the branch it is in."
    match state.conditions
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("OP_ELSE outside an OP_IF")))
        [head, ..tail] -> Step.Continue(Domain.ScriptState.withConditions(state, List.prepend(Bool.not(head), tail)))

verify switched
    switched(Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_ELSE outside an OP_IF")))
    switched(State(stack = [], alt = [], conditions = [false], opCount = 0)) => Step.Continue(State(stack = [], alt = [], conditions = [true], opCount = 0))

fn closed(state: State) -> Step
    ? "OP_ENDIF closes it."
    match state.conditions
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("OP_ENDIF outside an OP_IF")))
        [head, ..tail] -> Step.Continue(Domain.ScriptState.withConditions(state, tail))

verify closed
    closed(Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_ENDIF outside an OP_IF")))
    closed(State(stack = [], alt = [], conditions = [true], opCount = 0)) => Step.Continue(Domain.ScriptState.empty())

fn whenExecuting(code: Int, state: State, context: Context) -> Step
    ? "Everything else is skipped inside a branch not being taken."
    match Domain.ScriptState.executing(state.conditions)
        false -> Step.Continue(state)
        true -> operated(code, state, context)

verify whenExecuting
    whenExecuting(106, State(stack = [], alt = [], conditions = [false], opCount = 0), Domain.SpendContext.bare()) => Step.Continue(State(stack = [], alt = [], conditions = [false], opCount = 0))
    whenExecuting(106, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_RETURN")))

fn operated(code: Int, state: State, context: Context) -> Step
    ? "The opcodes worth naming by number; the rest go by kind."
    match code
        0 -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(0), state)
        79 -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(0 - 1), state)
        105 -> verified(state)
        106 -> Step.Stop(Outcome.Decided(Ending.Failed("OP_RETURN")))
        107 -> toAlt(state)
        108 -> fromAlt(state)
        115 -> ifDup(state)
        116 -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(List.len(state.stack)), state)
        121 -> pickedOrRolled(code, state)
        122 -> pickedOrRolled(code, state)
        130 -> sized(state)
        135 -> equality(code, state)
        136 -> equality(code, state)
        165 -> within(state)
        166 -> hashed(code, state)
        168 -> hashed(code, state)
        169 -> hashed(code, state)
        170 -> hashed(code, state)
        _ -> signedOrGrouped(code, state, context)

verify operated
    operated(0, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.holding([[]]))
    operated(79, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.holding([[129]]))
    operated(106, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_RETURN")))
    operated(116, Domain.ScriptState.holding([[1], [2]]), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.holding([[2], [1], [2]]))

fn signedOrGrouped(code: Int, state: State, context: Context) -> Step
    ? "The signature opcodes have their own module: they are the only ones that"
      "reach a variable depth, they charge their own opcodes against the limit,"
      "and there was no room left in this file for them."
    match Domain.Checksig.isSignatureOpcode(code)
        true -> Domain.Checksig.step(code, state, context)
        false -> byGroup(code, state)

verify signedOrGrouped
    signedOrGrouped(81, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    signedOrGrouped(172, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_CHECKSIG needs two items")))
    signedOrGrouped(169, Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_HASH160 makes any script that runs it invalid")))

fn byGroup(code: Int, state: State) -> Step
    ? "By family, once the ones handled by number are out of the way."
    match Domain.Opcode.kindOf(code)
        Domain.Opcode.Kind.SmallNumber -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(Domain.Opcode.smallNumberValue(code)), state)
        Domain.Opcode.Kind.Rearrange -> shuffled(code, state)
        Domain.Opcode.Kind.UnaryArithmetic -> unaryArith(code, state)
        Domain.Opcode.Kind.BinaryArithmetic -> binaryArith(code, state)
        Domain.Opcode.Kind.Nop -> Step.Continue(state)
        Domain.Opcode.Kind.Undecidable -> Step.Stop(Outcome.Undecided(Domain.ScriptState.missing(code)))
        Domain.Opcode.Kind.Invalid -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} makes any script that runs it invalid")))

verify byGroup
    byGroup(81, Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    byGroup(97, Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.empty())
    byGroup(167, Domain.ScriptState.empty()) => Step.Stop(Outcome.Undecided("OP_SHA1 needs sha1"))
    byGroup(80, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_RESERVED makes any script that runs it invalid")))
    byGroup(118, Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[1], [1]]))
    byGroup(139, Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[2]]))
    byGroup(147, Domain.ScriptState.holding([[2], [3]])) => Step.Continue(Domain.ScriptState.holding([[5]]))

fn verified(state: State) -> Step
    ? "OP_VERIFY takes the top item and stops if it was false."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("OP_VERIFY needs an item")))
        [head, ..tail] -> Domain.ScriptStep.stoppedUnless(Domain.StackItem.isTruthy(head), "OP_VERIFY found a false value", tail, state)

verify verified
    verified(Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_VERIFY needs an item")))
    verified(Domain.ScriptState.holding([[1], [2]])) => Step.Continue(Domain.ScriptState.holding([[2]]))
    verified(Domain.ScriptState.holding([[0]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_VERIFY found a false value")))

fn toAlt(state: State) -> Step
    ? "OP_TOALTSTACK moves the top item across."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("OP_TOALTSTACK needs an item")))
        [head, ..tail] -> Step.Continue(State(stack = tail, alt = List.prepend(head, state.alt), conditions = state.conditions, opCount = state.opCount))

verify toAlt
    toAlt(Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_TOALTSTACK needs an item")))
    toAlt(Domain.ScriptState.holding([[1]])) => Step.Continue(State(stack = [], alt = [[1]], conditions = [], opCount = 0))

fn fromAlt(state: State) -> Step
    ? "OP_FROMALTSTACK moves it back."
    match state.alt
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("OP_FROMALTSTACK needs an item on the alt stack")))
        [head, ..tail] -> Step.Continue(State(stack = List.prepend(head, state.stack), alt = tail, conditions = state.conditions, opCount = state.opCount))

verify fromAlt
    fromAlt(Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_FROMALTSTACK needs an item on the alt stack")))
    fromAlt(State(stack = [], alt = [[1]], conditions = [], opCount = 0)) => Step.Continue(Domain.ScriptState.holding([[1]]))

fn ifDup(state: State) -> Step
    ? "OP_IFDUP copies the top item only when it is true, which is why it is"
      "not one of the plain rearrangements."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("OP_IFDUP needs an item")))
        [head, ..tail] -> duplicatedIfTrue(head, state)

verify ifDup
    ifDup(Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_IFDUP needs an item")))
    ifDup(Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[1], [1]]))
    ifDup(Domain.ScriptState.holding([[0]])) => Step.Continue(Domain.ScriptState.holding([[0]]))

fn duplicatedIfTrue(top: List<Int>, state: State) -> Step
    ? "True on top, or leave it alone."
    match Domain.StackItem.isTruthy(top)
        false -> Step.Continue(state)
        true -> Domain.ScriptStep.pushing(top, state)

verify duplicatedIfTrue
    duplicatedIfTrue([1], Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[1], [1]]))
    duplicatedIfTrue([1], Domain.ScriptState.holding(Domain.ScriptState.repeated(1000, [1]))) => Step.Stop(Outcome.Decided(Ending.Failed("stack is over the 1000 item limit")))

fn sized(state: State) -> Step
    ? "OP_SIZE pushes the length of the top item and leaves the item alone,"
      "which is the opposite of what most of these do."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("OP_SIZE needs an item")))
        [head, ..tail] -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(List.len(head)), state)

verify sized
    sized(Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_SIZE needs an item")))
    sized(Domain.ScriptState.holding([[7, 8]])) => Step.Continue(Domain.ScriptState.holding([[2], [7, 8]]))
    sized(Domain.ScriptState.holding([[]])) => Step.Continue(Domain.ScriptState.holding([[], []]))

fn hashed(code: Int, state: State) -> Step
    ? "The four hash opcodes this engine can answer: OP_RIPEMD160, OP_SHA256,"
      "OP_HASH160 and OP_HASH256. OP_SHA1 is not among them and stays"
      "undecidable, because SHA-1 is a primitive nothing here has."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs an item")))
        [head, ..tail] -> hashedTop(code, head, tail, state)

verify hashed
    hashed(168, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_SHA256 needs an item")))
    hashed(169, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_HASH160 needs an item")))
    hashed(168, Domain.ScriptState.holding([[97]])) => Step.Continue(Domain.ScriptState.holding([Bytes.toList(Crypto.Digest32.toBytes(Crypto.sha256(Bytes.fromList([97]))))]))

fn hashedTop(code: Int, top: List<Int>, tail: List<List<Int>>, state: State) -> Step
    ? "The bytes have to be bytes first. Nothing on a stack built by this"
      "module can fail that, but the stack is a list of Ints and the type does"
      "not know it."
    match Bytes.fromList(top)
        Result.Err(message) -> Step.Stop(Outcome.Decided(Ending.Failed(message)))
        Result.Ok(raw) -> Domain.ScriptStep.landed(List.prepend(digestFor(code, raw), tail), state)

verify hashedTop
    hashedTop(168, [256], [], Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("byte 256 at index 0 is outside 0..=255")))
    hashedTop(168, [97], [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([Bytes.toList(Crypto.Digest32.toBytes(Crypto.sha256(Bytes.fromList([97]))))]))

fn digestFor(code: Int, raw: Bytes) -> List<Int>
    ? "Which digest each opcode names. OP_HASH160 and OP_HASH256 are the two"
      "composites Bitcoin defines, and they are composed here rather than by"
      "the provider, because the composition is Bitcoin's and neither"
      "RIPEMD-160 nor SHA-256 knows anything about it."
      "RIPEMD-160 crosses a capability boundary and SHA-256 does not, which is"
      "why one of these is a conversion and the others are a call."
    match code
        166 -> Domain.Hash.ripemd160(Bytes.toList(raw))
        169 -> Domain.Hash.hash160(Bytes.toList(raw))
        170 -> Bytes.toList(Crypto.Digest32.toBytes(Domain.Hash.doubleSha(raw)))
        _ -> Bytes.toList(Crypto.Digest32.toBytes(Crypto.sha256(raw)))

verify digestFor
    digestFor(170, Bytes.fromList([])) => Bytes.toList(Crypto.Digest32.toBytes(Domain.Hash.doubleSha(Bytes.fromList([]))))
    digestFor(168, Bytes.fromList([])) => Bytes.toList(Crypto.Digest32.toBytes(Crypto.sha256(Bytes.fromList([]))))

fn shuffled(code: Int, state: State) -> Step
    ? "The thirteen opcodes that only move items about, done as a permutation"
      "of the items they reach rather than as a sequence of pops."
    depth = Domain.Opcode.rearrangeDepth(code)
    items = List.take(state.stack, depth)
    match List.len(items) == depth
        false -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs {Domain.ScriptState.itemsWord(depth)}")))
        true -> Domain.ScriptStep.landed(List.concat(Domain.ScriptState.rearranged(code, items), List.drop(state.stack, depth)), state)

verify shuffled
    shuffled(118, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_DUP needs 1 item")))
    shuffled(118, Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[1], [1]]))
    shuffled(117, Domain.ScriptState.holding([[1], [2]])) => Step.Continue(Domain.ScriptState.holding([[2]]))
    shuffled(124, Domain.ScriptState.holding([[1], [2]])) => Step.Continue(Domain.ScriptState.holding([[2], [1]]))
    shuffled(123, Domain.ScriptState.holding([[3], [2], [1], [9]])) => Step.Continue(Domain.ScriptState.holding([[1], [3], [2], [9]]))
    shuffled(113, Domain.ScriptState.holding([[6], [5], [4], [3], [2], [1]])) => Step.Continue(Domain.ScriptState.holding([[2], [1], [6], [5], [4], [3]]))
    shuffled(113, Domain.ScriptState.holding([[6], [5]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_2ROT needs 6 items")))

fn pickedOrRolled(code: Int, state: State) -> Step
    ? "OP_PICK copies an item from a depth the Script names; OP_ROLL moves it."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs a depth")))
        [head, ..tail] -> countedDepth(code, head, tail, state)

verify pickedOrRolled
    pickedOrRolled(121, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_PICK needs a depth")))
    pickedOrRolled(121, Domain.ScriptState.holding([[1], [7], [8]])) => Step.Continue(Domain.ScriptState.holding([[8], [7], [8]]))
    pickedOrRolled(122, Domain.ScriptState.holding([[1], [7], [8]])) => Step.Continue(Domain.ScriptState.holding([[8], [7]]))

fn countedDepth(code: Int, head: List<Int>, tail: List<List<Int>>, state: State) -> Step
    ? "The depth is a number like any other and obeys the same four-byte rule."
    match Domain.StackItem.fitsArithmetic(head)
        false -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} depth is over four bytes")))
        true -> atDepth(code, Domain.StackItem.asNumber(head), tail, state)

verify countedDepth
    countedDepth(121, [1, 2, 3, 4, 5], [], Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_PICK depth is over four bytes")))
    countedDepth(121, [0], [[7]], Domain.ScriptState.holding([[1], [7]])) => Step.Continue(Domain.ScriptState.holding([[7], [7]]))

fn atDepth(code: Int, n: Int, tail: List<List<Int>>, state: State) -> Step
    ? "Nought is the item that was under the depth itself, so a stack of one"
      "item can still be picked from."
    match Bool.or(n < 0, n >= List.len(tail))
        true -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} reaches past the bottom of the stack")))
        false -> Domain.ScriptStep.landed(List.prepend(Domain.ScriptState.itemAt(tail, n), Domain.ScriptState.remaining(code, tail, n)), state)

verify atDepth
    atDepth(121, 0, [[7]], Domain.ScriptState.holding([[1], [7]])) => Step.Continue(Domain.ScriptState.holding([[7], [7]]))
    atDepth(121, 1, [[7]], Domain.ScriptState.holding([[1], [7]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_PICK reaches past the bottom of the stack")))
    atDepth(121, 0 - 1, [[7]], Domain.ScriptState.holding([[1], [7]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_PICK reaches past the bottom of the stack")))
    atDepth(122, 1, [[7], [8]], Domain.ScriptState.holding([[1], [7], [8]])) => Step.Continue(Domain.ScriptState.holding([[8], [7]]))

fn equality(code: Int, state: State) -> Step
    ? "OP_EQUAL and OP_EQUALVERIFY compare byte strings, not numbers, so an"
      "empty item and a single zero are different here and equal to OP_NUMEQUAL."
    match Domain.ScriptState.topTwo(state.stack, Domain.Opcode.nameOf(code))
        Result.Err(message) -> Step.Stop(Outcome.Decided(Ending.Failed(message)))
        Result.Ok(two) -> equalityOn(code, two, state)

verify equality
    equality(135, Domain.ScriptState.holding([[1]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_EQUAL needs two items")))
    equality(135, Domain.ScriptState.holding([[1], [1]])) => Step.Continue(Domain.ScriptState.holding([[1]]))
    equality(135, Domain.ScriptState.holding([[1], [2]])) => Step.Continue(Domain.ScriptState.holding([[]]))
    equality(136, Domain.ScriptState.holding([[1], [2]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_EQUALVERIFY found two different items")))

fn equalityOn(code: Int, two: Two, state: State) -> Step
    ? "One pushes the answer, the other stops on it."
    same = two.first == two.second
    match code == 136
        true -> Domain.ScriptStep.stoppedUnless(same, "OP_EQUALVERIFY found two different items", two.rest, state)
        false -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(Domain.ScriptMath.oneIf(same)), Domain.ScriptState.withStack(state, two.rest))

verify equalityOn
    equalityOn(135, Two(first = [1], second = [1], rest = []), Domain.ScriptState.holding([[1], [1]])) => Step.Continue(Domain.ScriptState.holding([[1]]))
    equalityOn(136, Two(first = [1], second = [2], rest = []), Domain.ScriptState.holding([[1], [2]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_EQUALVERIFY found two different items")))

fn unaryArith(code: Int, state: State) -> Step
    ? "The arithmetic on one operand."
    match state.stack
        [] -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} needs an item")))
        [head, ..tail] -> unaryOn(code, head, tail, state)

verify unaryArith
    unaryArith(139, Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_1ADD needs an item")))
    unaryArith(139, Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[2]]))
    unaryArith(143, Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[129]]))
    unaryArith(145, Domain.ScriptState.holding([[]])) => Step.Continue(Domain.ScriptState.holding([[1]]))

fn unaryOn(code: Int, top: List<Int>, tail: List<List<Int>>, state: State) -> Step
    ? "Arithmetic takes at most four bytes, whatever the stack is willing to hold."
    match Domain.StackItem.fitsArithmetic(top)
        false -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} operand is over four bytes")))
        true -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(Domain.ScriptMath.unaryValue(code, Domain.StackItem.asNumber(top))), Domain.ScriptState.withStack(state, tail))

verify unaryOn
    unaryOn(139, [1, 2, 3, 4, 5], [], Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_1ADD operand is over four bytes")))
    unaryOn(140, [1], [], Domain.ScriptState.holding([[1]])) => Step.Continue(Domain.ScriptState.holding([[]]))

fn binaryArith(code: Int, state: State) -> Step
    ? "The arithmetic on two operands, the numeric comparisons included."
    match Domain.ScriptState.topTwo(state.stack, Domain.Opcode.nameOf(code))
        Result.Err(message) -> Step.Stop(Outcome.Decided(Ending.Failed(message)))
        Result.Ok(two) -> binaryOn(code, two, state)

verify binaryArith
    binaryArith(147, Domain.ScriptState.holding([[1]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_ADD needs two items")))
    binaryArith(147, Domain.ScriptState.holding([[2], [3]])) => Step.Continue(Domain.ScriptState.holding([[5]]))
    binaryArith(148, Domain.ScriptState.holding([[2], [5]])) => Step.Continue(Domain.ScriptState.holding([[3]]))
    binaryArith(159, Domain.ScriptState.holding([[3], [2]])) => Step.Continue(Domain.ScriptState.holding([[1]]))
    binaryArith(157, Domain.ScriptState.holding([[1], [2]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_NUMEQUALVERIFY found two different numbers")))

fn binaryOn(code: Int, two: Two, state: State) -> Step
    ? "Both operands obey the four-byte rule."
    match Bool.and(Domain.StackItem.fitsArithmetic(two.first), Domain.StackItem.fitsArithmetic(two.second))
        false -> Step.Stop(Outcome.Decided(Ending.Failed("{Domain.Opcode.nameOf(code)} operand is over four bytes")))
        true -> binaryDone(code, Domain.StackItem.asNumber(two.second), Domain.StackItem.asNumber(two.first), two.rest, state)

verify binaryOn
    binaryOn(147, Two(first = [1, 2, 3, 4, 5], second = [1], rest = []), Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_ADD operand is over four bytes")))
    binaryOn(147, Two(first = [2], second = [3], rest = []), Domain.ScriptState.holding([[2], [3]])) => Step.Continue(Domain.ScriptState.holding([[5]]))

fn binaryDone(code: Int, a: Int, b: Int, deeper: List<List<Int>>, state: State) -> Step
    ? "a was the deeper of the two and b was on top, so OP_SUB is a minus b."
      "OP_NUMEQUALVERIFY stops on its answer instead of pushing it."
    match code == 157
        true -> Domain.ScriptStep.stoppedUnless(a == b, "OP_NUMEQUALVERIFY found two different numbers", deeper, state)
        false -> Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(Domain.ScriptMath.binaryValue(code, a, b)), Domain.ScriptState.withStack(state, deeper))

verify binaryDone
    binaryDone(147, 2, 3, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[5]]))
    binaryDone(148, 5, 3, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[2]]))
    binaryDone(157, 1, 2, [], Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_NUMEQUALVERIFY found two different numbers")))
    binaryDone(157, 2, 2, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.empty())

fn within(state: State) -> Step
    ? "OP_WITHIN, the only opcode reaching three items down."
    match Domain.ScriptState.topThree(state.stack, "OP_WITHIN")
        Result.Err(message) -> Step.Stop(Outcome.Decided(Ending.Failed(message)))
        Result.Ok(three) -> withinOn(three, state)

verify within
    within(Domain.ScriptState.holding([[1], [2]])) => Step.Stop(Outcome.Decided(Ending.Failed("OP_WITHIN needs three items")))
    within(Domain.ScriptState.holding([[5], [1], [3]])) => Step.Continue(Domain.ScriptState.holding([[1]]))
    within(Domain.ScriptState.holding([[5], [1], [7]])) => Step.Continue(Domain.ScriptState.holding([[]]))

fn withinOn(three: Three, state: State) -> Step
    ? "The upper bound is on top, the lower under it, the value under both."
      "The range is half open: the lower bound is inside it and the upper is"
      "not, which is the one thing about this opcode worth checking twice."
    match Bool.and(Domain.StackItem.fitsArithmetic(three.first), Bool.and(Domain.StackItem.fitsArithmetic(three.second), Domain.StackItem.fitsArithmetic(three.third)))
        false -> Step.Stop(Outcome.Decided(Ending.Failed("OP_WITHIN operand is over four bytes")))
        true -> inRange(Domain.StackItem.asNumber(three.third), Domain.StackItem.asNumber(three.second), Domain.StackItem.asNumber(three.first), three.rest, state)

verify withinOn
    withinOn(Three(first = [1, 2, 3, 4, 5], second = [1], third = [2], rest = []), Domain.ScriptState.empty()) => Step.Stop(Outcome.Decided(Ending.Failed("OP_WITHIN operand is over four bytes")))
    withinOn(Three(first = [5], second = [1], third = [3], rest = []), Domain.ScriptState.holding([[5], [1], [3]])) => Step.Continue(Domain.ScriptState.holding([[1]]))

fn inRange(value: Int, lower: Int, upper: Int, deeper: List<List<Int>>, state: State) -> Step
    ? "Lower bound included, upper bound not."
    Domain.ScriptStep.pushing(Domain.StackItem.fromNumber(Domain.ScriptMath.oneIf(Bool.and(value >= lower, value < upper))), Domain.ScriptState.withStack(state, deeper))

verify inRange
    inRange(3, 1, 5, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    inRange(1, 1, 5, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[1]]))
    inRange(5, 1, 5, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[]]))
    inRange(0, 1, 5, [], Domain.ScriptState.empty()) => Step.Continue(Domain.ScriptState.holding([[]]))
