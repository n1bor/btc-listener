    case("", [Prevout(txid = "fc4b1e0daa8d9fd7280141dea931dbad1485e2506afd12f5bb126fa2ebc3f85f", index = 0, script = "001491b24bf9f5288532960ac687abb035127b1d28a5", amount = 0)]) => Outcome.Decided(Ending.Failed("a twenty byte witness program needs exactly two witness items, not 3"))
    // Core: invalid  flags P2SH,WITNESS  -- P2WPKH with non-empty scriptSig
    case("", [Prevout(txid = "fc4b1e0daa8d9fd7280141dea931dbad1485e2506afd12f5bb126fa2ebc3f85f", index = 0, script = "001491b24bf9f5288532960ac687abb035127b1d28a5", amount = 0)]) => Outcome.Decided(Ending.Failed("witness program spent with a non-empty input script"))
