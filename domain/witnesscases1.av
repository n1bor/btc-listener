module WitnessCases1
    intent =
        "The Witness rows of Bitcoin Core's script_tests.json: part 1 of 3."
        "A Witness belongs to an Input and these rows do not carry one, so"
        "Core's harness builds two Transactions around each pair and this"
        "reproduces that construction exactly -- BuildCreditingTransaction and"
        "BuildSpendingTransaction from src/test/util/transaction_utils.cpp."
        "That makes them whole Transactions spending one known Output, which"
        "is the shape Domain.TxCase runs, so they join the corpus there rather"
        "than beside the Script pairs."
        "The answer recorded is this engine's, not Core's, so this is a"
        "regression corpus and not a conformance one. What Core says is on the"
        "comment above each case, and where the two differ the case records"
        "what this engine does today."
        "Standing as this was generated: 108 cases, 85 agree with"
        "Core, 23 disagree, 0 this engine cannot answer."
        "Nothing here was written by hand and nothing should be. Regenerate it"
        "with tools/witness_tests_to_aver.py."
    exposes [case]
    depends [Domain.ScriptState, Domain.TxCase]
    effects []

fn case(rawHex: String, prevouts: List<Prevout>) -> Outcome
    ? "One whole Transaction, its single Input run against the Output Core's"
      "harness credited it with."
    Domain.TxCase.verdict(rawHex, prevouts)

verify case
    // Core: invalid  flags P2SH,WITNESS  -- Invalid witness script
    case("01000000000101be50a17b341db121965b180b59c2f221b9717922c2ce9dfe8c16cdaaec9996e70000000000ffffffff0100000000000000000001010000000000", [Prevout(txid = "e79699ecaacd168cfe9dcec2227971b921f2c2590b185b9621b11d347ba150be", index = 0, script = "00206e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d", amount = 0)]) => Outcome.Decided(Ending.Failed("script left a false value on top"))
    // Core: invalid  flags P2SH,WITNESS  -- Witness script hash mismatch
    case("01000000000101be50a17b341db121965b180b59c2f221b9717922c2ce9dfe8c16cdaaec9996e70000000000ffffffff0100000000000000000001015100000000", [Prevout(txid = "e79699ecaacd168cfe9dcec2227971b921f2c2590b185b9621b11d347ba150be", index = 0, script = "00206e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d", amount = 0)]) => Outcome.Decided(Ending.Failed("the witness script does not hash to the program the output committed to"))
    // Core: valid  flags   -- Invalid witness script without WITNESS
    case("01000000000101be50a17b341db121965b180b59c2f221b9717922c2ce9dfe8c16cdaaec9996e70000000000ffffffff0100000000000000000001010000000000", [Prevout(txid = "e79699ecaacd168cfe9dcec2227971b921f2c2590b185b9621b11d347ba150be", index = 0, script = "00206e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d", amount = 0)]) => Outcome.Decided(Ending.Failed("script left a false value on top"))
    // Core: valid  flags   -- Witness script hash mismatch without WITNESS
    case("01000000000101be50a17b341db121965b180b59c2f221b9717922c2ce9dfe8c16cdaaec9996e70000000000ffffffff0100000000000000000001015100000000", [Prevout(txid = "e79699ecaacd168cfe9dcec2227971b921f2c2590b185b9621b11d347ba150be", index = 0, script = "00206e340b9cffb37a989ca544e6bb780a2c78901d3fb33738768511a30617afa01d", amount = 0)]) => Outcome.Decided(Ending.Failed("the witness script does not hash to the program the output committed to"))
    // Core: invalid  flags P2SH,WITNESS  -- OP_1NEGATE does not introduce a witness program
    case("010000000001011a68ec44ac4b80b4062b8f7b048f0def004d648038dd96a53f4080e27f6032b00000000000ffffffff0100000000000000000001015100000000", [Prevout(txid = "b032607fe280403fa596dd3880644d00ef0d8f047b8f2b06b4804bac44ec681a", index = 0, script = "4f021234", amount = 0)]) => Outcome.Decided(Ending.Failed("the input carries witness data and its output is not a witness program"))
    // Core: invalid  flags P2SH,WITNESS  -- OP_1 does introduce a witness program
    case("010000000001013a0c3be33b7a71f692a727c9e2daa53791d0fcc1a99df4f85569cb2f0f6651ea000000000100ffffffff0100000000000000000001015100000000", [Prevout(txid = "ea51660f2fcb6955f8f49da9c1fcd09137a5dae2c927a792f6717a3be33b0c3a", index = 0, script = "51021234", amount = 0)]) => Outcome.Decided(Ending.Failed("witness program spent with a non-empty input script"))
    // Core: invalid  flags P2SH,WITNESS  -- OP_16 does introduce a witness program
    case("010000000001019b775026d3e070daf98e731737710c04564b01eeba6c1c45dd3de69fcf93e504000000000100ffffffff0100000000000000000001015100000000", [Prevout(txid = "04e593cf9fe63ddd451c6cbaee014b56040c713717738ef9da70e0d32650779b", index = 0, script = "60021234", amount = 0)]) => Outcome.Decided(Ending.Failed("witness program spent with a non-empty input script"))
    // Core: invalid  flags P2SH,WITNESS  -- NOP does not introduce a witness program
    case("010000000001011860d6f67cf47932afdcf9309936167198a4b899105186a9be5897aa3b30023c0000000000ffffffff0100000000000000000001015100000000", [Prevout(txid = "3c02303baa9758bea986511099b8a4987116369930f9dcaf3279f47cf6d66018", index = 0, script = "61021234", amount = 0)]) => Outcome.Decided(Ending.Failed("the input carries witness data and its output is not a witness program"))
    // Core: valid  flags P2SH,WITNESS  -- Basic P2WSH
    case("", [Prevout(txid = "6f6d4307b8f805d26c3ff8c01afe4a91e5bc7971f6f071d224dcf0b9881d4990", index = 0, script = "0020b95237b48faaa69eb078e1170be3b5cbb3fddf16d0a991e14ad274f7b33a4f64", amount = 1)]) => Outcome.Decided(Ending.Passed)
