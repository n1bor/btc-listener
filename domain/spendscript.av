module SpendScript
    intent =
        "Running the two Scripts a spend is made of, in the order Bitcoin runs"
        "them."
        "An Input's Script and the Output's Script are not two questions. The"
        "Input's runs first and leaves things on the stack; the Output's runs on"
        "what it left. Running either on its own answers nothing: a P2PKH Output"
        "Script on an empty stack dies at its first OP_DUP, and an Input Script"
        "on its own is a couple of pushes that prove nothing. The spike in ADR"
        "0005 did exactly that and reported a reach it did not have."
        "Only the stack carries between them. The opcode count starts again and"
        "the condition stack has to be empty at the end of each, which is why"
        "an OP_IF opened in the Input's Script cannot be closed by the Output's."
        "A witness program is refused before it is run rather than after. What"
        "it means to an engine that cannot read it is not failure but success,"
        "which is the one kind of wrong answer this project cannot afford."
        "P2SH is here, and it arrived in the same change as RIPEMD-160 for the"
        "reason this note used to give for its absence: a P2SH Output Script is"
        "OP_HASH160, a push and OP_EQUAL, so until OP_HASH160 could answer the"
        "engine stopped on the first opcode and the redeem script was never"
        "reached. The moment it could answer, the re-run stopped being a branch"
        "nothing enters and became the difference between a right answer and a"
        "false pass -- because OP_HASH160 and OP_EQUAL only prove that the"
        "redeem script is the one committed to, and say nothing at all about"
        "whether it runs."
    exposes [check, Outcomes, noOutcomes, count, merged]
    depends [Bytes, Domain.Primitives, Domain.PrimitiveStub, Domain.Interp, Domain.Script, Domain.ScriptParse, Domain.ScriptState, Domain.SpendContext]
    effects []

fn check(inputScriptHex: String, outputScriptHex: String, context: Context) -> Outcome
    ? "Whether this Input is allowed to spend this Output."
      "Undecided is the honest answer for almost every real spend today, and"
      "the count of them is the measure of how much of consensus this checks."
      "The ten thousand byte limit applies to each Script on its own and is"
      "applied here rather than left to Domain.Interp.run, which this does not"
      "go through. Core's own corpus caught that: it has a case with an"
      "oversized Output Script that this accepted until the limit was put back."
    match Bool.or(tooLong(inputScriptHex), tooLong(outputScriptHex))
        true -> Outcome.Decided(Ending.Failed("script is over the {Domain.ScriptState.maxScript()} byte limit"))
        false -> notWitness(inputScriptHex, outputScriptHex, context)

verify check
    given hash: Domain.Primitives.ripemd160 = [Domain.PrimitiveStub.ripemd160]
    given sig: Domain.Primitives.verifySignature = [Domain.PrimitiveStub.verifySignature]
    check("51", "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    check(signedInput(), Domain.SpendContext.signedScriptCode(), Domain.SpendContext.bare()) => Outcome.Undecided("OP_CHECKSIG needs the transaction its signature commits to")
    check(signedInput(), Domain.SpendContext.signedScriptCode(), spendOfCorpusVector()) => Outcome.Decided(Ending.Passed)
    check(Domain.ScriptState.longScript(), "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("script is over the 10000 byte limit"))
    check("51", Domain.ScriptState.longScript(), Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("script is over the 10000 byte limit"))
    check("", "0014751e76e8199196d454941c45d1b3a323f1433bd6", Domain.SpendContext.bare()) => Outcome.Undecided("output is a witness program and needs the witness evaluated")

fn signedInput() -> String
    ? "The Input Script of the first Transaction in Bitcoin Core's legacy"
      "signature hash corpus: one push of a real signature."
    "47304402204e45e16932b8af514961a1d3a1a25fdf3f4f7732e9d624c6c61548ab5fb8cd410220181522ec8eca07de4860a4acdd12909d831cc56cbbac4622082221a8768d1d0901"

verify signedInput
    String.len(signedInput()) => 144

fn spendOfCorpusVector() -> Context
    ? "That Transaction's only Input, against the Output it spends."
      "It is here to hold the two cases above apart, and they are the whole"
      "evidence that a spend now runs end to end. Bare, the engine says it"
      "needs a Transaction and stays undecided. Committed, it builds the"
      "message, hands it to the curve and comes back passed -- which is the"
      "right answer, because this is the first spend Bitcoin ever made and it"
      "is a good one."
    Domain.SpendContext.committed(Domain.SpendContext.signedTransaction(), 0, 0, Domain.SpendContext.signedScriptCode())

verify spendOfCorpusVector
    Domain.SpendContext.scriptCodeOf(spendOfCorpusVector()) => Domain.SpendContext.signedScriptCode()

fn notWitness(inputScriptHex: String, outputScriptHex: String, context: Context) -> Outcome
    ? "A witness program cannot be answered by running it, and running it"
      "anyway does not fail -- it passes, which is worse."
      "Segwit was deployed as a soft fork, which means a witness program had to"
      "look valid to every node that could not read it: a version byte and a"
      "push of a hash, which under the old rules leaves the hash on top of the"
      "stack and comes out true. An engine with no witness evaluation therefore"
      "calls every segwit spend valid, silently and confidently, and over a"
      "recent Block that is nine spends in ten."
      "This was found by running three Blocks from 2023 and getting 6,363"
      "passes out of an engine that has never verified a signature. The number"
      "was real and meant nothing."
    match Domain.Script.isAnyWitnessProgram(outputScriptHex)
        true -> Outcome.Undecided("output is a witness program and needs the witness evaluated")
        false -> parsed(inputScriptHex, outputScriptHex, context)

verify notWitness
    notWitness("51", "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    notWitness("", "0014751e76e8199196d454941c45d1b3a323f1433bd6", Domain.SpendContext.bare()) => Outcome.Undecided("output is a witness program and needs the witness evaluated")
    notWitness("", "5120a60869f0dbcf1dc659c9cecbaf8050135ea9e8cdc487053f1dc6880949dc684c", Domain.SpendContext.bare()) => Outcome.Undecided("output is a witness program and needs the witness evaluated")
    notWitness("51", "00", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("script left a false value on top"))

fn tooLong(scriptHex: String) -> Bool
    ? "Two hexadecimal characters to the byte."
    String.len(scriptHex) > Domain.ScriptState.maxScript() * 2

verify tooLong
    tooLong("51") => false
    tooLong(Domain.ScriptState.longScript()) => true

fn parsed(inputScriptHex: String, outputScriptHex: String, context: Context) -> Outcome
    ? "Parse the Input's Script and run the pair."
    match Domain.ScriptParse.opsIn(inputScriptHex)
        Result.Err(message) -> Outcome.Decided(Ending.Failed("input script: {message}"))
        Result.Ok(ops) -> afterInput(ops, outputScriptHex, context)

verify parsed
    given hash: Domain.Primitives.ripemd160 = [Domain.PrimitiveStub.ripemd160]
    given sig: Domain.Primitives.verifySignature = [Domain.PrimitiveStub.verifySignature]
    parsed("51", "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    parsed("51", "00", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("script left a false value on top"))
    parsed("", "", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("script left nothing on the stack"))
    parsed("5152", "935387", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    parsed("02aa", "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("input script: push of 2 bytes runs past the end of the script"))
    parsed("51", "02aa", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("output script: push of 2 bytes runs past the end of the script"))
    parsed("6a", "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("OP_RETURN"))
    parsed("51", "a9", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    parsed("5163", "68", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("input script ended inside an unclosed OP_IF"))

fn afterInput(ops: List<Op>, outputScriptHex: String, context: Context) -> Outcome
    ? "The Input's Script, run for the stack it leaves rather than for a"
      "verdict. The Ops travel on as well as the stack, because P2SH needs to"
      "know whether this half was push-only."
    match Domain.Interp.reach(ops, Domain.ScriptState.empty(), context)
        Step.Stop(outcome) -> outcome
        Step.Continue(state) -> closedOrNot(ops, state, outputScriptHex, context)

verify afterInput
    afterInput([Op.Code(81)], "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    afterInput([Op.Code(106)], "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("OP_RETURN"))
    afterInput([Op.Code(169)], "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("OP_HASH160 needs an item"))

fn closedOrNot(ops: List<Op>, state: State, outputScriptHex: String, context: Context) -> Outcome
    ? "A branch opened in the Input's Script cannot be closed by the Output's."
      "Each Script is its own run and the condition stack does not survive it,"
      "which is a rule people are surprised by until they think about who"
      "supplies each half."
    match state.conditions
        [] -> withOutput(ops, state, outputScriptHex, context)
        [head, ..tail] -> Outcome.Decided(Ending.Failed("input script ended inside an unclosed OP_IF"))

verify closedOrNot
    closedOrNot([], Domain.ScriptState.empty(), "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    closedOrNot([], State(stack = [], alt = [], conditions = [true], opCount = 0), "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("input script ended inside an unclosed OP_IF"))
    closedOrNot([], Domain.ScriptState.empty(), "a9", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("OP_HASH160 needs an item"))

fn withOutput(ops: List<Op>, state: State, outputScriptHex: String, context: Context) -> Outcome
    ? "The Output's Script, on the stack the Input's Script left."
      "Only the stack carries over. holding gives a fresh opcode count and no"
      "open branch, which is what starting a new Script means."
    match Domain.ScriptParse.opsIn(outputScriptHex)
        Result.Err(message) -> Outcome.Decided(Ending.Failed("output script: {message}"))
        Result.Ok(outputOps) -> orRedeemed(Domain.Interp.evaluate(outputOps, Domain.ScriptState.holding(state.stack), context), ops, state, outputScriptHex, context)

verify withOutput
    withOutput([], Domain.ScriptState.empty(), "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    withOutput([], Domain.ScriptState.empty(), "02aa", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("output script: push of 2 bytes runs past the end of the script"))
    withOutput([], Domain.ScriptState.empty(), "a9", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("OP_HASH160 needs an item"))
    withOutput([], Domain.ScriptState.holding([[1], [1]]), "87", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)

fn orRedeemed(outcome: Outcome, ops: List<Op>, state: State, outputScriptHex: String, context: Context) -> Outcome
    ? "A P2SH Output Script that passed has proved one thing only: that the"
      "last item the Input Script pushed hashes to the value the Output"
      "committed to. Whether that item is a Script that runs is a separate"
      "question and this is where it gets asked."
    match redeemable(outcome, ops, outputScriptHex)
        false -> outcome
        true -> redeemed(state, context)

verify orRedeemed
    orRedeemed(Outcome.Decided(Ending.Passed), [Op.Code(81)], Domain.ScriptState.empty(), "51", Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    orRedeemed(Outcome.Undecided("no"), [Op.Code(81)], Domain.ScriptState.empty(), "51", Domain.SpendContext.bare()) => Outcome.Undecided("no")

fn redeemable(outcome: Outcome, ops: List<Op>, outputScriptHex: String) -> Bool
    ? "Only a passing run of a P2SH Output Script is re-run, and only when the"
      "Input Script was push-only, which BIP16 requires and which is what stops"
      "the Input Script from arranging the stack the redeem script sees."
    Bool.and(passed(outcome), Bool.and(Domain.Script.isPayToScriptHash(Domain.Script.bytesOf(outputScriptHex)), pushOnly(ops)))

verify redeemable
    redeemable(Outcome.Decided(Ending.Passed), [Op.Code(81)], "51") => false
    redeemable(Outcome.Decided(Ending.Passed), [Op.Code(81)], "a9140766b3e86a21a11b52c874d18e2dcf22d81fc38087") => true
    redeemable(Outcome.Decided(Ending.Failed("no")), [Op.Code(81)], "a9140766b3e86a21a11b52c874d18e2dcf22d81fc38087") => false
    redeemable(Outcome.Decided(Ending.Passed), [Op.Code(118)], "a9140766b3e86a21a11b52c874d18e2dcf22d81fc38087") => false

fn passed(outcome: Outcome) -> Bool
    ? "Whether a run came out passed, as a Bool for a caller that wants to ask"
      "rather than to match."
    match outcome
        Outcome.Decided(ending) -> endedPassed(ending)
        Outcome.Undecided(reason) -> false

verify passed
    passed(Outcome.Decided(Ending.Passed)) => true
    passed(Outcome.Decided(Ending.Failed("no"))) => false
    passed(Outcome.Undecided("no")) => false

fn endedPassed(ending: Ending) -> Bool
    ? "The Passed half of an Ending."
    match ending
        Ending.Passed -> true
        Ending.Failed(message) -> false

verify endedPassed
    endedPassed(Ending.Passed) => true
    endedPassed(Ending.Failed("no")) => false

fn pushOnly(ops: List<Op>) -> Bool
    ? "Whether every Op only puts something on the stack. OP_0 through OP_16"
      "and OP_1NEGATE are pushes despite being Codes, which is why the test is"
      "on the opcode number rather than on the constructor."
    match ops
        [] -> true
        [head, ..tail] -> pushOnlyFrom(isPush(head), tail)

verify pushOnly
    pushOnly([]) => true
    pushOnly([Op.Code(81), Op.Push(2, [1, 2])]) => true
    pushOnly([Op.Code(118)]) => false

fn pushOnlyFrom(soFar: Bool, rest: List<Op>) -> Bool
    ? "The rest of the Ops, once the one before them has been judged. Split"
      "out so that neither half holds a call open while the other runs."
    match soFar
        false -> false
        true -> pushOnly(rest)

verify pushOnlyFrom
    pushOnlyFrom(false, []) => false
    pushOnlyFrom(true, []) => true
    pushOnlyFrom(true, [Op.Code(118)]) => false

fn isPush(op: Op) -> Bool
    ? "One Op, by the same rule."
    match op
        Op.Push(code, bytes) -> true
        Op.Code(code) -> code <= 96

verify isPush
    isPush(Op.Push(2, [1, 2])) => true
    isPush(Op.Code(96)) => true
    isPush(Op.Code(97)) => false

fn redeemed(state: State, context: Context) -> Outcome
    ? "The redeem script is the last item the Input Script pushed, and it is"
      "run on the stack underneath it."
    match state.stack
        [] -> Outcome.Decided(Ending.Failed("P2SH input script left nothing to redeem"))
        [head, ..tail] -> redeemedWith(head, tail, context)

verify redeemed
    redeemed(Domain.ScriptState.empty(), Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("P2SH input script left nothing to redeem"))
    redeemed(Domain.ScriptState.holding([[81]]), Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)

fn redeemedWith(redeem: List<Int>, rest: List<List<Int>>, context: Context) -> Outcome
    ? "The redeem script parsed and run. A redeem script that does not parse"
      "fails the spend rather than going undecided: it was committed to by"
      "hash, so there is nothing further to learn about it."
      "A signature inside a redeem script is taken over the redeem script, not"
      "over the P2SH Output Script that committed to it, so the Script code"
      "moves here."
    match Domain.ScriptParse.parse(redeem)
        Result.Err(message) -> Outcome.Decided(Ending.Failed("redeem script: {message}"))
        Result.Ok(ops) -> Domain.Interp.evaluate(ops, Domain.ScriptState.holding(rest), Domain.SpendContext.overScript(context, hexOf(redeem)))

verify redeemedWith
    redeemedWith([81], [], Domain.SpendContext.bare()) => Outcome.Decided(Ending.Passed)
    redeemedWith([0], [], Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("script left a false value on top"))
    redeemedWith([2, 170], [], Domain.SpendContext.bare()) => Outcome.Decided(Ending.Failed("redeem script: push of 2 bytes runs past the end of the script"))

fn hexOf(script: List<Int>) -> String
    ? "A Script back as hexadecimal, for the Script code a signature in it is"
      "taken over. Bytes that came off a stack are bytes, so the failure"
      "branch is unreachable and answers with nothing rather than aborting."
    Bytes.toHex(Result.withDefault(Bytes.fromList(script), Bytes.fromList([])))

verify hexOf
    hexOf([]) => ""
    hexOf([81]) => "51"
    hexOf([169, 20]) => "a914"

record Outcomes
    passed: Int
    failed: Int
    undecided: Int

fn noOutcomes() -> Outcomes
    ? "Nothing run yet."
    Outcomes(passed = 0, failed = 0, undecided = 0)

verify noOutcomes
    noOutcomes() => Outcomes(passed = 0, failed = 0, undecided = 0)

fn count(counts: Outcomes, outcome: Outcome) -> Outcomes
    ? "Fold one spend's answer into a running total."
      "Undecided is counted apart from failed rather than folded into it,"
      "which is the same rule the audit already applies to unresolved Inputs."
      "Over real Blocks almost everything is Undecided, and a count that hid"
      "that would look like a passing check and be nothing of the sort."
    match outcome
        Outcome.Undecided(why) -> Outcomes(passed = counts.passed, failed = counts.failed, undecided = counts.undecided + 1)
        Outcome.Decided(ending) -> settled(counts, ending)

verify count
    count(noOutcomes(), Outcome.Undecided("x")) => Outcomes(passed = 0, failed = 0, undecided = 1)
    count(noOutcomes(), Outcome.Decided(Ending.Passed)) => Outcomes(passed = 1, failed = 0, undecided = 0)
    count(noOutcomes(), Outcome.Decided(Ending.Failed("x"))) => Outcomes(passed = 0, failed = 1, undecided = 0)

fn settled(counts: Outcomes, ending: Ending) -> Outcomes
    ? "Nested constructor patterns do not parse, so the Ending is matched apart."
    match ending
        Ending.Passed -> Outcomes(passed = counts.passed + 1, failed = counts.failed, undecided = counts.undecided)
        Ending.Failed(why) -> Outcomes(passed = counts.passed, failed = counts.failed + 1, undecided = counts.undecided)

verify settled
    settled(noOutcomes(), Ending.Passed) => Outcomes(passed = 1, failed = 0, undecided = 0)
    settled(noOutcomes(), Ending.Failed("x")) => Outcomes(passed = 0, failed = 1, undecided = 0)

fn merged(left: Outcomes, right: Outcomes) -> Outcomes
    ? "Two totals added together, for rolling a Transaction into a Block."
    Outcomes(passed = left.passed + right.passed, failed = left.failed + right.failed, undecided = left.undecided + right.undecided)

verify merged
    merged(noOutcomes(), noOutcomes()) => noOutcomes()
    merged(Outcomes(passed = 1, failed = 2, undecided = 3), Outcomes(passed = 10, failed = 20, undecided = 30)) => Outcomes(passed = 11, failed = 22, undecided = 33)
