module ScriptWork
    intent =
        "A Block's Script pairs, and how they are divided between branches."
        "Pure, all of it. Resolving an Input is where a spend touches the disk"
        "and the database; once that is done what is left is an Input, the"
        "Output it spends, the Rules and the Context, and none of it needs"
        "anything outside the branch it runs in. That is what makes it work an"
        "independent product can carry."
        "Apart from Infra.Spends because the two are different jobs -- finding"
        "out what an Input spends, and deciding how to divide what follows --"
        "and because the pair of them do not fit in one file."
        "The division is greedy longest-processing-time: sort the Transactions"
        "by Input count, then put each on the branch carrying the least so far."
        "A Block of 274 Transactions has a median of one Input and a tail"
        "reaching 468, so any division that ignores the sizes leaves one branch"
        "holding a Transaction every other branch waits on."
        "Measured on Blocks 250000-250050, three interleaved runs each:"
        "  sequential                 54.2 s   99% cpu"
        "  sorted, cut into runs      45.7 s  127% cpu"
        "  sorted, dealt round-robin  38.4 s  180% cpu"
        "Cutting a sorted list into contiguous runs is the worst of the three,"
        "because it hands one branch the widest Transactions in the Block."
    exposes [Work, Pending, Piece, Bin, piecesOf, divided, branchCount, sampleWork, manyWork, samplePending, samplePiece, manyPiece]
    depends [Domain.Bip341, Domain.Spend, Domain.SpendContext, Domain.Transaction]
    effects []

record Pending
    index: Int
    input: Input
    spend: Spend

record Work
    transaction: Transaction
    tally: Tally
    spent: List<Pending>

record Piece
    transaction: Transaction
    position: Int
    spent: Pending
    weight: Int
    prevouts: List<Spent>

record Bin
    load: Int
    work: List<Piece>

fn branchCount() -> Int
    ? "How many branches a Block is divided into."
      "Near the core count and a little under it, because the sequential part"
      "of the walk is still running and the machine is not otherwise idle."
    16

verify branchCount
    branchCount() > 0 => true

fn binCount(units: Int) -> Int
    ? "Never more branches than there are Transactions to fill them."
    match units < branchCount()
        true -> units
        false -> branchCount()

verify binCount
    binCount(0) => 0
    binCount(5) => 5
    binCount(953) => branchCount()

fn piecesOf(work: List<Work>, position: Int, acc: List<Piece>) -> List<Piece>
    ? "One unit of work per Input, not per Transaction."
      "A Transaction cannot be split across branches and some of them are very"
      "wide: Block 250000 has one with 58 Inputs beside a hundred with one, and"
      "binning by Transaction left that one alone in a branch for 145 ms while"
      "fourteen other branches finished in 26 ms and waited."
      "The weight is the Input count of the Transaction the Input belongs to,"
      "not one. A legacy signature hash re-serialises the whole Transaction for"
      "every Input it signs, so an Input of a wide Transaction costs more than"
      "an Input of a narrow one -- measured at 2.50 ms against 0.68 ms in that"
      "same Block. Weighting by one would balance the count and not the time."
    match work
        [] -> List.reverse(acc)
        [head, ..tail] -> piecesOf(tail, position + 1, spread(head, position, head.spent, acc))

verify piecesOf
    piecesOf([], 0, []) => []
    List.len(piecesOf([sampleWork()], 0, [])) => 1
    List.len(piecesOf([wideWork()], 0, [])) => 3

fn spread(owner: Work, position: Int, spent: List<Pending>, acc: List<Piece>) -> List<Piece>
    ? "Each Input of one Transaction as its own piece of work."
      "The spent Outputs and the weight are worked out once here and handed to"
      "every Piece, rather than by each Piece for itself. Both are properties"
      "of the Transaction and neither varies by Input, and doing them per"
      "Piece made a Transaction with N Inputs allocate N lists of N Outputs"
      "and walk N Inputs N times -- quadratic in the Input count, on the one"
      "path every Input of every Block goes through. n1bor/btc-listener#77."
    spreadOver(owner, position, spent, spentOutputs(owner.spent, []), List.len(owner.spent), acc)

verify spread
    spread(sampleWork(), 0, [], []) => []
    List.len(spread(wideWork(), 0, wideWork().spent, [])) => 3

fn spreadOver(owner: Work, position: Int, spent: List<Pending>, prevouts: List<Spent>, weight: Int, acc: List<Piece>) -> List<Piece>
    ? "The same walk, with the two Transaction-wide values already in hand."
      "They are passed rather than recomputed, so every Piece of one"
      "Transaction holds the same list value -- which is what makes the rope"
      "share it instead of copying it."
    match spent
        [] -> acc
        [head, ..tail] -> spreadOver(owner, position, tail, prevouts, weight, List.prepend(pieceFor(owner, position, head, prevouts, weight), acc))

verify spreadOver
    spreadOver(sampleWork(), 0, [], [], 0, []) => []
    List.len(spreadOver(wideWork(), 0, wideWork().spent, [], 3, [])) => 3

fn spentOutputs(spent: List<Pending>, acc: List<Spent>) -> List<Spent>
    ? "Every Input's spent Output, in Input order, as Taproot needs them."
      "The same list on every Piece of one Transaction, which costs nothing:"
      "an AverList is a rope and they share the one value."
      "In order and complete or not at all. An Input whose Output is not held"
      "would shift every later index if it were left out, so a gap abandons"
      "the list and Domain.Bip341 refuses a message whose count does not match"
      "the Input count. That is undecided, which is what an Output we have not"
      "got should give -- never a hash over the wrong bytes."
    match spent
        [] -> List.reverse(acc)
        [head, ..tail] -> spentOne(head, tail, acc)

verify spentOutputs
    spentOutputs([], []) => []

fn spentOne(one: Pending, rest: List<Pending>, acc: List<Spent>) -> List<Spent>
    ? "One Input's Output, when it resolved."
    match one.spend
        Spend.Resolved(value, script) -> spentOutputs(rest, List.prepend(Spent(amount = value, script = script), acc))
        Spend.Unknown(why) -> []
        Spend.Invalid(why) -> []

verify spentOne
    spentOne(samplePending(), [], []) => [Spent(amount = 5, script = "51")]
    spentOne(Pending(index = 0, input = Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), spend = Spend.Unknown("no")), [], []) => []

fn pieceFor(owner: Work, position: Int, spent: Pending, prevouts: List<Spent>, weight: Int) -> Piece
    ? "One Input of one Transaction, weighted by how wide that Transaction is."
      "The Transaction's whole list of spent Outputs rides along, because a"
      "Taproot signature commits to all of them and the Piece is only one"
      "Input. It arrives as an argument rather than being built here, so all"
      "the Pieces of one Transaction hold one list rather than N copies of it."
    Piece(transaction = owner.transaction, position = position, spent = spent, weight = weight, prevouts = prevouts)

verify pieceFor
    pieceFor(sampleWork(), 0, samplePending(), [], 1).weight => 1
    pieceFor(wideWork(), 2, samplePending(), [], 3).weight => 3
    pieceFor(wideWork(), 2, samplePending(), [], 3).position => 2

fn divided(units: List<Piece>) -> List<List<Piece>>
    ? "The Block's Inputs split between branches, heaviest first."
    loads(packed(heaviestFirst(units), emptyBins(binCount(List.len(units)), [])), [])

verify divided
    divided([]) => []
    List.len(divided([samplePiece()])) => 1
    List.len(divided(manyPiece(40, []))) => branchCount()

fn emptyBins(count: Int, acc: List<Bin>) -> List<Bin>
    ? "That many branches with nothing in them yet."
    match count <= 0
        true -> acc
        false -> emptyBins(count - 1, List.prepend(Bin(load = 0, work = []), acc))

verify emptyBins
    emptyBins(0, []) => []
    List.len(emptyBins(18, [])) => 18

fn packed(work: List<Piece>, bins: List<Bin>) -> List<Bin>
    ? "Each Transaction onto the branch carrying the least work so far."
      "Longest first, then greedily onto the lightest: the classic way to"
      "divide uneven work between a fixed number of workers, and within a"
      "third of the best possible division however the sizes fall."
      "The weight is the Input count, because an Input is one Script pair and"
      "a Script pair is what a branch spends its time on."
    match work
        [] -> bins
        [head, ..tail] -> packed(tail, intoLightest(head, bins))

verify packed
    packed([], []) => []
    List.len(packed(manyPiece(5, []), emptyBins(2, []))) => 2
    loadOf(packed(manyPiece(3, []), emptyBins(2, []))) => 3

fn loadOf(bins: List<Bin>) -> Int
    ? "How much work all the branches hold between them."
    match bins
        [] -> 0
        [head, ..tail] -> head.load + loadOf(tail)

verify loadOf
    loadOf([]) => 0
    loadOf(emptyBins(3, [])) => 0

fn intoLightest(one: Piece, bins: List<Bin>) -> List<Bin>
    ? "Put it in the first branch carrying the least."
    added(one, lightest(bins, 0 - 1), bins, [], false)

verify intoLightest
    List.len(intoLightest(samplePiece(), emptyBins(2, []))) => 2
    loadOf(intoLightest(samplePiece(), emptyBins(2, []))) => 1

fn lightest(bins: List<Bin>, best: Int) -> Int
    ? "The smallest load any branch is carrying."
    match bins
        [] -> best
        [head, ..tail] -> lightest(tail, lower(head.load, best))

verify lightest
    lightest([], 0 - 1) => 0 - 1
    lightest(emptyBins(3, []), 0 - 1) => 0

fn lower(load: Int, best: Int) -> Int
    ? "The smaller of the two, treating no answer yet as no limit."
    match Bool.or(best < 0, load < best)
        true -> load
        false -> best

verify lower
    lower(5, 0 - 1) => 5
    lower(5, 3) => 3
    lower(3, 5) => 3

fn added(one: Piece, target: Int, bins: List<Bin>, seen: List<Bin>, done: Bool) -> List<Bin>
    ? "Walk the branches and drop it into the first carrying the target load."
    match bins
        [] -> List.reverse(seen)
        [head, ..tail] -> addedHere(one, target, head, tail, seen, done)

verify added
    added(samplePiece(), 0, [], [], false) => []
    loadOf(added(samplePiece(), 0, emptyBins(2, []), [], false)) => 1

fn addedHere(one: Piece, target: Int, head: Bin, tail: List<Bin>, seen: List<Bin>, done: Bool) -> List<Bin>
    ? "This branch, if it is the one and nothing has taken it yet."
      "Prepended, not appended. List.concat(head.work, [one]) copies the whole"
      "branch every time something joins it, so filling a 328 Transaction"
      "Block cost a hundred thousand copies and made this packing slower than"
      "the round-robin it was meant to beat. The order within a branch does"
      "not matter -- every Transaction in it is checked either way -- so the"
      "reversal the prepend implies is never undone."
    match Bool.and(done == false, head.load == target)
        true -> added(one, target, tail, List.prepend(Bin(load = head.load + one.weight, work = List.prepend(one, head.work)), seen), true)
        false -> added(one, target, tail, List.prepend(head, seen), done)

verify addedHere
    loadOf(addedHere(samplePiece(), 0, Bin(load = 0, work = []), [], [], false)) => 1
    loadOf(addedHere(samplePiece(), 0, Bin(load = 0, work = []), [], [], true)) => 0

fn loads(bins: List<Bin>, acc: List<List<Piece>>) -> List<List<Piece>>
    ? "What each branch is to check."
    match bins
        [] -> List.reverse(acc)
        [head, ..tail] -> loads(tail, List.prepend(head.work, acc))

verify loads
    loads([], []) => []
    List.len(loads(emptyBins(3, []), [])) => 3

fn samplePiece() -> Piece
    ? "One Input of a one-Input Transaction, for the cases here."
    pieceFor(sampleWork(), 0, samplePending(), spentOutputs(sampleWork().spent, []), List.len(sampleWork().spent))

verify samplePiece
    samplePiece().weight => 1

fn manyPiece(count: Int, acc: List<Piece>) -> List<Piece>
    ? "That many of them."
    match count <= 0
        true -> acc
        false -> manyPiece(count - 1, List.prepend(samplePiece(), acc))

verify manyPiece
    List.len(manyPiece(0, [])) => 0
    List.len(manyPiece(5, [])) => 5

fn heaviestFirst(work: List<Piece>) -> List<Piece>
    ? "The Block's Transactions, most Inputs first."
      "Sorted by run rather than by Piece. Every Piece of one Transaction"
      "carries that Transaction's Input count as its weight, and piecesOf"
      "emits them together, so the list arrives as a handful of long runs of"
      "equal weight -- one per Transaction. Sorting the runs sorts the Pieces,"
      "and there are fifty of the first where there are fifteen thousand of"
      "the second."
      "It used to insert Piece by Piece into a sorted list, on the reasoning"
      "that almost every Transaction has one or two Inputs so the few long"
      "ones would travel a short way and the rest would not move at all. That"
      "holds for most of the chain and fails completely where it matters: in"
      "signet's dense era every Transaction has hundreds of Inputs, so every"
      "weight is large and, worse, *equal*. Equal is the worst case for that"
      "insertion -- the comparison is strictly greater-than, so a Piece never"
      "stops early and walks the whole sorted prefix, reversing and"
      "concatenating it. Fourteen thousand Pieces made about a hundred million"
      "element copies in two fresh lists apiece, and the peak was tens of"
      "gigabytes for one Block. n1bor/btc-listener#77."
    flattened(sortedRuns(runsOf(work, [], []), []), [])

verify heaviestFirst
    heaviestFirst([]) => []
    List.len(heaviestFirst(manyPiece(4, []))) => 4
    inputsIn(List.take(heaviestFirst(List.concat(manyPiece(2, []), [widePiece()])), 1)) => 3

fn widePiece() -> Piece
    ? "One Input of a three-Input Transaction, so it outweighs the others."
    pieceFor(wideWork(), 0, samplePending(), spentOutputs(wideWork().spent, []), List.len(wideWork().spent))

verify widePiece
    widePiece().weight => 3

fn runsOf(work: List<Piece>, run: List<Piece>, acc: List<List<Piece>>) -> List<List<Piece>>
    ? "The Pieces split into maximal stretches of one weight."
      "One pass. A stretch ends where the weight changes, which is where one"
      "Transaction ends and the next begins."
    match work
        [] -> List.reverse(closedRun(run, acc))
        [head, ..tail] -> runStep(head, tail, run, acc)

verify runsOf
    runsOf([], [], []) => []
    List.len(runsOf(manyPiece(3, []), [], [])) => 1
    List.len(runsOf(List.concat(manyPiece(2, []), [widePiece()]), [], [])) => 2

fn runStep(head: Piece, tail: List<Piece>, run: List<Piece>, acc: List<List<Piece>>) -> List<List<Piece>>
    ? "Keep the stretch going while the weight is the same."
    match sameWeight(head, run)
        true -> runsOf(tail, List.prepend(head, run), acc)
        false -> runsOf(tail, [head], closedRun(run, acc))

verify runStep
    List.len(runStep(samplePiece(), [], [], [])) => 1
    List.len(runStep(widePiece(), [], [samplePiece()], [])) => 2

fn sameWeight(one: Piece, run: List<Piece>) -> Bool
    ? "Whether this Piece belongs to the stretch being built."
      "An empty stretch takes anything, which is how the first one starts."
    match run
        [] -> true
        [head, ..tail] -> one.weight == head.weight

verify sameWeight
    sameWeight(samplePiece(), []) => true
    sameWeight(samplePiece(), [samplePiece()]) => true
    sameWeight(widePiece(), [samplePiece()]) => false

fn closedRun(run: List<Piece>, acc: List<List<Piece>>) -> List<List<Piece>>
    ? "Finish a stretch, unless there was not one."
      "Turned round here: it was built by prepending and its Pieces are"
      "interchangeable to the packer, but keeping Input order costs nothing"
      "and makes a branch's work read the way the Block does."
    match run
        [] -> acc
        [head, ..tail] -> List.prepend(List.reverse(run), acc)

verify closedRun
    closedRun([], []) => []
    List.len(closedRun([samplePiece()], [])) => 1

fn sortedRuns(runs: List<List<Piece>>, acc: List<List<Piece>>) -> List<List<Piece>>
    ? "The stretches, heaviest first."
      "Insertion again, and safe this time: there is one stretch per"
      "Transaction, so this is fifty items rather than fifteen thousand."
    match runs
        [] -> acc
        [head, ..tail] -> sortedRuns(tail, placedRun(head, acc, []))

verify sortedRuns
    sortedRuns([], []) => []
    List.len(sortedRuns(runsOf(List.concat(manyPiece(2, []), [widePiece()]), [], []), [])) => 2

fn placedRun(one: List<Piece>, sorted: List<List<Piece>>, seen: List<List<Piece>>) -> List<List<Piece>>
    ? "In front of the first stretch lighter than this one."
    match sorted
        [] -> List.concat(List.reverse(seen), [one])
        [head, ..tail] -> placedRunAgainst(one, head, tail, seen)

verify placedRun
    placedRun([samplePiece()], [], []) => [[samplePiece()]]
    List.len(placedRun([widePiece()], [[samplePiece()]], [])) => 2

fn placedRunAgainst(one: List<Piece>, head: List<Piece>, tail: List<List<Piece>>, seen: List<List<Piece>>) -> List<List<Piece>>
    ? "Compare against the next stretch along."
    match weightOf(one) > weightOf(head)
        true -> List.concat(List.reverse(seen), List.prepend(one, List.prepend(head, tail)))
        false -> placedRun(one, tail, List.prepend(head, seen))

verify placedRunAgainst
    List.len(placedRunAgainst([widePiece()], [samplePiece()], [], [])) => 2
    weightOf(firstRun(placedRunAgainst([widePiece()], [samplePiece()], [], []))) => 3

fn firstRun(runs: List<List<Piece>>) -> List<Piece>
    ? "The first stretch, for the cases here."
    match runs
        [] -> []
        [head, ..tail] -> head

verify firstRun
    firstRun([]) => []
    weightOf(firstRun([[widePiece()]])) => 3

fn weightOf(run: List<Piece>) -> Int
    ? "What a stretch weighs, which is what any one of its Pieces weighs."
    match run
        [] -> 0
        [head, ..tail] -> head.weight

verify weightOf
    weightOf([]) => 0
    weightOf([widePiece()]) => 3

fn flattened(runs: List<List<Piece>>, acc: List<Piece>) -> List<Piece>
    ? "The stretches back into one list, in the order they were sorted into."
    match runs
        [] -> acc
        [head, ..tail] -> flattened(tail, List.concat(acc, head))

verify flattened
    flattened([], []) => []
    List.len(flattened([[samplePiece()], [widePiece()]], [])) => 2

fn inputsIn(work: List<Piece>) -> Int
    ? "How many Inputs the Transactions in this list hold, for the cases here."
    match work
        [] -> 0
        [head, ..tail] -> head.weight + inputsIn(tail)

verify inputsIn
    inputsIn([]) => 0
    inputsIn([samplePiece()]) => 1
    inputsIn([widePiece()]) => 3

fn wideWork() -> Work
    ? "A resolved Transaction with three Inputs, for the sorting cases."
    Work(transaction = Domain.SpendContext.emptyTransaction(), tally = Domain.Spend.started(), spent = [samplePending(), samplePending(), samplePending()])

verify wideWork
    List.len(wideWork().spent) => 3

fn manyWork(count: Int, acc: List<Work>) -> List<Work>
    ? "That many copies of the same resolved Transaction, for the cases here."
    match count <= 0
        true -> acc
        false -> manyWork(count - 1, List.prepend(sampleWork(), acc))

verify manyWork
    List.len(manyWork(0, [])) => 0
    List.len(manyWork(5, [])) => 5

fn samplePending() -> Pending
    ? "One resolved Input whose Script pair passes, for the blocks above."
    Pending(index = 0, input = Input(previousTxid = "aa", previousIndex = 0, script = "51", sequence = 0, witness = []), spend = Spend.Resolved(5, "51"))

verify samplePending
    samplePending().index => 0

fn sampleWork() -> Work
    ? "One resolved Transaction with one passing Input, for the blocks above."
    Work(transaction = Domain.SpendContext.emptyTransaction(), tally = Domain.Spend.started(), spent = [samplePending()])

verify sampleWork
    List.len(sampleWork().spent) => 1
