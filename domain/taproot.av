module Taproot
    intent =
        "Spending a version one witness program: BIP341's key path."
        "The program is the output key itself, thirty-two bytes and x-only --"
        "no hash to preimage and no Script to reveal, which is what makes a"
        "key path spend the same size whatever tree stands behind it. Nothing"
        "on the chain distinguishes a key path spend of a bare key from one of"
        "an elaborate contract that nobody needed to open, and that was the"
        "point of the design rather than a side effect of it."
        "The script path is BIP342 and is not here. A Witness with more than"
        "one item after the annex comes off is one, and this says so and"
        "leaves it undecided rather than guessing."
        "The annex is a final Witness item beginning 0x50, present only when"
        "there are at least two items -- with one there is nothing to tell an"
        "annex from a signature. It has no meaning yet and is committed to"
        "anyway, so that giving it one later is a soft fork rather than a way"
        "to rewrite signatures already made."
    exposes [spend, annexOf, strippedOf, leafHashOf, joined, merkleRootFrom, commits]
    depends [Bytes, Domain.Bip341, Domain.CompactSize, Domain.Interp, Domain.Primitives, Domain.Rules, Domain.Schnorr, Domain.ScriptParse, Domain.ScriptState, Domain.SpendContext, Domain.Tagged, Domain.Transaction]
    effects []

fn spend(program: List<Int>, context: Context) -> Outcome
    ? "A Taproot spend, annex taken off before anything counts the Witness."
    witness = Domain.SpendContext.witnessOf(context)
    afterAnnex(program, annexOf(witness), strippedOf(witness), context)

verify spend
    spend(Domain.ScriptState.zeros(32), spending([])) => Outcome.Decided(Ending.Failed("a taproot spend needs a witness and got none"))
    spend(Domain.ScriptState.zeros(32), spending(["aa", "bb"])) => Outcome.Decided(Ending.Failed("the witness script does not match the taproot commitment"))

fn spending(witness: List<String>) -> Context
    ? "A Context with a Transaction behind it carrying this Witness."
      "The Transaction is the empty one, so any case reaching the message"
      "gets a refusal about the Input index rather than a real hash. The"
      "cases that need a real Transaction are BIP341's own, in the corpus."
    Domain.SpendContext.committed(Domain.Rules.latest(), Domain.Bip341.emptyTransaction(), 0, 0, "", witness)

verify spending
    Domain.SpendContext.hasSpend(spending([])) => true
    Domain.SpendContext.witnessOf(spending(["aa"])) => ["aa"]

fn afterAnnex(program: List<Int>, annex: Option<String>, witness: List<String>, context: Context) -> Outcome
    ? "One item left is a key path spend; more is a script path."
    match List.len(witness)
        0 -> Outcome.Decided(Ending.Failed("a taproot spend needs a witness and got none"))
        1 -> keyPath(program, witness, annex, context)
        _ -> scriptPath(program, witness, annex, context)

verify afterAnnex
    afterAnnex(Domain.ScriptState.zeros(32), Option.None, [], spending([])) => Outcome.Decided(Ending.Failed("a taproot spend needs a witness and got none"))
    afterAnnex(Domain.ScriptState.zeros(32), Option.None, ["aa", "bb"], spending([])) => Outcome.Decided(Ending.Failed("the witness script does not match the taproot commitment"))

fn scriptPath(program: List<Int>, witness: List<String>, annex: Option<String>, context: Context) -> Outcome
    ? "The last Witness item is the control block and the one before it is the"
      "Script. Everything under them is the stack the Script runs on."
      "The commitment is proved rather than signed: the control block carries"
      "the internal key and the Merkle path, and the Output key is that key"
      "tweaked by the root. Nobody signs to show the leaf was in the tree."
    control = lastOf(witness)
    leaf = lastOf(List.take(witness, List.len(witness) - 1))
    committed(program, control, leaf, List.take(witness, List.len(witness) - 2), annex, context)

verify scriptPath
    scriptPath(Domain.ScriptState.zeros(32), ["aa", "bb"], Option.None, spending([])) => Outcome.Decided(Ending.Failed("the witness script does not match the taproot commitment"))

fn committed(program: List<Int>, control: String, leaf: String, stack: List<String>, annex: Option<String>, context: Context) -> Outcome
    ? "A leaf that is not in the tree the Output committed to fails the spend."
    match commits(program, control, leaf)
        false -> Outcome.Decided(Ending.Failed("the witness script does not match the taproot commitment"))
        true -> byLeafVersion(leafVersionOf(control), control, leaf, stack, annex, context)

verify committed
    committed(Domain.ScriptState.zeros(32), "aa", "bb", [], Option.None, spending([])) => Outcome.Decided(Ending.Failed("the witness script does not match the taproot commitment"))

fn byLeafVersion(leafVersion: Int, control: String, leaf: String, stack: List<String>, annex: Option<String>, context: Context) -> Outcome
    ? "Leaf version 0xc0 is tapscript. Every other version is a leaf whose"
      "meaning has not been defined, and BIP341 says such a spend is valid --"
      "the commitment has been proved and there is no rule saying to run"
      "anything. Core only rejects it under a policy flag, which is the"
      "giveaway that it is not consensus."
    match leafVersion == 192
        false -> Outcome.Decided(Ending.Passed)
        true -> tapscript(control, leaf, stack, annex, context)

verify byLeafVersion
    byLeafVersion(80, "50", "51", [], Option.None, spending([])) => Outcome.Decided(Ending.Passed)
    byLeafVersion(192, "c0", "51", [], Option.None, spending([])) => Outcome.Decided(Ending.Passed)

fn tapscript(control: String, leaf: String, stack: List<String>, annex: Option<String>, context: Context) -> Outcome
    ? "A BIP342 leaf, run against the Witness under it."
      "OP_SUCCESS is asked first and asked of the whole Script, executed"
      "branches or not: BIP342 says that if the Script contains one anywhere,"
      "the spend is valid and nothing runs. That is what reserves the opcodes"
      "for later soft forks, and it means a Script holding one need not even"
      "parse past it."
    match hasSuccessOpcode(bytesIn(leaf))
        true -> Outcome.Decided(Ending.Passed)
        false -> parsedLeaf(control, leaf, stack, annex, context)

verify tapscript
    tapscript("c0", "50", [], Option.None, spending([])) => Outcome.Decided(Ending.Passed)
    tapscript("c0", "51", [], Option.None, spending([])) => Outcome.Decided(Ending.Passed)
    tapscript("c0", "00", [], Option.None, spending([])) => Outcome.Decided(Ending.Failed("script left a false value on top"))

fn parsedLeaf(control: String, leaf: String, stack: List<String>, annex: Option<String>, context: Context) -> Outcome
    ? "A leaf that does not parse fails the spend: it was committed to by"
      "hash, so there is nothing further to learn about it."
    match Domain.ScriptParse.parse(bytesIn(leaf))
        Result.Err(why) -> Outcome.Decided(Ending.Failed("tapscript leaf: {why}"))
        Result.Ok(ops) -> ranLeaf(ops, control, leaf, stack, annex, context)

verify parsedLeaf
    parsedLeaf("c0", "02aa", [], Option.None, spending([])) => Outcome.Decided(Ending.Failed("tapscript leaf: push of 2 bytes runs past the end of the script"))

fn ranLeaf(ops: List<Op>, control: String, leaf: String, stack: List<String>, annex: Option<String>, context: Context) -> Outcome
    ? "The leaf, over the Witness stack, under BIP341's message with BIP342's"
      "extension. The same cleanstack rule as version zero applies."
    cleanly(Domain.Interp.reach(ops, Domain.ScriptState.withBudget(Domain.ScriptState.holding(stackOf(stack, [])), budgetFor(context)), Domain.SpendContext.inTapscript(context, Domain.SpendContext.TapContext(leafHash = hexOf(leafHashOf(leafVersionOf(control), leaf)), annex = annex, codeSeparatorPosition = 4294967295))))

verify ranLeaf
    ranLeaf([], "c0", "51", [], Option.None, spending([])) => Outcome.Decided(Ending.Failed("a tapscript must leave exactly one item, not 0"))

fn budgetFor(context: Context) -> Int
    ? "BIP342's validation weight budget for this spend."
      "The serialised size of the whole Witness plus fifty. The whole Witness,"
      "not the stack the leaf runs over: the leaf itself, the control block"
      "and the annex are all in it and all paid for, which is what makes a"
      "deep Merkle proof cost something."
      "Fifty is one signature check, so a Witness carrying one signature can"
      "always afford to check it. Everything beyond that has to be bought with"
      "Witness bytes, which is the whole design -- it ties the cost of"
      "verifying a spend to the size of the thing being relayed."
    witnessSize(Domain.SpendContext.witnessOf(context), 0) + Domain.ScriptState.budgetOffset()

verify budgetFor
    budgetFor(spending([])) => 51
    budgetFor(Domain.SpendContext.committed(Domain.Rules.latest(), Domain.SpendContext.emptyTransaction(), 0, 0, "", ["aabb"])) => 54

fn witnessSize(items: List<String>, acc: Int) -> Int
    ? "How many bytes the Witness takes on the wire."
      "A CompactSize count in front, then each item with its own CompactSize"
      "length. Core measures it with GetSerializeSize over the stack, which is"
      "the same thing."
    List.len(Domain.CompactSize.encode(List.len(items))) + itemsSize(items, acc)

verify witnessSize
    witnessSize([], 0) => 1
    witnessSize(["aabb"], 0) => 4
    witnessSize(["aabb", "cc"], 0) => 6

fn itemsSize(items: List<String>, acc: Int) -> Int
    ? "Each item: its length, and a CompactSize saying so."
    match items
        [] -> acc
        [head, ..tail] -> itemsSize(tail, acc + List.len(Domain.CompactSize.encode(byteWidth(head))) + byteWidth(head))

verify itemsSize
    itemsSize([], 7) => 7
    itemsSize(["aabb"], 0) => 3

fn byteWidth(hex: String) -> Int
    ? "How many bytes a hexadecimal item stands for."
    Int.div(String.len(hex), 2)

verify byteWidth
    byteWidth("aabb") => 2
    byteWidth("") => 0

fn stackOf(hexes: List<String>, acc: List<List<Int>>) -> List<List<Int>>
    ? "The Witness items as bytes, top of stack first, as version zero does."
    match hexes
        [] -> acc
        [head, ..tail] -> stackOf(tail, List.prepend(bytesIn(head), acc))

verify stackOf
    stackOf([], []) => []
    stackOf(["01", "02"], []) => [[2], [1]]

fn cleanly(step: Step) -> Outcome
    ? "Inside a Witness the stack must hold exactly one true item at the end."
    match step
        Step.Stop(outcome) -> outcome
        Step.Continue(final) -> onlyOne(final)

verify cleanly
    cleanly(Step.Continue(Domain.ScriptState.holding([[1]]))) => Outcome.Decided(Ending.Passed)
    cleanly(Step.Continue(Domain.ScriptState.holding([[1], [1]]))) => Outcome.Decided(Ending.Failed("a tapscript must leave exactly one item, not 2"))

fn onlyOne(final: State) -> Outcome
    ? "One item, and it has to be true."
    match List.len(final.stack) == 1
        false -> Outcome.Decided(Ending.Failed("a tapscript must leave exactly one item, not {List.len(final.stack)}"))
        true -> Outcome.Decided(Domain.ScriptState.settled(final))

verify onlyOne
    onlyOne(Domain.ScriptState.holding([[1]])) => Outcome.Decided(Ending.Passed)
    onlyOne(Domain.ScriptState.holding([[0]])) => Outcome.Decided(Ending.Failed("script left a false value on top"))

fn hasSuccessOpcode(script: List<Int>) -> Bool
    ? "Whether the Script contains an OP_SUCCESS opcode."
      "Decoded, not scanned. A byte inside a push is data and not an opcode,"
      "and reading it as one is the difference between a Script that succeeds"
      "without running and a Script that runs -- so a 32 byte public key with"
      "an 0xea in it would make every Script holding one succeed."
      "Core walks with GetOp and asks IsOpSuccess of each opcode it decodes."
      "A push that runs past the end stops the walk and the Script is refused,"
      "which is why BIP342's an OP_SUCCESS makes an undecodable Script succeed"
      "only when it comes before the part that will not decode. Core's own"
      "comment says as much: the bad-opcode branch is not reached if an"
      "unknown OP_SUCCESSx was found."
    match script
        [] -> false
        [head, ..tail] -> successAt(head, tail)

verify hasSuccessOpcode
    hasSuccessOpcode([]) => false
    hasSuccessOpcode([81, 82]) => false
    hasSuccessOpcode([81, 80]) => true
    hasSuccessOpcode([187]) => true
    hasSuccessOpcode([1, 187]) => false
    hasSuccessOpcode([1, 187, 187]) => true
    hasSuccessOpcode([32, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234, 234]) => false
    hasSuccessOpcode([187, 1]) => true
    hasSuccessOpcode([1]) => false

fn successAt(head: Int, tail: List<Int>) -> Bool
    ? "This opcode, or the one after whatever data it carries."
    match isSuccessOpcode(head)
        true -> true
        false -> pastData(head, tail)

verify successAt
    successAt(187, []) => true
    successAt(81, [187]) => true
    successAt(1, [187]) => false

fn pastData(head: Int, tail: List<Int>) -> Bool
    ? "Step over a push's data before looking at the next opcode."
      "A push that does not fit is where the walk stops. Nothing after it is"
      "an opcode, because there is no way to know where the next one starts."
    match pushWidth(head, tail)
        Option.None -> false
        Option.Some(skip) -> hasSuccessOpcode(List.drop(tail, skip))

verify pastData
    pastData(1, [187]) => false
    pastData(1, [187, 187]) => true
    pastData(81, [187]) => true
    pastData(1, []) => false

fn pushWidth(head: Int, tail: List<Int>) -> Option<Int>
    ? "How many bytes of what follows this opcode are its data."
      "Nothing for an opcode that is not a push, its own value for a direct"
      "push, and a counted length for the three OP_PUSHDATA forms."
    match head
        76 -> countedWidth(tail, 1)
        77 -> countedWidth(tail, 2)
        78 -> countedWidth(tail, 4)
        _ -> directWidth(head, tail)

verify pushWidth
    pushWidth(81, []) => Option.Some(0)
    pushWidth(1, [7]) => Option.Some(1)
    pushWidth(1, []) => Option.None
    pushWidth(76, [1, 7]) => Option.Some(2)
    pushWidth(76, []) => Option.None

fn directWidth(head: Int, tail: List<Int>) -> Option<Int>
    ? "A byte from one to seventy-five pushes that many bytes."
    match Bool.and(head >= 1, head <= 75)
        false -> Option.Some(0)
        true -> enough(tail, head, head)

verify directWidth
    directWidth(81, []) => Option.Some(0)
    directWidth(1, [7]) => Option.Some(1)
    directWidth(2, [7]) => Option.None

fn countedWidth(tail: List<Int>, width: Int) -> Option<Int>
    ? "OP_PUSHDATA1, 2 and 4 carry their length in the next one, two or four"
      "bytes, little-endian."
    match List.len(tail) < width
        true -> Option.None
        false -> enough(tail, width + littleEndian(List.take(tail, width), 0, 1), width + littleEndian(List.take(tail, width), 0, 1))

verify countedWidth
    countedWidth([1, 7], 1) => Option.Some(2)
    countedWidth([], 1) => Option.None
    countedWidth([2, 7], 1) => Option.None

fn enough(tail: List<Int>, needed: Int, answer: Int) -> Option<Int>
    ? "The answer, unless the Script is shorter than the push says."
    match List.len(tail) < needed
        true -> Option.None
        false -> Option.Some(answer)

verify enough
    enough([1], 1, 1) => Option.Some(1)
    enough([], 1, 1) => Option.None

fn littleEndian(bytes: List<Int>, acc: Int, place: Int) -> Int
    ? "Bytes as a number, least significant first."
    match bytes
        [] -> acc
        [head, ..tail] -> littleEndian(tail, acc + head * place, place * 256)

verify littleEndian
    littleEndian([1], 0, 1) => 1
    littleEndian([0, 1], 0, 1) => 256
    littleEndian([], 5, 1) => 5

fn isSuccessOpcode(code: Int) -> Bool
    ? "BIP342's OP_SUCCESS set: 80, 98, 126 to 129, 131 to 134, 137 and 138,"
      "141 and 142, 149 to 153, and everything from 187 to 254."
      "These are the opcodes that were disabled or undefined and had no"
      "meaning worth keeping, so Taproot handed them to whoever wants them."
    Bool.or(Bool.or(Bool.or(code == 80, code == 98), Bool.or(Bool.and(code >= 126, code <= 129), Bool.and(code >= 131, code <= 134))), Bool.or(Bool.or(Bool.and(code >= 137, code <= 138), Bool.and(code >= 141, code <= 142)), Bool.or(Bool.and(code >= 149, code <= 153), Bool.and(code >= 187, code <= 254))))

verify isSuccessOpcode
    isSuccessOpcode(80) => true
    isSuccessOpcode(98) => true
    isSuccessOpcode(126) => true
    isSuccessOpcode(129) => true
    isSuccessOpcode(130) => false
    isSuccessOpcode(134) => true
    isSuccessOpcode(137) => true
    isSuccessOpcode(142) => true
    isSuccessOpcode(149) => true
    isSuccessOpcode(153) => true
    isSuccessOpcode(186) => false
    isSuccessOpcode(187) => true
    isSuccessOpcode(254) => true
    isSuccessOpcode(255) => false
    isSuccessOpcode(81) => false
    isSuccessOpcode(172) => false

fn leafVersionOf(control: String) -> Int
    ? "The control block's first byte with its low bit cleared. That bit is"
      "the parity of the Output key and is not part of the version."
    match bytesIn(control)
        [] -> 0
        [head, ..tail] -> Bits.and(head, 254)

verify leafVersionOf
    leafVersionOf("c0") => 192
    leafVersionOf("c1") => 192
    leafVersionOf("") => 0

fn parityOf(control: String) -> Bool
    ? "The low bit of the control block's first byte: whether the Output key's"
      "y coordinate is odd. An x-only key does not carry it, so the spender"
      "has to say."
    match bytesIn(control)
        [] -> false
        [head, ..tail] -> Bits.and(head, 1) == 1

verify parityOf
    parityOf("c0") => false
    parityOf("c1") => true
    parityOf("") => false

fn commits(program: List<Int>, control: String, leaf: String) -> Bool
    ? "Whether this leaf, by this path, gives this Output key."
    match wellFormed(control)
        false -> false
        true -> tweakMatches(program, control, merkleRootFrom(control, leafHashOf(leafVersionOf(control), leaf)))

verify commits
    commits(Domain.ScriptState.zeros(32), "", "51") => false
    commits(Domain.ScriptState.zeros(32), "c0", "51") => false

fn wellFormed(control: String) -> Bool
    ? "A control block is thirty-three bytes plus thirty-two for each step of"
      "the Merkle path, and the path is at most a hundred and twenty-eight"
      "steps -- which is the tree depth BIP341 allows."
    width = Int.div(String.len(control), 2)
    Bool.and(Bool.and(width >= 33, width <= 4129), Int.mod(width - 33, 32) == 0)

verify wellFormed
    wellFormed("") => false
    wellFormed("c0") => false
    wellFormed(hexOf(Domain.ScriptState.zeros(33))) => true
    wellFormed(hexOf(Domain.ScriptState.zeros(65))) => true
    wellFormed(hexOf(Domain.ScriptState.zeros(66))) => false
    wellFormed(hexOf(Domain.ScriptState.zeros(4129))) => true
    wellFormed(hexOf(Domain.ScriptState.zeros(4161))) => false

fn leafHashOf(leafVersion: Int, leaf: String) -> List<Int>
    ? "TapLeaf over the version, the Script's length and the Script."
    bytes = bytesIn(leaf)
    Domain.Tagged.tapLeaf(List.concat([leafVersion], List.concat(Domain.CompactSize.encode(List.len(bytes)), bytes)))

verify leafHashOf
    List.len(leafHashOf(192, "51")) => 32
    leafHashOf(192, "51") => Domain.Tagged.tapLeaf([192, 1, 81])

fn merkleRootFrom(control: String, leafHash: List<Int>) -> List<Int>
    ? "Walk the path from the leaf to the root, one thirty-two byte step at a"
      "time. The path is everything after the first thirty-three bytes."
    upward(List.drop(bytesIn(control), 33), leafHash)

verify merkleRootFrom
    merkleRootFrom(hexOf(Domain.ScriptState.zeros(33)), [1]) => [1]

fn upward(path: List<Int>, here: List<Int>) -> List<Int>
    ? "One sibling at a time, until the path runs out."
    match List.len(path) >= 32
        false -> here
        true -> upward(List.drop(path, 32), joined(here, List.take(path, 32)))

verify upward
    upward([], [1]) => [1]
    upward([1], [2]) => [2]
    List.len(upward(Domain.ScriptState.zeros(32), Domain.ScriptState.zeros(32))) => 32

fn joined(left: List<Int>, right: List<Int>) -> List<Int>
    ? "TapBranch over the pair, smaller first."
      "Sorted rather than positional, so a node does not record which side it"
      "came from and the path does not have to carry the direction."
    match lexicographicallyBefore(left, right)
        true -> Domain.Tagged.tapBranch(List.concat(left, right))
        false -> Domain.Tagged.tapBranch(List.concat(right, left))

verify joined
    joined([1], [2]) => Domain.Tagged.tapBranch([1, 2])
    joined([2], [1]) => Domain.Tagged.tapBranch([1, 2])
    joined([1], [1]) => Domain.Tagged.tapBranch([1, 1])

fn lexicographicallyBefore(left: List<Int>, right: List<Int>) -> Bool
    ? "Byte by byte, as std::lexicographical_compare has it."
    match left
        [] -> List.len(right) > 0
        [head, ..tail] -> comparedAt(head, tail, right)

verify lexicographicallyBefore
    lexicographicallyBefore([], []) => false
    lexicographicallyBefore([], [1]) => true
    lexicographicallyBefore([1], []) => false
    lexicographicallyBefore([1], [2]) => true
    lexicographicallyBefore([2], [1]) => false
    lexicographicallyBefore([1, 1], [1, 2]) => true

fn comparedAt(head: Int, tail: List<Int>, right: List<Int>) -> Bool
    ? "This byte decides unless the two are equal, when the rest does."
    match right
        [] -> false
        [other, ..rest] -> deeperOrNot(head, tail, other, rest)

verify comparedAt
    comparedAt(1, [], []) => false
    comparedAt(1, [], [2]) => true

fn deeperOrNot(head: Int, tail: List<Int>, other: Int, rest: List<Int>) -> Bool
    ? "Equal bytes carry the comparison one place further along."
    match head == other
        false -> head < other
        true -> lexicographicallyBefore(tail, rest)

verify deeperOrNot
    deeperOrNot(1, [], 2, []) => true
    deeperOrNot(2, [], 1, []) => false
    deeperOrNot(1, [1], 1, [2]) => true

fn tweakMatches(program: List<Int>, control: String, root: List<Int>) -> Bool
    ? "The Output key is the internal key tweaked by the Merkle root."
    internal = List.take(List.drop(bytesIn(control), 1), 32)
    Domain.Primitives.taprootTweakMatches(bytesOf(internal), bytesOf(Domain.Tagged.tapTweak(List.concat(internal, root))), bytesOf(program), parityOf(control))

verify tweakMatches
    tweakMatches(Domain.ScriptState.zeros(32), hexOf(Domain.ScriptState.zeros(33)), Domain.ScriptState.zeros(32)) => false

fn bytesIn(hex: String) -> List<Int>
    ? "Hexadecimal as bytes; unreadable hex is empty and matches nothing."
    Bytes.toList(Result.withDefault(Bytes.fromHex(hex), Bytes.fromList([])))

verify bytesIn
    bytesIn("00c0") => [0, 192]
    bytesIn("zz") => []

fn bytesOf(bytes: List<Int>) -> Bytes
    ? "A byte list as Bytes, for the provider boundary."
    Result.withDefault(Bytes.fromList(bytes), Bytes.fromList([]))

verify bytesOf
    bytesOf([0, 1]) => Bytes.fromList([0, 1])

fn annexOf(witness: List<String>) -> Option<String>
    ? "The annex, when the last of at least two Witness items begins 0x50."
    match List.len(witness) >= 2
        false -> Option.None
        true -> annexIfMarked(lastOf(witness))

verify annexOf
    annexOf([]) => Option.None
    annexOf(["50aa"]) => Option.None
    annexOf(["aa", "50bb"]) => Option.Some("50bb")
    annexOf(["aa", "bb"]) => Option.None

fn annexIfMarked(last: String) -> Option<String>
    ? "0x50 is the marker and it is the only thing that makes an annex."
    match String.startsWith(last, "50")
        true -> Option.Some(last)
        false -> Option.None

verify annexIfMarked
    annexIfMarked("50") => Option.Some("50")
    annexIfMarked("51") => Option.None
    annexIfMarked("") => Option.None

fn strippedOf(witness: List<String>) -> List<String>
    ? "The Witness with the annex taken off, if there was one."
    match annexOf(witness)
        Option.None -> witness
        Option.Some(annex) -> List.take(witness, List.len(witness) - 1)

verify strippedOf
    strippedOf(["aa", "bb"]) => ["aa", "bb"]
    strippedOf(["aa", "50bb"]) => ["aa"]
    strippedOf([]) => []

fn lastOf(items: List<String>) -> String
    ? "The final item, or nothing when there is none."
    match List.drop(items, List.len(items) - 1)
        [] -> ""
        [head, ..tail] -> head

verify lastOf
    lastOf([]) => ""
    lastOf(["a", "b"]) => "b"
    lastOf(["a"]) => "a"

fn keyPath(program: List<Int>, witness: List<String>, annex: Option<String>, context: Context) -> Outcome
    ? "The whole Witness is one signature, checked against the output key."
    match witness
        [] -> Outcome.Decided(Ending.Failed("a taproot spend needs a witness and got none"))
        [signature, ..rest] -> signedWith(program, signature, annex, context)

verify keyPath
    keyPath(Domain.ScriptState.zeros(32), [], Option.None, spending([])) => Outcome.Decided(Ending.Failed("a taproot spend needs a witness and got none"))

fn signedWith(program: List<Int>, signature: String, annex: Option<String>, context: Context) -> Outcome
    ? "The hash type comes off the signature before the message is built,"
      "because the message commits to it."
    match Domain.Schnorr.hashTypeOf(signature)
        Result.Err(why) -> Outcome.Decided(Ending.Failed(why))
        Result.Ok(hashType) -> overMessage(program, signature, hashType, annex, context)

verify signedWith
    signedWith(Domain.ScriptState.zeros(32), "", Option.None, spending([])) => Outcome.Decided(Ending.Failed("a taproot signature is 0 bytes, which is neither 64 nor 65"))

fn overMessage(program: List<Int>, signature: String, hashType: Int, annex: Option<String>, context: Context) -> Outcome
    ? "Build the BIP341 message and ask the curve."
      "A message that will not build is undecided rather than failed. The"
      "commonest reason is that the caller did not supply a spent Output for"
      "every Input, which is a gap in what this engine was told and not a"
      "fault in the spend -- answering Failed there would call a valid"
      "Transaction invalid, which is the one mistake that must not happen."
    match Domain.Bip341.validHashType(hashType)
        false -> Outcome.Decided(Ending.Failed("hash type {hashType} is not one Taproot defines"))
        true -> overBuiltMessage(program, signature, hashType, annex, context)

verify overMessage
    overMessage(Domain.ScriptState.zeros(32), "", 0, Option.None, spending([])) => Outcome.Undecided("taproot message: no input at index 0 to sign")
    overMessage(Domain.ScriptState.zeros(32), "", 4, Option.None, spending([])) => Outcome.Decided(Ending.Failed("hash type 4 is not one Taproot defines"))

fn overBuiltMessage(program: List<Int>, signature: String, hashType: Int, annex: Option<String>, context: Context) -> Outcome
    ? "The hash type is one BIP341 defines; now build the message."
      "A message that will not build is undecided rather than failed. The"
      "commonest reason is that the caller did not supply a spent Output for"
      "every Input, which is a gap in what this engine was told and not a"
      "fault in the spend -- answering Failed there would call a valid"
      "Transaction invalid, which is the one mistake that must not happen."
      "An undefined hash type is the other kind of reason and is checked"
      "above, because BIP341 makes it invalid rather than unanswerable."
    match Domain.Bip341.message(transactionIn(context), Domain.SpendContext.inputIndexOf(context), Domain.SpendContext.prevoutsOf(context), hashType, annex)
        Result.Err(why) -> Outcome.Undecided("taproot message: {why}")
        Result.Ok(message) -> ruled(Domain.Schnorr.verified(hexOf(program), signature, message))

verify overBuiltMessage
    overBuiltMessage(Domain.ScriptState.zeros(32), "", 0, Option.None, spending([])) => Outcome.Undecided("taproot message: no input at index 0 to sign")

fn transactionIn(context: Context) -> Transaction
    ? "The Transaction behind this run. Callers reach here only after"
      "hasSpend, so the empty one is a shape rather than a case."
    match Domain.SpendContext.transactionOf(context)
        Option.None -> Domain.Bip341.emptyTransaction()
        Option.Some(transaction) -> transaction

verify transactionIn
    transactionIn(Domain.SpendContext.bare(Domain.Rules.latest())) => Domain.Bip341.emptyTransaction()

fn ruled(valid: Bool) -> Outcome
    ? "The curve has run and there is no third answer."
    match valid
        true -> Outcome.Decided(Ending.Passed)
        false -> Outcome.Decided(Ending.Failed("taproot signature does not verify"))

verify ruled
    ruled(true) => Outcome.Decided(Ending.Passed)
    ruled(false) => Outcome.Decided(Ending.Failed("taproot signature does not verify"))

fn hexOf(bytes: List<Int>) -> String
    ? "Bytes back as hexadecimal, for the key the curve is given."
    Bytes.toHex(Result.withDefault(Bytes.fromList(bytes), Bytes.fromList([])))

verify hexOf
    hexOf([0, 81]) => "0051"
    hexOf([]) => ""
