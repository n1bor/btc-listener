module CompactSize
    intent =
        "Bitcoin's variable-width count, which prefixes almost every list on the"
        "wire: Inputs, Outputs, Witness items, inventory entries, Headers."
        "One byte below 253; otherwise a marker naming a wider little-endian"
        "field that follows it. Three modules had each written their own reader,"
        "one of which only ever needed the width."
        "Running out of bytes reads as zero rather than as an error. A count is"
        "always followed by the items it counts, so a truncated Message fails when"
        "those items are read, with something to say about what was missing."
    exposes [Count, read, widthOf, encode]
    depends [Domain.Message]
    effects []

record Count
    value: Int
    rest: List<Int>
    width: Int

fn read(bytes: List<Int>) -> Count
    ? "The count at the front, whatever follows it, and how many bytes it took."
      "The width is reported rather than worked out from the value, so a caller"
      "measuring how much it consumed stays right even on an encoding that used"
      "more bytes than the value needed."
    match bytes
        [] -> Count(value = 0, rest = [], width = 0)
        [head, ..tail] -> from(head, tail)

verify read
    read([]) => Count(value = 0, rest = [], width = 0)
    read([5, 9]) => Count(value = 5, rest = [9], width = 1)
    read([252, 9]) => Count(value = 252, rest = [9], width = 1)
    read([253, 1, 1, 9]) => Count(value = 257, rest = [9], width = 3)
    read([253, 208, 7, 9]) => Count(value = 2000, rest = [9], width = 3)
    read([254, 0, 0, 1, 0, 9]) => Count(value = 65536, rest = [9], width = 5)
    read([255, 1, 0, 0, 0, 0, 0, 0, 0, 9]) => Count(value = 1, rest = [9], width = 9)

fn from(head: Int, tail: List<Int>) -> Count
    ? "Values below 253 are the byte itself; the three markers name a wider field."
    match head
        253 -> wide(2, tail)
        254 -> wide(4, tail)
        255 -> wide(8, tail)
        _ -> Count(value = head, rest = tail, width = 1)

verify from
    from(5, [9]) => Count(value = 5, rest = [9], width = 1)
    from(252, []) => Count(value = 252, rest = [], width = 1)
    from(253, [1, 1, 9]) => Count(value = 257, rest = [9], width = 3)
    from(254, [0, 0, 1, 0]) => Count(value = 65536, rest = [], width = 5)
    from(255, [1, 0, 0, 0, 0, 0, 0, 0]) => Count(value = 1, rest = [], width = 9)

fn wide(width: Int, tail: List<Int>) -> Count
    ? "Read the wider field the marker promised, and step past it."
    Count(value = Domain.Message.readLittleEndian(List.take(tail, width)), rest = List.drop(tail, width), width = width + 1)

verify wide
    wide(2, [1, 1, 9]) => Count(value = 257, rest = [9], width = 3)
    wide(4, [0, 0, 1, 0, 9]) => Count(value = 65536, rest = [9], width = 5)

fn widthOf(head: Int) -> Int
    ? "How many bytes the count occupies, its marker included."
      "For a caller that only needs to step over the count rather than read it."
    match head
        253 -> 3
        254 -> 5
        255 -> 9
        _ -> 1

verify widthOf
    widthOf(5) => 1
    widthOf(252) => 1
    widthOf(253) => 3
    widthOf(254) => 5
    widthOf(255) => 9

fn encode(value: Int) -> List<Int>
    ? "The count written back out, in the narrowest form that holds it."
      "The narrowest form is the only one anything here produces, though read"
      "accepts wider ones. Bitcoin calls a wider encoding non-canonical and"
      "rejects it in most places, so writing one would be a way of producing"
      "Transactions nothing would accept."
    match value < 253
        true -> [value]
        false -> narrowOrWide(value)

verify encode
    encode(0) => [0]
    encode(5) => [5]
    encode(252) => [252]
    encode(253) => [253, 253, 0]
    encode(257) => [253, 1, 1]
    encode(2000) => [253, 208, 7]
    encode(65535) => [253, 255, 255]
    encode(65536) => [254, 0, 0, 1, 0]
    encode(4294967295) => [254, 255, 255, 255, 255]
    encode(4294967296) => [255, 0, 0, 0, 0, 1, 0, 0, 0]

verify encode law readsBack
    given value: Int = [0, 1, 252, 253, 254, 255, 256, 65535, 65536, 2147483647, 4294967295, 4294967296, 9223372036854775807, 18446744073709551615]
    given rest: List<Int> = [[], [9], [253, 0, 0]]
    when Bool.and(0 <= value, value <= 18446744073709551615)
    read(List.concat(encode(value), rest)) => Count(value = value, rest = rest, width = List.len(encode(value)))

fn narrowOrWide(value: Int) -> List<Int>
    ? "Two, four or eight bytes behind the marker that names the width."
    match value < 65536
        true -> List.prepend(253, Domain.Message.littleEndian(value, 2))
        false -> wider(value)

verify narrowOrWide
    narrowOrWide(253) => [253, 253, 0]
    narrowOrWide(65535) => [253, 255, 255]
    narrowOrWide(65536) => [254, 0, 0, 1, 0]

fn wider(value: Int) -> List<Int>
    ? "Four bytes or eight."
    match value < 4294967296
        true -> List.prepend(254, Domain.Message.littleEndian(value, 4))
        false -> List.prepend(255, Domain.Message.littleEndian(value, 8))

verify wider
    wider(65536) => [254, 0, 0, 1, 0]
    wider(4294967295) => [254, 255, 255, 255, 255]
    wider(4294967296) => [255, 0, 0, 0, 0, 1, 0, 0, 0]
