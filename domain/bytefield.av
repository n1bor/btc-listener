module ByteField
    intent =
        "Fixed-width and length-prefixed fields, for the records this program"
        "keeps in a database."
        "Keys and values are both bytes now (n1bor/btc-listener#45, #46), and"
        "both are built the same way: numbers of a known width, identifiers of"
        "a known length, and at most one field whose length is not known until"
        "it is read. Written once here rather than five times over."
        "Numbers are big-endian throughout. For a key that is load-bearing --"
        "the database orders keys bytewise, so a scan sees numeric order only"
        "if the bytes are most-significant-first. For a value it does not"
        "matter at all, and the same order is used anyway: two spellings of a"
        "number in one program is one more than anybody can keep straight."
    exposes [number, numberBytes, numberIn, at, after, prefixed, prefixedBytes, prefixedIn, afterPrefixed, filled, prefixedWide, prefixedWideBytes, prefixedWideIn, afterPrefixedWide, widest, wideWidth]
    depends [Bytes]
    effects []

fn number(value: Int, width: Int) -> List<Int>
    ? "A number as this many bytes, most significant first."
    numberInto(value, width, [])

verify number
    number(0, 4) => [0, 0, 0, 0]
    number(1, 4) => [0, 0, 0, 1]
    number(256, 4) => [0, 0, 1, 0]
    number(4294967295, 4) => [255, 255, 255, 255]
    number(5000000000, 8) => [0, 0, 0, 1, 42, 5, 242, 0]

fn numberBytes(value: Int, width: Int) -> Bytes
    ? "The same number, already packed (#243)."
      "Total: every element number makes is a byte, so fromList cannot"
      "refuse. Packed here rather than by the caller, so what is concatenated"
      "downstream is bytes to bytes -- a copy -- and never a rope of boxed"
      "integers walked and validated at the end."
    Result.withDefault(Bytes.fromList(number(value, width)), Bytes.empty())

verify numberBytes
    Bytes.octets(numberBytes(0, 4)) => [0, 0, 0, 0]
    Bytes.octets(numberBytes(256, 4)) => [0, 0, 1, 0]
    Bytes.octets(numberBytes(5000000000, 8)) => [0, 0, 0, 1, 42, 5, 242, 0]
    Bytes.len(numberBytes(7, 1)) => 1

fn numberInto(value: Int, width: Int, acc: List<Int>) -> List<Int>
    ? "Take the low byte, shift down, and build the answer back to front."
    match width <= 0
        true -> acc
        false -> numberInto(Int.div(value, 256), width - 1, List.prepend(Int.mod(value, 256), acc))

verify numberInto
    numberInto(0, 1, []) => [0]
    numberInto(258, 2, []) => [1, 2]
    numberInto(5, 0, []) => []

fn numberIn(bytes: List<Int>) -> Int
    ? "Those bytes back into the number they were written from."
    numberFrom(bytes, 0)

verify numberIn
    numberIn([]) => 0
    numberIn([0, 0, 0, 1]) => 1
    numberIn([0, 0, 1, 0]) => 256
    numberIn(number(962268, 4)) => 962268
    numberIn(number(5000000000, 8)) => 5000000000
    numberIn(number(2099999997690000, 8)) => 2099999997690000

fn numberFrom(bytes: List<Int>, acc: Int) -> Int
    ? "Fold the most significant byte in first."
    match bytes
        [] -> acc
        [head, ..tail] -> numberFrom(tail, acc * 256 + head)

verify numberFrom
    numberFrom([], 7) => 7
    numberFrom([1, 2], 0) => 258

fn at(bytes: List<Int>, offset: Int, width: Int) -> List<Int>
    ? "One fixed-width field, by where it starts and how wide it is."
    List.take(List.drop(bytes, offset), width)

verify at
    at([1, 2, 3, 4], 0, 2) => [1, 2]
    at([1, 2, 3, 4], 2, 2) => [3, 4]
    at([1, 2], 0, 8) => [1, 2]

fn after(bytes: List<Int>, offset: Int) -> List<Int>
    ? "Everything past the fixed part, which is at most one field per record."
    List.drop(bytes, offset)

verify after
    after([1, 2, 3], 1) => [2, 3]
    after([1, 2, 3], 9) => []

fn filled(count: Int, value: Int) -> List<Int>
    ? "A run of one byte repeated, for the cases that need a long field."
    filling(count, value, [])

verify filled
    filled(0, 7) => []
    filled(3, 7) => [7, 7, 7]
    List.len(filled(270, 4)) => 270

fn filling(count: Int, value: Int, acc: List<Int>) -> List<Int>
    ? "One at a time until the run is as long as it was asked for."
    match count <= 0
        true -> acc
        false -> filling(count - 1, value, List.prepend(value, acc))

verify filling
    filling(2, 5, []) => [5, 5]
    filling(0, 5, [9]) => [9]

fn prefixed(body: List<Int>) -> Result<List<Int>, String>
    ? "A field whose length is not known in advance, behind one byte saying it."
      "One byte, so at most 255. Used for a quantity of Chain Work, which is"
      "an arbitrary-precision Int in this program and so has no width a record"
      "could fix: a 256-bit target gives 32 bytes today and the type promises"
      "nothing. A ceiling written into the format would be a ceiling the"
      "arithmetic does not have."
      "It refuses a body it cannot describe rather than lying about it (#218)."
      "This used to prepend the length whatever the length was, so a body of"
      "270 bytes produced a first element of 270 -- a List<Int> that is not a"
      "list of bytes. Nothing looked until Bytes.fromList refused it a layer"
      "up, naming an offset but not the field, the record or the caller. That"
      "cost mainnet its Set at Height 243016 and, because the failure reached"
      "the follow loop, one Peer and then every Candidate in the Book."
      "A caller whose body is bounded above 255 wants prefixedWide."
    match List.len(body) > widest()
        true -> Result.Err("a length-prefixed field holds at most {widest()} bytes, got {List.len(body)}")
        false -> Result.Ok(List.prepend(List.len(body), body))

verify prefixed
    prefixed([]) => Result.Ok([0])
    prefixed([7]) => Result.Ok([1, 7])
    prefixed([1, 2, 3]) => Result.Ok([3, 1, 2, 3])
    prefixed(filled(255, 0)) => Result.Ok(List.prepend(255, filled(255, 0)))
    prefixed(filled(256, 0)) => Result.Err("a length-prefixed field holds at most 255 bytes, got 256")

fn widest() -> Int
    ? "The longest body one length byte can describe."
    255

verify widest
    widest() => 255

fn wideWidth() -> Int
    ? "How many bytes a wide length prefix takes: four, which describes any"
      "field a Block can contain and several orders more."
    4

verify wideWidth
    wideWidth() => 4

fn prefixedBytes(body: Bytes) -> Result<Bytes, String>
    ? "A packed field behind one byte saying its length (#243)."
    match Bytes.len(body) > widest()
        true -> Result.Err("a field of {Bytes.len(body)} bytes is longer than one length byte can say")
        false -> Result.Ok(Bytes.concat(numberBytes(Bytes.len(body), 1), body))

verify prefixedBytes
    Bytes.octets(prefixedBytes(Bytes.fromList([7, 8]))?) => [2, 7, 8]
    Bytes.octets(prefixedBytes(Bytes.empty())?) => [0]
    prefixedBytes(Result.withDefault(Bytes.fromList(filled(256, 1)), Bytes.empty())) => Result.Err("a field of 256 bytes is longer than one length byte can say")

fn prefixedWideBytes(body: Bytes) -> Bytes
    ? "A packed field behind four bytes saying its length (#243)."
    Bytes.concat(numberBytes(Bytes.len(body), wideWidth()), body)

verify prefixedWideBytes
    Bytes.octets(prefixedWideBytes(Bytes.fromList([7, 8]))) => [0, 0, 0, 2, 7, 8]
    Bytes.len(prefixedWideBytes(Result.withDefault(Bytes.fromList(filled(300, 1)), Bytes.empty()))) => 304

fn prefixedWide(body: List<Int>) -> List<Int>
    ? "The same, for a field with no small bound on its length (#218)."
      "A spent Output's Set entry is thirteen bytes and then its scriptPubKey,"
      "and a scriptPubKey has no consensus ceiling worth calling small: the"
      "2013 chain is full of bare multisig data carriers, and one of 257 bytes"
      "at Height 243016 is what stopped the Set. Four bytes rather than two"
      "because a ceiling that a Block could reach is the bug again with a"
      "bigger number in it."
    List.concat(number(List.len(body), wideWidth()), body)

verify prefixedWide
    prefixedWide([]) => [0, 0, 0, 0]
    prefixedWide([7]) => [0, 0, 0, 1, 7]
    prefixedWide([1, 2, 3]) => [0, 0, 0, 3, 1, 2, 3]
    List.len(prefixedWide(filled(270, 0))) => 274

fn prefixedWideIn(bytes: List<Int>) -> List<Int>
    ? "The field a wide length prefix introduces."
    List.take(after(bytes, wideWidth()), numberIn(at(bytes, 0, wideWidth())))

verify prefixedWideIn
    prefixedWideIn([]) => []
    prefixedWideIn(prefixedWide([1, 2, 3])) => [1, 2, 3]
    prefixedWideIn(prefixedWide([])) => []
    prefixedWideIn(List.concat(prefixedWide([9]), [8, 8])) => [9]
    prefixedWideIn(prefixedWide(filled(270, 4))) => filled(270, 4)

fn afterPrefixedWide(bytes: List<Int>) -> List<Int>
    ? "Everything past a wide length-prefixed field."
    List.drop(after(bytes, wideWidth()), numberIn(at(bytes, 0, wideWidth())))

verify afterPrefixedWide
    afterPrefixedWide([]) => []
    afterPrefixedWide(prefixedWide([1, 2, 3])) => []
    afterPrefixedWide(List.concat(prefixedWide([9]), [8, 8])) => [8, 8]
    afterPrefixedWide(List.concat(prefixedWide(filled(270, 4)), [5])) => [5]

fn prefixedIn(bytes: List<Int>) -> List<Int>
    ? "The field a length byte introduces."
    match bytes
        [] -> []
        [head, ..tail] -> List.take(tail, head)

verify prefixedIn
    prefixedIn([]) => []
    prefixedIn(Result.withDefault(prefixed([1, 2, 3]), [])) => [1, 2, 3]
    prefixedIn(Result.withDefault(prefixed([]), [])) => []
    prefixedIn(List.concat(Result.withDefault(prefixed([9]), []), [8, 8])) => [9]

fn afterPrefixed(bytes: List<Int>) -> List<Int>
    ? "Everything past a length-prefixed field."
    match bytes
        [] -> []
        [head, ..tail] -> List.drop(tail, head)

verify afterPrefixed
    afterPrefixed([]) => []
    afterPrefixed(Result.withDefault(prefixed([1, 2, 3]), [])) => []
    afterPrefixed(List.concat(Result.withDefault(prefixed([9]), []), [8, 8])) => [8, 8]
