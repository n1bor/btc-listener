module Script
    intent =
        "Recognising the standard Output scripts, and naming who they pay."
        "An address is not stored in a Transaction — it is a rendering of the"
        "hash a script already contains, so deriving one is pattern-matching"
        "plus an encoding, never a hash of a public key."
        "Anything unrecognised keeps its hex: guessing at a script that does not"
        "match a known shape would be worse than saying so."
    exposes [describe, kindOf, isAnyWitnessProgram, isPayToScriptHash, isPushOnly, pushOnly, bytesOf]
    depends [Bytes, Domain.Base58, Domain.Bech32, Domain.ScriptParse]
    effects []

fn mainnetPrefix() -> String
    ? "The human-readable part of a mainnet SegWit address."
    "bc"

verify mainnetPrefix
    mainnetPrefix() => "bc"

fn describe(scriptHex: String) -> String
    ? "The script's kind and the address it pays, or its hex when unrecognised."
    render(kindOf(scriptHex), scriptHex)

verify describe
    describe("76a914751e76e8199196d454941c45d1b3a323f1433bd688ac") => "P2PKH  1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMH"
    describe("a9140766b3e86a21a11b52c874d18e2dcf22d81fc38087") => "P2SH   32N9goLjsePShNTwoSaEe7fzJ8NTrm9keZ"
    describe("0014751e76e8199196d454941c45d1b3a323f1433bd6") => "P2WPKH bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4"
    describe("512079be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798") => "P2TR   bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0"
    describe("6a0b68656c6c6f20776f726c64") => "OP_RETURN 6a0b68656c6c6f20776f726c64"
    describe("ffff") => "nonstandard ffff"

fn render(kind: String, scriptHex: String) -> String
    ? "An address when one could be derived, otherwise the kind and the hex."
    match addressOf(kind, bytesOf(scriptHex))
        Result.Ok(address) -> "{padded(kind)} {address}"
        Result.Err(reason) -> "{padded(kind)} {scriptHex}"

verify render
    render("nonstandard", "ffff") => "nonstandard ffff"

fn padded(kind: String) -> String
    ? "Pad the kind so the addresses beside it line up."
    padRight(kind, 6)

verify padded
    padded("P2SH") => "P2SH  "
    padded("OP_RETURN") => "OP_RETURN"

fn padRight(text: String, width: Int) -> String
    ? "Pad with spaces until the text is at least `width` characters."
    match String.len(text) >= width
        true -> text
        false -> padRight(text + " ", width)

verify padRight
    padRight("ab", 4) => "ab  "
    padRight("abcdef", 3) => "abcdef"

fn bytesOf(scriptHex: String) -> List<Int>
    ? "The script as bytes; unreadable hex simply matches nothing."
    Result.withDefault(listOf(scriptHex), [])

verify bytesOf
    bytesOf("00ff") => [0, 255]
    bytesOf("zz") => []

fn listOf(scriptHex: String) -> Result<List<Int>, String>
    ? "Decode the script's hex."
    decoded = Bytes.fromHex(scriptHex)?
    Result.Ok(Bytes.toList(decoded))

verify listOf
    listOf("00ff") => Result.Ok([0, 255])
    listOf("zz") => Result.Err("Bytes.fromHex: invalid hexadecimal character 'z'")

fn kindOf(scriptHex: String) -> String
    ? "Which standard shape this Output script has, if any."
    classify(bytesOf(scriptHex))

verify kindOf
    kindOf("76a914751e76e8199196d454941c45d1b3a323f1433bd688ac") => "P2PKH"
    kindOf("0014751e76e8199196d454941c45d1b3a323f1433bd6") => "P2WPKH"
    kindOf("ffff") => "nonstandard"

fn classify(script: List<Int>) -> String
    ? "Match the script against the standard shapes, by its leading opcode."
      "The opcode alone is not enough — each shape also has a fixed length and"
      "a push size — so the byte selects a candidate and the shape confirms it."
    match byteAt(script, 0)
        118 -> named(isPayToPubKeyHash(script), "P2PKH")
        169 -> named(isPayToScriptHash(script), "P2SH")
        0 -> witnessKind(script)
        81 -> versionOneOrMultisig(script)
        82 -> laterWitness(script)
        83 -> laterWitness(script)
        84 -> laterWitness(script)
        85 -> laterWitness(script)
        86 -> laterWitness(script)
        87 -> laterWitness(script)
        88 -> laterWitness(script)
        89 -> laterWitness(script)
        90 -> laterWitness(script)
        91 -> laterWitness(script)
        92 -> laterWitness(script)
        93 -> laterWitness(script)
        94 -> laterWitness(script)
        95 -> laterWitness(script)
        96 -> laterWitness(script)
        106 -> "OP_RETURN"
        33 -> named(isPayToPubKey(script, 33), "P2PK")
        65 -> named(isPayToPubKey(script, 65), "P2PK")
        _ -> multisigOrNot(script)

verify classify
    classify(bytesOf("410496b538e853519c726a2c91e61ec11600ae1390813a627c66fb8be7947be63c52da7589379515d4e0a604f8141781e62294721166bf621e73a82cbf2342c858eeac")) => "P2PK"
    classify(bytesOf("514104cc71eb30d653c0c3163990c47b976f3fb3f37cccdcbedb169a1dfef58bbfbfaff7d8a473e7e2e6d317b87bafe8bde97e3cf8f065dec022b51d11fcdd0d348ac4410461cbdcc5409fb4b4d42b51d33381354d80e550078cb532a34bfa2fcfdeb7d76519aecc62770f5b0e4ef8551946d8a540911abe3e7854a26f39f58b25c15342af52ae")) => "P2MS"
    classify(bytesOf("76a914751e76e8199196d454941c45d1b3a323f1433bd688ac")) => "P2PKH"
    classify(bytesOf("a9140766b3e86a21a11b52c874d18e2dcf22d81fc38087")) => "P2SH"
    classify(bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6")) => "P2WPKH"
    classify(bytesOf("00201863143c14c5166804bd19203356da136c985678cd4d27a1b8c6329604903262")) => "P2WSH"
    classify(bytesOf("512079be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798")) => "P2TR"
    classify(bytesOf("6a0b68656c6c6f20776f726c64")) => "OP_RETURN"
    classify(bytesOf("ffff")) => "nonstandard"
    classify(bytesOf("76ff")) => "nonstandard"

fn versionOneOrMultisig(script: List<Int>) -> String
    ? "A leading OP_1 opens a version-one witness program or a bare multisig."
      "The two share their first byte and nothing else, so the length settles it:"
      "a Taproot output is OP_1 and a thirty-two byte push and stops there."
    match isWitnessProgram(script, 81, 34)
        true -> "P2TR"
        false -> multisigOrNot(script)

verify versionOneOrMultisig
    versionOneOrMultisig(bytesOf("512079be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798")) => "P2TR"
    versionOneOrMultisig(bytesOf("514104cc71eb30d653c0c3163990c47b976f3fb3f37cccdcbedb169a1dfef58bbfbfaff7d8a473e7e2e6d317b87bafe8bde97e3cf8f065dec022b51d11fcdd0d348ac4410461cbdcc5409fb4b4d42b51d33381354d80e550078cb532a34bfa2fcfdeb7d76519aecc62770f5b0e4ef8551946d8a540911abe3e7854a26f39f58b25c15342af52ae")) => "P2MS"
    versionOneOrMultisig(bytesOf("5100")) => "nonstandard"

fn multisigOrNot(script: List<Int>) -> String
    ? "Bare multisig: OP_m, the keys, OP_n, OP_CHECKMULTISIG."
    named(isBareMultisig(script), "P2MS")

verify multisigOrNot
    multisigOrNot(bytesOf("514104cc71eb30d653c0c3163990c47b976f3fb3f37cccdcbedb169a1dfef58bbfbfaff7d8a473e7e2e6d317b87bafe8bde97e3cf8f065dec022b51d11fcdd0d348ac4410461cbdcc5409fb4b4d42b51d33381354d80e550078cb532a34bfa2fcfdeb7d76519aecc62770f5b0e4ef8551946d8a540911abe3e7854a26f39f58b25c15342af52ae")) => "P2MS"
    multisigOrNot(bytesOf("ffff")) => "nonstandard"

fn isPayToPubKey(script: List<Int>, keyLength: Int) -> Bool
    ? "A push of a public key, then OP_CHECKSIG, and nothing else."
      "Sixty-five bytes uncompressed or thirty-three compressed. This was how"
      "coins were paid before addresses existed, so it is most of the early"
      "chain -- and it has no address form, which is why it went away."
    Bool.and(List.len(script) == keyLength + 2, byteAt(script, keyLength + 1) == 172)

verify isPayToPubKey
    isPayToPubKey(bytesOf("410496b538e853519c726a2c91e61ec11600ae1390813a627c66fb8be7947be63c52da7589379515d4e0a604f8141781e62294721166bf621e73a82cbf2342c858eeac"), 65) => true
    isPayToPubKey(bytesOf("21038282263212c609d9ea2a6e3e172de238d8c39cabd5ac1ca10646e23fd5f51508ac"), 33) => true
    isPayToPubKey(bytesOf("4104cc71eb30d653c0c3163990c47b976f3fb3f37cccdcbedb169a1dfef58bbfbfaff7d8a473e7e2e6d317b87bafe8bde97e3cf8f065dec022b51d11fcdd0d348ac41"), 65) => false
    isPayToPubKey(bytesOf("41ac"), 65) => false

fn isBareMultisig(script: List<Int>) -> Bool
    ? "OP_m, one or more key pushes, OP_n, OP_CHECKMULTISIG, with m at most n."
      "Only the frame is checked here, not that the pushes are well formed keys."
      "Anything claiming to be multisig and failing the frame is nonstandard,"
      "which is the same answer it would get for failing anywhere else."
    last = List.len(script) - 1
    total = byteAt(script, last - 1)
    Bool.and(isSmallNumber(byteAt(script, 0)), Bool.and(byteAt(script, last) == 174, Bool.and(isSmallNumber(total), byteAt(script, 0) <= total)))

verify isBareMultisig
    isBareMultisig(bytesOf("514104cc71eb30d653c0c3163990c47b976f3fb3f37cccdcbedb169a1dfef58bbfbfaff7d8a473e7e2e6d317b87bafe8bde97e3cf8f065dec022b51d11fcdd0d348ac4410461cbdcc5409fb4b4d42b51d33381354d80e550078cb532a34bfa2fcfdeb7d76519aecc62770f5b0e4ef8551946d8a540911abe3e7854a26f39f58b25c15342af52ae")) => true
    isBareMultisig(bytesOf("5251ae")) => false
    isBareMultisig(bytesOf("5152ae")) => true
    isBareMultisig(bytesOf("5152ac")) => false
    isBareMultisig(bytesOf("ffff")) => false

fn isSmallNumber(byte: Int) -> Bool
    ? "OP_1 through OP_16, which is how a multisig writes its two counts."
    Bool.and(byte >= 81, byte <= 96)

verify isSmallNumber
    isSmallNumber(81) => true
    isSmallNumber(96) => true
    isSmallNumber(80) => false
    isSmallNumber(97) => false

fn witnessKind(script: List<Int>) -> String
    ? "A leading zero is a version-zero program; its length says which."
      "Version zero defines exactly two lengths. A version zero program of any"
      "other length is not a witness program at all and never becomes one --"
      "that is the version that has already been spent."
    match List.len(script)
        22 -> named(isWitnessProgram(script, 0, 22), "P2WPKH")
        34 -> named(isWitnessProgram(script, 0, 34), "P2WSH")
        _ -> "nonstandard"

fn witnessName() -> String
    ? "What an Output is called when it is a witness program of a version"
      "nothing has defined yet."
      "Not nonstandard: it is a witness program, Bitcoin will not run it, and"
      "it has a perfectly good address. Calling it nonstandard says the"
      "opposite of all three."
    "witness"

verify witnessName
    witnessName() => "witness"

fn laterWitness(script: List<Int>) -> String
    ? "OP_2 through OP_16 open a witness program of a version nobody has given"
      "meaning to. They are anyone-can-spend today and a soft fork may claim"
      "one later, which is exactly how version one arrived."
    match looksLikeWitness(script)
        true -> witnessName()
        false -> multisigOrNot(script)

verify laterWitness
    laterWitness(bytesOf("520250ed")) => "witness"
    laterWitness(bytesOf("5202dc96")) => "witness"
    laterWitness(bytesOf("5200")) => "nonstandard"

fn looksLikeWitness(script: List<Int>) -> Bool
    ? "A version opcode, one push of two to forty bytes, and nothing else."
      "BIP141's shape. The version byte is the caller's business; this is"
      "about what follows it."
    Bool.and(programWidth(script) >= 2, Bool.and(programWidth(script) <= 40, byteAt(script, 1) == programWidth(script)))

verify looksLikeWitness
    looksLikeWitness(bytesOf("520250ed")) => true
    looksLikeWitness(bytesOf("5200")) => false
    looksLikeWitness(bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6")) => true

fn programWidth(script: List<Int>) -> Int
    ? "How many bytes follow the version opcode and its length byte."
    List.len(script) - 2

verify programWidth
    programWidth(bytesOf("520250ed")) => 2
    programWidth(bytesOf("52")) => 0 - 1

fn witnessVersionOf(script: List<Int>) -> Int
    ? "The version a witness program's leading opcode names: OP_0 is nought,"
      "OP_1 through OP_16 are one through sixteen."
    match byteAt(script, 0)
        0 -> 0
        _ -> byteAt(script, 0) - 80

verify witnessVersionOf
    witnessVersionOf(bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6")) => 0
    witnessVersionOf(bytesOf("520250ed")) => 2
    witnessVersionOf(bytesOf("6002aabb")) => 16

verify witnessKind
    witnessKind(bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6")) => "P2WPKH"
    witnessKind(bytesOf("00201863143c14c5166804bd19203356da136c985678cd4d27a1b8c6329604903262")) => "P2WSH"
    witnessKind(bytesOf("0000")) => "nonstandard"

fn named(matches: Bool, kind: String) -> String
    ? "The kind when the shape confirms it, and nothing when it does not."
    match matches
        true -> kind
        false -> "nonstandard"

verify named
    named(true, "P2SH") => "P2SH"
    named(false, "P2SH") => "nonstandard"

fn startsWith(script: List<Int>, opcode: Int) -> Bool
    ? "Whether the script opens with this opcode."
    match script
        [] -> false
        [head, ..tail] -> head == opcode

verify startsWith
    startsWith([106, 1], 106) => true
    startsWith([1], 106) => false
    startsWith([], 106) => false

fn byteAt(script: List<Int>, index: Int) -> Int
    ? "One byte of the script, or -1 when the script is shorter than that."
    Option.withDefault(Vector.get(Vector.fromList(script), index), 0 - 1)

verify byteAt
    byteAt([7, 8], 1) => 8
    byteAt([7], 5) => 0 - 1

fn isPayToPubKeyHash(script: List<Int>) -> Bool
    ? "OP_DUP OP_HASH160 <20 bytes> OP_EQUALVERIFY OP_CHECKSIG."
    Bool.and(List.len(script) == 25, Bool.and(byteAt(script, 0) == 118, Bool.and(byteAt(script, 1) == 169, Bool.and(byteAt(script, 2) == 20, Bool.and(byteAt(script, 23) == 136, byteAt(script, 24) == 172)))))

verify isPayToPubKeyHash
    isPayToPubKeyHash(bytesOf("76a914751e76e8199196d454941c45d1b3a323f1433bd688ac")) => true
    isPayToPubKeyHash(bytesOf("ffff")) => false

fn isPayToScriptHash(script: List<Int>) -> Bool
    ? "OP_HASH160 <20 bytes> OP_EQUAL."
    Bool.and(List.len(script) == 23, Bool.and(byteAt(script, 0) == 169, Bool.and(byteAt(script, 1) == 20, byteAt(script, 22) == 135)))

verify isPayToScriptHash
    isPayToScriptHash(bytesOf("a9140766b3e86a21a11b52c874d18e2dcf22d81fc38087")) => true
    isPayToScriptHash(bytesOf("ffff")) => false

fn isWitnessProgram(script: List<Int>, opcode: Int, length: Int) -> Bool
    ? "A version opcode, a push of the program, and nothing else."
    Bool.and(List.len(script) == length, Bool.and(byteAt(script, 0) == opcode, byteAt(script, 1) == length - 2))

verify isWitnessProgram
    isWitnessProgram(bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6"), 0, 22) => true
    isWitnessProgram(bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6"), 0, 34) => false

fn addressOf(kind: String, script: List<Int>) -> Result<String, String>
    ? "Derive the address a recognised script pays to."
      "The witness shapes differ only in which version the program follows,"
      "and that version is what selects Bech32 or Bech32m."
    program = List.drop(script, 2)
    match kind
        "P2PKH" -> Domain.Base58.encodeCheck(Domain.Base58.pubKeyHashVersion(), List.take(List.drop(script, 3), 20))
        "P2SH" -> Domain.Base58.encodeCheck(Domain.Base58.scriptHashVersion(), List.take(program, 20))
        "P2WPKH" -> Result.Ok(Domain.Bech32.encode(mainnetPrefix(), 0, program))
        "P2WSH" -> Result.Ok(Domain.Bech32.encode(mainnetPrefix(), 0, program))
        "P2TR" -> Result.Ok(Domain.Bech32.encode(mainnetPrefix(), 1, program))
        _ -> laterWitnessAddress(kind, script)

fn laterWitnessAddress(kind: String, script: List<Int>) -> Result<String, String>
    ? "A witness program of an undefined version still has an address, and"
      "Domain.Bech32.encode already picks Bech32m for every version above"
      "nought, which is what BIP350 asks for."
    match kind == witnessName()
        true -> Result.Ok(Domain.Bech32.encode(mainnetPrefix(), witnessVersionOf(script), List.drop(script, 2)))
        false -> Result.Err("no address for {kind}")

verify laterWitnessAddress
    laterWitnessAddress("witness", bytesOf("520250ed")) => Result.Ok("bc1z2rksukkjr8")
    laterWitnessAddress("OP_RETURN", []) => Result.Err("no address for OP_RETURN")

verify addressOf
    addressOf("P2PKH", bytesOf("76a914751e76e8199196d454941c45d1b3a323f1433bd688ac")) => Result.Ok("1BgGZ9tcN4rm9KBzDn7KprQz87SZ26SAMH")
    addressOf("P2SH", bytesOf("a9140766b3e86a21a11b52c874d18e2dcf22d81fc38087")) => Result.Ok("32N9goLjsePShNTwoSaEe7fzJ8NTrm9keZ")
    addressOf("P2WPKH", bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6")) => Result.Ok("bc1qw508d6qejxtdg4y5r3zarvary0c5xw7kv8f3t4")
    addressOf("P2TR", bytesOf("512079be667ef9dcbbac55a06295ce870b07029bfcdb2dce28d959f2815b16f81798")) => Result.Ok("bc1p0xlxvlhemja6c4dqv22uapctqupfhlxm9h8z3k2e72q4k9hcz7vqzk5jj0")
    addressOf("OP_RETURN", []) => Result.Err("no address for OP_RETURN")

fn isAnyWitnessProgram(scriptHex: String) -> Bool
    ? "Whether this Output is a witness program of any version, as BIP141 has it."
      "A different question from kindOf, which names the three shapes anyone"
      "actually uses. This covers every version from nought to sixteen and every"
      "push from two bytes to forty, including versions nobody has defined."
      "It matters because of what such a Script means to an engine that cannot"
      "read it. A version byte and a push of a hash, run under the old rules,"
      "leaves the hash on the stack and comes out true -- which is exactly how"
      "segwit was deployed without splitting the network, and which means an"
      "engine with no witness evaluation calls every segwit spend valid. This"
      "is the question that has to be asked before that answer is believed."
    witnessShaped(bytesOf(scriptHex))

verify isAnyWitnessProgram
    isAnyWitnessProgram("0014751e76e8199196d454941c45d1b3a323f1433bd6") => true
    isAnyWitnessProgram("0020701a8d401c84fb13e6baf169d59684e17abd9fa216c8cc5b9fc63d622ff8c58d") => true
    isAnyWitnessProgram("5120a60869f0dbcf1dc659c9cecbaf8050135ea9e8cdc487053f1dc6880949dc684c") => true
    isAnyWitnessProgram("60020102") => true
    isAnyWitnessProgram("76a914751e76e8199196d454941c45d1b3a323f1433bd688ac") => false
    isAnyWitnessProgram("a914751e76e8199196d454941c45d1b3a323f1433bd687") => false
    isAnyWitnessProgram("51") => false
    isAnyWitnessProgram("0001") => false

fn witnessShaped(script: List<Int>) -> Bool
    ? "A version byte, then one push that accounts for all the rest."
      "Four bytes at the least and forty-two at the most, so the push is between"
      "two and forty and there is no room for anything after it."
    length = List.len(script)
    Bool.and(Bool.and(length >= 4, length <= 42), Bool.and(isVersionByte(byteAt(script, 0)), byteAt(script, 1) == length - 2))

verify witnessShaped
    witnessShaped(bytesOf("0014751e76e8199196d454941c45d1b3a323f1433bd6")) => true
    witnessShaped(bytesOf("60020102")) => true
    witnessShaped(bytesOf("0002010203")) => false
    witnessShaped(bytesOf("0101")) => false

fn isVersionByte(byte: Int) -> Bool
    ? "OP_0, or OP_1 through OP_16, and nothing else."
    Bool.or(byte == 0, Bool.and(byte >= 81, byte <= 96))

verify isVersionByte
    isVersionByte(0) => true
    isVersionByte(81) => true
    isVersionByte(96) => true
    isVersionByte(97) => false
    isVersionByte(80) => false

fn isPushOnly(scriptHex: String) -> Bool
    ? "Whether this Script only puts things on the stack."
      "A Script that will not parse is not push-only, which is Core's answer"
      "too: CScript::IsPushOnly walks with GetOp and returns false the moment"
      "it cannot read the next opcode. So a truncated push is refused here"
      "rather than reaching a parser that would refuse it anyway -- the same"
      "verdict, one step earlier."
    match Domain.ScriptParse.opsIn(scriptHex)
        Result.Err(why) -> false
        Result.Ok(ops) -> pushOnly(ops)

verify isPushOnly
    isPushOnly("") => true
    isPushOnly("51") => true
    isPushOnly("0102") => true
    isPushOnly("76") => false
    isPushOnly("02aa") => false

fn pushOnly(ops: List<Op>) -> Bool
    ? "Whether every Op only puts something on the stack. OP_0 through OP_16"
      "and OP_1NEGATE are pushes despite being Codes, which is why the test is"
      "on the opcode number rather than on the constructor."
    match ops
        [] -> true
        [head, ..tail] -> pushOnlyFrom(isPush(head), tail)

verify pushOnly
    pushOnly([]) => true
    pushOnly([Op.Code(81), Op.Push(2, [1, 2])]) => true
    pushOnly([Op.Code(118)]) => false
fn pushOnlyFrom(soFar: Bool, rest: List<Op>) -> Bool
    ? "The rest of the Ops, once the one before them has been judged. Split"
      "out so that neither half holds a call open while the other runs."
    match soFar
        false -> false
        true -> pushOnly(rest)

verify pushOnlyFrom
    pushOnlyFrom(false, []) => false
    pushOnlyFrom(true, []) => true
    pushOnlyFrom(true, [Op.Code(118)]) => false
fn isPush(op: Op) -> Bool
    ? "One Op, by the same rule."
    match op
        Op.Push(code, bytes) -> true
        Op.Code(code) -> code <= 96

verify isPush
    isPush(Op.Push(2, [1, 2])) => true
    isPush(Op.Code(96)) => true
    isPush(Op.Code(97)) => false
