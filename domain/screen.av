module Screen
    intent =
        "What the Screen shows and how keys move it, with nothing that"
        "touches a terminal."
        "A frame is a list of draw operations for Infra.Screen to execute --"
        "the one impure piece. Everything here is arithmetic over the"
        "Snapshot: which Panel is up, what a key does to that, and the exact"
        "text of every frame, all of it answerable by a verify case (#130)."
        "The Panels beyond the Overview arrived one issue at a time, and"
        "until each did its screen said which issue it was waiting for,"
        "because a blank Panel and a Panel not yet built should not look"
        "alike; placeholderLines is that sentence, kept for the next one."
    exposes [DrawOp, Panel, View, Pressed, Answer, opened, pressed, pressedAll, frameOf, overviewLines, placeholderLines, keymapLine, confirmLine, etaClock, ageText]
    depends [Domain.Screenlines, Domain.Snapshot]
    effects []

type DrawOp
    ClearAll
    MoveTo(Int, Int)
    Text(String)

type Panel
    Overview
    Peers
    Blocks
    Transactions
    Mempool

record View
    panel: Panel
    confirming: Bool

type Answer
    Unchanged
    Redraw
    StopNode

record Pressed
    view: View
    answer: Answer

fn opened() -> View
    ? "The Screen as it first appears: the Overview, asking nothing."
    View(panel = Panel.Overview, confirming = false)

verify opened
    opened() => View(panel = Panel.Overview, confirming = false)

fn pressed(view: View, key: String) -> Pressed
    ? "What one key does."
      "While the stop question is open, y stops the node and any other key"
      "withdraws the question -- a question answered by accident should err"
      "towards the node staying up."
    match view.confirming
        true -> answered(key)
        false -> switched(view, key)

verify pressed
    pressed(View(panel = Panel.Overview, confirming = true), "y").answer => Answer.StopNode
    pressed(View(panel = Panel.Overview, confirming = true), "n").answer => Answer.Redraw
    pressed(View(panel = Panel.Overview, confirming = true), "n").view.confirming => false
    pressed(opened(), "q").view.confirming => true
    pressed(opened(), "p").view.panel => Panel.Peers
    pressed(opened(), "x").answer => Answer.Unchanged

fn answered(key: String) -> Pressed
    ? "The stop question, answered."
    match key
        "y" -> Pressed(view = View(panel = Panel.Overview, confirming = false), answer = Answer.StopNode)
        _ -> Pressed(view = View(panel = Panel.Overview, confirming = false), answer = Answer.Redraw)

verify answered
    answered("y").answer => Answer.StopNode
    answered("Escape").answer => Answer.Redraw

fn switched(view: View, key: String) -> Pressed
    ? "The Panel keys, and q opening the stop question."
      "An unknown key changes nothing and redraws nothing, so leaning on the"
      "keyboard costs no flicker."
    match key
        "o" -> Pressed(view = View(panel = Panel.Overview, confirming = false), answer = Answer.Redraw)
        "p" -> Pressed(view = View(panel = Panel.Peers, confirming = false), answer = Answer.Redraw)
        "b" -> Pressed(view = View(panel = Panel.Blocks, confirming = false), answer = Answer.Redraw)
        "t" -> Pressed(view = View(panel = Panel.Transactions, confirming = false), answer = Answer.Redraw)
        "m" -> Pressed(view = View(panel = Panel.Mempool, confirming = false), answer = Answer.Redraw)
        "q" -> Pressed(view = View(panel = view.panel, confirming = true), answer = Answer.Redraw)
        _ -> Pressed(view = view, answer = Answer.Unchanged)

verify switched
    switched(opened(), "b").view.panel => Panel.Blocks
    switched(opened(), "m").view.panel => Panel.Mempool
    switched(opened(), "q").view.confirming => true
    switched(View(panel = Panel.Blocks, confirming = false), "z").view.panel => Panel.Blocks

fn pressedAll(view: View, keys: List<String>) -> Pressed
    ? "A drain's worth of keys, in order; a stop wins over everything after"
      "it, because the question was answered."
    match keys
        [] -> Pressed(view = view, answer = Answer.Unchanged)
        [head, ..tail] -> pressedNext(pressed(view, head), tail)

verify pressedAll
    pressedAll(opened(), []).answer => Answer.Unchanged
    pressedAll(opened(), ["p"]).view.panel => Panel.Peers
    pressedAll(opened(), ["q", "y"]).answer => Answer.StopNode
    pressedAll(opened(), ["q", "n", "b"]).view.panel => Panel.Blocks
    pressedAll(opened(), ["q", "n", "b"]).answer => Answer.Redraw
    pressedAll(opened(), ["x"]).answer => Answer.Unchanged

fn pressedNext(sofar: Pressed, keys: List<String>) -> Pressed
    ? "Fold the rest, keeping a redraw once one is owed."
    match sofar.answer
        Answer.StopNode -> sofar
        Answer.Unchanged -> pressedAll(sofar.view, keys)
        Answer.Redraw -> redrawKept(pressedAll(sofar.view, keys))

verify pressedNext
    pressedNext(Pressed(view = opened(), answer = Answer.StopNode), ["b"]).answer => Answer.StopNode
    pressedNext(Pressed(view = opened(), answer = Answer.Redraw), []).answer => Answer.Redraw

fn redrawKept(later: Pressed) -> Pressed
    ? "A redraw already owed is still owed, whatever later keys said."
    match later.answer
        Answer.Unchanged -> Pressed(view = later.view, answer = Answer.Redraw)
        _ -> later

verify redrawKept
    redrawKept(Pressed(view = opened(), answer = Answer.Unchanged)).answer => Answer.Redraw
    redrawKept(Pressed(view = opened(), answer = Answer.StopNode)).answer => Answer.StopNode

fn keymapLine() -> String
    ? "The one line that says what the keys are, always at the top."
    "o overview  p peers  b blocks  t transactions  m mempool  q quit"

verify keymapLine
    keymapLine() => "o overview  p peers  b blocks  t transactions  m mempool  q quit"

fn confirmLine() -> String
    ? "The stop question, shown while it is open."
    "Stop the node? y/n"

verify confirmLine
    confirmLine() => "Stop the node? y/n"

fn frameOf(view: View, snapshot: Snapshot, nowMs: Int) -> List<DrawOp>
    ? "One whole frame: clear, the keymap, the Panel, and the stop question"
      "when it is open."
    List.concat([DrawOp.ClearAll, DrawOp.MoveTo(0, 0), DrawOp.Text(keymapLine())], bodyOps(linesOf(view, snapshot, nowMs), confirmingLine(view.confirming), 2, []))

fn confirmingLine(confirming: Bool) -> List<String>
    ? "The stop question as a trailing line, or nothing."
    match confirming
        true -> [confirmLine()]
        false -> []

verify confirmingLine
    confirmingLine(true) => ["Stop the node? y/n"]
    confirmingLine(false) => []

fn bodyOps(lines: List<String>, trailing: List<String>, row: Int, acc: List<DrawOp>) -> List<DrawOp>
    ? "Each line at its row, top to bottom."
    match List.concat(lines, trailing)
        [] -> List.reverse(acc)
        [head, ..tail] -> bodyOps(tail, [], row + 1, List.prepend(DrawOp.Text(head), List.prepend(DrawOp.MoveTo(0, row), acc)))

verify bodyOps
    bodyOps([], [], 2, []) => []
    bodyOps(["a"], [], 2, []) => [DrawOp.MoveTo(0, 2), DrawOp.Text("a")]
    bodyOps(["a"], ["b"], 2, []) => [DrawOp.MoveTo(0, 2), DrawOp.Text("a"), DrawOp.MoveTo(0, 3), DrawOp.Text("b")]

fn linesOf(view: View, snapshot: Snapshot, nowMs: Int) -> List<String>
    ? "The Panel that is up, as its lines."
    match view.panel
        Panel.Overview -> overviewLines(snapshot, nowMs)
        Panel.Peers -> peersPanelLines(snapshot.company, nowMs)
        Panel.Blocks -> blocksPanelLines(snapshot, nowMs)
        Panel.Transactions -> transactionsPanelLines(snapshot, nowMs)
        Panel.Mempool -> mempoolPanelLines(snapshot.mempool)

verify linesOf
    linesOf(View(panel = Panel.Mempool, confirming = false), Domain.Snapshot.started(0), 0) => ["", "Mempool: 0 Transaction(s), 0 of 0 bytes", "minimum fee rate to enter: 0 sat/kB"]
    List.len(linesOf(View(panel = Panel.Peers, confirming = false), Domain.Snapshot.started(0), 0)) => 5
    List.len(linesOf(opened(), Domain.Snapshot.started(0), 0)) => 5

fn mempoolPanelLines(view: MempoolView) -> List<String>
    ? "The Mempool Panel (#134): how much is held, against what cap, and"
      "the fee rate that would get in right now -- the eviction floor is"
      "the one number that says what is happening under load."
    [
        "",
        "Mempool: {view.held} Transaction(s), {view.bytes} of {view.cap} bytes",
        "minimum fee rate to enter: {view.floorRate} sat/kB",
    ]

verify mempoolPanelLines
    mempoolPanelLines(MempoolView(held = 3, bytes = 900, cap = 5000000, floorRate = 1000)) => ["", "Mempool: 3 Transaction(s), 900 of 5000000 bytes", "minimum fee rate to enter: 1000 sat/kB"]

fn transactionsPanelLines(snapshot: Snapshot, nowMs: Int) -> List<String>
    ? "The Transactions Panel (#133): the newest Transactions, each with the"
      "fee connect computed, and how long ago it arrived."
      "Both kinds are here (#164). A Transaction joins the ring when the"
      "Mempool admits it and the same row flips when a Block takes it, so"
      "what this Panel shows is the flow rather than only its end."
    List.concat([
        "",
        "last Transactions:",
    ], transactionRows(snapshot.rings.transactions, nowMs, []))

verify transactionsPanelLines
    transactionsPanelLines(Domain.Snapshot.started(0), 0) => ["", "last Transactions:", "  none yet"]
    List.len(transactionsPanelLines(Domain.Snapshot.notedTransaction(Domain.Snapshot.started(0), TxView(txId = "tt", fee = 1000, coinbase = false, atMs = 0, confirmed = true)), 5000)) => 3

fn transactionRows(views: List<TxView>, nowMs: Int, acc: List<String>) -> List<String>
    ? "One row per Transaction, newest first."
    match views
        [] -> anyRows(List.reverse(acc), "  none yet")
        [head, ..tail] -> transactionRows(tail, nowMs, List.prepend("  {Domain.Screenlines.transactionLine(head)}  ({ageText(head.atMs, nowMs)} ago)", acc))

verify transactionRows
    transactionRows([], 0, []) => ["  none yet"]
    transactionRows([TxView(txId = "tt", fee = 1000, coinbase = false, atMs = 3000, confirmed = true)], 5000, []) => ["  tx tt fee 1000 sat  (2s ago)"]
    transactionRows([TxView(txId = "tt", fee = 1000, coinbase = false, atMs = 3000, confirmed = false)], 5000, []) => ["  tx tt fee 1000 sat  in Mempool  (2s ago)"]

fn blocksPanelLines(snapshot: Snapshot, nowMs: Int) -> List<String>
    ? "The Blocks Panel (#132): the newest Blocks, then anything the chain"
      "did that was not simply growing."
    List.concat(List.concat([
        "",
        "last Blocks:",
    ], blockRows(snapshot.rings.blocks, [])), List.concat(List.prepend("", reorgRows(snapshot.rings.reorgs, [])), orphanRow(snapshot.rings.orphans, snapshot.rings.orphanMs, nowMs)))

verify blocksPanelLines
    blocksPanelLines(Domain.Snapshot.started(0), 0) => ["", "last Blocks:", "  none connected yet", "", "  no Reorganisation seen"]
    List.len(blocksPanelLines(Domain.Snapshot.notedOrphan(Domain.Snapshot.started(0), 2, 0), 5000)) => 6

fn blockRows(views: List<BlockView>, acc: List<String>) -> List<String>
    ? "One row per held Block, newest first."
    match views
        [] -> anyRows(List.reverse(acc), "  none connected yet")
        [head, ..tail] -> blockRows(tail, List.prepend("  {Domain.Screenlines.blockLine(head)}", acc))

verify blockRows
    blockRows([], []) => ["  none connected yet"]
    blockRows([BlockView(height = 5, blockId = "aa", transactions = 2, bytes = 300, atMs = 0)], []) => ["  block 5 aa 2 tx 300 bytes"]

fn reorgRows(views: List<ReorgView>, acc: List<String>) -> List<String>
    ? "One row per remembered Reorganisation, newest first."
    match views
        [] -> anyRows(List.reverse(acc), "  no Reorganisation seen")
        [head, ..tail] -> reorgRows(tail, List.prepend("  {Domain.Screenlines.reorgLine(head)}", acc))

verify reorgRows
    reorgRows([], []) => ["  no Reorganisation seen"]
    reorgRows([ReorgView(forkHeight = 7, displaced = 5, tipHeight = 12, atMs = 5)], []) => ["  reorganisation at Height 7: 5 Height(s) re-pointed, tip now 12"]

fn anyRows(rows: List<String>, whenNone: String) -> List<String>
    ? "Nothing is said, not left blank."
    match rows
        [] -> [whenNone]
        [head, ..tail] -> rows

verify anyRows
    anyRows([], "none") => ["none"]
    anyRows(["x"], "none") => ["x"]

fn orphanRow(count: Int, lastMs: Int, nowMs: Int) -> List<String>
    ? "The orphan line, only once there is something to count."
    match count > 0
        true -> ["  {Domain.Screenlines.orphanLine(count, lastMs, nowMs)}"]
        false -> []

verify orphanRow
    orphanRow(0, 0, 0) => []
    orphanRow(3, 0, 250000) => ["  Orphan Headers seen: 3, last 4m10s ago"]

fn peersPanelLines(company: Company, nowMs: Int) -> List<String>
    ? "The Peers Panel (#131): the pool one line per Peer, then the Book."
      "Direction is read from the Standing rather than assumed (#164). The"
      "column was written when every Peer was one this node dialled and was"
      "left as a promise that the day inbound Peers arrived would change a"
      "value and not a shape; #30 brought them, and this is that day."
    List.concat([
        "",
        Domain.Screenlines.peersLine(company, nowMs),
        "",
        "key  dir  address                version  sent      received  heard   agent",
    ], peerLines(company.peers, nowMs, []))

verify peersPanelLines
    List.len(peersPanelLines(Company(peers = [], candidates = 0, serving = Option.None), 0)) => 5
    peersPanelLines(Company(peers = [], candidates = 0, serving = Option.None), 0) => ["", "0 Peers (0 out, 0 in), 0 Candidates, quietest heard 0s ago", "", "key  dir  address                version  sent      received  heard   agent", "  none connected"]

fn directionOf(inbound: Bool) -> String
    ? "Which side opened the connection: in for a Peer that dialled us, out"
      "for one we dialled. Two letters and three, so the column holds either"
      "without moving."
    match inbound
        true -> "in"
        false -> "out"

verify directionOf
    directionOf(true) => "in"
    directionOf(false) => "out"

fn peerLines(peers: List<PeerView>, nowMs: Int, acc: List<String>) -> List<String>
    ? "One line per Peer, in key order as the pool keeps them."
    match peers
        [] -> anyPeers(List.reverse(acc))
        [head, ..tail] -> peerLines(tail, nowMs, List.prepend(peerLine(head, nowMs), acc))

verify peerLines
    peerLines([], 0, []) => ["  none connected"]
    List.len(peerLines([PeerView(key = 0, address = "1.2.3.4:8333", version = 70016, agent = "/Satoshi/", lastHeardMs = 0, sent = 0, received = 0, inbound = false)], 5000, [])) => 1

fn anyPeers(lines: List<String>) -> List<String>
    ? "No Peers is said, not left blank."
    match lines
        [] -> ["  none connected"]
        [head, ..tail] -> lines

verify anyPeers
    anyPeers([]) => ["  none connected"]
    anyPeers(["x"]) => ["x"]

fn peerLine(peer: PeerView, nowMs: Int) -> String
    ? "One Peer: who, which way, how much has crossed, how fresh."
    "{padTo(String.fromInt(peer.key), 5)}{padTo(directionOf(peer.inbound), 5)}{padTo(peer.address, 23)}{padTo(String.fromInt(peer.version), 9)}{padTo(String.fromInt(peer.sent), 10)}{padTo(String.fromInt(peer.received), 10)}{padTo(agoText(peer.lastHeardMs, nowMs), 8)}{peer.agent}"

verify peerLine
    peerLine(PeerView(key = 0, address = "1.2.3.4:8333", version = 70016, agent = "/Satoshi/", lastHeardMs = 3000, sent = 120, received = 4096, inbound = false), 5000) => "0    out  1.2.3.4:8333           70016    120       4096      2s ago  /Satoshi/"
    peerLine(PeerView(key = 1, address = "1.2.3.4:8333", version = 70016, agent = "/Satoshi/", lastHeardMs = 3000, sent = 120, received = 4096, inbound = true), 5000) => "1    in   1.2.3.4:8333           70016    120       4096      2s ago  /Satoshi/"

fn agoText(atMs: Int, nowMs: Int) -> String
    ? "How long since this Peer said anything."
    "{ageText(atMs, nowMs)} ago"

verify agoText
    agoText(3000, 5000) => "2s ago"

fn padTo(text: String, width: Int) -> String
    ? "The text, then spaces out to the column width; a value wider than"
      "its column keeps one space so columns never fuse."
    match String.len(text) >= width
        true -> "{text} "
        false -> "{text}{spaces(width - String.len(text), "")}"

verify padTo
    padTo("ab", 4) => "ab  "
    padTo("abcd", 4) => "abcd "
    padTo("abcde", 4) => "abcde "

fn spaces(count: Int, acc: String) -> String
    ? "That many spaces."
    match count <= 0
        true -> acc
        false -> spaces(count - 1, "{acc} ")

verify spaces
    spaces(0, "") => ""
    spaces(3, "") => "   "

fn placeholderLines(name: String, issue: String) -> List<String>
    ? "A Panel that is not built yet says so, and says where it is coming"
      "from."
    ["", "waiting for the {name} Panel ({issue})"]

verify placeholderLines
    placeholderLines("Mempool", "#28") => ["", "waiting for the Mempool Panel (#28)"]

fn overviewLines(snapshot: Snapshot, nowMs: Int) -> List<String>
    ? "The Overview: the catch-up while it runs, the tip once there is one."
    match snapshot.phase
        Phase.Headers -> ibdLines(snapshot)
        Phase.Bodies -> ibdLines(snapshot)
        Phase.Listening -> tipLines(snapshot, nowMs)

verify overviewLines
    overviewLines(Domain.Snapshot.started(0), 0) => ["", "catching up", "headers 0 held, 0/s", "blocks 0/0 (0%) 0/s eta —", "set 0/0 (0%) 0/s eta —"]
    List.len(overviewLines(Domain.Snapshot.tipAt(Domain.Snapshot.started(0), 7, "aa", 0), 5000)) => 8

fn ibdLines(snapshot: Snapshot) -> List<String>
    ? "The catch-up form: the Header walk, then the body walk."
    [
        "",
        "catching up",
        "headers {snapshot.headers.done} held, {Domain.Snapshot.rateOf(snapshot.headers)}/s",
        "blocks {snapshot.bodies.done}/{snapshot.bodies.target} ({Domain.Snapshot.percentOf(snapshot.bodies)}%) {Domain.Snapshot.rateOf(snapshot.bodies)}/s eta {etaClock(Domain.Snapshot.etaSecsOf(snapshot.bodies))}",
        "set {snapshot.sets.done}/{snapshot.sets.target} ({Domain.Snapshot.percentOf(snapshot.sets)}%) {Domain.Snapshot.rateOf(snapshot.sets)}/s eta {etaClock(Domain.Snapshot.etaSecsOf(snapshot.sets))}",
    ]

verify ibdLines
    ibdLines(Domain.Snapshot.started(0)) => ["", "catching up", "headers 0 held, 0/s", "blocks 0/0 (0%) 0/s eta —", "set 0/0 (0%) 0/s eta —"]
    List.len(ibdLines(Domain.Snapshot.headersAt(Domain.Snapshot.started(0), 5, 9, 100))) => 5

fn tipLines(snapshot: Snapshot, nowMs: Int) -> List<String>
    ? "The at-the-tip form: where the node stands, what just happened, who"
      "it is talking to, and the Mempool it does not have yet."
    List.concat([
        "",
        "{Domain.Screenlines.tipLine(snapshot.tip)}  (age {ageText(snapshot.tip.atMs, nowMs)})",
        "",
        "last Transactions:",
    ], List.concat(transactionLines(List.take(snapshot.rings.transactions, 4), []), [
        "",
        Domain.Screenlines.peersLine(snapshot.company, nowMs),
        "Mempool: {snapshot.mempool.held} Transaction(s), floor {snapshot.mempool.floorRate} sat/kB",
    ]))

fn transactionLines(views: List<TxView>, acc: List<String>) -> List<String>
    ? "The newest few Transactions, one line each; none yet is said, not"
      "left blank."
    match views
        [] -> noneYet(List.reverse(acc))
        [head, ..tail] -> transactionLines(tail, List.prepend("  {Domain.Screenlines.transactionLine(head)}", acc))

verify transactionLines
    transactionLines([], []) => ["  none seen yet"]
    transactionLines([TxView(txId = "tt", fee = 1000, coinbase = false, atMs = 0, confirmed = true)], []) => ["  tx tt fee 1000 sat"]

fn noneYet(lines: List<String>) -> List<String>
    ? "An empty list of Transaction lines reads as a sentence instead."
    match lines
        [] -> ["  none seen yet"]
        [head, ..tail] -> lines

verify noneYet
    noneYet([]) => ["  none seen yet"]
    noneYet(["  tx aa fee 1 sat"]) => ["  tx aa fee 1 sat"]

fn etaClock(eta: Option<Int>) -> String
    ? "The remaining time as h:mm, or an em dash while the rate window is"
      "still filling -- a dash reads as 'not yet known', where a number"
      "would read as a promise."
    match eta
        Option.None -> "—"
        Option.Some(secs) -> "{Int.div(secs, 3600)}:{padded(Int.div(Int.mod(secs, 3600), 60))}"

verify etaClock
    etaClock(Option.None) => "—"
    etaClock(Option.Some(0)) => "0:00"
    etaClock(Option.Some(59)) => "0:00"
    etaClock(Option.Some(3600)) => "1:00"
    etaClock(Option.Some(11225)) => "3:07"

fn padded(minutes: Int) -> String
    ? "Two digits of minutes."
    match minutes < 10
        true -> "0{minutes}"
        false -> "{minutes}"

verify padded
    padded(0) => "00"
    padded(7) => "07"
    padded(59) => "59"

fn ageText(atMs: Int, nowMs: Int) -> String
    ? "How long ago that was, never negative even against a skewed clock."
    Domain.Screenlines.spanText(Int.max(Int.div(nowMs - atMs, 1000), 0))

verify ageText
    ageText(0, 250000) => "4m10s"
    ageText(250000, 0) => "0s"
