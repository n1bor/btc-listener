module Address
    intent =
        "The validated network location of a Peer: four octets and a port."
        "Parsing is the only way in, so an unvalidated address cannot reach the"
        "rest of the program. Octets are kept as numbers rather than as the"
        "original text, so rendering is canonical no matter how it was written."
    exposes [fromString, fromStringOn, fromPeerText, fromParts, fromOctets, fromOctetsOn, toString, hostOf, portOf, octetsOf, routable]
    exposes opaque [PeerAddress]
    effects []

record PeerAddress
    octets: List<Int>
    portNumber: Int

fn defaultPort() -> Int
    ? "The port a Bitcoin mainnet Peer listens on."
    8333

verify defaultPort
    defaultPort() => 8333

fn fromString(text: String) -> Result<PeerAddress, String>
    ? "Parse a dotted-quad address, using the default Peer port."
    fromOctetsAndPort(text, defaultPort())

verify fromString
    fromString("1.2.3.4") => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 8333))
    hostOf(fromString("192.168.1.10")?) => "192.168.1.10"
    portOf(fromString("192.168.1.10")?) => 8333
    fromString("999.1.1.1") => Result.Err("octet 999 is out of range (0-255)")
    fromString("") => Result.Err("expected four dot-separated octets, got 1")

fn fromStringOn(text: String, port: Int) -> Result<PeerAddress, String>
    ? "Parse a dotted-quad address onto an already-numeric port."
      "The default port is a fact about a Network, so a caller that knows its"
      "Network passes the port that Network answers."
    fromOctetsAndPort(text, port)

verify fromStringOn
    fromStringOn("1.2.3.4", 38333) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 38333))
    portOf(fromStringOn("10.0.0.1", 18444)?) => 18444
    fromStringOn("999.1.1.1", 38333) => Result.Err("octet 999 is out of range (0-255)")

fn fromPeerText(text: String, port: Int) -> Result<PeerAddress, String>
    ? "A Peer as a person writes one down: an address, and a port if they mean"
      "one other than the Network's."
      "Every Peer on a Network uses the same port, which is why the rest of"
      "this program never had to ask. Several Peers on one machine do not --"
      "two nodes on a loopback have to differ somewhere, and the port is"
      "where. The Address gossip carries a port beside every address for the"
      "same reason, so this is what will read those too."
    onParts(text, port, String.split(text, ":"))

verify fromPeerText
    fromPeerText("1.2.3.4", 38333) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 38333))
    fromPeerText("1.2.3.4:18444", 38333) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 18444))
    fromPeerText("1.2.3.4:x", 38333) => Result.Err("port must be a whole number, got 'x'")
    fromPeerText("1.2.3.4:1:2", 38333) => Result.Err("a Peer is an address or an address and a port, got '1.2.3.4:1:2'")
    fromPeerText("nonsense", 38333) => Result.Err("expected four dot-separated octets, got 1")

fn onParts(text: String, port: Int, split: List<String>) -> Result<PeerAddress, String>
    ? "The address comes first."
    match split
        [] -> Result.Err("a Peer is an address or an address and a port, got '{text}'")
        [host, ..rest] -> afterHost(text, port, host, rest)

verify onParts
    onParts("1.2.3.4", 38333, ["1.2.3.4"]) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 38333))
    onParts("1.2.3.4:18444", 38333, ["1.2.3.4", "18444"]) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 18444))
    onParts("", 38333, []) => Result.Err("a Peer is an address or an address and a port, got ''")

fn afterHost(text: String, port: Int, host: String, rest: List<String>) -> Result<PeerAddress, String>
    ? "Nothing after the address means the Network's own port."
    match rest
        [] -> fromStringOn(host, port)
        [given, ..extra] -> afterPort(text, host, given, extra)

verify afterHost
    afterHost("1.2.3.4", 38333, "1.2.3.4", []) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 38333))
    afterHost("1.2.3.4:18444", 38333, "1.2.3.4", ["18444"]) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 18444))

fn afterPort(text: String, host: String, given: String, extra: List<String>) -> Result<PeerAddress, String>
    ? "A third field means the text was never a Peer."
    match extra
        [] -> onGivenPort(host, given)
        [head, ..tail] -> Result.Err("a Peer is an address or an address and a port, got '{text}'")

verify afterPort
    afterPort("1.2.3.4:18444", "1.2.3.4", "18444", []) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 18444))
    afterPort("1.2.3.4:1:2", "1.2.3.4", "1", ["2"]) => Result.Err("a Peer is an address or an address and a port, got '1.2.3.4:1:2'")

fn onGivenPort(host: String, given: String) -> Result<PeerAddress, String>
    ? "The port has to be a whole number before it can be a port."
    match Int.fromString(given)
        Result.Err(why) -> Result.Err("port must be a whole number, got '{given}'")
        Result.Ok(port) -> fromStringOn(host, port)

verify onGivenPort
    onGivenPort("1.2.3.4", "18444") => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 18444))
    onGivenPort("1.2.3.4", "x") => Result.Err("port must be a whole number, got 'x'")

fn fromParts(text: String, portText: String) -> Result<PeerAddress, String>
    ? "Parse a dotted-quad address and an explicit port, both given as text."
    fromOctetsAndPort(text, parsePort(portText)?)

verify fromParts
    fromParts("1.2.3.4", "18333") => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 18333))
    portOf(fromParts("10.0.0.1", "18333")?) => 18333
    fromParts("10.0.0.1", "banana") => Result.Err("port 'banana' is not a number")
    fromParts("10.0.0.1", "0") => Result.Err("port 0 is out of range (1-65535)")
    fromParts("", "8333") => Result.Err("expected four dot-separated octets, got 1")

fn fromOctets(octets: List<Int>) -> Result<PeerAddress, String>
    ? "Build an address from four already-numeric octets, on the default port."
    checkOctetCount(octets, defaultPort())

verify fromOctets
    fromOctets([192, 168, 1, 10]) => Result.Ok(PeerAddress(octets = [192, 168, 1, 10], portNumber = 8333))
    fromOctets([1, 2, 3]) => Result.Err("expected four octets, got 3")
    fromOctets([1, 2, 3, 300]) => Result.Err("octet 300 is out of range (0-255)")

fn fromOctetsOn(octets: List<Int>, port: Int) -> Result<PeerAddress, String>
    ? "Build an address from four already-numeric octets, on an explicit port."
    checkOctetCount(octets, port)

verify fromOctetsOn
    fromOctetsOn([192, 168, 1, 10], 38333) => Result.Ok(PeerAddress(octets = [192, 168, 1, 10], portNumber = 38333))
    fromOctetsOn([1, 2, 3], 38333) => Result.Err("expected four octets, got 3")

fn checkOctetCount(octets: List<Int>, port: Int) -> Result<PeerAddress, String>
    ? "An address is exactly four octets, each of them in range."
    count = List.len(octets)
    match count == 4
        true -> build(checkedOctets(octets)?, port)
        false -> Result.Err("expected four octets, got {count}")

verify checkOctetCount
    checkOctetCount([1, 2, 3, 4], 8333) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 8333))
    checkOctetCount([1], 8333) => Result.Err("expected four octets, got 1")

fn checkedOctets(octets: List<Int>) -> Result<List<Int>, String>
    ? "Every octet must be in range, whatever produced them."
    checkedOctetsInto(octets, [])

verify checkedOctets
    checkedOctets([1, 255]) => Result.Ok([1, 255])
    checkedOctets([256]) => Result.Err("octet 256 is out of range (0-255)")

fn checkedOctetsInto(octets: List<Int>, acc: List<Int>) -> Result<List<Int>, String>
    ? "Accumulator form so the recursion stays in tail position."
    match octets
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> checkedOctetsInto(tail, List.prepend(checkOctetRange(head)?, acc))

verify checkedOctetsInto
    checkedOctetsInto([7], []) => Result.Ok([7])
    checkedOctetsInto([], [2, 1]) => Result.Ok([1, 2])
    checkedOctetsInto([300], []) => Result.Err("octet 300 is out of range (0-255)")

fn fromOctetsAndPort(text: String, port: Int) -> Result<PeerAddress, String>
    ? "Shared constructor: validate the octets, then the port."
    parts = String.split(text, ".")
    checkPartCount(parts, port)

verify fromOctetsAndPort
    fromOctetsAndPort("1.2.3.4", 8333) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 8333))
    fromOctetsAndPort("10.0.0", 8333) => Result.Err("expected four dot-separated octets, got 3")
    fromOctetsAndPort("", 8333) => Result.Err("expected four dot-separated octets, got 1")

fn checkPartCount(parts: List<String>, port: Int) -> Result<PeerAddress, String>
    ? "An address must be exactly four dot-separated parts."
    count = List.len(parts)
    match count == 4
        true -> build(parseOctets(parts)?, port)
        false -> Result.Err("expected four dot-separated octets, got {count}")

verify checkPartCount
    checkPartCount(["1", "2", "3", "4"], 8333) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 8333))
    checkPartCount(["1", "2"], 8333) => Result.Err("expected four dot-separated octets, got 2")

fn build(octets: List<Int>, port: Int) -> Result<PeerAddress, String>
    ? "Seal validated octets and a validated port into a PeerAddress."
    match inPortRange(port)
        true -> Result.Ok(PeerAddress(octets = octets, portNumber = port))
        false -> Result.Err("port {port} is out of range (1-65535)")

verify build
    build([1, 2, 3, 4], 8333) => Result.Ok(PeerAddress(octets = [1, 2, 3, 4], portNumber = 8333))
    build([1, 2, 3, 4], 0) => Result.Err("port 0 is out of range (1-65535)")
    build([1, 2, 3, 4], 65536) => Result.Err("port 65536 is out of range (1-65535)")

fn inPortRange(port: Int) -> Bool
    ? "Ports are 1-65535; zero is reserved and cannot be dialled."
    Bool.and(port >= 1, port <= 65535)

verify inPortRange
    inPortRange(8333) => true
    inPortRange(1) => true
    inPortRange(65535) => true
    inPortRange(0) => false
    inPortRange(65536) => false
    inPortRange(0 - 1) => false

fn parsePort(portText: String) -> Result<Int, String>
    ? "Parse the port argument, naming the text back when it is not a number."
    match Int.fromString(portText)
        Result.Ok(n) -> Result.Ok(n)
        Result.Err(_) -> Result.Err("port '{portText}' is not a number")

verify parsePort
    parsePort("8333") => Result.Ok(8333)
    parsePort("banana") => Result.Err("port 'banana' is not a number")
    parsePort("") => Result.Err("port '' is not a number")

fn parseOctets(parts: List<String>) -> Result<List<Int>, String>
    ? "Parse every part as an octet, failing on the first bad one."
    parseOctetsInto(parts, [])

verify parseOctets
    parseOctets(["1", "2", "3", "4"]) => Result.Ok([1, 2, 3, 4])
    parseOctets(["1", "256"]) => Result.Err("octet 256 is out of range (0-255)")
    parseOctets([]) => Result.Ok([])

fn parseOctetsInto(parts: List<String>, acc: List<Int>) -> Result<List<Int>, String>
    ? "Accumulator form so the recursion stays in tail position."
    match parts
        [] -> Result.Ok(List.reverse(acc))
        [head, ..tail] -> parseOctetsInto(tail, List.prepend(parseOctet(head)?, acc))

verify parseOctetsInto
    parseOctetsInto(["1", "2"], []) => Result.Ok([1, 2])
    parseOctetsInto([], [9]) => Result.Ok([9])
    parseOctetsInto(["256"], []) => Result.Err("octet 256 is out of range (0-255)")

fn parseOctet(text: String) -> Result<Int, String>
    ? "Parse one octet, rejecting anything outside 0-255."
    match Int.fromString(text)
        Result.Ok(n) -> checkOctetRange(n)
        Result.Err(_) -> Result.Err("octet '{text}' is not a number")

verify parseOctet
    parseOctet("0") => Result.Ok(0)
    parseOctet("255") => Result.Ok(255)
    parseOctet("256") => Result.Err("octet 256 is out of range (0-255)")
    parseOctet("x") => Result.Err("octet 'x' is not a number")
    parseOctet("") => Result.Err("octet '' is not a number")

fn checkOctetRange(n: Int) -> Result<Int, String>
    ? "Octets are 0-255."
    match Bool.and(n >= 0, n <= 255)
        true -> Result.Ok(n)
        false -> Result.Err("octet {n} is out of range (0-255)")

verify checkOctetRange
    checkOctetRange(0) => Result.Ok(0)
    checkOctetRange(255) => Result.Ok(255)
    checkOctetRange(256) => Result.Err("octet 256 is out of range (0-255)")

fn hostOf(address: PeerAddress) -> String
    ? "Canonical dotted-quad form, rebuilt from the validated octets."
    joinOctets(address.octets)

fn routable(address: PeerAddress) -> Bool
    ? "Whether this is an address worth telling another Peer about."
      "Bitcoin Core calls this IsRoutable and it is not a formality: Core"
      "silently refuses to store an address outside it, so gossiping one is"
      "noise that no Peer will keep. Advertising a private address is worse"
      "than noise -- it says the operator's internal network out loud to"
      "everyone who asks (#210)."
      "The ranges are the published ones, not a guess: RFC1918 private,"
      "RFC2544 benchmarking, RFC3927 link-local, RFC5737 documentation,"
      "RFC6598 shared address space, loopback, this-network and broadcast."
    routableOctets(octetsOf(address))

verify routable
    routable(fromOctetsOn([1, 2, 3, 4], 8333)?) => true
    routable(fromOctetsOn([62, 210, 113, 61], 38333)?) => true
    routable(fromOctetsOn([10, 0, 0, 1], 8333)?) => false
    routable(fromOctetsOn([127, 0, 0, 1], 8333)?) => false
    routable(fromOctetsOn([192, 168, 1, 1], 8333)?) => false
    routable(fromOctetsOn([172, 16, 0, 1], 8333)?) => false
    routable(fromOctetsOn([172, 32, 0, 1], 8333)?) => true
    routable(fromOctetsOn([169, 254, 1, 1], 8333)?) => false
    routable(fromOctetsOn([198, 51, 100, 1], 8333)?) => false
    routable(fromOctetsOn([192, 0, 2, 1], 8333)?) => false
    routable(fromOctetsOn([203, 0, 113, 1], 8333)?) => false
    routable(fromOctetsOn([100, 64, 0, 1], 8333)?) => false
    routable(fromOctetsOn([100, 128, 0, 1], 8333)?) => true
    routable(fromOctetsOn([198, 18, 0, 1], 8333)?) => false
    routable(fromOctetsOn([255, 255, 255, 255], 8333)?) => false
    routable(fromOctetsOn([240, 0, 0, 1], 8333)?) => true

fn routableOctets(octets: List<Int>) -> Bool
    ? "The same, on four plain octets."
      "240.0.0.0/4 is deliberately left routable: it is reserved and"
      "unallocated, Core stores it, and docs/regtest-testing.md leans on"
      "exactly that to fill an Address Book with Candidates that will never"
      "answer."
    match List.len(octets) == 4
        false -> false
        true -> firstOf(octets)

verify routableOctets
    routableOctets([1, 2, 3, 4]) => true
    routableOctets([]) => false
    routableOctets([1, 2, 3]) => false

fn firstOf(octets: List<Int>) -> Bool
    ? "Four octets, taken one at a time."
    match octets
        [] -> false
        [a, ..rest] -> withFirst(a, rest)

verify firstOf
    firstOf([1, 2, 3, 4]) => true
    firstOf([]) => false

fn withFirst(a: Int, rest: List<Int>) -> Bool
    ? "The first octet, and on to the second."
    match rest
        [] -> false
        [b, ..more] -> withSecond(a, b, more)

verify withFirst
    withFirst(1, [2, 3, 4]) => true
    withFirst(1, []) => false

fn withSecond(a: Int, b: Int, more: List<Int>) -> Bool
    ? "The third octet is the last one any of these ranges needs."
    match more
        [] -> false
        [c, ..last] -> routableParts(a, b, c)

verify withSecond
    withSecond(1, 2, [3, 4]) => true
    withSecond(1, 2, []) => false

fn routableParts(a: Int, b: Int, c: Int) -> Bool
    ? "One test per published range, read in the order Core reads them."
    match a == 0
        true -> false
        false -> notReserved(a, b, c)

verify routableParts
    routableParts(1, 2, 3) => true
    routableParts(0, 0, 0) => false

fn notReserved(a: Int, b: Int, c: Int) -> Bool
    ? "Everything after this-network."
    Bool.and(notPrivate(a, b), notSpecial(a, b, c))

verify notReserved
    notReserved(1, 2, 3) => true
    notReserved(10, 0, 0) => false

fn notPrivate(a: Int, b: Int) -> Bool
    ? "RFC1918, loopback, RFC6598 and the broadcast address."
    Bool.and(Bool.and(a != 10, a != 127), Bool.and(Bool.and(a != 255, notSixteenTwelve(a, b)), Bool.and(notOneNineTwo(a, b), notShared(a, b))))

verify notPrivate
    notPrivate(1, 2) => true
    notPrivate(10, 0) => false
    notPrivate(127, 0) => false
    notPrivate(255, 255) => false

fn notSixteenTwelve(a: Int, b: Int) -> Bool
    ? "172.16.0.0/12 is private; 172.32.0.0 is not."
    match a == 172
        false -> true
        true -> Bool.or(b < 16, b > 31)

verify notSixteenTwelve
    notSixteenTwelve(172, 16) => false
    notSixteenTwelve(172, 31) => false
    notSixteenTwelve(172, 32) => true
    notSixteenTwelve(173, 16) => true

fn notOneNineTwo(a: Int, b: Int) -> Bool
    ? "192.168.0.0/16 is private."
    match a == 192
        false -> true
        true -> b != 168

verify notOneNineTwo
    notOneNineTwo(192, 168) => false
    notOneNineTwo(192, 0) => true
    notOneNineTwo(193, 168) => true

fn notShared(a: Int, b: Int) -> Bool
    ? "RFC6598 shared address space is 100.64.0.0/10."
    match a == 100
        false -> true
        true -> Bool.or(b < 64, b > 127)

verify notShared
    notShared(100, 64) => false
    notShared(100, 127) => false
    notShared(100, 128) => true
    notShared(101, 64) => true

fn notSpecial(a: Int, b: Int, c: Int) -> Bool
    ? "RFC3927 link-local, RFC2544 benchmarking and the three RFC5737"
      "documentation ranges."
    Bool.and(Bool.and(notLinkLocal(a, b), notBenchmark(a, b)), notDocumentation(a, b, c))

verify notSpecial
    notSpecial(1, 2, 3) => true
    notSpecial(169, 254, 1) => false

fn notLinkLocal(a: Int, b: Int) -> Bool
    ? "169.254.0.0/16."
    match a == 169
        false -> true
        true -> b != 254

verify notLinkLocal
    notLinkLocal(169, 254) => false
    notLinkLocal(169, 253) => true

fn notBenchmark(a: Int, b: Int) -> Bool
    ? "198.18.0.0/15."
    match a == 198
        false -> true
        true -> Bool.or(b < 18, b > 19)

verify notBenchmark
    notBenchmark(198, 18) => false
    notBenchmark(198, 19) => false
    notBenchmark(198, 20) => true

fn notDocumentation(a: Int, b: Int, c: Int) -> Bool
    ? "192.0.2.0/24, 198.51.100.0/24 and 203.0.113.0/24."
    Bool.and(Bool.and(notTestNetOne(a, b, c), notTestNetTwo(a, b, c)), notTestNetThree(a, b, c))

verify notDocumentation
    notDocumentation(192, 0, 2) => false
    notDocumentation(198, 51, 100) => false
    notDocumentation(203, 0, 113) => false
    notDocumentation(1, 2, 3) => true

fn notTestNetOne(a: Int, b: Int, c: Int) -> Bool
    ? "192.0.2.0/24."
    Bool.not(Bool.and(a == 192, Bool.and(b == 0, c == 2)))

verify notTestNetOne
    notTestNetOne(192, 0, 2) => false
    notTestNetOne(192, 0, 3) => true

fn notTestNetTwo(a: Int, b: Int, c: Int) -> Bool
    ? "198.51.100.0/24."
    Bool.not(Bool.and(a == 198, Bool.and(b == 51, c == 100)))

verify notTestNetTwo
    notTestNetTwo(198, 51, 100) => false
    notTestNetTwo(198, 51, 101) => true

fn notTestNetThree(a: Int, b: Int, c: Int) -> Bool
    ? "203.0.113.0/24."
    Bool.not(Bool.and(a == 203, Bool.and(b == 0, c == 113)))

verify notTestNetThree
    notTestNetThree(203, 0, 113) => false
    notTestNetThree(203, 0, 114) => true

fn octetsOf(address: PeerAddress) -> List<Int>
    ? "The four validated octets, for building an address field on the wire."
    address.octets

verify octetsOf
    octetsOf(fromString("192.168.1.10")?) => [192, 168, 1, 10]

fn portOf(address: PeerAddress) -> Int
    ? "The port this Peer is dialled on."
    address.portNumber

fn toString(address: PeerAddress) -> String
    ? "Host and port as they are shown to a reader."
    "{hostOf(address)}:{portOf(address)}"

fn joinOctets(octets: List<Int>) -> String
    ? "Render octets dot-separated, without a leading dot."
    match octets
        [] -> ""
        [head, ..tail] -> joinTail(tail, "{head}")

verify joinOctets
    joinOctets([192, 168, 1, 10]) => "192.168.1.10"
    joinOctets([0, 0, 0, 0]) => "0.0.0.0"
    joinOctets([]) => ""

fn joinTail(octets: List<Int>, acc: String) -> String
    ? "Append the remaining octets to what has been rendered so far."
    match octets
        [] -> acc
        [head, ..tail] -> joinTail(tail, acc + ".{head}")

verify joinTail
    joinTail([1, 2], "0") => "0.1.2"
    joinTail([], "7") => "7"
