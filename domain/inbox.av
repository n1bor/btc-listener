module Inbox
    intent =
        "What a Peer has sent that has not been read yet, and the Messages"
        "that can be taken out of it."
        "The single-Peer code reads a Message by asking the socket for exactly"
        "twenty-four bytes and then for exactly the payload those announce."
        "That is the right shape for one Peer and the wrong shape for several:"
        "a Peer that sends a header and then stops holds the read open, and"
        "with one loop over many sockets it holds every other Peer with it."
        "So bytes are taken off the socket as they arrive, kept per Peer, and"
        "Messages are cut out of what has accumulated. A partial Message is"
        "not an error and not a stall -- it is simply the tail, waiting for"
        "the rest of itself."
        "Every Message is checked before it is handed over: the four magic"
        "bytes must be this Network's, and the payload must hash to the"
        "checksum its own header carries. Neither was checked anywhere in"
        "this program before -- Domain.Message could compute a checksum and"
        "read one out of a header, and nothing ever compared them, so a"
        "corrupted payload reached the decoders and surfaced as whatever they"
        "made of it. A wire fault looked like a protocol bug."
        "A header announcing a payload larger than the protocol allows is the"
        "one thing here that is refused outright. Reading exactly what a"
        "socket is told to read has a ceiling underneath it; a buffer this"
        "program fills itself does not, so the ceiling has to be named."
        "Messages are cut off the front of the buffer one at a time rather"
        "than all at once into a queue. The queue came first and the compiler"
        "took it away: a record kept as a Map value has Eq and Hash derived"
        "for it, and a Frame satisfies neither, so a queue of them could not"
        "live beside the buffer. What replaced it is smaller -- the buffer is"
        "the queue -- and it costs a caller nothing, because a caller waiting"
        "on one Message discards the others exactly as it always did."
    exposes [Frame, TakenOne, Buffer, emptyBuffer, Standing, Popped, PoppedAt, maxPayload, firstOf, noStanding, saidBytes, seated, offered, addressesHeld, faultyIn, forgotten, absorbedInto, popped, poppedAny, greeted, standingAt]
    depends [Bytes, Domain.Message, Domain.Network]
    effects []

record Frame
    command: String
    body: List<Int>

record TakenOne
    frame: Frame
    rest: Bytes

record Buffer
    settled: Bytes
    arriving: List<Bytes>
    arrivingLen: Int

record Standing
    address: String
    buffer: Buffer
    version: Int
    agent: String
    sent: Int
    received: Int
    inbound: Bool
    height: Int
    services: Int

record Popped
    held: Standing
    frame: Frame

record PoppedAt
    held: Standing
    key: Int
    frame: Frame

fn maxPayload() -> Int
    ? "The largest payload a Message is allowed to announce."
      "Four million bytes, which is Bitcoin Core's"
      "MAX_PROTOCOL_MESSAGE_LENGTH -- the number a Peer is entitled to expect"
      "us to accept, and the number above which it is not being honest. A"
      "Block at the consensus weight limit fits underneath it, which is what"
      "the limit was chosen to allow."
    4000000

verify maxPayload
    maxPayload() => 4000000

fn firstOf(network: Network, buffer: Bytes) -> Result<Option<TakenOne>, String>
    ? "The first whole Message the buffer holds, and what follows it."
      "Nothing is not an error: a Peer that has sent half a Message has sent"
      "half a Message, and the rest of it is on its way."
    match Bytes.len(buffer) < Domain.Message.headerLength()
        true -> Result.Ok(Option.None)
        false -> sized(network, buffer, Domain.Message.payloadLengthAt(Bytes.octets(Bytes.take(buffer, Domain.Message.headerLength()))))

verify firstOf
    firstOf(Network.Signet, Bytes.empty()) => Result.Ok(Option.None)
    firstOf(Network.Signet, Bytes.fromList([1, 2, 3])) => Result.Ok(Option.None)
    firstOf(Network.Signet, Bytes.fromList(oneMessage())?) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "verack", body = []), rest = Bytes.empty())))
    firstOf(Network.Signet, Bytes.fromList(List.concat(oneMessage(), [9, 9]))?) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "verack", body = []), rest = Bytes.fromList([9, 9]))))
    firstOf(Network.Signet, Bytes.fromList(withPayload())?) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "ping", body = [1, 2, 3, 4, 5, 6, 7, 8]), rest = Bytes.empty())))
    firstOf(Network.Signet, Bytes.fromList(List.take(withPayload(), 27))?) => Result.Ok(Option.None)
    firstOf(Network.Signet, Bytes.fromList(overLong())?) => Result.Err("a Message announced 4000001 payload bytes, which is more than the 4000000 the protocol allows")
    firstOf(Network.Mainnet, Bytes.fromList(oneMessage())?) => Result.Err("a Message arrived framed for another Network")
    firstOf(Network.Signet, Bytes.fromList(corrupted())?) => Result.Err("a Message did not match the checksum its own header carries")

fn sized(network: Network, buffer: Bytes, announced: Int) -> Result<Option<TakenOne>, String>
    ? "A payload larger than the protocol allows ends the conversation."
      "There is no reading past it and no waiting for it: the length is four"
      "bytes of a header this program has already accepted, so a stream that"
      "carries an impossible one is either a Peer misbehaving or a stream we"
      "have lost our place in, and neither is survivable by reading more."
    match announced > maxPayload()
        true -> Result.Err(tooLong(announced))
        false -> whole(network, buffer, announced)

verify sized
    sized(Network.Signet, Bytes.fromList(oneMessage())?, 0) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "verack", body = []), rest = Bytes.empty())))
    sized(Network.Signet, Bytes.fromList(oneMessage())?, 4000001) => Result.Err("a Message announced 4000001 payload bytes, which is more than the 4000000 the protocol allows")
    sized(Network.Signet, Bytes.fromList(oneMessage())?, 4000000) => Result.Ok(Option.None)

fn tooLong(announced: Int) -> String
    ? "What to say about a header that announces the impossible."
    "a Message announced {announced} payload bytes, which is more than the {maxPayload()} the protocol allows"

verify tooLong
    tooLong(4000001) => "a Message announced 4000001 payload bytes, which is more than the 4000000 the protocol allows"

fn whole(network: Network, buffer: Bytes, announced: Int) -> Result<Option<TakenOne>, String>
    ? "The Message is only there if all of it is there."
    match Bytes.len(buffer) < Domain.Message.headerLength() + announced
        true -> Result.Ok(Option.None)
        false -> cut(network, buffer, announced)

verify whole
    whole(Network.Signet, Bytes.fromList(oneMessage())?, 0) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "verack", body = []), rest = Bytes.empty())))
    whole(Network.Signet, Bytes.fromList(oneMessage())?, 1) => Result.Ok(Option.None)

fn cut(network: Network, buffer: Bytes, announced: Int) -> Result<Option<TakenOne>, String>
    ? "Take this Message out, once it is one this Network sent."
    header = Bytes.octets(Bytes.take(buffer, Domain.Message.headerLength()))
    body = Bytes.take(Bytes.drop(buffer, Domain.Message.headerLength()), announced)
    magicChecked(network, header, body, Bytes.drop(buffer, Domain.Message.headerLength() + announced))

verify cut
    cut(Network.Signet, Bytes.fromList(oneMessage())?, 0) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "verack", body = []), rest = Bytes.empty())))
    cut(Network.Signet, Bytes.fromList(withPayload())?, 8) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "ping", body = [1, 2, 3, 4, 5, 6, 7, 8]), rest = Bytes.empty())))
    cut(Network.Mainnet, Bytes.fromList(oneMessage())?, 0) => Result.Err("a Message arrived framed for another Network")

fn magicChecked(network: Network, header: List<Int>, body: Bytes, rest: Bytes) -> Result<Option<TakenOne>, String>
    ? "The four bytes that say which chain this Message belongs to."
      "A Message framed for another Network is not a Message we misread; it"
      "is a Peer on a different chain, or a stream this program has lost its"
      "place in. Either way there is nothing to be done by reading on."
    match Domain.Message.magicAt(header) == Domain.Network.magicOf(network)
        false -> Result.Err("a Message arrived framed for another Network")
        true -> sumChecked(header, body, rest)

verify magicChecked
    magicChecked(Network.Signet, List.take(oneMessage(), 24), Bytes.empty(), Bytes.empty()) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "verack", body = []), rest = Bytes.empty())))
    magicChecked(Network.Mainnet, List.take(oneMessage(), 24), Bytes.empty(), Bytes.empty()) => Result.Err("a Message arrived framed for another Network")

fn sumChecked(header: List<Int>, body: Bytes, rest: Bytes) -> Result<Option<TakenOne>, String>
    ? "The payload has to hash to the checksum its own header carries."
      "Four bytes of double-SHA256, which is what every other Bitcoin"
      "implementation checks and what this one never did. It catches a"
      "corrupted payload before a decoder makes something of it, which is the"
      "difference between a wire fault reported as a wire fault and one"
      "reported as whatever the Transaction decoder said about the wreckage."
    match Domain.Message.checksumAt(header) == Domain.Message.checksumOf(body)
        false -> Result.Err("a Message did not match the checksum its own header carries")
        true -> Result.Ok(Option.Some(TakenOne(frame = Frame(command = Domain.Message.commandAt(header), body = Bytes.octets(body)), rest = rest)))

verify sumChecked
    sumChecked(List.take(oneMessage(), 24), Bytes.empty(), Bytes.empty()) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "verack", body = []), rest = Bytes.empty())))
    sumChecked(List.take(withPayload(), 24), Bytes.fromList([1, 2, 3, 4, 5, 6, 7, 8]), Bytes.empty()) => Result.Ok(Option.Some(TakenOne(frame = Frame(command = "ping", body = [1, 2, 3, 4, 5, 6, 7, 8]), rest = Bytes.empty())))
    sumChecked(List.take(oneMessage(), 24), Bytes.fromList([9]), Bytes.empty()) => Result.Err("a Message did not match the checksum its own header carries")

fn noStanding() -> Map<Int, Standing>
    ? "Nothing known about anybody yet."
    Map.fromList([])

fn seated(standing: Map<Int, Standing>, key: Int, address: String, inbound: Bool) -> Map<Int, Standing>
    ? "A Peer just joined, with nothing said in either direction yet."
      "The Peer Address is kept as text rather than as a PeerAddress, for the"
      "same reason the queue went: a Map value has Eq and Hash derived for it"
      "and an opaque record satisfies neither. Nothing here parses it, so"
      "text is what it is for."
      "inbound says which side dialled. It is a fact about the Peer rather"
      "than about the socket, and it never changes: an inbound Peer chose us,"
      "which is the whole reason inbound slots need defending in a way"
      "outbound ones never did (n1bor/btc-listener#30). It is also what a"
      "Peers Panel shows in its direction column (#164)."
    Map.set(standing, key, Standing(address = address, buffer = emptyBuffer(), version = 0, agent = "", sent = 0, received = 0, inbound = inbound, height = 0, services = 0))

verify seated
    Map.len(seated(noStanding(), 0, "192.0.2.1:8333", false)) => 1
    standingAt(seated(noStanding(), 0, "192.0.2.1:8333", false), 0) => Option.Some(Standing(address = "192.0.2.1:8333", buffer = emptyBuffer(), version = 0, agent = "", sent = 0, received = 0, inbound = false, height = 0, services = 0))
    standingAt(seated(noStanding(), 0, "192.0.2.1:8333", true), 0) => Option.Some(Standing(address = "192.0.2.1:8333", buffer = emptyBuffer(), version = 0, agent = "", sent = 0, received = 0, inbound = true, height = 0, services = 0))

fn addressesHeld(standing: Map<Int, Standing>) -> List<String>
    ? "Where every Peer currently held can be reached."
      "The Address gossip hands back the Peers we are already talking to --"
      "they are, after all, the addresses our Peers know best -- so something"
      "has to be able to say which those are."
    eachAddress(standing, Map.keys(standing), [])

verify addressesHeld
    addressesHeld(noStanding()) => []
    addressesHeld(oneSeated()) => ["192.0.2.1:8333"]
    List.len(addressesHeld(seated(oneSeated(), 1, "192.0.2.2:8333", false))) => 2

fn eachAddress(standing: Map<Int, Standing>, keys: List<Int>, acc: List<String>) -> List<String>
    ? "One Peer at a time, in identifier order."
    match keys
        [] -> List.reverse(acc)
        [head, ..tail] -> eachAddress(standing, tail, withAddress(acc, Map.get(standing, head)))

verify eachAddress
    eachAddress(noStanding(), [], []) => []
    eachAddress(oneSeated(), [0], []) => ["192.0.2.1:8333"]

fn withAddress(acc: List<String>, held: Option<Standing>) -> List<String>
    ? "A Peer we do not hold contributes nothing."
    match held
        Option.None -> acc
        Option.Some(one) -> List.prepend(one.address, acc)

verify withAddress
    withAddress([], Option.None) => []
    withAddress([], Option.Some(emptyStanding())) => ["192.0.2.1:8333"]

fn standingAt(standing: Map<Int, Standing>, key: Int) -> Option<Standing>
    ? "What is known about one Peer, if it is one we hold."
    Map.get(standing, key)

fn forgotten(standing: Map<Int, Standing>, key: Int) -> Map<Int, Standing>
    ? "Drop everything known about one Peer."
    Map.remove(standing, key)

verify forgotten
    Map.len(forgotten(oneSeated(), 0)) => 0
    Map.len(forgotten(noStanding(), 0)) => 0

fn absorbedInto(standing: Map<Int, Standing>, key: Int, arrived: Bytes) -> Map<Int, Standing>
    ? "Bytes just read from one Peer, onto the end of its buffer."
    match Map.get(standing, key)
        Option.None -> standing
        Option.Some(held) -> Map.set(standing, key, Standing(address = held.address, buffer = absorbed(held.buffer, arrived), version = held.version, agent = held.agent, sent = held.sent, received = held.received + Bytes.len(arrived), inbound = held.inbound, height = held.height, services = held.services))

verify absorbedInto
    absorbedInto(noStanding(), 0, Bytes.fromList([1, 2])) => noStanding()
    standingBuffer(absorbedInto(oneSeated(), 0, Bytes.fromList([1, 2])), 0) => [1, 2]
    standingBuffer(absorbedInto(absorbedInto(oneSeated(), 0, Bytes.fromList([1])), 0, Bytes.fromList([2])), 0) => [1, 2]

fn emptyBuffer() -> Buffer
    ? "Nothing read from this Peer yet."
    Buffer(settled = Bytes.empty(), arriving = [], arrivingLen = 0)

verify emptyBuffer
    bufferLen(emptyBuffer()) => 0

fn absorbed(buffer: Buffer, arrived: Bytes) -> Buffer
    ? "One read's bytes kept as they came, newest first, and not yet joined"
      "to what was there (#280 item 17). Joining on every read copied the"
      "whole buffer each time: a 4 MB Block arriving in 64 KB reads was"
      "copied sixty-four times over, some 128 MB of copying for one"
      "Message. The join waits until the bytes for a whole Message are here"
      "(settledIfWhole), so each byte is copied a bounded number of times"
      "however many reads carried it."
    Buffer(settled = buffer.settled, arriving = List.prepend(arrived, buffer.arriving), arrivingLen = buffer.arrivingLen + Bytes.len(arrived))

verify absorbed
    bufferLen(absorbed(emptyBuffer(), Bytes.fromList([1, 2, 3]))) => 3
    bufferLen(absorbed(absorbed(emptyBuffer(), Bytes.fromList([1, 2, 3])), Bytes.fromList([4]))) => 4
    Bytes.octets(allOf(absorbed(absorbed(emptyBuffer(), Bytes.fromList([1, 2, 3])), Bytes.fromList([4])))) => [1, 2, 3, 4]

fn bufferLen(buffer: Buffer) -> Int
    ? "Every byte held for this Peer, joined or not."
    Bytes.len(buffer.settled) + buffer.arrivingLen

verify bufferLen
    bufferLen(Buffer(settled = Bytes.fromList([1, 2]), arriving = [Bytes.fromList([3])], arrivingLen = 1)) => 3

fn allOf(buffer: Buffer) -> Bytes
    ? "The whole buffer as one run of bytes, oldest first."
    Bytes.concat(buffer.settled, joined(List.reverse(buffer.arriving)))

verify allOf
    Bytes.octets(allOf(emptyBuffer())) => []
    Bytes.octets(allOf(Buffer(settled = Bytes.fromList([1]), arriving = [Bytes.fromList([3]), Bytes.fromList([2])], arrivingLen = 2))) => [1, 2, 3]

fn joinedUp(buffer: Buffer) -> Buffer
    ? "Every read joined into one run of bytes."
    Buffer(settled = allOf(buffer), arriving = [], arrivingLen = 0)

verify joinedUp
    joinedUp(Buffer(settled = Bytes.fromList([1]), arriving = [Bytes.fromList([3]), Bytes.fromList([2])], arrivingLen = 2)) => Buffer(settled = Bytes.fromList([1, 2, 3]), arriving = [], arrivingLen = 0)

fn joined(chunks: List<Bytes>) -> Bytes
    ? "Many runs of bytes as one, joined pairwise so no byte is copied more"
      "than log2 of the number of runs times: joining each onto a growing"
      "whole would copy the whole again for every run."
    match chunks
        [] -> Bytes.empty()
        [one, ..rest] -> joinedOnward(one, rest, chunks)

verify joined
    Bytes.octets(joined([])) => []
    Bytes.octets(joined([Bytes.fromList([1])])) => [1]
    Bytes.octets(joined([Bytes.fromList([1]), Bytes.fromList([2]), Bytes.fromList([3])])) => [1, 2, 3]
    Bytes.octets(joined([Bytes.fromList([1, 2]), Bytes.fromList([]), Bytes.fromList([3]), Bytes.fromList([4, 5]), Bytes.fromList([6])])) => [1, 2, 3, 4, 5, 6]

fn joinedOnward(one: Bytes, rest: List<Bytes>, chunks: List<Bytes>) -> Bytes
    ? "One run is the answer; more are paired and joined again."
    match rest
        [] -> one
        [second, ..more] -> joined(paired(chunks, []))

verify joinedOnward
    Bytes.octets(joinedOnward(Bytes.fromList([1]), [], [Bytes.fromList([1])])) => [1]
    Bytes.octets(joinedOnward(Bytes.fromList([1]), [Bytes.fromList([2])], [Bytes.fromList([1]), Bytes.fromList([2])])) => [1, 2]

fn paired(chunks: List<Bytes>, acc: List<Bytes>) -> List<Bytes>
    ? "Adjacent runs joined two at a time, order kept; an odd last one stands."
    match chunks
        [] -> List.reverse(acc)
        [first, ..afterFirst] -> pairedWith(first, afterFirst, acc)

verify paired
    paired([], []) => []
    paired([Bytes.fromList([1]), Bytes.fromList([2]), Bytes.fromList([3])], []) => [Bytes.fromList([1, 2]), Bytes.fromList([3])]
    paired([Bytes.fromList([1]), Bytes.fromList([2]), Bytes.fromList([3]), Bytes.fromList([4])], []) => [Bytes.fromList([1, 2]), Bytes.fromList([3, 4])]

fn pairedWith(first: Bytes, afterFirst: List<Bytes>, acc: List<Bytes>) -> List<Bytes>
    ? "The run after the first, joined to it if there is one."
    match afterFirst
        [] -> List.reverse(List.prepend(first, acc))
        [second, ..rest] -> paired(rest, List.prepend(Bytes.concat(first, second), acc))

verify pairedWith
    pairedWith(Bytes.fromList([1]), [], []) => [Bytes.fromList([1])]
    pairedWith(Bytes.fromList([1]), [Bytes.fromList([2])], []) => [Bytes.fromList([1, 2])]

fn settledIfWhole(buffer: Buffer) -> Option<Buffer>
    ? "The reads joined, when what is held is at least one whole Message,"
      "or a header announcing more than a Message may carry, which is an"
      "error the join lets firstOf raise. Otherwise nothing: the bytes"
      "stay as they came and the next read is one prepend."
      "How much is needed is read off the header, which may itself sit"
      "across the settled bytes and the first reads, so headOf gathers"
      "just those twenty-four bytes rather than joining everything to"
      "learn that the Message is not here yet."
    match Bool.and(buffer.arrivingLen > 0, bufferLen(buffer) >= neededBy(headOf(buffer.settled, List.reverse(buffer.arriving))))
        true -> Option.Some(joinedUp(buffer))
        false -> Option.None

verify settledIfWhole
    settledIfWhole(emptyBuffer()) => Option.None
    settledIfWhole(absorbed(emptyBuffer(), Bytes.fromList([1, 2, 3]))) => Option.None
    settledIfWhole(absorbed(emptyBuffer(), Bytes.fromList(List.take(withPayload(), 27))?)) => Option.None
    settledIfWhole(absorbed(absorbed(emptyBuffer(), Bytes.fromList(List.take(withPayload(), 27))?), Bytes.fromList(List.drop(withPayload(), 27))?)) => Option.Some(Buffer(settled = Bytes.fromList(withPayload())?, arriving = [], arrivingLen = 0))
    settledIfWhole(absorbed(emptyBuffer(), Bytes.fromList(oneMessage())?)) => Option.Some(Buffer(settled = Bytes.fromList(oneMessage())?, arriving = [], arrivingLen = 0))
    settledIfWhole(absorbed(absorbed(emptyBuffer(), Bytes.fromList(List.take(overLong(), 10))?), Bytes.fromList(List.drop(overLong(), 10))?)) => Option.Some(Buffer(settled = Bytes.fromList(overLong())?, arriving = [], arrivingLen = 0))
    settledIfWhole(Buffer(settled = Bytes.fromList(oneMessage())?, arriving = [], arrivingLen = 0)) => Option.None

fn headOf(front: Bytes, oldestFirst: List<Bytes>) -> Bytes
    ? "At least a header's worth of the buffer's front, if that much is held,"
      "gathered from the settled bytes and then one read at a time."
    match Bytes.len(front) >= Domain.Message.headerLength()
        true -> Bytes.take(front, Domain.Message.headerLength())
        false -> headOnward(front, oldestFirst)

verify headOf
    Bytes.octets(headOf(Bytes.empty(), [])) => []
    Bytes.octets(headOf(Bytes.fromList([1, 2]), [Bytes.fromList([3]), Bytes.fromList([4])])) => [1, 2, 3, 4]
    Bytes.len(headOf(Bytes.fromList(List.take(oneMessage(), 10))?, [Bytes.fromList(List.drop(oneMessage(), 10))?])) => 24
    Bytes.len(headOf(Bytes.fromList(withPayload())?, [])) => 24

fn headOnward(front: Bytes, oldestFirst: List<Bytes>) -> Bytes
    ? "The next read's first bytes onto the front, or the front as it stands."
    match oldestFirst
        [] -> front
        [one, ..rest] -> headOf(Bytes.concat(front, Bytes.take(one, Domain.Message.headerLength())), rest)

verify headOnward
    Bytes.octets(headOnward(Bytes.fromList([1]), [])) => [1]
    Bytes.octets(headOnward(Bytes.fromList([1]), [Bytes.fromList([2, 3])])) => [1, 2, 3]

fn neededBy(head: Bytes) -> Int
    ? "How many bytes a whole Message needs, read off its header: the header"
      "alone until there is one, then header and announced payload, or the"
      "header alone again when the announcement is impossible, so that"
      "firstOf sees it and ends the conversation now rather than after"
      "four megabytes of whatever follows."
    match Bytes.len(head) < Domain.Message.headerLength()
        true -> Domain.Message.headerLength()
        false -> neededFor(Domain.Message.payloadLengthAt(Bytes.octets(Bytes.take(head, Domain.Message.headerLength()))))

verify neededBy
    neededBy(Bytes.empty()) => 24
    neededBy(Bytes.fromList(oneMessage())?) => 24
    neededBy(Bytes.fromList(withPayload())?) => 32
    neededBy(Bytes.fromList(overLong())?) => 24

fn neededFor(announced: Int) -> Int
    ? "Header and payload, or the header alone for an impossible payload."
    match announced > maxPayload()
        true -> Domain.Message.headerLength()
        false -> Domain.Message.headerLength() + announced

verify neededFor
    neededFor(0) => 24
    neededFor(8) => 32
    neededFor(4000001) => 24

fn popped(network: Network, standing: Map<Int, Standing>, key: Int) -> Result<Option<Popped>, String>
    ? "Take the oldest whole Message one Peer has sent and not had read,"
      "with what that Peer's standing becomes. The map is only read here:"
      "the caller sets the standing back into the map it holds, so the map"
      "has one holder when it is set."
    match Map.get(standing, key)
        Option.None -> Result.Ok(Option.None)
        Option.Some(held) -> poppedSettling(network, held, firstOf(network, held.buffer.settled))

verify popped
    popped(Network.Signet, noStanding(), 0) => Result.Ok(Option.None)
    popped(Network.Signet, oneSeated(), 0) => Result.Ok(Option.None)
    popped(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(oneMessage())?), 0) => Result.Ok(Option.Some(Popped(held = readOnce(), frame = Frame(command = "verack", body = []))))
    popped(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(overLong())?), 0) => Result.Err("a Message announced 4000001 payload bytes, which is more than the 4000000 the protocol allows")
    popped(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(corrupted())?), 0) => Result.Err("a Message did not match the checksum its own header carries")

fn poppedSettling(network: Network, held: Standing, found: Result<Option<TakenOne>, String>) -> Result<Option<Popped>, String>
    ? "A Message among the settled bytes is taken from them; none there, and"
      "the reads are joined and looked at, but only once they hold a whole"
      "one (#280 item 17). A join that finds nothing is never done: the"
      "standing handed back on None is the one held, so a join then would"
      "be repeated on every read until the Message completed."
    match found
        Result.Err(why) -> Result.Err(why)
        Result.Ok(Option.Some(taken)) -> poppedOne(held, Option.Some(taken))
        Result.Ok(Option.None) -> poppedJoined(network, held, settledIfWhole(held.buffer))

verify poppedSettling
    poppedSettling(Network.Signet, emptyStanding(), Result.Err("no")) => Result.Err("no")
    poppedSettling(Network.Signet, emptyStanding(), Result.Ok(Option.None)) => Result.Ok(Option.None)
    poppedSettling(Network.Signet, emptyStanding(), Result.Ok(Option.Some(TakenOne(frame = sampleFrame(), rest = Bytes.empty())))) => Result.Ok(Option.Some(Popped(held = emptyStanding(), frame = sampleFrame())))
    poppedSettling(Network.Signet, Standing.update(emptyStanding(), buffer = absorbed(absorbed(emptyBuffer(), Bytes.fromList(List.take(withPayload(), 27))?), Bytes.fromList(List.drop(withPayload(), 27))?)), Result.Ok(Option.None)) => Result.Ok(Option.Some(Popped(held = emptyStanding(), frame = Frame(command = "ping", body = [1, 2, 3, 4, 5, 6, 7, 8]))))
    poppedSettling(Network.Signet, Standing.update(emptyStanding(), buffer = absorbed(emptyBuffer(), Bytes.fromList(List.take(withPayload(), 27))?)), Result.Ok(Option.None)) => Result.Ok(Option.None)

fn poppedJoined(network: Network, held: Standing, ready: Option<Buffer>) -> Result<Option<Popped>, String>
    ? "The joined reads cut, when there was a whole Message to join for."
    match ready
        Option.None -> Result.Ok(Option.None)
        Option.Some(buffer) -> poppedFrom(Standing.update(held, buffer = buffer), firstOf(network, buffer.settled))

verify poppedJoined
    poppedJoined(Network.Signet, emptyStanding(), Option.None) => Result.Ok(Option.None)
    poppedJoined(Network.Signet, emptyStanding(), Option.Some(Buffer(settled = Bytes.fromList(oneMessage())?, arriving = [], arrivingLen = 0))) => Result.Ok(Option.Some(Popped(held = emptyStanding(), frame = Frame(command = "verack", body = []))))
    poppedJoined(Network.Signet, emptyStanding(), Option.Some(Buffer(settled = Bytes.fromList(corrupted())?, arriving = [], arrivingLen = 0))) => Result.Err("a Message did not match the checksum its own header carries")

fn poppedFrom(held: Standing, found: Result<Option<TakenOne>, String>) -> Result<Option<Popped>, String>
    ? "A buffer with no whole Message in it is a Peer mid-sentence."
    match found
        Result.Err(why) -> Result.Err(why)
        Result.Ok(one) -> poppedOne(held, one)

verify poppedFrom
    poppedFrom(emptyStanding(), Result.Ok(Option.None)) => Result.Ok(Option.None)
    poppedFrom(emptyStanding(), Result.Err("no")) => Result.Err("no")

fn poppedOne(held: Standing, one: Option<TakenOne>) -> Result<Option<Popped>, String>
    ? "The Message off the front, and the buffer shortened by exactly it."
    match one
        Option.None -> Result.Ok(Option.None)
        Option.Some(taken) -> Result.Ok(Option.Some(Popped(held = Standing.update(held, buffer = shortened(held.buffer, taken.rest)), frame = taken.frame)))

verify poppedOne
    poppedOne(emptyStanding(), Option.None) => Result.Ok(Option.None)
    poppedOne(emptyStanding(), Option.Some(TakenOne(frame = sampleFrame(), rest = Bytes.empty()))) => Result.Ok(Option.Some(Popped(held = emptyStanding(), frame = sampleFrame())))

fn shortened(buffer: Buffer, rest: Bytes) -> Buffer
    ? "The settled bytes replaced by what followed the Message cut from them."
    Buffer.update(buffer, settled = rest)

verify shortened
    shortened(emptyBuffer(), Bytes.fromList([9])) => Buffer(settled = Bytes.fromList([9]), arriving = [], arrivingLen = 0)

fn poppedAny(network: Network, standing: Map<Int, Standing>) -> Result<Option<PoppedAt>, String>
    ? "The next Message any Peer has sent and not had read, and which Peer."
      "What a node's loop actually wants. With one Peer, waiting for the next"
      "Message and waiting for the next Message from that Peer were the same"
      "thing; with several they are not, and it is the difference between a"
      "node that hears an Announcement and one that hears it eventually."
      "Identifier order, which is arbitrary but fixed. One Message per turn"
      "and not a whole buffer, so a Peer that talks a great deal cannot keep"
      "the loop from reaching the others."
    firstWith(network, standing, Map.keys(standing))

verify poppedAny
    poppedAny(Network.Signet, noStanding()) => Result.Ok(Option.None)
    poppedAny(Network.Signet, oneSeated()) => Result.Ok(Option.None)
    poppedAny(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(oneMessage())?)) => Result.Ok(Option.Some(PoppedAt(held = readOnce(), key = 0, frame = Frame(command = "verack", body = []))))
    poppedAny(Network.Signet, absorbedInto(seated(oneSeated(), 1, "192.0.2.2:8333", false), 1, Bytes.fromList(oneMessage())?)) => Result.Ok(Option.Some(PoppedAt(held = Standing(address = "192.0.2.2:8333", buffer = emptyBuffer(), version = 0, agent = "", sent = 0, received = 24, inbound = false, height = 0, services = 0), key = 1, frame = Frame(command = "verack", body = []))))

fn firstWith(network: Network, standing: Map<Int, Standing>, keys: List<Int>) -> Result<Option<PoppedAt>, String>
    ? "The first Peer, in identifier order, with a whole Message waiting."
    match keys
        [] -> Result.Ok(Option.None)
        [head, ..tail] -> orNext(network, standing, head, tail, popped(network, standing, head))

verify firstWith
    firstWith(Network.Signet, oneSeated(), []) => Result.Ok(Option.None)
    firstWith(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(oneMessage())?), [0]) => Result.Ok(Option.Some(PoppedAt(held = readOnce(), key = 0, frame = Frame(command = "verack", body = []))))

fn orNext(network: Network, standing: Map<Int, Standing>, key: Int, rest: List<Int>, found: Result<Option<Popped>, String>) -> Result<Option<PoppedAt>, String>
    ? "This Peer had something, or the next one is asked."
    match found
        Result.Err(why) -> Result.Err("peer {key}: {why}")
        Result.Ok(one) -> orNextOk(network, standing, key, rest, one)

verify orNext
    orNext(Network.Signet, oneSeated(), 0, [], Result.Ok(Option.None)) => Result.Ok(Option.None)
    orNext(Network.Signet, oneSeated(), 0, [], Result.Err("no")) => Result.Err("peer 0: no")

fn orNextOk(network: Network, standing: Map<Int, Standing>, key: Int, rest: List<Int>, one: Option<Popped>) -> Result<Option<PoppedAt>, String>
    ? "Name the Peer beside the Message, or carry on down the list."
    match one
        Option.Some(found) -> Result.Ok(Option.Some(PoppedAt(held = found.held, key = key, frame = found.frame)))
        Option.None -> firstWith(network, standing, rest)

verify orNextOk
    orNextOk(Network.Signet, oneSeated(), 0, [], Option.None) => Result.Ok(Option.None)
    orNextOk(Network.Signet, oneSeated(), 0, [], Option.Some(Popped(held = emptyStanding(), frame = sampleFrame()))) => Result.Ok(Option.Some(PoppedAt(held = emptyStanding(), key = 0, frame = sampleFrame())))

fn faultyIn(network: Network, standing: Map<Int, Standing>) -> Option<Int>
    ? "Which Peer has said something this program will not read on from."
      "Asked only after a read has already failed, to name the Peer whose"
      "stream it was. With one Peer that question answered itself; with"
      "several the node has to know which one to drop, and dropping the wrong"
      "one would leave the offender in place and remove an innocent Peer."
    firstFaulty(network, standing, Map.keys(standing))

verify faultyIn
    faultyIn(Network.Signet, noStanding()) => Option.None
    faultyIn(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(oneMessage())?)) => Option.None
    faultyIn(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(corrupted())?)) => Option.Some(0)
    faultyIn(Network.Signet, absorbedInto(seated(oneSeated(), 1, "192.0.2.2:8333", false), 1, Bytes.fromList(overLong())?)) => Option.Some(1)

fn firstFaulty(network: Network, standing: Map<Int, Standing>, keys: List<Int>) -> Option<Int>
    ? "The first Peer, in identifier order, whose buffer will not be read."
    match keys
        [] -> Option.None
        [head, ..tail] -> faultyOrNext(network, standing, head, tail)

verify firstFaulty
    firstFaulty(Network.Signet, oneSeated(), []) => Option.None
    firstFaulty(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(corrupted())?), [0]) => Option.Some(0)

fn faultyOrNext(network: Network, standing: Map<Int, Standing>, key: Int, rest: List<Int>) -> Option<Int>
    ? "This Peer if its buffer is the problem, otherwise the next."
    match popped(network, standing, key)
        Result.Err(why) -> Option.Some(key)
        Result.Ok(fine) -> firstFaulty(network, standing, rest)

verify faultyOrNext
    faultyOrNext(Network.Signet, absorbedInto(oneSeated(), 0, Bytes.fromList(corrupted())?), 0, []) => Option.Some(0)
    faultyOrNext(Network.Signet, oneSeated(), 0, []) => Option.None

fn saidBytes(standing: Map<Int, Standing>, key: Int, count: Int) -> Map<Int, Standing>
    ? "Count bytes put on one Peer's wire (#131)."
      "Kept beside the received count absorbedInto keeps, so the two totals"
      "a Peers Panel shows come from the two places bytes actually cross."
    match Map.get(standing, key)
        Option.None -> standing
        Option.Some(held) -> Map.set(standing, key, Standing(address = held.address, buffer = held.buffer, version = held.version, agent = held.agent, sent = held.sent + count, received = held.received, inbound = held.inbound, height = held.height, services = held.services))

verify saidBytes
    standingAt(saidBytes(seated(noStanding(), 0, "a", false), 0, 24), 0) => Option.Some(Standing(address = "a", buffer = emptyBuffer(), version = 0, agent = "", sent = 24, received = 0, inbound = false, height = 0, services = 0))
    standingAt(saidBytes(saidBytes(seated(noStanding(), 0, "a", false), 0, 24), 0, 10), 0) => Option.Some(Standing(address = "a", buffer = emptyBuffer(), version = 0, agent = "", sent = 34, received = 0, inbound = false, height = 0, services = 0))
    Map.len(saidBytes(noStanding(), 9, 24)) => 0

fn offered(standing: Map<Int, Standing>, key: Int, services: Int) -> Map<Int, Standing>
    ? "The service bits a Peer's version offered, kept the moment they arrive"
      "(#280 item 16): a Peer without NODE_WITNESS is never asked for Blocks."
    match Map.get(standing, key)
        Option.None -> standing
        Option.Some(held) -> Map.set(standing, key, Standing.update(held, services = services))

verify offered
    servicesAt(offered(oneSeated(), 0, 9), 0) => 9
    servicesAt(offered(oneSeated(), 0, 9), 7) => 0
    servicesAt(offered(noStanding(), 0, 9), 0) => 0

fn servicesAt(standing: Map<Int, Standing>, key: Int) -> Int
    ? "The bits a Peer offered, or none for a key not seated."
    match Map.get(standing, key)
        Option.None -> 0
        Option.Some(held) -> held.services

verify servicesAt
    servicesAt(noStanding(), 0) => 0

fn greeted(standing: Map<Int, Standing>, key: Int, version: Int, agent: String, height: Int) -> Map<Int, Standing>
    ? "What a Peer told us about itself once its Handshake completed: its"
      "protocol version, its user agent, and the Height it said it held."
      "The Height is kept because it is the one thing a Peer says about the"
      "chain before it says anything else (#328): a Peer seated claiming"
      "more than the tree holds is evidence this node is behind, and it"
      "used to be read and thrown away."
    match Map.get(standing, key)
        Option.None -> standing
        Option.Some(held) -> Map.set(standing, key, Standing(address = held.address, buffer = held.buffer, version = version, agent = agent, sent = held.sent, received = held.received, inbound = held.inbound, height = height, services = held.services))

verify greeted
    standingAgent(greeted(oneSeated(), 0, 70016, "/Satoshi:27.0.0/", 179), 0) => "/Satoshi:27.0.0/"
    standingHeight(greeted(oneSeated(), 0, 70016, "/Satoshi:27.0.0/", 179), 0) => 179
    standingHeight(greeted(oneSeated(), 0, 70016, "/Satoshi:27.0.0/", 179), 1) => 0
    Map.len(greeted(noStanding(), 0, 70016, "x", 179)) => 0

fn framed(command: String, payload: List<Int>) -> Result<List<Int>, String>
    ? "A Message built by the encoder, as the bytes it would put on the wire."
      "The cases here go through the encoder rather than spelling headers"
      "out, so what they prove is that the two halves of this program agree"
      "with each other -- which is the only thing a round trip can prove, and"
      "more than a hand-written header would."
    body = Bytes.fromList(payload)?
    wrapped = Domain.Message.frame(Network.Signet, command, body)?
    Result.Ok(Bytes.octets(wrapped))

verify framed
    List.len(framed("verack", [])?) => 24
    List.len(framed("ping", [1, 2, 3, 4, 5, 6, 7, 8])?) => 32
    Domain.Message.commandAt(List.take(framed("verack", [])?, 24)) => "verack"

fn oneMessage() -> List<Int>
    ? "A framed verack with no payload, for the cases here."
    Result.withDefault(framed("verack", []), [])

verify oneMessage
    List.len(oneMessage()) => 24

fn withPayload() -> List<Int>
    ? "A framed ping carrying its eight-byte nonce, for the cases here."
    Result.withDefault(framed("ping", [1, 2, 3, 4, 5, 6, 7, 8]), [])

verify withPayload
    List.len(withPayload()) => 32

fn overLong() -> List<Int>
    ? "A header announcing one byte more than the protocol allows."
    List.concat(List.concat(List.take(oneMessage(), 16), Domain.Message.littleEndian(maxPayload() + 1, 4)), List.drop(oneMessage(), 20))

verify overLong
    List.len(overLong()) => 24
    Domain.Message.payloadLengthAt(overLong()) => 4000001

fn corrupted() -> List<Int>
    ? "A ping whose payload one byte has changed in, for the cases here."
      "What a wire fault looks like: the header is intact and says the"
      "payload is eight bytes, and the eight bytes are not the ones hashed."
    List.concat(List.take(withPayload(), 31), [99])

verify corrupted
    List.len(corrupted()) => 32
    Domain.Message.payloadLengthAt(List.take(corrupted(), 24)) => 8

fn emptyStanding() -> Standing
    ? "A Peer just seated, for the cases here."
    Standing(address = "192.0.2.1:8333", buffer = emptyBuffer(), version = 0, agent = "", sent = 0, received = 0, inbound = false, height = 0, services = 0)

fn readOnce() -> Standing
    ? "The seated Peer once it has been read once: 24 bytes counted, buffer empty."
    Standing.update(emptyStanding(), received = 24)

fn oneSeated() -> Map<Int, Standing>
    ? "One Peer held under identifier zero, for the cases here."
    seated(noStanding(), 0, "192.0.2.1:8333", false)

verify oneSeated
    Map.len(oneSeated()) => 1

fn sampleFrame() -> Frame
    ? "A Message for the cases here."
    Frame(command = "verack", body = [])

fn standingBuffer(standing: Map<Int, Standing>, key: Int) -> List<Int>
    ? "The bytes not yet cut into Messages for one Peer, for the cases here."
    match bufferOf(Map.get(standing, key))
        Result.Err(_) -> []
        Result.Ok(buffer) -> Bytes.octets(buffer)

verify standingBuffer
    standingBuffer(noStanding(), 0) => []
    standingBuffer(oneSeated(), 0) => []
    standingBuffer(absorbedInto(oneSeated(), 0, Bytes.fromList([1, 2])), 0) => [1, 2]

fn bufferOf(held: Option<Standing>) -> Result<Bytes, String>
    ? "The buffer behind a Peer we may not hold."
    match held
        Option.None -> Result.Err("none")
        Option.Some(one) -> Result.Ok(allOf(one.buffer))

verify bufferOf
    bufferOf(Option.None) => Result.Err("none")
    bufferOf(Option.Some(emptyStanding())) => Result.Ok(Bytes.empty())

fn standingHeight(standing: Map<Int, Standing>, key: Int) -> Int
    ? "The Height a Peer claimed, for the cases here; zero for nobody."
    match Map.get(standing, key)
        Option.None -> 0
        Option.Some(held) -> held.height

verify standingHeight
    standingHeight(oneSeated(), 0) => 0
    standingHeight(noStanding(), 7) => 0
    standingHeight(greeted(oneSeated(), 0, 70016, "/Satoshi:27.0.0/", 179), 0) => 179

fn standingAgent(standing: Map<Int, Standing>, key: Int) -> String
    ? "What a Peer called itself, for the cases here."
    Result.withDefault(agentOf(Map.get(standing, key)), "")

fn agentOf(held: Option<Standing>) -> Result<String, String>
    ? "The agent behind a Peer we may not hold."
    match held
        Option.None -> Result.Err("none")
        Option.Some(one) -> Result.Ok(one.agent)

verify agentOf
    agentOf(Option.None) => Result.Err("none")
    agentOf(Option.Some(emptyStanding())) => Result.Ok("")
