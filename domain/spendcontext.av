module SpendContext
    intent =
        "What a signature commits to, carried down to the opcode that checks"
        "it."
        "A Script on its own cannot be checked for signatures at all. The"
        "signature in it commits to a Transaction -- which inputs it spends,"
        "which outputs it pays, and which of its own inputs is being signed --"
        "and an engine handed two Scripts and nothing else has none of that."
        "That was why Domain.Checksig answered undecided even for a well formed"
        "signature over a valid key: not for want of a curve, but for want of"
        "anything to check it against."
        "So a Context is the rules the run is judged under, and a spend if there"
        "is one. No spend is what the corpus cases are and what they should"
        "stay: a case that asserts what OP_CHECKSIG does to a stack should not"
        "need a Transaction invented for it. A spend comes from a real Input"
        "and carries the four things a legacy signature hash needs."
        "The rules travel here rather than beside, because the Context already"
        "reaches every opcode and which soft forks were in force is as much"
        "part of what a Script is run against as the Transaction is."
        "The Witness rides here too, and this is the only place it could. A"
        "witness spend needs three things the two Scripts do not carry: the"
        "stack the Witness supplies, the amount, and the Transaction BIP143"
        "commits to. The amount and the Transaction were already here for the"
        "legacy hash, so the Witness joining them costs one field and leaves"
        "Domain.SpendScript.check with the arity it had."
        "It is not read yet. Domain.Checksig still routes every signature to"
        "the legacy hash and n1bor/btc-listener#60 is where that changes; this"
        "is the plumbing under it, and the proof it is only plumbing is that"
        "no answer moved when it landed."
    exposes [Locking, lockingOf, withoutSignatures, SigVersion, Commitment, Context, bare, committed, inWitnessV0, sigVersionOf, hasSpend, amountOf, withPrevouts, prevoutsOf, transactionOf, inputIndexOf, rulesOf, overScript, messageFor, scriptCodeOf, witnessOf, emptyTransaction, signedTransaction, signedScriptCode]
    depends [Domain.Network, Bytes, Domain.Bip143, Domain.Bip341, Domain.Rules, Domain.ScriptParse, Domain.Sighash, Domain.Transaction]
    effects []

type SigVersion
    Base
    WitnessV0

record Commitment
    transaction: Transaction
    inputIndex: Int
    amount: Int
    scriptCode: String
    witness: List<String>
    sigVersion: SigVersion
    prevouts: List<Spent>

record Context
    rules: Rules
    spend: Option<Commitment>

fn bare(rules: Rules) -> Context
    ? "A run with no spend behind it, under these rules."
    Context(rules = rules, spend = Option.None)

verify bare
    bare(Domain.Rules.latest()).spend => Option.None
    bare(Domain.Rules.latest()).rules => Domain.Rules.latest()

fn committed(rules: Rules, transaction: Transaction, inputIndex: Int, amount: Int, scriptCode: String, witness: List<String>) -> Context
    ? "A run of one Input of a real Transaction against the Output it claims."
      "The amount is carried even though a legacy signature hash does not use"
      "it, because BIP143 does and the Input knows it here rather than three"
      "modules further down. The Witness is carried for the same reason and"
      "is empty for every Input that is not a witness spend, which below the"
      "SegWit activation is all of them."
    Context(rules = rules, spend = Option.Some(Commitment(transaction = transaction, inputIndex = inputIndex, amount = amount, scriptCode = scriptCode, witness = witness, sigVersion = SigVersion.Base, prevouts = [])))

verify committed
    scriptCodeOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => "51"
    rulesOf(committed(Domain.Rules.at(Network.Mainnet, 1), emptyTransaction(), 0, 5, "51", [])) => Domain.Rules.at(Network.Mainnet, 1)
    witnessOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", ["aabb", "cc"])) => ["aabb", "cc"]

fn inWitnessV0(context: Context, scriptCode: String) -> Context
    ? "The same spend, entered as a version zero witness program."
      "Two things change together and must not be changed apart: the Script"
      "code a signature commits to becomes the witness Script rather than the"
      "Output Script, and the hash becomes BIP143's rather than the legacy"
      "one. A caller that set one and forgot the other would compute a real"
      "message over the wrong bytes and get a clean, wrong answer."
      "A Context with no spend stays as it is: there is nothing to enter."
    match context.spend
        Option.None -> context
        Option.Some(commitment) -> Context(rules = context.rules, spend = Option.Some(Commitment(transaction = commitment.transaction, inputIndex = commitment.inputIndex, amount = commitment.amount, scriptCode = scriptCode, witness = commitment.witness, sigVersion = SigVersion.WitnessV0, prevouts = commitment.prevouts)))

verify inWitnessV0
    sigVersionOf(inWitnessV0(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", []), "52")) => SigVersion.WitnessV0
    scriptCodeOf(inWitnessV0(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", []), "52")) => "52"
    sigVersionOf(inWitnessV0(bare(Domain.Rules.latest()), "52")) => SigVersion.Base
    scriptCodeOf(withoutSignatures(inWitnessV0(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "5101ab52", []), "5101ab52"), [[171]])) => "5101ab52"

fn bip143Transaction() -> Transaction
    ? "The unsigned Transaction from BIP143's own P2SH-P2WPKH worked example."
      "Kept here so the routing can be checked end to end rather than by"
      "reading it: Domain.Bip143 proves it computes the message, and this"
      "proves a Context that entered the witness path actually asks for it."
    Result.withDefault(Domain.Transaction.decode(Bytes.toList(Result.withDefault(Bytes.fromHex("0100000001db6b1b20aa0fd7b23880be2ecbd4a98130974cf4748fb66092ac4d3ceb1a54770100000000feffffff02b8b4eb0b000000001976a914a457b684d7f0d539a46a45bbc043f35b59d0d96388ac0008af2f000000001976a914fd270b1ee6abcaea97fea7ad0402e8bd8ad6d77c88ac92040000"), Bytes.fromList([])))), emptyTransaction())

verify bip143Transaction
    Domain.Transaction.versionOf(bip143Transaction()) => 1
    List.len(Domain.Transaction.inputsOf(bip143Transaction())) => 1
    List.len(Domain.Transaction.outputsOf(bip143Transaction())) => 2

fn sigVersionOf(context: Context) -> SigVersion
    ? "Which signature hash this run's signatures commit to."
      "A Context with no spend answers Base, because there is no witness spend"
      "without a Transaction and nothing downstream can act on the difference."
    match context.spend
        Option.None -> SigVersion.Base
        Option.Some(commitment) -> commitment.sigVersion

verify sigVersionOf
    sigVersionOf(bare(Domain.Rules.latest())) => SigVersion.Base
    sigVersionOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => SigVersion.Base

fn withPrevouts(context: Context, prevouts: List<Spent>) -> Context
    ? "The same spend, told what every Input of the Transaction spends."
      "Taproot needs this and the two older signature hashes do not, which is"
      "why it arrives separately rather than as a seventh argument to"
      "committed: a caller that has not got it should not be made to say so."
      "An empty list means not supplied, and Domain.Bip341 refuses a message"
      "whose Prevout count does not match the Input count -- so a caller that"
      "forgets gets undecided rather than a message over the wrong bytes."
    match context.spend
        Option.None -> context
        Option.Some(commitment) -> Context(rules = context.rules, spend = Option.Some(Commitment(transaction = commitment.transaction, inputIndex = commitment.inputIndex, amount = commitment.amount, scriptCode = commitment.scriptCode, witness = commitment.witness, sigVersion = commitment.sigVersion, prevouts = prevouts)))

verify withPrevouts
    prevoutsOf(withPrevouts(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", []), [Spent(amount = 7, script = "51")])) => [Spent(amount = 7, script = "51")]
    prevoutsOf(withPrevouts(bare(Domain.Rules.latest()), [Spent(amount = 7, script = "51")])) => []

fn prevoutsOf(context: Context) -> List<Spent>
    ? "What every Input of this Transaction spends, when the caller knew."
    match context.spend
        Option.None -> []
        Option.Some(commitment) -> commitment.prevouts

verify prevoutsOf
    prevoutsOf(bare(Domain.Rules.latest())) => []
    prevoutsOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => []

fn transactionOf(context: Context) -> Option<Transaction>
    ? "The Transaction this run is part of, when there is one."
    match context.spend
        Option.None -> Option.None
        Option.Some(commitment) -> Option.Some(commitment.transaction)

verify transactionOf
    transactionOf(bare(Domain.Rules.latest())) => Option.None
    transactionOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => Option.Some(emptyTransaction())

fn inputIndexOf(context: Context) -> Int
    ? "Which Input of it is being spent. Zero when there is no spend, which"
      "no caller acts on because they ask hasSpend first."
    match context.spend
        Option.None -> 0
        Option.Some(commitment) -> commitment.inputIndex

verify inputIndexOf
    inputIndexOf(bare(Domain.Rules.latest())) => 0
    inputIndexOf(committed(Domain.Rules.latest(), emptyTransaction(), 3, 5, "51", [])) => 3

fn hasSpend(context: Context) -> Bool
    ? "Whether there is a Transaction behind this run at all."
      "A Context with no spend is a Script asked about on its own, and for a"
      "witness program that is not a spend that fails -- it is a question that"
      "cannot be asked. An empty Witness and no Witness look identical from"
      "the stack and mean opposite things, so the difference has to be read"
      "from here rather than guessed from an empty list."
    match context.spend
        Option.None -> false
        Option.Some(commitment) -> true

verify hasSpend
    hasSpend(bare(Domain.Rules.latest())) => false
    hasSpend(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => true

fn amountOf(context: Context) -> Int
    ? "What the Output being spent was worth, which BIP143 commits to."
      "Zero when there is no spend, which is also what a case that supplied no"
      "amount carries -- the two are indistinguishable and neither can be"
      "checked against anything."
    match context.spend
        Option.None -> 0
        Option.Some(commitment) -> commitment.amount

verify amountOf
    amountOf(bare(Domain.Rules.latest())) => 0
    amountOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => 5

fn witnessOf(context: Context) -> List<String>
    ? "The Witness stack this run has behind it, innermost item first."
      "A Context with no spend has none, which is not the same as a spend whose"
      "Input carried none -- but nothing downstream can tell the two apart and"
      "nothing should need to: both mean there is no Witness to run."
    match context.spend
        Option.None -> []
        Option.Some(commitment) -> commitment.witness

verify witnessOf
    witnessOf(bare(Domain.Rules.latest())) => []
    witnessOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => []
    witnessOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", ["aabb", "cc"])) => ["aabb", "cc"]

record Locking
    version: Int
    lockTime: Int
    sequence: Int

fn lockingOf(context: Context) -> Option<Locking>
    ? "What OP_CHECKLOCKTIMEVERIFY and OP_CHECKSEQUENCEVERIFY read."
      "The three fields between them: the Transaction's version and lock time,"
      "and the sequence of the Input being spent. They are not stored -- the"
      "Commitment has the Transaction and which Input, so this reaches for"
      "them, and there is no second copy to fall out of step."
      "None when there is no spend behind the Context, which is what leaves"
      "the two opcodes undecided in a bare run."
    match context.spend
        Option.None -> Option.None
        Option.Some(commitment) -> lockingIn(commitment)

verify lockingOf
    lockingOf(bare(Domain.Rules.latest())) => Option.None
    lockingOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => Option.None

fn lockingIn(commitment: Commitment) -> Option<Locking>
    ? "An Input index the Transaction does not have leaves this None rather"
      "than inventing a sequence, which the caller then reports as undecided."
    match inputAt(Domain.Transaction.inputsOf(commitment.transaction), commitment.inputIndex)
        Option.None -> Option.None
        Option.Some(input) -> Option.Some(Locking(version = Domain.Transaction.versionOf(commitment.transaction), lockTime = Domain.Transaction.lockTimeOf(commitment.transaction), sequence = Domain.Transaction.sequenceOf(input)))

verify lockingIn
    lockingIn(Commitment(transaction = emptyTransaction(), inputIndex = 0, amount = 0, scriptCode = "", witness = [], sigVersion = SigVersion.Base, prevouts = [])) => Option.None

fn inputAt(inputs: List<Input>, index: Int) -> Option<Input>
    ? "The Input at a position, counting down."
    match inputs
        [] -> Option.None
        [head, ..tail] -> thisOrFurther(head, tail, index)

verify inputAt
    inputAt([], 0) => Option.None

fn thisOrFurther(head: Input, tail: List<Input>, index: Int) -> Option<Input>
    ? "Here when the count runs out, otherwise on."
    match index < 1
        true -> Option.Some(head)
        false -> inputAt(tail, index - 1)

verify thisOrFurther
    thisOrFurther(Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 7, witness = []), [], 0) => Option.Some(Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 7, witness = []))
    thisOrFurther(Input(previousTxid = "aa", previousIndex = 0, script = "", sequence = 7, witness = []), [], 1) => Option.None

fn rulesOf(context: Context) -> Rules
    ? "Which consensus rules this run is judged under."
      "The rules travel with the Context because the Context is already carried"
      "to the opcode that needs them, and because which rules were in force is"
      "as much a part of what a Script is being run against as the Transaction"
      "is. An engine that had to be handed them separately would have to be"
      "handed them everywhere the Context already goes."
    context.rules

verify rulesOf
    rulesOf(bare(Domain.Rules.latest())) => Domain.Rules.latest()
    rulesOf(bare(Domain.Rules.at(Network.Mainnet, 0))) => Domain.Rules.at(Network.Mainnet, 0)

fn emptyTransaction() -> Transaction
    ? "A Transaction with nothing in it, for the cases here."
    Transaction(version = 1, inputs = [], outputs = [], lockTime = 0, txid = "", size = 0, isSegWit = false)

verify emptyTransaction
    emptyTransaction().version => 1
    emptyTransaction().inputs => []

fn signedTransaction() -> Transaction
    ? "The first Transaction of Bitcoin Core's legacy signature hash corpus,"
      "decoded. Its digest below is Core's, not this project's, which is the"
      "point of using it here rather than a Transaction made up for the"
      "purpose."
    Result.withDefault(Domain.Transaction.decode(Bytes.toList(Result.withDefault(Bytes.fromHex(signedRaw()), Bytes.fromList([])))), emptyTransaction())

verify signedTransaction
    signedTransaction().version => 1
    List.len(signedTransaction().inputs) => 1

fn signedRaw() -> String
    ? "That Transaction as it is published, in hexadecimal."
    ""

verify signedRaw
    String.len(signedRaw()) => 550

fn signedScriptCode() -> String
    ? "The Output Script its one Input spends, which is what the signature was"
      "taken over."
    "410411db93e1dcdb8a016b49840f8c53bc1eb68a382e97b1482ecad7b148a6909a5cb2e0eaddfb84ccf9744464f82e160bfa9b8b64f9d4c03f999b8643f656b412a3ac"

verify signedScriptCode
    String.len(signedScriptCode()) => 134

fn overScript(context: Context, scriptCode: String) -> Context
    ? "The same spend, over a different Script."
      "A spend runs the Output Script and, when it is P2SH, the redeem Script"
      "afterwards. The signature in each is taken over the Script it appears"
      "in, so the Script code is set where it is known -- by the engine, as it"
      "starts each one -- rather than guessed at by the caller."
    match context.spend
        Option.None -> context
        Option.Some(commitment) -> Context(rules = context.rules, spend = Option.Some(Commitment(transaction = commitment.transaction, inputIndex = commitment.inputIndex, amount = commitment.amount, scriptCode = scriptCode, witness = commitment.witness, sigVersion = commitment.sigVersion, prevouts = commitment.prevouts)))

verify overScript
    scriptCodeOf(overScript(bare(Domain.Rules.latest()), "51")) => ""
    scriptCodeOf(overScript(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", []), "52")) => "52"
    rulesOf(overScript(committed(Domain.Rules.at(Network.Mainnet, 0), emptyTransaction(), 0, 5, "51", []), "52")) => Domain.Rules.at(Network.Mainnet, 0)

fn withoutSignatures(context: Context, signatures: List<List<Int>>) -> Context
    ? "The same spend, over a Script code with these signatures deleted."
      "Bitcoin's FindAndDelete. OP_CHECKSIG applies it to its one signature and"
      "OP_CHECKMULTISIG to all of its signatures before it checks any of them,"
      "so what a signature commits to never includes itself."
      "It matters only when a signature appears inside the Script it is"
      "signing, which is on the chain exactly once in the first 290329 Blocks:"
      "a P2SH redeem Script carrying one of its own signatures where a public"
      "key should be. See n1bor/btc-listener#49."
      "BIP143 dropped it, so the witness path must not do this. Deleting a"
      "signature from a witness scriptCode would change the message every"
      "signature in that Script commits to, and every one of them would then"
      "fail. That is why the version is asked first and the witness arm"
      "returns the Context untouched."
      "Total: a Script code that is already in hand parsed once to get here, so"
      "withoutPushes cannot refuse it and the other arm leaves the Context as"
      "it was -- which is what the engine did before this existed."
    match sigVersionOf(context)
        SigVersion.WitnessV0 -> context
        SigVersion.Base -> deletedFrom(context, signatures)

fn deletedFrom(context: Context, signatures: List<List<Int>>) -> Context
    ? "The deletion itself, on the legacy path where it applies."
    match Domain.ScriptParse.withoutPushes(scriptCodeOf(context), signatures)
        Result.Err(why) -> context
        Result.Ok(stripped) -> overScript(context, stripped)

verify withoutSignatures
    scriptCodeOf(withoutSignatures(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "5101ab52", []), [[171]])) => "5152"
    scriptCodeOf(withoutSignatures(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "5101ab52", []), [])) => "5101ab52"
    scriptCodeOf(withoutSignatures(bare(Domain.Rules.latest()), [[171]])) => ""

fn scriptCodeOf(context: Context) -> String
    ? "The Script the signature is taken over, which is the one being run:"
      "the Output Script, or the redeem Script when a P2SH spend is re-run."
      "Empty for a Bare run, which has none."
    match context.spend
        Option.None -> ""
        Option.Some(commitment) -> commitment.scriptCode

verify scriptCodeOf
    scriptCodeOf(bare(Domain.Rules.latest())) => ""
    scriptCodeOf(committed(Domain.Rules.latest(), emptyTransaction(), 0, 5, "51", [])) => "51"

fn messageFor(context: Context, hashType: Int) -> Option<String>
    ? "The thirty-two byte message this signature should have been taken over,"
      "as hexadecimal, or None when there is no spend to take it over."
      "None is not failure. It is the honest answer for a Script run on its"
      "own, and the caller reports it as undecided rather than invalid."
    match context.spend
        Option.None -> Option.None
        Option.Some(commitment) -> messageOf(commitment, hashType)

verify messageFor
    messageFor(bare(Domain.Rules.latest()), 1) => Option.None
    messageFor(committed(Domain.Rules.latest(), signedTransaction(), 0, 0, signedScriptCode(), []), 1) => Option.Some("7a05c6145f10101e9d6325494245adf1297d80f8f38d4d576d57cdba220bcb19")
    messageFor(inWitnessV0(committed(Domain.Rules.latest(), bip143Transaction(), 0, 1000000000, "51", []), "76a91479091972186c449eb1ded22b78e40d009bdf008988ac"), 1) => Option.Some("64f3b0f4dd2bb3aa1ce8566d220cc74dda9df97d8490cc81d89d735c92e59fb6")

fn messageOf(commitment: Commitment, hashType: Int) -> Option<String>
    ? "The signature hash for one Input, or None when it cannot be built."
      "A signature hash that will not build is not a signature that fails: it"
      "is a question this engine cannot ask, so it stays undecided."
      "Which hash depends on how the Output was reached, not on what the"
      "signature looks like. The same bytes in the same Script mean the legacy"
      "hash under a bare Output and the BIP143 one under a witness program, so"
      "the version travels with the spend rather than being guessed here."
    match commitment.sigVersion
        SigVersion.Base -> legacyMessage(commitment, hashType)
        SigVersion.WitnessV0 -> witnessMessage(commitment, hashType)

fn legacyMessage(commitment: Commitment, hashType: Int) -> Option<String>
    ? "The pre-SegWit signature hash, quadratic in the size of the Transaction."
    match Domain.Sighash.legacy(commitment.transaction, commitment.inputIndex, commitment.scriptCode, hashType)
        Result.Err(why) -> Option.None
        Result.Ok(digest) -> Option.Some(digest)

fn witnessMessage(commitment: Commitment, hashType: Int) -> Option<String>
    ? "BIP143, which is where the amount earns its place in the record."
      "The binding is called digest rather than message because this module"
      "depends on both Domain.Bip143 and Domain.Bip341, each of which exposes"
      "a message, and the emitted Rust glob-imports both -- so a local called"
      "message is ambiguous there even though nothing here refers to one"
      "unqualified. jasisz/aver#1042."
      "It has no arm that refuses to hash: SIGHASH_SINGLE with no matching"
      "Output commits to no Outputs rather than signing the number one, which"
      "was the point of the redesign. A None here is a hash type that will not"
      "fit in four bytes or an Input index that is not there."
    match Domain.Bip143.message(commitment.transaction, commitment.inputIndex, commitment.scriptCode, commitment.amount, hashType)
        Result.Err(why) -> Option.None
        Result.Ok(digest) -> Option.Some(digest)

verify messageOf
    messageOf(Commitment(transaction = signedTransaction(), inputIndex = 0, amount = 0, scriptCode = signedScriptCode(), witness = [], sigVersion = SigVersion.Base, prevouts = []), 1) => Option.Some("7a05c6145f10101e9d6325494245adf1297d80f8f38d4d576d57cdba220bcb19")
