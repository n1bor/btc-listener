module WorkingProbe
    intent =
        "Exercise a job and a Peer on one generated loop against a real Peer,"
        "so that what happens to the Peer while a Block is being decoded has"
        "automated coverage."
        "The interesting cases -- a ping arriving a byte at a time, a Block"
        "announced while the job runs -- are cases about the turns rather"
        "than about the answer, and the regtest suite cannot make a node"
        "stand in them on purpose."
        "So the payload is read off disk and decoded by the same"
        "Infra.BlockJobs job kind the walk uses, begun by an answer module"
        "and parked on, while the Peer's own process reads it through"
        "Infra.Peers.hearing, which is the node's. What the job decodes does"
        "not matter and the file is not required to be a Block anybody would"
        "accept: this is about the scheduler, and the consensus rules have"
        "their own corpus."
    depends [Domain.BlockWorkJob, Infra.Wire, Tools.Decoding, Tools.ProbeOwner]
    effects [
        Args.get,
        Console.print,
        Infra.Wire.handled, Infra.Wire.heard, Infra.Wire.started,
        Tools.Decoding.decoded, Tools.Decoding.finished,
    ]

process peer seated by Tools.ProbeOwner.peers

fn main() -> Result<Unit, String>
    ? "One Peer to keep and one payload to decode, both named on the"
      "command line; the processes below do the rest."
    ! [Args.get]
    match Args.get()
        [address, path, .._] -> Run.all()
        [address] -> Result.Err("missing payload path")
        _ -> Result.Err("usage: working-probe HOST:PORT PAYLOAD")

fn stop(view: Run.View) -> Bool
    ? "A stop does not end the run by itself: the decode request notices"
      "it, cancels the job and says so, and the run ends once the probe has"
      "let its Peer go."
    false

verify stop
    stop(Run.View(pending = {}, ready = [], askable = [], dropped = 0, stopping = true)) => false

fn starter() -> Unit
    ? "The Peer greeted, once."
    ! [Console.print, Infra.Wire.started]
    match Infra.Wire.started()
        Infra.Wire.Started.Running -> Unit
        Infra.Wire.Started.Failed(why) -> Console.print("could not start: {why}")

fn peer(key: Int) -> Unit
    ? "The Peer's Messages, one at a time, for as long as it is held."
    ! [Infra.Wire.handled, Infra.Wire.heard]
    heard = Infra.Wire.heard(key)
    going = handledIf(key, heard)
    match going
        true -> peer(key)
        false -> Unit

fn handledIf(key: Int, heard: Infra.Wire.Heard) -> Bool
    ? "A Message acted on, or the Peer gone."
    ! [Infra.Wire.handled]
    match heard
        Infra.Wire.Heard.Message(command, body) -> Infra.Wire.handled(key, command, body)
        Infra.Wire.Heard.Gone -> false

fn decoder() -> Unit
    ? "The payload decoded, the answer said, then the Peer let go."
    ! [Console.print, Tools.Decoding.decoded, Tools.Decoding.finished]
    said = answerText(Tools.Decoding.decoded())
    _printed = Console.print(said)
    Tools.Decoding.finished()

fn answerText(answer: Tools.Decoding.Decoded) -> String
    ? "The one line a harness asserts the job's outcome on."
      "Cancelled, refused and decoded are spelled differently on purpose."
      "A stop and a Block that would not decode both end the walk, and a"
      "probe that printed the same word for them could not tell a"
      "cancellation that worked from one that was never reached."
    match answer
        Tools.Decoding.Decoded.Cancelled -> "cancelled"
        Tools.Decoding.Decoded.Transactions(count) -> "decoded {count}"
        Tools.Decoding.Decoded.Refused(why) -> "refused {why}"

verify answerText
    answerText(Tools.Decoding.Decoded.Cancelled) => "cancelled"
    answerText(Tools.Decoding.Decoded.Transactions(0)) => "decoded 0"
    answerText(Tools.Decoding.Decoded.Refused("bad")) => "refused bad"
