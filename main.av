module Main
    intent =
        "Bitcoin peer listener argv entrypoint."
        "Kept thin so the CLI adapter and the domain stay in their own modules,"
        "and so `aver context` has a stable root to resume from."
    depends [App.Cli]
    effects [
        Args.get,
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.connect, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.now, Time.unixMs,
    ]

fn main() -> Result<Unit, String>
    ? "Starts the Bitcoin peer listener CLI."
    ! [
        Args.get,
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.accept, Tcp.beginConnect, Tcp.close, Tcp.closeDial, Tcp.connect, Tcp.dialled, Tcp.listen, Tcp.peerAddress, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Terminal.clear, Terminal.disableRawMode, Terminal.enableRawMode, Terminal.flush, Terminal.hideCursor, Terminal.moveTo, Terminal.print, Terminal.readKey, Terminal.showCursor,
        Time.now, Time.unixMs,
    ]
    App.Cli.runCli()
