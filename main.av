module Main
    intent =
        "Bitcoin peer listener argv entrypoint."
        "Kept thin so the CLI adapter and the domain stay in their own modules,"
        "and so `aver context` has a stable root to resume from."
    depends [App.Cli]
    effects [Args.get, Console.print, Console.error, Tcp.connect, Tcp.writeBytes, Tcp.readBytes, Tcp.close, Time.unixMs, Random.int]

fn main() -> Unit
    ? "Starts the Bitcoin peer listener CLI."
    ! [Args.get, Console.print, Console.error, Tcp.connect, Tcp.writeBytes, Tcp.readBytes, Tcp.close, Time.unixMs, Random.int]
    App.Cli.runCli()
