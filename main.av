module Main
    intent =
        "Bitcoin peer listener argv entrypoint."
        "Kept thin so the CLI adapter and the domain stay in their own modules,"
        "and so `aver context` has a stable root to resume from."
    depends [App.Cli]
    effects [
        Args.get,
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]

fn main() -> Unit
    ? "Starts the Bitcoin peer listener CLI."
    ! [
        Args.get,
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    App.Cli.runCli()
