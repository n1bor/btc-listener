module Lookup
    intent =
        "The two commands that start from a Transaction Id rather than a Height."
        "tx shows the Transaction and spend follows its Inputs back to what they"
        "spend. They take the same two arguments and do the same three lookups"
        "to get there, so they are one path with a choice at the end rather than"
        "two paths that happen to agree."
    exposes [byTxid]
    depends [Domain.Network, Domain.SpendScript, App.Show, Domain.Index, Domain.Rules, Domain.Transaction, Infra.Blocks, Infra.Chain, Infra.Spends, Infra.Store]
    effects [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Infra.Kv.get, Infra.Kv.open,
    ]

fn byTxid(network: Network, rest: List<String>, spending: Bool) -> Unit
    ? "Both commands want a directory and a Transaction Id."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match rest
        [] -> Console.error("usage: <dir> <txid>")
        [dir, ..more] -> withTxid(network, dir, more, spending)

fn withTxid(network: Network, dir: String, more: List<String>, spending: Bool) -> Unit
    ? "The Transaction Id follows the directory."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match more
        [] -> Console.error("usage: <dir> <txid>")
        [txid, ..extra] -> said(txidRun(network, dir, txid, spending))

fn txidRun(network: Network, dir: String, txid: String, spending: Bool) -> Result<List<String>, String>
    ? "Find the Transaction, then either show it or check what it spends."
    ! [Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Infra.Kv.get, Infra.Kv.open]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open("{dir}/blocks")?
    sited = Infra.Store.get(store, Domain.Index.txKey(txid))?
    found = Infra.Chain.transactionAt(store, blocks, txid)?
    transaction = App.Show.transactionSited(found, txid, sited)?
    reported(network, store, blocks, transaction, txid, sited, found, spending)

fn reported(network: Network, store: Store, blocks: BlockStore, transaction: Transaction, txid: String, sited: Option<String>, found: Found, spending: Bool) -> Result<List<String>, String>
    ? "Which of the two reports was asked for."
    ! [Disk.readText, Infra.Kv.get]
    match spending
        false -> App.Show.describeSited(found, txid, sited)
        true -> spendReport(network, store, blocks, transaction, found.height, found.blockId)

fn spendReport(network: Network, store: Store, blocks: BlockStore, transaction: Transaction, height: Int, blockId: String) -> Result<List<String>, String>
    ? "Follow every Input back and report whether the Transaction adds up."
      "The Height decides which consensus rules the Scripts are run under, and"
      "it is the Height of the Block holding this Transaction rather than the"
      "tip: a spend is judged by the rules it was mined under."
    ! [Disk.readText, Infra.Kv.get]
    work = Infra.Spends.resolved(store, blocks, transaction, Domain.Rules.at(network, height))?
    answered = Infra.Spends.scriptsAcross([work], Domain.Rules.at(network, height), height, blockId)?
    Result.Ok(List.concat(App.Show.describeSpend(transaction, work.tally), App.Show.describeScripts(onlyOutcomes(answered))))

fn onlyOutcomes(answered: Tuple<Outcomes, List<String>>) -> Outcomes
    ? "One Transaction was asked about, so the Block total is its total."
    match answered
        (scripts, lines) -> scripts

verify onlyOutcomes
    onlyOutcomes((Domain.SpendScript.noOutcomes(), [])) => Domain.SpendScript.noOutcomes()

fn said(outcome: Result<List<String>, String>) -> Unit
    ? "Print the lines, or the reason there are none."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(lines) -> printLines(lines)
        Result.Err(message) -> Console.error("error: {message}")

fn printLines(lines: List<String>) -> Unit
    ? "Print each line in turn."
    ! [Console.print]
    match lines
        [] -> Unit
        [head, ..tail] -> printThen(head, tail)

fn printThen(line: String, rest: List<String>) -> Unit
    ? "Print one line, then continue with the rest."
    ! [Console.print]
    _printed = Console.print(line)
    printLines(rest)
