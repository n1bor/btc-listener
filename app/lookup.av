module Lookup
    intent =
        "The two commands that start from a Transaction Id rather than a Height."
        "tx shows the Transaction and spend follows its Inputs back to what they"
        "spend. They take the same two arguments and do the same three lookups"
        "to get there, so they are one path with a choice at the end rather than"
        "two paths that happen to agree."
    exposes [byTxid]
    depends [Domain.Network, Domain.Rules, Domain.SpendScript, App.Show, Domain.Index, Domain.Rules, Domain.Transaction, Infra.Blocks, Infra.Chain, Infra.Spends, Infra.Store]
    effects [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]

fn byTxid(network: Network, rest: List<String>, spending: Bool) -> Unit
    ? "Both commands want a directory and a Transaction Id."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match rest
        [] -> Console.error("usage: <dir> <txid>")
        [dir, ..more] -> withTxid(network, dir, more, spending)

fn withTxid(network: Network, dir: String, more: List<String>, spending: Bool) -> Unit
    ? "The Transaction Id follows the directory."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match more
        [] -> Console.error("usage: <dir> <txid>")
        [txid, ..extra] -> said(txidRun(network, dir, txid, spending))

fn txidRun(network: Network, dir: String, txid: String, spending: Bool) -> Result<List<String>, String>
    ? "Find the Transaction, then either show it or check what it spends."
    ! [
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open("{dir}/blocks")?
    sited = Infra.Store.get(store, Domain.Index.txKey(txid))?
    found = Infra.Chain.transactionAt(store, blocks, txid)?
    transaction = App.Show.transactionSited(found, txid, sited)?
    directoryNetwork = Infra.Chain.networkOf(store)?
    reported(network, directoryNetwork, store, blocks, transaction, txid, sited, found, spending)

fn reported(network: Network, directoryNetwork: Option<Network>, store: Store, blocks: BlockStore, transaction: Transaction, txid: String, sited: Option<String>, found: Found, spending: Bool) -> Result<List<String>, String>
    ? "Which of the two reports was asked for."
      "Two Networks, and they answer different questions. The one on the"
      "command line decides which timetable of soft forks a Script is judged"
      "under; the one read off the directory decides how an address is"
      "spelled. A directory can be shown without being told what it is, and"
      "the second is the only one that cannot be got wrong."
    ! [Disk.readBytesAt, Infra.Kv.get]
    match spending
        false -> App.Show.describeSited(directoryNetwork, found, txid, sited)
        true -> spendReport(network, store, blocks, transaction, found.height, found.blockId)

fn spendReport(network: Network, store: Store, blocks: BlockStore, transaction: Transaction, height: Int, blockId: String) -> Result<List<String>, String>
    ? "Follow every Input back and report whether the Transaction adds up."
      "The Height decides which consensus rules the Scripts are run under, and"
      "it is the Height of the Block holding this Transaction rather than the"
      "tip: a spend is judged by the rules it was mined under."
    ! [Disk.readBytesAt, Infra.Kv.get]
    rules = rulesFor(network, height)
    work = Infra.Spends.resolved(store, blocks, transaction, rules)?
    answered = Infra.Spends.scriptsAcross([work], rules, height, blockId)?
    Result.Ok(List.concat(App.Show.describeSpend(transaction, work.tally), List.concat(App.Show.describeScripts(onlyOutcomes(answered)), caveat(height))))

fn rulesFor(network: Network, height: Int) -> Rules
    ? "The rules to judge this Transaction under."
      "A Transaction reached by its Id is named by its Block, because a Block"
      "Id names one Block and a Height does not -- two chains can both have a"
      "Block at 300000. The Block's own Height is not in doubt once the Block"
      "is known, and the n: keyspace now records it, so the ordinary answer is"
      "the Height of the Block that mined this Transaction."
      "Minus one still arrives from a directory whose t: entries predate that"
      "keyspace. Minus one is below every activation, so asking Domain.Rules.at"
      "for it would turn every soft fork off -- and a witness program judged"
      "with SegWit off is an anyone-can-spend push of a hash that passes. That"
      "is the lax direction and it is the dangerous one, so an unknown Height"
      "is judged under every rule this engine knows instead. A spend mined"
      "before a fork may then be reported undecided or failed when it was"
      "valid; the caveat line below says so, and says how to fix it."
    match height < 0
        true -> Domain.Rules.latest()
        false -> Domain.Rules.at(network, height)

verify rulesFor
    rulesFor(Network.Signet, 0 - 1) => Domain.Rules.latest()
    rulesFor(Network.Mainnet, 170060) => Domain.Rules.at(Network.Mainnet, 170060)

fn caveat(height: Int) -> List<String>
    ? "Say so when the Height was not known, because the rules depend on it."
    match height < 0
        false -> []
        true -> ["       (this directory does not record which Height this Block sits at, so scripts were judged under every rule this engine knows; re-run txindex over the range to record it)"]

verify caveat
    caveat(300000) => []
    List.len(caveat(0 - 1)) => 1

fn onlyOutcomes(answered: Tuple<Outcomes, List<String>>) -> Outcomes
    ? "One Transaction was asked about, so the Block total is its total."
    match answered
        (scripts, lines) -> scripts

verify onlyOutcomes
    onlyOutcomes((Domain.SpendScript.noOutcomes(), [])) => Domain.SpendScript.noOutcomes()

fn said(outcome: Result<List<String>, String>) -> Unit
    ? "Print the lines, or the reason there are none."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(lines) -> printLines(lines)
        Result.Err(message) -> Console.error("error: {message}")

fn printLines(lines: List<String>) -> Unit
    ? "Print each line in turn."
    ! [Console.print]
    match lines
        [] -> Unit
        [head, ..tail] -> printThen(head, tail)

fn printThen(line: String, rest: List<String>) -> Unit
    ? "Print one line, then continue with the rest."
    ! [Console.print]
    _printed = Console.print(line)
    printLines(rest)
