module Maintain
    intent =
        "The commands that change a chain directory without a Peer."
        "prune discards Blocks below a Height, txindex records where Transactions"
        "sit, and audit checks a range against everything we know how to check."
        "The first two write and claim the directory; audit only reads."
        "migrate is the odd one. It is run once, it moves the Index from the"
        "log into the database beside it, and after it nothing else behaves"
        "differently: the same commands read the same keys through the same"
        "Store. It takes the directory claim like any writer, because a peer"
        "still appending to the log while it copies would leave what it copied"
        "short of what the log holds."
    exposes [prune, txIndex, outputs, audit, migrate]
    depends [Domain.Network, Domain.Index, Domain.SpendScript, Infra.Audit, Infra.Blocks, Infra.Lock, Infra.Migrate, Infra.Outputs, Infra.Prune, Infra.Store, Infra.TxIndex]
    effects [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Time.now, Time.unixMs,
    ]

record Span
    from: Int
    to: Int

fn prune(rest: List<String>) -> Unit
    ? "Pruning is local: a directory and the Height to prune below, no Peer."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match rest
        [] -> Console.error("usage: <dir> <height>")
        [dir, ..more] -> pruneHeight(dir, more)

fn pruneHeight(dir: String, more: List<String>) -> Unit
    ? "Take the Height that follows the directory."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match more
        [] -> Console.error("usage: <dir> <height>")
        [height, ..extra] -> startPrune(dir, Int.fromString(height))

fn startPrune(dir: String, parsed: Result<Int, String>) -> Unit
    ? "Prune, or show the usage if the Height was not a whole number."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match parsed
        Result.Err(message) -> Console.error("usage: <dir> <height>")
        Result.Ok(below) -> said(pruneRun(dir, below))

fn pruneRun(dir: String, below: Int) -> Result<String, String>
    ? "Open the Index and the Segments, then discard what is below the Height."
    ! [
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    _claimed = Infra.Lock.claim(dir, "prune")?
    Infra.Lock.releasingAfter(dir, pruneDone(dir, below))

fn pruneDone(dir: String, below: Int) -> Result<String, String>
    ? "Discard the Blocks, with the claim already taken."
    ! [
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open("{dir}/blocks")?
    pruned = Infra.Prune.run(store, blocks, below)?
    Result.Ok("{pruned.segments} Segments deleted, {pruned.locations} Locations dropped, Prune Watermark now {pruned.watermark}")

fn migrate(rest: List<String>) -> Unit
    ? "Migrating is local: a directory, and nothing else to choose."
    ! [
        Console.error, Console.print,
        Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.open, Infra.Kv.putAll,
    ]
    match rest
        [] -> Console.error("usage: <dir>")
        [dir, ..extra] -> said(migrateRun(dir))

fn migrateRun(dir: String) -> Result<String, String>
    ? "Take the directory claim, then move the Index."
    ! [
        Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.open, Infra.Kv.putAll,
    ]
    _claimed = Infra.Lock.claim(dir, "migrate")?
    Infra.Lock.releasingAfter(dir, migrateDone(dir))

fn migrateDone(dir: String) -> Result<String, String>
    ? "Copy the log into the database, with the claim already taken."
    ! [Disk.exists, Disk.makeDir, Disk.readText, Infra.Kv.open, Infra.Kv.putAll]
    moved = Infra.Migrate.migrate(dir)?
    Result.Ok("{moved} entries moved into {Infra.Store.databasePath(dir)}; the log is still there")

fn txIndex(rest: List<String>) -> Unit
    ? "Indexing is local: a directory and a range of Heights."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match rest
        [] -> Console.error("usage: <dir> <a> <b>")
        [dir, ..more] -> txIndexRange(dir, more)

fn txIndexRange(dir: String, more: List<String>) -> Unit
    ? "Both Heights must be given."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match heights(more)
        Option.None -> Console.error("usage: <dir> <a> <b>")
        Option.Some(span) -> said(txIndexRun(dir, span))

fn txIndexRun(dir: String, span: Span) -> Result<String, String>
    ? "Record where every Transaction in the range sits."
    ! [
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    _claimed = Infra.Lock.claim(dir, "txindex")?
    Infra.Lock.releasingAfter(dir, txIndexDone(dir, span))

fn txIndexDone(dir: String, span: Span) -> Result<String, String>
    ? "Record the Transactions, with the claim already taken."
    ! [
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open("{dir}/blocks")?
    built = Infra.TxIndex.build(store, blocks, span.from, span.to)?
    Result.Ok("{built.transactions} Transactions recorded from {built.blocks} Blocks")

