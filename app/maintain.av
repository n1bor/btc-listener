fn audit(network: Network, rest: List<String>) -> Unit
    ? "Checking a range needs no claim: it only reads."
      "The Network comes from the caller because the rules a Block was mined"
      "under depend on which chain it is on, not only how high up it is."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
        Time.now, Time.unixMs,
    ]
    match rest
        [] -> Console.error("usage: <dir> <a> <b>")
        [dir, ..more] -> auditRange(network, dir, more)

fn auditRange(network: Network, dir: String, more: List<String>) -> Unit
    ? "Both Heights must be given."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
        Time.now, Time.unixMs,
    ]
    match heights(more)
        Option.None -> Console.error("usage: <dir> <a> <b>")
        Option.Some(span) -> said(auditRun(network, dir, span))

fn auditRun(network: Network, dir: String, span: Span) -> Result<String, String>
    ? "Walk the range and report what it found."
    ! [
        Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
        Time.now, Time.unixMs,
    ]
    counts = Infra.Audit.run(network, dir, span.from, span.to)?
    Result.Ok(summary(counts))

fn summary(counts: Counts) -> String
    ? "The line a whole run ends on."
      "Pure and separate from the run so that both shapes of it can be"
      "checked. That matters more than it sounds: n1bor/btc-listener#76 was"
      "not a counting bug but a reading one -- the line ended FAULTS 0 while"
      "a hundred failed Scripts sat earlier in it -- and a line nothing can"
      "check is a line whose wording drifts."
    "blocks {counts.blocks}  transactions {counts.transactions}  spends resolved {counts.resolved}  coinbase {counts.coinbase}  unresolved {counts.unresolved}  scripts {counts.scripts.passed} passed / {counts.scripts.failed} failed / {counts.scripts.undecided} undecided  {Infra.Audit.standing(counts)} ({Infra.Audit.breakdown(counts)})"

verify summary
    summary(Counts(blocks = 51, transactions = 1842, resolved = 1791, coinbase = 51, unresolved = 0, faults = 0, scripts = Domain.SpendScript.Outcomes(passed = 3652, failed = 0, undecided = 0, note = Option.None))) => "blocks 51  transactions 1842  spends resolved 1791  coinbase 51  unresolved 0  scripts 3652 passed / 0 failed / 0 undecided  CLEAN (faults 0, script failures 0)"
    summary(Counts(blocks = 51, transactions = 1842, resolved = 1791, coinbase = 51, unresolved = 0, faults = 0, scripts = Domain.SpendScript.Outcomes(passed = 3596, failed = 56, undecided = 0, note = Option.None))) => "blocks 51  transactions 1842  spends resolved 1791  coinbase 51  unresolved 0  scripts 3596 passed / 56 failed / 0 undecided  FAILED (faults 0, script failures 56)"
    summary(Counts(blocks = 2, transactions = 3, resolved = 1, coinbase = 2, unresolved = 0, faults = 1, scripts = Domain.SpendScript.Outcomes(passed = 4, failed = 0, undecided = 0, note = Option.None))) => "blocks 2  transactions 3  spends resolved 1  coinbase 2  unresolved 0  scripts 4 passed / 0 failed / 0 undecided  FAILED (faults 1, script failures 0)"

fn heights(range: List<String>) -> Option<Span>
    ? "Two whole numbers, or nothing."
    match range
        [] -> Option.None
        [from, ..rest] -> secondHeight(from, rest)

verify heights
    heights([]) => Option.None
    heights(["1"]) => Option.None
    heights(["1", "5"]) => Option.Some(Span(from = 1, to = 5))
    heights(["x", "5"]) => Option.None

fn secondHeight(from: String, rest: List<String>) -> Option<Span>
    ? "The Height after the first."
    match rest
        [] -> Option.None
        [to, ..extra] -> spanOf(Int.fromString(from), Int.fromString(to))

verify secondHeight
    secondHeight("1", []) => Option.None
    secondHeight("1", ["5"]) => Option.Some(Span(from = 1, to = 5))

fn spanOf(from: Result<Int, String>, to: Result<Int, String>) -> Option<Span>
    ? "Both had to parse."
    match from
        Result.Err(e) -> Option.None
        Result.Ok(a) -> withFrom(a, to)

verify spanOf
    spanOf(Result.Ok(1), Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    spanOf(Result.Err("no"), Result.Ok(5)) => Option.None

fn withFrom(from: Int, to: Result<Int, String>) -> Option<Span>
    ? "The first parsed; the second still has to."
    match to
        Result.Err(e) -> Option.None
        Result.Ok(b) -> Option.Some(Span(from = from, to = b))

verify withFrom
    withFrom(1, Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    withFrom(1, Result.Err("no")) => Option.None

fn said(outcome: Result<String, String>) -> Unit
    ? "Report what the command finished with."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(line) -> Console.print(line)
        Result.Err(message) -> Console.error("error: {message}")

fn utxo(network: Network, rest: List<String>) -> Unit
    ? "Building the UTXO Set is local: a directory and a Height to reach."
      "A Height rather than a range. The Set is the state after connecting"
      "every Block up to one Height, so there is nothing a start Height could"
      "mean -- it resumes from whatever it last recorded."
    ! [
        Console.error, Console.print,
        Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Time.now, Time.unixMs,
    ]
    match rest
        [] -> Console.error("usage: <dir> <height>")
        [dir, ..more] -> utxoHeight(network, dir, more)

fn utxoHeight(network: Network, dir: String, more: List<String>) -> Unit
    ? "Take the Height that follows the directory."
    ! [
        Console.error, Console.print,
        Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Time.now, Time.unixMs,
    ]
    match more
        [] -> Console.error("usage: <dir> <height>")
        [height, ..extra] -> startUtxo(network, dir, Int.fromString(height))

fn startUtxo(network: Network, dir: String, parsed: Result<Int, String>) -> Unit
    ? "Build, or show the usage if the Height was not a whole number."
    ! [
        Console.error, Console.print,
        Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Time.now, Time.unixMs,
    ]
    match parsed
        Result.Err(message) -> Console.error("usage: <dir> <height>")
        Result.Ok(to) -> said(utxoRun(network, dir, to))

fn utxoRun(network: Network, dir: String, to: Int) -> Result<String, String>
    ? "Connect Blocks into the UTXO Set up to the Height."
    ! [
        Console.print,
        Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Time.now, Time.unixMs,
    ]
    _claimed = Infra.Lock.claim(dir, "utxo")?
    Infra.Lock.releasingAfter(dir, utxoDone(network, dir, to))

fn utxoDone(network: Network, dir: String, to: Int) -> Result<String, String>
    ? "Build the Set, with the claim already taken."
    ! [
        Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Time.now, Time.unixMs,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open("{dir}/blocks")?
    built = Infra.ChainState.build(network, store, blocks, to)?
    Result.Ok("{built.blocks} Blocks connected to Height {built.reached}; Set +{built.added} -{built.removed} Outputs, {built.fees} satoshis in fees")

fn assumeValid(rest: List<String>) -> Unit
    ? "Setting the Assume-valid Height is local: a directory and a Height."
    ! [
        Console.error, Console.print,
        Disk.delete, Disk.exists, Disk.makeDir, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match rest
        [] -> Console.error("usage: <dir> <height>")
        [dir, ..more] -> assumeValidHeight(dir, more)

fn assumeValidHeight(dir: String, more: List<String>) -> Unit
    ? "Take the Height that follows the directory."
    ! [
        Console.error, Console.print,
        Disk.delete, Disk.exists, Disk.makeDir, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match more
        [] -> Console.error("usage: <dir> <height>")
        [height, ..extra] -> startAssumeValid(dir, Int.fromString(height))

fn startAssumeValid(dir: String, parsed: Result<Int, String>) -> Unit
    ? "Set it, or show the usage if the Height was not a whole number."
    ! [
        Console.error, Console.print,
        Disk.delete, Disk.exists, Disk.makeDir, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    match parsed
        Result.Err(message) -> Console.error("usage: <dir> <height>")
        Result.Ok(height) -> said(assumeValidRun(dir, height))

fn assumeValidRun(dir: String, height: Int) -> Result<String, String>
    ? "Pin the claim to whatever Block the Index names at that Height."
    ! [
        Disk.delete, Disk.exists, Disk.makeDir, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
    ]
    _claimed = Infra.Lock.claim(dir, "assumevalid")?
    Infra.Lock.releasingAfter(dir, assumeValidDone(dir, height))

fn assumeValidDone(dir: String, height: Int) -> Result<String, String>
    ? "Read the Block Id there and write the claim against it."
      "Against the Block rather than the Height alone, so a reorganisation"
      "under the claim is detected rather than trusted -- which is the whole"
      "of ADR 0007's 'a pinned Block Id, not a bare Height'."
    ! [Disk.exists, Disk.makeDir, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll]
    store = Infra.Store.open(dir)?
    named = Infra.Store.get(store, Domain.Index.heightKey(height))?
    pinned(store, height, named)

fn pinned(store: Store, height: Int, named: Option<String>) -> Result<String, String>
    ? "A Height the Index does not name cannot be claimed."
    ! [Infra.Kv.putAll]
    match named
        Option.None -> Result.Err("the Index names no Block at Height {height}, so there is nothing to pin the claim to")
        Option.Some(blockId) -> written(store, height, blockId)

fn written(store: Store, height: Int, blockId: String) -> Result<String, String>
    ? "The claim, recorded."
    ! [Infra.Kv.putAll]
    _stored = Infra.Store.putAll(store, [Entry(key = Domain.AssumeValid.claimKey(), value = Domain.AssumeValid.encodeClaim(Claim(height = height, blockId = blockId)))])?
    Result.Ok("Assume-valid Height {height}, pinned to {blockId}; Scripts at or below it will not be run")
