module Cli
    intent =
        "Argv adapter for the Bitcoin peer listener."
        "Argument handling lives here so that address parsing in the domain stays"
        "pure and verifiable, and so the entrypoint has one thing to call."
    exposes [runCli]
    depends [App.Show, Domain.Block, Domain.Index, Infra.TxIndex, Domain.Address, Domain.Network, Infra.Blocks, Infra.Chain, Infra.Download, Infra.Peer, Infra.Prune, Infra.Resolver, Infra.Store]
    effects [
        Args.get,
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]

record Span
    from: Int
    to: Int

fn usageLines() -> List<String>
    ? "User-facing help for the argv CLI."
    [
        "Bitcoin peer listener and chain downloader",
        "",
        "  [peer-address] [port]                 listen for Transactions",
        "  headers <peer-address> <dir>          fetch every Block Header",
        "  bodies  <peer-address> <dir> <a> <b>  fetch Blocks for Heights a..b",
        "  prune   <dir> <height>                delete Blocks below a Height",
        "  show    <dir> <height> [summary]      read one Block back and check it",
        "  txindex <dir> <a> <b>                 record where Transactions in a..b sit",
        "  tx      <dir> <txid>                  find one Transaction by its Id",
        "",
        "  peer-address   IPv4 address of the Peer. Omit it, when listening,",
        "                 to ask a Bitcoin DNS seed for one.",
        "  port           optional, defaults to 8333",
        "  dir            where the Index and the Segments live",
        "  summary        show, without listing the Block's Transactions",
        "",
        "  headers must run before bodies, and bodies before txindex: each needs",
        "  what the one before it wrote. Only headers and bodies need a Peer.",
        "",
        "  prune deletes whole Segments only, so it frees nothing until a Segment",
        "  holds no Block you are still keeping, and never deletes the one the",
        "  next Block goes into.",
    ]

verify usageLines
    List.len(usageLines()) => 22
    List.contains(usageLines(), "Bitcoin peer listener and chain downloader") => true

fn describe(address: PeerAddress) -> String
    ? "The line shown once an address has been accepted."
    "listening to peer {Domain.Address.toString(address)}"

verify describe
    describe(Domain.Address.fromString("192.168.1.10")?) => "listening to peer 192.168.1.10:8333"
    describe(Domain.Address.fromParts("10.0.0.1", "18333")?) => "listening to peer 10.0.0.1:18333"

fn runCli() -> Unit
    ? "Starts the argv CLI."
    ! [
        Args.get,
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    run(Args.get())

fn run(args: List<String>) -> Unit
    ? "Dispatch on the arguments given after `--`."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match args
        [] -> discover()
        [head, ..rest] -> dispatch(head, rest)

fn dispatch(command: String, rest: List<String>) -> Unit
    ? "A leading subcommand, or an address for the listener as before."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match command
        "headers" -> needTwo(rest)
        "bodies" -> needFour(rest)
        "prune" -> needPrune(rest)
        "txindex" -> needTxIndex(rest)
        "tx" -> needTx(rest)
        "show" -> needShow(rest)
        "help" -> printLines(usageLines())
        _ -> runWithAddress(command, rest)

fn needTwo(rest: List<String>) -> Unit
    ? "The header phase wants an address and a directory."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> printLines(usageLines())
        [address, ..more] -> withDir(address, more)

fn withDir(address: String, more: List<String>) -> Unit
    ? "Take the directory that follows the address."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match more
        [] -> printLines(usageLines())
        [dir, ..extra] -> startHeaders(Domain.Address.fromString(address), dir)

fn startHeaders(parsed: Result<PeerAddress, String>, dir: String) -> Unit
    ? "Fetch every Header, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Err(message) -> Console.error("error: {message}")
        Result.Ok(address) -> said(headerRun(address, dir))

fn headerRun(address: PeerAddress, dir: String) -> Result<String, String>
    ? "Open the Index and fill it with Headers."
      "The directory is handed to the Store whole. What it keeps in there, and"
      "whether it has to be created, are the Store's business rather than this"
      "one's — which is what lets a real database replace it untouched."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    store = Infra.Store.open(dir)?
    grown = Infra.Download.headers(Network.Mainnet, address, store)?
    Result.Ok("index holds {Infra.Store.size(grown)} entries")

fn needFour(rest: List<String>) -> Unit
    ? "The body phase wants an address, a directory and two Heights."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> printLines(usageLines())
        [address, ..more] -> bodyDir(address, more)

fn bodyDir(address: String, more: List<String>) -> Unit
    ? "Take the directory, then the range."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match more
        [] -> printLines(usageLines())
        [dir, ..range] -> bodyRange(address, dir, range)

fn bodyRange(address: String, dir: String, range: List<String>) -> Unit
    ? "Both Heights must be given; there is no sensible default for either."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match heights(range)
        Option.None -> printLines(usageLines())
        Option.Some(span) -> startBodies(Domain.Address.fromString(address), dir, span)

fn heights(range: List<String>) -> Option<Span>
    ? "Two whole numbers, or nothing."
    match range
        [] -> Option.None
        [from, ..rest] -> secondHeight(from, rest)

verify heights
    heights([]) => Option.None
    heights(["1"]) => Option.None
    heights(["1", "5"]) => Option.Some(Span(from = 1, to = 5))
    heights(["x", "5"]) => Option.None

fn secondHeight(from: String, rest: List<String>) -> Option<Span>
    ? "The Height after the first."
    match rest
        [] -> Option.None
        [to, ..extra] -> spanOf(Int.fromString(from), Int.fromString(to))

verify secondHeight
    secondHeight("1", []) => Option.None
    secondHeight("1", ["5"]) => Option.Some(Span(from = 1, to = 5))

fn spanOf(from: Result<Int, String>, to: Result<Int, String>) -> Option<Span>
    ? "Both had to parse."
    match from
        Result.Err(e) -> Option.None
        Result.Ok(a) -> withFrom(a, to)

verify spanOf
    spanOf(Result.Ok(1), Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    spanOf(Result.Err("no"), Result.Ok(5)) => Option.None

fn withFrom(from: Int, to: Result<Int, String>) -> Option<Span>
    ? "The first parsed; the second still has to."
    match to
        Result.Err(e) -> Option.None
        Result.Ok(b) -> Option.Some(Span(from = from, to = b))

verify withFrom
    withFrom(1, Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    withFrom(1, Result.Err("no")) => Option.None

fn startBodies(parsed: Result<PeerAddress, String>, dir: String, span: Span) -> Unit
    ? "Fetch the Blocks, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Err(message) -> Console.error("error: {message}")
        Result.Ok(address) -> said(bodyRun(address, dir, span))

fn bodyRun(address: PeerAddress, dir: String, span: Span) -> Result<String, String>
    ? "Open the Index and the Segments, then fill the range."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    progress = Infra.Download.bodies(Network.Mainnet, address, store, blocks, span.from, span.to)?
    Result.Ok("{progress.count} Blocks stored, last Segment {Infra.Blocks.currentSegment(progress.blocks)}")

fn needPrune(rest: List<String>) -> Unit
    ? "Pruning is local: a directory and the Height to prune below, no Peer."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
    ]
    match rest
        [] -> printLines(usageLines())
        [dir, ..more] -> pruneHeight(dir, more)

fn pruneHeight(dir: String, more: List<String>) -> Unit
    ? "Take the Height that follows the directory."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
    ]
    match more
        [] -> printLines(usageLines())
        [height, ..extra] -> startPrune(dir, Int.fromString(height))

fn startPrune(dir: String, parsed: Result<Int, String>) -> Unit
    ? "Prune, or show the usage if the Height was not a whole number."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
    ]
    match parsed
        Result.Err(message) -> printLines(usageLines())
        Result.Ok(below) -> said(pruneRun(dir, below))

fn pruneRun(dir: String, below: Int) -> Result<String, String>
    ? "Open the Index and the Segments, then discard what is below the Height."
    ! [Disk.appendText, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    pruned = Infra.Prune.run(store, blocks, below)?
    Result.Ok("{pruned.segments} Segments deleted, {pruned.locations} Locations dropped, Prune Watermark now {pruned.watermark}")

fn needShow(rest: List<String>) -> Unit
    ? "Showing a Block is local: a directory and a Height, no Peer."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match rest
        [] -> printLines(usageLines())
        [dir, ..more] -> showHeight(dir, more)

fn showHeight(dir: String, more: List<String>) -> Unit
    ? "Take the Height that follows the directory."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match more
        [] -> printLines(usageLines())
        [height, ..extra] -> showMode(dir, Int.fromString(height), extra)

fn showMode(dir: String, parsed: Result<Int, String>, extra: List<String>) -> Unit
    ? "An optional third word chooses how much of the Block to print."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match extra
        [] -> startShow(dir, parsed, true)
        [mode, ..rest] -> namedMode(dir, parsed, mode)

fn namedMode(dir: String, parsed: Result<Int, String>, mode: String) -> Unit
    ? "Only two words mean anything here; anything else is a typo worth showing."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match mode
        "full" -> startShow(dir, parsed, true)
        "summary" -> startShow(dir, parsed, false)
        _ -> printLines(usageLines())

fn startShow(dir: String, parsed: Result<Int, String>, withTransactions: Bool) -> Unit
    ? "Show, or the usage if the Height was not a whole number."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match parsed
        Result.Err(message) -> printLines(usageLines())
        Result.Ok(height) -> shown(showRun(dir, height, withTransactions))

fn showRun(dir: String, height: Int, withTransactions: Bool) -> Result<List<String>, String>
    ? "What the Index and the Segments hold for one Height."
    ! [Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    found = Infra.Chain.at(store, blocks, height)?
    below = Infra.Chain.watermark(store)?
    Result.Ok(App.Show.describeFound(found, below, withTransactions))

fn shown(outcome: Result<List<String>, String>) -> Unit
    ? "Print the lines, or the reason there are none."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(lines) -> printLines(lines)
        Result.Err(message) -> Console.error("error: {message}")

fn needTxIndex(rest: List<String>) -> Unit
    ? "Indexing is local: a directory and a range of Heights."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
    ]
    match rest
        [] -> printLines(usageLines())
        [dir, ..more] -> txIndexRange(dir, more)

fn txIndexRange(dir: String, more: List<String>) -> Unit
    ? "Both Heights must be given."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
    ]
    match heights(more)
        Option.None -> printLines(usageLines())
        Option.Some(span) -> said(txIndexRun(dir, span))

fn txIndexRun(dir: String, span: Span) -> Result<String, String>
    ? "Record where every Transaction in the range sits."
    ! [Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    built = Infra.TxIndex.build(store, blocks, span.from, span.to)?
    Result.Ok("{built.transactions} Transactions recorded from {built.blocks} Blocks")

fn needTx(rest: List<String>) -> Unit
    ? "Looking one up is local: a directory and a Transaction Id."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match rest
        [] -> printLines(usageLines())
        [dir, ..more] -> txNamed(dir, more)

fn txNamed(dir: String, more: List<String>) -> Unit
    ? "The Transaction Id follows the directory."
    ! [Console.error, Console.print, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    match more
        [] -> printLines(usageLines())
        [txid, ..extra] -> shown(txRun(dir, txid))

fn txRun(dir: String, txid: String) -> Result<List<String>, String>
    ? "Find the Transaction and show it."
    ! [Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    sited = Infra.Store.get(store, Domain.Index.txKey(txid))?
    found = Infra.Chain.transactionAt(store, blocks, txid)?
    App.Show.describeSited(found, txid, sited)

fn blocksPath(dir: String) -> String
    ? "Where the Segments live."
    "{dir}/blocks"

verify blocksPath
    blocksPath("chain") => "chain/blocks"

fn said(outcome: Result<String, String>) -> Unit
    ? "Report what a phase finished with."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(line) -> Console.print(line)
        Result.Err(message) -> Console.error("error: {message}")

fn discover() -> Unit
    ? "With no address given, ask a Bitcoin DNS seed for one."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _searching = Console.print("no peer given; asking a Bitcoin DNS seed")
    report(Infra.Resolver.discover())

fn runWithAddress(address: String, rest: List<String>) -> Unit
    ? "One argument is an address on the default port; more may carry a port."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> report(Domain.Address.fromString(address))
        [port, ..extra] -> runWithPort(address, port, extra)

fn runWithPort(address: String, port: String, extra: List<String>) -> Unit
    ? "An address and a port, and nothing after them."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match extra
        [] -> report(Domain.Address.fromParts(address, port))
        [_, ..surplus] -> printLines(usageLines())

fn report(parsed: Result<PeerAddress, String>) -> Unit
    ? "Connect to the accepted Peer, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Ok(address) -> connectTo(address)
        Result.Err(message) -> Console.error("error: {message}")

fn connectTo(address: PeerAddress) -> Unit
    ? "Announce the Peer, then listen to it."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _announced = Console.print(describe(address))
    announce(Infra.Peer.run(Network.Mainnet, address))

fn announce(outcome: Result<Unit, String>) -> Unit
    ? "Say why the session ended, if it ended badly."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(done) -> Console.print("peer closed the connection")
        Result.Err(message) -> Console.error("peer session failed: {message}")

fn printLines(lines: List<String>) -> Unit
    ? "Print each line in turn."
    ! [Console.print]
    match lines
        [] -> Unit
        [head, ..tail] -> printThen(head, tail)

fn printThen(line: String, rest: List<String>) -> Unit
    ? "Print one line, then continue with the rest."
    ! [Console.print]
    _printed = Console.print(line)
    printLines(rest)
