module Cli
    intent =
        "Argv adapter for the Bitcoin peer listener."
        "Argument handling lives here so that address parsing in the domain stays"
        "pure and verifiable, and so the entrypoint has one thing to call."
    exposes [runCli]
    depends [App.Lookup, App.Maintain, App.Node, App.Show, App.Usage, Domain.Index, Infra.Lock, Domain.Address, Domain.Network, Infra.Blocks, Infra.Chain, Infra.Bodies, Infra.Download, Infra.Peer, Infra.Prune, Infra.Resolver, Infra.Store]
    effects [
        Args.get,
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]

record Span
    from: Int
    to: Int

fn describe(address: PeerAddress) -> String
    ? "The line shown once an address has been accepted."
    "listening to peer {Domain.Address.toString(address)}"

verify describe
    describe(Domain.Address.fromString("192.168.1.10")?) => "listening to peer 192.168.1.10:8333"
    describe(Domain.Address.fromParts("10.0.0.1", "18333")?) => "listening to peer 10.0.0.1:18333"

fn runCli() -> Unit
    ? "Starts the argv CLI."
    ! [
        Args.get,
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    run(Args.get())

fn run(args: List<String>) -> Unit
    ? "Dispatch on the arguments given after `--`."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    match args
        [] -> discover(Network.Mainnet)
        [head, ..rest] -> maybeNetwork(head, rest)

fn maybeNetwork(head: String, rest: List<String>) -> Unit
    ? "A leading Network name chooses the Network; anything else is mainnet as before."
      "regtest is here for the same reason the other three are -- it is a"
      "Network this program can speak, and every part below already knew its"
      "magic, its port, its genesis and its halving interval. What it adds is"
      "a chain whose reorganisations can be asked for rather than waited for,"
      "which is how the follow loop's disconnect path was measured (#26)."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    match head
        "signet" -> onNetwork(Network.Signet, rest)
        "regtest" -> onNetwork(Network.Regtest, rest)
        _ -> dispatch(Network.Mainnet, head, rest)

fn onNetwork(network: Network, args: List<String>) -> Unit
    ? "The arguments after the Network was chosen: same grammar, different wire."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    match args
        [] -> discover(network)
        [head, ..rest] -> dispatch(network, head, rest)

fn dispatch(network: Network, command: String, rest: List<String>) -> Unit
    ? "A leading subcommand, or an address for the listener as before."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.now, Time.unixMs,
    ]
    match command
        "headers" -> needTwo(network, rest)
        "bodies" -> needFour(network, rest)
        "prune" -> App.Maintain.prune(rest)
        "txindex" -> App.Maintain.txIndex(rest)
        "outputs" -> App.Maintain.outputs(rest)
        "utxo" -> App.Maintain.utxo(network, rest)
        "follow" -> App.Node.follow(network, rest)
        "assumevalid" -> App.Maintain.assumeValid(rest)
        "audit" -> App.Maintain.audit(network, rest)
        "reindex" -> App.Maintain.reindex(rest)
        "tx" -> App.Lookup.byTxid(network, rest, false)
        "spend" -> App.Lookup.byTxid(network, rest, true)
        "show" -> needShow(rest)
        "help" -> App.Usage.print()
        _ -> runWithAddress(network, command, rest)

fn needTwo(network: Network, rest: List<String>) -> Unit
    ? "The header phase wants an address and a directory."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> App.Usage.print()
        [address, ..more] -> withDir(network, address, more)

fn withDir(network: Network, address: String, more: List<String>) -> Unit
    ? "Take the directory that follows the address."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match more
        [] -> App.Usage.print()
        [dir, ..extra] -> startHeaders(network, Domain.Address.fromStringOn(address, Domain.Network.portOf(network)), dir)

fn startHeaders(network: Network, parsed: Result<PeerAddress, String>, dir: String) -> Unit
    ? "Fetch every Header, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Err(message) -> Console.error("error: {message}")
        Result.Ok(address) -> said(headerRun(network, address, dir))

fn headerRun(network: Network, address: PeerAddress, dir: String) -> Result<String, String>
    ? "Open the Index and fill it with Headers."
      "The directory is handed to the Store whole. What it keeps in there, and"
      "whether it has to be created, are the Store's business rather than this"
      "one's — which is what lets a real database replace it untouched."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.makeDir, Disk.readText, Disk.writeText,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _claimed = Infra.Lock.claim(dir, "headers")?
    Infra.Lock.releasingAfter(dir, headersDone(network, address, dir))

fn headersDone(network: Network, address: PeerAddress, dir: String) -> Result<String, String>
    ? "Fill the Index, with the claim already taken."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.exists, Disk.makeDir,
        Infra.Kv.count, Infra.Kv.deleteAll, Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    store = Infra.Store.open(dir)?
    grown = Infra.Download.headers(network, address, store)?
    held = Infra.Store.size(grown)?
    Result.Ok("index holds {held} entries")

fn needFour(network: Network, rest: List<String>) -> Unit
    ? "The body phase wants an address, a directory and two Heights."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> App.Usage.print()
        [address, ..more] -> bodyDir(network, address, more)

fn bodyDir(network: Network, address: String, more: List<String>) -> Unit
    ? "Take the directory, then the range."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match more
        [] -> App.Usage.print()
        [dir, ..range] -> bodyRange(network, address, dir, range)

fn bodyRange(network: Network, address: String, dir: String, range: List<String>) -> Unit
    ? "Both Heights must be given; there is no sensible default for either."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match heights(range)
        Option.None -> App.Usage.print()
        Option.Some(span) -> startBodies(network, Domain.Address.fromStringOn(address, Domain.Network.portOf(network)), dir, span)

fn heights(range: List<String>) -> Option<Span>
    ? "Two whole numbers, or nothing."
    match range
        [] -> Option.None
        [from, ..rest] -> secondHeight(from, rest)

verify heights
    heights([]) => Option.None
    heights(["1"]) => Option.None
    heights(["1", "5"]) => Option.Some(Span(from = 1, to = 5))
    heights(["x", "5"]) => Option.None

fn secondHeight(from: String, rest: List<String>) -> Option<Span>
    ? "The Height after the first."
    match rest
        [] -> Option.None
        [to, ..extra] -> spanOf(Int.fromString(from), Int.fromString(to))

verify secondHeight
    secondHeight("1", []) => Option.None
    secondHeight("1", ["5"]) => Option.Some(Span(from = 1, to = 5))

fn spanOf(from: Result<Int, String>, to: Result<Int, String>) -> Option<Span>
    ? "Both had to parse."
    match from
        Result.Err(e) -> Option.None
        Result.Ok(a) -> withFrom(a, to)

verify spanOf
    spanOf(Result.Ok(1), Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    spanOf(Result.Err("no"), Result.Ok(5)) => Option.None

fn withFrom(from: Int, to: Result<Int, String>) -> Option<Span>
    ? "The first parsed; the second still has to."
    match to
        Result.Err(e) -> Option.None
        Result.Ok(b) -> Option.Some(Span(from = from, to = b))

verify withFrom
    withFrom(1, Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    withFrom(1, Result.Err("no")) => Option.None

fn startBodies(network: Network, parsed: Result<PeerAddress, String>, dir: String, span: Span) -> Unit
    ? "Fetch the Blocks, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Err(message) -> Console.error("error: {message}")
        Result.Ok(address) -> said(bodyRun(network, address, dir, span))

fn bodyRun(network: Network, address: PeerAddress, dir: String, span: Span) -> Result<String, String>
    ? "Open the Index and the Segments, then fill the range."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.delete, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.readText, Disk.size, Disk.writeBytes, Disk.writeText,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _claimed = Infra.Lock.claim(dir, "bodies")?
    Infra.Lock.releasingAfter(dir, bodiesDone(network, address, dir, span))

fn bodiesDone(network: Network, address: PeerAddress, dir: String, span: Span) -> Result<String, String>
    ? "Fetch the Blocks, with the claim already taken."
    ! [
        Console.error, Console.print,
        Disk.appendBytes, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open, Infra.Kv.putAll,
        Process.stopRequested,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    progress = Infra.Bodies.bodies(network, address, store, blocks, span.from, span.to)?
    bodiesReport(progress.count, Infra.Blocks.currentSegment(progress.blocks), Infra.Chain.withoutBodies(progress.store, span.from, span.to, 0)?)

fn bodiesReport(stored: Int, segment: Int, empty: Int) -> Result<String, String>
    ? "What the phase did, and whether it left the range whole."
      "A count of Blocks stored says nothing about coverage: the phase skips a"
      "Height whose Block it already holds, so a re-run stores none and is"
      "right to. What matters is whether any Height the Index names still has"
      "no body when the phase says it is done -- three such Heights sat in this"
      "chain for six days, and what found them was an audit 108000 Blocks"
      "later reporting 908 spends it could not resolve."
    match empty
        0 -> Result.Ok("{stored} Blocks stored, last Segment {segment}")
        _ -> Result.Err("{stored} Blocks stored but {empty} Heights in the range still hold no body; run this phase again over them")

verify bodiesReport
    bodiesReport(7, 3, 0) => Result.Ok("7 Blocks stored, last Segment 3")
    bodiesReport(0, 3, 0) => Result.Ok("0 Blocks stored, last Segment 3")
    bodiesReport(7, 3, 3) => Result.Err("7 Blocks stored but 3 Heights in the range still hold no body; run this phase again over them")

fn needShow(rest: List<String>) -> Unit
    ? "Showing a Block is local: a directory and a Height, no Peer."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match rest
        [] -> App.Usage.print()
        [dir, ..more] -> showHeight(dir, more)

fn showHeight(dir: String, more: List<String>) -> Unit
    ? "Take the Height that follows the directory."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match more
        [] -> App.Usage.print()
        [height, ..extra] -> showMode(dir, Int.fromString(height), extra)

fn showMode(dir: String, parsed: Result<Int, String>, extra: List<String>) -> Unit
    ? "An optional third word chooses how much of the Block to print."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match extra
        [] -> startShow(dir, parsed, true)
        [mode, ..rest] -> namedMode(dir, parsed, mode)

fn namedMode(dir: String, parsed: Result<Int, String>, mode: String) -> Unit
    ? "Only two words mean anything here; anything else is a typo worth showing."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match mode
        "full" -> startShow(dir, parsed, true)
        "summary" -> startShow(dir, parsed, false)
        _ -> App.Usage.print()

fn startShow(dir: String, parsed: Result<Int, String>, withTransactions: Bool) -> Unit
    ? "Show, or the usage if the Height was not a whole number."
    ! [
        Console.error, Console.print,
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    match parsed
        Result.Err(message) -> App.Usage.print()
        Result.Ok(height) -> shown(showRun(dir, height, withTransactions))

fn showRun(dir: String, height: Int, withTransactions: Bool) -> Result<List<String>, String>
    ? "What the Index and the Segments hold for one Height."
    ! [
        Disk.exists, Disk.listDir, Disk.makeDir, Disk.readBytesAt, Disk.size, Disk.writeBytes,
        Infra.Kv.get, Infra.Kv.open,
    ]
    store = Infra.Store.open(dir)?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    found = Infra.Chain.at(store, blocks, height)?
    below = Infra.Chain.watermark(store)?
    network = Infra.Chain.networkOf(store)?
    Result.Ok(App.Show.describeFound(network, found, below, withTransactions))

fn shown(outcome: Result<List<String>, String>) -> Unit
    ? "Print the lines, or the reason there are none."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(lines) -> App.Usage.printLines(lines)
        Result.Err(message) -> Console.error("error: {message}")

fn blocksPath(dir: String) -> String
    ? "Where the Segments live."
    "{dir}/blocks"

verify blocksPath
    blocksPath("chain") => "chain/blocks"

fn said(outcome: Result<String, String>) -> Unit
    ? "Report what a phase finished with."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(line) -> Console.print(line)
        Result.Err(message) -> Console.error("error: {message}")

fn discover(network: Network) -> Unit
    ? "With no address given, ask a DNS seed of the chosen Network for one."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _searching = Console.print("no peer given; asking a {Domain.Network.nameOf(network)} DNS seed")
    report(network, Infra.Resolver.discover(network))

fn runWithAddress(network: Network, address: String, rest: List<String>) -> Unit
    ? "One argument is an address on the default port; more may carry a port."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> report(network, Domain.Address.fromStringOn(address, Domain.Network.portOf(network)))
        [port, ..extra] -> runWithPort(network, address, port, extra)

fn runWithPort(network: Network, address: String, port: String, extra: List<String>) -> Unit
    ? "An address and a port, and nothing after them."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match extra
        [] -> report(network, Domain.Address.fromParts(address, port))
        [_, ..surplus] -> App.Usage.print()

fn report(network: Network, parsed: Result<PeerAddress, String>) -> Unit
    ? "Connect to the accepted Peer, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Ok(address) -> connectTo(network, address)
        Result.Err(message) -> Console.error("error: {message}")

fn connectTo(network: Network, address: PeerAddress) -> Unit
    ? "Announce the Peer, then listen to it."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.poll, Tcp.readBytes, Tcp.readSome, Tcp.writeBytes,
        Time.unixMs,
    ]
    _announced = Console.print(describe(address))
    announce(Infra.Peer.run(network, address))

fn announce(outcome: Result<Unit, String>) -> Unit
    ? "Say why the session ended, if it ended badly."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(done) -> Console.print("peer closed the connection")
        Result.Err(message) -> Console.error("peer session failed: {message}")
