module Cli
    intent =
        "Argv adapter for the Bitcoin peer listener."
        "Argument handling lives here so that address parsing in the domain stays"
        "pure and verifiable, and so the entrypoint has one thing to call."
    exposes [runCli]
    depends [Domain.Address, Domain.Network, Infra.Blocks, Infra.Download, Infra.Peer, Infra.Resolver, Infra.Store]
    effects [
        Args.get,
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]

record Span
    from: Int
    to: Int

fn usageLines() -> List<String>
    ? "User-facing help for the argv CLI."
    [
        "Bitcoin peer listener and chain downloader",
        "",
        "  [peer-address] [port]                 listen for Transactions",
        "  headers <peer-address> <dir>          fetch every Block Header",
        "  bodies  <peer-address> <dir> <a> <b>  fetch Blocks for Heights a..b",
        "",
        "  peer-address   IPv4 address of the Peer. Omit it, when listening,",
        "                 to ask a Bitcoin DNS seed for one.",
        "  port           optional, defaults to 8333",
        "  dir            where the Index and the Segments live",
        "",
        "  headers must run before bodies: a getdata names Block Ids, never",
        "  Heights, so the chain has to be known before a Block can be asked for.",
    ]

verify usageLines
    List.len(usageLines()) => 13
    List.contains(usageLines(), "Bitcoin peer listener and chain downloader") => true

fn describe(address: PeerAddress) -> String
    ? "The line shown once an address has been accepted."
    "listening to peer {Domain.Address.toString(address)}"

verify describe
    describe(Domain.Address.fromString("192.168.1.10")?) => "listening to peer 192.168.1.10:8333"
    describe(Domain.Address.fromParts("10.0.0.1", "18333")?) => "listening to peer 10.0.0.1:18333"

fn runCli() -> Unit
    ? "Starts the argv CLI."
    ! [
        Args.get,
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    run(Args.get())

fn run(args: List<String>) -> Unit
    ? "Dispatch on the arguments given after `--`."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match args
        [] -> discover()
        [head, ..rest] -> dispatch(head, rest)

fn dispatch(command: String, rest: List<String>) -> Unit
    ? "A leading subcommand, or an address for the listener as before."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match command
        "headers" -> needTwo(rest, "headers")
        "bodies" -> needFour(rest)
        "help" -> printLines(usageLines())
        _ -> runWithAddress(command, rest)

fn needTwo(rest: List<String>, phase: String) -> Unit
    ? "The header phase wants an address and a directory."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> printLines(usageLines())
        [address, ..more] -> withDir(address, more)

fn withDir(address: String, more: List<String>) -> Unit
    ? "Take the directory that follows the address."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match more
        [] -> printLines(usageLines())
        [dir, ..extra] -> startHeaders(Domain.Address.fromString(address), dir)

fn startHeaders(parsed: Result<PeerAddress, String>, dir: String) -> Unit
    ? "Fetch every Header, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Err(message) -> Console.error("error: {message}")
        Result.Ok(address) -> said(headerRun(address, dir))

fn headerRun(address: PeerAddress, dir: String) -> Result<String, String>
    ? "Open the Index and fill it with Headers."
      "The directory is created first: a Store appends to a file and will not"
      "make the directory holding it."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _made = Disk.makeDir(dir)?
    store = Infra.Store.open(indexPath(dir))?
    grown = Infra.Download.headers(Network.Mainnet, address, store)?
    Result.Ok("index holds {Infra.Store.size(grown)} entries")

fn needFour(rest: List<String>) -> Unit
    ? "The body phase wants an address, a directory and two Heights."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> printLines(usageLines())
        [address, ..more] -> bodyDir(address, more)

fn bodyDir(address: String, more: List<String>) -> Unit
    ? "Take the directory, then the range."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match more
        [] -> printLines(usageLines())
        [dir, ..range] -> bodyRange(address, dir, range)

fn bodyRange(address: String, dir: String, range: List<String>) -> Unit
    ? "Both Heights must be given; there is no sensible default for either."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match heights(range)
        Option.None -> printLines(usageLines())
        Option.Some(span) -> startBodies(Domain.Address.fromString(address), dir, span)

fn heights(range: List<String>) -> Option<Span>
    ? "Two whole numbers, or nothing."
    match range
        [] -> Option.None
        [from, ..rest] -> secondHeight(from, rest)

verify heights
    heights([]) => Option.None
    heights(["1"]) => Option.None
    heights(["1", "5"]) => Option.Some(Span(from = 1, to = 5))
    heights(["x", "5"]) => Option.None

fn secondHeight(from: String, rest: List<String>) -> Option<Span>
    ? "The Height after the first."
    match rest
        [] -> Option.None
        [to, ..extra] -> spanOf(Int.fromString(from), Int.fromString(to))

verify secondHeight
    secondHeight("1", []) => Option.None
    secondHeight("1", ["5"]) => Option.Some(Span(from = 1, to = 5))

fn spanOf(from: Result<Int, String>, to: Result<Int, String>) -> Option<Span>
    ? "Both had to parse."
    match from
        Result.Err(e) -> Option.None
        Result.Ok(a) -> withFrom(a, to)

verify spanOf
    spanOf(Result.Ok(1), Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    spanOf(Result.Err("no"), Result.Ok(5)) => Option.None

fn withFrom(from: Int, to: Result<Int, String>) -> Option<Span>
    ? "The first parsed; the second still has to."
    match to
        Result.Err(e) -> Option.None
        Result.Ok(b) -> Option.Some(Span(from = from, to = b))

verify withFrom
    withFrom(1, Result.Ok(5)) => Option.Some(Span(from = 1, to = 5))
    withFrom(1, Result.Err("no")) => Option.None

fn startBodies(parsed: Result<PeerAddress, String>, dir: String, span: Span) -> Unit
    ? "Fetch the Blocks, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Err(message) -> Console.error("error: {message}")
        Result.Ok(address) -> said(bodyRun(address, dir, span))

fn bodyRun(address: PeerAddress, dir: String, span: Span) -> Result<String, String>
    ? "Open the Index and the Segments, then fill the range."
    ! [
        Console.error, Console.print,
        Disk.appendText, Disk.exists, Disk.listDir, Disk.makeDir, Disk.readText,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _made = Disk.makeDir(dir)?
    store = Infra.Store.open(indexPath(dir))?
    blocks = Infra.Blocks.open(blocksPath(dir))?
    progress = Infra.Download.bodies(Network.Mainnet, address, store, blocks, span.from, span.to)?
    Result.Ok("{progress.count} Blocks stored, last Segment {progress.blocks.state.segment}")

fn indexPath(dir: String) -> String
    ? "Where the Index log lives."
    "{dir}/index.log"

verify indexPath
    indexPath("chain") => "chain/index.log"

fn blocksPath(dir: String) -> String
    ? "Where the Segments live."
    "{dir}/blocks"

verify blocksPath
    blocksPath("chain") => "chain/blocks"

fn said(outcome: Result<String, String>) -> Unit
    ? "Report what a phase finished with."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(line) -> Console.print(line)
        Result.Err(message) -> Console.error("error: {message}")

fn discover() -> Unit
    ? "With no address given, ask a Bitcoin DNS seed for one."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _searching = Console.print("no peer given; asking a Bitcoin DNS seed")
    report(Infra.Resolver.discover())

fn runWithAddress(address: String, rest: List<String>) -> Unit
    ? "One argument is an address on the default port; more may carry a port."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match rest
        [] -> report(Domain.Address.fromString(address))
        [port, ..extra] -> runWithPort(address, port, extra)

fn runWithPort(address: String, port: String, extra: List<String>) -> Unit
    ? "An address and a port, and nothing after them."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match extra
        [] -> report(Domain.Address.fromParts(address, port))
        [_, ..surplus] -> printLines(usageLines())

fn report(parsed: Result<PeerAddress, String>) -> Unit
    ? "Connect to the accepted Peer, or say why the address was rejected."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    match parsed
        Result.Ok(address) -> connectTo(address)
        Result.Err(message) -> Console.error("error: {message}")

fn connectTo(address: PeerAddress) -> Unit
    ? "Announce the Peer, then listen to it."
    ! [
        Console.error, Console.print,
        Random.int,
        Tcp.close, Tcp.connect, Tcp.readBytes, Tcp.writeBytes,
        Time.unixMs,
    ]
    _announced = Console.print(describe(address))
    announce(Infra.Peer.run(Network.Mainnet, address))

fn announce(outcome: Result<Unit, String>) -> Unit
    ? "Say why the session ended, if it ended badly."
    ! [Console.error, Console.print]
    match outcome
        Result.Ok(done) -> Console.print("peer closed the connection")
        Result.Err(message) -> Console.error("peer session failed: {message}")

fn printLines(lines: List<String>) -> Unit
    ? "Print each line in turn."
    ! [Console.print]
    match lines
        [] -> Unit
        [head, ..tail] -> printThen(head, tail)

fn printThen(line: String, rest: List<String>) -> Unit
    ? "Print one line, then continue with the rest."
    ! [Console.print]
    _printed = Console.print(line)
    printLines(rest)
