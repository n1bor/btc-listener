module Usage
    intent =
        "What the command line says about itself, and how it says it."
        "Held apart from the adapter that dispatches commands because the two"
        "grow for different reasons: a new subcommand adds a line here and a"
        "branch there, and the adapter was carrying both until it outgrew the"
        "file. Nothing here knows what any command does."
    exposes [lines, print, printLines]
    depends []
    effects [Console.print]

fn lines() -> List<String>
    ? "User-facing help for the argv CLI."
    [
        "Bitcoin peer listener, chain downloader and auditor",
        "",
        "  [peer-address] [port]                 listen for Transactions",
        "  headers <peer-address> <dir>          fetch every Block Header",
        "  bodies  <peer-address> <dir> <a> <b>  fetch Blocks for Heights a..b",
        "  prune   <dir> <height>                delete Blocks below a Height",
        "  show    <dir> <height> [summary]      read one Block back and check it",
        "  txindex <dir> <a> <b>                 record where Transactions in a..b sit",
        "  outputs <dir> <a> <b>                 record the Outputs in a..b, so spends resolve",
        "  utxo    <dir> <height>                connect Blocks into the UTXO Set up to a Height",
        "  assumevalid <dir> <height>            take Scripts at or below a Height as settled",
        "  follow  <peer-addresses> <dir> [screen] [serve] [log]",
        "                                      stay on the tip, and never stop",
        "                                        with screen: a live terminal Screen once",
        "                                        caught up -- o p b t m switch Panels, q quits",
        "                                        with log: a metrics record a minute and one",
        "                                        per phase to <dir>/metrics.log; log:PATH",
        "                                        names the file instead",
        "  follow  <dir> [screen] [serve] [log]  the same, bootstrapping from the DNS seeds",
        "                                        rather than from an address you name",
        "  tx      <dir> <txid>                  find one Transaction by its Id",
        "  spend   <dir> <txid>                  check what it spends against what it pays",
        "  audit   <dir> <a> <b>                 check every Block and spend in a..b",
        "  reindex <dir>                         rebuild every Block's Location from the Segments",
        "",
        "  peer-address   IPv4 address of the Peer, with :port for one not on",
        "                 the Network's own. Omit it, when listening, to ask a DNS seed.",
        "  port           optional, defaults to 8333",
        "  regtest        put before any command to speak regtest: magic, port",
        "                 18444 and genesis follow. Every consensus rule is in",
        "                 force from the start, as on signet, and the subsidy",
        "                 halves every 150 Blocks rather than every 210000.",
        "  signet         put before any command to speak signet instead of",
        "                 mainnet: magic, port 38333, seeds and genesis follow.",
        "                 It also decides which consensus rules a Height means,",
        "                 so audit needs it too: signet has had P2SH, BIP65,",
        "                 BIP112, SegWit and Taproot since Height 1, and",
        "                 auditing it as mainnet judges the whole chain by a",
        "                 timetable it never followed.",
        "  dir            where the Index and the Segments live",
        "  summary        show, without listing the Block's Transactions",
        "",
        "  headers must run before bodies, and bodies before txindex: each needs",
        "  what the one before it wrote. Only headers, bodies and follow need a",
        "  Peer.",
        "",
        "  follow is those first three phases run again every time a Peer says",
        "  a Block arrived, so it both catches a directory up and keeps it up.",
        "  Give it one Peer Address or several separated by commas, each with",
        "  an optional :port: every Peer",
        "  is read and kept alive while any one of them is being asked a",
        "  question, and whichever announces a Block is the one asked for it.",
        "  It holds the directory until it is stopped, and it stops rather than",
        "  guesses if the chain forks below the Undo window.",
        "",
        "  prune deletes whole Segments only, so it frees nothing until a Segment",
        "  holds no Block you are still keeping, and never deletes the one the",
        "  next Block goes into.",
        "",
        "  reindex is for a directory whose Index was lost: move or delete <dir>/kv,",
        "  run headers, then reindex, then txindex and outputs as before.",
    ]

verify lines
    List.len(lines()) => 61
    List.contains(lines(), "Bitcoin peer listener, chain downloader and auditor") => true

fn print() -> Unit
    ? "Say what the command line accepts."
    ! [Console.print]
    printLines(lines())

fn printLines(all: List<String>) -> Unit
    ? "Print each line in turn."
    ! [Console.print]
    match all
        [] -> Unit
        [head, ..tail] -> printThen(head, tail)

fn printThen(line: String, rest: List<String>) -> Unit
    ? "Print one line, then continue with the rest."
    ! [Console.print]
    _printed = Console.print(line)
    printLines(rest)
